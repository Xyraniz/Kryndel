#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    printf 'usage: %s OUTPUT\n' "$0" >&2
    exit 64
fi

output=$1
tmp="${output}.tmp.$$"
trap 'rm -f "$tmp"' EXIT HUP INT TERM

# ELF64 little-endian x86_64 Linux, one RX PT_LOAD segment, _start exits 0.
printf '%b' \
    '\177ELF\002\001\001\000\000\000\000\000\000\000\000\000' \
    '\002\000\076\000\001\000\000\000' \
    '\170\000\100\000\000\000\000\000' \
    '\100\000\000\000\000\000\000\000' \
    '\000\000\000\000\000\000\000\000' \
    '\000\000\000\000' \
    '\100\000\070\000\001\000\000\000\000\000\000\000' \
    '\001\000\000\000\005\000\000\000' \
    '\000\000\000\000\000\000\000\000' \
    '\000\000\100\000\000\000\000\000' \
    '\000\000\100\000\000\000\000\000' \
    '\204\000\000\000\000\000\000\000' \
    '\204\000\000\000\000\000\000\000' \
    '\000\020\000\000\000\000\000\000' \
    '\270\074\000\000\000\277\000\000\000\000\017\005' \
    > "$tmp"

chmod 755 "$tmp"
mv -f "$tmp" "$output"
trap - EXIT HUP INT TERM
