#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
binary="$root/build/kry"
source="$root/native/kry.c"

if [ ! -x "$binary" ] || [ "$source" -nt "$binary" ]; then
    compiler=${CC:-}
    if [ -z "$compiler" ]; then
        compiler=$(command -v cc 2>/dev/null || command -v gcc 2>/dev/null || true)
    fi
    if [ -z "$compiler" ] || { ! command -v "$compiler" >/dev/null 2>&1 && [ ! -x "$compiler" ]; }; then
        printf '%s\n' 'kry: no usable C11 compiler found; set CC to GCC or Clang, or install a native compiler' >&2
        exit 69
    fi
    mkdir -p "$root/build"
    "$compiler" -std=c11 -O2 -Wall -Wextra -Wpedantic "$source" -lm -o "$binary"
fi
exec "$binary" "$@"
