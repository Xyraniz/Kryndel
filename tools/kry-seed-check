#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
work=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/kry-seed-check.XXXXXX")
trap '/usr/bin/rm -rf "$work"' EXIT HUP INT TERM

# Give the seed only the POSIX commands it actually needs. In particular, do
# not expose Python, an assembler, a linker, or the repository's normal CLI.
minimal_path=$work/minimal-path
/usr/bin/mkdir -p "$minimal_path" "$work/output directory"
for command in sh chmod mv rm; do
    /usr/bin/ln -s "/usr/bin/$command" "$minimal_path/$command"
done

first="$work/output directory/seed-one"
second="$work/output directory/seed-two"
/usr/bin/env -i PATH="$minimal_path" HOME= /bin/sh "$root/tools/kry-seed" "$first"
/usr/bin/env -i PATH="$minimal_path" HOME= /bin/sh "$root/tools/kry-seed" "$second"

[ -x "$first" ]
[ -x "$second" ]
magic=$(/usr/bin/od -An -tx1 -N4 "$first" | /usr/bin/tr -d ' \t\r\n')
[ "$magic" = 7f454c46 ]
/usr/bin/cmp -s "$first" "$second"

# Execute the generated file with an empty environment and no HOME. The seed
# has no dynamic loader or runtime dependency and must exit successfully.
/usr/bin/env -i PATH="$minimal_path" "$first"

printf '%s\n' "seed-only offline check passed"
printf '%s\n' "scope: raw x86_64 Linux ELF64 empty-main exit-0 seed"
printf '%s\n' "not verified: compiler, runtime, package tooling, or full Kryndel CLI"
