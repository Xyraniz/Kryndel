#!/bin/sh
set -eu

check=0
if [ "${1:-}" = "--check" ]; then
    check=1
    shift
fi

if [ "$#" -ne 1 ]; then
    printf 'usage: %s [--check] FILE\n' "$0" >&2
    exit 64
fi

path=$1
tmp="${path}.kry-format.tmp.$$"
trap 'rm -f "$tmp"' EXIT HUP INT TERM

awk '
{
    sub(/[ \t\r]+$/, "")
    lines[NR] = $0
}
END {
    if (NR == 0) {
        print ""
        exit
    }
    end = NR
    while (end > 0 && lines[end] == "") {
        end--
    }
    for (i = 1; i <= end; i++) {
        print lines[i]
    }
}
' "$path" > "$tmp"

if [ "$check" -eq 1 ]; then
    if cmp -s "$path" "$tmp"; then
        rm -f "$tmp"
        exit 0
    fi
    rm -f "$tmp"
    printf '%s: needs formatting\n' "$path" >&2
    exit 1
fi

chmod 644 "$tmp"
mv -f "$tmp" "$path"
