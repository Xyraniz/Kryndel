        enum_type: enum_type,
        enum_variant: enum_variant,
        tail: false,
        callee: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions),
        lambda: kir_typed_absent_ref(KIRTypedTable::KIRTableFunctions),
        binding: kir_typed_absent_ref(KIRTypedTable::KIRTableBindings)
    }
}

