import "dynamic_backend"
import "validated_kir"
import "kir_typed_arena"

struct SourceToken {
    kind: String,
    text: String,
    source: String,
    line: Int,
    column: Int,
    byte_start: Int,
    byte_end: Int,
}

struct SourceLocation {
    line: Int,
    column: Int,
}

struct SourceBinding {
    reference: KIRIndexRef,
    type_name: String,
    mutable: Bool,
    known: Bool,
    display: String,
    source: String,
    line: Int,
    column: Int,
    byte_start: Int,
}

struct SourceExpr {
    row: KIRTypedExpression,
    reference: KIRIndexRef,
    type_name: String,
    known: Bool,
    display: String,
    location: SourceToken,
    empty_kind: String,
}

fn node_prefix(token: SourceToken) -> SourceToken { return token }

fn node_prefix_range(token: SourceToken, byte_end: Int) -> SourceToken {
    return SourceToken{ kind: token.kind, text: token.text, source: token.source, line: token.line, column: token.column, byte_start: token.byte_start, byte_end: byte_end }
}

fn prefix_with_span_end(prefix: SourceToken, byte_end: Int) -> SourceToken {
    return node_prefix_range(prefix, byte_end)
}

fn prefix_span_end(prefix: SourceToken) -> Int { return prefix.byte_end }

fn prefix_with_diagnostic(prefix: SourceToken, token: SourceToken) -> SourceToken {
    return SourceToken{ kind: prefix.kind, text: prefix.text, source: token.source, line: token.line, column: token.column, byte_start: prefix.byte_start, byte_end: prefix.byte_end }
}





fn previous_token(parser: SourceParser) -> SourceToken {
    if parser.position <= 0 { return current_token(parser) }
    return unwrap_or(array_get(parser.tokens, parser.position - 1), current_token(parser))
}

fn previous_non_separator(parser: SourceParser) -> SourceToken {
    let mut index: Int = parser.position - 1
    while index >= 0 {
        let token: SourceToken = unwrap_or(array_get(parser.tokens, index), current_token(parser))
        if token.kind != "separator" && token.text != ";" { return token }
        index = index - 1
    }
    return current_token(parser)
}

struct SourceFunction {
    return_type: String,
    parameters: Array[String],
    symbol: String,
}

struct SourceStruct {
    symbol: String,
    module_id: String,
    public: Bool,
    fields: Map[String, String],
    names: Array[String],
    public_fields: Map[String, Bool],
}

struct SourceParser {
    arena: KIRTypedArena,
    tokens: Array[SourceToken],
    position: Int,
    module_id: String,
    bindings: Map[String, SourceBinding],
    functions: Map[String, SourceFunction],
    structs: Map[String, SourceStruct],
    return_type: String,
}

struct ParsedExpr {
    parser: SourceParser,
    expression: SourceExpr,
}

struct ParsedType {
    parser: SourceParser,
    name: String,
}

struct ParsedStatements {
    parser: SourceParser,
    references: Array[KIRIndexRef],
}

struct ParsedProgram {
    parser: SourceParser,
    statements: Array[KIRIndexRef],
    functions: Array[KIRIndexRef],
}

struct ParsedFunction {
    parser: SourceParser,
    reference: KIRIndexRef,
}

struct ParsedFunctionHeader {
    parser: SourceParser,
    name: String,
    signature: SourceFunction,
}

struct ParsedStruct {
    parser: SourceParser,
    reference: KIRIndexRef,
}

struct ParsedEnum {
    parser: SourceParser,
    reference: KIRIndexRef,
}

struct SourceImport {
    path: String,
    token: SourceToken,
}

struct SourceModule {
    path: String,
    tokens: Array[SourceToken],
    imports: Array[String],
    import_records: Array[SourceImport],
}

struct SourceModuleContext {
    module_id: String,
    functions: Map[String, SourceFunction],
    public_names: Array[String],
    structs: Map[String, SourceStruct],
    struct_names: Array[String],
    public_struct_names: Array[String],
}

struct SourceModules {
    items: Array[SourceModule],
    visiting: Map[String, Bool],
    loaded: Map[String, Bool],
}

fn source_row_int(type_name: String, int_value: Int) -> KIRTypedExpression {
    return KIRTypedExpression{
        kind: "int",
        source: "",
        line: 0,
        column: 0,
        span: kir_typed_absent_ref(KIRTypedTable::KIRTableSpans),
        type_name: type_name,
        constant: kir_typed_absent_ref(KIRTypedTable::KIRTableValues),
        int_value: int_value,
        uint_value: u64(0),
        uint_bits: u8(0),
        float_text: "",
        bool_value: false,
        string_value: "",
        name: "",
        operator: "",
        call_target: "",
        trait_name: "",
        builtin_id: "",
        left: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions),
        right: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions),
        operand: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions),
        args: kir_typed_empty_edges(),
        items: kir_typed_empty_edges(),
        base: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions),
        field: "",
        receiver: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions),
        map_keys: kir_typed_empty_edges(),
        struct_name: "",
        struct_type: "",
        generic_arguments: [],
        fields: [],
        values: kir_typed_empty_edges(),
        enum_type: "",
        enum_variant: "",
        tail: false,
        callee: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions),
        lambda: kir_typed_absent_ref(KIRTypedTable::KIRTableFunctions),
        binding: kir_typed_absent_ref(KIRTypedTable::KIRTableBindings)
    }
}

