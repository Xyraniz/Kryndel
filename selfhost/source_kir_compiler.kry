import "dynamic_backend"

struct SourceToken {
    kind: String,
    text: String,
}

struct SourceBinding {
    type_name: String,
    mutable: Bool,
    known: Bool,
    display: String,
}

struct SourceExpr {
    json: String,
    type_name: String,
    known: Bool,
    display: String,
}

struct SourceFunction {
    return_type: String,
    parameters: Array[String],
}

struct SourceStruct {
    fields: Map[String, String],
    names: Array[String],
}

struct SourceParser {
    tokens: Array[SourceToken],
    position: Int,
    bindings: Map[String, SourceBinding],
    functions: Map[String, SourceFunction],
    structs: Map[String, SourceStruct],
}

struct ParsedExpr {
    parser: SourceParser,
    expression: SourceExpr,
}

struct ParsedType {
    parser: SourceParser,
    name: String,
}

struct ParsedStatements {
    parser: SourceParser,
    json: String,
}

struct ParsedProgram {
    parser: SourceParser,
    statements: String,
    functions: String,
    structs: String,
}

struct ParsedFunction {
    parser: SourceParser,
    json: String,
}

struct ParsedFunctionHeader {
    parser: SourceParser,
    name: String,
    signature: SourceFunction,
}

struct ParsedStruct {
    parser: SourceParser,
    json: String,
}

fn char_at(chars: Array[String], index: Int) -> String {
    return unwrap_or(array_get(chars, index), "")
}

fn is_space(value: String) -> Bool {
    return value == " " || value == "\t" || value == "\r"
}

fn is_digit(value: String) -> Bool {
    return contains("0123456789", value)
}

fn is_identifier_start(value: String) -> Bool {
    return value == "_" || contains("abcdefghijklmnopqrstuvwxyz", value) || contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", value)
}

fn is_identifier_continue(value: String) -> Bool {
    return is_identifier_start(value) || is_digit(value)
}

fn join_text_range(parts: Array[String], start: Int, end: Int) -> String {
    if end <= start { return "" }
    if end - start == 1 { return unwrap_or(array_get(parts, start), "") }
    let middle: Int = start + (end - start) / 2
    return join_text_range(parts, start, middle) + join_text_range(parts, middle, end)
}

fn push_token(tokens: Array[SourceToken], kind: String, text: String) -> Array[SourceToken] {
    return array_push(tokens, SourceToken{ kind: kind, text: text })
}

fn join_token_chunks(chunks: Array[Array[SourceToken]], start: Int, end: Int) -> Array[SourceToken] {
    if end <= start { return [] }
    if end - start == 1 { return unwrap_or(array_get(chunks, start), []) }
    let middle: Int = start + (end - start) / 2
    return array_concat(join_token_chunks(chunks, start, middle), join_token_chunks(chunks, middle, end))
}

fn lex(source: String) -> Result[Array[SourceToken], String] {
    let chars: Array[String] = string_chars(source)
    let mut index: Int = 0
    let count: Int = len(chars)
    let mut tokens: Array[SourceToken] = []
    let mut token_chunks: Array[Array[SourceToken]] = []
    let mut paren_depth: Int = 0
    let mut bracket_depth: Int = 0
    while index < count {
        let current: String = char_at(chars, index)
        if is_space(current) {
            index = index + 1
            continue
        }
        if current == "\n" {
            if paren_depth == 0 && bracket_depth == 0 {
                tokens = push_token(tokens, "separator", ";")
                if len(tokens) >= 128 {
                    token_chunks = array_push(token_chunks, tokens)
                    tokens = []
                }
            }
            index = index + 1
            continue
        }
        if current == "/" && char_at(chars, index + 1) == "/" {
            index = index + 2
            while index < count && char_at(chars, index) != "\n" {
                index = index + 1
            }
            continue
        }
        if is_identifier_start(current) {
            let start: Int = index
            while index < count && is_identifier_continue(char_at(chars, index)) {
                index = index + 1
            }
            let text: String = join_text_range(chars, start, index)
            tokens = push_token(tokens, "identifier", text)
            if len(tokens) >= 128 {
                token_chunks = array_push(token_chunks, tokens)
                tokens = []
            }
            continue
        }
        if is_digit(current) {
            let start: Int = index
            while index < count && is_digit(char_at(chars, index)) {
                index = index + 1
            }
            let text: String = join_text_range(chars, start, index)
            tokens = push_token(tokens, "integer", text)
            if len(tokens) >= 128 {
                token_chunks = array_push(token_chunks, tokens)
                tokens = []
            }
            continue
        }
        if current == "\"" {
            index = index + 1
            let mut text_parts: Array[String] = []
            let mut closed: Bool = false
            while index < count {
                let value: String = char_at(chars, index)
                if value == "\"" {
                    closed = true
                    index = index + 1
                    break
                }
                if value == "\\" {
                    index = index + 1
                    if index >= count {
                        return err("lexer: unfinished escape sequence")
                    }
                    let escaped: String = char_at(chars, index)
                    if escaped == "n" {
                        text_parts = array_push(text_parts, "\n")
                    } else if escaped == "r" {
                        text_parts = array_push(text_parts, "\r")
                    } else if escaped == "t" {
                        text_parts = array_push(text_parts, "\t")
                    } else if escaped == "\\" {
                        text_parts = array_push(text_parts, "\\")
                    } else if escaped == "\"" {
                        text_parts = array_push(text_parts, "\"")
                    } else {
                        return err("lexer: unsupported string escape \\" + escaped)
                    }
                    index = index + 1
                    continue
                }
                if value == "\n" {
                    return err("lexer: newline in string literal")
                }
                text_parts = array_push(text_parts, value)
                index = index + 1
            }
            if !closed {
                return err("lexer: unterminated string literal")
            }
            tokens = push_token(tokens, "string", join_text_range(text_parts, 0, len(text_parts)))
            if len(tokens) >= 128 {
                token_chunks = array_push(token_chunks, tokens)
                tokens = []
            }
            continue
        }
        let next: String = char_at(chars, index + 1)
        if (current == "=" && next == "=") || (current == "!" && next == "=") || (current == "<" && next == "=") || (current == ">" && next == "=") || (current == "&" && next == "&") || (current == "|" && next == "|") || (current == "<" && next == "<") || (current == ">" && next == ">") || (current == "-" && next == ">") {
            tokens = push_token(tokens, "symbol", current + next)
            if len(tokens) >= 128 {
                token_chunks = array_push(token_chunks, tokens)
                tokens = []
            }
            index = index + 2
            continue
        }
        if current == "(" || current == ")" || current == "{" || current == "}" || current == "[" || current == "]" || current == ":" || current == "=" || current == "+" || current == "-" || current == "*" || current == "/" || current == "%" || current == "<" || current == ">" || current == "!" || current == "&" || current == "|" || current == "^" || current == "," || current == ";" || current == "." {
            tokens = push_token(tokens, "symbol", current)
            if len(tokens) >= 128 {
                token_chunks = array_push(token_chunks, tokens)
                tokens = []
            }
            if current == "(" { paren_depth = paren_depth + 1 }
            if current == ")" && paren_depth > 0 { paren_depth = paren_depth - 1 }
            if current == "[" { bracket_depth = bracket_depth + 1 }
            if current == "]" && bracket_depth > 0 { bracket_depth = bracket_depth - 1 }
            index = index + 1
            continue
        }
        return err("lexer: unsupported character '" + current + "'")
    }
    tokens = push_token(tokens, "eof", "")
    token_chunks = array_push(token_chunks, tokens)
    return ok(join_token_chunks(token_chunks, 0, len(token_chunks)))
}

fn current_token(parser: SourceParser) -> SourceToken {
    return unwrap_or(array_get(parser.tokens, parser.position), SourceToken{ kind: "eof", text: "" })
}

fn advance(parser: SourceParser) -> SourceParser {
    return SourceParser{ tokens: parser.tokens, position: parser.position + 1, bindings: parser.bindings, functions: parser.functions, structs: parser.structs }
}

fn parser_error(value: Result[SourceParser, String]) -> String {
    return unwrap_or(result_error(value), "parser error")
}

fn source_expression_error(value: Result[ParsedExpr, String]) -> String {
    return unwrap_or(result_error(value), "expression parser error")
}

fn statements_error(value: Result[ParsedStatements, String]) -> String {
    return unwrap_or(result_error(value), "statement parser error")
}

fn program_error(value: Result[ParsedProgram, String]) -> String {
    return unwrap_or(result_error(value), "program parser error")
}

fn expect(parser: SourceParser, expected: String) -> Result[SourceParser, String] {
    let token: SourceToken = current_token(parser)
    if token.text != expected {
        return err("parser: expected '" + expected + "', found '" + token.text + "'")
    }
    return ok(advance(parser))
}

fn parse_type(parser: SourceParser) -> Result[ParsedType, String] {
    let token: SourceToken = current_token(parser)
    if token.kind != "identifier" { return err("parser: expected a type name") }
    let mut current: SourceParser = advance(parser)
    let mut name: String = token.text
    if current_token(current).text == "[" {
        current = advance(current)
        let mut arguments: String = ""
        let mut first: Bool = true
        while current_token(current).text != "]" {
            let nested: Result[ParsedType, String] = parse_type(current)
            if is_err(nested) { return err(unwrap_or(result_error(nested), "parser: invalid generic type")) }
            let parsed: ParsedType = result_unwrap(nested)
            if !first { arguments = arguments + "," }
            arguments = arguments + parsed.name
            first = false
            current = parsed.parser
            if current_token(current).text == "," {
                current = advance(current)
            } else if current_token(current).text != "]" {
                return err("parser: expected ',' or ']' in generic type")
            }
        }
        let closed: Result[SourceParser, String] = expect(current, "]")
        if is_err(closed) { return err(parser_error(closed)) }
        current = result_unwrap(closed)
        name = name + "[" + arguments + "]"
    }
    return ok(ParsedType{ parser: current, name: name })
}

fn parse_struct(parser: SourceParser, public: Bool) -> Result[ParsedStruct, String] {
    let opened: Result[SourceParser, String] = expect(parser, "struct")
    if is_err(opened) { return err(parser_error(opened)) }
    let named: SourceParser = result_unwrap(opened)
    let name: SourceToken = current_token(named)
    if name.kind != "identifier" { return err("parser: expected a struct name") }
    let brace: Result[SourceParser, String] = expect(advance(named), "{")
    if is_err(brace) { return err(parser_error(brace)) }
    let mut current: SourceParser = skip_separators(result_unwrap(brace))
    let mut fields: Map[String, String] = {}
    let mut names: Array[String] = []
    let mut fields_json: String = "["
    let mut first: Bool = true
    while current_token(current).text != "}" {
        let mut field_public: Bool = false
        if current_token(current).text == "pub" {
            field_public = true
            current = advance(current)
        }
        let field_name: SourceToken = current_token(current)
        if field_name.kind != "identifier" { return err("parser: expected a struct field name") }
        if map_contains_key(fields, field_name.text) { return err("parser: duplicate struct field '" + field_name.text + "'") }
        let colon: Result[SourceParser, String] = expect(advance(current), ":")
        if is_err(colon) { return err(parser_error(colon)) }
        let parsed_type: Result[ParsedType, String] = parse_type(result_unwrap(colon))
        if is_err(parsed_type) { return err(unwrap_or(result_error(parsed_type), "parser: expected a struct field type")) }
        let field_type: String = result_unwrap(parsed_type).name
        if !source_type_supported(parser, field_type) && field_type != name.text { return err("parser: unsupported struct field type '" + field_type + "'") }
        fields = map_insert(fields, field_name.text, field_type)
        names = array_push(names, field_name.text)
        if !first { fields_json = fields_json + "," }
        fields_json = fields_json + "{\"name\":" + json_quote(field_name.text) + ",\"public\":" + bool_text(field_public) + ",\"type\":" + json_quote(field_type) + "}"
        first = false
        current = skip_separators(result_unwrap(parsed_type).parser)
        if current_token(current).text == "," {
            current = skip_separators(advance(current))
        } else if current_token(current).text != "}" {
            return err("parser: expected ',' or '}' after struct field")
        }
    }
    let closed: Result[SourceParser, String] = expect(current, "}")
    if is_err(closed) { return err(parser_error(closed)) }
    let definition: SourceStruct = SourceStruct{ fields: fields, names: names }
    let after: SourceParser = result_unwrap(closed)
    let updated: SourceParser = SourceParser{ tokens: after.tokens, position: after.position, bindings: after.bindings, functions: after.functions, structs: map_insert(after.structs, name.text, definition) }
    return ok(ParsedStruct{ parser: updated, json: "{\"name\":" + json_quote(name.text) + ",\"public\":" + bool_text(public) + ",\"module\":\"\",\"fields\":" + fields_json + "]}" })
}

fn json_quote(value: String) -> String {
    let chars: Array[String] = string_chars(value)
    let mut parts: Array[String] = ["\""]
    let mut index: Int = 0
    while index < len(chars) {
        let character: String = char_at(chars, index)
        if character == "\"" {
            parts = array_push(parts, "\\\"")
        } else if character == "\\" {
            parts = array_push(parts, "\\\\")
        } else if character == "\n" {
            parts = array_push(parts, "\\n")
        } else if character == "\r" {
            parts = array_push(parts, "\\r")
        } else if character == "\t" {
            parts = array_push(parts, "\\t")
        } else {
            parts = array_push(parts, character)
        }
        index = index + 1
    }
    parts = array_push(parts, "\"")
    return join_text_range(parts, 0, len(parts))
}

fn bool_text(value: Bool) -> String {
    if value {
        return "true"
    }
    return "false"
}

fn source_is_scalar_type(type_name: String) -> Bool {
    return type_name == "Int" || type_name == "Bool" || type_name == "String" || type_name == "Json" || type_name == "Bytes" || starts_with(type_name, "UInt") || starts_with(type_name, "Array[") || starts_with(type_name, "Option[") || starts_with(type_name, "Result[") || starts_with(type_name, "Map[")
}

fn source_type_supported(parser: SourceParser, type_name: String) -> Bool {
    return source_is_scalar_type(type_name) || map_contains_key(parser.structs, type_name)
}

fn source_struct_field_type(parser: SourceParser, type_name: String, field_name: String) -> String {
    let definition: Option[SourceStruct] = map_get(parser.structs, type_name)
    if is_none(definition) { return "" }
    let fields: Map[String, String] = unwrap_or(definition, SourceStruct{ fields: {}, names: [] }).fields
    return unwrap_or(map_get(fields, field_name), "")
}

fn generic_inner(type_name: String, prefix: String) -> String {
    if !starts_with(type_name, prefix) { return "" }
    let start: Int = len(string_chars(prefix))
    let chars: Array[String] = string_chars(type_name)
    let mut index: Int = start
    let mut depth: Int = 0
    while index < len(chars) {
        let current: String = char_at(chars, index)
        if current == "[" {
            depth = depth + 1
        } else if current == "]" {
            if depth == 0 { break }
            depth = depth - 1
        } else if current == "," && depth == 0 {
            break
        }
        index = index + 1
    }
    let value: Result[String, String] = substring(type_name, start, index - start)
    if is_err(value) { return "" }
    return result_unwrap(value)
}

fn generic_error(type_name: String) -> String {
    if !is_result_type(type_name) { return "" }
    let chars: Array[String] = string_chars(type_name)
    let start: Int = len(string_chars("Result["))
    let mut index: Int = start
    let mut depth: Int = 0
    let mut comma: Int = -1
    while index < len(chars) - 1 {
        let current: String = char_at(chars, index)
        if current == "[" {
            depth = depth + 1
        } else if current == "]" {
            if depth > 0 { depth = depth - 1 }
        } else if current == "," && depth == 0 {
            comma = index
            break
        }
        index = index + 1
    }
    if comma < 0 { return "" }
    let value: Result[String, String] = substring(type_name, comma + 1, len(chars) - comma - 2)
    if is_err(value) { return "" }
    return result_unwrap(value)
}

fn is_option_type(type_name: String) -> Bool {
    return starts_with(type_name, "Option[") && ends_with(type_name, "]")
}

fn is_result_type(type_name: String) -> Bool {
    return starts_with(type_name, "Result[") && ends_with(type_name, "]")
}

fn is_array_type(type_name: String) -> Bool {
    return starts_with(type_name, "Array[") && ends_with(type_name, "]")
}

fn generic_value(type_name: String, prefix: String) -> String {
    if !starts_with(type_name, prefix) { return "" }
    let chars: Array[String] = string_chars(type_name)
    let start: Int = len(string_chars(prefix))
    let mut index: Int = start
    let mut depth: Int = 0
    let mut comma: Int = -1
    while index < len(chars) - 1 {
        let current: String = char_at(chars, index)
        if current == "[" {
            depth = depth + 1
        } else if current == "]" {
            if depth > 0 { depth = depth - 1 }
        } else if current == "," && depth == 0 {
            comma = index
            break
        }
        index = index + 1
    }
    if comma < 0 { return "" }
    let value: Result[String, String] = substring(type_name, comma + 1, len(chars) - comma - 2)
    if is_err(value) { return "" }
    return result_unwrap(value)
}

fn array_inner(type_name: String) -> String {
    return generic_inner(type_name, "Array[")
}

fn is_generic_builtin(name: String) -> Bool {
    return name == "assert" || name == "assert_eq" || name == "contains" || name == "starts_with" || name == "ends_with" || name == "string_chars" || name == "substring" || name == "str" || name == "int" || name == "some" || name == "none" || name == "ok" || name == "err" || name == "is_some" || name == "is_none" || name == "is_ok" || name == "is_err" || name == "unwrap_or" || name == "result_unwrap" || name == "result_error" || name == "len" || name == "array_push" || name == "array_get" || name == "array_concat" || name == "array_indices" || name == "array_set" || name == "array_slice" || name == "bytes" || name == "bytes_from_u8" || name == "u8_array" || name == "string_to_bytes" || name == "process_args" || name == "fs_read_text" || name == "fs_write_bytes" || name == "json_parse" || name == "json_stringify" || name == "json_kind" || name == "json_array_len" || name == "json_object_get" || name == "json_array_get" || name == "json_string" || name == "json_bool" || name == "json_int" || name == "json_uint" || name == "map_get" || name == "map_insert" || name == "map_contains_key" || name == "map_remove" || name == "print" || name == "println"
}

fn const_json(type_name: String, display: String) -> String {
    if type_name == "Int" {
        return "{\"kind\":\"int\",\"int\":" + display + "}"
    }
    if type_name == "Bool" {
        return "{\"kind\":\"bool\",\"bool\":" + display + "}"
    }
    if type_name == "String" {
        return "{\"kind\":\"string\",\"string\":" + json_quote(display) + "}"
    }
    return "null"
}

fn literal_int(value: Int) -> SourceExpr {
    let display: String = str(value)
    return SourceExpr{
        json: "{\"kind\":\"int\",\"type\":\"Int\",\"const\":" + const_json("Int", display) + ",\"int\":" + display + "}",
        type_name: "Int",
        known: true,
        display: display,
    }
}

fn literal_bool(value: Bool) -> SourceExpr {
    let display: String = bool_text(value)
    return SourceExpr{
        json: "{\"kind\":\"bool\",\"type\":\"Bool\",\"const\":" + const_json("Bool", display) + ",\"bool\":" + display + "}",
        type_name: "Bool",
        known: true,
        display: display,
    }
}

fn literal_string(value: String) -> SourceExpr {
    return SourceExpr{
        json: "{\"kind\":\"string\",\"type\":\"String\",\"const\":" + const_json("String", value) + ",\"string\":" + json_quote(value) + "}",
        type_name: "String",
        known: true,
        display: value,
    }
}

fn apply_empty_type(expression: SourceExpr, expected: String) -> SourceExpr {
    if is_array_type(expected) && expression.json == "{\"kind\":\"array\",\"type\":\"Array[Int]\",\"const\":null,\"items\":[]}" {
        return SourceExpr{ json: "{\"kind\":\"array\",\"type\":" + json_quote(expected) + ",\"const\":null,\"items\":[]}", type_name: expected, known: expression.known, display: expression.display }
    }
    if starts_with(expected, "Map[") && expression.json == "{\"kind\":\"map\",\"type\":\"Map[String,Int]\",\"const\":null,\"map_keys\":[],\"values\":[]}" {
        return SourceExpr{ json: "{\"kind\":\"map\",\"type\":" + json_quote(expected) + ",\"const\":null,\"map_keys\":[],\"values\":[]}", type_name: expected, known: expression.known, display: expression.display }
    }
    if is_result_type(expected) && is_result_type(expression.type_name) && generic_error(expected) == generic_error(expression.type_name) && expression.display != "" {
        let updated_json: String = "{\"kind\":\"call\",\"type\":" + json_quote(expected) + ",\"const\":null,\"name\":\"err\",\"call_target\":\"builtin:err\",\"args\":" + expression.display + "}"
        return SourceExpr{ json: updated_json, type_name: expected, known: expression.known, display: "" }
    }
    return expression
}

fn variable_expr(name: String, binding: SourceBinding) -> SourceExpr {
    let mut constant: String = "null"
    if binding.known {
        constant = const_json(binding.type_name, binding.display)
    }
    return SourceExpr{
        json: "{\"kind\":\"var\",\"type\":" + json_quote(binding.type_name) + ",\"const\":" + constant + ",\"name\":" + json_quote(name) + "}",
        type_name: binding.type_name,
        known: binding.known,
        display: binding.display,
    }
}

fn combine_values(left: SourceExpr, operator: String, right: SourceExpr) -> Result[SourceExpr, String] {
    if operator == "+" && left.type_name == "String" && right.type_name == "String" {
        let known: Bool = left.known && right.known
        let mut display: String = ""
        let mut constant: String = "null"
        if known {
            display = left.display + right.display
            constant = const_json("String", display)
        }
        return ok(SourceExpr{
            json: "{\"kind\":\"binary\",\"type\":\"String\",\"const\":" + constant + ",\"operator\":\"+\",\"left\":" + left.json + ",\"right\":" + right.json + "}",
            type_name: "String",
            known: known,
            display: display,
        })
    }
    if operator == "<<" || operator == ">>" {
        if !starts_with(left.type_name, "UInt") || right.type_name != "Int" {
            return err("parser: shifts require a UInt value and an Int count")
        }
        return ok(SourceExpr{
            json: "{\"kind\":\"binary\",\"type\":" + json_quote(left.type_name) + ",\"const\":null,\"operator\":" + json_quote(operator) + ",\"left\":" + left.json + ",\"right\":" + right.json + "}",
            type_name: left.type_name,
            known: false,
            display: "",
        })
    }
    if left.type_name != right.type_name {
        return err("parser: binary operands must have the same type")
    }
    if operator == "+" && is_array_type(left.type_name) {
        return ok(SourceExpr{
            json: "{\"kind\":\"binary\",\"type\":" + json_quote(left.type_name) + ",\"const\":null,\"operator\":\"+\",\"left\":" + left.json + ",\"right\":" + right.json + "}",
            type_name: left.type_name,
            known: false,
            display: "",
        })
    }
    if left.type_name == "String" && (operator == "==" || operator == "!=") {
        let known: Bool = left.known && right.known
        let mut equal: Bool = left.display == right.display
        let mut constant: String = "null"
        if known {
            if operator == "!=" { equal = !equal }
            constant = const_json("Bool", bool_text(equal))
        }
        return ok(SourceExpr{
            json: "{\"kind\":\"binary\",\"type\":\"Bool\",\"const\":" + constant + ",\"operator\":" + json_quote(operator) + ",\"left\":" + left.json + ",\"right\":" + right.json + "}",
            type_name: "Bool",
            known: known,
            display: bool_text(equal),
        })
    }
    if left.type_name == "String" {
        return err("parser: String supports only + and equality")
    }
    if left.type_name != "Int" && left.type_name != "Bool" && !starts_with(left.type_name, "UInt") {
        return err("parser: unsupported binary operand type '" + left.type_name + "'")
    }
    if left.type_name == "Bool" && operator != "==" && operator != "!=" && operator != "&&" && operator != "||" {
        return err("parser: Bool supports only equality and logical operators")
    }
    if (operator == "&" || operator == "|" || operator == "^") && !starts_with(left.type_name, "UInt") {
        return err("parser: bitwise operands must be UInt values")
    }
    if (left.type_name == "Int" || starts_with(left.type_name, "UInt")) && (operator == "&&" || operator == "||") {
        return err("parser: logical operators require Bool operands")
    }
    let mut known: Bool = left.known && right.known
    if starts_with(left.type_name, "UInt") { known = false }
    let mut result_type: String = left.type_name
    let mut display: String = ""
    if operator == "==" || operator == "!=" || operator == "<" || operator == "<=" || operator == ">" || operator == ">=" || operator == "&&" || operator == "||" {
        result_type = "Bool"
    }
    if known {
        if left.type_name == "Int" {
            let a: Int = int(left.display)
            let b: Int = int(right.display)
            if (operator == "/" || operator == "%") && b == 0 {
                return err("parser: division by zero")
            }
            if operator == "+" { display = str(a + b) }
            else if operator == "-" { display = str(a - b) }
            else if operator == "*" { display = str(a * b) }
            else if operator == "/" { display = str(a / b) }
            else if operator == "%" { display = str(a % b) }
            else if operator == "==" { display = bool_text(a == b) }
            else if operator == "!=" { display = bool_text(a != b) }
            else if operator == "<" { display = bool_text(a < b) }
            else if operator == "<=" { display = bool_text(a <= b) }
            else if operator == ">" { display = bool_text(a > b) }
            else if operator == ">=" { display = bool_text(a >= b) }
            else { known = false }
        } else {
            if operator == "==" { display = bool_text(left.display == right.display) }
            else if operator == "!=" { display = bool_text(left.display != right.display) }
            else if operator == "&&" { display = bool_text(left.display == "true" && right.display == "true") }
            else if operator == "||" { display = bool_text(left.display == "true" || right.display == "true") }
            else { known = false }
        }
    }
    let mut constant: String = "null"
    if known {
        constant = const_json(result_type, display)
    }
    return ok(SourceExpr{
        json: "{\"kind\":\"binary\",\"type\":" + json_quote(result_type) + ",\"const\":" + constant + ",\"operator\":" + json_quote(operator) + ",\"left\":" + left.json + ",\"right\":" + right.json + "}",
        type_name: result_type,
        known: known,
        display: display,
    })
}

fn parse_struct_literal(parser: SourceParser, type_name: String) -> Result[ParsedExpr, String] {
    let definition: Option[SourceStruct] = map_get(parser.structs, type_name)
    if is_none(definition) { return err("parser: unknown struct '" + type_name + "'") }
    let shape: SourceStruct = unwrap_or(definition, SourceStruct{ fields: {}, names: [] })
    let opened: Result[SourceParser, String] = expect(parser, "{")
    if is_err(opened) { return err(parser_error(opened)) }
    let mut current: SourceParser = skip_separators(result_unwrap(opened))
    let mut names: String = "["
    let mut values: String = "["
    let mut seen: Map[String, Bool] = {}
    let mut first: Bool = true
    let mut count: Int = 0
    while current_token(current).text != "}" {
        let field_name: SourceToken = current_token(current)
        if field_name.kind != "identifier" { return err("parser: expected a struct field name in literal") }
        if !map_contains_key(shape.fields, field_name.text) { return err("parser: unknown field '" + field_name.text + "' in struct '" + type_name + "'") }
        if map_contains_key(seen, field_name.text) { return err("parser: duplicate field '" + field_name.text + "' in struct literal") }
        let colon: Result[SourceParser, String] = expect(advance(current), ":")
        if is_err(colon) { return err(parser_error(colon)) }
        let parsed_value: Result[ParsedExpr, String] = parse_expression(result_unwrap(colon))
        if is_err(parsed_value) { return err(source_expression_error(parsed_value)) }
        let value: ParsedExpr = result_unwrap(parsed_value)
        let expected: String = unwrap_or(map_get(shape.fields, field_name.text), "")
        let field_value: SourceExpr = apply_empty_type(value.expression, expected)
        if field_value.type_name != expected { return err("parser: struct field '" + field_name.text + "' expects " + expected) }
        if !first {
            names = names + ","
            values = values + ","
        }
        names = names + json_quote(field_name.text)
        values = values + field_value.json
        first = false
        count = count + 1
        seen = map_insert(seen, field_name.text, true)
        current = skip_separators(value.parser)
        if current_token(current).text == "," {
            current = skip_separators(advance(current))
        } else if current_token(current).text != "}" {
            return err("parser: expected ',' or '}' after struct literal field")
        }
    }
    if count != len(shape.names) { return err("parser: struct literal for '" + type_name + "' is missing a field") }
    let mut index: Int = 0
    while index < len(shape.names) {
        let expected_name: String = unwrap_or(array_get(shape.names, index), "")
        if !map_contains_key(seen, expected_name) { return err("parser: struct literal for '" + type_name + "' is missing field '" + expected_name + "'") }
        index = index + 1
    }
    let closed: Result[SourceParser, String] = expect(current, "}")
    if is_err(closed) { return err(parser_error(closed)) }
    let json: String = "{\"kind\":\"struct\",\"type\":" + json_quote(type_name) + ",\"const\":null,\"struct_name\":" + json_quote(type_name) + ",\"fields\":" + names + "],\"values\":" + values + "]}"
    return ok(ParsedExpr{ parser: result_unwrap(closed), expression: SourceExpr{ json: json, type_name: type_name, known: false, display: "" } })
}

fn parse_primary(parser: SourceParser) -> Result[ParsedExpr, String] {
    let token: SourceToken = current_token(parser)
    if token.kind == "string" {
        return ok(ParsedExpr{ parser: advance(parser), expression: literal_string(token.text) })
    }
    if token.kind == "integer" {
        return ok(ParsedExpr{ parser: advance(parser), expression: literal_int(int(token.text)) })
    }
    if token.text == "true" || token.text == "false" {
        return ok(ParsedExpr{ parser: advance(parser), expression: literal_bool(token.text == "true") })
    }
    if token.text == "nil" {
        return ok(ParsedExpr{ parser: advance(parser), expression: SourceExpr{ json: "{\"kind\":\"nil\",\"type\":\"Nil\",\"const\":null}", type_name: "Nil", known: true, display: "" } })
    }
    if token.text == "(" {
        let nested: Result[ParsedExpr, String] = parse_expression(advance(parser))
        if is_err(nested) { return err(source_expression_error(nested)) }
        let parsed: ParsedExpr = result_unwrap(nested)
        let closed: Result[SourceParser, String] = expect(parsed.parser, ")")
        if is_err(closed) { return err(parser_error(closed)) }
        return ok(ParsedExpr{ parser: result_unwrap(closed), expression: parsed.expression })
    }
    if token.kind == "identifier" {
        let after_name: SourceParser = advance(parser)
        if current_token(after_name).text == "(" {
            let mut return_type: String = ""
            let mut expected: Array[String] = []
            let mut call_target: String = ""
            let mut builtin_generic: Bool = false
            let mut builtin_unsigned_conversion: Bool = false
            if token.text == "u8" || token.text == "u16" || token.text == "u32" || token.text == "u64" {
                if token.text == "u8" { return_type = "UInt8" }
                else if token.text == "u16" { return_type = "UInt16" }
                else if token.text == "u32" { return_type = "UInt32" }
                else { return_type = "UInt64" }
                call_target = "builtin:" + token.text
                builtin_unsigned_conversion = true
            } else if is_generic_builtin(token.text) {
                call_target = "builtin:" + token.text
                builtin_generic = true
            } else {
                let signature: Option[SourceFunction] = map_get(parser.functions, token.text)
                if is_none(signature) { return err("parser: unknown function '" + token.text + "'") }
                let found: SourceFunction = unwrap_or(signature, SourceFunction{ return_type: "", parameters: [] })
                return_type = found.return_type
                expected = found.parameters
                call_target = "function:" + token.text
            }
            let mut current: SourceParser = advance(after_name)
            let mut args: String = "["
            let mut argument_types: Array[String] = []
            let mut first: Bool = true
            let mut argument_index: Int = 0
            while current_token(current).kind != "symbol" || current_token(current).text != ")" {
                let argument: Result[ParsedExpr, String] = parse_expression(current)
                if is_err(argument) { return err(source_expression_error(argument)) }
                let parsed_argument: ParsedExpr = result_unwrap(argument)
                let mut argument_expression: SourceExpr = parsed_argument.expression
                if token.text == "unwrap_or" && argument_index == 1 {
                    let option_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if is_option_type(option_type) {
                        argument_expression = apply_empty_type(argument_expression, generic_inner(option_type, "Option["))
                    }
                }
                if !builtin_generic && !builtin_unsigned_conversion {
                    if argument_index >= len(expected) { return err("parser: too many function arguments") }
                    if argument_expression.type_name != unwrap_or(array_get(expected, argument_index), "") {
                        return err("parser: function '" + token.text + "' argument " + str(argument_index) + " expects '" + unwrap_or(array_get(expected, argument_index), "") + "', got '" + argument_expression.type_name + "'")
                    }
                }
                if !first { args = args + "," }
                args = args + argument_expression.json
                argument_types = array_push(argument_types, argument_expression.type_name)
                first = false
                argument_index = argument_index + 1
                current = parsed_argument.parser
                if current_token(current).text == "," {
                    current = advance(current)
                } else if current_token(current).text != ")" {
                    return err("parser: expected ',' or ')' after function argument")
                }
            }
            if builtin_unsigned_conversion {
                if argument_index != 1 { return err("parser: unsigned conversion expects one argument") }
                let argument_type: String = unwrap_or(array_get(argument_types, 0), "")
                if argument_type != "Int" && !starts_with(argument_type, "UInt") { return err("parser: unsigned conversion expects Int or UInt") }
            }
            if !builtin_generic && !builtin_unsigned_conversion && argument_index != len(expected) { return err("parser: function '" + token.text + "' expects " + str(len(expected)) + " arguments, got " + str(argument_index)) }
            if builtin_generic {
                if token.text == "assert" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Bool" { return err("parser: assert expects one Bool") }
                    return_type = "Nil"
                } else if token.text == "assert_eq" {
                    if argument_index != 2 || unwrap_or(array_get(argument_types, 0), "") != unwrap_or(array_get(argument_types, 1), "") { return err("parser: assert_eq expects matching values") }
                    let asserted_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if asserted_type != "Int" && asserted_type != "Bool" && !starts_with(asserted_type, "UInt") { return err("parser: assert_eq supports Int, UInt, and Bool") }
                    return_type = "Nil"
                } else if token.text == "contains" || token.text == "starts_with" || token.text == "ends_with" {
                    if argument_index != 2 || unwrap_or(array_get(argument_types, 0), "") != "String" || unwrap_or(array_get(argument_types, 1), "") != "String" { return err("parser: string predicate expects two String arguments") }
                    return_type = "Bool"
                } else if token.text == "string_chars" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "String" { return err("parser: string_chars expects one String") }
                    return_type = "Array[String]"
                } else if token.text == "substring" {
                    if argument_index != 3 || unwrap_or(array_get(argument_types, 0), "") != "String" || unwrap_or(array_get(argument_types, 1), "") != "Int" || unwrap_or(array_get(argument_types, 2), "") != "Int" { return err("parser: substring expects String, Int, Int") }
                    return_type = "Result[String,String]"
                } else if token.text == "str" {
                    if argument_index != 1 { return err("parser: str expects one argument") }
                    return_type = "String"
                } else if token.text == "int" {
                    if argument_index != 1 || (unwrap_or(array_get(argument_types, 0), "") != "String" && unwrap_or(array_get(argument_types, 0), "") != "Int" && unwrap_or(array_get(argument_types, 0), "") != "Bool") { return err("parser: int expects String, Int, or Bool") }
                    return_type = "Int"
                } else if token.text == "none" {
                    if argument_index != 0 { return err("parser: none expects no arguments") }
                    return_type = "Option[Int]"
                } else if token.text == "some" {
                    if argument_index != 1 { return err("parser: some expects one argument") }
                    return_type = "Option[" + unwrap_or(array_get(argument_types, 0), "") + "]"
                } else if token.text == "ok" {
                    if argument_index != 1 { return err("parser: ok expects one argument") }
                    return_type = "Result[" + unwrap_or(array_get(argument_types, 0), "") + ",String]"
                } else if token.text == "err" {
                    if argument_index != 1 { return err("parser: err expects one argument") }
                    return_type = "Result[Int," + unwrap_or(array_get(argument_types, 0), "") + "]"
                } else if token.text == "is_some" || token.text == "is_none" {
                    if argument_index != 1 || !is_option_type(unwrap_or(array_get(argument_types, 0), "")) { return err("parser: Option predicate expects one Option argument") }
                    return_type = "Bool"
                } else if token.text == "is_ok" || token.text == "is_err" {
                    if argument_index != 1 || !is_result_type(unwrap_or(array_get(argument_types, 0), "")) { return err("parser: Result predicate expects one Result argument") }
                    return_type = "Bool"
                } else if token.text == "unwrap_or" {
                    let option_type: String = unwrap_or(array_get(argument_types, 0), "")
                    let fallback_type: String = unwrap_or(array_get(argument_types, 1), "")
                    if argument_index != 2 || !is_option_type(option_type) { return err("parser: unwrap_or expects an Option and a fallback, got '" + option_type + "'") }
                    let option_inner: String = generic_inner(option_type, "Option[")
                    if option_inner != fallback_type { return err("parser: unwrap_or fallback type '" + fallback_type + "' does not match Option[" + option_inner + "]") }
                    return_type = fallback_type
                } else if token.text == "result_unwrap" {
                    let result_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if argument_index != 1 || !is_result_type(result_type) { return err("parser: result_unwrap expects one Result, got '" + result_type + "'") }
                    return_type = generic_inner(result_type, "Result[")
                } else if token.text == "result_error" {
                    if argument_index != 1 || !is_result_type(unwrap_or(array_get(argument_types, 0), "")) { return err("parser: result_error expects one Result") }
                    return_type = "Option[" + generic_error(unwrap_or(array_get(argument_types, 0), "")) + "]"
                } else if token.text == "len" {
                    if argument_index != 1 || !is_array_type(unwrap_or(array_get(argument_types, 0), "")) { return err("parser: len expects one Array") }
                    return_type = "Int"
                } else if token.text == "array_push" {
                    if argument_index != 2 || !is_array_type(unwrap_or(array_get(argument_types, 0), "")) { return err("parser: array_push expects an Array and a value") }
                    if array_inner(unwrap_or(array_get(argument_types, 0), "")) != unwrap_or(array_get(argument_types, 1), "") { return err("parser: array_push element type does not match Array") }
                    return_type = unwrap_or(array_get(argument_types, 0), "")
                } else if token.text == "array_get" {
                    if argument_index != 2 || !is_array_type(unwrap_or(array_get(argument_types, 0), "")) || unwrap_or(array_get(argument_types, 1), "") != "Int" { return err("parser: array_get expects an Array and an Int index") }
                    return_type = "Option[" + array_inner(unwrap_or(array_get(argument_types, 0), "")) + "]"
                } else if token.text == "array_concat" {
                    if argument_index != 2 || !is_array_type(unwrap_or(array_get(argument_types, 0), "")) || unwrap_or(array_get(argument_types, 0), "") != unwrap_or(array_get(argument_types, 1), "") { return err("parser: array_concat expects matching Arrays") }
                    return_type = unwrap_or(array_get(argument_types, 0), "")
                } else if token.text == "array_indices" {
                    if argument_index != 1 || !is_array_type(unwrap_or(array_get(argument_types, 0), "")) { return err("parser: array_indices expects one Array") }
                    return_type = "Array[Int]"
                } else if token.text == "array_set" {
                    let array_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if argument_index != 3 || !is_array_type(array_type) || unwrap_or(array_get(argument_types, 1), "") != "Int" || array_inner(array_type) != unwrap_or(array_get(argument_types, 2), "") { return err("parser: array_set expects Array[T], Int, and T") }
                    return_type = "Result[" + array_type + ",String]"
                } else if token.text == "array_slice" {
                    let array_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if argument_index != 3 || !is_array_type(array_type) || unwrap_or(array_get(argument_types, 1), "") != "Int" || unwrap_or(array_get(argument_types, 2), "") != "Int" { return err("parser: array_slice expects Array[T] and two Int indexes") }
                    return_type = array_type
                } else if token.text == "bytes" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Array[Int]" { return err("parser: bytes expects Array[Int]") }
                    return_type = "Bytes"
                } else if token.text == "bytes_from_u8" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Array[UInt8]" { return err("parser: bytes_from_u8 expects Array[UInt8]") }
                    return_type = "Bytes"
                } else if token.text == "u8_array" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Bytes" { return err("parser: u8_array expects Bytes") }
                    return_type = "Array[UInt8]"
                } else if token.text == "string_to_bytes" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "String" { return err("parser: string_to_bytes expects String") }
                    return_type = "Bytes"
                } else if token.text == "process_args" {
                    if argument_index != 0 { return err("parser: process_args expects no arguments") }
                    return_type = "Array[String]"
                } else if token.text == "fs_read_text" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "String" { return err("parser: fs_read_text expects String") }
                    return_type = "Result[String,String]"
                } else if token.text == "fs_write_bytes" {
                    if argument_index != 2 || unwrap_or(array_get(argument_types, 0), "") != "String" || unwrap_or(array_get(argument_types, 1), "") != "Bytes" { return err("parser: fs_write_bytes expects String and Bytes") }
                    return_type = "Result[Nil,String]"
                } else if token.text == "json_parse" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "String" { return err("parser: json_parse expects String") }
                    return_type = "Result[Json,String]"
                } else if token.text == "json_stringify" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Json" { return err("parser: json_stringify expects Json") }
                    return_type = "String"
                } else if token.text == "json_kind" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Json" { return err("parser: json_kind expects Json") }
                    return_type = "String"
                } else if token.text == "json_array_len" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Json" { return err("parser: json_array_len expects Json") }
                    return_type = "Result[Int,String]"
                } else if token.text == "json_object_get" {
                    if argument_index != 2 || unwrap_or(array_get(argument_types, 0), "") != "Json" || unwrap_or(array_get(argument_types, 1), "") != "String" { return err("parser: json_object_get expects Json and String") }
                    return_type = "Result[Json,String]"
                } else if token.text == "json_array_get" {
                    if argument_index != 2 || unwrap_or(array_get(argument_types, 0), "") != "Json" || unwrap_or(array_get(argument_types, 1), "") != "Int" { return err("parser: json_array_get expects Json and Int") }
                    return_type = "Result[Json,String]"
                } else if token.text == "json_string" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Json" { return err("parser: json_string expects Json") }
                    return_type = "Result[String,String]"
                } else if token.text == "json_bool" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Json" { return err("parser: json_bool expects Json") }
                    return_type = "Result[Bool,String]"
                } else if token.text == "json_int" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Json" { return err("parser: json_int expects Json") }
                    return_type = "Result[Int,String]"
                } else if token.text == "json_uint" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Json" { return err("parser: json_uint expects Json") }
                    return_type = "Result[UInt64,String]"
                } else if token.text == "map_get" {
                    let map_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if argument_index != 2 || !starts_with(map_type, "Map[") || generic_inner(map_type, "Map[") != unwrap_or(array_get(argument_types, 1), "") { return err("parser: map_get expects Map[K,V] and K") }
                    return_type = "Option[" + generic_value(map_type, "Map[") + "]"
                } else if token.text == "map_insert" {
                    let map_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if argument_index != 3 || !starts_with(map_type, "Map[") || generic_inner(map_type, "Map[") != unwrap_or(array_get(argument_types, 1), "") || generic_value(map_type, "Map[") != unwrap_or(array_get(argument_types, 2), "") { return err("parser: map_insert expects Map[K,V], K, and V") }
                    return_type = map_type
                } else if token.text == "map_contains_key" {
                    let map_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if argument_index != 2 || !starts_with(map_type, "Map[") || generic_inner(map_type, "Map[") != unwrap_or(array_get(argument_types, 1), "") { return err("parser: map_contains_key expects Map[K,V] and K") }
                    return_type = "Bool"
                } else if token.text == "map_remove" {
                    let map_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if argument_index != 2 || !starts_with(map_type, "Map[") || generic_inner(map_type, "Map[") != unwrap_or(array_get(argument_types, 1), "") { return err("parser: map_remove expects Map[K,V] and K") }
                    return_type = map_type
                } else if token.text == "print" || token.text == "println" {
                    if argument_index != 1 { return err("parser: print expects one argument") }
                    return_type = "Nil"
                }
            }
            let closed: Result[SourceParser, String] = expect(current, ")")
            if is_err(closed) { return err(parser_error(closed)) }
            let json: String = "{\"kind\":\"call\",\"type\":" + json_quote(return_type) + ",\"const\":null,\"name\":" + json_quote(token.text) + ",\"call_target\":" + json_quote(call_target) + ",\"args\":" + args + "]}"
            let mut display: String = ""
            if token.text == "err" { display = args + "]" }
            return ok(ParsedExpr{ parser: result_unwrap(closed), expression: SourceExpr{ json: json, type_name: return_type, known: false, display: display } })
        }
        if current_token(after_name).text == "{" && map_contains_key(parser.structs, token.text) {
            return parse_struct_literal(after_name, token.text)
        }
        let binding: Option[SourceBinding] = map_get(parser.bindings, token.text)
        if is_none(binding) { return err("parser: unknown identifier '" + token.text + "'") }
        return ok(ParsedExpr{ parser: after_name, expression: variable_expr(token.text, unwrap_or(binding, SourceBinding{ type_name: "", mutable: false, known: false, display: "" })) })
    }
    if token.text == "[" {
        let mut current: SourceParser = skip_separators(advance(parser))
        let mut items: String = "["
        let mut first: Bool = true
        let mut element_type: String = ""
        while current_token(current).kind != "symbol" || current_token(current).text != "]" {
            let item: Result[ParsedExpr, String] = parse_expression(current)
        if is_err(item) { return err(source_expression_error(item)) }
            let parsed_item: ParsedExpr = result_unwrap(item)
            if element_type == "" {
                element_type = parsed_item.expression.type_name
            } else if element_type != parsed_item.expression.type_name {
                return err("parser: array literal elements must have the same type")
            }
            if !first { items = items + "," }
            items = items + parsed_item.expression.json
            first = false
            current = skip_separators(parsed_item.parser)
            if current_token(current).text == "," {
                current = skip_separators(advance(current))
            } else if current_token(current).text != "]" {
                return err("parser: expected ',' or ']' after array element, found '" + current_token(current).text + "' at position " + str(current.position))
            }
        }
        current = skip_separators(current)
        let closed: Result[SourceParser, String] = expect(current, "]")
        if is_err(closed) { return err(parser_error(closed)) }
        if element_type == "" { element_type = "Int" }
        let type_name: String = "Array[" + element_type + "]"
        let json: String = "{\"kind\":\"array\",\"type\":" + json_quote(type_name) + ",\"const\":null,\"items\":" + items + "]}"
        return ok(ParsedExpr{ parser: result_unwrap(closed), expression: SourceExpr{ json: json, type_name: type_name, known: false, display: "" } })
    }
    if token.text == "{" {
        let mut current: SourceParser = skip_separators(advance(parser))
        let mut keys: String = "["
        let mut values: String = "["
        let mut first: Bool = true
        let mut key_type: String = ""
        let mut value_type: String = ""
        while current_token(current).kind != "symbol" || current_token(current).text != "}" {
            let key: Result[ParsedExpr, String] = parse_expression(current)
            if is_err(key) { return err(source_expression_error(key)) }
            let parsed_key: ParsedExpr = result_unwrap(key)
            if key_type == "" {
                key_type = parsed_key.expression.type_name
            } else if key_type != parsed_key.expression.type_name {
                return err("parser: map keys must have one homogeneous type")
            }
            if parsed_key.expression.type_name != "Int" && parsed_key.expression.type_name != "Bool" && parsed_key.expression.type_name != "String" && !starts_with(parsed_key.expression.type_name, "UInt") {
                return err("parser: map keys must be Int, UInt, Bool, or String")
            }
            let colon: Result[SourceParser, String] = expect(parsed_key.parser, ":")
            if is_err(colon) { return err(parser_error(colon)) }
            let value: Result[ParsedExpr, String] = parse_expression(result_unwrap(colon))
            if is_err(value) { return err(source_expression_error(value)) }
            let parsed_value: ParsedExpr = result_unwrap(value)
            if value_type == "" {
                value_type = parsed_value.expression.type_name
            } else if value_type != parsed_value.expression.type_name {
                return err("parser: map values must have one homogeneous type")
            }
            if !first {
                keys = keys + ","
                values = values + ","
            }
            keys = keys + parsed_key.expression.json
            values = values + parsed_value.expression.json
            first = false
            current = skip_separators(parsed_value.parser)
            if current_token(current).text == "," {
                current = skip_separators(advance(current))
            } else if current_token(current).text != "}" {
                return err("parser: expected ',' or '}' after map entry")
            }
        }
        let closed: Result[SourceParser, String] = expect(current, "}")
        if is_err(closed) { return err(parser_error(closed)) }
        if key_type == "" {
            key_type = "String"
            value_type = "Int"
        }
        let type_name: String = "Map[" + key_type + "," + value_type + "]"
        let json: String = "{\"kind\":\"map\",\"type\":" + json_quote(type_name) + ",\"const\":null,\"map_keys\":" + keys + "],\"values\":" + values + "]}"
        return ok(ParsedExpr{ parser: result_unwrap(closed), expression: SourceExpr{ json: json, type_name: type_name, known: false, display: "" } })
    }
    return err("parser: expected a literal, identifier, or parenthesized expression; found " + token.kind + " '" + token.text + "'")
}

fn parse_postfix(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_primary(parser)
    if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "[" || current_token(parsed.parser).text == "." {
        if current_token(parsed.parser).text == "." {
            let field_token: SourceToken = current_token(advance(parsed.parser))
            if field_token.kind != "identifier" { return err("parser: expected a struct field name after '.'") }
            let field_type: String = source_struct_field_type(parsed.parser, parsed.expression.type_name, field_token.text)
            if field_type == "" { return err("parser: unknown field '" + field_token.text + "' in struct '" + parsed.expression.type_name + "'") }
            let json: String = "{\"kind\":\"field\",\"type\":" + json_quote(field_type) + ",\"const\":null,\"base\":" + parsed.expression.json + ",\"field\":" + json_quote(field_token.text) + "}"
            parsed = ParsedExpr{ parser: advance(advance(parsed.parser)), expression: SourceExpr{ json: json, type_name: field_type, known: false, display: "" } }
            continue
        }
        let index: Result[ParsedExpr, String] = parse_expression(advance(parsed.parser))
        if is_err(index) { return err(source_expression_error(index)) }
        let parsed_index: ParsedExpr = result_unwrap(index)
        if parsed_index.expression.type_name != "Int" { return err("parser: array index must be Int") }
        let closed: Result[SourceParser, String] = expect(parsed_index.parser, "]")
        if is_err(closed) { return err(parser_error(closed)) }
        if !is_array_type(parsed.expression.type_name) { return err("parser: indexing requires Array[T]") }
        let type_name: String = array_inner(parsed.expression.type_name)
        let json: String = "{\"kind\":\"index\",\"type\":" + json_quote(type_name) + ",\"const\":null,\"left\":" + parsed_index.expression.json + ",\"base\":" + parsed.expression.json + "}"
        parsed = ParsedExpr{ parser: result_unwrap(closed), expression: SourceExpr{ json: json, type_name: type_name, known: false, display: "" } }
    }
    return ok(parsed)
}

fn parse_unary(parser: SourceParser) -> Result[ParsedExpr, String] {
    let token: SourceToken = current_token(parser)
    if token.kind != "symbol" || (token.text != "-" && token.text != "!") {
        return parse_postfix(parser)
    }
    let nested: Result[ParsedExpr, String] = parse_unary(advance(parser))
    if is_err(nested) { return err(source_expression_error(nested)) }
    let parsed: ParsedExpr = result_unwrap(nested)
    if token.text == "-" && parsed.expression.type_name != "Int" {
        return err("parser: unary '-' expects Int")
    }
    if token.text == "!" && parsed.expression.type_name != "Bool" {
        return err("parser: unary '!' expects Bool")
    }
    let mut known: Bool = parsed.expression.known
    let mut display: String = ""
    if known {
        if token.text == "-" { display = str(0 - int(parsed.expression.display)) }
        else { display = bool_text(parsed.expression.display != "true") }
    }
    let type_name: String = parsed.expression.type_name
    let mut constant: String = "null"
    if known { constant = const_json(type_name, display) }
    let json: String = "{\"kind\":\"unary\",\"type\":" + json_quote(type_name) + ",\"const\":" + constant + ",\"operator\":" + json_quote(token.text) + ",\"operand\":" + parsed.expression.json + "}"
    return ok(ParsedExpr{ parser: parsed.parser, expression: SourceExpr{ json: json, type_name: type_name, known: known, display: display } })
}

fn parse_multiplication(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_unary(parser)
    if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "*" || current_token(parsed.parser).text == "/" || current_token(parsed.parser).text == "%" {
        let operator: String = current_token(parsed.parser).text
        let right_result: Result[ParsedExpr, String] = parse_unary(advance(parsed.parser))
        if is_err(right_result) { return err(source_expression_error(right_result)) }
        let right: ParsedExpr = result_unwrap(right_result)
        let combined: Result[SourceExpr, String] = combine_values(parsed.expression, operator, right.expression)
        if is_err(combined) { return err(unwrap_or(result_error(combined), "parser: binary expression failed")) }
        parsed = ParsedExpr{ parser: right.parser, expression: result_unwrap(combined) }
    }
    return ok(parsed)
}

fn parse_addition(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_multiplication(parser)
    if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "+" || current_token(parsed.parser).text == "-" {
        let operator: String = current_token(parsed.parser).text
        let right_result: Result[ParsedExpr, String] = parse_multiplication(advance(parsed.parser))
        if is_err(right_result) { return err(source_expression_error(right_result)) }
        let right: ParsedExpr = result_unwrap(right_result)
        let combined: Result[SourceExpr, String] = combine_values(parsed.expression, operator, right.expression)
        if is_err(combined) { return err(unwrap_or(result_error(combined), "parser: binary expression failed")) }
        parsed = ParsedExpr{ parser: right.parser, expression: result_unwrap(combined) }
    }
    return ok(parsed)
}

fn parse_shift(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_addition(parser)
    if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "<<" || current_token(parsed.parser).text == ">>" {
        let operator: String = current_token(parsed.parser).text
        let right_result: Result[ParsedExpr, String] = parse_addition(advance(parsed.parser))
        if is_err(right_result) { return err(source_expression_error(right_result)) }
        let right: ParsedExpr = result_unwrap(right_result)
        let combined: Result[SourceExpr, String] = combine_values(parsed.expression, operator, right.expression)
        if is_err(combined) { return err(unwrap_or(result_error(combined), "parser: comparison failed")) }
        parsed = ParsedExpr{ parser: right.parser, expression: result_unwrap(combined) }
    }
    return ok(parsed)
}

fn parse_bitand(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_shift(parser)
    if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "&" {
        let right_result: Result[ParsedExpr, String] = parse_shift(advance(parsed.parser))
        if is_err(right_result) { return err(source_expression_error(right_result)) }
        let right: ParsedExpr = result_unwrap(right_result)
        let combined: Result[SourceExpr, String] = combine_values(parsed.expression, "&", right.expression)
        if is_err(combined) { return err(unwrap_or(result_error(combined), "parser: bitwise expression failed")) }
        parsed = ParsedExpr{ parser: right.parser, expression: result_unwrap(combined) }
    }
    return ok(parsed)
}

fn parse_bitxor(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_bitand(parser)
    if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "^" {
        let right_result: Result[ParsedExpr, String] = parse_bitand(advance(parsed.parser))
        if is_err(right_result) { return err(source_expression_error(right_result)) }
        let right: ParsedExpr = result_unwrap(right_result)
        let combined: Result[SourceExpr, String] = combine_values(parsed.expression, "^", right.expression)
        if is_err(combined) { return err(unwrap_or(result_error(combined), "parser: bitwise expression failed")) }
        parsed = ParsedExpr{ parser: right.parser, expression: result_unwrap(combined) }
    }
    return ok(parsed)
}

fn parse_bitor(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_bitxor(parser)
    if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "|" {
        let right_result: Result[ParsedExpr, String] = parse_bitxor(advance(parsed.parser))
        if is_err(right_result) { return err(source_expression_error(right_result)) }
        let right: ParsedExpr = result_unwrap(right_result)
        let combined: Result[SourceExpr, String] = combine_values(parsed.expression, "|", right.expression)
        if is_err(combined) { return err(unwrap_or(result_error(combined), "parser: bitwise expression failed")) }
        parsed = ParsedExpr{ parser: right.parser, expression: result_unwrap(combined) }
    }
    return ok(parsed)
}

fn parse_comparison(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_bitor(parser)
    if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "==" || current_token(parsed.parser).text == "!=" || current_token(parsed.parser).text == "<" || current_token(parsed.parser).text == "<=" || current_token(parsed.parser).text == ">" || current_token(parsed.parser).text == ">=" {
        let operator: String = current_token(parsed.parser).text
        let right_result: Result[ParsedExpr, String] = parse_bitor(advance(parsed.parser))
        if is_err(right_result) { return err(source_expression_error(right_result)) }
        let right: ParsedExpr = result_unwrap(right_result)
        let combined: Result[SourceExpr, String] = combine_values(parsed.expression, operator, right.expression)
        if is_err(combined) { return err(unwrap_or(result_error(combined), "parser: comparison failed")) }
        parsed = ParsedExpr{ parser: right.parser, expression: result_unwrap(combined) }
    }
    return ok(parsed)
}

fn parse_logical_and(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_comparison(parser)
        if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "&&" {
        let right_result: Result[ParsedExpr, String] = parse_comparison(advance(parsed.parser))
        if is_err(right_result) { return err(source_expression_error(right_result)) }
        let right: ParsedExpr = result_unwrap(right_result)
        let combined: Result[SourceExpr, String] = combine_values(parsed.expression, "&&", right.expression)
        if is_err(combined) { return err(unwrap_or(result_error(combined), "parser: logical expression failed")) }
        parsed = ParsedExpr{ parser: right.parser, expression: result_unwrap(combined) }
    }
    return ok(parsed)
}

fn parse_expression(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_logical_and(parser)
        if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "||" {
        let right_result: Result[ParsedExpr, String] = parse_logical_and(advance(parsed.parser))
        if is_err(right_result) { return err(source_expression_error(right_result)) }
        let right: ParsedExpr = result_unwrap(right_result)
        let combined: Result[SourceExpr, String] = combine_values(parsed.expression, "||", right.expression)
        if is_err(combined) { return err(unwrap_or(result_error(combined), "parser: logical expression failed")) }
        parsed = ParsedExpr{ parser: right.parser, expression: result_unwrap(combined) }
    }
    return ok(parsed)
}

fn skip_separators(parser: SourceParser) -> SourceParser {
    let mut current: SourceParser = parser
    while current_token(current).text == ";" {
        current = advance(current)
    }
    return current
}

fn finish_statement(parser: SourceParser) -> Result[SourceParser, String] {
    let current: SourceToken = current_token(parser)
    if current.text == ";" {
        return ok(skip_separators(parser))
    }
    if current.kind == "eof" || current.text == "}" {
        return ok(parser)
    }
    return err("parser: expected a statement separator after '" + current.text + "'")
}

fn statement_json(kind: String, body: String) -> String {
    return "{\"kind\":" + json_quote(kind) + "," + body + "}"
}

fn parse_output(parser: SourceParser) -> Result[ParsedStatements, String] {
    let name: String = current_token(parser).text
    let opened: Result[SourceParser, String] = expect(advance(parser), "(")
    if is_err(opened) { return err(parser_error(opened)) }
    let value: Result[ParsedExpr, String] = parse_expression(result_unwrap(opened))
        if is_err(value) { return err(source_expression_error(value)) }
    let parsed: ParsedExpr = result_unwrap(value)
    let closed: Result[SourceParser, String] = expect(parsed.parser, ")")
    if is_err(closed) { return err(parser_error(closed)) }
    let separated: Result[SourceParser, String] = finish_statement(result_unwrap(closed))
    if is_err(separated) { return err(parser_error(separated)) }
    let expression: String = "{\"kind\":\"call\",\"type\":\"Nil\",\"const\":null,\"name\":" + json_quote(name) + ",\"call_target\":\"builtin:" + name + "\",\"args\":[" + parsed.expression.json + "]}"
    return ok(ParsedStatements{ parser: result_unwrap(separated), json: statement_json("expr", "\"expr\":" + expression) })
}

fn parse_binding(parser: SourceParser) -> Result[ParsedStatements, String] {
    let keyword: String = current_token(parser).text
    let current: SourceParser = advance(parser)
    let mutable: Bool = keyword == "let" && current_token(current).text == "mut"
    let mut named: SourceParser = current
    if mutable {
        named = advance(current)
    }
    let name: SourceToken = current_token(named)
    if name.kind != "identifier" { return err("parser: expected a binding name") }
    let mut after_name: SourceParser = advance(named)
    let mut annotation: String = ""
    if current_token(after_name).text == ":" {
        let parsed_type: Result[ParsedType, String] = parse_type(advance(after_name))
        if is_err(parsed_type) { return err(unwrap_or(result_error(parsed_type), "parser: expected a type annotation")) }
        annotation = result_unwrap(parsed_type).name
        after_name = result_unwrap(parsed_type).parser
    }
    let equals: Result[SourceParser, String] = expect(after_name, "=")
    if is_err(equals) { return err(parser_error(equals)) }
    let value: Result[ParsedExpr, String] = parse_expression(result_unwrap(equals))
        if is_err(value) { return err(source_expression_error(value)) }
    let parsed: ParsedExpr = result_unwrap(value)
    let mut initializer: SourceExpr = apply_empty_type(parsed.expression, annotation)
    if annotation != "" && annotation != initializer.type_name {
        return err("parser: annotation for '" + name.text + "' expects '" + annotation + "', got '" + initializer.type_name + "'")
    }
    if keyword == "const" && !initializer.known {
        return err("parser: const initializer must be compile-time known")
    }
    let separated: Result[SourceParser, String] = finish_statement(parsed.parser)
    if is_err(separated) { return err(parser_error(separated)) }
    let binding: SourceBinding = SourceBinding{ type_name: initializer.type_name, mutable: mutable, known: !mutable && initializer.known, display: initializer.display }
    let mut updated_parser: SourceParser = result_unwrap(separated)
    updated_parser = SourceParser{ tokens: updated_parser.tokens, position: updated_parser.position, bindings: map_insert(updated_parser.bindings, name.text, binding), functions: updated_parser.functions, structs: updated_parser.structs }
    let body: String = "\"name\":" + json_quote(name.text) + ",\"mutable\":" + bool_text(mutable) + ",\"const\":" + bool_text(keyword == "const") + ",\"annotation\":" + json_quote(initializer.type_name) + ",\"init\":" + initializer.json
    return ok(ParsedStatements{ parser: updated_parser, json: statement_json("let", body) })
}

fn parse_assignment(parser: SourceParser) -> Result[ParsedStatements, String] {
    let target: SourceToken = current_token(parser)
    let binding: Option[SourceBinding] = map_get(parser.bindings, target.text)
    if is_none(binding) { return err("parser: unknown assignment target '" + target.text + "'") }
    let info: SourceBinding = unwrap_or(binding, SourceBinding{ type_name: "", mutable: false, known: false, display: "" })
    if !info.mutable { return err("parser: assignment target '" + target.text + "' is not mutable") }
    let equals: Result[SourceParser, String] = expect(advance(parser), "=")
    if is_err(equals) { return err(parser_error(equals)) }
    let value: Result[ParsedExpr, String] = parse_expression(result_unwrap(equals))
        if is_err(value) { return err(source_expression_error(value)) }
    let parsed: ParsedExpr = result_unwrap(value)
    let updated_expression: SourceExpr = apply_empty_type(parsed.expression, info.type_name)
    if updated_expression.type_name != info.type_name { return err("parser: assignment to '" + target.text + "' expects '" + info.type_name + "', got '" + updated_expression.type_name + "'") }
    let separated: Result[SourceParser, String] = finish_statement(parsed.parser)
    if is_err(separated) { return err(parser_error(separated)) }
    let updated: SourceParser = result_unwrap(separated)
    let replacement: SourceBinding = SourceBinding{ type_name: info.type_name, mutable: true, known: false, display: "" }
    let next: SourceParser = SourceParser{ tokens: updated.tokens, position: updated.position, bindings: map_insert(updated.bindings, target.text, replacement), functions: updated.functions, structs: updated.structs }
    let target_json: String = "{\"kind\":\"var\",\"type\":" + json_quote(info.type_name) + ",\"const\":null,\"name\":" + json_quote(target.text) + "}"
    return ok(ParsedStatements{ parser: next, json: statement_json("assign", "\"target\":" + target_json + ",\"value\":" + updated_expression.json) })
}

fn parse_call_statement(parser: SourceParser) -> Result[ParsedStatements, String] {
    let value: Result[ParsedExpr, String] = parse_expression(parser)
    if is_err(value) { return err(source_expression_error(value)) }
    let parsed: ParsedExpr = result_unwrap(value)
    if parsed.expression.type_name != "Nil" { return err("parser: scalar call result must be used in an expression") }
    let separated: Result[SourceParser, String] = finish_statement(parsed.parser)
    if is_err(separated) { return err(parser_error(separated)) }
    return ok(ParsedStatements{ parser: result_unwrap(separated), json: statement_json("expr", "\"expr\":" + parsed.expression.json) })
}

fn parse_return(parser: SourceParser) -> Result[ParsedStatements, String] {
    let mut current: SourceParser = advance(parser)
    let mut value: SourceExpr = SourceExpr{ json: "{\"kind\":\"nil\",\"type\":\"Nil\",\"const\":null}", type_name: "Nil", known: true, display: "" }
    if current_token(current).text != ";" && current_token(current).text != "}" && current_token(current).kind != "eof" {
        let parsed: Result[ParsedExpr, String] = parse_expression(current)
        if is_err(parsed) { return err(source_expression_error(parsed)) }
        let result: ParsedExpr = result_unwrap(parsed)
        value = result.expression
        current = result.parser
    }
    let separated: Result[SourceParser, String] = finish_statement(current)
    if is_err(separated) { return err(parser_error(separated)) }
    return ok(ParsedStatements{ parser: result_unwrap(separated), json: statement_json("return", "\"return\":" + value.json) })
}

fn join_json_items(items: Array[String], start: Int, end: Int) -> String {
    if end <= start { return "" }
    if end - start == 1 { return unwrap_or(array_get(items, start), "") }
    let middle: Int = start + (end - start) / 2
    let left: String = join_json_items(items, start, middle)
    let right: String = join_json_items(items, middle, end)
    if left == "" { return right }
    if right == "" { return left }
    return left + "," + right
}

fn parse_block(parser: SourceParser) -> Result[ParsedStatements, String] {
    let opened: Result[SourceParser, String] = expect(parser, "{")
    if is_err(opened) { return err(parser_error(opened)) }
    let mut current: SourceParser = skip_separators(result_unwrap(opened))
    let mut body_items: Array[String] = []
    while current_token(current).kind != "symbol" || current_token(current).text != "}" {
        if current_token(current).kind == "eof" { return err("parser: unterminated block") }
        let statement: Result[ParsedStatements, String] = parse_statement(current)
        if is_err(statement) { return err("at block token '" + current_token(current).text + "' (position " + str(current.position) + "): " + statements_error(statement)) }
        let parsed: ParsedStatements = result_unwrap(statement)
        body_items = array_push(body_items, parsed.json)
        current = skip_separators(parsed.parser)
    }
    let closed: Result[SourceParser, String] = expect(current, "}")
    if is_err(closed) { return err(parser_error(closed)) }
    let body_json: String = "[" + join_json_items(body_items, 0, len(body_items)) + "]"
    return ok(ParsedStatements{ parser: result_unwrap(closed), json: body_json })
}

fn parse_function_header(parser: SourceParser) -> Result[ParsedFunctionHeader, String] {
    let opened: Result[SourceParser, String] = expect(parser, "fn")
    if is_err(opened) { return err(parser_error(opened)) }
    let named: SourceParser = result_unwrap(opened)
    let name: SourceToken = current_token(named)
    if name.kind != "identifier" { return err("parser: expected a function name") }
    let parameters_open: Result[SourceParser, String] = expect(advance(named), "(")
    if is_err(parameters_open) { return err(parser_error(parameters_open)) }
    let mut current: SourceParser = result_unwrap(parameters_open)
    let mut parameter_types: Array[String] = []
    while current_token(current).text != ")" {
        let parameter_name: SourceToken = current_token(current)
        if parameter_name.kind != "identifier" { return err("parser: expected a parameter name") }
        let colon: Result[SourceParser, String] = expect(advance(current), ":")
        if is_err(colon) { return err(parser_error(colon)) }
        let parsed_type: Result[ParsedType, String] = parse_type(result_unwrap(colon))
        if is_err(parsed_type) { return err(unwrap_or(result_error(parsed_type), "parser: expected a parameter type")) }
        parameter_types = array_push(parameter_types, result_unwrap(parsed_type).name)
        current = result_unwrap(parsed_type).parser
        if current_token(current).text == "," {
            current = advance(current)
        } else if current_token(current).text != ")" {
            return err("parser: expected ',' or ')' after parameter")
        }
    }
    let closed_parameters: Result[SourceParser, String] = expect(current, ")")
    if is_err(closed_parameters) { return err(parser_error(closed_parameters)) }
    let arrow: Result[SourceParser, String] = expect(result_unwrap(closed_parameters), "->")
    if is_err(arrow) { return err(parser_error(arrow)) }
    let parsed_return: Result[ParsedType, String] = parse_type(result_unwrap(arrow))
    if is_err(parsed_return) { return err(unwrap_or(result_error(parsed_return), "parser: expected a function return type")) }
    let header: ParsedFunctionHeader = ParsedFunctionHeader{
        parser: result_unwrap(parsed_return).parser,
        name: name.text,
        signature: SourceFunction{ return_type: result_unwrap(parsed_return).name, parameters: parameter_types },
    }
    return ok(header)
}

fn skip_source_block(parser: SourceParser) -> SourceParser {
    if current_token(parser).text != "{" { return parser }
    let mut current: SourceParser = parser
    let mut depth: Int = 0
    while current_token(current).kind != "eof" {
        let token: SourceToken = current_token(current)
        if token.kind == "symbol" && token.text == "{" {
            depth = depth + 1
        } else if token.kind == "symbol" && token.text == "}" {
            depth = depth - 1
            current = advance(current)
            if depth == 0 { return current }
            continue
        }
        current = advance(current)
    }
    return current
}

fn predeclare_functions(parser: SourceParser) -> Result[SourceParser, String] {
    let mut current: SourceParser = skip_separators(parser)
    let mut functions: Map[String, SourceFunction] = parser.functions
    while current_token(current).kind != "eof" {
        let mut declaration: SourceParser = current
        if current_token(declaration).text == "pub" {
            declaration = advance(declaration)
        }
        if current_token(declaration).kind == "identifier" && current_token(declaration).text == "fn" {
            let header: Result[ParsedFunctionHeader, String] = parse_function_header(declaration)
            if is_err(header) { return err(unwrap_or(result_error(header), "parser: invalid function header")) }
            let parsed_header: ParsedFunctionHeader = result_unwrap(header)
            if current_token(parsed_header.parser).text != "{" { return err("parser: expected a function body") }
            functions = map_insert(functions, parsed_header.name, parsed_header.signature)
            current = skip_source_block(parsed_header.parser)
            continue
        }
        if current_token(current).kind == "symbol" && current_token(current).text == "{" {
            current = skip_source_block(current)
            continue
        }
        current = advance(current)
    }
    return ok(SourceParser{ tokens: parser.tokens, position: parser.position, bindings: parser.bindings, functions: functions, structs: parser.structs })
}

fn parse_function(parser: SourceParser, public: Bool) -> Result[ParsedFunction, String] {
    let opened: Result[SourceParser, String] = expect(parser, "fn")
    if is_err(opened) { return err(parser_error(opened)) }
    let named: SourceParser = result_unwrap(opened)
    let name: SourceToken = current_token(named)
    if name.kind != "identifier" { return err("parser: expected a function name") }
    let parameters_open: Result[SourceParser, String] = expect(advance(named), "(")
    if is_err(parameters_open) { return err(parser_error(parameters_open)) }
    let mut current: SourceParser = result_unwrap(parameters_open)
    let mut parameters_json: String = "["
    let mut parameter_types: Array[String] = []
    let mut local_bindings: Map[String, SourceBinding] = {}
    let mut first: Bool = true
    while current_token(current).text != ")" {
        let parameter_name: SourceToken = current_token(current)
        if parameter_name.kind != "identifier" { return err("parser: expected a parameter name") }
        let colon: Result[SourceParser, String] = expect(advance(current), ":")
        if is_err(colon) { return err(parser_error(colon)) }
        let parsed_type: Result[ParsedType, String] = parse_type(result_unwrap(colon))
        if is_err(parsed_type) { return err(unwrap_or(result_error(parsed_type), "parser: expected a parameter type")) }
        let parameter_type: String = result_unwrap(parsed_type).name
        if !source_type_supported(parser, parameter_type) { return err("parser: unsupported function parameter type '" + parameter_type + "'") }
        if !first { parameters_json = parameters_json + "," }
        parameters_json = parameters_json + "{\"name\":" + json_quote(parameter_name.text) + ",\"type\":" + json_quote(parameter_type) + ",\"default\":null}"
        parameter_types = array_push(parameter_types, parameter_type)
        local_bindings = map_insert(local_bindings, parameter_name.text, SourceBinding{ type_name: parameter_type, mutable: false, known: false, display: "" })
        current = result_unwrap(parsed_type).parser
        if current_token(current).text == "," {
            current = advance(current)
        } else if current_token(current).text != ")" {
            return err("parser: expected ',' or ')' after parameter")
        }
        first = false
    }
    let closed_parameters: Result[SourceParser, String] = expect(current, ")")
    if is_err(closed_parameters) { return err(parser_error(closed_parameters)) }
    let arrow: Result[SourceParser, String] = expect(result_unwrap(closed_parameters), "->")
    if is_err(arrow) { return err(parser_error(arrow)) }
    let parsed_return: Result[ParsedType, String] = parse_type(result_unwrap(arrow))
    if is_err(parsed_return) { return err(unwrap_or(result_error(parsed_return), "parser: expected a function return type")) }
    let return_type: String = result_unwrap(parsed_return).name
    if return_type != "Nil" && !source_type_supported(parser, return_type) { return err("parser: unsupported function return type '" + return_type + "'") }
    let signature: SourceFunction = SourceFunction{ return_type: return_type, parameters: parameter_types }
    let local_parser: SourceParser = SourceParser{ tokens: parser.tokens, position: result_unwrap(parsed_return).parser.position, bindings: local_bindings, functions: map_insert(parser.functions, name.text, signature), structs: parser.structs }
    let body: Result[ParsedStatements, String] = parse_block(local_parser)
    if is_err(body) { return err(statements_error(body)) }
    let parsed_body: ParsedStatements = result_unwrap(body)
    let outer_parser: SourceParser = SourceParser{ tokens: parser.tokens, position: parsed_body.parser.position, bindings: parser.bindings, functions: map_insert(parser.functions, name.text, signature), structs: parser.structs }
    let function_json: String = "{\"name\":" + json_quote(name.text) + ",\"public\":" + bool_text(public) + ",\"params\":" + parameters_json + "] ,\"return\":" + json_quote(return_type) + ",\"body\":" + parsed_body.json + "}"
    return ok(ParsedFunction{ parser: outer_parser, json: function_json })
}

fn parse_if(parser: SourceParser) -> Result[ParsedStatements, String] {
    let condition: Result[ParsedExpr, String] = parse_expression(advance(parser))
    if is_err(condition) { return err(source_expression_error(condition)) }
    let parsed_condition: ParsedExpr = result_unwrap(condition)
    if parsed_condition.expression.type_name != "Bool" { return err("parser: if condition must be Bool") }
    let then_block: Result[ParsedStatements, String] = parse_block(parsed_condition.parser)
    if is_err(then_block) { return err(statements_error(then_block)) }
    let parsed_then: ParsedStatements = result_unwrap(then_block)
    let mut after_then: SourceParser = skip_separators(parsed_then.parser)
    let mut else_json: String = "[]"
    if current_token(after_then).text == "else" {
        let else_start: SourceParser = advance(after_then)
        if current_token(else_start).text == "if" {
            let else_if: Result[ParsedStatements, String] = parse_if(else_start)
            if is_err(else_if) { return err(statements_error(else_if)) }
            let parsed_else_if: ParsedStatements = result_unwrap(else_if)
            else_json = "[" + parsed_else_if.json + "]"
            after_then = parsed_else_if.parser
        } else {
            let else_block: Result[ParsedStatements, String] = parse_block(else_start)
            if is_err(else_block) { return err(statements_error(else_block)) }
            let parsed_else: ParsedStatements = result_unwrap(else_block)
            else_json = parsed_else.json
            after_then = parsed_else.parser
        }
    }
    let body: String = "\"cond\":" + parsed_condition.expression.json + ",\"then\":" + parsed_then.json + ",\"else\":" + else_json
    return ok(ParsedStatements{ parser: after_then, json: statement_json("if", body) })
}

fn parse_while(parser: SourceParser) -> Result[ParsedStatements, String] {
    let condition: Result[ParsedExpr, String] = parse_expression(advance(parser))
    if is_err(condition) { return err(source_expression_error(condition)) }
    let parsed_condition: ParsedExpr = result_unwrap(condition)
    if parsed_condition.expression.type_name != "Bool" { return err("parser: while condition must be Bool") }
    let body: Result[ParsedStatements, String] = parse_block(parsed_condition.parser)
    if is_err(body) { return err(statements_error(body)) }
    let parsed_body: ParsedStatements = result_unwrap(body)
    return ok(ParsedStatements{ parser: parsed_body.parser, json: statement_json("while", "\"cond\":" + parsed_condition.expression.json + ",\"body\":" + parsed_body.json) })
}

fn parse_for(parser: SourceParser) -> Result[ParsedStatements, String] {
    let binding_token: SourceToken = current_token(advance(parser))
    if binding_token.kind != "identifier" { return err("parser: expected a for binding name") }
    let in_token: Result[SourceParser, String] = expect(advance(advance(parser)), "in")
    if is_err(in_token) { return err(parser_error(in_token)) }
    let iterator: Result[ParsedExpr, String] = parse_expression(result_unwrap(in_token))
    if is_err(iterator) { return err(source_expression_error(iterator)) }
    let parsed_iterator: ParsedExpr = result_unwrap(iterator)
    if !is_array_type(parsed_iterator.expression.type_name) { return err("parser: for iterator must be Array[T]") }
    let item_type: String = array_inner(parsed_iterator.expression.type_name)
    let loop_parser: SourceParser = SourceParser{ tokens: parsed_iterator.parser.tokens, position: parsed_iterator.parser.position, bindings: map_insert(parsed_iterator.parser.bindings, binding_token.text, SourceBinding{ type_name: item_type, mutable: false, known: false, display: "" }), functions: parsed_iterator.parser.functions, structs: parsed_iterator.parser.structs }
    let body: Result[ParsedStatements, String] = parse_block(loop_parser)
    if is_err(body) { return err(statements_error(body)) }
    let parsed_body: ParsedStatements = result_unwrap(body)
    let outer: SourceParser = SourceParser{ tokens: parsed_body.parser.tokens, position: parsed_body.parser.position, bindings: parser.bindings, functions: parsed_body.parser.functions, structs: parsed_body.parser.structs }
    let json: String = statement_json("for", "\"name\":" + json_quote(binding_token.text) + ",\"iter\":" + parsed_iterator.expression.json + ",\"body\":" + parsed_body.json)
    return ok(ParsedStatements{ parser: outer, json: json })
}

fn parse_statement(parser: SourceParser) -> Result[ParsedStatements, String] {
    let current: SourceParser = skip_separators(parser)
    let token: SourceToken = current_token(current)
    if token.kind == "eof" || token.text == "}" {
        return err("parser: expected a statement")
    }
    if token.text == "let" || token.text == "const" { return parse_binding(current) }
    if token.text == "print" || token.text == "println" { return parse_output(current) }
    if token.text == "if" { return parse_if(current) }
    if token.text == "while" { return parse_while(current) }
    if token.text == "for" { return parse_for(current) }
    if token.text == "break" || token.text == "continue" {
        let separated: Result[SourceParser, String] = finish_statement(advance(current))
        if is_err(separated) { return err(parser_error(separated)) }
        return ok(ParsedStatements{ parser: result_unwrap(separated), json: statement_json(token.text, "\"expr\":null") })
    }
    if token.text == "return" { return parse_return(current) }
    if token.kind == "identifier" && current_token(advance(current)).text == "=" { return parse_assignment(current) }
    if token.kind == "identifier" && current_token(advance(current)).text == "(" { return parse_call_statement(current) }
    return err("parser: unsupported statement '" + token.text + "'")
}

fn parse_program(parser: SourceParser) -> Result[ParsedProgram, String] {
    let declarations: Result[SourceParser, String] = predeclare_functions(parser)
    if is_err(declarations) { return err(unwrap_or(result_error(declarations), "parser: failed to collect function declarations")) }
    let mut current: SourceParser = skip_separators(result_unwrap(declarations))
    let mut statement_items: Array[String] = []
    let mut function_items: Array[String] = []
    let mut struct_items: Array[String] = []
    while current_token(current).kind != "eof" {
        let mut function_parser: SourceParser = current
        let mut public: Bool = false
        if current_token(current).text == "pub" {
            public = true
            function_parser = advance(current)
        }
        if current_token(function_parser).text == "struct" {
            let definition: Result[ParsedStruct, String] = parse_struct(function_parser, public)
            if is_err(definition) { return err(unwrap_or(result_error(definition), "struct parser error")) }
            let parsed_struct: ParsedStruct = result_unwrap(definition)
            struct_items = array_push(struct_items, parsed_struct.json)
            current = skip_separators(parsed_struct.parser)
            continue
        }
        if current_token(function_parser).text == "fn" {
            let function: Result[ParsedFunction, String] = parse_function(function_parser, public)
            if is_err(function) { return err(unwrap_or(result_error(function), "function parser error")) }
            let parsed_function: ParsedFunction = result_unwrap(function)
            function_items = array_push(function_items, parsed_function.json)
            current = skip_separators(parsed_function.parser)
            continue
        }
        let statement: Result[ParsedStatements, String] = parse_statement(current)
        if is_err(statement) { return err("at source token '" + current_token(current).text + "' (position " + str(current.position) + "): " + statements_error(statement)) }
        let parsed: ParsedStatements = result_unwrap(statement)
        statement_items = array_push(statement_items, parsed.json)
        if parsed.parser.position == current.position { return err("parser: made no progress") }
        current = skip_separators(parsed.parser)
    }
    let statements: String = "[" + join_json_items(statement_items, 0, len(statement_items)) + "]"
    let functions: String = "[" + join_json_items(function_items, 0, len(function_items)) + "]"
    let structs: String = "[" + join_json_items(struct_items, 0, len(struct_items)) + "]"
    return ok(ParsedProgram{ parser: current, statements: statements, functions: functions, structs: structs })
}

fn compile_source(source: String) -> Result[Bytes, String] {
    let tokens: Result[Array[SourceToken], String] = lex(source)
    if is_err(tokens) { return err(unwrap_or(result_error(tokens), "lexer error")) }
    let parser: SourceParser = SourceParser{ tokens: result_unwrap(tokens), position: 0, bindings: {}, functions: {}, structs: {} }
    let program: Result[ParsedProgram, String] = parse_program(parser)
    if is_err(program) { return err(program_error(program)) }
    let parsed: ParsedProgram = result_unwrap(program)
    let document_text: String = "{\"format\":\"kry-ir\",\"version\":2,\"language_version\":\"1.0.0\",\"module\":\"\",\"source\":\"\",\"target\":{\"os\":\"linux\",\"arch\":\"amd64\",\"gui\":false},\"imports\":[],\"sources\":[],\"structs\":" + parsed.structs + ",\"enums\":[],\"functions\":" + parsed.functions + ",\"statements\":" + parsed.statements + "}"
    let document: Result[Json, String] = json_parse(document_text)
    if is_err(document) { return err(unwrap_or(result_error(document), "source frontend produced invalid KIR")) }
    let lowered: Result[Bytes, String] = compile_document(result_unwrap(document))
    return lowered
}

fn fail_compilation(message: String) -> Nil {
	println(message)
    let failure: Result[Nil, String] = err(message)
    result_unwrap(failure)
    return nil
}

fn main() -> Nil {
    let args: Array[String] = process_args()
    if len(args) != 2 {
        return fail_compilation("source compiler expects 2 arguments, got " + str(len(args)))
    }
    let source_result: Result[String, String] = fs_read_text(args[0])
    if is_err(source_result) {
        return fail_compilation("source compiler read failed: " + unwrap_or(result_error(source_result), "unknown error"))
    }
    let compiled: Result[Bytes, String] = compile_source(result_unwrap(source_result))
    if is_err(compiled) {
        return fail_compilation("source compiler compile failed: " + unwrap_or(result_error(compiled), "unknown error"))
    }
    let written: Result[Nil, String] = fs_write_bytes(args[1], result_unwrap(compiled))
    if is_err(written) {
        return fail_compilation("source compiler write failed: " + unwrap_or(result_error(written), "unknown error"))
    }
    return nil
}
