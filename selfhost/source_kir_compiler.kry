fn source_with_arena(parser: SourceParser, arena: KIRTypedArena) -> SourceParser {
    return SourceParser{ arena: arena, tokens: parser.tokens, position: parser.position, module_id: parser.module_id, bindings: parser.bindings, functions: parser.functions, structs: parser.structs, return_type: parser.return_type }
}

fn source_value(kind: String, display: String) -> KIRTypedValue {
    let mut number: Int = 0
    if kind == "int" { number = int(display) }
    let mut text: String = ""
    if kind == "string" { text = display }
    return KIRTypedValue{ kind: kind, int_value: number, uint_value: u64(0), uint_bits: u8(0), float_text: "", bool_value: kind == "bool" && display == "true", string_value: text, bytes: [], array: kir_typed_empty_edges(), inner: kir_typed_absent_ref(KIRTypedTable::KIRTableValues), present: false, ok: false }
}

fn store_source_expression(parser: SourceParser, expression: SourceExpr) -> ParsedExpr {
    if expression.row.span.present { return ParsedExpr{ parser: parser, expression: expression } }
    let appended_span: KIRTypedAppendRef = kir_typed_append_span(parser.arena, KIRTypedSourceSpan{ start: expression.location.byte_start, end: expression.location.byte_end })
    let mut arena: KIRTypedArena = appended_span.arena
    let mut constant: KIRIndexRef = kir_typed_absent_ref(KIRTypedTable::KIRTableValues)
    if expression.known && (expression.type_name == "Int" || expression.type_name == "Bool" || expression.type_name == "String") {
        let mut kind: String = "int"
        if expression.type_name == "Bool" { kind = "bool" }
        if expression.type_name == "String" { kind = "string" }
        let appended_constant: KIRTypedAppendRef = kir_typed_append_value(arena, source_value(kind, expression.display))
        arena = appended_constant.arena
        constant = appended_constant.reference
    }
    let row: KIRTypedExpression = source_located_row(expression.row, expression.location, appended_span.reference, constant)
    let mut reference: KIRIndexRef = expression.reference
    if reference.present {
        arena = result_unwrap(kir_typed_replace_expression(arena, reference.index, row))
    } else {
        let appended: KIRTypedAppendRef = kir_typed_append_expression(arena, row)
        arena = appended.arena
        reference = appended.reference
    }
    return ParsedExpr{ parser: source_with_arena(parser, arena), expression: SourceExpr{ row: row, reference: reference, type_name: expression.type_name, known: expression.known, display: expression.display, location: expression.location, empty_kind: expression.empty_kind } }
}

fn store_parsed_expression(parsed: ParsedExpr) -> ParsedExpr { return store_source_expression(parsed.parser, parsed.expression) }


fn char_at(chars: Array[String], index: Int) -> String {
    return unwrap_or(array_get(chars, index), "")
}

fn is_space(value: String) -> Bool {
    return value == " " || value == "\t" || value == "\r"
}

fn newline_continues_expression(chars: Array[String], newline_index: Int) -> Bool {
    let mut previous_index: Int = newline_index - 1
    while previous_index >= 0 && is_space(char_at(chars, previous_index)) {
        previous_index = previous_index - 1
    }
    if previous_index < 0 { return false }
    let previous: String = char_at(chars, previous_index)
    return previous == "," || previous == "." || previous == "+" || previous == "-" || previous == "*" || previous == "/" || previous == "%" || previous == "<" || previous == ">" || previous == "=" || previous == "!" || previous == "&" || previous == "|" || previous == "^"
}

fn is_digit(value: String) -> Bool {
    return contains("0123456789", value)
}

fn is_identifier_start(value: String) -> Bool {
    return value == "_" || contains("abcdefghijklmnopqrstuvwxyz", value) || contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", value)
}

fn is_identifier_continue(value: String) -> Bool {
    return is_identifier_start(value) || is_digit(value)
}

fn join_text_range(parts: Array[String], start: Int, end: Int) -> String {
    if end <= start { return "" }
    let mut result: String = ""
    let mut index: Int = start
    while index < end {
        result = result + unwrap_or(array_get(parts, index), "")
        index = index + 1
    }
    return result
}

fn source_directory(path: String) -> String {
    let chars: Array[String] = string_chars(path)
    let mut index: Int = len(chars) - 1
    while index >= 0 {
        if char_at(chars, index) == "/" || char_at(chars, index) == "\\" {
            return join_text_range(chars, 0, index + 1)
        }
        index = index - 1
    }
    return ""
}

fn source_import_path(module_path: String, imported_name: String) -> String {
    let local_file: String = source_directory(module_path) + imported_name + ".kry"
    if is_ok(fs_read_text(local_file)) { return local_file }
    let local_package: String = source_directory(module_path) + imported_name + "/main.kry"
    if is_ok(fs_read_text(local_package)) { return local_package }
    let root_file: String = imported_name + ".kry"
    if is_ok(fs_read_text(root_file)) { return root_file }
    return imported_name + "/main.kry"
}

fn safe_module_name(name: String) -> Bool {
    let chars: Array[String] = string_chars(name)
    if len(chars) == 0 || !is_identifier_start(char_at(chars, 0)) { return false }
    let mut index: Int = 1
    while index < len(chars) {
        if !is_identifier_continue(char_at(chars, index)) { return false }
        index = index + 1
    }
    return true
}

fn safe_module_path(path: String) -> Bool {
    let chars: Array[String] = string_chars(path)
    let mut component_start: Int = 0
    let mut index: Int = 0
    while index < len(chars) {
        if char_at(chars, index) == "/" {
            if index == component_start { return false }
            let component: String = result_unwrap(substring(path, component_start, index - component_start))
            if !safe_module_name(component) { return false }
            component_start = index + 1
        }
        index = index + 1
    }
    if component_start >= len(chars) { return false }
    let final_component: String = result_unwrap(substring(path, component_start, len(chars) - component_start))
    return safe_module_name(final_component)
}

fn source_function_symbol(module_id: String, name: String) -> String {
    if module_id == "root" && name == "main" { return "main" }
    return "kry_module_" + module_id + "_" + name
}

fn push_token(tokens: Array[SourceToken], token: SourceToken) -> Array[SourceToken] {
    return array_push(tokens, token)
}

fn join_token_chunks(chunks: Array[Array[SourceToken]], start: Int, end: Int) -> Array[SourceToken] {
    if end <= start { return [] }
    if end - start == 1 { return unwrap_or(array_get(chunks, start), []) }
    let middle: Int = start + (end - start) / 2
    return array_concat(join_token_chunks(chunks, start, middle), join_token_chunks(chunks, middle, end))
}

fn lex(source: String, source_name: String) -> Result[Array[SourceToken], String] {
    let chars: Array[String] = string_chars(source)
    let mut index: Int = 0
    let count: Int = len(chars)
    let mut line: Int = 1
    let mut column: Int = 1
    let mut byte_offset: Int = 0
    let mut tokens: Array[SourceToken] = []
    let mut token_chunks: Array[Array[SourceToken]] = []
    let mut paren_depth: Int = 0
    let mut bracket_depth: Int = 0
    while index < count {
        let current: String = char_at(chars, index)
        if is_space(current) {
            byte_offset = byte_offset + len(string_to_bytes(current))
            index = index + 1
            column = column + 1
            continue
        }
        if current == "\n" {
            if paren_depth == 0 && bracket_depth == 0 && !newline_continues_expression(chars, index) {
                tokens = push_token(tokens, SourceToken{ kind: "separator", text: ";", source: source_name, line: line, column: column, byte_start: byte_offset, byte_end: byte_offset + 1 })
                if len(tokens) >= 128 {
                    token_chunks = array_push(token_chunks, tokens)
                    tokens = []
                }
            }
            byte_offset = byte_offset + 1
            index = index + 1
            line = line + 1
            column = 1
            continue
        }
        if current == "/" && char_at(chars, index + 1) == "/" {
            byte_offset = byte_offset + 2
            index = index + 2
            column = column + 2
            while index < count && char_at(chars, index) != "\n" {
                byte_offset = byte_offset + len(string_to_bytes(char_at(chars, index)))
                index = index + 1
                column = column + 1
            }
            continue
        }
        if is_identifier_start(current) {
            let start: Int = index
            let start_byte: Int = byte_offset
            let location: SourceLocation = SourceLocation{ line: line, column: column }
            while index < count && is_identifier_continue(char_at(chars, index)) {
                byte_offset = byte_offset + len(string_to_bytes(char_at(chars, index)))
                index = index + 1
                column = column + 1
            }
            let text: String = join_text_range(chars, start, index)
            tokens = push_token(tokens, SourceToken{ kind: "identifier", text: text, source: source_name, line: location.line, column: location.column, byte_start: start_byte, byte_end: byte_offset })
            if len(tokens) >= 128 {
                token_chunks = array_push(token_chunks, tokens)
                tokens = []
            }
            continue
        }
        if is_digit(current) {
            let start: Int = index
            let start_byte: Int = byte_offset
            let location: SourceLocation = SourceLocation{ line: line, column: column }
            while index < count && is_digit(char_at(chars, index)) {
                byte_offset = byte_offset + 1
                index = index + 1
                column = column + 1
            }
            let text: String = join_text_range(chars, start, index)
            tokens = push_token(tokens, SourceToken{ kind: "integer", text: text, source: source_name, line: location.line, column: location.column, byte_start: start_byte, byte_end: byte_offset })
            if len(tokens) >= 128 {
                token_chunks = array_push(token_chunks, tokens)
                tokens = []
            }
            continue
        }
        if current == "\"" {
            let start_byte: Int = byte_offset
            let location: SourceLocation = SourceLocation{ line: line, column: column }
            byte_offset = byte_offset + 1
            index = index + 1
            column = column + 1
            let mut text_parts: Array[String] = []
            let mut closed: Bool = false
            while index < count {
                let value: String = char_at(chars, index)
                if value == "\"" {
                    closed = true
                    byte_offset = byte_offset + 1
                    index = index + 1
                    column = column + 1
                    break
                }
                if value == "\\" {
                    byte_offset = byte_offset + 1
                    index = index + 1
                    column = column + 1
                    if index >= count {
                        return err("lexer: unfinished escape sequence")
                    }
                    let escaped: String = char_at(chars, index)
                    byte_offset = byte_offset + len(string_to_bytes(escaped))
                    if escaped == "n" {
                        text_parts = array_push(text_parts, "\n")
                    } else if escaped == "r" {
                        text_parts = array_push(text_parts, "\r")
                    } else if escaped == "t" {
                        text_parts = array_push(text_parts, "\t")
                    } else if escaped == "\\" {
                        text_parts = array_push(text_parts, "\\")
                    } else if escaped == "\"" {
                        text_parts = array_push(text_parts, "\"")
                    } else {
                        return err("lexer: unsupported string escape \\" + escaped)
                    }
                    index = index + 1
                    column = column + 1
                    continue
                }
                if value == "\n" {
                    return err("lexer: newline in string literal")
                }
                text_parts = array_push(text_parts, value)
                byte_offset = byte_offset + len(string_to_bytes(value))
                index = index + 1
                column = column + 1
            }
            if !closed {
                return err("lexer: unterminated string literal")
            }
            tokens = push_token(tokens, SourceToken{ kind: "string", text: join_text_range(text_parts, 0, len(text_parts)), source: source_name, line: location.line, column: location.column, byte_start: start_byte, byte_end: byte_offset })
            if len(tokens) >= 128 {
                token_chunks = array_push(token_chunks, tokens)
                tokens = []
            }
            continue
        }
        let next: String = char_at(chars, index + 1)
        if (current == "=" && next == "=") || (current == "=" && next == ">") || (current == "!" && next == "=") || (current == "<" && next == "=") || (current == ">" && next == "=") || (current == "&" && next == "&") || (current == "|" && next == "|") || (current == "<" && next == "<") || (current == ">" && next == ">") || (current == "-" && next == ">") || (current == ":" && next == ":") {
            tokens = push_token(tokens, SourceToken{ kind: "symbol", text: current + next, source: source_name, line: line, column: column, byte_start: byte_offset, byte_end: byte_offset + 2 })
            if len(tokens) >= 128 {
                token_chunks = array_push(token_chunks, tokens)
                tokens = []
            }
            index = index + 2
            column = column + 2
            byte_offset = byte_offset + 2
            continue
        }
        if current == "(" || current == ")" || current == "{" || current == "}" || current == "[" || current == "]" || current == ":" || current == "=" || current == "+" || current == "-" || current == "*" || current == "/" || current == "%" || current == "<" || current == ">" || current == "!" || current == "&" || current == "|" || current == "^" || current == "," || current == ";" || current == "." || current == "?" {
            tokens = push_token(tokens, SourceToken{ kind: "symbol", text: current, source: source_name, line: line, column: column, byte_start: byte_offset, byte_end: byte_offset + len(string_to_bytes(current)) })
            if len(tokens) >= 128 {
                token_chunks = array_push(token_chunks, tokens)
                tokens = []
            }
            if current == "(" { paren_depth = paren_depth + 1 }
            if current == ")" && paren_depth > 0 { paren_depth = paren_depth - 1 }
            if current == "[" { bracket_depth = bracket_depth + 1 }
            if current == "]" && bracket_depth > 0 { bracket_depth = bracket_depth - 1 }
            index = index + 1
            column = column + 1
            byte_offset = byte_offset + len(string_to_bytes(current))
            continue
        }
        return err("lexer: unsupported character '" + current + "'")
    }
    tokens = push_token(tokens, SourceToken{ kind: "eof", text: "", source: source_name, line: line, column: column, byte_start: byte_offset, byte_end: byte_offset })
    token_chunks = array_push(token_chunks, tokens)
    return ok(join_token_chunks(token_chunks, 0, len(token_chunks)))
}

fn module_without_imports(path: String, tokens: Array[SourceToken]) -> Result[SourceModule, String] {
    let mut output: Array[SourceToken] = []
    let mut output_chunks: Array[Array[SourceToken]] = []
    let mut imports: Array[String] = []
    let mut import_records: Array[SourceImport] = []
    let mut index: Int = 0
    let mut braces: Int = 0
    while index < len(tokens) {
        let token: SourceToken = unwrap_or(array_get(tokens, index), SourceToken{ kind: "eof", text: "", source: path, line: 1, column: 1, byte_start: 0, byte_end: 0 })
        if braces == 0 && token.kind == "identifier" && token.text == "import" {
            let name: SourceToken = unwrap_or(array_get(tokens, index + 1), SourceToken{ kind: "eof", text: "", source: path, line: 1, column: 1, byte_start: 0, byte_end: 0 })
            if name.kind != "string" { return err("module: import expects a quoted module name in '" + path + "'") }
            if !safe_module_path(name.text) { return err("module: unsafe module path '" + name.text + "' in '" + path + "'") }
            imports = array_push(imports, name.text)
            import_records = array_push(import_records, SourceImport{ path: name.text, token: name })
            index = index + 2
            let separator: SourceToken = unwrap_or(array_get(tokens, index), SourceToken{ kind: "eof", text: "", source: path, line: 1, column: 1, byte_start: 0, byte_end: 0 })
            if separator.text == ";" { index = index + 1 }
            else if separator.kind != "eof" { return err("module: expected separator after import in '" + path + "'") }
            continue
        }
        if token.kind == "symbol" && token.text == "{" { braces = braces + 1 }
        if token.kind == "symbol" && token.text == "}" { braces = braces - 1 }
        output = array_push(output, token)
        if len(output) >= 128 {
            output_chunks = array_push(output_chunks, output)
            output = []
        }
        index = index + 1
    }
    if len(output) > 0 { output_chunks = array_push(output_chunks, output) }
    return ok(SourceModule{ path: path, tokens: join_token_chunks(output_chunks, 0, len(output_chunks)), imports: imports, import_records: import_records })
}

fn load_source_modules(path: String, state: SourceModules, root_directory: String) -> Result[SourceModules, String] {
    if map_contains_key(state.visiting, path) { return err("module: import cycle involving '" + path + "'") }
    if map_contains_key(state.loaded, path) { return ok(state) }
    let source: Result[String, String] = fs_read_text(path)
    if is_err(source) { return err("module: cannot read '" + path + "': " + unwrap_or(result_error(source), "unknown error")) }
    let lexed: Result[Array[SourceToken], String] = lex(result_unwrap(source), portable_source_name(path, root_directory))
    if is_err(lexed) { return err("module: lexer failed in '" + path + "': " + unwrap_or(result_error(lexed), "unknown error")) }
    let stripped: Result[SourceModule, String] = module_without_imports(path, result_unwrap(lexed))
    if is_err(stripped) { return err(unwrap_or(result_error(stripped), "invalid import")) }
    let module: SourceModule = result_unwrap(stripped)
    let mut current: SourceModules = SourceModules{ items: state.items, visiting: map_insert(state.visiting, path, true), loaded: state.loaded }
    let mut index: Int = 0
    while index < len(module.imports) {
        let name: String = unwrap_or(array_get(module.imports, index), "")
        let imported: Result[SourceModules, String] = load_source_modules(source_import_path(path, name), current, root_directory)
        if is_err(imported) { return err(unwrap_or(result_error(imported), "cannot load module")) }
        current = result_unwrap(imported)
        index = index + 1
    }
    return ok(SourceModules{ items: array_push(current.items, module), visiting: map_remove(current.visiting, path), loaded: map_insert(current.loaded, path, true) })
}

fn current_token(parser: SourceParser) -> SourceToken {
    return unwrap_or(array_get(parser.tokens, parser.position), SourceToken{ kind: "eof", text: "", source: "", line: 1, column: 1, byte_start: 0, byte_end: 0 })
}

fn advance(parser: SourceParser) -> SourceParser {
    return SourceParser{ arena: parser.arena, tokens: parser.tokens, position: parser.position + 1, module_id: parser.module_id, bindings: parser.bindings, functions: parser.functions, structs: parser.structs, return_type: parser.return_type }
}

fn parser_error(value: Result[SourceParser, String]) -> String {
    return unwrap_or(result_error(value), "parser error")
}

fn source_expression_error(value: Result[ParsedExpr, String]) -> String {
    return unwrap_or(result_error(value), "expression parser error")
}

fn statements_error(value: Result[ParsedStatements, String]) -> String {
    return unwrap_or(result_error(value), "statement parser error")
}

fn program_error(value: Result[ParsedProgram, String]) -> String {
    return unwrap_or(result_error(value), "program parser error")
}

fn expect(parser: SourceParser, expected: String) -> Result[SourceParser, String] {
    let token: SourceToken = current_token(parser)
    if token.text != expected {
        return err("parser: expected '" + expected + "', found '" + token.text + "'")
    }
    return ok(advance(parser))
}

fn parse_type(parser: SourceParser) -> Result[ParsedType, String] {
    let token: SourceToken = current_token(parser)
    if token.kind != "identifier" { return err("parser: expected a type name") }
    if token.text == "fn" {
        let opened: Result[SourceParser, String] = expect(advance(parser), "(")
        if is_err(opened) { return err(parser_error(opened)) }
        let mut current: SourceParser = result_unwrap(opened)
        let mut parameters: String = ""
        let mut first: Bool = true
        while current_token(current).text != ")" {
            let parsed_parameter: Result[ParsedType, String] = parse_type(current)
            if is_err(parsed_parameter) { return err(unwrap_or(result_error(parsed_parameter), "parser: expected a function type parameter")) }
            let parameter: ParsedType = result_unwrap(parsed_parameter)
            if parameter.name == "Nil" { return err("parser: unsupported function type parameter 'Nil'") }
            if !first { parameters = parameters + "," }
            parameters = parameters + parameter.name
            first = false
            current = parameter.parser
            if current_token(current).text == "," {
                current = advance(current)
            } else if current_token(current).text != ")" {
                return err("parser: expected ',' or ')' in function type")
            }
        }
        let closed: Result[SourceParser, String] = expect(current, ")")
        if is_err(closed) { return err(parser_error(closed)) }
        let arrow: Result[SourceParser, String] = expect(result_unwrap(closed), "->")
        if is_err(arrow) { return err(parser_error(arrow)) }
        let parsed_return: Result[ParsedType, String] = parse_type(result_unwrap(arrow))
        if is_err(parsed_return) { return err(unwrap_or(result_error(parsed_return), "parser: expected a function type return")) }
        let returned: ParsedType = result_unwrap(parsed_return)
        return ok(ParsedType{ parser: returned.parser, name: "fn(" + parameters + ")->" + returned.name })
    }
    let mut current: SourceParser = advance(parser)
    let mut name: String = token.text
    let declared: Option[SourceStruct] = map_get(parser.structs, token.text)
    if !is_none(declared) {
        name = unwrap_or(declared, SourceStruct{ symbol: "", module_id: "", public: false, fields: {}, names: [], public_fields: {} }).symbol
    } else if map_contains_key(parser.structs, "private:" + token.text) {
        let hidden: SourceStruct = unwrap_or(map_get(parser.structs, "private:" + token.text), SourceStruct{ symbol: "", module_id: "", public: false, fields: {}, names: [], public_fields: {} })
        if source_type_is_enum(hidden) { return err("parser: imported enum '" + token.text + "' is private") }
        return err("parser: imported struct '" + token.text + "' is private")
    }
    if current_token(current).text == "[" {
        current = advance(current)
        let mut arguments: String = ""
        let mut first: Bool = true
        while current_token(current).text != "]" {
            let nested: Result[ParsedType, String] = parse_type(current)
            if is_err(nested) { return err(unwrap_or(result_error(nested), "parser: invalid generic type")) }
            let parsed: ParsedType = result_unwrap(nested)
            if !first { arguments = arguments + "," }
            arguments = arguments + parsed.name
            first = false
            current = parsed.parser
            if current_token(current).text == "," {
                current = advance(current)
            } else if current_token(current).text != "]" {
                return err("parser: expected ',' or ']' in generic type")
            }
        }
        let closed: Result[SourceParser, String] = expect(current, "]")
        if is_err(closed) { return err(parser_error(closed)) }
        current = result_unwrap(closed)
        name = name + "[" + arguments + "]"
    }
    return ok(ParsedType{ parser: current, name: name })
}

fn source_struct_symbol(module_id: String, name: String) -> String {
    // The @ prefix cannot be produced by the source lexer, so internal type
    // identities cannot be named directly by user code to bypass visibility.
    return "@kry_type_module_" + module_id + "_" + name
}

fn source_enum_symbol(module_id: String, name: String) -> String {
    // Keep enum identities outside the source identifier alphabet as well.
    return "@kry_enum_module_" + module_id + "_" + name
}

fn source_type_is_enum(definition: SourceStruct) -> Bool {
    return starts_with(definition.symbol, "@kry_enum_module_")
}

fn source_string_array_contains(items: Array[String], value: String) -> Bool {
    let mut index: Int = 0
    while index < len(items) {
        if unwrap_or(array_get(items, index), "") == value { return true }
        index = index + 1
    }
    return false
}

fn source_module_name(path: String, directory: String) -> String {
    if !starts_with(path, directory) { return path }
    let path_length: Int = len(string_chars(path))
    let directory_length: Int = len(string_chars(directory))
    return result_unwrap(substring(path, directory_length, path_length - directory_length))
}

fn portable_source_name(path: String, root_directory: String) -> String {
    let relative: String = source_module_name(path, root_directory)
    let chars: Array[String] = string_chars(relative)
    let mut result: String = ""
    let mut index: Int = 0
    while index < len(chars) {
        let value: String = char_at(chars, index)
        if value == "\\" { result = result + "/" }
        else { result = result + value }
        index = index + 1
    }
    return result
}

fn parse_struct(parser: SourceParser, public: Bool) -> Result[ParsedStruct, String] {
    let declaration_token: SourceToken = current_token(parser)
    let opened: Result[SourceParser, String] = expect(parser, "struct")
    if is_err(opened) { return err(parser_error(opened)) }
    let named: SourceParser = result_unwrap(opened)
    let name: SourceToken = current_token(named)
    if name.kind != "identifier" { return err("parser: expected a struct name") }
    let declaration: Option[SourceStruct] = map_get(parser.structs, name.text)
    if is_none(declaration) { return err("parser: struct '" + name.text + "' was not declared in this module context") }
    let declared_shape: SourceStruct = unwrap_or(declaration, SourceStruct{ symbol: "", module_id: parser.module_id, public: public, fields: {}, names: [], public_fields: {} })
    let brace: Result[SourceParser, String] = expect(advance(named), "{")
    if is_err(brace) { return err(parser_error(brace)) }
    let mut current: SourceParser = skip_separators(result_unwrap(brace))
    let mut fields: Map[String, String] = {}
    let mut public_fields: Map[String, Bool] = {}
    let mut names: Array[String] = []
    let mut field_refs: Array[KIRIndexRef] = []
    while current_token(current).text != "}" {
        let mut field_public: Bool = true
        if current_token(current).text == "private" {
            field_public = false
            current = advance(current)
        }
        let field_name: SourceToken = current_token(current)
        if field_name.kind != "identifier" { return err("parser: expected a struct field name") }
        if map_contains_key(fields, field_name.text) { return err("parser: duplicate struct field '" + field_name.text + "'") }
        let colon: Result[SourceParser, String] = expect(advance(current), ":")
        if is_err(colon) { return err(parser_error(colon)) }
        let parsed_type: Result[ParsedType, String] = parse_type(result_unwrap(colon))
        if is_err(parsed_type) { return err(unwrap_or(result_error(parsed_type), "parser: expected a struct field type")) }
        let field_type: String = result_unwrap(parsed_type).name
        if !source_type_supported(parser, field_type) { return err("parser: unsupported struct field type '" + field_type + "'") }
        fields = map_insert(fields, field_name.text, field_type)
        public_fields = map_insert(public_fields, field_name.text, field_public)
        names = array_push(names, field_name.text)
        let span: KIRTypedAppendRef = kir_typed_append_span(result_unwrap(parsed_type).parser.arena, KIRTypedSourceSpan{ start: field_name.byte_start, end: field_name.byte_end })
        let field: KIRTypedAppendRef = kir_typed_append_field(span.arena, KIRTypedField{ name: field_name.text, source: field_name.source, line: field_name.line, column: field_name.column, span: span.reference, public: field_public, type_name: field_type })
        field_refs = array_push(field_refs, field.reference)
        current = skip_separators(source_with_arena(result_unwrap(parsed_type).parser, field.arena))
        if current_token(current).text == "," {
            current = skip_separators(advance(current))
        } else if current_token(current).text != "}" {
            return err("parser: expected ',' or '}' after struct field")
        }
    }
    if public {
        let mut field_index: Int = 0
        while field_index < len(names) {
            let public_field_name: String = unwrap_or(array_get(names, field_index), "")
            let public_field_type: String = unwrap_or(map_get(fields, public_field_name), "")
            if source_type_exposes_private(parser.structs, public_field_type) { return err("parser: public struct '" + name.text + "' exposes a private field type") }
            field_index = field_index + 1
        }
    }
    let closed: Result[SourceParser, String] = expect(current, "}")
    if is_err(closed) { return err(parser_error(closed)) }
    let definition: SourceStruct = SourceStruct{ symbol: declared_shape.symbol, module_id: declared_shape.module_id, public: declared_shape.public, fields: fields, names: names, public_fields: public_fields }
    let after: SourceParser = result_unwrap(closed)
    let updated_structs: Map[String, SourceStruct] = map_insert(map_insert(after.structs, name.text, definition), definition.symbol, definition)
    let updated: SourceParser = SourceParser{ arena: after.arena, tokens: after.tokens, position: after.position, module_id: after.module_id, bindings: after.bindings, functions: after.functions, structs: updated_structs, return_type: after.return_type }
    let declaration_end: Int = previous_token(result_unwrap(closed)).byte_end
    let span: KIRTypedAppendRef = kir_typed_append_span(updated.arena, KIRTypedSourceSpan{ start: declaration_token.byte_start, end: declaration_end })
    let fields_range: KIRTypedAppendRange = kir_typed_append_edges(span.arena, field_refs)
    let row: KIRTypedAppendRef = kir_typed_append_struct(fields_range.arena, KIRTypedStruct{ name: definition.symbol, source: declaration_token.source, line: declaration_token.line, column: declaration_token.column, span: span.reference, public: public, module: "", type_params: kir_typed_empty_edges(), fields: fields_range.range })
    return ok(ParsedStruct{ parser: source_with_arena(updated, row.arena), reference: row.reference })
}

fn parse_enum(parser: SourceParser, public: Bool, module_name: String) -> Result[ParsedEnum, String] {
    let declaration_token: SourceToken = current_token(parser)
    let opened: Result[SourceParser, String] = expect(parser, "enum")
    if is_err(opened) { return err(parser_error(opened)) }
    let named: SourceParser = result_unwrap(opened)
    let name: SourceToken = current_token(named)
    if name.kind != "identifier" { return err("parser: expected an enum name") }
    let declaration: Option[SourceStruct] = map_get(parser.structs, name.text)
    if is_none(declaration) { return err("parser: enum '" + name.text + "' was not declared in this module context") }
    let declared_shape: SourceStruct = unwrap_or(declaration, SourceStruct{ symbol: "", module_id: parser.module_id, public: public, fields: {}, names: [], public_fields: {} })
    if !source_type_is_enum(declared_shape) { return err("parser: '" + name.text + "' was not declared as an enum") }
    let brace: Result[SourceParser, String] = expect(advance(named), "{")
    if is_err(brace) { return err(parser_error(brace)) }
    let mut current: SourceParser = skip_separators(result_unwrap(brace))
    let mut variants: Array[String] = []
    let mut variant_spans: Array[KIRIndexRef] = []
    while current_token(current).text != "}" {
        let variant: SourceToken = current_token(current)
        if variant.kind != "identifier" { return err("parser: expected an enum variant name") }
        if source_string_array_contains(variants, variant.text) { return err("parser: duplicate enum variant '" + variant.text + "'") }
        variants = array_push(variants, variant.text)
        let span: KIRTypedAppendRef = kir_typed_append_span(current.arena, KIRTypedSourceSpan{ start: variant.byte_start, end: variant.byte_end })
        variant_spans = array_push(variant_spans, span.reference)
        current = advance(source_with_arena(current, span.arena))
        if current_token(current).text == "," {
            current = skip_separators(advance(current))
        } else if current_token(current).text == ";" {
            current = skip_separators(current)
        } else if current_token(current).text != "}" {
            return err("parser: expected ',' or '}' after enum variant")
        }
    }
    if len(variants) == 0 { return err("parser: enum '" + name.text + "' must declare at least one variant") }
    let closed: Result[SourceParser, String] = expect(current, "}")
    if is_err(closed) { return err(parser_error(closed)) }
    let definition: SourceStruct = SourceStruct{ symbol: declared_shape.symbol, module_id: declared_shape.module_id, public: declared_shape.public, fields: {}, names: variants, public_fields: {} }
    let after: SourceParser = result_unwrap(closed)
    let updated_enums: Map[String, SourceStruct] = map_insert(map_insert(after.structs, name.text, definition), definition.symbol, definition)
    let updated: SourceParser = SourceParser{ arena: after.arena, tokens: after.tokens, position: after.position, module_id: after.module_id, bindings: after.bindings, functions: after.functions, structs: updated_enums, return_type: after.return_type }
    let declaration_end: Int = previous_token(result_unwrap(closed)).byte_end
    let span: KIRTypedAppendRef = kir_typed_append_span(updated.arena, KIRTypedSourceSpan{ start: declaration_token.byte_start, end: declaration_end })
    let variants_range: KIRTypedAppendRange = kir_typed_append_edges(span.arena, variant_spans)
    let row: KIRTypedAppendRef = kir_typed_append_enum(variants_range.arena, KIRTypedEnum{ name: definition.symbol, source: declaration_token.source, line: declaration_token.line, column: declaration_token.column, span: span.reference, public: public, module: module_name, variants: variants, variant_spans: variants_range.range })
    return ok(ParsedEnum{ parser: source_with_arena(updated, row.arena), reference: row.reference })
}

fn bool_text(value: Bool) -> String {
    if value {
        return "true"
    }
    return "false"
}

fn source_is_scalar_type(type_name: String) -> Bool {
    return type_name == "Int" || type_name == "Float" || type_name == "Bool" || type_name == "String" || type_name == "Json" || type_name == "Bytes" || type_name == "FFILibrary" || type_name == "FFISymbol" || type_name == "FFIBuffer" || starts_with(type_name, "UInt") || starts_with(type_name, "Array[") || starts_with(type_name, "Option[") || starts_with(type_name, "Result[") || starts_with(type_name, "Map[") || starts_with(type_name, "Set[")
}

fn source_type_supported(parser: SourceParser, type_name: String) -> Bool {
    return source_is_scalar_type(type_name) || starts_with(type_name, "fn(") || map_contains_key(parser.structs, type_name)
}

fn source_struct_field_type(parser: SourceParser, type_name: String, field_name: String) -> String {
    let definition: Option[SourceStruct] = map_get(parser.structs, type_name)
    if is_none(definition) { return "" }
    let fields: Map[String, String] = unwrap_or(definition, SourceStruct{ symbol: "", module_id: "", public: false, fields: {}, names: [], public_fields: {} }).fields
    return unwrap_or(map_get(fields, field_name), "")
}

fn source_struct_field_is_public(parser: SourceParser, type_name: String, field_name: String) -> Bool {
    let definition: Option[SourceStruct] = map_get(parser.structs, type_name)
    if is_none(definition) { return false }
    let visibility: Map[String, Bool] = unwrap_or(definition, SourceStruct{ symbol: "", module_id: "", public: false, fields: {}, names: [], public_fields: {} }).public_fields
    return unwrap_or(map_get(visibility, field_name), false)
}

fn generic_inner(type_name: String, prefix: String) -> String {
    if !starts_with(type_name, prefix) { return "" }
    let start: Int = len(string_chars(prefix))
    let chars: Array[String] = string_chars(type_name)
    let mut index: Int = start
    let mut depth: Int = 0
    while index < len(chars) {
        let current: String = char_at(chars, index)
        if current == "[" {
            depth = depth + 1
        } else if current == "]" {
            if depth == 0 { break }
            depth = depth - 1
        } else if current == "," && depth == 0 {
            break
        }
        index = index + 1
    }
    let value: Result[String, String] = substring(type_name, start, index - start)
    if is_err(value) { return "" }
    return result_unwrap(value)
}

fn generic_error(type_name: String) -> String {
    if !is_result_type(type_name) { return "" }
    let chars: Array[String] = string_chars(type_name)
    let start: Int = len(string_chars("Result["))
    let mut index: Int = start
    let mut depth: Int = 0
    let mut comma: Int = -1
    while index < len(chars) - 1 {
        let current: String = char_at(chars, index)
        if current == "[" {
            depth = depth + 1
        } else if current == "]" {
            if depth > 0 { depth = depth - 1 }
        } else if current == "," && depth == 0 {
            comma = index
            break
        }
        index = index + 1
    }
    if comma < 0 { return "" }
    let value: Result[String, String] = substring(type_name, comma + 1, len(chars) - comma - 2)
    if is_err(value) { return "" }
    return result_unwrap(value)
}

fn is_option_type(type_name: String) -> Bool {
    return starts_with(type_name, "Option[") && ends_with(type_name, "]")
}

fn is_result_type(type_name: String) -> Bool {
    return starts_with(type_name, "Result[") && ends_with(type_name, "]")
}

fn source_generic_arity(type_name: String, prefix: String) -> Int {
    if !starts_with(type_name, prefix) || !ends_with(type_name, "]") { return 0 }
    let chars: Array[String] = string_chars(type_name)
    let mut index: Int = len(string_chars(prefix))
    let mut depth: Int = 0
    let mut arity: Int = 1
    while index < len(chars) - 1 {
        let current: String = char_at(chars, index)
        if current == "[" {
            depth = depth + 1
        } else if current == "]" {
            if depth == 0 { return 0 }
            depth = depth - 1
        } else if current == "," && depth == 0 {
            arity = arity + 1
        }
        index = index + 1
    }
    if depth != 0 { return 0 }
    return arity
}

fn is_array_type(type_name: String) -> Bool {
    return starts_with(type_name, "Array[") && ends_with(type_name, "]")
}

fn generic_value(type_name: String, prefix: String) -> String {
    if !starts_with(type_name, prefix) { return "" }
    let chars: Array[String] = string_chars(type_name)
    let start: Int = len(string_chars(prefix))
    let mut index: Int = start
    let mut depth: Int = 0
    let mut comma: Int = -1
    while index < len(chars) - 1 {
        let current: String = char_at(chars, index)
        if current == "[" {
            depth = depth + 1
        } else if current == "]" {
            if depth > 0 { depth = depth - 1 }
        } else if current == "," && depth == 0 {
            comma = index
            break
        }
        index = index + 1
    }
    if comma < 0 { return "" }
    let value: Result[String, String] = substring(type_name, comma + 1, len(chars) - comma - 2)
    if is_err(value) { return "" }
    return result_unwrap(value)
}

fn array_inner(type_name: String) -> String {
    return generic_inner(type_name, "Array[")
}

fn source_type_contains_function(parser: SourceParser, type_name: String, visiting: Map[String, Bool]) -> Bool {
    if contains(type_name, "fn(") { return true }
    if is_array_type(type_name) { return source_type_contains_function(parser, array_inner(type_name), visiting) }
    if starts_with(type_name, "Option[") { return source_type_contains_function(parser, generic_inner(type_name, "Option["), visiting) }
    if starts_with(type_name, "Result[") {
        return source_type_contains_function(parser, generic_inner(type_name, "Result["), visiting) || source_type_contains_function(parser, generic_error(type_name), visiting)
    }
    if starts_with(type_name, "Map[") {
        return source_type_contains_function(parser, generic_inner(type_name, "Map["), visiting) || source_type_contains_function(parser, generic_value(type_name, "Map["), visiting)
    }
    if starts_with(type_name, "Set[") { return source_type_contains_function(parser, generic_inner(type_name, "Set["), visiting) }
    if map_contains_key(visiting, type_name) { return false }
    let definition: Option[SourceStruct] = map_get(parser.structs, type_name)
    if is_none(definition) { return false }
    let shape: SourceStruct = unwrap_or(definition, SourceStruct{ symbol: "", module_id: "", public: false, fields: {}, names: [], public_fields: {} })
    let next_visiting: Map[String, Bool] = map_insert(visiting, type_name, true)
    let mut index: Int = 0
    while index < len(shape.names) {
        let field_name: String = unwrap_or(array_get(shape.names, index), "")
        let field_type: String = unwrap_or(map_get(shape.fields, field_name), "")
        if source_type_contains_function(parser, field_type, next_visiting) { return true }
        index = index + 1
    }
    return false
}

fn is_generic_builtin(name: String) -> Bool {
    return name == "assert" || name == "assert_eq" || name == "contains" || name == "starts_with" || name == "ends_with" || name == "string_chars" || name == "codepoints" || name == "substring" || name == "str" || name == "int" || name == "some" || name == "none" || name == "ok" || name == "err" || name == "is_some" || name == "is_none" || name == "is_ok" || name == "is_err" || name == "unwrap_or" || name == "result_unwrap" || name == "result_error" || name == "len" || name == "array_push" || name == "array_get" || name == "array_concat" || name == "array_indices" || name == "array_set" || name == "array_slice" || name == "bytes" || name == "bytes_from_u8" || name == "u8_array" || name == "string_to_bytes" || name == "process_args" || name == "fs_read_text" || name == "fs_write_bytes" || name == "json_parse" || name == "json_stringify" || name == "json_kind" || name == "json_array_len" || name == "json_object_get" || name == "json_object_keys" || name == "json_object_keys_allowed" || name == "json_object_fields_empty_except" || name == "json_array_get" || name == "json_string" || name == "json_bool" || name == "json_int" || name == "json_uint" || name == "map_get" || name == "map_insert" || name == "map_contains_key" || name == "map_remove" || name == "print" || name == "println" || name == "ffi_library_open" || name == "ffi_library_close" || name == "ffi_symbol" || name == "ffi_call" || name == "ffi_buffer_new" || name == "ffi_buffer_new_sized" || name == "ffi_buffer_address" || name == "ffi_buffer_read" || name == "ffi_buffer_close" || name == "ffi_thread_pin" || name == "ffi_thread_unpin"
}

fn source_ffi_argument_type(argument_types: Array[String], index: Int) -> String {
    return unwrap_or(array_get(argument_types, index), "")
}

fn source_ffi_return_type(name: String, argument_types: Array[String], argument_count: Int) -> Result[String, String] {
    if name == "ffi_library_open" {
        if argument_count != 1 || source_ffi_argument_type(argument_types, 0) != "String" { return err("parser: ffi_library_open expects one String") }
        return ok("Result[FFILibrary,String]")
    }
    if name == "ffi_library_close" {
        if argument_count != 1 || source_ffi_argument_type(argument_types, 0) != "FFILibrary" { return err("parser: ffi_library_close expects one FFILibrary") }
        return ok("Nil")
    }
    if name == "ffi_symbol" {
        if argument_count != 2 || source_ffi_argument_type(argument_types, 0) != "FFILibrary" || source_ffi_argument_type(argument_types, 1) != "String" { return err("parser: ffi_symbol expects FFILibrary and String") }
        return ok("Result[FFISymbol,String]")
    }
    if name == "ffi_call" {
        if argument_count != 3 || source_ffi_argument_type(argument_types, 0) != "FFISymbol" || source_ffi_argument_type(argument_types, 1) != "String" || source_ffi_argument_type(argument_types, 2) != "Array[Int]" { return err("parser: ffi_call expects FFISymbol, String, and Array[Int]") }
        return ok("Result[Int,String]")
    }
    if name == "ffi_buffer_new" {
        if argument_count != 1 || source_ffi_argument_type(argument_types, 0) != "Bytes" { return err("parser: ffi_buffer_new expects one Bytes") }
        return ok("FFIBuffer")
    }
    if name == "ffi_buffer_new_sized" {
        if argument_count != 1 || source_ffi_argument_type(argument_types, 0) != "Int" { return err("parser: ffi_buffer_new_sized expects one Int") }
        return ok("Result[FFIBuffer,String]")
    }
    if name == "ffi_buffer_address" {
        if argument_count != 1 || source_ffi_argument_type(argument_types, 0) != "FFIBuffer" { return err("parser: ffi_buffer_address expects one FFIBuffer") }
        return ok("Result[Int,String]")
    }
    if name == "ffi_buffer_read" {
        if argument_count != 1 || source_ffi_argument_type(argument_types, 0) != "FFIBuffer" { return err("parser: ffi_buffer_read expects one FFIBuffer") }
        return ok("Result[Bytes,String]")
    }
    if name == "ffi_buffer_close" {
        if argument_count != 1 || source_ffi_argument_type(argument_types, 0) != "FFIBuffer" { return err("parser: ffi_buffer_close expects one FFIBuffer") }
        return ok("Nil")
    }
    if name == "ffi_thread_pin" || name == "ffi_thread_unpin" {
        if argument_count != 0 { return err("parser: " + name + " expects no arguments") }
        return ok("Nil")
    }
    return err("parser: unknown FFI builtin '" + name + "'")
}



fn binding_id(name: String, source: String, byte_start: Int, line: Int, column: Int) -> String {
    return "kry-binding-v1/" + str(byte_start) + "/" + str(line) + "/" + str(column) + "/" + str(len(string_to_bytes(source))) + ":" + source + "/" + str(len(string_to_bytes(name))) + ":" + name
}



fn literal_int(value: Int, token: SourceToken) -> SourceExpr {
    let display: String = str(value)
    let prefix: SourceToken = node_prefix(token)
    return SourceExpr{
        row: source_row_int("Int", value), reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions),
        type_name: "Int",
        known: true,
        display: display,
        location: prefix,
        empty_kind: "",
    }
}

fn literal_bool(value: Bool, token: SourceToken) -> SourceExpr {
    let display: String = bool_text(value)
    let prefix: SourceToken = node_prefix(token)
    return SourceExpr{
        row: source_row_bool("Bool", value), reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions),
        type_name: "Bool",
        known: true,
        display: display,
        location: prefix,
        empty_kind: "",
    }
}

fn literal_string(value: String, token: SourceToken) -> SourceExpr {
    let prefix: SourceToken = node_prefix(token)
    return SourceExpr{
        row: source_row_string("String", value), reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions),
        type_name: "String",
        known: true,
        display: value,
        location: prefix,
        empty_kind: "",
    }
}

fn apply_empty_type(expression: SourceExpr, expected: String) -> SourceExpr {
    let row: KIRTypedExpression = expression.row
    let option_empty: Bool = is_option_type(expected) && is_option_type(expression.type_name) && row.kind == "call" && row.name == "none"
    let array_empty: Bool = is_array_type(expected) && expression.empty_kind == "array"
    let map_empty: Bool = starts_with(expected, "Map[") && expression.empty_kind == "map"
    let result_ok: Bool = is_result_type(expected) && is_result_type(expression.type_name) && generic_inner(expected, "Result[") == generic_inner(expression.type_name, "Result[") && row.kind == "call" && row.name == "ok"
    let result_err: Bool = is_result_type(expected) && is_result_type(expression.type_name) && generic_error(expected) == generic_error(expression.type_name) && row.kind == "call" && row.name == "err"
    if option_empty || array_empty || map_empty || result_ok || result_err {
        return SourceExpr{ row: source_retype_row(row, expected), reference: expression.reference, type_name: expected, known: expression.known, display: expression.display, location: expression.location, empty_kind: expression.empty_kind }
    }
    return expression
}

fn variable_expr(name: String, binding: SourceBinding, token: SourceToken) -> SourceExpr {
    let prefix: SourceToken = node_prefix(token)
    return SourceExpr{
        row: source_row_var(binding.type_name, name, binding.reference), reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions),
        type_name: binding.type_name,
        known: binding.known,
        display: binding.display,
        location: prefix,
        empty_kind: "",
    }
}

fn combine_values(left: SourceExpr, operator: String, right: SourceExpr, token: SourceToken) -> Result[SourceExpr, String] {
    let prefix: SourceToken = prefix_with_diagnostic(prefix_with_span_end(left.location, prefix_span_end(right.location)), token)
    if operator == "+" && left.type_name == "String" && right.type_name == "String" {
        let known: Bool = left.known && right.known
        let mut display: String = ""
        if known {
            display = left.display + right.display
        }
        return ok(SourceExpr{
            row: source_row_binary("String", "+", left.reference, right.reference), reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions),
            type_name: "String",
            known: known,
            display: display,
            location: prefix,
            empty_kind: "",
        })
    }
    if operator == "<<" || operator == ">>" {
        if !starts_with(left.type_name, "UInt") || right.type_name != "Int" {
            return err("parser: shifts require a UInt value and an Int count")
        }
        return ok(SourceExpr{
            row: source_row_binary(left.type_name, operator, left.reference, right.reference), reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions),
            type_name: left.type_name,
            known: false,
            display: "",
            location: prefix,
            empty_kind: "",
        })
    }
    if left.type_name != right.type_name {
        return err("parser: binary operands must have the same type")
    }
    if starts_with(left.type_name, "@kry_enum_module_") {
        if operator != "==" && operator != "!=" { return err("parser: enum values support only equality") }
        return ok(SourceExpr{
            row: source_row_binary("Bool", operator, left.reference, right.reference), reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions),
            type_name: "Bool",
            known: false,
            display: "",
            location: prefix,
            empty_kind: "",
        })
    }
    if operator == "+" && is_array_type(left.type_name) {
        return ok(SourceExpr{
            row: source_row_binary(left.type_name, "+", left.reference, right.reference), reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions),
            type_name: left.type_name,
            known: false,
            display: "",
            location: prefix,
            empty_kind: "",
        })
    }
    if left.type_name == "String" && (operator == "==" || operator == "!=") {
        let known: Bool = left.known && right.known
        let mut equal: Bool = left.display == right.display
        if known {
            if operator == "!=" { equal = !equal }
        }
        return ok(SourceExpr{
            row: source_row_binary("Bool", operator, left.reference, right.reference), reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions),
            type_name: "Bool",
            known: known,
            display: bool_text(equal),
            location: prefix,
            empty_kind: "",
        })
    }
    if left.type_name == "String" {
        return err("parser: String supports only + and equality")
    }
    if left.type_name != "Int" && left.type_name != "Bool" && !starts_with(left.type_name, "UInt") {
        return err("parser: unsupported binary operand type '" + left.type_name + "'")
    }
    if left.type_name == "Bool" && operator != "==" && operator != "!=" && operator != "&&" && operator != "||" {
        return err("parser: Bool supports only equality and logical operators")
    }
    if (operator == "&" || operator == "|" || operator == "^") && !starts_with(left.type_name, "UInt") {
        return err("parser: bitwise operands must be UInt values")
    }
    if (left.type_name == "Int" || starts_with(left.type_name, "UInt")) && (operator == "&&" || operator == "||") {
        return err("parser: logical operators require Bool operands")
    }
    let mut known: Bool = left.known && right.known
    if starts_with(left.type_name, "UInt") { known = false }
    let mut result_type: String = left.type_name
    let mut display: String = ""
    if operator == "==" || operator == "!=" || operator == "<" || operator == "<=" || operator == ">" || operator == ">=" || operator == "&&" || operator == "||" {
        result_type = "Bool"
    }
    if known {
        if left.type_name == "Int" {
            let a: Int = int(left.display)
            let b: Int = int(right.display)
            if (operator == "/" || operator == "%") && b == 0 {
                return err("parser: division by zero")
            }
            if operator == "+" { display = str(a + b) }
            else if operator == "-" { display = str(a - b) }
            else if operator == "*" { display = str(a * b) }
            else if operator == "/" { display = str(a / b) }
            else if operator == "%" { display = str(a % b) }
            else if operator == "==" { display = bool_text(a == b) }
            else if operator == "!=" { display = bool_text(a != b) }
            else if operator == "<" { display = bool_text(a < b) }
            else if operator == "<=" { display = bool_text(a <= b) }
            else if operator == ">" { display = bool_text(a > b) }
            else if operator == ">=" { display = bool_text(a >= b) }
            else { known = false }
        } else {
            if operator == "==" { display = bool_text(left.display == right.display) }
            else if operator == "!=" { display = bool_text(left.display != right.display) }
            else if operator == "&&" { display = bool_text(left.display == "true" && right.display == "true") }
            else if operator == "||" { display = bool_text(left.display == "true" || right.display == "true") }
            else { known = false }
        }
    }
    return ok(SourceExpr{
        row: source_row_binary(result_type, operator, left.reference, right.reference), reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions),
        type_name: result_type,
        known: known,
        display: display,
        location: prefix,
        empty_kind: "",
    })
}

fn parse_struct_literal(parser: SourceParser, type_name: String, token: SourceToken) -> Result[ParsedExpr, String] {
    let prefix: SourceToken = node_prefix(token)
    let definition: Option[SourceStruct] = map_get(parser.structs, type_name)
    if is_none(definition) { return err("parser: unknown struct '" + type_name + "'") }
    let shape: SourceStruct = unwrap_or(definition, SourceStruct{ symbol: "", module_id: "", public: false, fields: {}, names: [], public_fields: {} })
    let opened: Result[SourceParser, String] = expect(parser, "{")
    if is_err(opened) { return err(parser_error(opened)) }
    let mut current: SourceParser = skip_separators(result_unwrap(opened))
    let mut names: Array[String] = []
    let mut values: Array[KIRIndexRef] = []
    let mut seen: Map[String, Bool] = {}
    let mut first: Bool = true
    let mut count: Int = 0
    while current_token(current).text != "}" {
        let field_name: SourceToken = current_token(current)
        if field_name.kind != "identifier" { return err("parser: expected a struct field name in literal") }
        if !map_contains_key(shape.fields, field_name.text) { return err("parser: unknown field '" + field_name.text + "' in struct '" + type_name + "'") }
        if shape.module_id != parser.module_id && !source_struct_field_is_public(parser, shape.symbol, field_name.text) { return err("parser: field '" + field_name.text + "' is private in struct '" + type_name + "'") }
        if map_contains_key(seen, field_name.text) { return err("parser: duplicate field '" + field_name.text + "' in struct literal") }
        let colon: Result[SourceParser, String] = expect(advance(current), ":")
        if is_err(colon) { return err(parser_error(colon)) }
        let parsed_value: Result[ParsedExpr, String] = parse_expression(result_unwrap(colon))
        if is_err(parsed_value) { return err(source_expression_error(parsed_value)) }
        let value: ParsedExpr = result_unwrap(parsed_value)
        let expected: String = unwrap_or(map_get(shape.fields, field_name.text), "")
        let field_value: SourceExpr = apply_empty_type(value.expression, expected)
        if field_value.type_name != expected { return err("parser: struct field '" + field_name.text + "' expects " + expected) }
        names = array_push(names, field_name.text)
        let stored_field: ParsedExpr = store_source_expression(value.parser, field_value)
        values = array_push(values, stored_field.expression.reference)
        first = false
        count = count + 1
        seen = map_insert(seen, field_name.text, true)
        current = skip_separators(stored_field.parser)
        if current_token(current).text == "," {
            current = skip_separators(advance(current))
        } else if current_token(current).text != "}" {
            return err("parser: expected ',' or '}' after struct literal field")
        }
    }
    if count != len(shape.names) { return err("parser: struct literal for '" + type_name + "' is missing a field") }
    let mut index: Int = 0
    while index < len(shape.names) {
        let expected_name: String = unwrap_or(array_get(shape.names, index), "")
        if !map_contains_key(seen, expected_name) { return err("parser: struct literal for '" + type_name + "' is missing field '" + expected_name + "'") }
        index = index + 1
    }
    let closed: Result[SourceParser, String] = expect(current, "}")
    if is_err(closed) { return err(parser_error(closed)) }
    let extended_prefix: SourceToken = node_prefix_range(token, previous_token(result_unwrap(closed)).byte_end)
    let value_edges: KIRTypedAppendRange = kir_typed_append_edges(result_unwrap(closed).arena, values)
    let row: KIRTypedExpression = source_row_struct(shape.symbol, shape.symbol, shape.symbol, names, value_edges.range)
    return ok(store_parsed_expression(ParsedExpr{ parser: source_with_arena(result_unwrap(closed), value_edges.arena), expression: SourceExpr{ row: row, reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), type_name: shape.symbol, known: false, display: "", location: extended_prefix, empty_kind: "" } }))
}

fn parse_enum_variant(parser: SourceParser, enum_name: String, token: SourceToken) -> Result[ParsedExpr, String] {
    let prefix: SourceToken = node_prefix(token)
    let declaration: Option[SourceStruct] = map_get(parser.structs, enum_name)
    if is_none(declaration) {
        if map_contains_key(parser.structs, "private:" + enum_name) { return err("parser: imported enum '" + enum_name + "' is private") }
        return err("parser: unknown enum '" + enum_name + "'")
    }
    let shape: SourceStruct = unwrap_or(declaration, SourceStruct{ symbol: "", module_id: "", public: false, fields: {}, names: [], public_fields: {} })
    if !source_type_is_enum(shape) { return err("parser: type '" + enum_name + "' is not an enum") }
    let separator: Result[SourceParser, String] = expect(parser, "::")
    if is_err(separator) { return err(parser_error(separator)) }
    let variant: SourceToken = current_token(result_unwrap(separator))
    if variant.kind != "identifier" { return err("parser: expected an enum variant after '::'") }
    if !source_string_array_contains(shape.names, variant.text) { return err("parser: unknown enum variant '" + enum_name + "::" + variant.text + "'") }
    let next: SourceParser = advance(result_unwrap(separator))
    let extended_prefix: SourceToken = node_prefix_range(token, variant.byte_end)
    let row: KIRTypedExpression = source_row_enum(shape.symbol, shape.symbol, variant.text)
    return ok(store_parsed_expression(ParsedExpr{ parser: next, expression: SourceExpr{ row: row, reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), type_name: shape.symbol, known: false, display: "", location: extended_prefix, empty_kind: "" } }))
}

fn parse_primary(parser: SourceParser) -> Result[ParsedExpr, String] {
    let token: SourceToken = current_token(parser)
    let prefix: SourceToken = node_prefix(token)
    if token.kind == "string" {
        return ok(store_parsed_expression(ParsedExpr{ parser: advance(parser), expression: literal_string(token.text, token) }))
    }
    if token.kind == "integer" {
        return ok(store_parsed_expression(ParsedExpr{ parser: advance(parser), expression: literal_int(int(token.text), token) }))
    }
    if token.text == "true" || token.text == "false" {
        return ok(store_parsed_expression(ParsedExpr{ parser: advance(parser), expression: literal_bool(token.text == "true", token) }))
    }
    if token.text == "nil" {
        return ok(store_parsed_expression(ParsedExpr{ parser: advance(parser), expression: SourceExpr{ row: source_row_nil("Nil"), reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), type_name: "Nil", known: true, display: "", location: prefix, empty_kind: "" } }))
    }
    if token.text == "(" {
        let nested: Result[ParsedExpr, String] = parse_expression(advance(parser))
        if is_err(nested) { return err(source_expression_error(nested)) }
        let parsed: ParsedExpr = result_unwrap(nested)
        let closed: Result[SourceParser, String] = expect(parsed.parser, ")")
        if is_err(closed) { return err(parser_error(closed)) }
        return ok(store_parsed_expression(ParsedExpr{ parser: result_unwrap(closed), expression: parsed.expression }))
    }
    if token.kind == "identifier" {
        let after_name: SourceParser = advance(parser)
        if current_token(after_name).text == "::" { return parse_enum_variant(after_name, token.text, token) }
        if current_token(after_name).text == "(" {
            let opening_token: SourceToken = current_token(after_name)
            let mut return_type: String = ""
            let mut expected: Array[String] = []
            let mut call_target: String = ""
            let mut call_name: String = token.text
            let mut builtin_generic: Bool = false
            let mut builtin_unsigned_conversion: Bool = false
            if token.text == "u8" || token.text == "u16" || token.text == "u32" || token.text == "u64" {
                if token.text == "u8" { return_type = "UInt8" }
                else if token.text == "u16" { return_type = "UInt16" }
                else if token.text == "u32" { return_type = "UInt32" }
                else { return_type = "UInt64" }
                call_target = "builtin:" + token.text
                builtin_unsigned_conversion = true
            } else if is_generic_builtin(token.text) {
                call_target = "builtin:" + token.text
                builtin_generic = true
            } else {
                let signature: Option[SourceFunction] = map_get(parser.functions, token.text)
                if is_none(signature) { return err("parser: unknown function '" + token.text + "'") }
                let found: SourceFunction = unwrap_or(signature, SourceFunction{ return_type: "", parameters: [], symbol: "" })
                return_type = found.return_type
                expected = found.parameters
                call_target = "function:" + found.symbol
                call_name = found.symbol
            }
            let mut current: SourceParser = advance(after_name)
            let mut args: Array[KIRIndexRef] = []
            let mut argument_types: Array[String] = []
            let mut first: Bool = true
            let mut argument_index: Int = 0
            while current_token(current).kind != "symbol" || current_token(current).text != ")" {
                let argument: Result[ParsedExpr, String] = parse_expression(current)
                if is_err(argument) { return err(source_expression_error(argument)) }
                let parsed_argument: ParsedExpr = result_unwrap(argument)
                let mut argument_expression: SourceExpr = parsed_argument.expression
                if token.text == "unwrap_or" && argument_index == 1 {
                    let option_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if is_option_type(option_type) {
                        argument_expression = apply_empty_type(argument_expression, generic_inner(option_type, "Option["))
                    }
                }
                if !builtin_generic && !builtin_unsigned_conversion {
                    if argument_index >= len(expected) { return err("parser: too many function arguments") }
                    let expected_argument_type: String = unwrap_or(array_get(expected, argument_index), "")
                    argument_expression = apply_empty_type(argument_expression, expected_argument_type)
                    if argument_expression.type_name != expected_argument_type {
                        return err("parser: function '" + token.text + "' argument " + str(argument_index) + " expects '" + expected_argument_type + "', got '" + argument_expression.type_name + "'")
                    }
                }
                let stored_argument: ParsedExpr = store_source_expression(parsed_argument.parser, argument_expression)
                args = array_push(args, stored_argument.expression.reference)
                argument_types = array_push(argument_types, argument_expression.type_name)
                first = false
                argument_index = argument_index + 1
                current = stored_argument.parser
                if current_token(current).text == "," {
                    current = advance(current)
                } else if current_token(current).text != ")" {
                    return err("parser: expected ',' or ')' after function argument")
                }
            }
            if builtin_unsigned_conversion {
                if argument_index != 1 { return err("parser: unsigned conversion expects one argument") }
                let argument_type: String = unwrap_or(array_get(argument_types, 0), "")
                if argument_type != "Int" && !starts_with(argument_type, "UInt") { return err("parser: unsigned conversion expects Int or UInt") }
            }
            if !builtin_generic && !builtin_unsigned_conversion && argument_index != len(expected) { return err("parser: function '" + token.text + "' expects " + str(len(expected)) + " arguments, got " + str(argument_index)) }
            if builtin_generic {
                if starts_with(token.text, "ffi_") {
                    let ffi_return: Result[String, String] = source_ffi_return_type(token.text, argument_types, argument_index)
                    if is_err(ffi_return) { return err(unwrap_or(result_error(ffi_return), "invalid FFI builtin signature")) }
                    return_type = result_unwrap(ffi_return)
                } else if token.text == "assert" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Bool" { return err("parser: assert expects one Bool") }
                    return_type = "Nil"
                } else if token.text == "assert_eq" {
                    if argument_index != 2 || unwrap_or(array_get(argument_types, 0), "") != unwrap_or(array_get(argument_types, 1), "") { return err("parser: assert_eq expects matching values") }
                    let asserted_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if source_type_contains_function(parser, asserted_type, {}) { return err("parser: assert_eq does not support values containing functions") }
                    return_type = "Nil"
                } else if token.text == "contains" || token.text == "starts_with" || token.text == "ends_with" {
                    if argument_index != 2 || unwrap_or(array_get(argument_types, 0), "") != "String" || unwrap_or(array_get(argument_types, 1), "") != "String" { return err("parser: string predicate expects two String arguments") }
                    return_type = "Bool"
                } else if token.text == "string_chars" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "String" { return err("parser: string_chars expects one String") }
                    return_type = "Array[String]"
                } else if token.text == "codepoints" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "String" { return err("parser: codepoints expects one String") }
                    return_type = "Array[Int]"
                } else if token.text == "substring" {
                    if argument_index != 3 || unwrap_or(array_get(argument_types, 0), "") != "String" || unwrap_or(array_get(argument_types, 1), "") != "Int" || unwrap_or(array_get(argument_types, 2), "") != "Int" { return err("parser: substring expects String, Int, Int") }
                    return_type = "Result[String,String]"
                } else if token.text == "str" {
                    if argument_index != 1 { return err("parser: str expects one argument") }
                    return_type = "String"
                } else if token.text == "int" {
                    let int_argument_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if argument_index != 1 || (int_argument_type != "String" && int_argument_type != "Int" && int_argument_type != "Float" && int_argument_type != "Bool" && !starts_with(int_argument_type, "UInt")) { return err("parser: int expects String, Int, UInt, Float, or Bool") }
                    return_type = "Int"
                } else if token.text == "none" {
                    if argument_index != 0 { return err("parser: none expects no arguments") }
                    return_type = "Option[Int]"
                } else if token.text == "some" {
                    if argument_index != 1 { return err("parser: some expects one argument") }
                    return_type = "Option[" + unwrap_or(array_get(argument_types, 0), "") + "]"
                } else if token.text == "ok" {
                    if argument_index != 1 { return err("parser: ok expects one argument") }
                    return_type = "Result[" + unwrap_or(array_get(argument_types, 0), "") + ",String]"
                } else if token.text == "err" {
                    if argument_index != 1 { return err("parser: err expects one argument") }
                    return_type = "Result[Int," + unwrap_or(array_get(argument_types, 0), "") + "]"
                } else if token.text == "is_some" || token.text == "is_none" {
                    if argument_index != 1 || !is_option_type(unwrap_or(array_get(argument_types, 0), "")) { return err("parser: Option predicate expects one Option argument") }
                    return_type = "Bool"
                } else if token.text == "is_ok" || token.text == "is_err" {
                    if argument_index != 1 || !is_result_type(unwrap_or(array_get(argument_types, 0), "")) { return err("parser: Result predicate expects one Result argument") }
                    return_type = "Bool"
                } else if token.text == "unwrap_or" {
                    let option_type: String = unwrap_or(array_get(argument_types, 0), "")
                    let fallback_type: String = unwrap_or(array_get(argument_types, 1), "")
                    if argument_index != 2 || !is_option_type(option_type) { return err("parser: unwrap_or expects an Option and a fallback, got '" + option_type + "'") }
                    let option_inner: String = generic_inner(option_type, "Option[")
                    if option_inner != fallback_type { return err("parser: unwrap_or fallback type '" + fallback_type + "' does not match Option[" + option_inner + "]") }
                    return_type = fallback_type
                } else if token.text == "result_unwrap" {
                    let result_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if argument_index != 1 || !is_result_type(result_type) { return err("parser: result_unwrap expects one Result, got '" + result_type + "'") }
                    return_type = generic_inner(result_type, "Result[")
                } else if token.text == "result_error" {
                    if argument_index != 1 || !is_result_type(unwrap_or(array_get(argument_types, 0), "")) { return err("parser: result_error expects one Result") }
                    return_type = "Option[" + generic_error(unwrap_or(array_get(argument_types, 0), "")) + "]"
                } else if token.text == "len" {
                    let len_argument_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if argument_index != 1 || (!is_array_type(len_argument_type) && len_argument_type != "String" && len_argument_type != "Bytes" && !starts_with(len_argument_type, "Map[") && !starts_with(len_argument_type, "Set[")) { return err("parser: len expects one String, Bytes, Array, Map, or Set") }
                    return_type = "Int"
                } else if token.text == "array_push" {
                    if argument_index != 2 || !is_array_type(unwrap_or(array_get(argument_types, 0), "")) { return err("parser: array_push expects an Array and a value") }
                    if array_inner(unwrap_or(array_get(argument_types, 0), "")) != unwrap_or(array_get(argument_types, 1), "") { return err("parser: array_push element type does not match Array") }
                    return_type = unwrap_or(array_get(argument_types, 0), "")
                } else if token.text == "array_get" {
                    if argument_index != 2 || !is_array_type(unwrap_or(array_get(argument_types, 0), "")) || unwrap_or(array_get(argument_types, 1), "") != "Int" { return err("parser: array_get expects an Array and an Int index") }
                    return_type = "Option[" + array_inner(unwrap_or(array_get(argument_types, 0), "")) + "]"
                } else if token.text == "array_concat" {
                    if argument_index != 2 || !is_array_type(unwrap_or(array_get(argument_types, 0), "")) || unwrap_or(array_get(argument_types, 0), "") != unwrap_or(array_get(argument_types, 1), "") { return err("parser: array_concat expects matching Arrays") }
                    return_type = unwrap_or(array_get(argument_types, 0), "")
                } else if token.text == "array_indices" {
                    if argument_index != 1 || !is_array_type(unwrap_or(array_get(argument_types, 0), "")) { return err("parser: array_indices expects one Array") }
                    return_type = "Array[Int]"
                } else if token.text == "array_set" {
                    let array_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if argument_index != 3 || !is_array_type(array_type) || unwrap_or(array_get(argument_types, 1), "") != "Int" || array_inner(array_type) != unwrap_or(array_get(argument_types, 2), "") { return err("parser: array_set expects Array[T], Int, and T") }
                    return_type = "Result[" + array_type + ",String]"
                } else if token.text == "array_slice" {
                    let array_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if argument_index != 3 || !is_array_type(array_type) || unwrap_or(array_get(argument_types, 1), "") != "Int" || unwrap_or(array_get(argument_types, 2), "") != "Int" { return err("parser: array_slice expects Array[T] and two Int indexes") }
                    return_type = array_type
                } else if token.text == "bytes" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Array[Int]" { return err("parser: bytes expects Array[Int]") }
                    return_type = "Bytes"
                } else if token.text == "bytes_from_u8" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Array[UInt8]" { return err("parser: bytes_from_u8 expects Array[UInt8]") }
                    return_type = "Bytes"
                } else if token.text == "u8_array" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Bytes" { return err("parser: u8_array expects Bytes") }
                    return_type = "Array[UInt8]"
                } else if token.text == "string_to_bytes" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "String" { return err("parser: string_to_bytes expects String") }
                    return_type = "Bytes"
                } else if token.text == "process_args" {
                    if argument_index != 0 { return err("parser: process_args expects no arguments") }
                    return_type = "Array[String]"
                } else if token.text == "fs_read_text" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "String" { return err("parser: fs_read_text expects String") }
                    return_type = "Result[String,String]"
                } else if token.text == "fs_write_bytes" {
                    if argument_index != 2 || unwrap_or(array_get(argument_types, 0), "") != "String" || unwrap_or(array_get(argument_types, 1), "") != "Bytes" { return err("parser: fs_write_bytes expects String and Bytes") }
                    return_type = "Result[Nil,String]"
                } else if token.text == "json_parse" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "String" { return err("parser: json_parse expects String") }
                    return_type = "Result[Json,String]"
                } else if token.text == "json_stringify" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Json" { return err("parser: json_stringify expects Json") }
                    return_type = "String"
                } else if token.text == "json_kind" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Json" { return err("parser: json_kind expects Json") }
                    return_type = "String"
                } else if token.text == "json_array_len" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Json" { return err("parser: json_array_len expects Json") }
                    return_type = "Result[Int,String]"
                } else if token.text == "json_object_get" {
                    if argument_index != 2 || unwrap_or(array_get(argument_types, 0), "") != "Json" || unwrap_or(array_get(argument_types, 1), "") != "String" { return err("parser: json_object_get expects Json and String") }
                    return_type = "Result[Json,String]"
                } else if token.text == "json_object_keys" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Json" { return err("parser: json_object_keys expects Json") }
                    return_type = "Result[Array[String],String]"
                } else if token.text == "json_object_keys_allowed" {
                    if argument_index != 2 || unwrap_or(array_get(argument_types, 0), "") != "Json" || unwrap_or(array_get(argument_types, 1), "") != "String" { return err("parser: json_object_keys_allowed expects Json and String") }
                    return_type = "Bool"
                } else if token.text == "json_object_fields_empty_except" {
                    if argument_index != 4 || unwrap_or(array_get(argument_types, 0), "") != "Json" || unwrap_or(array_get(argument_types, 1), "") != "String" || unwrap_or(array_get(argument_types, 2), "") != "String" || unwrap_or(array_get(argument_types, 3), "") != "String" { return err("parser: json_object_fields_empty_except expects Json and three Strings") }
                    return_type = "Bool"
                } else if token.text == "json_array_get" {
                    if argument_index != 2 || unwrap_or(array_get(argument_types, 0), "") != "Json" || unwrap_or(array_get(argument_types, 1), "") != "Int" { return err("parser: json_array_get expects Json and Int") }
                    return_type = "Result[Json,String]"
                } else if token.text == "json_string" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Json" { return err("parser: json_string expects Json") }
                    return_type = "Result[String,String]"
                } else if token.text == "json_bool" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Json" { return err("parser: json_bool expects Json") }
                    return_type = "Result[Bool,String]"
                } else if token.text == "json_int" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Json" { return err("parser: json_int expects Json") }
                    return_type = "Result[Int,String]"
                } else if token.text == "json_uint" {
                    if argument_index != 1 || unwrap_or(array_get(argument_types, 0), "") != "Json" { return err("parser: json_uint expects Json") }
                    return_type = "Result[UInt64,String]"
                } else if token.text == "map_get" {
                    let map_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if argument_index != 2 || !starts_with(map_type, "Map[") || generic_inner(map_type, "Map[") != unwrap_or(array_get(argument_types, 1), "") { return err("parser: map_get expects Map[K,V] and K") }
                    return_type = "Option[" + generic_value(map_type, "Map[") + "]"
                } else if token.text == "map_insert" {
                    let map_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if argument_index != 3 || !starts_with(map_type, "Map[") || generic_inner(map_type, "Map[") != unwrap_or(array_get(argument_types, 1), "") || generic_value(map_type, "Map[") != unwrap_or(array_get(argument_types, 2), "") { return err("parser: map_insert expects Map[K,V], K, and V") }
                    return_type = map_type
                } else if token.text == "map_contains_key" {
                    let map_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if argument_index != 2 || !starts_with(map_type, "Map[") || generic_inner(map_type, "Map[") != unwrap_or(array_get(argument_types, 1), "") { return err("parser: map_contains_key expects Map[K,V] and K") }
                    return_type = "Bool"
                } else if token.text == "map_remove" {
                    let map_type: String = unwrap_or(array_get(argument_types, 0), "")
                    if argument_index != 2 || !starts_with(map_type, "Map[") || generic_inner(map_type, "Map[") != unwrap_or(array_get(argument_types, 1), "") { return err("parser: map_remove expects Map[K,V] and K") }
                    return_type = map_type
                } else if token.text == "print" || token.text == "println" {
                    if argument_index != 1 { return err("parser: print expects one argument") }
                    return_type = "Nil"
                }
            }
            let call_end: Int = current_token(current).byte_end
            let closed: Result[SourceParser, String] = expect(current, ")")
            if is_err(closed) { return err(parser_error(closed)) }
            let mut builtin_identity: String = ""
            if starts_with(call_target, "builtin:") { builtin_identity = result_unwrap(substring(call_target, 8, len(string_chars(call_target)) - 8)) }
            let call_prefix: SourceToken = prefix_with_diagnostic(node_prefix_range(token, call_end), opening_token)
            let argument_edges: KIRTypedAppendRange = kir_typed_append_edges(result_unwrap(closed).arena, args)
            let row: KIRTypedExpression = source_row_call(return_type, call_name, call_target, builtin_identity, argument_edges.range)
            let mut display: String = ""
            return ok(store_parsed_expression(ParsedExpr{ parser: source_with_arena(result_unwrap(closed), argument_edges.arena), expression: SourceExpr{ row: row, reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), type_name: return_type, known: false, display: display, location: call_prefix, empty_kind: "" } }))
        }
        if current_token(after_name).text == "{" && map_contains_key(parser.structs, token.text) {
            return parse_struct_literal(after_name, token.text, token)
        }
        let binding: Option[SourceBinding] = map_get(parser.bindings, token.text)
        if is_none(binding) { return err("parser: unknown identifier '" + token.text + "'") }
        return ok(store_parsed_expression(ParsedExpr{ parser: after_name, expression: variable_expr(token.text, unwrap_or(binding, SourceBinding{ reference: kir_typed_absent_ref(KIRTypedTable::KIRTableBindings), type_name: "", mutable: false, known: false, display: "", source: token.source, line: token.line, column: token.column, byte_start: token.byte_start }), token) }))
    }
    if token.text == "[" {
        let mut current: SourceParser = skip_separators(advance(parser))
        let mut items: Array[KIRIndexRef] = []
        let mut first: Bool = true
        let mut element_type: String = ""
        while current_token(current).kind != "symbol" || current_token(current).text != "]" {
            let item: Result[ParsedExpr, String] = parse_expression(current)
        if is_err(item) { return err(source_expression_error(item)) }
            let parsed_item: ParsedExpr = result_unwrap(item)
            if element_type == "" {
                element_type = parsed_item.expression.type_name
            } else if element_type != parsed_item.expression.type_name {
                return err("parser: array literal elements must have the same type")
            }
            items = array_push(items, parsed_item.expression.reference)
            first = false
            current = skip_separators(parsed_item.parser)
            if current_token(current).text == "," {
                current = skip_separators(advance(current))
            } else if current_token(current).text != "]" {
                return err("parser: expected ',' or ']' after array element, found '" + current_token(current).text + "' at position " + str(current.position))
            }
        }
        current = skip_separators(current)
        let closed: Result[SourceParser, String] = expect(current, "]")
        if is_err(closed) { return err(parser_error(closed)) }
        if element_type == "" { element_type = "Int" }
        let type_name: String = "Array[" + element_type + "]"
        let mut empty_kind: String = ""
        if first { empty_kind = "array" }
        let collection_prefix: SourceToken = node_prefix_range(token, previous_token(result_unwrap(closed)).byte_end)
        let item_edges: KIRTypedAppendRange = kir_typed_append_edges(result_unwrap(closed).arena, items)
        let row: KIRTypedExpression = source_row_array(type_name, item_edges.range)
        return ok(store_parsed_expression(ParsedExpr{ parser: source_with_arena(result_unwrap(closed), item_edges.arena), expression: SourceExpr{ row: row, reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), type_name: type_name, known: false, display: "", location: collection_prefix, empty_kind: empty_kind } }))
    }
    if token.text == "{" {
        let mut current: SourceParser = skip_separators(advance(parser))
        let mut keys: Array[KIRIndexRef] = []
        let mut values: Array[KIRIndexRef] = []
        let mut first: Bool = true
        let mut key_type: String = ""
        let mut value_type: String = ""
        while current_token(current).kind != "symbol" || current_token(current).text != "}" {
            let key: Result[ParsedExpr, String] = parse_expression(current)
            if is_err(key) { return err(source_expression_error(key)) }
            let parsed_key: ParsedExpr = result_unwrap(key)
            if key_type == "" {
                key_type = parsed_key.expression.type_name
            } else if key_type != parsed_key.expression.type_name {
                return err("parser: map keys must have one homogeneous type")
            }
            if parsed_key.expression.type_name != "Int" && parsed_key.expression.type_name != "Bool" && parsed_key.expression.type_name != "String" && !starts_with(parsed_key.expression.type_name, "UInt") {
                return err("parser: map keys must be Int, UInt, Bool, or String")
            }
            let colon: Result[SourceParser, String] = expect(parsed_key.parser, ":")
            if is_err(colon) { return err(parser_error(colon)) }
            let value: Result[ParsedExpr, String] = parse_expression(result_unwrap(colon))
            if is_err(value) { return err(source_expression_error(value)) }
            let parsed_value: ParsedExpr = result_unwrap(value)
            if value_type == "" {
                value_type = parsed_value.expression.type_name
            } else if value_type != parsed_value.expression.type_name {
                return err("parser: map values must have one homogeneous type")
            }
            keys = array_push(keys, parsed_key.expression.reference)
            values = array_push(values, parsed_value.expression.reference)
            first = false
            current = skip_separators(parsed_value.parser)
            if current_token(current).text == "," {
                current = skip_separators(advance(current))
            } else if current_token(current).text != "}" {
                return err("parser: expected ',' or '}' after map entry")
            }
        }
        let closed: Result[SourceParser, String] = expect(current, "}")
        if is_err(closed) { return err(parser_error(closed)) }
        if key_type == "" {
            key_type = "String"
            value_type = "Int"
        }
        let type_name: String = "Map[" + key_type + "," + value_type + "]"
        let mut empty_kind: String = ""
        if first { empty_kind = "map" }
        let collection_prefix: SourceToken = node_prefix_range(token, previous_token(result_unwrap(closed)).byte_end)
        let key_edges: KIRTypedAppendRange = kir_typed_append_edges(result_unwrap(closed).arena, keys)
        let value_edges: KIRTypedAppendRange = kir_typed_append_edges(key_edges.arena, values)
        let row: KIRTypedExpression = source_row_map(type_name, key_edges.range, value_edges.range)
        return ok(store_parsed_expression(ParsedExpr{ parser: source_with_arena(result_unwrap(closed), value_edges.arena), expression: SourceExpr{ row: row, reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), type_name: type_name, known: false, display: "", location: collection_prefix, empty_kind: empty_kind } }))
    }
    return err("parser: expected a literal, identifier, or parenthesized expression; found " + token.kind + " '" + token.text + "'")
}

fn parse_postfix(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_primary(parser)
    if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "[" || current_token(parsed.parser).text == "." || current_token(parsed.parser).text == "?" {
        let postfix_token: SourceToken = current_token(parsed.parser)
        let mut prefix: SourceToken = node_prefix(postfix_token)
        if current_token(parsed.parser).text == "." {
            let field_token: SourceToken = current_token(advance(parsed.parser))
            if field_token.kind != "identifier" { return err("parser: expected a struct field name after '.'") }
            let field_type: String = source_struct_field_type(parsed.parser, parsed.expression.type_name, field_token.text)
            if field_type == "" { return err("parser: unknown field '" + field_token.text + "' in struct '" + parsed.expression.type_name + "'") }
            let struct_definition: Option[SourceStruct] = map_get(parsed.parser.structs, parsed.expression.type_name)
            if !is_none(struct_definition) && unwrap_or(struct_definition, SourceStruct{ symbol: "", module_id: "", public: false, fields: {}, names: [], public_fields: {} }).module_id != parsed.parser.module_id && !source_struct_field_is_public(parsed.parser, parsed.expression.type_name, field_token.text) {
                return err("parser: field '" + field_token.text + "' is private in struct '" + parsed.expression.type_name + "'")
            }
            prefix = prefix_with_diagnostic(prefix_with_span_end(parsed.expression.location, field_token.byte_end), field_token)
            let row: KIRTypedExpression = source_row_field(field_type, parsed.expression.reference, field_token.text)
            parsed = store_parsed_expression(ParsedExpr{ parser: advance(advance(parsed.parser)), expression: SourceExpr{ row: row, reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), type_name: field_type, known: false, display: "", location: prefix, empty_kind: "" } })
            continue
        }
        if current_token(parsed.parser).text == "?" {
            let operand_type: String = parsed.expression.type_name
            let return_type: String = parsed.parser.return_type
            if return_type == "" { return err("parser: '?' is only valid inside a function returning Option or Result") }
            let mut type_name: String = ""
            if is_option_type(operand_type) {
                if source_generic_arity(operand_type, "Option[") != 1 { return err("parser: '?' operand must have type Option[T] or Result[T,E]") }
                if !is_option_type(return_type) || source_generic_arity(return_type, "Option[") != 1 { return err("parser: '?' requires an Option or Result matching the enclosing function return type") }
                type_name = generic_inner(operand_type, "Option[")
            } else if is_result_type(operand_type) {
                if source_generic_arity(operand_type, "Result[") != 2 { return err("parser: '?' operand must have type Option[T] or Result[T,E]") }
                if !is_result_type(return_type) || source_generic_arity(return_type, "Result[") != 2 || generic_error(operand_type) != generic_error(return_type) { return err("parser: '?' requires an Option or Result matching the enclosing function return type") }
                type_name = generic_inner(operand_type, "Result[")
            } else {
                return err("parser: '?' requires an Option or Result matching the enclosing function return type")
            }
            prefix = prefix_with_diagnostic(prefix_with_span_end(parsed.expression.location, postfix_token.byte_end), postfix_token)
            let row: KIRTypedExpression = source_row_propagate(type_name, parsed.expression.reference)
            parsed = store_parsed_expression(ParsedExpr{ parser: advance(parsed.parser), expression: SourceExpr{ row: row, reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), type_name: type_name, known: false, display: "", location: prefix, empty_kind: "" } })
            continue
        }
        let index: Result[ParsedExpr, String] = parse_expression(advance(parsed.parser))
        if is_err(index) { return err(source_expression_error(index)) }
        let parsed_index: ParsedExpr = result_unwrap(index)
        if parsed_index.expression.type_name != "Int" { return err("parser: array index must be Int") }
        let closed: Result[SourceParser, String] = expect(parsed_index.parser, "]")
        if is_err(closed) { return err(parser_error(closed)) }
        if !is_array_type(parsed.expression.type_name) { return err("parser: indexing requires Array[T]") }
        let type_name: String = array_inner(parsed.expression.type_name)
        prefix = prefix_with_diagnostic(prefix_with_span_end(parsed.expression.location, previous_token(result_unwrap(closed)).byte_end), postfix_token)
        let row: KIRTypedExpression = source_row_index(type_name, parsed_index.expression.reference, parsed.expression.reference)
        parsed = store_parsed_expression(ParsedExpr{ parser: result_unwrap(closed), expression: SourceExpr{ row: row, reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), type_name: type_name, known: false, display: "", location: prefix, empty_kind: "" } })
    }
    return ok(parsed)
}

fn parse_unary(parser: SourceParser) -> Result[ParsedExpr, String] {
    let token: SourceToken = current_token(parser)
    let prefix: SourceToken = node_prefix(token)
    if token.kind != "symbol" || (token.text != "-" && token.text != "!") {
        return parse_postfix(parser)
    }
    let nested: Result[ParsedExpr, String] = parse_unary(advance(parser))
    if is_err(nested) { return err(source_expression_error(nested)) }
    let parsed: ParsedExpr = result_unwrap(nested)
    if token.text == "-" && parsed.expression.type_name != "Int" {
        return err("parser: unary '-' expects Int")
    }
    if token.text == "!" && parsed.expression.type_name != "Bool" {
        return err("parser: unary '!' expects Bool")
    }
    let mut known: Bool = parsed.expression.known
    let mut display: String = ""
    if known {
        if token.text == "-" { display = str(0 - int(parsed.expression.display)) }
        else { display = bool_text(parsed.expression.display != "true") }
    }
    let type_name: String = parsed.expression.type_name
    let unary_prefix: SourceToken = prefix_with_span_end(prefix, prefix_span_end(parsed.expression.location))
    let row: KIRTypedExpression = source_row_unary(type_name, token.text, parsed.expression.reference)
    return ok(store_parsed_expression(ParsedExpr{ parser: parsed.parser, expression: SourceExpr{ row: row, reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), type_name: type_name, known: known, display: display, location: unary_prefix, empty_kind: "" } }))
}

fn parse_multiplication(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_unary(parser)
    if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "*" || current_token(parsed.parser).text == "/" || current_token(parsed.parser).text == "%" {
        let operator_token: SourceToken = current_token(parsed.parser)
        let operator: String = operator_token.text
        let right_result: Result[ParsedExpr, String] = parse_unary(advance(parsed.parser))
        if is_err(right_result) { return err(source_expression_error(right_result)) }
        let right: ParsedExpr = result_unwrap(right_result)
        let combined: Result[SourceExpr, String] = combine_values(parsed.expression, operator, right.expression, operator_token)
        if is_err(combined) { return err(unwrap_or(result_error(combined), "parser: binary expression failed")) }
        parsed = store_parsed_expression(ParsedExpr{ parser: right.parser, expression: result_unwrap(combined) })
    }
    return ok(parsed)
}

fn parse_addition(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_multiplication(parser)
    if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "+" || current_token(parsed.parser).text == "-" {
        let operator_token: SourceToken = current_token(parsed.parser)
        let operator: String = operator_token.text
        let right_result: Result[ParsedExpr, String] = parse_multiplication(advance(parsed.parser))
        if is_err(right_result) { return err(source_expression_error(right_result)) }
        let right: ParsedExpr = result_unwrap(right_result)
        let combined: Result[SourceExpr, String] = combine_values(parsed.expression, operator, right.expression, operator_token)
        if is_err(combined) { return err(unwrap_or(result_error(combined), "parser: binary expression failed")) }
        parsed = store_parsed_expression(ParsedExpr{ parser: right.parser, expression: result_unwrap(combined) })
    }
    return ok(parsed)
}

fn parse_shift(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_addition(parser)
    if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "<<" || current_token(parsed.parser).text == ">>" {
        let operator_token: SourceToken = current_token(parsed.parser)
        let operator: String = operator_token.text
        let right_result: Result[ParsedExpr, String] = parse_addition(advance(parsed.parser))
        if is_err(right_result) { return err(source_expression_error(right_result)) }
        let right: ParsedExpr = result_unwrap(right_result)
        let combined: Result[SourceExpr, String] = combine_values(parsed.expression, operator, right.expression, operator_token)
        if is_err(combined) { return err(unwrap_or(result_error(combined), "parser: comparison failed")) }
        parsed = store_parsed_expression(ParsedExpr{ parser: right.parser, expression: result_unwrap(combined) })
    }
    return ok(parsed)
}

fn parse_bitand(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_shift(parser)
    if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "&" {
        let operator_token: SourceToken = current_token(parsed.parser)
        let right_result: Result[ParsedExpr, String] = parse_shift(advance(parsed.parser))
        if is_err(right_result) { return err(source_expression_error(right_result)) }
        let right: ParsedExpr = result_unwrap(right_result)
        let combined: Result[SourceExpr, String] = combine_values(parsed.expression, "&", right.expression, operator_token)
        if is_err(combined) { return err(unwrap_or(result_error(combined), "parser: bitwise expression failed")) }
        parsed = store_parsed_expression(ParsedExpr{ parser: right.parser, expression: result_unwrap(combined) })
    }
    return ok(parsed)
}

fn parse_bitxor(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_bitand(parser)
    if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "^" {
        let operator_token: SourceToken = current_token(parsed.parser)
        let right_result: Result[ParsedExpr, String] = parse_bitand(advance(parsed.parser))
        if is_err(right_result) { return err(source_expression_error(right_result)) }
        let right: ParsedExpr = result_unwrap(right_result)
        let combined: Result[SourceExpr, String] = combine_values(parsed.expression, "^", right.expression, operator_token)
        if is_err(combined) { return err(unwrap_or(result_error(combined), "parser: bitwise expression failed")) }
        parsed = store_parsed_expression(ParsedExpr{ parser: right.parser, expression: result_unwrap(combined) })
    }
    return ok(parsed)
}

fn parse_bitor(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_bitxor(parser)
    if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "|" {
        let operator_token: SourceToken = current_token(parsed.parser)
        let right_result: Result[ParsedExpr, String] = parse_bitxor(advance(parsed.parser))
        if is_err(right_result) { return err(source_expression_error(right_result)) }
        let right: ParsedExpr = result_unwrap(right_result)
        let combined: Result[SourceExpr, String] = combine_values(parsed.expression, "|", right.expression, operator_token)
        if is_err(combined) { return err(unwrap_or(result_error(combined), "parser: bitwise expression failed")) }
        parsed = store_parsed_expression(ParsedExpr{ parser: right.parser, expression: result_unwrap(combined) })
    }
    return ok(parsed)
}

fn parse_comparison(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_bitor(parser)
    if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "==" || current_token(parsed.parser).text == "!=" || current_token(parsed.parser).text == "<" || current_token(parsed.parser).text == "<=" || current_token(parsed.parser).text == ">" || current_token(parsed.parser).text == ">=" {
        let operator_token: SourceToken = current_token(parsed.parser)
        let operator: String = operator_token.text
        let right_result: Result[ParsedExpr, String] = parse_bitor(advance(parsed.parser))
        if is_err(right_result) { return err(source_expression_error(right_result)) }
        let right: ParsedExpr = result_unwrap(right_result)
        let combined: Result[SourceExpr, String] = combine_values(parsed.expression, operator, right.expression, operator_token)
        if is_err(combined) { return err(unwrap_or(result_error(combined), "parser: comparison failed")) }
        parsed = store_parsed_expression(ParsedExpr{ parser: right.parser, expression: result_unwrap(combined) })
    }
    return ok(parsed)
}

fn parse_logical_and(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_comparison(parser)
        if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "&&" {
        let operator_token: SourceToken = current_token(parsed.parser)
        let right_result: Result[ParsedExpr, String] = parse_comparison(advance(parsed.parser))
        if is_err(right_result) { return err(source_expression_error(right_result)) }
        let right: ParsedExpr = result_unwrap(right_result)
        let combined: Result[SourceExpr, String] = combine_values(parsed.expression, "&&", right.expression, operator_token)
        if is_err(combined) { return err(unwrap_or(result_error(combined), "parser: logical expression failed")) }
        parsed = store_parsed_expression(ParsedExpr{ parser: right.parser, expression: result_unwrap(combined) })
    }
    return ok(parsed)
}

fn parse_expression(parser: SourceParser) -> Result[ParsedExpr, String] {
    let first: Result[ParsedExpr, String] = parse_logical_and(parser)
        if is_err(first) { return err(source_expression_error(first)) }
    let mut parsed: ParsedExpr = result_unwrap(first)
    while current_token(parsed.parser).text == "||" {
        let operator_token: SourceToken = current_token(parsed.parser)
        let right_result: Result[ParsedExpr, String] = parse_logical_and(advance(parsed.parser))
        if is_err(right_result) { return err(source_expression_error(right_result)) }
        let right: ParsedExpr = result_unwrap(right_result)
        let combined: Result[SourceExpr, String] = combine_values(parsed.expression, "||", right.expression, operator_token)
        if is_err(combined) { return err(unwrap_or(result_error(combined), "parser: logical expression failed")) }
        parsed = store_parsed_expression(ParsedExpr{ parser: right.parser, expression: result_unwrap(combined) })
    }
    return ok(parsed)
}

fn skip_separators(parser: SourceParser) -> SourceParser {
    let mut current: SourceParser = parser
    while current_token(current).text == ";" {
        current = advance(current)
    }
    return current
}

fn finish_statement(parser: SourceParser) -> Result[SourceParser, String] {
    let current: SourceToken = current_token(parser)
    if current.text == ";" {
        return ok(skip_separators(parser))
    }
    if current.kind == "eof" || current.text == "}" {
        return ok(parser)
    }
    return err("parser: expected a statement separator after '" + current.text + "'")
}

fn source_restore_bindings(parser: SourceParser, bindings: Map[String, SourceBinding]) -> SourceParser {
    return SourceParser{ tokens: parser.tokens, position: parser.position, module_id: parser.module_id, bindings: bindings, functions: parser.functions, structs: parser.structs, return_type: parser.return_type, arena: parser.arena }
}

fn source_append_binding(arena: KIRTypedArena, name: String, type_name: String, mutable: Bool, token: SourceToken) -> KIRTypedAppendRef {
    let span: KIRTypedAppendRef = kir_typed_append_span(arena, KIRTypedSourceSpan{ start: token.byte_start, end: token.byte_start + len(string_to_bytes(name)) })
    return kir_typed_append_binding(span.arena, KIRTypedBinding{ id: binding_id(name, token.source, token.byte_start, token.line, token.column), name: name, type_name: type_name, mutable: mutable, source: token.source, line: token.line, column: token.column, span: span.reference })
}

fn store_source_statement(parser: SourceParser, row: KIRTypedStatement, token: SourceToken, end: Int) -> ParsedStatements {
    let span: KIRTypedAppendRef = kir_typed_append_span(parser.arena, KIRTypedSourceSpan{ start: token.byte_start, end: end })
    let statement: KIRTypedAppendRef = kir_typed_append_statement(span.arena, KIRTypedStatement{ kind: row.kind, source: token.source, line: token.line, column: token.column, span: span.reference, name: row.name, binding: row.binding, mutable: row.mutable, is_const: row.is_const, annotation: row.annotation, init: row.init, expr: row.expr, target: row.target, value: row.value, cond: row.cond, then_body: row.then_body, else_body: row.else_body, body: row.body, iter: row.iter, return_value: row.return_value, scrutinee: row.scrutinee, arms: row.arms })
    return ParsedStatements{ parser: source_with_arena(parser, statement.arena), references: [statement.reference] }
}

fn parse_output(parser: SourceParser) -> Result[ParsedStatements, String] {
    let token: SourceToken = current_token(parser)
    let opening_token: SourceToken = current_token(advance(parser))
    let opened: Result[SourceParser, String] = expect(advance(parser), "(")
    if is_err(opened) { return err(parser_error(opened)) }
    let value: Result[ParsedExpr, String] = parse_expression(result_unwrap(opened))
    if is_err(value) { return err(source_expression_error(value)) }
    let parsed: ParsedExpr = result_unwrap(value)
    let call_end: Int = current_token(parsed.parser).byte_end
    let closed: Result[SourceParser, String] = expect(parsed.parser, ")")
    if is_err(closed) { return err(parser_error(closed)) }
    let separated: Result[SourceParser, String] = finish_statement(result_unwrap(closed))
    if is_err(separated) { return err(parser_error(separated)) }
    let arguments: KIRTypedAppendRange = kir_typed_append_edges(result_unwrap(separated).arena, [parsed.expression.reference])
    let call_location: SourceToken = prefix_with_diagnostic(node_prefix_range(token, call_end), opening_token)
    let call: SourceExpr = SourceExpr{ row: source_row_call("Nil", token.text, "builtin:" + token.text, token.text, arguments.range), reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), type_name: "Nil", known: false, display: "", location: call_location, empty_kind: "" }
    let stored: ParsedExpr = store_source_expression(source_with_arena(result_unwrap(separated), arguments.arena), call)
    return ok(store_source_statement(stored.parser, KIRTypedStatement{ kind: "expr", source: "", line: 0, column: 0, span: kir_typed_absent_ref(KIRTypedTable::KIRTableSpans), name: "", binding: kir_typed_absent_ref(KIRTypedTable::KIRTableBindings), mutable: false, is_const: false, annotation: "", init: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), expr: stored.expression.reference, target: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), cond: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), then_body: kir_typed_empty_edges(), else_body: kir_typed_empty_edges(), body: kir_typed_empty_edges(), iter: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), return_value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), scrutinee: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), arms: kir_typed_empty_edges() }, token, previous_token(result_unwrap(closed)).byte_end))
}

fn parse_binding(parser: SourceParser) -> Result[ParsedStatements, String] {
    let keyword_token: SourceToken = current_token(parser)
    let keyword: String = keyword_token.text
    let current: SourceParser = advance(parser)
    let mutable: Bool = keyword == "let" && current_token(current).text == "mut"
    let mut named: SourceParser = current
    if mutable {
        named = advance(current)
    }
    let name: SourceToken = current_token(named)
    if name.kind != "identifier" { return err("parser: expected a binding name") }
    let mut after_name: SourceParser = advance(named)
    let mut annotation: String = ""
    if current_token(after_name).text == ":" {
        let parsed_type: Result[ParsedType, String] = parse_type(advance(after_name))
        if is_err(parsed_type) { return err(unwrap_or(result_error(parsed_type), "parser: expected a type annotation")) }
        annotation = result_unwrap(parsed_type).name
        after_name = result_unwrap(parsed_type).parser
    }
    let equals: Result[SourceParser, String] = expect(after_name, "=")
    if is_err(equals) { return err(parser_error(equals)) }
    let value: Result[ParsedExpr, String] = parse_expression(result_unwrap(equals))
        if is_err(value) { return err(source_expression_error(value)) }
    let parsed: ParsedExpr = result_unwrap(value)
    let mut initializer: SourceExpr = apply_empty_type(parsed.expression, annotation)
    if annotation != "" && annotation != initializer.type_name {
        return err("parser: annotation for '" + name.text + "' expects '" + annotation + "', got '" + initializer.type_name + "'")
    }
    if keyword == "const" && !initializer.known {
        return err("parser: const initializer must be compile-time known")
    }
    let stored: ParsedExpr = store_source_expression(parsed.parser, initializer)
    let separated: Result[SourceParser, String] = finish_statement(stored.parser)
    if is_err(separated) { return err(parser_error(separated)) }
    let appended: KIRTypedAppendRef = source_append_binding(result_unwrap(separated).arena, name.text, initializer.type_name, mutable, name)
    let binding: SourceBinding = SourceBinding{ type_name: initializer.type_name, mutable: mutable, known: !mutable && initializer.known, display: initializer.display, source: name.source, line: name.line, column: name.column, byte_start: name.byte_start, reference: appended.reference }
    let updated: SourceParser = source_restore_bindings(source_with_arena(result_unwrap(separated), appended.arena), map_insert(result_unwrap(separated).bindings, name.text, binding))
    return ok(store_source_statement(updated, KIRTypedStatement{ kind: keyword, source: "", line: 0, column: 0, span: kir_typed_absent_ref(KIRTypedTable::KIRTableSpans), name: name.text, binding: appended.reference, mutable: mutable, is_const: keyword == "const", annotation: annotation, init: stored.expression.reference, expr: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), target: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), cond: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), then_body: kir_typed_empty_edges(), else_body: kir_typed_empty_edges(), body: kir_typed_empty_edges(), iter: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), return_value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), scrutinee: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), arms: kir_typed_empty_edges() }, keyword_token, previous_token(parsed.parser).byte_end))
}

fn parse_assignment(parser: SourceParser) -> Result[ParsedStatements, String] {
    let target: SourceToken = current_token(parser)
    let binding: Option[SourceBinding] = map_get(parser.bindings, target.text)
    if is_none(binding) { return err("parser: unknown assignment target '" + target.text + "'") }
    let info: SourceBinding = unwrap_or(binding, SourceBinding{ reference: kir_typed_absent_ref(KIRTypedTable::KIRTableBindings), type_name: "", mutable: false, known: false, display: "", source: target.source, line: target.line, column: target.column, byte_start: target.byte_start })
    if !info.mutable { return err("parser: assignment target '" + target.text + "' is not mutable") }
    let equals: Result[SourceParser, String] = expect(advance(parser), "=")
    if is_err(equals) { return err(parser_error(equals)) }
    let value: Result[ParsedExpr, String] = parse_expression(result_unwrap(equals))
        if is_err(value) { return err(source_expression_error(value)) }
    let parsed: ParsedExpr = result_unwrap(value)
    let updated_expression: SourceExpr = apply_empty_type(parsed.expression, info.type_name)
    if updated_expression.type_name != info.type_name { return err("parser: assignment to '" + target.text + "' expects '" + info.type_name + "', got '" + updated_expression.type_name + "'") }
    let stored_value: ParsedExpr = store_source_expression(parsed.parser, updated_expression)
    let separated: Result[SourceParser, String] = finish_statement(stored_value.parser)
    if is_err(separated) { return err(parser_error(separated)) }
    let updated: SourceParser = result_unwrap(separated)
    let replacement: SourceBinding = SourceBinding{ type_name: info.type_name, mutable: true, known: false, display: "", source: info.source, line: info.line, column: info.column, byte_start: info.byte_start, reference: info.reference }
    let next: SourceParser = source_restore_bindings(updated, map_insert(updated.bindings, target.text, replacement))
    let target_expression: ParsedExpr = store_source_expression(next, variable_expr(target.text, replacement, target))
    return ok(store_source_statement(target_expression.parser, KIRTypedStatement{ kind: "assign", source: "", line: 0, column: 0, span: kir_typed_absent_ref(KIRTypedTable::KIRTableSpans), name: "", binding: kir_typed_absent_ref(KIRTypedTable::KIRTableBindings), mutable: false, is_const: false, annotation: "", init: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), expr: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), target: target_expression.expression.reference, value: stored_value.expression.reference, cond: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), then_body: kir_typed_empty_edges(), else_body: kir_typed_empty_edges(), body: kir_typed_empty_edges(), iter: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), return_value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), scrutinee: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), arms: kir_typed_empty_edges() }, target, previous_token(parsed.parser).byte_end))
}

fn parse_call_statement(parser: SourceParser) -> Result[ParsedStatements, String] {
    let token: SourceToken = current_token(parser)
    let value: Result[ParsedExpr, String] = parse_expression(parser)
    if is_err(value) { return err(source_expression_error(value)) }
    let parsed: ParsedExpr = result_unwrap(value)
    if parsed.expression.type_name != "Nil" { return err("parser: scalar call result must be used in an expression") }
    let separated: Result[SourceParser, String] = finish_statement(parsed.parser)
    if is_err(separated) { return err(parser_error(separated)) }
    return ok(store_source_statement(result_unwrap(separated), KIRTypedStatement{ kind: "expr", source: "", line: 0, column: 0, span: kir_typed_absent_ref(KIRTypedTable::KIRTableSpans), name: "", binding: kir_typed_absent_ref(KIRTypedTable::KIRTableBindings), mutable: false, is_const: false, annotation: "", init: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), expr: parsed.expression.reference, target: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), cond: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), then_body: kir_typed_empty_edges(), else_body: kir_typed_empty_edges(), body: kir_typed_empty_edges(), iter: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), return_value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), scrutinee: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), arms: kir_typed_empty_edges() }, token, previous_token(parsed.parser).byte_end))
}

fn parse_return(parser: SourceParser) -> Result[ParsedStatements, String] {
    let token: SourceToken = current_token(parser)
    let mut current: SourceParser = advance(parser)
    let mut value: SourceExpr = SourceExpr{ row: source_row_nil("Nil"), reference: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), type_name: "Nil", known: true, display: "", location: token, empty_kind: "" }
    if current_token(current).text != ";" && current_token(current).text != "}" && current_token(current).kind != "eof" {
        let parsed: Result[ParsedExpr, String] = parse_expression(current)
        if is_err(parsed) { return err(source_expression_error(parsed)) }
        let result: ParsedExpr = result_unwrap(parsed)
        value = apply_empty_type(result.expression, parser.return_type)
        current = result.parser
    }
    let stored: ParsedExpr = store_source_expression(current, value)
    let separated: Result[SourceParser, String] = finish_statement(stored.parser)
    if is_err(separated) { return err(parser_error(separated)) }
    return ok(store_source_statement(result_unwrap(separated), KIRTypedStatement{ kind: "return", source: "", line: 0, column: 0, span: kir_typed_absent_ref(KIRTypedTable::KIRTableSpans), name: "", binding: kir_typed_absent_ref(KIRTypedTable::KIRTableBindings), mutable: false, is_const: false, annotation: "", init: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), expr: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), target: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), cond: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), then_body: kir_typed_empty_edges(), else_body: kir_typed_empty_edges(), body: kir_typed_empty_edges(), iter: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), return_value: stored.expression.reference, scrutinee: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), arms: kir_typed_empty_edges() }, token, previous_token(current).byte_end))
}

fn parse_block(parser: SourceParser) -> Result[ParsedStatements, String] {
    let opened: Result[SourceParser, String] = expect(parser, "{")
    if is_err(opened) { return err(parser_error(opened)) }
    let mut current: SourceParser = skip_separators(result_unwrap(opened))
    let mut body_items: KIRTypedIndexRefRows = kir_typed_reference_rows_empty()
    while current_token(current).kind != "symbol" || current_token(current).text != "}" {
        if current_token(current).kind == "eof" { return err("parser: unterminated block") }
        let statement: Result[ParsedStatements, String] = parse_statement(current)
        if is_err(statement) { return err("at block token '" + current_token(current).text + "' (position " + str(current.position) + "): " + statements_error(statement)) }
        let parsed: ParsedStatements = result_unwrap(statement)
        body_items = kir_typed_reference_rows_append_all(body_items, parsed.references)
        current = skip_separators(parsed.parser)
    }
    let closed: Result[SourceParser, String] = expect(current, "}")
    if is_err(closed) { return err(parser_error(closed)) }
    return ok(ParsedStatements{ parser: source_restore_bindings(result_unwrap(closed), parser.bindings), references: kir_typed_reference_rows_finish(body_items) })
}

fn parse_function_header(parser: SourceParser) -> Result[ParsedFunctionHeader, String] {
    let opened: Result[SourceParser, String] = expect(parser, "fn")
    if is_err(opened) { return err(parser_error(opened)) }
    let named: SourceParser = result_unwrap(opened)
    let name: SourceToken = current_token(named)
    if name.kind != "identifier" { return err("parser: expected a function name") }
    let parameters_open: Result[SourceParser, String] = expect(advance(named), "(")
    if is_err(parameters_open) { return err(parser_error(parameters_open)) }
    let mut current: SourceParser = result_unwrap(parameters_open)
    let mut parameter_types: Array[String] = []
    while current_token(current).text != ")" {
        let parameter_name: SourceToken = current_token(current)
        if parameter_name.kind != "identifier" { return err("parser: expected a parameter name") }
        let colon: Result[SourceParser, String] = expect(advance(current), ":")
        if is_err(colon) { return err(parser_error(colon)) }
        let parsed_type: Result[ParsedType, String] = parse_type(result_unwrap(colon))
        if is_err(parsed_type) { return err(unwrap_or(result_error(parsed_type), "parser: expected a parameter type")) }
        parameter_types = array_push(parameter_types, result_unwrap(parsed_type).name)
        current = result_unwrap(parsed_type).parser
        if current_token(current).text == "," {
            current = advance(current)
        } else if current_token(current).text != ")" {
            return err("parser: expected ',' or ')' after parameter")
        }
    }
    let closed_parameters: Result[SourceParser, String] = expect(current, ")")
    if is_err(closed_parameters) { return err(parser_error(closed_parameters)) }
    let arrow: Result[SourceParser, String] = expect(result_unwrap(closed_parameters), "->")
    if is_err(arrow) { return err(parser_error(arrow)) }
    let parsed_return: Result[ParsedType, String] = parse_type(result_unwrap(arrow))
    if is_err(parsed_return) { return err(unwrap_or(result_error(parsed_return), "parser: expected a function return type")) }
    let header: ParsedFunctionHeader = ParsedFunctionHeader{
        parser: result_unwrap(parsed_return).parser,
        name: name.text,
        signature: SourceFunction{ return_type: result_unwrap(parsed_return).name, parameters: parameter_types, symbol: source_function_symbol(parser.module_id, name.text) },
    }
    return ok(header)
}

fn collect_module_type_headers(module: SourceModule, module_index: Int, is_root: Bool) -> Result[SourceModuleContext, String] {
    let mut module_id: String = str(module_index)
    if is_root { module_id = "root" }
    let mut parser: SourceParser = SourceParser{ arena: kir_typed_empty_arena(), tokens: module.tokens, position: 0, module_id: module_id, bindings: {}, functions: {}, structs: {}, return_type: "" }
    let mut structs: Map[String, SourceStruct] = {}
    let mut struct_names: Array[String] = []
    let mut public_struct_names: Array[String] = []
    while current_token(parser).kind != "eof" {
        parser = skip_separators(parser)
        let mut declaration: SourceParser = parser
        let mut public: Bool = false
        if current_token(declaration).text == "pub" {
            public = true
            declaration = advance(declaration)
        }
        if current_token(declaration).text == "struct" {
            let name: SourceToken = current_token(advance(declaration))
            if name.kind != "identifier" { return err("module: expected a struct name in '" + module.path + "'") }
            if map_contains_key(structs, name.text) { return err("module: duplicate type '" + name.text + "' in '" + module.path + "'") }
            let definition: SourceStruct = SourceStruct{ symbol: source_struct_symbol(module_id, name.text), module_id: module_id, public: public, fields: {}, names: [], public_fields: {} }
            structs = map_insert(structs, name.text, definition)
            struct_names = array_push(struct_names, name.text)
            if public { public_struct_names = array_push(public_struct_names, name.text) }
            parser = skip_source_block(advance(advance(declaration)))
            continue
        }
        if current_token(declaration).text == "enum" {
            let enum_name: SourceToken = current_token(advance(declaration))
            if enum_name.kind != "identifier" { return err("module: expected an enum name in '" + module.path + "'") }
            if map_contains_key(structs, enum_name.text) { return err("module: duplicate type '" + enum_name.text + "' in '" + module.path + "'") }
            let definition: SourceStruct = SourceStruct{ symbol: source_enum_symbol(module_id, enum_name.text), module_id: module_id, public: public, fields: {}, names: [], public_fields: {} }
            structs = map_insert(structs, enum_name.text, definition)
            struct_names = array_push(struct_names, enum_name.text)
            if public { public_struct_names = array_push(public_struct_names, enum_name.text) }
            parser = skip_source_block(advance(advance(declaration)))
            continue
        }
        if current_token(declaration).text == "fn" {
            let header: Result[ParsedFunctionHeader, String] = parse_function_header(SourceParser{ arena: parser.arena, tokens: parser.tokens, position: declaration.position, module_id: module_id, bindings: {}, functions: {}, structs: structs, return_type: "" })
            if is_err(header) { return err(unwrap_or(result_error(header), "invalid function header")) }
            let parsed_header: ParsedFunctionHeader = result_unwrap(header)
            if current_token(parsed_header.parser).text != "{" { return err("module: expected a body for '" + parsed_header.name + "'") }
            parser = skip_source_block(parsed_header.parser)
            continue
        }
        if current_token(declaration).kind == "eof" { break }
        if current_token(parser).text == "{" { parser = skip_source_block(parser) }
        else { parser = advance(parser) }
    }
    return ok(SourceModuleContext{ module_id: module_id, functions: {}, public_names: [], structs: structs, struct_names: struct_names, public_struct_names: public_struct_names })
}

fn source_function_parameters_expose_private(structs: Map[String, SourceStruct], parameters: String) -> Bool {
    let chars: Array[String] = string_chars(parameters)
    let mut start: Int = 0
    let mut index: Int = 0
    let mut bracket_depth: Int = 0
    let mut parenthesis_depth: Int = 0
    while index <= len(chars) {
        let mut current: String = ""
        if index < len(chars) { current = unwrap_or(array_get(chars, index), "") }
        if index == len(chars) || (current == "," && bracket_depth == 0 && parenthesis_depth == 0) {
            if index > start {
                let parameter: Result[String, String] = substring(parameters, start, index - start)
                if is_err(parameter) { return true }
                if source_type_exposes_private(structs, result_unwrap(parameter)) { return true }
            }
            start = index + 1
        } else if current == "[" {
            bracket_depth = bracket_depth + 1
        } else if current == "]" {
            bracket_depth = bracket_depth - 1
        } else if current == "(" {
            parenthesis_depth = parenthesis_depth + 1
        } else if current == ")" {
            parenthesis_depth = parenthesis_depth - 1
        }
        index = index + 1
    }
    return false
}

fn source_function_type_exposes_private(structs: Map[String, SourceStruct], type_name: String) -> Bool {
    if !starts_with(type_name, "fn(") { return true }
    let chars: Array[String] = string_chars(type_name)
    let mut index: Int = 2
    let mut depth: Int = 0
    let mut closing: Int = -1
    while index < len(chars) {
        let current: String = unwrap_or(array_get(chars, index), "")
        if current == "(" {
            depth = depth + 1
        } else if current == ")" {
            depth = depth - 1
            if depth == 0 { closing = index; break }
        }
        index = index + 1
    }
    if closing < 0 || closing + 3 >= len(chars) { return true }
    let parameters: Result[String, String] = substring(type_name, 3, closing - 3)
    if is_err(parameters) { return true }
    if source_function_parameters_expose_private(structs, result_unwrap(parameters)) { return true }
    let returned: Result[String, String] = substring(type_name, closing + 3, len(chars) - closing - 3)
    if is_err(returned) { return true }
    return source_type_exposes_private(structs, result_unwrap(returned))
}

fn source_type_exposes_private(structs: Map[String, SourceStruct], type_name: String) -> Bool {
    if starts_with(type_name, "fn(") { return source_function_type_exposes_private(structs, type_name) }
    if is_array_type(type_name) { return source_type_exposes_private(structs, array_inner(type_name)) }
    if starts_with(type_name, "Option[") { return source_type_exposes_private(structs, generic_inner(type_name, "Option[")) }
    if starts_with(type_name, "Result[") {
        return source_type_exposes_private(structs, generic_inner(type_name, "Result[")) || source_type_exposes_private(structs, generic_error(type_name))
    }
    if starts_with(type_name, "Map[") {
        return source_type_exposes_private(structs, generic_inner(type_name, "Map[")) || source_type_exposes_private(structs, generic_value(type_name, "Map["))
    }
    if starts_with(type_name, "Set[") { return source_type_exposes_private(structs, generic_inner(type_name, "Set[")) }
    if source_is_scalar_type(type_name) { return false }
    let definition: Option[SourceStruct] = map_get(structs, type_name)
    if is_none(definition) { return false }
    return !unwrap_or(definition, SourceStruct{ symbol: "", module_id: "", public: false, fields: {}, names: [], public_fields: {} }).public
}

fn source_module_type_scope(modules: Array[SourceModule], contexts: Array[SourceModuleContext], module_index: Int) -> Result[Map[String, SourceStruct], String] {
    let module: SourceModule = unwrap_or(array_get(modules, module_index), SourceModule{ path: "", tokens: [], imports: [], import_records: [] })
    let mut scope: Map[String, SourceStruct] = {}
    let mut visible_names: Map[String, Bool] = {}
    let mut all_index: Int = 0
    while all_index < len(contexts) {
        let context: SourceModuleContext = unwrap_or(array_get(contexts, all_index), SourceModuleContext{ module_id: "", functions: {}, public_names: [], structs: {}, struct_names: [], public_struct_names: [] })
        let mut type_index: Int = 0
        while type_index < len(context.struct_names) {
            let own_type_name: String = unwrap_or(array_get(context.struct_names, type_index), "")
            let own_definition: Option[SourceStruct] = map_get(context.structs, own_type_name)
            if is_none(own_definition) { return err("module: missing struct header '" + own_type_name + "'") }
            let own_shape: SourceStruct = unwrap_or(own_definition, SourceStruct{ symbol: "", module_id: "", public: false, fields: {}, names: [], public_fields: {} })
            scope = map_insert(scope, own_shape.symbol, own_shape)
            if all_index == module_index {
                if map_contains_key(visible_names, own_type_name) { return err("module: duplicate type '" + own_type_name + "' in '" + module.path + "'") }
                visible_names = map_insert(visible_names, own_type_name, true)
                scope = map_insert(scope, own_type_name, own_shape)
            }
            type_index = type_index + 1
        }
        all_index = all_index + 1
    }
    let mut seen: Map[String, Bool] = {}
    let mut import_index: Int = 0
    while import_index < len(module.imports) {
        let imported_name: String = unwrap_or(array_get(module.imports, import_index), "")
        let imported_path: String = source_import_path(module.path, imported_name)
        if !map_contains_key(seen, imported_path) {
            let target_index: Int = find_source_module(modules, imported_path)
            if target_index < 0 { return err("module: import resolver lost module '" + imported_name + "'") }
            let imported: SourceModuleContext = unwrap_or(array_get(contexts, target_index), SourceModuleContext{ module_id: "", functions: {}, public_names: [], structs: {}, struct_names: [], public_struct_names: [] })
            let mut public_index: Int = 0
            while public_index < len(imported.public_struct_names) {
                let imported_public_type_name: String = unwrap_or(array_get(imported.public_struct_names, public_index), "")
                if map_contains_key(visible_names, imported_public_type_name) { return err("module: duplicate visible type '" + imported_public_type_name + "' in '" + module.path + "'") }
                let public_definition: Option[SourceStruct] = map_get(imported.structs, imported_public_type_name)
                if is_none(public_definition) { return err("module: missing export '" + imported_public_type_name + "' from '" + imported_name + "'") }
                let public_shape: SourceStruct = unwrap_or(public_definition, SourceStruct{ symbol: "", module_id: "", public: false, fields: {}, names: [], public_fields: {} })
                visible_names = map_insert(visible_names, imported_public_type_name, true)
                scope = map_insert(scope, imported_public_type_name, public_shape)
                public_index = public_index + 1
            }
            let mut private_index: Int = 0
            while private_index < len(imported.struct_names) {
                let imported_private_type_name: String = unwrap_or(array_get(imported.struct_names, private_index), "")
                let private_definition: Option[SourceStruct] = map_get(imported.structs, imported_private_type_name)
                if !is_none(private_definition) && !unwrap_or(private_definition, SourceStruct{ symbol: "", module_id: "", public: false, fields: {}, names: [], public_fields: {} }).public {
                    scope = map_insert(scope, "private:" + imported_private_type_name, unwrap_or(private_definition, SourceStruct{ symbol: "", module_id: "", public: false, fields: {}, names: [], public_fields: {} }))
                }
                private_index = private_index + 1
            }
            seen = map_insert(seen, imported_path, true)
        }
        import_index = import_index + 1
    }
    return ok(scope)
}

fn collect_module_context(module: SourceModule, headers: SourceModuleContext, type_scope: Map[String, SourceStruct]) -> Result[SourceModuleContext, String] {
    let module_id: String = headers.module_id
    let mut parser: SourceParser = SourceParser{ arena: kir_typed_empty_arena(), tokens: module.tokens, position: 0, module_id: module_id, bindings: {}, functions: {}, structs: type_scope, return_type: "" }
    let mut functions: Map[String, SourceFunction] = {}
    let mut public_names: Array[String] = []
    while current_token(parser).kind != "eof" {
        parser = skip_separators(parser)
        let mut declaration: SourceParser = parser
        let mut public: Bool = false
        if current_token(declaration).text == "pub" {
            public = true
            declaration = advance(declaration)
        }
        if current_token(declaration).text == "fn" {
            let parsed: Result[ParsedFunctionHeader, String] = parse_function_header(SourceParser{ arena: parser.arena, tokens: parser.tokens, position: declaration.position, module_id: module_id, bindings: {}, functions: {}, structs: parser.structs, return_type: "" })
            if is_err(parsed) { return err(unwrap_or(result_error(parsed), "invalid function header")) }
            let header: ParsedFunctionHeader = result_unwrap(parsed)
            if map_contains_key(functions, header.name) { return err("module: duplicate function '" + header.name + "' in '" + module.path + "'") }
            if public {
                let mut parameter_index: Int = 0
                while parameter_index < len(header.signature.parameters) {
                    let parameter_type: String = unwrap_or(array_get(header.signature.parameters, parameter_index), "")
                    if source_type_exposes_private(parser.structs, parameter_type) { return err("module: public function '" + header.name + "' exposes a private type") }
                    parameter_index = parameter_index + 1
                }
                if source_type_exposes_private(parser.structs, header.signature.return_type) { return err("module: public function '" + header.name + "' exposes a private return type") }
            }
            functions = map_insert(functions, header.name, header.signature)
            if public { public_names = array_push(public_names, header.name) }
            if current_token(header.parser).text != "{" { return err("module: expected a body for '" + header.name + "'") }
            parser = skip_source_block(header.parser)
            continue
        }
        if current_token(declaration).text == "struct" {
            let parsed_struct: Result[ParsedStruct, String] = parse_struct(SourceParser{ arena: parser.arena, tokens: parser.tokens, position: declaration.position, module_id: module_id, bindings: {}, functions: functions, structs: parser.structs, return_type: "" }, public)
            if is_err(parsed_struct) { return err("module '" + module.path + "': " + unwrap_or(result_error(parsed_struct), "invalid struct declaration")) }
            let completed: ParsedStruct = result_unwrap(parsed_struct)
            parser = completed.parser
            continue
        }
        if current_token(declaration).text == "enum" {
            let parsed_enum: Result[ParsedEnum, String] = parse_enum(SourceParser{ arena: parser.arena, tokens: parser.tokens, position: declaration.position, module_id: module_id, bindings: {}, functions: functions, structs: parser.structs, return_type: "" }, public, source_module_name(module.path, source_directory(module.path)))
            if is_err(parsed_enum) { return err("module '" + module.path + "': " + unwrap_or(result_error(parsed_enum), "invalid enum declaration")) }
            let completed_enum: ParsedEnum = result_unwrap(parsed_enum)
            parser = completed_enum.parser
            continue
        }
        if current_token(declaration).kind == "eof" { break }
        if current_token(parser).text == "{" { parser = skip_source_block(parser) }
        else { parser = advance(parser) }
    }
    let mut own_structs: Map[String, SourceStruct] = {}
    let mut struct_index: Int = 0
    while struct_index < len(headers.struct_names) {
        let name: String = unwrap_or(array_get(headers.struct_names, struct_index), "")
        let definition: Option[SourceStruct] = map_get(parser.structs, name)
        if is_none(definition) { return err("module: type '" + name + "' was not parsed in '" + module.path + "'") }
        own_structs = map_insert(own_structs, name, unwrap_or(definition, SourceStruct{ symbol: "", module_id: module_id, public: false, fields: {}, names: [], public_fields: {} }))
        struct_index = struct_index + 1
    }
    return ok(SourceModuleContext{ module_id: module_id, functions: functions, public_names: public_names, structs: own_structs, struct_names: headers.struct_names, public_struct_names: headers.public_struct_names })
}

fn find_source_module(modules: Array[SourceModule], path: String) -> Int {
    let mut index: Int = 0
    while index < len(modules) {
        let module: SourceModule = unwrap_or(array_get(modules, index), SourceModule{ path: "", tokens: [], imports: [], import_records: [] })
        if module.path == path { return index }
        index = index + 1
    }
    return -1
}

fn source_module_scope(modules: Array[SourceModule], contexts: Array[SourceModuleContext], module_index: Int) -> Result[Map[String, SourceFunction], String] {
    let module: SourceModule = unwrap_or(array_get(modules, module_index), SourceModule{ path: "", tokens: [], imports: [], import_records: [] })
    let own: SourceModuleContext = unwrap_or(array_get(contexts, module_index), SourceModuleContext{ module_id: "", functions: {}, public_names: [], structs: {}, struct_names: [], public_struct_names: [] })
    let mut scope: Map[String, SourceFunction] = own.functions
    let mut seen: Map[String, Bool] = {}
    let mut import_index: Int = 0
    while import_index < len(module.imports) {
        let imported_name: String = unwrap_or(array_get(module.imports, import_index), "")
        let imported_path: String = source_import_path(module.path, imported_name)
        if !map_contains_key(seen, imported_path) {
            let target_index: Int = find_source_module(modules, imported_path)
            if target_index < 0 { return err("module: import resolver lost module '" + imported_name + "'") }
            let imported: SourceModuleContext = unwrap_or(array_get(contexts, target_index), SourceModuleContext{ module_id: "", functions: {}, public_names: [], structs: {}, struct_names: [], public_struct_names: [] })
            let mut public_index: Int = 0
            while public_index < len(imported.public_names) {
                let name: String = unwrap_or(array_get(imported.public_names, public_index), "")
                if map_contains_key(scope, name) { return err("module: duplicate visible function '" + name + "' in '" + module.path + "'") }
                let signature: Option[SourceFunction] = map_get(imported.functions, name)
                if is_none(signature) { return err("module: missing export '" + name + "' from '" + imported_name + "'") }
                scope = map_insert(scope, name, unwrap_or(signature, SourceFunction{ return_type: "", parameters: [], symbol: "" }))
                public_index = public_index + 1
            }
            seen = map_insert(seen, imported_path, true)
        }
        import_index = import_index + 1
    }
    return ok(scope)
}

fn skip_source_block(parser: SourceParser) -> SourceParser {
    if current_token(parser).text != "{" { return parser }
    let mut current: SourceParser = parser
    let mut depth: Int = 0
    while current_token(current).kind != "eof" {
        let token: SourceToken = current_token(current)
        if token.kind == "symbol" && token.text == "{" {
            depth = depth + 1
        } else if token.kind == "symbol" && token.text == "}" {
            depth = depth - 1
            current = advance(current)
            if depth == 0 { return current }
            continue
        }
        current = advance(current)
    }
    return current
}

fn predeclare_functions(parser: SourceParser) -> Result[SourceParser, String] {
    let mut current: SourceParser = skip_separators(parser)
    let mut functions: Map[String, SourceFunction] = parser.functions
    while current_token(current).kind != "eof" {
        let mut declaration: SourceParser = current
        if current_token(declaration).text == "pub" {
            declaration = advance(declaration)
        }
        if current_token(declaration).kind == "identifier" && current_token(declaration).text == "fn" {
            let header: Result[ParsedFunctionHeader, String] = parse_function_header(declaration)
            if is_err(header) { return err(unwrap_or(result_error(header), "parser: invalid function header")) }
            let parsed_header: ParsedFunctionHeader = result_unwrap(header)
            if current_token(parsed_header.parser).text != "{" { return err("parser: expected a function body") }
            functions = map_insert(functions, parsed_header.name, parsed_header.signature)
            current = skip_source_block(parsed_header.parser)
            continue
        }
        if current_token(current).kind == "symbol" && current_token(current).text == "{" {
            current = skip_source_block(current)
            continue
        }
        current = advance(current)
    }
    return ok(SourceParser{ arena: parser.arena, tokens: parser.tokens, position: parser.position, module_id: parser.module_id, bindings: parser.bindings, functions: functions, structs: parser.structs, return_type: parser.return_type })
}

fn parse_function(parser: SourceParser, public: Bool) -> Result[ParsedFunction, String] {
    let opened: Result[SourceParser, String] = expect(parser, "fn")
    if is_err(opened) { return err(parser_error(opened)) }
    let named: SourceParser = result_unwrap(opened)
    let name: SourceToken = current_token(named)
    if name.kind != "identifier" { return err("parser: expected a function name") }
    let parameters_open: Result[SourceParser, String] = expect(advance(named), "(")
    if is_err(parameters_open) { return err(parser_error(parameters_open)) }
    let mut current: SourceParser = result_unwrap(parameters_open)
    let mut parameter_refs: Array[KIRIndexRef] = []
    let mut parameter_types: Array[String] = []
    let mut local_bindings: Map[String, SourceBinding] = {}
    while current_token(current).text != ")" {
        let parameter_name: SourceToken = current_token(current)
        if parameter_name.kind != "identifier" { return err("parser: expected a parameter name") }
        let colon: Result[SourceParser, String] = expect(advance(current), ":")
        if is_err(colon) { return err(parser_error(colon)) }
        let parsed_type: Result[ParsedType, String] = parse_type(result_unwrap(colon))
        if is_err(parsed_type) { return err(unwrap_or(result_error(parsed_type), "parser: expected a parameter type")) }
        let parameter_type: String = result_unwrap(parsed_type).name
        if !source_type_supported(parser, parameter_type) { return err("parser: unsupported function parameter type '" + parameter_type + "'") }
        let after_type: SourceParser = result_unwrap(parsed_type).parser
        let binding: KIRTypedAppendRef = source_append_binding(after_type.arena, parameter_name.text, parameter_type, false, parameter_name)
        let span: KIRTypedAppendRef = kir_typed_append_span(binding.arena, KIRTypedSourceSpan{ start: parameter_name.byte_start, end: previous_token(after_type).byte_end })
        let parameter: KIRTypedAppendRef = kir_typed_append_parameter(span.arena, KIRTypedParameter{ name: parameter_name.text, type_name: parameter_type, source: parameter_name.source, line: parameter_name.line, column: parameter_name.column, span: span.reference, default_value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), binding: binding.reference })
        let parameter_binding: SourceBinding = SourceBinding{ type_name: parameter_type, mutable: false, known: false, display: "", source: parameter_name.source, line: parameter_name.line, column: parameter_name.column, byte_start: parameter_name.byte_start, reference: binding.reference }
        parameter_refs = array_push(parameter_refs, parameter.reference)
        parameter_types = array_push(parameter_types, parameter_type)
        local_bindings = map_insert(local_bindings, parameter_name.text, parameter_binding)
        current = source_with_arena(after_type, parameter.arena)
        if current_token(current).text == "," {
            current = advance(current)
        } else if current_token(current).text != ")" {
            return err("parser: expected ',' or ')' after parameter")
        }
    }
    let closed_parameters: Result[SourceParser, String] = expect(current, ")")
    if is_err(closed_parameters) { return err(parser_error(closed_parameters)) }
    let arrow: Result[SourceParser, String] = expect(result_unwrap(closed_parameters), "->")
    if is_err(arrow) { return err(parser_error(arrow)) }
    let parsed_return: Result[ParsedType, String] = parse_type(result_unwrap(arrow))
    if is_err(parsed_return) { return err(unwrap_or(result_error(parsed_return), "parser: expected a function return type")) }
    let return_type: String = result_unwrap(parsed_return).name
    if return_type != "Nil" && !source_type_supported(parser, return_type) { return err("parser: unsupported function return type '" + return_type + "'") }
    let signature: SourceFunction = SourceFunction{ return_type: return_type, parameters: parameter_types, symbol: source_function_symbol(parser.module_id, name.text) }
    let after_return: SourceParser = result_unwrap(parsed_return).parser
    let local_parser: SourceParser = SourceParser{ tokens: after_return.tokens, position: after_return.position, module_id: parser.module_id, bindings: local_bindings, functions: map_insert(parser.functions, name.text, signature), structs: parser.structs, return_type: return_type, arena: after_return.arena }
    let body: Result[ParsedStatements, String] = parse_block(local_parser)
    if is_err(body) { return err(statements_error(body)) }
    let parsed_body: ParsedStatements = result_unwrap(body)
    let outer_parser: SourceParser = SourceParser{ tokens: parser.tokens, position: parsed_body.parser.position, module_id: parser.module_id, bindings: parser.bindings, functions: map_insert(parser.functions, name.text, signature), structs: parser.structs, return_type: parser.return_type, arena: parsed_body.parser.arena }
    let function_token: SourceToken = current_token(parser)
    let function_end: Int = previous_non_separator(parsed_body.parser).byte_end
    let span: KIRTypedAppendRef = kir_typed_append_span(outer_parser.arena, KIRTypedSourceSpan{ start: function_token.byte_start, end: function_end })
    let parameters: KIRTypedAppendRange = kir_typed_append_edges(span.arena, parameter_refs)
    let statements: KIRTypedAppendRange = kir_typed_append_edges(parameters.arena, parsed_body.references)
    let function: KIRTypedAppendRef = kir_typed_append_function(statements.arena, KIRTypedFunction{ name: signature.symbol, source: function_token.source, line: function_token.line, column: function_token.column, span: span.reference, public: public, worker: false, is_unsafe: false, trait_name: "", module: "", receiver: "", return_type: return_type, type_params: kir_typed_empty_edges(), params: parameters.range, captures: kir_typed_empty_edges(), body: statements.range })
    return ok(ParsedFunction{ parser: source_with_arena(outer_parser, function.arena), reference: function.reference })
}

fn parse_if(parser: SourceParser) -> Result[ParsedStatements, String] {
    let token: SourceToken = current_token(parser)
    let condition: Result[ParsedExpr, String] = parse_expression(advance(parser))
    if is_err(condition) { return err(source_expression_error(condition)) }
    let parsed_condition: ParsedExpr = result_unwrap(condition)
    if parsed_condition.expression.type_name != "Bool" { return err("parser: if condition must be Bool") }
    let then_block: Result[ParsedStatements, String] = parse_block(parsed_condition.parser)
    if is_err(then_block) { return err(statements_error(then_block)) }
    let parsed_then: ParsedStatements = result_unwrap(then_block)
    let mut after_then: SourceParser = skip_separators(parsed_then.parser)
    let mut else_refs: Array[KIRIndexRef] = []
    if current_token(after_then).text == "else" {
        let else_start: SourceParser = advance(after_then)
        if current_token(else_start).text == "if" {
            let else_if: Result[ParsedStatements, String] = parse_if(else_start)
            if is_err(else_if) { return err(statements_error(else_if)) }
            let parsed_else_if: ParsedStatements = result_unwrap(else_if)
            else_refs = parsed_else_if.references
            after_then = parsed_else_if.parser
        } else {
            let else_block: Result[ParsedStatements, String] = parse_block(else_start)
            if is_err(else_block) { return err(statements_error(else_block)) }
            let parsed_else: ParsedStatements = result_unwrap(else_block)
            else_refs = parsed_else.references
            after_then = parsed_else.parser
        }
    }
    let then_edges: KIRTypedAppendRange = kir_typed_append_edges(after_then.arena, parsed_then.references)
    let else_edges: KIRTypedAppendRange = kir_typed_append_edges(then_edges.arena, else_refs)
    return ok(store_source_statement(source_with_arena(after_then, else_edges.arena), KIRTypedStatement{ kind: "if", source: "", line: 0, column: 0, span: kir_typed_absent_ref(KIRTypedTable::KIRTableSpans), name: "", binding: kir_typed_absent_ref(KIRTypedTable::KIRTableBindings), mutable: false, is_const: false, annotation: "", init: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), expr: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), target: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), cond: parsed_condition.expression.reference, then_body: then_edges.range, else_body: else_edges.range, body: kir_typed_empty_edges(), iter: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), return_value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), scrutinee: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), arms: kir_typed_empty_edges() }, token, previous_non_separator(after_then).byte_end))
}

fn parse_match(parser: SourceParser) -> Result[ParsedStatements, String] {
    let token: SourceToken = current_token(parser)
    let scrutinee_result: Result[ParsedExpr, String] = parse_expression(advance(parser))
    if is_err(scrutinee_result) { return err(source_expression_error(scrutinee_result)) }
    let scrutinee: ParsedExpr = result_unwrap(scrutinee_result)
    let enum_declaration: Option[SourceStruct] = map_get(scrutinee.parser.structs, scrutinee.expression.type_name)
    if is_none(enum_declaration) { return err("parser: match scrutinee must be a fieldless enum") }
    let enum_shape: SourceStruct = unwrap_or(enum_declaration, SourceStruct{ symbol: "", module_id: "", public: false, fields: {}, names: [], public_fields: {} })
    if !source_type_is_enum(enum_shape) { return err("parser: match scrutinee must be a fieldless enum") }
    let opened: Result[SourceParser, String] = expect(scrutinee.parser, "{")
    if is_err(opened) { return err(parser_error(opened)) }
    let mut current: SourceParser = skip_separators(result_unwrap(opened))
    let mut arm_items: Array[KIRIndexRef] = []
    let mut seen_variants: Array[String] = []
    let mut wildcard_seen: Bool = false
    while current_token(current).text != "}" {
        if current_token(current).kind == "eof" { return err("parser: unterminated match arms") }
        if wildcard_seen { return err("parser: wildcard pattern must be the final match arm") }
        let pattern_token: SourceToken = current_token(current)
        let mut pattern_kind: String = "wildcard"
        let mut pattern_type_name: String = ""
        let mut pattern_variant: String = ""
        let mut pattern_end: Int = pattern_token.byte_end
        if pattern_token.kind != "identifier" { return err("parser: expected an enum variant or '_' match pattern") }
        if pattern_token.text == "_" {
            wildcard_seen = true
            current = advance(current)
        } else {
            let pattern_type: String = pattern_token.text
            let pattern_declaration: Option[SourceStruct] = map_get(current.structs, pattern_type)
            if is_none(pattern_declaration) {
                if map_contains_key(current.structs, "private:" + pattern_type) { return err("parser: imported enum '" + pattern_type + "' is private") }
                return err("parser: unknown enum '" + pattern_type + "' in match pattern")
            }
            let pattern_shape: SourceStruct = unwrap_or(pattern_declaration, SourceStruct{ symbol: "", module_id: "", public: false, fields: {}, names: [], public_fields: {} })
            if !source_type_is_enum(pattern_shape) { return err("parser: match pattern type '" + pattern_type + "' is not an enum") }
            if pattern_shape.symbol != enum_shape.symbol { return err("parser: match pattern enum type does not match the scrutinee type") }
            let separator: Result[SourceParser, String] = expect(advance(current), "::")
            if is_err(separator) { return err(parser_error(separator)) }
            let variant: SourceToken = current_token(result_unwrap(separator))
            if variant.kind != "identifier" { return err("parser: expected an enum variant after '::' in match pattern") }
            if !source_string_array_contains(pattern_shape.names, variant.text) { return err("parser: unknown enum variant '" + pattern_type + "::" + variant.text + "' in match pattern") }
            if source_string_array_contains(seen_variants, variant.text) { return err("parser: duplicate enum match pattern '" + pattern_type + "::" + variant.text + "'") }
            seen_variants = array_push(seen_variants, variant.text)
            pattern_kind = "enum"
            pattern_type_name = pattern_shape.symbol
            pattern_variant = variant.text
            pattern_end = variant.byte_end
            current = advance(result_unwrap(separator))
        }
        let pattern_span: KIRTypedAppendRef = kir_typed_append_span(current.arena, KIRTypedSourceSpan{ start: pattern_token.byte_start, end: pattern_end })
        let pattern: KIRTypedAppendRef = kir_typed_append_pattern(pattern_span.arena, KIRTypedPattern{ kind: pattern_kind, source: pattern_token.source, line: pattern_token.line, column: pattern_token.column, span: pattern_span.reference, bool_value: false, int_value: 0, string_value: "", type_name: pattern_type_name, variant: pattern_variant, binding_name: "", present: false, ok: false, resolved_binding: kir_typed_absent_ref(KIRTypedTable::KIRTableBindings) })
        current = source_with_arena(current, pattern.arena)
        let arrow: Result[SourceParser, String] = expect(current, "=>")
        if is_err(arrow) { return err(parser_error(arrow)) }
        let body: Result[ParsedStatements, String] = parse_block(result_unwrap(arrow))
        if is_err(body) { return err(statements_error(body)) }
        let parsed_body: ParsedStatements = result_unwrap(body)
        let arm_end: Int = previous_non_separator(parsed_body.parser).byte_end
        let arm_span: KIRTypedAppendRef = kir_typed_append_span(parsed_body.parser.arena, KIRTypedSourceSpan{ start: pattern_token.byte_start, end: arm_end })
        let body_edges: KIRTypedAppendRange = kir_typed_append_edges(arm_span.arena, parsed_body.references)
        let arm: KIRTypedAppendRef = kir_typed_append_arm(body_edges.arena, KIRTypedArm{ source: pattern_token.source, line: pattern_token.line, column: pattern_token.column, span: arm_span.reference, pattern: pattern.reference, body: body_edges.range })
        arm_items = array_push(arm_items, arm.reference)
        current = source_restore_bindings(source_with_arena(parsed_body.parser, arm.arena), scrutinee.parser.bindings)
        current = skip_separators(current)
    }
    if !wildcard_seen {
        let mut variant_index: Int = 0
        while variant_index < len(enum_shape.names) {
            let expected_variant: String = unwrap_or(array_get(enum_shape.names, variant_index), "")
            if !source_string_array_contains(seen_variants, expected_variant) { return err("parser: non-exhaustive match; missing enum variant '" + expected_variant + "'") }
            variant_index = variant_index + 1
        }
    }
    let closed: Result[SourceParser, String] = expect(current, "}")
    if is_err(closed) { return err(parser_error(closed)) }
    let arms: KIRTypedAppendRange = kir_typed_append_edges(result_unwrap(closed).arena, arm_items)
    return ok(store_source_statement(source_with_arena(result_unwrap(closed), arms.arena), KIRTypedStatement{ kind: "match", source: "", line: 0, column: 0, span: kir_typed_absent_ref(KIRTypedTable::KIRTableSpans), name: "", binding: kir_typed_absent_ref(KIRTypedTable::KIRTableBindings), mutable: false, is_const: false, annotation: "", init: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), expr: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), target: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), cond: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), then_body: kir_typed_empty_edges(), else_body: kir_typed_empty_edges(), body: kir_typed_empty_edges(), iter: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), return_value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), scrutinee: scrutinee.expression.reference, arms: arms.range }, token, previous_token(result_unwrap(closed)).byte_end))
}

fn parse_while(parser: SourceParser) -> Result[ParsedStatements, String] {
    let token: SourceToken = current_token(parser)
    let condition: Result[ParsedExpr, String] = parse_expression(advance(parser))
    if is_err(condition) { return err(source_expression_error(condition)) }
    let parsed_condition: ParsedExpr = result_unwrap(condition)
    if parsed_condition.expression.type_name != "Bool" { return err("parser: while condition must be Bool") }
    let body: Result[ParsedStatements, String] = parse_block(parsed_condition.parser)
    if is_err(body) { return err(statements_error(body)) }
    let parsed_body: ParsedStatements = result_unwrap(body)
    let body_edges: KIRTypedAppendRange = kir_typed_append_edges(parsed_body.parser.arena, parsed_body.references)
    return ok(store_source_statement(source_with_arena(parsed_body.parser, body_edges.arena), KIRTypedStatement{ kind: "while", source: "", line: 0, column: 0, span: kir_typed_absent_ref(KIRTypedTable::KIRTableSpans), name: "", binding: kir_typed_absent_ref(KIRTypedTable::KIRTableBindings), mutable: false, is_const: false, annotation: "", init: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), expr: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), target: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), cond: parsed_condition.expression.reference, then_body: kir_typed_empty_edges(), else_body: kir_typed_empty_edges(), body: body_edges.range, iter: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), return_value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), scrutinee: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), arms: kir_typed_empty_edges() }, token, previous_non_separator(parsed_body.parser).byte_end))
}

fn parse_for(parser: SourceParser) -> Result[ParsedStatements, String] {
    let token: SourceToken = current_token(parser)
    let binding_token: SourceToken = current_token(advance(parser))
    if binding_token.kind != "identifier" { return err("parser: expected a for binding name") }
    let in_token: Result[SourceParser, String] = expect(advance(advance(parser)), "in")
    if is_err(in_token) { return err(parser_error(in_token)) }
    let iterator: Result[ParsedExpr, String] = parse_expression(result_unwrap(in_token))
    if is_err(iterator) { return err(source_expression_error(iterator)) }
    let parsed_iterator: ParsedExpr = result_unwrap(iterator)
    if !is_array_type(parsed_iterator.expression.type_name) { return err("parser: for iterator must be Array[T]") }
    let item_type: String = array_inner(parsed_iterator.expression.type_name)
    let binding: KIRTypedAppendRef = source_append_binding(parsed_iterator.parser.arena, binding_token.text, item_type, false, binding_token)
    let loop_binding: SourceBinding = SourceBinding{ type_name: item_type, mutable: false, known: false, display: "", source: binding_token.source, line: binding_token.line, column: binding_token.column, byte_start: binding_token.byte_start, reference: binding.reference }
    let loop_parser: SourceParser = source_restore_bindings(source_with_arena(parsed_iterator.parser, binding.arena), map_insert(parsed_iterator.parser.bindings, binding_token.text, loop_binding))
    let body: Result[ParsedStatements, String] = parse_block(loop_parser)
    if is_err(body) { return err(statements_error(body)) }
    let parsed_body: ParsedStatements = result_unwrap(body)
    let outer: SourceParser = source_restore_bindings(parsed_body.parser, parser.bindings)
    let body_edges: KIRTypedAppendRange = kir_typed_append_edges(outer.arena, parsed_body.references)
    return ok(store_source_statement(source_with_arena(outer, body_edges.arena), KIRTypedStatement{ kind: "for", source: "", line: 0, column: 0, span: kir_typed_absent_ref(KIRTypedTable::KIRTableSpans), name: binding_token.text, binding: binding.reference, mutable: false, is_const: false, annotation: "", init: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), expr: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), target: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), cond: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), then_body: kir_typed_empty_edges(), else_body: kir_typed_empty_edges(), body: body_edges.range, iter: parsed_iterator.expression.reference, return_value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), scrutinee: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), arms: kir_typed_empty_edges() }, token, previous_non_separator(parsed_body.parser).byte_end))
}

fn parse_statement(parser: SourceParser) -> Result[ParsedStatements, String] {
    let current: SourceParser = skip_separators(parser)
    let token: SourceToken = current_token(current)
    if token.kind == "eof" || token.text == "}" {
        return err("parser: expected a statement")
    }
    if token.text == "let" || token.text == "const" { return parse_binding(current) }
    if token.text == "print" || token.text == "println" { return parse_output(current) }
    if token.text == "if" { return parse_if(current) }
    if token.text == "match" { return parse_match(current) }
    if token.text == "while" { return parse_while(current) }
    if token.text == "for" { return parse_for(current) }
    if token.text == "break" || token.text == "continue" {
        let separated: Result[SourceParser, String] = finish_statement(advance(current))
        if is_err(separated) { return err(parser_error(separated)) }
        return ok(store_source_statement(result_unwrap(separated), KIRTypedStatement{ kind: token.text, source: "", line: 0, column: 0, span: kir_typed_absent_ref(KIRTypedTable::KIRTableSpans), name: "", binding: kir_typed_absent_ref(KIRTypedTable::KIRTableBindings), mutable: false, is_const: false, annotation: "", init: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), expr: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), target: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), cond: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), then_body: kir_typed_empty_edges(), else_body: kir_typed_empty_edges(), body: kir_typed_empty_edges(), iter: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), return_value: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), scrutinee: kir_typed_absent_ref(KIRTypedTable::KIRTableExpressions), arms: kir_typed_empty_edges() }, token, token.byte_end))
    }
    if token.text == "return" { return parse_return(current) }
    if token.kind == "identifier" && current_token(advance(current)).text == "=" { return parse_assignment(current) }
    if token.kind == "identifier" && current_token(advance(current)).text == "(" { return parse_call_statement(current) }
    return err("parser: unsupported statement '" + token.text + "'")
}

fn parse_program(parser: SourceParser, module_path: String) -> Result[ParsedProgram, String] {
    let declarations: Result[SourceParser, String] = predeclare_functions(parser)
    if is_err(declarations) { return err(unwrap_or(result_error(declarations), "parser: failed to collect function declarations")) }
    let mut current: SourceParser = skip_separators(result_unwrap(declarations))
    let mut statement_items: KIRTypedIndexRefRows = kir_typed_reference_rows_empty()
    let mut function_items: Array[KIRIndexRef] = []
    while current_token(current).kind != "eof" {
        let mut function_parser: SourceParser = current
        let mut public: Bool = false
        if current_token(current).text == "pub" {
            public = true
            function_parser = advance(current)
        }
        if current_token(function_parser).text == "struct" {
            let definition: Result[ParsedStruct, String] = parse_struct(function_parser, public)
            if is_err(definition) { return err(unwrap_or(result_error(definition), "struct parser error")) }
            let parsed_struct: ParsedStruct = result_unwrap(definition)
            current = skip_separators(parsed_struct.parser)
            continue
        }
        if current_token(function_parser).text == "enum" {
            let definition: Result[ParsedEnum, String] = parse_enum(function_parser, public, module_path)
            if is_err(definition) { return err(unwrap_or(result_error(definition), "enum parser error")) }
            let parsed_enum: ParsedEnum = result_unwrap(definition)
            current = skip_separators(parsed_enum.parser)
            continue
        }
        if current_token(function_parser).text == "fn" {
            let function: Result[ParsedFunction, String] = parse_function(function_parser, public)
            if is_err(function) { return err(unwrap_or(result_error(function), "function parser error")) }
            let parsed_function: ParsedFunction = result_unwrap(function)
            function_items = array_push(function_items, parsed_function.reference)
            current = skip_separators(parsed_function.parser)
            continue
        }
        let statement: Result[ParsedStatements, String] = parse_statement(current)
        if is_err(statement) { return err("at source token '" + current_token(current).text + "' (position " + str(current.position) + "): " + statements_error(statement)) }
        let parsed: ParsedStatements = result_unwrap(statement)
        statement_items = kir_typed_reference_rows_append_all(statement_items, parsed.references)
        if parsed.parser.position == current.position { return err("parser: made no progress") }
        current = skip_separators(parsed.parser)
    }
    return ok(ParsedProgram{ parser: current, statements: kir_typed_reference_rows_finish(statement_items), functions: function_items })
}

fn build_source_arena(path: String, target_os: String, target_arch: String, target_gui: Bool) -> Result[KIRTypedArena, String] {
    let initial: SourceModules = SourceModules{ items: [], visiting: {}, loaded: {} }
    let loaded: Result[SourceModules, String] = load_source_modules(path, initial, source_directory(path))
    if is_err(loaded) { return err(unwrap_or(result_error(loaded), "module load failed")) }
    let modules: Array[SourceModule] = result_unwrap(loaded).items
    let mut contexts: Array[SourceModuleContext] = []
    let mut index: Int = 0
    while index < len(modules) {
        let header_module: SourceModule = unwrap_or(array_get(modules, index), SourceModule{ path: "", tokens: [], imports: [], import_records: [] })
        let header_result: Result[SourceModuleContext, String] = collect_module_type_headers(header_module, index, index == len(modules) - 1)
        if is_err(header_result) { return err(unwrap_or(result_error(header_result), "module declaration error")) }
        contexts = array_push(contexts, result_unwrap(header_result))
        index = index + 1
    }
    index = 0
    while index < len(modules) {
        let implementation_module: SourceModule = unwrap_or(array_get(modules, index), SourceModule{ path: "", tokens: [], imports: [], import_records: [] })
        let headers: SourceModuleContext = unwrap_or(array_get(contexts, index), SourceModuleContext{ module_id: "", functions: {}, public_names: [], structs: {}, struct_names: [], public_struct_names: [] })
        let implementation_scope: Result[Map[String, SourceStruct], String] = source_module_type_scope(modules, contexts, index)
        if is_err(implementation_scope) { return err(unwrap_or(result_error(implementation_scope), "module type scope error")) }
        let implementation_result: Result[SourceModuleContext, String] = collect_module_context(implementation_module, headers, result_unwrap(implementation_scope))
        if is_err(implementation_result) { return err(unwrap_or(result_error(implementation_result), "module declaration error")) }
        let replaced: Result[Array[SourceModuleContext], String] = array_set(contexts, index, result_unwrap(implementation_result))
        if is_err(replaced) { return err(unwrap_or(result_error(replaced), "module context update failed")) }
        contexts = result_unwrap(replaced)
        index = index + 1
    }
    let mut function_items: Array[KIRIndexRef] = []
    let mut statements: Array[KIRIndexRef] = []
    let mut arena: KIRTypedArena = kir_typed_empty_source_arena()
    index = 0
    while index < len(modules) {
        let module: SourceModule = unwrap_or(array_get(modules, index), SourceModule{ path: "", tokens: [], imports: [], import_records: [] })
        let context: SourceModuleContext = unwrap_or(array_get(contexts, index), SourceModuleContext{ module_id: "", functions: {}, public_names: [], structs: {}, struct_names: [], public_struct_names: [] })
        let scope: Result[Map[String, SourceFunction], String] = source_module_scope(modules, contexts, index)
        if is_err(scope) { return err(unwrap_or(result_error(scope), "module scope error")) }
        let emission_type_scope: Result[Map[String, SourceStruct], String] = source_module_type_scope(modules, contexts, index)
        if is_err(emission_type_scope) { return err(unwrap_or(result_error(emission_type_scope), "module type scope error")) }
        let parser: SourceParser = SourceParser{ arena: arena, tokens: module.tokens, position: 0, module_id: context.module_id, bindings: {}, functions: result_unwrap(scope), structs: result_unwrap(emission_type_scope), return_type: "" }
        let program: Result[ParsedProgram, String] = parse_program(parser, portable_source_name(module.path, source_directory(path)))
        if is_err(program) { return err("module '" + module.path + "': " + program_error(program)) }
        let parsed: ParsedProgram = result_unwrap(program)
        if index != len(modules) - 1 && len(parsed.statements) != 0 { return err("module '" + module.path + "': imported modules cannot contain top-level statements") }
        function_items = array_concat(function_items, parsed.functions)
        arena = parsed.parser.arena
        arena = kir_typed_append_source(arena, portable_source_name(module.path, source_directory(path))).arena
        if index == len(modules) - 1 {
            statements = parsed.statements
            let mut import_index: Int = 0
            while import_index < len(module.imports) {
                arena = kir_typed_append_import(arena, unwrap_or(array_get(module.imports, import_index), "")).arena
                let record: SourceImport = unwrap_or(array_get(module.import_records, import_index), SourceImport{ path: "", token: current_token(parser) })
                let import_span: KIRTypedAppendRef = kir_typed_append_span(arena, KIRTypedSourceSpan{ start: record.token.byte_start, end: record.token.byte_end })
                let import_record: KIRTypedAppendRef = kir_typed_append_import_record(import_span.arena, KIRTypedImport{ path: record.path, source: record.token.source, line: record.token.line, column: record.token.column, span: import_span.reference })
                arena = import_record.arena
                import_index = import_index + 1
            }
        }
        index = index + 1
    }
    let function_edges: KIRTypedAppendRange = kir_typed_append_edges(arena, function_items)
    let statement_edges: KIRTypedAppendRange = kir_typed_append_edges(function_edges.arena, statements)
    let header: KIRTypedDocumentHeader = KIRTypedDocumentHeader{ format: "kry-ir", version: 6, language_version: "1.0.0", module: "", source: portable_source_name(path, source_directory(path)), target: KIRTypedTarget{ os: target_os, arch: target_arch, gui: target_gui }, top_functions: function_edges.range, top_statements: statement_edges.range }
    return ok(kir_typed_finish_source_build(kir_typed_append_document_ranges(statement_edges.arena, header)))
}

pub fn compile_path(path: String, target_os: String, target_arch: String, target_gui: Bool) -> Result[Bytes, String] {
    let arena: Result[KIRTypedArena, String] = build_source_arena(path, target_os, target_arch, target_gui)
    if is_err(arena) { return err(unwrap_or(result_error(arena), "source frontend failed to build KIR")) }
    let validated: Result[ValidatedKIR, String] = validate_kir_typed_arena(result_unwrap(arena))
    if is_err(validated) { return err("source KIR validation failed: " + unwrap_or(result_error(validated), "invalid typed KIR")) }
    return compile_validated_kir(result_unwrap(validated))
}

fn emit_source_kir(path: String, target_os: String, target_arch: String, target_gui: Bool) -> Result[String, String] {
    let arena: Result[KIRTypedArena, String] = build_source_arena(path, target_os, target_arch, target_gui)
    if is_err(arena) { return err(unwrap_or(result_error(arena), "source frontend failed to build KIR")) }
    let validated: Result[ValidatedKIR, String] = validate_kir_typed_arena(result_unwrap(arena))
    if is_err(validated) { return err("source KIR validation failed: " + unwrap_or(result_error(validated), "invalid typed KIR")) }
    return kir_typed_arena_serialize(validated_kir_typed_arena(result_unwrap(validated)))
}

fn fail_compilation(message: String) -> Nil {
	println(message)
    let failure: Result[Nil, String] = err(message)
    result_unwrap(failure)
    return nil
}

fn main() -> Nil {
    let args: Array[String] = process_args()
    let emit_kir: Bool = unwrap_or(array_get(args, 0), "") == "--emit-kir"
    let mut argument_offset: Int = 0
    if emit_kir { argument_offset = 1 }
    let required_arguments: Int = 2 + argument_offset
    if len(args) < required_arguments || len(args) > required_arguments + 1 {
        if emit_kir { return fail_compilation("source compiler KIR mode expects --emit-kir, source, output, and optional target") }
        return fail_compilation("source compiler expects source, output, and optional target (2 or 3 arguments), got " + str(len(args)))
    }
    let source_path: String = unwrap_or(array_get(args, argument_offset), "")
    let output_path: String = unwrap_or(array_get(args, argument_offset + 1), "")
    let mut target_os: String = "linux"
    let mut target_arch: String = "amd64"
    let mut target_gui: Bool = false
    if len(args) > required_arguments {
        let requested_target: String = unwrap_or(array_get(args, argument_offset + 2), "")
        if requested_target == "windows-amd64" {
            target_os = "windows"
        } else if requested_target == "windows-amd64-gui" {
            target_os = "windows"
            target_gui = true
        } else if requested_target != "linux-amd64" {
            return fail_compilation("unsupported target '" + requested_target + "' (supported: linux-amd64, windows-amd64, windows-amd64-gui)")
        }
    }
    if emit_kir {
        let document_text: Result[String, String] = emit_source_kir(source_path, target_os, target_arch, target_gui)
        if is_err(document_text) {
            return fail_compilation("source compiler KIR emission failed: " + unwrap_or(result_error(document_text), "unknown error"))
        }
        let written_kir: Result[Nil, String] = fs_write_bytes(output_path, string_to_bytes(result_unwrap(document_text)))
        if is_err(written_kir) {
            return fail_compilation("source compiler KIR write failed: " + unwrap_or(result_error(written_kir), "unknown error"))
        }
        return nil
    }
    let compiled: Result[Bytes, String] = compile_path(source_path, target_os, target_arch, target_gui)
    if is_err(compiled) {
        return fail_compilation("source compiler compile failed: " + unwrap_or(result_error(compiled), "unknown error"))
    }
    let written: Result[Nil, String] = fs_write_bytes(output_path, result_unwrap(compiled))
    if is_err(written) {
        return fail_compilation("source compiler write failed: " + unwrap_or(result_error(written), "unknown error"))
    }
    return nil
}
