let present: Option[Array[Int]] = some([7, 8])
println(is_some(present))
let values: Array[Int] = unwrap_or(present, [1])
println(values[1])
let failure: Result[Int, Array[Int]] = err([4, 5])
println(is_err(failure))
let problem: Option[Array[Int]] = result_error(failure)
println(is_some(problem))
println(unwrap_or(problem, [9])[1])
