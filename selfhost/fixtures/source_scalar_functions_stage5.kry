fn double(value: Int) -> Int {
    return value + value
}

fn positive(value: Int) -> Bool {
    return value > 0
}

fn increment(value: UInt64) -> UInt64 {
    return value + u64(1)
}

fn mask(value: UInt8) -> UInt8 {
    let mut masked: UInt8 = value & u8(15)
    masked = ((((masked << 1) >> 1) | u8(1)) ^ u8(2))
    return masked
}

fn main() -> Nil {
    println(double(21))
    if positive(1) {
        println("positive")
    } else {
        println("wrong")
    }
    println(increment(u64(0)))
    println(mask(u8(16)))
}
