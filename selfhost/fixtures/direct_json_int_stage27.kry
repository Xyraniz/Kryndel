fn decode(value: String) -> Int {
    let parsed: Json = result_unwrap(json_parse(value))
    return result_unwrap(json_int(parsed))
}

fn is_int(value: String) -> Bool {
    let parsed: Result[Json, String] = json_parse(value)
    if is_err(parsed) { return false }
    return is_ok(json_int(result_unwrap(parsed)))
}

fn main() -> Nil {
    println(decode("0"))
    println(decode("-0"))
    println(decode("42"))
    println(decode("-42"))
    println(decode("9223372036854775807"))
    println(decode("-9223372036854775808"))
    println(decode(" \t-7\n"))
    println(is_int("9223372036854775808"))
    println(is_int("-9223372036854775809"))
    println(is_int("1.0"))
    println(is_int("1e3"))
    println(is_int("01"))
    println(is_int("true"))
    return nil
}
