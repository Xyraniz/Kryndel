// Stage 1 self-hosted backend. It accepts only the validated flat KIR arena
// and rejects unsupported nodes before constructing the output image.
import "validated_kir"
import "kir_typed_arena"

fn u16_bytes(value: UInt16) -> Array[UInt8] {
    return [u8(value & u16(255)), u8(value >> 8)]
}

fn u32_bytes(value: UInt32) -> Array[UInt8] {
    return [u8(value & u32(255)), u8((value >> 8) & u32(255)), u8((value >> 16) & u32(255)), u8(value >> 24)]
}

fn u64_bytes(value: UInt64) -> Array[UInt8] {
    return [u8(value & u64(255)), u8((value >> 8) & u64(255)), u8((value >> 16) & u64(255)), u8((value >> 24) & u64(255)), u8((value >> 32) & u64(255)), u8((value >> 40) & u64(255)), u8((value >> 48) & u64(255)), u8(value >> 56)]
}

fn append_u8(left: Array[UInt8], value: UInt8) -> Array[UInt8] { return array_push(left, value) }
fn append_bytes(left: Array[UInt8], right: Array[UInt8]) -> Array[UInt8] { return array_concat(left, right) }

fn json_field(value: KIRTypedNodeView, key: String) -> KIRTypedNodeView {
    return result_unwrap(kir_typed_object_get(value, key))
}

fn json_text(value: KIRTypedNodeView) -> String { return result_unwrap(kir_typed_string(value)) }

pub fn eval_int(expression: KIRTypedNodeView, bindings: Map[String, String]) -> Result[Int, String] {
    let kind: String = json_text(json_field(expression, "kind"))
    let checked_type: String = json_text(json_field(expression, "type"))
    if checked_type != "Int" { return err("stage1 ELF backend expects a checked Int expression") }
    if kind == "int" { return kir_typed_int(json_field(expression, "int")) }
    if kind == "var" {
        let name: String = json_text(json_field(expression, "name"))
        if is_none(map_get(bindings, name)) { return err("unknown static binding: " + name) }
        return ok(int(unwrap_or(map_get(bindings, name), "")))
    }
    if kind == "binary" {
        let operator: String = json_text(json_field(expression, "operator"))
        let left_result: Result[Int, String] = eval_int(json_field(expression, "left"), bindings)
        if is_err(left_result) { return err(unwrap_or(result_error(left_result), "expression is not a static Int")) }
        let right_result: Result[Int, String] = eval_int(json_field(expression, "right"), bindings)
        if is_err(right_result) { return err(unwrap_or(result_error(right_result), "expression is not a static Int")) }
        let left: Int = result_unwrap(left_result)
        let right: Int = result_unwrap(right_result)
        if operator == "+" { return ok(left + right) }
        if operator == "-" { return ok(left - right) }
        if operator == "*" { return ok(left * right) }
        if operator == "/" {
            if right == 0 { return err("static integer division by zero") }
            return ok(left / right)
        }
        if operator == "%" {
            if right == 0 { return err("static integer remainder by zero") }
            return ok(left % right)
        }
        return err("unsupported static integer operator: " + operator)
    }
    return err("expression is not a static Int")
}

pub fn eval_display(expression: KIRTypedNodeView, bindings: Map[String, String]) -> Result[String, String] {
    let kind: String = json_text(json_field(expression, "kind"))
    let checked_type: String = json_text(json_field(expression, "type"))
    if kind == "string" {
        if checked_type != "String" { return err("stage1 ELF backend found a String literal with an inconsistent checked type") }
        return ok(json_text(json_field(expression, "string")))
    }
    if kind == "int" { return ok(str(result_unwrap(eval_int(expression, bindings)))) }
    if kind == "float" {
        if checked_type != "Float" { return err("stage1 ELF backend found a Float literal with an inconsistent checked type") }
        return ok(kir_typed_number_text(json_field(expression, "float")))
    }
    if kind == "bool" {
        if checked_type != "Bool" { return err("stage1 ELF backend found a Bool literal with an inconsistent checked type") }
        if result_unwrap(kir_typed_bool(json_field(expression, "bool"))) { return ok("true") }
        return ok("false")
    }
    if kind == "var" {
        let name: String = json_text(json_field(expression, "name"))
        if is_none(map_get(bindings, name)) { return err("unknown static binding: " + name) }
        return ok(unwrap_or(map_get(bindings, name), ""))
    }
    if kind == "binary" {
        if checked_type == "Int" { return ok(str(result_unwrap(eval_int(expression, bindings)))) }
        if checked_type == "String" && json_text(json_field(expression, "operator")) == "+" {
            let left: Result[String, String] = eval_display(json_field(expression, "left"), bindings)
            if is_err(left) { return err(unwrap_or(result_error(left), "expression is not statically displayable")) }
            let right: Result[String, String] = eval_display(json_field(expression, "right"), bindings)
            if is_err(right) { return err(unwrap_or(result_error(right), "expression is not statically displayable")) }
            return ok(result_unwrap(left) + result_unwrap(right))
        }
        return err("unsupported static binary expression or checked type")
    }
    if kind == "call" {
        let target: String = json_text(json_field(expression, "call_target"))
        if target != "builtin:str" { return err("unsupported static call: " + target) }
        let arguments: KIRTypedNodeView = json_field(expression, "args")
        if result_unwrap(kir_typed_array_len(arguments)) != 1 { return err("stage1 ELF backend requires exactly one str argument") }
        return eval_display(result_unwrap(kir_typed_array_get(arguments, 0)), bindings)
    }
    return err("expression is not statically displayable: " + kind)
}

pub fn emit_elf(payload: Array[UInt8]) -> Bytes {
    // ELF header (64 bytes), program header (56 bytes), code (33 bytes), data.
    let file_size: Int = 153 + len(payload)
    let mut file: Array[UInt8] = []

    file = append_bytes(file, [u8(127), u8(69), u8(76), u8(70), u8(2), u8(1), u8(1), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0)])
    file = append_bytes(file, u16_bytes(u16(2)))
    file = append_bytes(file, u16_bytes(u16(62)))
    file = append_bytes(file, u32_bytes(u32(1)))
    file = append_bytes(file, u64_bytes(u64(4194424)))
    file = append_bytes(file, u64_bytes(u64(64)))
    file = append_bytes(file, u64_bytes(u64(0)))
    file = append_bytes(file, u32_bytes(u32(0)))
    file = append_bytes(file, u16_bytes(u16(64)))
    file = append_bytes(file, u16_bytes(u16(56)))
    file = append_bytes(file, u16_bytes(u16(1)))
    file = append_bytes(file, u16_bytes(u16(0)))
    file = append_bytes(file, u16_bytes(u16(0)))
    file = append_bytes(file, u16_bytes(u16(0)))

    // One readable/executable PT_LOAD segment containing headers, code, data.
    file = append_bytes(file, u32_bytes(u32(1)))
    file = append_bytes(file, u32_bytes(u32(5)))
    file = append_bytes(file, u64_bytes(u64(0)))
    file = append_bytes(file, u64_bytes(u64(4194304)))
    file = append_bytes(file, u64_bytes(u64(4194304)))
    file = append_bytes(file, u64_bytes(u64(file_size)))
    file = append_bytes(file, u64_bytes(u64(file_size)))
    file = append_bytes(file, u64_bytes(u64(4096)))

    // _start: write(1, payload, len), then exit(0). The data address is
    // sixteen bytes after the RIP following the lea instruction.
    file = append_bytes(file, [u8(184), u8(1), u8(0), u8(0), u8(0)])
    file = append_bytes(file, [u8(191), u8(1), u8(0), u8(0), u8(0)])
    file = append_bytes(file, [u8(72), u8(141), u8(53), u8(16), u8(0), u8(0), u8(0)])
    file = append_bytes(file, [u8(186)])
    file = append_bytes(file, u32_bytes(u32(len(payload))))
    file = append_bytes(file, [u8(15), u8(5), u8(184), u8(60), u8(0), u8(0), u8(0), u8(49), u8(255), u8(15), u8(5)])
    file = append_bytes(file, payload)
    return bytes_from_u8(file)
}

pub fn compile_kir(kir: ValidatedKIR) -> Result[Bytes, String] {
    let document: KIRTypedNodeView = validated_kir_typed_root(kir)
    let target: KIRTypedNodeView = json_field(document, "target")
    if json_text(json_field(target, "os")) != "linux" || json_text(json_field(target, "arch")) != "amd64" || result_unwrap(kir_typed_bool(json_field(target, "gui"))) {
        return err("stage1 ELF backend requires a non-GUI linux-amd64 target")
    }
    if result_unwrap(kir_typed_array_len(json_field(document, "functions"))) != 0 { return err("stage1 ELF backend does not support function declarations") }

    // Preflight and evaluate every source statement before constructing output bytes.
    let statements: KIRTypedNodeView = json_field(document, "statements")
    let statement_count: Int = result_unwrap(kir_typed_array_len(statements))
    let mut bindings: Map[String, String] = {}
    let mut output_values: Array[String] = []
    let mut index: Int = 0
    while index < statement_count {
        let statement: KIRTypedNodeView = result_unwrap(kir_typed_array_get(statements, index))
        let kind: String = json_text(json_field(statement, "kind"))
        if kind == "let" || kind == "const" {
            if result_unwrap(kir_typed_bool(json_field(statement, "mutable"))) { return err("stage1 ELF backend does not support mutable bindings") }
            let name: String = json_text(json_field(statement, "name"))
            let evaluated: Result[String, String] = eval_display(json_field(statement, "init"), bindings)
            if is_err(evaluated) { return err(unwrap_or(result_error(evaluated), "cannot evaluate static binding")) }
            bindings = map_insert(bindings, name, result_unwrap(evaluated))
        } else if kind == "expr" {
            let expression: KIRTypedNodeView = json_field(statement, "expr")
            if json_text(json_field(expression, "kind")) != "call" { return err("stage1 ELF backend accepts only print and println expression statements") }
            let target_name: String = json_text(json_field(expression, "call_target"))
            if target_name != "builtin:print" && target_name != "builtin:println" { return err("stage1 ELF backend accepts only print and println") }
            let arguments: KIRTypedNodeView = json_field(expression, "args")
            if result_unwrap(kir_typed_array_len(arguments)) != 1 { return err("stage1 ELF backend requires exactly one print argument") }
            let argument: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
            let evaluated: Result[String, String] = eval_display(argument, bindings)
            if is_err(evaluated) { return err(unwrap_or(result_error(evaluated), "print argument is not statically displayable")) }
            let mut text: String = result_unwrap(evaluated)
            if target_name == "builtin:println" { text = text + "\n" }
            output_values = array_push(output_values, text)
        } else {
            return err("stage1 ELF backend does not support statement kind " + kind)
        }
        index = index + 1
    }

    let mut payload: Array[UInt8] = []
    let mut output_index: Int = 0
    while output_index < len(output_values) {
        payload = append_bytes(payload, u8_array(string_to_bytes(unwrap_or(array_get(output_values, output_index), ""))))
        output_index = output_index + 1
    }
    return ok(emit_elf(payload))
}
