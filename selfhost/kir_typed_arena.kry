fn typed_view_root_field(arena: KIRTypedArena, key: String) -> Result[KIRTypedNodeView, String] {
    let declarations: KIRTypedDeclarations = arena.declarations
    if key == "format" { return typed_view_string_field(arena, arena.format) }
    if key == "version" { return typed_view_int_field(arena, arena.version) }
    if key == "language_version" { return typed_view_string_field(arena, arena.language_version) }
    if key == "module" { return typed_view_string_field(arena, arena.module) }
    if key == "source" { return typed_view_string_field(arena, arena.source) }
    if key == "target" { return typed_view_reference_field(arena, KIRIndexRef{ table: KIRTypedTable::KIRTableTarget, index: 0, present: true }) }
    if key == "imports" { return ok(typed_view_strings(arena, declarations.imports)) }
    if key == "import_records" { return ok(typed_view_direct_rows(arena, KIRTypedTable::KIRTableImportRecords, len(declarations.import_records))) }
    if key == "sources" { return ok(typed_view_strings(arena, declarations.sources)) }
    if key == "structs" { return ok(typed_view_direct_rows(arena, KIRTypedTable::KIRTableStructs, len(declarations.structs))) }
    if key == "enums" { return ok(typed_view_direct_rows(arena, KIRTypedTable::KIRTableEnums, len(declarations.enums))) }
    if key == "traits" { return ok(typed_view_direct_rows(arena, KIRTypedTable::KIRTableTraits, len(declarations.traits))) }
    if key == "trait_impls" { return ok(typed_view_direct_rows(arena, KIRTypedTable::KIRTableTraitImpls, len(declarations.trait_impls))) }
    if key == "functions" { return typed_view_edge_field(arena, arena.top_functions, KIRTypedTable::KIRTableFunctions) }
    if key == "statements" { return typed_view_edge_field(arena, arena.top_statements, KIRTypedTable::KIRTableStatements) }
    return err("typed KIR document has no field " + key)
}

fn typed_view_target_field(arena: KIRTypedArena, key: String) -> Result[KIRTypedNodeView, String] {
