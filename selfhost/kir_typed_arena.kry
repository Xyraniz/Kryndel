    let int_value: Result[Int, String] = typed_json_int_field(node, "int", 0)
    let string_value: Result[String, String] = typed_json_string_field(node, "string", "")
    let type_name: Result[String, String] = typed_json_string_field(node, "type", "")
    let variant: Result[String, String] = typed_json_string_field(node, "variant", "")
    let binding_name: Result[String, String] = typed_json_string_field(node, "binding", "")
    let present: Result[Bool, String] = typed_json_bool_field(node, "present", false)
    let ok_value: Result[Bool, String] = typed_json_bool_field(node, "ok", false)
    if is_err(kind) || is_err(source) || is_err(line) || is_err(column) || is_err(bool_value) || is_err(int_value) || is_err(string_value) || is_err(type_name) || is_err(variant) || is_err(binding_name) || is_err(present) || is_err(ok_value) { return err("validated KIR pattern has an invalid scalar field") }
    let span: Result[KIRTypedBuildRef, String] = typed_json_span(arena, node)
    if is_err(span) { return err(unwrap_or(result_error(span), "invalid pattern span")) }
    let after_span: KIRTypedBuildRef = result_unwrap(span)
    let resolved: Result[KIRTypedBuildRef, String] = typed_json_binding_ref(after_span.arena, node, "resolved_binding")
    if is_err(resolved) { return err(unwrap_or(result_error(resolved), "invalid pattern binding")) }
    let after_resolved: KIRTypedBuildRef = result_unwrap(resolved)
    let executable: KIRTypedExecutable = after_resolved.arena.executable
    let index: Int = len(executable.patterns)
    let row: KIRTypedPattern = KIRTypedPattern{ kind: result_unwrap(kind), source: result_unwrap(source), line: result_unwrap(line), column: result_unwrap(column), span: after_span.reference, bool_value: result_unwrap(bool_value), int_value: result_unwrap(int_value), string_value: result_unwrap(string_value), type_name: result_unwrap(type_name), variant: result_unwrap(variant), binding_name: result_unwrap(binding_name), present: result_unwrap(present), ok: result_unwrap(ok_value), resolved_binding: after_resolved.reference }
    let updated: KIRTypedExecutable = KIRTypedExecutable{ functions: executable.functions, parameters: executable.parameters, captures: executable.captures, bindings: executable.bindings, expressions: executable.expressions, statements: executable.statements, arms: executable.arms, patterns: array_push(executable.patterns, row) }
    return ok(KIRTypedBuildRef{ arena: typed_with_executable(after_resolved.arena, updated), reference: KIRIndexRef{ table: KIRTypedTable::KIRTablePatterns, index: index, present: true } })
}

