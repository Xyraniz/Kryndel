    let empty_generic_arguments: Array[String] = []
    let mut generic_arguments: Result[Array[String], String] = ok(empty_generic_arguments)
    if !is_err(generic_arguments_json) { generic_arguments = typed_json_string_array(result_unwrap(generic_arguments_json)) }
    if is_err(generic_arguments) { return err(unwrap_or(result_error(generic_arguments), "invalid generic arguments")) }
    let fields_json: Result[Json, String] = typed_json_optional_field(node, "fields")
    let empty_fields: Array[String] = []
    let mut fields: Result[Array[String], String] = ok(empty_fields)
    if !is_err(fields_json) { fields = typed_json_string_array(result_unwrap(fields_json)) }
    if is_err(fields) { return err(unwrap_or(result_error(fields), "invalid expression fields")) }
    let values: Result[KIRTypedBuildRange, String] = typed_json_expression_range(after_map_keys.arena, node, "values")
    if is_err(values) { return err(unwrap_or(result_error(values), "invalid expression values")) }
    let after_values: KIRTypedBuildRange = result_unwrap(values)
