    let updated: KIRTypedExecutable = KIRTypedExecutable{ functions: executable.functions, parameters: executable.parameters, captures: executable.captures, bindings: executable.bindings, expressions: array_push(executable.expressions, row), statements: executable.statements, arms: executable.arms, patterns: executable.patterns }
    return ok(KIRTypedBuildRef{ arena: typed_with_executable(after_binding.arena, updated), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: index, present: true } })
}

fn typed_json_array_field(value: Json, key: String) -> Result[Json, String] {
    let field: Result[Json, String] = json_object_get(value, key)
    // The validator requires arrays only for the node kinds that consume them.
    // Missing optional child lists therefore have the canonical empty range.
    if is_err(field) { return json_parse("[]") }
    if json_kind(result_unwrap(field)) != "array" { return err("validated KIR field " + key + " is not an array") }
    return field
}

fn typed_json_type_param_range(arena: KIRTypedArena, node: Json, key: String) -> Result[KIRTypedBuildRange, String] {
    let list: Result[Json, String] = typed_json_array_field(node, key)
    if is_err(list) { return err(unwrap_or(result_error(list), "invalid type parameter list")) }
    let count: Result[Int, String] = json_array_len(result_unwrap(list))
    if is_err(count) { return err("validated KIR type parameter list cannot be read") }
    let mut current: KIRTypedArena = arena
    let mut edges: Array[KIRIndexRef] = []
    let mut index: Int = 0
    while index < result_unwrap(count) {
        let item: Result[Json, String] = json_array_get(result_unwrap(list), index)
        if is_err(item) { return err("validated KIR type parameter list has a missing item") }
        let row_json: Json = result_unwrap(item)
        let name: Result[String, String] = typed_json_string_field(row_json, "name", "")
        let constraint: Result[String, String] = typed_json_string_field(row_json, "constraint", "")
        let source: Result[String, String] = typed_json_string_field(row_json, "source", "")
        let line: Result[Int, String] = typed_json_int_field(row_json, "line", 0)
        let column: Result[Int, String] = typed_json_int_field(row_json, "column", 0)
        if is_err(name) || is_err(constraint) || is_err(source) || is_err(line) || is_err(column) { return err("validated KIR type parameter has an invalid scalar field") }
        let span: Result[KIRTypedBuildRef, String] = typed_json_span(current, row_json)
        if is_err(span) { return err(unwrap_or(result_error(span), "invalid type parameter span")) }
        let span_value: KIRTypedBuildRef = result_unwrap(span)
        let declarations: KIRTypedDeclarations = span_value.arena.declarations
        let row_index: Int = len(declarations.type_params)
        let row: KIRTypedTypeParam = KIRTypedTypeParam{ name: result_unwrap(name), constraint: result_unwrap(constraint), source: result_unwrap(source), line: result_unwrap(line), column: result_unwrap(column), span: span_value.reference }
        let updated: KIRTypedDeclarations = KIRTypedDeclarations{ imports: declarations.imports, import_records: declarations.import_records, sources: declarations.sources, structs: declarations.structs, fields: declarations.fields, enums: declarations.enums, traits: declarations.traits, trait_methods: declarations.trait_methods, trait_impls: declarations.trait_impls, trait_impl_methods: declarations.trait_impl_methods, type_params: array_push(declarations.type_params, row) }
        current = typed_with_declarations(span_value.arena, updated)
        edges = array_push(edges, KIRIndexRef{ table: KIRTypedTable::KIRTableTypeParams, index: row_index, present: true })
        index = index + 1
    }
    return ok(typed_append_edge_range(current, edges))
}

fn typed_json_parameter(arena: KIRTypedArena, node: Json) -> Result[KIRTypedBuildRef, String] {
    let name: Result[String, String] = typed_json_string_field(node, "name", "")
    let type_name: Result[String, String] = typed_json_string_field(node, "type", "")
    let source: Result[String, String] = typed_json_string_field(node, "source", "")
    let line: Result[Int, String] = typed_json_int_field(node, "line", 0)
    let column: Result[Int, String] = typed_json_int_field(node, "column", 0)
    if is_err(name) || is_err(type_name) || is_err(source) || is_err(line) || is_err(column) { return err("validated KIR parameter has an invalid scalar field") }
    let span: Result[KIRTypedBuildRef, String] = typed_json_span(arena, node)
    if is_err(span) { return err(unwrap_or(result_error(span), "invalid parameter span")) }
    let after_span: KIRTypedBuildRef = result_unwrap(span)
    let default_value: Result[KIRTypedBuildRef, String] = typed_json_expression_ref(after_span.arena, node, "default")
    if is_err(default_value) { return err(unwrap_or(result_error(default_value), "invalid parameter default")) }
    let after_default: KIRTypedBuildRef = result_unwrap(default_value)
    let binding_json: Result[Json, String] = typed_json_optional_field(node, "binding")
    let mut binding: Result[KIRTypedBuildRef, String] = ok(KIRTypedBuildRef{ arena: after_default.arena, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableBindings, index: 0, present: false } })
    if !is_err(binding_json) { binding = typed_json_binding(after_default.arena, result_unwrap(binding_json)) }
    if is_err(binding) { return err(unwrap_or(result_error(binding), "invalid parameter binding")) }
    let after_binding: KIRTypedBuildRef = result_unwrap(binding)
    let executable: KIRTypedExecutable = after_binding.arena.executable
    let index: Int = len(executable.parameters)
    let row: KIRTypedParameter = KIRTypedParameter{ name: result_unwrap(name), type_name: result_unwrap(type_name), source: result_unwrap(source), line: result_unwrap(line), column: result_unwrap(column), span: after_span.reference, default_value: after_default.reference, binding: after_binding.reference }
    let updated: KIRTypedExecutable = KIRTypedExecutable{ functions: executable.functions, parameters: array_push(executable.parameters, row), captures: executable.captures, bindings: executable.bindings, expressions: executable.expressions, statements: executable.statements, arms: executable.arms, patterns: executable.patterns }
    return ok(KIRTypedBuildRef{ arena: typed_with_executable(after_binding.arena, updated), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableParameters, index: index, present: true } })
}

fn typed_json_parameter_range(arena: KIRTypedArena, node: Json, key: String) -> Result[KIRTypedBuildRange, String] {
    let list: Result[Json, String] = typed_json_array_field(node, key)
    if is_err(list) { return err(unwrap_or(result_error(list), "invalid parameter list")) }
    let count: Result[Int, String] = json_array_len(result_unwrap(list))
    if is_err(count) { return err("validated KIR parameter list cannot be read") }
    let mut current: KIRTypedArena = arena
    let mut edges: Array[KIRIndexRef] = []
    let mut index: Int = 0
    while index < result_unwrap(count) {
        let item: Result[Json, String] = json_array_get(result_unwrap(list), index)
        if is_err(item) { return err("validated KIR parameter list has a missing item") }
        let built: Result[KIRTypedBuildRef, String] = typed_json_parameter(current, result_unwrap(item))
        if is_err(built) { return err(unwrap_or(result_error(built), "invalid KIR parameter")) }
        let row: KIRTypedBuildRef = result_unwrap(built)
        current = row.arena
        edges = array_push(edges, row.reference)
        index = index + 1
    }
    return ok(typed_append_edge_range(current, edges))
}

fn typed_json_capture_range(arena: KIRTypedArena, node: Json, key: String) -> Result[KIRTypedBuildRange, String] {
    let list: Result[Json, String] = typed_json_array_field(node, key)
    if is_err(list) { return err(unwrap_or(result_error(list), "invalid capture list")) }
    let count: Result[Int, String] = json_array_len(result_unwrap(list))
    if is_err(count) { return err("validated KIR capture list cannot be read") }
    let mut current: KIRTypedArena = arena
    let mut edges: Array[KIRIndexRef] = []
    let mut index: Int = 0
    while index < result_unwrap(count) {
        let item: Result[Json, String] = json_array_get(result_unwrap(list), index)
        if is_err(item) { return err("validated KIR capture list has a missing item") }
        let binding: Result[KIRTypedBuildRef, String] = typed_json_binding_ref(current, result_unwrap(item), "binding")
        if is_err(binding) { return err(unwrap_or(result_error(binding), "invalid capture binding")) }
        let built_binding: KIRTypedBuildRef = result_unwrap(binding)
        let executable: KIRTypedExecutable = built_binding.arena.executable
        let row_index: Int = len(executable.captures)
        let row: KIRTypedCapture = KIRTypedCapture{ binding: built_binding.reference }
        let updated: KIRTypedExecutable = KIRTypedExecutable{ functions: executable.functions, parameters: executable.parameters, captures: array_push(executable.captures, row), bindings: executable.bindings, expressions: executable.expressions, statements: executable.statements, arms: executable.arms, patterns: executable.patterns }
        current = typed_with_executable(built_binding.arena, updated)
        edges = array_push(edges, KIRIndexRef{ table: KIRTypedTable::KIRTableCaptures, index: row_index, present: true })
        index = index + 1
    }
    return ok(typed_append_edge_range(current, edges))
}

fn typed_json_binding_ref(arena: KIRTypedArena, node: Json, key: String) -> Result[KIRTypedBuildRef, String] {
    let field: Result[Json, String] = typed_json_optional_field(node, key)
    if is_err(field) || json_kind(result_unwrap(field)) == "null" {
        return ok(KIRTypedBuildRef{ arena: arena, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableBindings, index: 0, present: false } })
    }
    return typed_json_binding(arena, result_unwrap(field))
}

fn typed_json_function(arena: KIRTypedArena, node: Json) -> Result[KIRTypedBuildRef, String] {
    if json_kind(node) != "object" { return err("validated KIR function is not an object") }
    let name: Result[String, String] = typed_json_string_field(node, "name", "")
    let source: Result[String, String] = typed_json_string_field(node, "source", "")
