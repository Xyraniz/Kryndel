pub struct KIRTypedDeclarations {
    private imports: Array[String],
    private import_records: Array[KIRTypedImport],
    private sources: Array[String],
    private structs: Array[KIRTypedStruct],
    private fields: Array[KIRTypedField],
    private enums: Array[KIRTypedEnum],
    private traits: Array[KIRTypedTrait],
    private trait_methods: Array[KIRTypedTraitMethod],
    private trait_impls: Array[KIRTypedTraitImpl],
    private trait_impl_methods: Array[KIRTypedTraitImplMethod],
    private type_params: Array[KIRTypedTypeParam],
}

pub struct KIRTypedExecutable {
    private functions: Array[KIRTypedFunction],
    private parameters: Array[KIRTypedParameter],
    private captures: Array[KIRTypedCapture],
    private bindings: Array[KIRTypedBinding],
    private expressions: Array[KIRTypedExpression],
    private statements: Array[KIRTypedStatement],
    private arms: Array[KIRTypedArm],
    private patterns: Array[KIRTypedPattern],
}

pub struct KIRTypedReferences {
    private spans: Array[KIRTypedSourceSpan],
    private edges: Array[KIRIndexRef],
}

// Source parsing appends rows incrementally. Native Array is immutable, so a
// direct append to a flat table would copy the entire table for every row.
// Keep bounded chunks while building and flatten once before validation.
pub struct KIRTypedSourceSpanRows {
    private chunks: Array[Array[KIRTypedSourceSpan]],
    private current: Array[KIRTypedSourceSpan],
}

pub struct KIRTypedIndexRefRows {
    private chunks: Array[Array[KIRIndexRef]],
    private current: Array[KIRIndexRef],
}

pub struct KIRTypedBindingRows {
    private chunks: Array[Array[KIRTypedBinding]],
    private current: Array[KIRTypedBinding],
}

pub struct KIRTypedValueRows {
    private chunks: Array[Array[KIRTypedValue]],
    private current: Array[KIRTypedValue],
}

pub struct KIRTypedExpressionRows {
    private chunks: Array[Array[KIRTypedExpression]],
    private current: Array[KIRTypedExpression],
}

pub struct KIRTypedStatementRows {
    private chunks: Array[Array[KIRTypedStatement]],
    private current: Array[KIRTypedStatement],
}

pub struct KIRTypedSourceBuildReferences {
    private spans: KIRTypedSourceSpanRows,
    private edges: KIRTypedIndexRefRows,
}

pub struct KIRTypedSourceBuildExecutable {
    private bindings: KIRTypedBindingRows,
    private expressions: KIRTypedExpressionRows,
    private statements: KIRTypedStatementRows,
}

pub struct KIRTypedSourceBuilder {
    private references: KIRTypedSourceBuildReferences,
    private executable: KIRTypedSourceBuildExecutable,
    private values: KIRTypedValueRows,
}

pub struct KIRTypedArena {
    private format: String,
    private version: Int,
    private language_version: String,
    private module: String,
    private source: String,
    private target: KIRTypedTarget,
    private declarations: KIRTypedDeclarations,
    private executable: KIRTypedExecutable,
    private values: Array[KIRTypedValue],
    private references: KIRTypedReferences,
    private source_builder: Option[KIRTypedSourceBuilder],
    private top_functions: KIRIndexRange,
    private top_statements: KIRIndexRange,
}

pub fn kir_typed_empty_arena() -> KIRTypedArena {
    let empty_functions: KIRIndexRange = KIRIndexRange{ table: KIRTypedTable::KIRTableEdges, start: 0, count: 0 }
    let empty_statements: KIRIndexRange = KIRIndexRange{ table: KIRTypedTable::KIRTableEdges, start: 0, count: 0 }
    return KIRTypedArena{
        format: "", version: 0, language_version: "", module: "", source: "",
        target: KIRTypedTarget{ os: "", arch: "", gui: false },
        declarations: KIRTypedDeclarations{
            imports: [], import_records: [], sources: [], structs: [], fields: [], enums: [],
            traits: [], trait_methods: [], trait_impls: [], trait_impl_methods: [], type_params: [],
        },
        executable: KIRTypedExecutable{
            functions: [], parameters: [], captures: [], bindings: [], expressions: [], statements: [],
            arms: [], patterns: [],
        },
        values: [], references: KIRTypedReferences{ spans: [], edges: [] },
        source_builder: none(),
        top_functions: empty_functions, top_statements: empty_statements,
    }
}

fn kir_typed_empty_source_builder() -> KIRTypedSourceBuilder {
    return KIRTypedSourceBuilder{
        references: KIRTypedSourceBuildReferences{
            spans: KIRTypedSourceSpanRows{ chunks: [], current: [] },
            edges: KIRTypedIndexRefRows{ chunks: [], current: [] },
        },
        executable: KIRTypedSourceBuildExecutable{
            bindings: KIRTypedBindingRows{ chunks: [], current: [] },
            expressions: KIRTypedExpressionRows{ chunks: [], current: [] },
            statements: KIRTypedStatementRows{ chunks: [], current: [] },
        },
        values: KIRTypedValueRows{ chunks: [], current: [] },
    }
}

fn typed_with_source_builder(arena: KIRTypedArena, builder: Option[KIRTypedSourceBuilder]) -> KIRTypedArena {
    return KIRTypedArena{ format: arena.format, version: arena.version, language_version: arena.language_version, module: arena.module, source: arena.source, target: arena.target, declarations: arena.declarations, executable: arena.executable, values: arena.values, references: arena.references, source_builder: builder, top_functions: arena.top_functions, top_statements: arena.top_statements }
}

pub fn kir_typed_empty_source_arena() -> KIRTypedArena {
    return typed_with_source_builder(kir_typed_empty_arena(), some(kir_typed_empty_source_builder()))
}

pub fn kir_typed_arena_table_counts(arena: KIRTypedArena) -> Array[Int] {
    let declarations: KIRTypedDeclarations = arena.declarations
    let executable: KIRTypedExecutable = arena.executable
    let references: KIRTypedReferences = arena.references
    return [len(declarations.imports), len(declarations.import_records), len(declarations.sources), len(declarations.structs), len(declarations.fields), len(declarations.enums),
        len(declarations.traits), len(declarations.trait_methods), len(declarations.trait_impls), len(declarations.trait_impl_methods),
        len(declarations.type_params), len(executable.functions), len(executable.parameters), len(executable.captures),
        len(executable.bindings), len(executable.expressions), len(executable.statements), len(executable.arms),
        len(executable.patterns), len(arena.values), len(references.spans), len(references.edges)]
}

fn kir_typed_table_len(arena: KIRTypedArena, table: KIRTypedTable) -> Result[Int, String] {
    let declarations: KIRTypedDeclarations = arena.declarations
    let executable: KIRTypedExecutable = arena.executable
    let references: KIRTypedReferences = arena.references
    if table == KIRTypedTable::KIRTableImports { return ok(len(declarations.imports)) }
    if table == KIRTypedTable::KIRTableImportRecords { return ok(len(declarations.import_records)) }
    if table == KIRTypedTable::KIRTableSources { return ok(len(declarations.sources)) }
    if table == KIRTypedTable::KIRTableStructs { return ok(len(declarations.structs)) }
    if table == KIRTypedTable::KIRTableFields { return ok(len(declarations.fields)) }
    if table == KIRTypedTable::KIRTableEnums { return ok(len(declarations.enums)) }
    if table == KIRTypedTable::KIRTableTraits { return ok(len(declarations.traits)) }
    if table == KIRTypedTable::KIRTableTraitMethods { return ok(len(declarations.trait_methods)) }
    if table == KIRTypedTable::KIRTableTraitImpls { return ok(len(declarations.trait_impls)) }
    if table == KIRTypedTable::KIRTableTraitImplMethods { return ok(len(declarations.trait_impl_methods)) }
    if table == KIRTypedTable::KIRTableTypeParams { return ok(len(declarations.type_params)) }
    if table == KIRTypedTable::KIRTableFunctions { return ok(len(executable.functions)) }
    if table == KIRTypedTable::KIRTableParameters { return ok(len(executable.parameters)) }
    if table == KIRTypedTable::KIRTableCaptures { return ok(len(executable.captures)) }
    if table == KIRTypedTable::KIRTableBindings { return ok(len(executable.bindings)) }
    if table == KIRTypedTable::KIRTableExpressions { return ok(len(executable.expressions)) }
    if table == KIRTypedTable::KIRTableStatements { return ok(len(executable.statements)) }
    if table == KIRTypedTable::KIRTableArms { return ok(len(executable.arms)) }
    if table == KIRTypedTable::KIRTablePatterns { return ok(len(executable.patterns)) }
    if table == KIRTypedTable::KIRTableValues { return ok(len(arena.values)) }
    if table == KIRTypedTable::KIRTableSpans { return ok(len(references.spans)) }
    if table == KIRTypedTable::KIRTableEdges { return ok(len(references.edges)) }
    if table == KIRTypedTable::KIRTableDocument || table == KIRTypedTable::KIRTableTarget { return ok(1) }
    return err("unknown typed KIR table")
}

pub fn kir_typed_reference_valid(arena: KIRTypedArena, reference: KIRIndexRef) -> Bool {
    if !reference.present { return reference.index == 0 }
    let count: Result[Int, String] = kir_typed_table_len(arena, reference.table)
    if is_err(count) { return false }
    return reference.index >= 0 && reference.index < result_unwrap(count)
}

pub fn kir_typed_span_count(arena: KIRTypedArena) -> Int {
    return len(arena.references.spans)
}

pub fn kir_typed_span_at(arena: KIRTypedArena, reference: KIRIndexRef) -> Result[KIRTypedSourceSpan, String] {
    if !reference.present || reference.table != KIRTypedTable::KIRTableSpans || !kir_typed_reference_valid(arena, reference) {
        return err("typed KIR source span reference is out of bounds")
    }
    let spans: Array[KIRTypedSourceSpan] = arena.references.spans
    let value: Option[KIRTypedSourceSpan] = array_get(spans, reference.index)
    if is_none(value) { return err("typed KIR source span reference is out of bounds") }
    return ok(spans[reference.index])
}

pub fn kir_typed_span_row_at(arena: KIRTypedArena, index: Int) -> Result[KIRTypedSourceSpan, String] {
    let spans: Array[KIRTypedSourceSpan] = arena.references.spans
    let value: Option[KIRTypedSourceSpan] = array_get(spans, index)
    if is_none(value) { return err("typed KIR source span index is out of bounds") }
    return ok(spans[index])
}

pub fn kir_typed_binding_count(arena: KIRTypedArena) -> Int {
    return len(arena.executable.bindings)
}

pub fn kir_typed_binding_at(arena: KIRTypedArena, index: Int) -> Result[KIRTypedBinding, String] {
    let bindings: Array[KIRTypedBinding] = arena.executable.bindings
    let value: Option[KIRTypedBinding] = array_get(bindings, index)
    if is_none(value) { return err("typed KIR binding index is out of bounds") }
    return ok(bindings[index])
}

pub fn kir_typed_range_valid(arena: KIRTypedArena, range: KIRIndexRange) -> Bool {
    if range.table != KIRTypedTable::KIRTableEdges { return false }
    let count: Result[Int, String] = kir_typed_table_len(arena, range.table)
    if is_err(count) { return false }
    let edge_count: Int = result_unwrap(count)
    if range.start < 0 || range.count < 0 || range.start > edge_count { return false }
    return range.count <= edge_count - range.start
}

fn kir_typed_ref_is(arena: KIRTypedArena, reference: KIRIndexRef, table: KIRTypedTable) -> Bool {
    return reference.table == table && kir_typed_reference_valid(arena, reference)
}

fn kir_typed_range_is(arena: KIRTypedArena, range: KIRIndexRange, table: KIRTypedTable) -> Bool {
    if !kir_typed_range_valid(arena, range) { return false }
    let references: KIRTypedReferences = arena.references
    let mut index: Int = range.start
    let end: Int = range.start + range.count
    while index < end {
        let reference: KIRIndexRef = unwrap_or(array_get(references.edges, index), KIRIndexRef{ table: KIRTypedTable::KIRTableEdges, index: 0, present: false })
        if !reference.present || reference.table != table || !kir_typed_reference_valid(arena, reference) { return false }
        index = index + 1
    }
    return true
}

pub fn kir_typed_arena_references_valid(arena: KIRTypedArena) -> Bool {
    let declarations: KIRTypedDeclarations = arena.declarations
    let executable: KIRTypedExecutable = arena.executable
    let references: KIRTypedReferences = arena.references
    if !kir_typed_range_is(arena, arena.top_functions, KIRTypedTable::KIRTableFunctions) { return false }
    if !kir_typed_range_is(arena, arena.top_statements, KIRTypedTable::KIRTableStatements) { return false }

    let mut index: Int = 0
    while index < len(declarations.import_records) {
        let row: KIRTypedImport = declarations.import_records[index]
        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) { return false }
        index = index + 1
    }
    index = 0
    while index < len(declarations.type_params) {
        let row: KIRTypedTypeParam = declarations.type_params[index]
        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) { return false }
        index = index + 1
    }
    index = 0
    while index < len(executable.bindings) {
        let row: KIRTypedBinding = executable.bindings[index]
        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) { return false }
        index = index + 1
    }
    index = 0
    while index < len(declarations.fields) {
        let row: KIRTypedField = declarations.fields[index]
        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) { return false }
        index = index + 1
    }
    index = 0
    while index < len(declarations.structs) {
        let row: KIRTypedStruct = declarations.structs[index]
        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) || !kir_typed_range_is(arena, row.type_params, KIRTypedTable::KIRTableTypeParams) || !kir_typed_range_is(arena, row.fields, KIRTypedTable::KIRTableFields) { return false }
        index = index + 1
    }
    index = 0
    while index < len(declarations.enums) {
        let row: KIRTypedEnum = declarations.enums[index]
        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) || !kir_typed_range_is(arena, row.variant_spans, KIRTypedTable::KIRTableSpans) || row.variant_spans.count != len(row.variants) { return false }
        index = index + 1
    }
    index = 0
    while index < len(declarations.trait_methods) {
        let row: KIRTypedTraitMethod = declarations.trait_methods[index]
        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) || !kir_typed_range_is(arena, row.params, KIRTypedTable::KIRTableParameters) { return false }
        index = index + 1
    }
    index = 0
    while index < len(declarations.traits) {
        let row: KIRTypedTrait = declarations.traits[index]
        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) || !kir_typed_range_is(arena, row.methods, KIRTypedTable::KIRTableTraitMethods) { return false }
        index = index + 1
    }
    index = 0
    while index < len(declarations.trait_impl_methods) {
        let row: KIRTypedTraitImplMethod = declarations.trait_impl_methods[index]
        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) { return false }
        index = index + 1
    }
    index = 0
    while index < len(declarations.trait_impls) {
        let row: KIRTypedTraitImpl = declarations.trait_impls[index]
        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) || !kir_typed_range_is(arena, row.methods, KIRTypedTable::KIRTableTraitImplMethods) { return false }
        index = index + 1
    }
    index = 0
    while index < len(executable.parameters) {
        let row: KIRTypedParameter = executable.parameters[index]
        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) || !kir_typed_ref_is(arena, row.default_value, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.binding, KIRTypedTable::KIRTableBindings) { return false }
        index = index + 1
    }
    index = 0
    while index < len(executable.captures) {
        let row: KIRTypedCapture = executable.captures[index]
        if !kir_typed_ref_is(arena, row.binding, KIRTypedTable::KIRTableBindings) { return false }
        index = index + 1
    }
    index = 0
    while index < len(executable.functions) {
        let row: KIRTypedFunction = executable.functions[index]
        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) || !kir_typed_range_is(arena, row.type_params, KIRTypedTable::KIRTableTypeParams) || !kir_typed_range_is(arena, row.params, KIRTypedTable::KIRTableParameters) || !kir_typed_range_is(arena, row.captures, KIRTypedTable::KIRTableCaptures) || !kir_typed_range_is(arena, row.body, KIRTypedTable::KIRTableStatements) { return false }
        index = index + 1
    }
    index = 0
    while index < len(executable.expressions) {
        let row: KIRTypedExpression = executable.expressions[index]
        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) || !kir_typed_ref_is(arena, row.constant, KIRTypedTable::KIRTableValues) || !kir_typed_ref_is(arena, row.left, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.right, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.operand, KIRTypedTable::KIRTableExpressions) || !kir_typed_range_is(arena, row.args, KIRTypedTable::KIRTableExpressions) || !kir_typed_range_is(arena, row.items, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.base, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.receiver, KIRTypedTable::KIRTableExpressions) || !kir_typed_range_is(arena, row.map_keys, KIRTypedTable::KIRTableExpressions) || !kir_typed_range_is(arena, row.values, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.callee, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.lambda, KIRTypedTable::KIRTableFunctions) || !kir_typed_ref_is(arena, row.binding, KIRTypedTable::KIRTableBindings) { return false }
        index = index + 1
    }
    index = 0
    while index < len(executable.statements) {
        let row: KIRTypedStatement = executable.statements[index]
        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) || !kir_typed_ref_is(arena, row.binding, KIRTypedTable::KIRTableBindings) || !kir_typed_ref_is(arena, row.init, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.expr, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.target, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.value, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.cond, KIRTypedTable::KIRTableExpressions) || !kir_typed_range_is(arena, row.then_body, KIRTypedTable::KIRTableStatements) || !kir_typed_range_is(arena, row.else_body, KIRTypedTable::KIRTableStatements) || !kir_typed_range_is(arena, row.body, KIRTypedTable::KIRTableStatements) || !kir_typed_ref_is(arena, row.iter, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.return_value, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.scrutinee, KIRTypedTable::KIRTableExpressions) || !kir_typed_range_is(arena, row.arms, KIRTypedTable::KIRTableArms) { return false }
        index = index + 1
    }
    index = 0
    while index < len(executable.arms) {
        let row: KIRTypedArm = executable.arms[index]
        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) || !kir_typed_ref_is(arena, row.pattern, KIRTypedTable::KIRTablePatterns) || !kir_typed_range_is(arena, row.body, KIRTypedTable::KIRTableStatements) { return false }
        index = index + 1
    }
    index = 0
    while index < len(executable.patterns) {
        let row: KIRTypedPattern = executable.patterns[index]
        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) || !kir_typed_ref_is(arena, row.resolved_binding, KIRTypedTable::KIRTableBindings) { return false }
        index = index + 1
    }
    index = 0
    while index < len(arena.values) {
        let row: KIRTypedValue = arena.values[index]
        if !kir_typed_range_is(arena, row.array, KIRTypedTable::KIRTableValues) || !kir_typed_ref_is(arena, row.inner, KIRTypedTable::KIRTableValues) { return false }
        index = index + 1
    }
    index = 0
    while index < len(references.edges) {
        if !kir_typed_reference_valid(arena, unwrap_or(array_get(references.edges, index), KIRIndexRef{ table: KIRTypedTable::KIRTableEdges, index: 0, present: false })) { return false }
        index = index + 1
    }
    return true
}

struct KIRTypedBuildRef {
    arena: KIRTypedArena,
    reference: KIRIndexRef,
}

struct KIRTypedBuildRange {
    arena: KIRTypedArena,
    range: KIRIndexRange,
}

fn typed_with_references(arena: KIRTypedArena, references: KIRTypedReferences) -> KIRTypedArena {
    return KIRTypedArena{ format: arena.format, version: arena.version, language_version: arena.language_version, module: arena.module, source: arena.source, target: arena.target, declarations: arena.declarations, executable: arena.executable, values: arena.values, references: references, source_builder: arena.source_builder, top_functions: arena.top_functions, top_statements: arena.top_statements }
}

fn typed_with_declarations(arena: KIRTypedArena, declarations: KIRTypedDeclarations) -> KIRTypedArena {
    return KIRTypedArena{ format: arena.format, version: arena.version, language_version: arena.language_version, module: arena.module, source: arena.source, target: arena.target, declarations: declarations, executable: arena.executable, values: arena.values, references: arena.references, source_builder: arena.source_builder, top_functions: arena.top_functions, top_statements: arena.top_statements }
}

fn typed_with_executable(arena: KIRTypedArena, executable: KIRTypedExecutable) -> KIRTypedArena {
    return KIRTypedArena{ format: arena.format, version: arena.version, language_version: arena.language_version, module: arena.module, source: arena.source, target: arena.target, declarations: arena.declarations, executable: executable, values: arena.values, references: arena.references, source_builder: arena.source_builder, top_functions: arena.top_functions, top_statements: arena.top_statements }
}

fn typed_with_values(arena: KIRTypedArena, values: Array[KIRTypedValue]) -> KIRTypedArena {
    return KIRTypedArena{ format: arena.format, version: arena.version, language_version: arena.language_version, module: arena.module, source: arena.source, target: arena.target, declarations: arena.declarations, executable: arena.executable, values: values, references: arena.references, source_builder: arena.source_builder, top_functions: arena.top_functions, top_statements: arena.top_statements }
}

pub fn kir_typed_finish_source_build(arena: KIRTypedArena) -> KIRTypedArena {
    if is_none(arena.source_builder) { return arena }
    let builder: KIRTypedSourceBuilder = unwrap_or(arena.source_builder, kir_typed_empty_source_builder())
    let references: KIRTypedReferences = KIRTypedReferences{ spans: typed_source_span_rows_finish(builder.references.spans), edges: typed_index_ref_rows_finish(builder.references.edges) }
    let executable: KIRTypedExecutable = KIRTypedExecutable{
        functions: arena.executable.functions, parameters: arena.executable.parameters, captures: arena.executable.captures,
        bindings: typed_binding_rows_finish(builder.executable.bindings), expressions: typed_expression_rows_finish(builder.executable.expressions),
        statements: typed_statement_rows_finish(builder.executable.statements), arms: arena.executable.arms, patterns: arena.executable.patterns,
    }
    return KIRTypedArena{ format: arena.format, version: arena.version, language_version: arena.language_version, module: arena.module, source: arena.source, target: arena.target, declarations: arena.declarations, executable: executable, values: typed_value_rows_finish(builder.values), references: references, source_builder: none(), top_functions: arena.top_functions, top_statements: arena.top_statements }
}

// Source compilation builds typed rows through these append-only operations.
// The arena's tables remain private, and callers receive only checked row refs
// and edge ranges. Validation still owns construction of ValidatedKIR.
pub fn kir_typed_ref(table: KIRTypedTable, index: Int) -> KIRIndexRef {
    return KIRIndexRef{ table: table, index: index, present: true }
}

pub fn kir_typed_absent_ref(table: KIRTypedTable) -> KIRIndexRef {
    return KIRIndexRef{ table: table, index: 0, present: false }
}

pub fn kir_typed_empty_edges() -> KIRIndexRange {
    return KIRIndexRange{ table: KIRTypedTable::KIRTableEdges, start: 0, count: 0 }
}

fn typed_source_span_rows_len(rows: KIRTypedSourceSpanRows) -> Int { return len(rows.chunks) * 512 + len(rows.current) }
fn typed_source_span_rows_append(rows: KIRTypedSourceSpanRows, row: KIRTypedSourceSpan) -> KIRTypedSourceSpanRows {
    let mut chunks: Array[Array[KIRTypedSourceSpan]] = rows.chunks
    let mut current: Array[KIRTypedSourceSpan] = rows.current
    if len(current) >= 512 { chunks = array_push(chunks, current); current = [] }
    return KIRTypedSourceSpanRows{ chunks: chunks, current: array_push(current, row) }
}
fn typed_source_span_rows_finish(rows: KIRTypedSourceSpanRows) -> Array[KIRTypedSourceSpan] {
    let mut chunks: Array[Array[KIRTypedSourceSpan]] = rows.chunks
    if len(rows.current) > 0 { chunks = array_push(chunks, rows.current) }
    while len(chunks) > 1 {
        let mut merged: Array[Array[KIRTypedSourceSpan]] = []
        let mut index: Int = 0
        while index < len(chunks) {
            let left: Array[KIRTypedSourceSpan] = unwrap_or(array_get(chunks, index), [])
            if index + 1 < len(chunks) {
                let right: Array[KIRTypedSourceSpan] = unwrap_or(array_get(chunks, index + 1), [])
                merged = array_push(merged, array_concat(left, right))
                index = index + 2
            } else { merged = array_push(merged, left); index = index + 1 }
        }
        chunks = merged
    }
    return unwrap_or(array_get(chunks, 0), [])
}

fn typed_index_ref_rows_len(rows: KIRTypedIndexRefRows) -> Int { return len(rows.chunks) * 512 + len(rows.current) }
fn typed_index_ref_rows_append(rows: KIRTypedIndexRefRows, row: KIRIndexRef) -> KIRTypedIndexRefRows {
    let mut chunks: Array[Array[KIRIndexRef]] = rows.chunks
    let mut current: Array[KIRIndexRef] = rows.current
    if len(current) >= 512 { chunks = array_push(chunks, current); current = [] }
    return KIRTypedIndexRefRows{ chunks: chunks, current: array_push(current, row) }
}
fn typed_index_ref_rows_finish(rows: KIRTypedIndexRefRows) -> Array[KIRIndexRef] {
    let mut chunks: Array[Array[KIRIndexRef]] = rows.chunks
    if len(rows.current) > 0 { chunks = array_push(chunks, rows.current) }
    while len(chunks) > 1 {
        let mut merged: Array[Array[KIRIndexRef]] = []
        let mut index: Int = 0
        while index < len(chunks) {
            let left: Array[KIRIndexRef] = unwrap_or(array_get(chunks, index), [])
            if index + 1 < len(chunks) {
                let right: Array[KIRIndexRef] = unwrap_or(array_get(chunks, index + 1), [])
                merged = array_push(merged, array_concat(left, right))
                index = index + 2
            } else { merged = array_push(merged, left); index = index + 1 }
        }
        chunks = merged
    }
    return unwrap_or(array_get(chunks, 0), [])
}
pub fn kir_typed_reference_rows_empty() -> KIRTypedIndexRefRows { return KIRTypedIndexRefRows{ chunks: [], current: [] } }
pub fn kir_typed_reference_rows_append(rows: KIRTypedIndexRefRows, reference: KIRIndexRef) -> KIRTypedIndexRefRows { return typed_index_ref_rows_append(rows, reference) }
pub fn kir_typed_reference_rows_append_all(rows: KIRTypedIndexRefRows, references: Array[KIRIndexRef]) -> KIRTypedIndexRefRows {
    let mut updated: KIRTypedIndexRefRows = rows
    let mut index: Int = 0
    while index < len(references) { updated = typed_index_ref_rows_append(updated, unwrap_or(array_get(references, index), KIRIndexRef{ table: KIRTypedTable::KIRTableEdges, index: 0, present: false })); index = index + 1 }
    return updated
}
pub fn kir_typed_reference_rows_finish(rows: KIRTypedIndexRefRows) -> Array[KIRIndexRef] { return typed_index_ref_rows_finish(rows) }

fn typed_binding_rows_len(rows: KIRTypedBindingRows) -> Int { return len(rows.chunks) * 512 + len(rows.current) }
fn typed_binding_rows_append(rows: KIRTypedBindingRows, row: KIRTypedBinding) -> KIRTypedBindingRows {
    let mut chunks: Array[Array[KIRTypedBinding]] = rows.chunks
    let mut current: Array[KIRTypedBinding] = rows.current
    if len(current) >= 512 { chunks = array_push(chunks, current); current = [] }
    return KIRTypedBindingRows{ chunks: chunks, current: array_push(current, row) }
}
fn typed_binding_rows_finish(rows: KIRTypedBindingRows) -> Array[KIRTypedBinding] {
    let mut chunks: Array[Array[KIRTypedBinding]] = rows.chunks
    if len(rows.current) > 0 { chunks = array_push(chunks, rows.current) }
    while len(chunks) > 1 {
        let mut merged: Array[Array[KIRTypedBinding]] = []
        let mut index: Int = 0
        while index < len(chunks) {
            let left: Array[KIRTypedBinding] = unwrap_or(array_get(chunks, index), [])
            if index + 1 < len(chunks) {
                let right: Array[KIRTypedBinding] = unwrap_or(array_get(chunks, index + 1), [])
                merged = array_push(merged, array_concat(left, right))
                index = index + 2
            } else { merged = array_push(merged, left); index = index + 1 }
        }
        chunks = merged
    }
    return unwrap_or(array_get(chunks, 0), [])
}

fn typed_value_rows_len(rows: KIRTypedValueRows) -> Int { return len(rows.chunks) * 512 + len(rows.current) }
fn typed_value_rows_append(rows: KIRTypedValueRows, row: KIRTypedValue) -> KIRTypedValueRows {
    let mut chunks: Array[Array[KIRTypedValue]] = rows.chunks
    let mut current: Array[KIRTypedValue] = rows.current
    if len(current) >= 512 { chunks = array_push(chunks, current); current = [] }
    return KIRTypedValueRows{ chunks: chunks, current: array_push(current, row) }
}
fn typed_value_rows_finish(rows: KIRTypedValueRows) -> Array[KIRTypedValue] {
    let mut chunks: Array[Array[KIRTypedValue]] = rows.chunks
    if len(rows.current) > 0 { chunks = array_push(chunks, rows.current) }
    while len(chunks) > 1 {
        let mut merged: Array[Array[KIRTypedValue]] = []
        let mut index: Int = 0
        while index < len(chunks) {
            let left: Array[KIRTypedValue] = unwrap_or(array_get(chunks, index), [])
            if index + 1 < len(chunks) {
                let right: Array[KIRTypedValue] = unwrap_or(array_get(chunks, index + 1), [])
                merged = array_push(merged, array_concat(left, right))
                index = index + 2
            } else { merged = array_push(merged, left); index = index + 1 }
        }
        chunks = merged
    }
    return unwrap_or(array_get(chunks, 0), [])
}

fn typed_expression_rows_len(rows: KIRTypedExpressionRows) -> Int { return len(rows.chunks) * 512 + len(rows.current) }
fn typed_expression_rows_append(rows: KIRTypedExpressionRows, row: KIRTypedExpression) -> KIRTypedExpressionRows {
    let mut chunks: Array[Array[KIRTypedExpression]] = rows.chunks
    let mut current: Array[KIRTypedExpression] = rows.current
    if len(current) >= 512 { chunks = array_push(chunks, current); current = [] }
    return KIRTypedExpressionRows{ chunks: chunks, current: array_push(current, row) }
}
fn typed_expression_rows_finish(rows: KIRTypedExpressionRows) -> Array[KIRTypedExpression] {
    let mut chunks: Array[Array[KIRTypedExpression]] = rows.chunks
    if len(rows.current) > 0 { chunks = array_push(chunks, rows.current) }
    while len(chunks) > 1 {
        let mut merged: Array[Array[KIRTypedExpression]] = []
        let mut index: Int = 0
        while index < len(chunks) {
            let left: Array[KIRTypedExpression] = unwrap_or(array_get(chunks, index), [])
            if index + 1 < len(chunks) {
                let right: Array[KIRTypedExpression] = unwrap_or(array_get(chunks, index + 1), [])
                merged = array_push(merged, array_concat(left, right))
                index = index + 2
            } else { merged = array_push(merged, left); index = index + 1 }
        }
        chunks = merged
    }
    return unwrap_or(array_get(chunks, 0), [])
}
fn typed_expression_rows_set(rows: KIRTypedExpressionRows, index: Int, row: KIRTypedExpression) -> Result[KIRTypedExpressionRows, String] {
    if index < 0 || index >= typed_expression_rows_len(rows) { return err("typed source expression index is out of bounds") }
    let chunk_index: Int = index / 512
    if chunk_index < len(rows.chunks) {
        let chunk: Array[KIRTypedExpression] = unwrap_or(array_get(rows.chunks, chunk_index), [])
        let changed_chunk: Result[Array[KIRTypedExpression], String] = array_set(chunk, index - chunk_index * 512, row)
        if is_err(changed_chunk) { return err("typed source expression chunk index is out of bounds") }
        let changed_chunks: Result[Array[Array[KIRTypedExpression]], String] = array_set(rows.chunks, chunk_index, result_unwrap(changed_chunk))
        if is_err(changed_chunks) { return err("typed source expression table index is out of bounds") }
        return ok(KIRTypedExpressionRows{ chunks: result_unwrap(changed_chunks), current: rows.current })
    }
    let changed_current: Result[Array[KIRTypedExpression], String] = array_set(rows.current, index - len(rows.chunks) * 512, row)
    if is_err(changed_current) { return err("typed source expression table index is out of bounds") }
    return ok(KIRTypedExpressionRows{ chunks: rows.chunks, current: result_unwrap(changed_current) })
}

fn typed_statement_rows_len(rows: KIRTypedStatementRows) -> Int { return len(rows.chunks) * 512 + len(rows.current) }
fn typed_statement_rows_append(rows: KIRTypedStatementRows, row: KIRTypedStatement) -> KIRTypedStatementRows {
    let mut chunks: Array[Array[KIRTypedStatement]] = rows.chunks
    let mut current: Array[KIRTypedStatement] = rows.current
    if len(current) >= 512 { chunks = array_push(chunks, current); current = [] }
    return KIRTypedStatementRows{ chunks: chunks, current: array_push(current, row) }
}
fn typed_statement_rows_finish(rows: KIRTypedStatementRows) -> Array[KIRTypedStatement] {
    let mut chunks: Array[Array[KIRTypedStatement]] = rows.chunks
    if len(rows.current) > 0 { chunks = array_push(chunks, rows.current) }
    while len(chunks) > 1 {
        let mut merged: Array[Array[KIRTypedStatement]] = []
        let mut index: Int = 0
        while index < len(chunks) {
            let left: Array[KIRTypedStatement] = unwrap_or(array_get(chunks, index), [])
            if index + 1 < len(chunks) {
                let right: Array[KIRTypedStatement] = unwrap_or(array_get(chunks, index + 1), [])
                merged = array_push(merged, array_concat(left, right))
                index = index + 2
            } else { merged = array_push(merged, left); index = index + 1 }
        }
        chunks = merged
    }
    return unwrap_or(array_get(chunks, 0), [])
}

pub fn kir_typed_append_span(arena: KIRTypedArena, span: KIRTypedSourceSpan) -> KIRTypedAppendRef {
    if !is_none(arena.source_builder) {
        let builder: KIRTypedSourceBuilder = unwrap_or(arena.source_builder, kir_typed_empty_source_builder())
        let index: Int = typed_source_span_rows_len(builder.references.spans)
        let references: KIRTypedSourceBuildReferences = KIRTypedSourceBuildReferences{ spans: typed_source_span_rows_append(builder.references.spans, span), edges: builder.references.edges }
        let updated_builder: KIRTypedSourceBuilder = KIRTypedSourceBuilder{ references: references, executable: builder.executable, values: builder.values }
        return KIRTypedAppendRef{ arena: typed_with_source_builder(arena, some(updated_builder)), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableSpans, index: index, present: true } }
    }
    let references: KIRTypedReferences = arena.references
    let index: Int = len(references.spans)
    let updated: KIRTypedReferences = KIRTypedReferences{ spans: array_push(references.spans, span), edges: references.edges }
    return KIRTypedAppendRef{ arena: typed_with_references(arena, updated), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableSpans, index: index, present: true } }
}

pub fn kir_typed_append_edges(arena: KIRTypedArena, references_to_append: Array[KIRIndexRef]) -> KIRTypedAppendRange {
    if !is_none(arena.source_builder) {
        let builder: KIRTypedSourceBuilder = unwrap_or(arena.source_builder, kir_typed_empty_source_builder())
        let start: Int = typed_index_ref_rows_len(builder.references.edges)
        let mut rows: KIRTypedIndexRefRows = builder.references.edges
        let mut edge_index: Int = 0
        while edge_index < len(references_to_append) {
            rows = typed_index_ref_rows_append(rows, unwrap_or(array_get(references_to_append, edge_index), KIRIndexRef{ table: KIRTypedTable::KIRTableEdges, index: 0, present: false }))
            edge_index = edge_index + 1
        }
        let references: KIRTypedSourceBuildReferences = KIRTypedSourceBuildReferences{ spans: builder.references.spans, edges: rows }
        let updated_builder: KIRTypedSourceBuilder = KIRTypedSourceBuilder{ references: references, executable: builder.executable, values: builder.values }
        return KIRTypedAppendRange{ arena: typed_with_source_builder(arena, some(updated_builder)), range: KIRIndexRange{ table: KIRTypedTable::KIRTableEdges, start: start, count: len(references_to_append) } }
    }
    let references: KIRTypedReferences = arena.references
    let start: Int = len(references.edges)
    let mut edges: Array[KIRIndexRef] = references.edges
    let mut index: Int = 0
    while index < len(references_to_append) {
        edges = array_push(edges, unwrap_or(array_get(references_to_append, index), KIRIndexRef{ table: KIRTypedTable::KIRTableEdges, index: 0, present: false }))
        index = index + 1
    }
    let updated: KIRTypedReferences = KIRTypedReferences{ spans: references.spans, edges: edges }
    return KIRTypedAppendRange{ arena: typed_with_references(arena, updated), range: KIRIndexRange{ table: KIRTypedTable::KIRTableEdges, start: start, count: len(references_to_append) } }
}

pub fn kir_typed_append_binding(arena: KIRTypedArena, row: KIRTypedBinding) -> KIRTypedAppendRef {
    if !is_none(arena.source_builder) {
        let builder: KIRTypedSourceBuilder = unwrap_or(arena.source_builder, kir_typed_empty_source_builder())
        let index: Int = typed_binding_rows_len(builder.executable.bindings)
        let executable: KIRTypedSourceBuildExecutable = KIRTypedSourceBuildExecutable{ bindings: typed_binding_rows_append(builder.executable.bindings, row), expressions: builder.executable.expressions, statements: builder.executable.statements }
        let updated_builder: KIRTypedSourceBuilder = KIRTypedSourceBuilder{ references: builder.references, executable: executable, values: builder.values }
        return KIRTypedAppendRef{ arena: typed_with_source_builder(arena, some(updated_builder)), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableBindings, index: index, present: true } }
    }
    let executable: KIRTypedExecutable = arena.executable
    let index: Int = len(executable.bindings)
    let updated: KIRTypedExecutable = KIRTypedExecutable{ functions: executable.functions, parameters: executable.parameters, captures: executable.captures, bindings: array_push(executable.bindings, row), expressions: executable.expressions, statements: executable.statements, arms: executable.arms, patterns: executable.patterns }
    return KIRTypedAppendRef{ arena: typed_with_executable(arena, updated), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableBindings, index: index, present: true } }
}

pub fn kir_typed_append_value(arena: KIRTypedArena, row: KIRTypedValue) -> KIRTypedAppendRef {
    if !is_none(arena.source_builder) {
        let builder: KIRTypedSourceBuilder = unwrap_or(arena.source_builder, kir_typed_empty_source_builder())
        let index: Int = typed_value_rows_len(builder.values)
        let updated_builder: KIRTypedSourceBuilder = KIRTypedSourceBuilder{ references: builder.references, executable: builder.executable, values: typed_value_rows_append(builder.values, row) }
        return KIRTypedAppendRef{ arena: typed_with_source_builder(arena, some(updated_builder)), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableValues, index: index, present: true } }
    }
    let index: Int = len(arena.values)
    return KIRTypedAppendRef{ arena: typed_with_values(arena, array_push(arena.values, row)), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableValues, index: index, present: true } }
}

pub fn kir_typed_append_expression(arena: KIRTypedArena, row: KIRTypedExpression) -> KIRTypedAppendRef {
    if !is_none(arena.source_builder) {
        let builder: KIRTypedSourceBuilder = unwrap_or(arena.source_builder, kir_typed_empty_source_builder())
        let index: Int = typed_expression_rows_len(builder.executable.expressions)
        let executable: KIRTypedSourceBuildExecutable = KIRTypedSourceBuildExecutable{ bindings: builder.executable.bindings, expressions: typed_expression_rows_append(builder.executable.expressions, row), statements: builder.executable.statements }
        let updated_builder: KIRTypedSourceBuilder = KIRTypedSourceBuilder{ references: builder.references, executable: executable, values: builder.values }
        return KIRTypedAppendRef{ arena: typed_with_source_builder(arena, some(updated_builder)), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: index, present: true } }
    }
    let executable: KIRTypedExecutable = arena.executable
    let index: Int = len(executable.expressions)
    let updated: KIRTypedExecutable = KIRTypedExecutable{ functions: executable.functions, parameters: executable.parameters, captures: executable.captures, bindings: executable.bindings, expressions: array_push(executable.expressions, row), statements: executable.statements, arms: executable.arms, patterns: executable.patterns }
    return KIRTypedAppendRef{ arena: typed_with_executable(arena, updated), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: index, present: true } }
}

pub fn kir_typed_replace_expression(arena: KIRTypedArena, index: Int, row: KIRTypedExpression) -> Result[KIRTypedArena, String] {
    if !is_none(arena.source_builder) {
        let builder: KIRTypedSourceBuilder = unwrap_or(arena.source_builder, kir_typed_empty_source_builder())
        let changed_rows: Result[KIRTypedExpressionRows, String] = typed_expression_rows_set(builder.executable.expressions, index, row)
        if is_err(changed_rows) { return err(unwrap_or(result_error(changed_rows), "typed source expression index is out of bounds")) }
        let executable: KIRTypedSourceBuildExecutable = KIRTypedSourceBuildExecutable{ bindings: builder.executable.bindings, expressions: result_unwrap(changed_rows), statements: builder.executable.statements }
        let updated_builder: KIRTypedSourceBuilder = KIRTypedSourceBuilder{ references: builder.references, executable: executable, values: builder.values }
        return ok(typed_with_source_builder(arena, some(updated_builder)))
    }
    let executable: KIRTypedExecutable = arena.executable
    let updated_rows: Result[Array[KIRTypedExpression], String] = array_set(executable.expressions, index, row)
    if is_err(updated_rows) { return err("typed source expression index is out of bounds") }
    let updated: KIRTypedExecutable = KIRTypedExecutable{ functions: executable.functions, parameters: executable.parameters, captures: executable.captures, bindings: executable.bindings, expressions: result_unwrap(updated_rows), statements: executable.statements, arms: executable.arms, patterns: executable.patterns }
    return ok(typed_with_executable(arena, updated))
}

pub fn kir_typed_append_statement(arena: KIRTypedArena, row: KIRTypedStatement) -> KIRTypedAppendRef {
    if !is_none(arena.source_builder) {
        let builder: KIRTypedSourceBuilder = unwrap_or(arena.source_builder, kir_typed_empty_source_builder())
        let index: Int = typed_statement_rows_len(builder.executable.statements)
        let executable: KIRTypedSourceBuildExecutable = KIRTypedSourceBuildExecutable{ bindings: builder.executable.bindings, expressions: builder.executable.expressions, statements: typed_statement_rows_append(builder.executable.statements, row) }
        let updated_builder: KIRTypedSourceBuilder = KIRTypedSourceBuilder{ references: builder.references, executable: executable, values: builder.values }
        return KIRTypedAppendRef{ arena: typed_with_source_builder(arena, some(updated_builder)), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableStatements, index: index, present: true } }
    }
    let executable: KIRTypedExecutable = arena.executable
    let index: Int = len(executable.statements)
    let updated: KIRTypedExecutable = KIRTypedExecutable{ functions: executable.functions, parameters: executable.parameters, captures: executable.captures, bindings: executable.bindings, expressions: executable.expressions, statements: array_push(executable.statements, row), arms: executable.arms, patterns: executable.patterns }
    return KIRTypedAppendRef{ arena: typed_with_executable(arena, updated), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableStatements, index: index, present: true } }
}

