// Schema-shaped in-memory KIR rows. Child relationships use explicit table
// references; child lists are ranges in the shared edge table, whose entries
// name and validate their destination table. Rows do not store recursive wire
// values by value. Row payloads mirror internal/kry/mir_arena.go.
pub enum KIRTypedTable {
    KIRTableImports,
    KIRTableImportRecords,
    KIRTableSources,
    KIRTableStructs,
    KIRTableFields,
    KIRTableEnums,
    KIRTableTraits,
    KIRTableTraitMethods,
    KIRTableTraitImpls,
    KIRTableTraitImplMethods,
    KIRTableTypeParams,
    KIRTableFunctions,
    KIRTableParameters,
    KIRTableCaptures,
    KIRTableBindings,
    KIRTableExpressions,
    KIRTableStatements,
    KIRTableArms,
    KIRTablePatterns,
    KIRTableValues,
    KIRTableSpans,
    KIRTableEdges,
    KIRTableDocument,
    KIRTableTarget,
}

pub enum KIRTypedViewMode {
    KIRViewNull,
    KIRViewRow,
    KIRViewEdgeRange,
    KIRViewTableRange,
    KIRViewStrings,
    KIRViewBytes,
    KIRViewString,
    KIRViewNumber,
    KIRViewBool,
}

// A nonrecursive, typed cursor over validated arena rows. It is the backend
// traversal API; ranges resolve only through checked row references.
pub struct KIRTypedNodeView {
    private arena: KIRTypedArena,
    private mode: KIRTypedViewMode,
    private reference: KIRIndexRef,
    private range: KIRIndexRange,
    private direct_table: KIRTypedTable,
    private direct_start: Int,
    private direct_count: Int,
    private strings: Array[String],
    private bytes: Array[UInt8],
    private text: String,
    private number_text: String,
    private boolean: Bool,
}

