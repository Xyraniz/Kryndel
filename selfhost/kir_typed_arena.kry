fn typed_json_statement(arena: KIRTypedArena, node: Json) -> Result[KIRTypedBuildRef, String] {
    if json_kind(node) != "object" { return err("validated KIR statement is not an object") }
    let kind: Result[String, String] = typed_json_string_field(node, "kind", "")
    let source: Result[String, String] = typed_json_string_field(node, "source", "")
    let line: Result[Int, String] = typed_json_int_field(node, "line", 0)
    let column: Result[Int, String] = typed_json_int_field(node, "column", 0)
    let name: Result[String, String] = typed_json_string_field(node, "name", "")
    let mutable: Result[Bool, String] = typed_json_bool_field(node, "mutable", false)
    let is_const: Result[Bool, String] = typed_json_bool_field(node, "const", false)
    let annotation: Result[String, String] = typed_json_string_field(node, "annotation", "")
    if is_err(kind) || is_err(source) || is_err(line) || is_err(column) || is_err(name) || is_err(mutable) || is_err(is_const) || is_err(annotation) { return err("validated KIR statement has an invalid scalar field") }
    let span: Result[KIRTypedBuildRef, String] = typed_json_span(arena, node)
    if is_err(span) { return err(unwrap_or(result_error(span), "invalid statement span")) }
    let after_span: KIRTypedBuildRef = result_unwrap(span)
    let binding: Result[KIRTypedBuildRef, String] = typed_json_binding_ref(after_span.arena, node, "binding")
    if is_err(binding) { return err(unwrap_or(result_error(binding), "invalid statement binding")) }
    let after_binding: KIRTypedBuildRef = result_unwrap(binding)
    let init: Result[KIRTypedBuildRef, String] = typed_json_expression_ref(after_binding.arena, node, "init")
    if is_err(init) { return err(unwrap_or(result_error(init), "invalid statement initializer")) }
    let after_init: KIRTypedBuildRef = result_unwrap(init)
    let expr: Result[KIRTypedBuildRef, String] = typed_json_expression_ref(after_init.arena, node, "expr")
    if is_err(expr) { return err(unwrap_or(result_error(expr), "invalid statement expression")) }
    let after_expr: KIRTypedBuildRef = result_unwrap(expr)
    let target: Result[KIRTypedBuildRef, String] = typed_json_expression_ref(after_expr.arena, node, "target")
    if is_err(target) { return err(unwrap_or(result_error(target), "invalid statement target")) }
    let after_target: KIRTypedBuildRef = result_unwrap(target)
    let value: Result[KIRTypedBuildRef, String] = typed_json_expression_ref(after_target.arena, node, "value")
    if is_err(value) { return err(unwrap_or(result_error(value), "invalid statement value")) }
    let after_value: KIRTypedBuildRef = result_unwrap(value)
    let cond: Result[KIRTypedBuildRef, String] = typed_json_expression_ref(after_value.arena, node, "cond")
    if is_err(cond) { return err(unwrap_or(result_error(cond), "invalid statement condition")) }
    let after_cond: KIRTypedBuildRef = result_unwrap(cond)
    let then_body: Result[KIRTypedBuildRange, String] = typed_json_statement_range(after_cond.arena, node, "then")
    if is_err(then_body) { return err(unwrap_or(result_error(then_body), "invalid then branch")) }
    let after_then: KIRTypedBuildRange = result_unwrap(then_body)
    let else_body: Result[KIRTypedBuildRange, String] = typed_json_statement_range(after_then.arena, node, "else")
    if is_err(else_body) { return err(unwrap_or(result_error(else_body), "invalid else branch")) }
    let after_else: KIRTypedBuildRange = result_unwrap(else_body)
    let body: Result[KIRTypedBuildRange, String] = typed_json_statement_range(after_else.arena, node, "body")
    if is_err(body) { return err(unwrap_or(result_error(body), "invalid statement body")) }
    let after_body: KIRTypedBuildRange = result_unwrap(body)
    let iter: Result[KIRTypedBuildRef, String] = typed_json_expression_ref(after_body.arena, node, "iter")
    if is_err(iter) { return err(unwrap_or(result_error(iter), "invalid iterator")) }
    let after_iter: KIRTypedBuildRef = result_unwrap(iter)
    let return_value: Result[KIRTypedBuildRef, String] = typed_json_expression_ref(after_iter.arena, node, "return")
    if is_err(return_value) { return err(unwrap_or(result_error(return_value), "invalid return expression")) }
    let after_return: KIRTypedBuildRef = result_unwrap(return_value)
    let scrutinee: Result[KIRTypedBuildRef, String] = typed_json_expression_ref(after_return.arena, node, "scrutinee")
    if is_err(scrutinee) { return err(unwrap_or(result_error(scrutinee), "invalid match scrutinee")) }
    let after_scrutinee: KIRTypedBuildRef = result_unwrap(scrutinee)
    let arms: Result[KIRTypedBuildRange, String] = typed_json_arm_range(after_scrutinee.arena, node, "arms")
    if is_err(arms) { return err(unwrap_or(result_error(arms), "invalid statement arms")) }
    let after_arms: KIRTypedBuildRange = result_unwrap(arms)
    let executable: KIRTypedExecutable = after_arms.arena.executable
    let index: Int = len(executable.statements)
    let row: KIRTypedStatement = KIRTypedStatement{ kind: result_unwrap(kind), source: result_unwrap(source), line: result_unwrap(line), column: result_unwrap(column), span: after_span.reference, name: result_unwrap(name), binding: after_binding.reference, mutable: result_unwrap(mutable), is_const: result_unwrap(is_const), annotation: result_unwrap(annotation), init: after_init.reference, expr: after_expr.reference, target: after_target.reference, value: after_value.reference, cond: after_cond.reference, then_body: after_then.range, else_body: after_else.range, body: after_body.range, iter: after_iter.reference, return_value: after_return.reference, scrutinee: after_scrutinee.reference, arms: after_arms.range }
    let updated: KIRTypedExecutable = KIRTypedExecutable{ functions: executable.functions, parameters: executable.parameters, captures: executable.captures, bindings: executable.bindings, expressions: executable.expressions, statements: array_push(executable.statements, row), arms: executable.arms, patterns: executable.patterns }
    return ok(KIRTypedBuildRef{ arena: typed_with_executable(after_arms.arena, updated), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableStatements, index: index, present: true } })
