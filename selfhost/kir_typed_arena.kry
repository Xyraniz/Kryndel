fn typed_json_enum_variant_spans(arena: KIRTypedArena, node: Json, variant_count: Int) -> Result[KIRTypedBuildRange, String] {
    let list: Result[Json, String] = typed_json_optional_field(node, "variant_spans")
    let mut current: KIRTypedArena = arena
    let mut edges: Array[KIRIndexRef] = []
    if is_err(list) || json_kind(result_unwrap(list)) == "null" {
        let mut missing_index: Int = 0
        while missing_index < variant_count {
            edges = array_push(edges, KIRIndexRef{ table: KIRTypedTable::KIRTableSpans, index: 0, present: false })
            missing_index = missing_index + 1
        }
        return ok(typed_append_edge_range(current, edges))
    }
    let count: Result[Int, String] = json_array_len(result_unwrap(list))
    if is_err(count) || result_unwrap(count) != variant_count { return err("validated KIR enum variant span count does not match its variants") }
    let mut index: Int = 0
    while index < variant_count {
        let item: Result[Json, String] = json_array_get(result_unwrap(list), index)
        if is_err(item) { return err("validated KIR enum span list has a missing item") }
        let span: Result[KIRTypedBuildRef, String] = typed_json_span_object(current, result_unwrap(item))
        if is_err(span) { return err(unwrap_or(result_error(span), "invalid enum variant span")) }
        let built: KIRTypedBuildRef = result_unwrap(span)
        current = built.arena
        edges = array_push(edges, built.reference)
        index = index + 1
    }
    return ok(typed_append_edge_range(current, edges))
}

fn typed_json_enum_row(arena: KIRTypedArena, node: Json) -> Result[KIRTypedBuildRef, String] {
    let name: Result[String, String] = typed_json_string_field(node, "name", "")
    let source: Result[String, String] = typed_json_string_field(node, "source", "")
    let line: Result[Int, String] = typed_json_int_field(node, "line", 0)
    let column: Result[Int, String] = typed_json_int_field(node, "column", 0)
    let public: Result[Bool, String] = typed_json_bool_field(node, "public", false)
    let module: Result[String, String] = typed_json_string_field(node, "module", "")
    if is_err(name) || is_err(source) || is_err(line) || is_err(column) || is_err(public) || is_err(module) { return err("validated KIR enum has an invalid scalar field") }
    let span: Result[KIRTypedBuildRef, String] = typed_json_span(arena, node)
    if is_err(span) { return err(unwrap_or(result_error(span), "invalid enum span")) }
    let after_span: KIRTypedBuildRef = result_unwrap(span)
    let variants_json: Result[Json, String] = typed_json_array_field(node, "variants")
    if is_err(variants_json) { return err(unwrap_or(result_error(variants_json), "invalid enum variants")) }
    let variants: Result[Array[String], String] = typed_json_string_array(result_unwrap(variants_json))
    if is_err(variants) { return err(unwrap_or(result_error(variants), "invalid enum variants")) }
    let variant_spans: Result[KIRTypedBuildRange, String] = typed_json_enum_variant_spans(after_span.arena, node, len(result_unwrap(variants)))
    if is_err(variant_spans) { return err(unwrap_or(result_error(variant_spans), "invalid enum variant spans")) }
    let after_variant_spans: KIRTypedBuildRange = result_unwrap(variant_spans)
    let declarations: KIRTypedDeclarations = after_variant_spans.arena.declarations
    let index: Int = len(declarations.enums)
    let row: KIRTypedEnum = KIRTypedEnum{ name: result_unwrap(name), source: result_unwrap(source), line: result_unwrap(line), column: result_unwrap(column), span: after_span.reference, public: result_unwrap(public), module: result_unwrap(module), variants: result_unwrap(variants), variant_spans: after_variant_spans.range }
    let updated: KIRTypedDeclarations = KIRTypedDeclarations{ imports: declarations.imports, import_records: declarations.import_records, sources: declarations.sources, structs: declarations.structs, fields: declarations.fields, enums: array_push(declarations.enums, row), traits: declarations.traits, trait_methods: declarations.trait_methods, trait_impls: declarations.trait_impls, trait_impl_methods: declarations.trait_impl_methods, type_params: declarations.type_params }
    return ok(KIRTypedBuildRef{ arena: typed_with_declarations(after_variant_spans.arena, updated), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableEnums, index: index, present: true } })
}

