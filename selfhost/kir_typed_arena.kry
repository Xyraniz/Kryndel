    let after_variant_spans: KIRTypedBuildRange = result_unwrap(variant_spans)
    let declarations: KIRTypedDeclarations = after_variant_spans.arena.declarations
    let index: Int = len(declarations.enums)
    let row: KIRTypedEnum = KIRTypedEnum{ name: result_unwrap(name), source: result_unwrap(source), line: result_unwrap(line), column: result_unwrap(column), span: after_span.reference, public: result_unwrap(public), module: result_unwrap(module), variants: result_unwrap(variants), variant_spans: after_variant_spans.range }
    let updated: KIRTypedDeclarations = KIRTypedDeclarations{ imports: declarations.imports, import_records: declarations.import_records, sources: declarations.sources, structs: declarations.structs, fields: declarations.fields, enums: array_push(declarations.enums, row), traits: declarations.traits, trait_methods: declarations.trait_methods, trait_impls: declarations.trait_impls, trait_impl_methods: declarations.trait_impl_methods, type_params: declarations.type_params }
    return ok(KIRTypedBuildRef{ arena: typed_with_declarations(after_variant_spans.arena, updated), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableEnums, index: index, present: true } })
