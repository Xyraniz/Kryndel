fn typed_json_pattern(arena: KIRTypedArena, node: Json) -> Result[KIRTypedBuildRef, String] {
    if json_kind(node) != "object" { return err("validated KIR pattern is not an object") }
    let kind: Result[String, String] = typed_json_string_field(node, "kind", "")
