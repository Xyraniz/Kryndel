        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) || !kir_typed_ref_is(arena, row.constant, KIRTypedTable::KIRTableValues) || !kir_typed_ref_is(arena, row.left, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.right, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.operand, KIRTypedTable::KIRTableExpressions) || !kir_typed_range_is(arena, row.args, KIRTypedTable::KIRTableExpressions) || !kir_typed_range_is(arena, row.items, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.base, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.receiver, KIRTypedTable::KIRTableExpressions) || !kir_typed_range_is(arena, row.map_keys, KIRTypedTable::KIRTableExpressions) || !kir_typed_range_is(arena, row.values, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.callee, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.lambda, KIRTypedTable::KIRTableFunctions) || !kir_typed_ref_is(arena, row.binding, KIRTypedTable::KIRTableBindings) { return false }
        index = index + 1
