    if is_err(callee) { return err(unwrap_or(result_error(callee), "invalid expression callee")) }
    let after_callee: KIRTypedBuildRef = result_unwrap(callee)
    let lambda_json: Result[Json, String] = typed_json_optional_field(node, "lambda")
    let mut lambda: Result[KIRTypedBuildRef, String] = ok(KIRTypedBuildRef{ arena: after_callee.arena, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableFunctions, index: 0, present: false } })
    if !is_err(lambda_json) && json_kind(result_unwrap(lambda_json)) != "null" { lambda = typed_json_function(after_callee.arena, result_unwrap(lambda_json)) }
    if is_err(lambda) { return err(unwrap_or(result_error(lambda), "invalid expression lambda")) }
    let after_lambda: KIRTypedBuildRef = result_unwrap(lambda)
    let binding_json: Result[Json, String] = typed_json_optional_field(node, "binding")
    let mut binding: Result[KIRTypedBuildRef, String] = ok(KIRTypedBuildRef{ arena: after_lambda.arena, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableBindings, index: 0, present: false } })
    if !is_err(binding_json) { binding = typed_json_binding(after_lambda.arena, result_unwrap(binding_json)) }
    if is_err(binding) { return err(unwrap_or(result_error(binding), "invalid expression binding")) }
    let after_binding: KIRTypedBuildRef = result_unwrap(binding)
