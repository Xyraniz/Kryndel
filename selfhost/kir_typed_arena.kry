    let updated: KIRTypedDeclarations = KIRTypedDeclarations{ imports: declarations.imports, import_records: declarations.import_records, sources: declarations.sources, structs: array_push(declarations.structs, row), fields: declarations.fields, enums: declarations.enums, traits: declarations.traits, trait_methods: declarations.trait_methods, trait_impls: declarations.trait_impls, trait_impl_methods: declarations.trait_impl_methods, type_params: declarations.type_params }
