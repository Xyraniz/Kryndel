    if is_err(else_body) { return err(unwrap_or(result_error(else_body), "invalid else branch")) }
    let after_else: KIRTypedBuildRange = result_unwrap(else_body)
    let body: Result[KIRTypedBuildRange, String] = typed_json_statement_range(after_else.arena, node, "body")
    if is_err(body) { return err(unwrap_or(result_error(body), "invalid statement body")) }
    let after_body: KIRTypedBuildRange = result_unwrap(body)
    let iter: Result[KIRTypedBuildRef, String] = typed_json_expression_ref(after_body.arena, node, "iter")
    if is_err(iter) { return err(unwrap_or(result_error(iter), "invalid iterator")) }
    let after_iter: KIRTypedBuildRef = result_unwrap(iter)
    let return_value: Result[KIRTypedBuildRef, String] = typed_json_expression_ref(after_iter.arena, node, "return")
    if is_err(return_value) { return err(unwrap_or(result_error(return_value), "invalid return expression")) }
    let after_return: KIRTypedBuildRef = result_unwrap(return_value)
    let scrutinee: Result[KIRTypedBuildRef, String] = typed_json_expression_ref(after_return.arena, node, "scrutinee")
    if is_err(scrutinee) { return err(unwrap_or(result_error(scrutinee), "invalid match scrutinee")) }
    let after_scrutinee: KIRTypedBuildRef = result_unwrap(scrutinee)
    let arms: Result[KIRTypedBuildRange, String] = typed_json_arm_range(after_scrutinee.arena, node, "arms")
    if is_err(arms) { return err(unwrap_or(result_error(arms), "invalid statement arms")) }
    let after_arms: KIRTypedBuildRange = result_unwrap(arms)
    let executable: KIRTypedExecutable = after_arms.arena.executable
    let index: Int = len(executable.statements)
    let row: KIRTypedStatement = KIRTypedStatement{ kind: result_unwrap(kind), source: result_unwrap(source), line: result_unwrap(line), column: result_unwrap(column), span: after_span.reference, name: result_unwrap(name), binding: after_binding.reference, mutable: result_unwrap(mutable), is_const: result_unwrap(is_const), annotation: result_unwrap(annotation), init: after_init.reference, expr: after_expr.reference, target: after_target.reference, value: after_value.reference, cond: after_cond.reference, then_body: after_then.range, else_body: after_else.range, body: after_body.range, iter: after_iter.reference, return_value: after_return.reference, scrutinee: after_scrutinee.reference, arms: after_arms.range }
    let updated: KIRTypedExecutable = KIRTypedExecutable{ functions: executable.functions, parameters: executable.parameters, captures: executable.captures, bindings: executable.bindings, expressions: executable.expressions, statements: array_push(executable.statements, row), arms: executable.arms, patterns: executable.patterns }
    return ok(KIRTypedBuildRef{ arena: typed_with_executable(after_arms.arena, updated), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableStatements, index: index, present: true } })
}

