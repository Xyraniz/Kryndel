fn typed_json_enum_variant_spans(arena: KIRTypedArena, node: Json, variant_count: Int) -> Result[KIRTypedBuildRange, String] {
    let list: Result[Json, String] = typed_json_optional_field(node, "variant_spans")
    let mut current: KIRTypedArena = arena
    let mut edges: Array[KIRIndexRef] = []
    if is_err(list) || json_kind(result_unwrap(list)) == "null" {
        let mut missing_index: Int = 0
        while missing_index < variant_count {
            edges = array_push(edges, KIRIndexRef{ table: KIRTypedTable::KIRTableSpans, index: 0, present: false })
            missing_index = missing_index + 1
        }
        return ok(typed_append_edge_range(current, edges))
    }
    let count: Result[Int, String] = json_array_len(result_unwrap(list))
    if is_err(count) || result_unwrap(count) != variant_count { return err("validated KIR enum variant span count does not match its variants") }
    let mut index: Int = 0
    while index < variant_count {
        let item: Result[Json, String] = json_array_get(result_unwrap(list), index)
        if is_err(item) { return err("validated KIR enum span list has a missing item") }
        let span: Result[KIRTypedBuildRef, String] = typed_json_span_object(current, result_unwrap(item))
        if is_err(span) { return err(unwrap_or(result_error(span), "invalid enum variant span")) }
        let built: KIRTypedBuildRef = result_unwrap(span)
        current = built.arena
        edges = array_push(edges, built.reference)
        index = index + 1
    }
    return ok(typed_append_edge_range(current, edges))
}

