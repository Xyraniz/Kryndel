fn typed_json_field_range(arena: KIRTypedArena, node: Json, key: String) -> Result[KIRTypedBuildRange, String] {
    let list: Result[Json, String] = typed_json_array_field(node, key)
    if is_err(list) { return err(unwrap_or(result_error(list), "invalid struct field list")) }
    let count: Result[Int, String] = json_array_len(result_unwrap(list))
    if is_err(count) { return err("validated KIR field list cannot be read") }
    let mut current: KIRTypedArena = arena
    let mut edges: Array[KIRIndexRef] = []
    let mut index: Int = 0
    while index < result_unwrap(count) {
        let item: Result[Json, String] = json_array_get(result_unwrap(list), index)
        if is_err(item) { return err("validated KIR field list has a missing item") }
        let built: Result[KIRTypedBuildRef, String] = typed_json_field_row(current, result_unwrap(item))
        if is_err(built) { return err(unwrap_or(result_error(built), "invalid KIR field")) }
        let row: KIRTypedBuildRef = result_unwrap(built)
        current = row.arena
        edges = array_push(edges, row.reference)
        index = index + 1
    }
    return ok(typed_append_edge_range(current, edges))
}

