    if is_err(receiver) { return err(unwrap_or(result_error(receiver), "invalid expression receiver")) }
    let after_receiver: KIRTypedBuildRef = result_unwrap(receiver)
    let map_keys: Result[KIRTypedBuildRange, String] = typed_json_expression_range(after_receiver.arena, node, "map_keys")
    if is_err(map_keys) { return err(unwrap_or(result_error(map_keys), "invalid expression map keys")) }
    let after_map_keys: KIRTypedBuildRange = result_unwrap(map_keys)
