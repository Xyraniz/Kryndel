    if key == "const" { return typed_view_bool_field(arena, row.is_const) }
    if key == "annotation" { return typed_view_string_field(arena, row.annotation) }
    if key == "init" { return typed_view_reference_field(arena, row.init) }
    if key == "expr" { return typed_view_reference_field(arena, row.expr) }
    if key == "target" { return typed_view_reference_field(arena, row.target) }
    if key == "value" { return typed_view_reference_field(arena, row.value) }
    if key == "cond" { return typed_view_reference_field(arena, row.cond) }
    if key == "then" { return typed_view_edge_field(arena, row.then_body, KIRTypedTable::KIRTableStatements) }
    if key == "else" { return typed_view_edge_field(arena, row.else_body, KIRTypedTable::KIRTableStatements) }
    if key == "body" { return typed_view_edge_field(arena, row.body, KIRTypedTable::KIRTableStatements) }
    if key == "iter" { return typed_view_reference_field(arena, row.iter) }
    if key == "return" { return typed_view_reference_field(arena, row.return_value) }
    if key == "scrutinee" { return typed_view_reference_field(arena, row.scrutinee) }
    if key == "arms" { return typed_view_edge_field(arena, row.arms, KIRTypedTable::KIRTableArms) }
    return err("typed KIR statement has no field " + key)
}

fn typed_view_arm_field(arena: KIRTypedArena, row_index: Int, key: String) -> Result[KIRTypedNodeView, String] {
    let rows: Array[KIRTypedArm] = arena.executable.arms
    let row_option: Option[KIRTypedArm] = array_get(rows, row_index)
    if is_none(row_option) { return err("typed KIR match arm row is out of bounds") }
    let row: KIRTypedArm = rows[row_index]
    if key == "source" { return typed_view_string_field(arena, row.source) }
    if key == "line" { return typed_view_int_field(arena, row.line) }
    if key == "column" { return typed_view_int_field(arena, row.column) }
    if key == "span" { return typed_view_reference_field(arena, row.span) }
    if key == "pattern" { return typed_view_reference_field(arena, row.pattern) }
    if key == "body" { return typed_view_edge_field(arena, row.body, KIRTypedTable::KIRTableStatements) }
    return err("typed KIR match arm has no field " + key)
}

fn typed_view_pattern_field(arena: KIRTypedArena, row_index: Int, key: String) -> Result[KIRTypedNodeView, String] {
    let rows: Array[KIRTypedPattern] = arena.executable.patterns
    let row_option: Option[KIRTypedPattern] = array_get(rows, row_index)
    if is_none(row_option) { return err("typed KIR pattern row is out of bounds") }
    let row: KIRTypedPattern = rows[row_index]
    if key == "kind" { return typed_view_string_field(arena, row.kind) }
    if key == "source" { return typed_view_string_field(arena, row.source) }
    if key == "line" { return typed_view_int_field(arena, row.line) }
    if key == "column" { return typed_view_int_field(arena, row.column) }
    if key == "span" { return typed_view_reference_field(arena, row.span) }
    if key == "bool" { return typed_view_bool_field(arena, row.bool_value) }
    if key == "int" { return typed_view_int_field(arena, row.int_value) }
    if key == "string" { return typed_view_string_field(arena, row.string_value) }
    if key == "type" { return typed_view_string_field(arena, row.type_name) }
    if key == "variant" { return typed_view_string_field(arena, row.variant) }
    if key == "binding" { return typed_view_string_field(arena, row.binding_name) }
    if key == "present" { return typed_view_bool_field(arena, row.present) }
    if key == "ok" { return typed_view_bool_field(arena, row.ok) }
    if key == "resolved_binding" { return typed_view_reference_field(arena, row.resolved_binding) }
    return err("typed KIR pattern has no field " + key)
}

fn typed_view_value_field(arena: KIRTypedArena, row_index: Int, key: String) -> Result[KIRTypedNodeView, String] {
    let row_option: Option[KIRTypedValue] = array_get(arena.values, row_index)
    if is_none(row_option) { return err("typed KIR value row is out of bounds") }
    let row: KIRTypedValue = arena.values[row_index]
    if key == "kind" { return typed_view_string_field(arena, row.kind) }
    if key == "int" { return typed_view_int_field(arena, row.int_value) }
    if key == "uint" { return typed_view_uint_field(arena, row.uint_value) }
    if key == "uint_bits" { return typed_view_int_field(arena, int(row.uint_bits)) }
    if key == "float" { return typed_view_float_field(arena, row.float_text) }
    if key == "bool" { return typed_view_bool_field(arena, row.bool_value) }
    if key == "string" { return typed_view_string_field(arena, row.string_value) }
    if key == "bytes" { return ok(typed_view_bytes(arena, row.bytes)) }
    if key == "array" { return typed_view_edge_field(arena, row.array, KIRTypedTable::KIRTableValues) }
    if key == "inner" { return typed_view_reference_field(arena, row.inner) }
    if key == "present" { return typed_view_bool_field(arena, row.present) }
    if key == "ok" { return typed_view_bool_field(arena, row.ok) }
    return err("typed KIR value has no field " + key)
}

fn typed_view_row_field(arena: KIRTypedArena, reference: KIRIndexRef, key: String) -> Result[KIRTypedNodeView, String] {
    if !kir_typed_reference_valid(arena, reference) { return err("typed KIR view reference is invalid") }
    if reference.table == KIRTypedTable::KIRTableDocument { return typed_view_root_field(arena, key) }
    if reference.table == KIRTypedTable::KIRTableTarget { return typed_view_target_field(arena, key) }
    if reference.table == KIRTypedTable::KIRTableSpans { return typed_view_span_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableImportRecords { return typed_view_import_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableTypeParams { return typed_view_type_param_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableBindings { return typed_view_binding_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableFields { return typed_view_field_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableStructs { return typed_view_struct_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableEnums { return typed_view_enum_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableTraitMethods { return typed_view_trait_method_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableTraits { return typed_view_trait_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableTraitImplMethods { return typed_view_trait_impl_method_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableTraitImpls { return typed_view_trait_impl_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableParameters { return typed_view_parameter_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableCaptures { return typed_view_capture_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableFunctions { return typed_view_function_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableExpressions { return typed_view_expression_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableStatements { return typed_view_statement_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableArms { return typed_view_arm_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTablePatterns { return typed_view_pattern_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableValues { return typed_view_value_field(arena, reference.index, key) }
    return err("typed KIR view reference does not identify an object row")
}

pub fn kir_typed_object_get(value: KIRTypedNodeView, key: String) -> Result[KIRTypedNodeView, String] {
    if value.mode != KIRTypedViewMode::KIRViewRow { return err("typed KIR view value is not an object") }
    return typed_view_row_field(value.arena, value.reference, key)
}

// Object member names are fixed by row schemas; no recursive wire object is stored.
pub fn kir_typed_object_keys(value: KIRTypedNodeView) -> Result[Array[String], String] {
    if value.mode != KIRTypedViewMode::KIRViewRow { return err("typed KIR value is not an object") }
    if value.reference.table == KIRTypedTable::KIRTableDocument { return ok(["format", "version", "language_version", "module", "source", "target", "imports", "import_records", "sources", "structs", "enums", "traits", "trait_impls", "functions", "statements"]) }
    if value.reference.table == KIRTypedTable::KIRTableTarget { return ok(["os", "arch", "gui"]) }
    if value.reference.table == KIRTypedTable::KIRTableSpans { return ok(["start", "end"]) }
    if value.reference.table == KIRTypedTable::KIRTableImportRecords { return ok(["path", "source", "line", "column", "span"]) }
    if value.reference.table == KIRTypedTable::KIRTableTypeParams { return ok(["name", "constraint", "source", "line", "column", "span"]) }
    if value.reference.table == KIRTypedTable::KIRTableBindings { return ok(["id", "name", "type", "mutable", "source", "line", "column", "span"]) }
    if value.reference.table == KIRTypedTable::KIRTableFields { return ok(["name", "source", "line", "column", "span", "public", "type"]) }
    if value.reference.table == KIRTypedTable::KIRTableStructs { return ok(["name", "source", "line", "column", "span", "public", "module", "type_params", "fields"]) }
    if value.reference.table == KIRTypedTable::KIRTableEnums { return ok(["name", "source", "line", "column", "span", "public", "module", "variants", "variant_spans"]) }
    if value.reference.table == KIRTypedTable::KIRTableTraitMethods { return ok(["name", "source", "line", "column", "span", "params", "return"]) }
    if value.reference.table == KIRTypedTable::KIRTableTraits { return ok(["name", "source", "line", "column", "span", "public", "module", "methods"]) }
    if value.reference.table == KIRTypedTable::KIRTableTraitImplMethods { return ok(["name", "source", "line", "column", "span", "target"]) }
    if value.reference.table == KIRTypedTable::KIRTableTraitImpls { return ok(["trait", "source", "line", "column", "span", "for", "module", "methods"]) }
    if value.reference.table == KIRTypedTable::KIRTableParameters { return ok(["name", "type", "source", "line", "column", "span", "default", "binding"]) }
    if value.reference.table == KIRTypedTable::KIRTableCaptures { return ok(["binding"]) }
    if value.reference.table == KIRTypedTable::KIRTableFunctions { return ok(["name", "source", "line", "column", "span", "public", "worker", "unsafe", "trait", "module", "receiver", "return", "type_params", "params", "captures", "body"]) }
    if value.reference.table == KIRTypedTable::KIRTableExpressions { return ok(["kind", "source", "line", "column", "span", "type", "const", "int", "uint", "uint_bits", "float", "bool", "string", "name", "operator", "call_target", "trait_name", "builtin_id", "left", "right", "operand", "args", "items", "base", "field", "receiver", "map_keys", "struct_name", "struct_type", "generic_arguments", "fields", "values", "enum_type", "enum_variant", "tail", "callee", "lambda", "binding"]) }
    if value.reference.table == KIRTypedTable::KIRTableStatements { return ok(["kind", "source", "line", "column", "span", "name", "binding", "mutable", "const", "annotation", "init", "expr", "target", "value", "cond", "then", "else", "body", "iter", "return", "scrutinee", "arms"]) }
    if value.reference.table == KIRTypedTable::KIRTableArms { return ok(["source", "line", "column", "span", "pattern", "body"]) }
    if value.reference.table == KIRTypedTable::KIRTablePatterns { return ok(["kind", "source", "line", "column", "span", "bool", "int", "string", "type", "variant", "binding", "present", "ok", "resolved_binding"]) }
    if value.reference.table == KIRTypedTable::KIRTableValues { return ok(["kind", "int", "uint", "uint_bits", "float", "bool", "string", "bytes", "array", "inner", "present", "ok"]) }
    return err("typed KIR row has no object schema")
}

pub fn kir_typed_object_keys_allowed(value: KIRTypedNodeView, allowed: String) -> Bool {
    let keys: Result[Array[String], String] = kir_typed_object_keys(value)
    if is_err(keys) { return false }
    let names: Array[String] = result_unwrap(keys)
    let mut index: Int = 0
    while index < len(names) {
        let key: String = unwrap_or(array_get(names, index), "")
        if !contains(allowed, "|" + key + "|") { return false }
        index = index + 1
    }
    return true
}

pub fn kir_typed_object_fields_empty_except(value: KIRTypedNodeView, candidates: String, allowed: String, empty_arrays: String) -> Bool {
    if value.mode == KIRTypedViewMode::KIRViewRow && value.reference.table == KIRTypedTable::KIRTableExpressions {
        let row: KIRTypedExpression = value.arena.executable.expressions[value.reference.index]
        if contains(candidates, "|left|") && !contains(allowed, "|left|") && row.left.present { return false }
        if contains(candidates, "|right|") && !contains(allowed, "|right|") && row.right.present { return false }
        if contains(candidates, "|operand|") && !contains(allowed, "|operand|") && row.operand.present { return false }
        if contains(candidates, "|base|") && !contains(allowed, "|base|") && row.base.present { return false }
        if contains(candidates, "|receiver|") && !contains(allowed, "|receiver|") && row.receiver.present { return false }
        if contains(candidates, "|callee|") && !contains(allowed, "|callee|") && row.callee.present { return false }
        if contains(candidates, "|lambda|") && !contains(allowed, "|lambda|") && row.lambda.present { return false }
        if contains(candidates, "|args|") && !contains(allowed, "|args|") && (row.args.count > 0 || !contains(empty_arrays, "|args|")) { return false }
        if contains(candidates, "|items|") && !contains(allowed, "|items|") && (row.items.count > 0 || !contains(empty_arrays, "|items|")) { return false }
        if contains(candidates, "|map_keys|") && !contains(allowed, "|map_keys|") && (row.map_keys.count > 0 || !contains(empty_arrays, "|map_keys|")) { return false }
        if contains(candidates, "|values|") && !contains(allowed, "|values|") && (row.values.count > 0 || !contains(empty_arrays, "|values|")) { return false }
        return true
    }

    let keys: Result[Array[String], String] = kir_typed_object_keys(value)
    if is_err(keys) { return false }
    let names: Array[String] = result_unwrap(keys)
    let mut index: Int = 0
    while index < len(names) {
        let key: String = unwrap_or(array_get(names, index), "")
        let marker: String = "|" + key + "|"
        if contains(candidates, marker) && !contains(allowed, marker) {
            let field: Result[KIRTypedNodeView, String] = kir_typed_object_get(value, key)
            if is_err(field) { return false }
            let child: KIRTypedNodeView = result_unwrap(field)
            if kir_typed_kind(child) != "null" {
                if !contains(empty_arrays, marker) || kir_typed_kind(child) != "array" || result_unwrap(kir_typed_array_len(child)) != 0 { return false }
            }
        }
        index = index + 1
    }
    return true
}

// Check the whole structural graph, including rows that are not root-reachable.
// Call targets are symbolic links, so legal recursive functions are unaffected.
fn typed_cycle_keys(value: KIRTypedNodeView) -> Array[String] {
    if value.reference.table == KIRTypedTable::KIRTableDocument { return ["functions", "statements"] }
    if value.reference.table == KIRTypedTable::KIRTableExpressions {
        let row: KIRTypedExpression = value.arena.executable.expressions[value.reference.index]
        if row.kind == "binary" { return ["const", "left", "right"] }
        if row.kind == "index" { return ["const", "base", "left"] }
        if row.kind == "field" { return ["const", "base"] }
        if row.kind == "unary" || row.kind == "propagate" { return ["const", "operand"] }
        if row.kind == "call" { return ["const", "args", "receiver", "callee"] }
        if row.kind == "array" || row.kind == "set" { return ["const", "items"] }
        if row.kind == "map" { return ["const", "map_keys", "values"] }
        if row.kind == "struct" { return ["const", "values"] }
        if row.kind == "lambda" { return ["const", "lambda"] }
        return ["const"]
    }
    if value.reference.table == KIRTypedTable::KIRTableStatements {
        let row: KIRTypedStatement = value.arena.executable.statements[value.reference.index]
        if row.kind == "let" || row.kind == "const" { return ["init"] }
        if row.kind == "expr" { return ["expr"] }
        if row.kind == "assign" { return ["target", "value"] }
        if row.kind == "if" { return ["cond", "then", "else"] }
        if row.kind == "while" { return ["cond", "body"] }
        if row.kind == "for" { return ["iter", "body"] }
        if row.kind == "return" { return ["return"] }
        if row.kind == "match" { return ["scrutinee", "arms"] }
        return []
    }
    if value.reference.table == KIRTypedTable::KIRTableFunctions { return ["params", "captures", "body"] }
    if value.reference.table == KIRTypedTable::KIRTableParameters { return ["default"] }
    if value.reference.table == KIRTypedTable::KIRTableArms { return ["pattern", "body"] }
    if value.reference.table == KIRTypedTable::KIRTableValues {
        let row: KIRTypedValue = value.arena.values[value.reference.index]
        if row.kind == "array" || row.kind == "set" { return ["array"] }
        if row.kind == "option" || row.kind == "result" { return ["inner"] }
    }
    return []
}

// Each row has one numeric color slot. A bounded hierarchy keeps immutable
// array updates from copying a directory that grows with the whole KIR.
struct KIRTypedColors {
    pages: Array[Array[Array[Array[UInt8]]]],
    offsets: Array[Int],
}

fn typed_color_table_index(table: KIRTypedTable) -> Int {
    if table == KIRTypedTable::KIRTableExpressions { return 0 }
    if table == KIRTypedTable::KIRTableStatements { return 1 }
    if table == KIRTypedTable::KIRTableValues { return 2 }
    if table == KIRTypedTable::KIRTableFunctions { return 3 }
    if table == KIRTypedTable::KIRTableParameters { return 4 }
    if table == KIRTypedTable::KIRTableArms { return 5 }
    if table == KIRTypedTable::KIRTablePatterns { return 6 }
    if table == KIRTypedTable::KIRTableCaptures { return 7 }
    if table == KIRTypedTable::KIRTableDocument { return 8 }
    return -1
}

fn typed_new_colors(arena: KIRTypedArena) -> KIRTypedColors {
    let counts: Array[Int] = [len(arena.executable.expressions), len(arena.executable.statements), len(arena.values), len(arena.executable.functions), len(arena.executable.parameters), len(arena.executable.arms), len(arena.executable.patterns), len(arena.executable.captures), 1]
    let mut offsets: Array[Int] = []
    let mut count: Int = 0
    let mut index: Int = 0
    while index < len(counts) {
        offsets = array_push(offsets, count)
        count = count + counts[index]
        index = index + 1
    }
    let mut leaf: Array[UInt8] = []
    index = 0
    while index < 32 {
        leaf = array_push(leaf, u8(0))
        index = index + 1
    }
    let mut pages: Array[Array[Array[Array[UInt8]]]] = []
    let mut group: Array[Array[Array[UInt8]]] = []
    let mut page: Array[Array[UInt8]] = []
    index = 0
    while index < count {
        page = array_push(page, leaf)
        if len(page) == 32 {
            group = array_push(group, page)
            page = []
            if len(group) == 32 {
                pages = array_push(pages, group)
                group = []
            }
        }
        index = index + 32
    }
    if len(page) != 0 { group = array_push(group, page) }
    if len(group) != 0 { pages = array_push(pages, group) }
    return KIRTypedColors{ pages: pages, offsets: offsets }
}

fn typed_color_position(colors: KIRTypedColors, reference: KIRIndexRef) -> Int {
    let table: Int = typed_color_table_index(reference.table)
    if table < 0 { return -1 }
    return colors.offsets[table] + reference.index
}

fn typed_color_get(colors: KIRTypedColors, position: Int) -> UInt8 {
    let group_index: Int = position / 32768
    let page_index: Int = (position / 1024) % 32
    let leaf_index: Int = (position / 32) % 32
    return colors.pages[group_index][page_index][leaf_index][position % 32]
}

fn typed_color_set(colors: KIRTypedColors, position: Int, color: UInt8) -> KIRTypedColors {
    let group_index: Int = position / 32768
    let page_index: Int = (position / 1024) % 32
    let leaf_index: Int = (position / 32) % 32
    let group: Array[Array[Array[UInt8]]] = colors.pages[group_index]
    let page: Array[Array[UInt8]] = group[page_index]
    let leaf: Array[UInt8] = result_unwrap(array_set(page[leaf_index], position % 32, color))
    let updated_page: Array[Array[UInt8]] = result_unwrap(array_set(page, leaf_index, leaf))
    let updated_group: Array[Array[Array[UInt8]]] = result_unwrap(array_set(group, page_index, updated_page))
    return KIRTypedColors{ pages: result_unwrap(array_set(colors.pages, group_index, updated_group)), offsets: colors.offsets }
}

fn typed_validate_acyclic_view(value: KIRTypedNodeView, states: KIRTypedColors, depth: Int) -> Result[KIRTypedColors, String] {
    if depth > 4096 { return err("typed KIR structural nesting exceeds the validation limit") }
    let kind: String = kir_typed_kind(value)
    let mut visited: KIRTypedColors = states
    if kind == "array" {
        let count: Int = result_unwrap(kir_typed_array_len(value))
        let mut index: Int = 0
        while index < count {
            let child: Result[KIRTypedNodeView, String] = kir_typed_array_get(value, index)
            if is_err(child) { return err("typed KIR array contains an invalid reference") }
            let checked: Result[KIRTypedColors, String] = typed_validate_acyclic_view(result_unwrap(child), visited, depth + 1)
            if is_err(checked) { return checked }
            visited = result_unwrap(checked)
            index = index + 1
        }
        return ok(visited)
    }
    if kind != "object" { return ok(visited) }
    let position: Int = typed_color_position(visited, value.reference)
    if position < 0 { return err("typed KIR structural graph references an unexpected table") }
    let state: UInt8 = typed_color_get(visited, position)
    if state == u8(1) { return err("typed KIR structural reference cycle at row " + str(value.reference.index)) }
    if state == u8(2) { return ok(visited) }
    visited = typed_color_set(visited, position, u8(1))
    let names: Array[String] = typed_cycle_keys(value)
    let mut index: Int = 0
    while index < len(names) {
        let child: Result[KIRTypedNodeView, String] = kir_typed_object_get(value, names[index])
        if is_err(child) { return err("typed KIR row contains an invalid field reference") }
        let checked: Result[KIRTypedColors, String] = typed_validate_acyclic_view(result_unwrap(child), visited, depth + 1)
        if is_err(checked) { return checked }
        visited = result_unwrap(checked)
        index = index + 1
    }
    return ok(typed_color_set(visited, position, u8(2)))
}

pub fn kir_typed_arena_structure_valid(arena: KIRTypedArena) -> Result[Bool, String] {
    if !kir_typed_arena_references_valid(arena) { return err("typed KIR arena has invalid table references or edge ranges") }
    let reachable: Result[KIRTypedColors, String] = typed_validate_acyclic_view(kir_typed_root_view(arena), typed_new_colors(arena), 0)
    if is_err(reachable) { return err(unwrap_or(result_error(reachable), "typed KIR structural graph is invalid")) }
    let states: KIRTypedColors = result_unwrap(reachable)
    let tables: Array[KIRTypedTable] = [KIRTypedTable::KIRTableFunctions, KIRTypedTable::KIRTableParameters, KIRTypedTable::KIRTableExpressions, KIRTypedTable::KIRTableStatements, KIRTypedTable::KIRTableArms, KIRTypedTable::KIRTablePatterns, KIRTypedTable::KIRTableValues]
    let mut table_index: Int = 0
    while table_index < len(tables) {
        let table: KIRTypedTable = tables[table_index]
        let count: Int = result_unwrap(kir_typed_table_len(arena, table))
        let offset: Int = states.offsets[typed_color_table_index(table)]
        let mut index: Int = 0
        while index < count {
            if typed_color_get(states, offset + index) != u8(2) { return err("typed KIR arena contains an unreachable executable row") }
            index = index + 1
        }
        table_index = table_index + 1
    }
    return ok(true)
}

fn typed_number_digit(character: String) -> Bool {
    return character == "0" || character == "1" || character == "2" || character == "3" || character == "4" || character == "5" || character == "6" || character == "7" || character == "8" || character == "9"
}

// Strict JSON-number grammar, including exponent forms and negative zero.
pub fn kir_typed_number_text_valid(text: String) -> Bool {
    let characters: Array[String] = string_chars(text)
    let count: Int = len(characters)
    if count == 0 { return false }
    let mut index: Int = 0
    if unwrap_or(array_get(characters, index), "") == "-" { index = index + 1 }
    if index >= count { return false }
    let first: String = unwrap_or(array_get(characters, index), "")
    if first == "0" { index = index + 1 }
    else {
        if !typed_number_digit(first) { return false }
        while index < count && typed_number_digit(unwrap_or(array_get(characters, index), "")) { index = index + 1 }
    }
    if unwrap_or(array_get(characters, index), "") == "." {
        index = index + 1
        let start: Int = index
        while index < count && typed_number_digit(unwrap_or(array_get(characters, index), "")) { index = index + 1 }
        if index == start { return false }
    }
    let exponent: String = unwrap_or(array_get(characters, index), "")
    if exponent == "e" || exponent == "E" {
        index = index + 1
        let sign: String = unwrap_or(array_get(characters, index), "")
        if sign == "+" || sign == "-" { index = index + 1 }
        let start: Int = index
        while index < count && typed_number_digit(unwrap_or(array_get(characters, index), "")) { index = index + 1 }
        if index == start { return false }
    }
    return index == count
}

fn typed_quote_text(text: String) -> String {
    let characters: Array[String] = string_chars(text)
    let hex: Array[String] = string_chars("0123456789abcdef")
    let mut result: String = "\""
    let mut index: Int = 0
    while index < len(characters) {
        let character: String = unwrap_or(array_get(characters, index), "")
        let point: Int = int(unwrap_or(array_get(u8_array(string_to_bytes(character)), 0), u8(0)))
        if character == "\"" { result = result + "\\\"" }
        else if character == "\\" { result = result + "\\\\" }
        else if point < 32 { result = result + "\\u00" + unwrap_or(array_get(hex, point / 16), "0") + unwrap_or(array_get(hex, point % 16), "0") }
        else { result = result + character }
        index = index + 1
    }
    return result + "\""
}

fn typed_base64_bytes(values: Array[UInt8]) -> String {
    let alphabet: Array[String] = string_chars("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
    let mut text: String = ""
    let mut index: Int = 0
    while index < len(values) {
        let first: Int = int(unwrap_or(array_get(values, index), u8(0)))
        let second: Int = int(unwrap_or(array_get(values, index + 1), u8(0)))
        let third: Int = int(unwrap_or(array_get(values, index + 2), u8(0)))
        text = text + unwrap_or(array_get(alphabet, first / 4), "") + unwrap_or(array_get(alphabet, (first % 4) * 16 + second / 16), "")
        if index + 1 < len(values) { text = text + unwrap_or(array_get(alphabet, (second % 16) * 4 + third / 64), "") }
        else { text = text + "=" }
        if index + 2 < len(values) { text = text + unwrap_or(array_get(alphabet, third % 64), "") }
        else { text = text + "=" }
        index = index + 3
    }
    return text
}

fn typed_serialize_view(value: KIRTypedNodeView, quotes: Map[String, String]) -> Result[String, String] {
    let kind: String = kir_typed_kind(value)
    if kind == "null" { return ok("null") }
    if kind == "string" {
        let text: String = result_unwrap(kir_typed_string(value))
        let quoted: Option[String] = map_get(quotes, text)
        if is_some(quoted) { return ok(unwrap_or(quoted, "")) }
        return ok(typed_quote_text(text))
    }
    if kind == "number" {
        let text: String = kir_typed_number_text(value)
        if !kir_typed_number_text_valid(text) { return err("typed KIR contains invalid portable numeric text") }
        return ok(text)
    }
    if kind == "bool" {
        if result_unwrap(kir_typed_bool(value)) { return ok("true") }
        return ok("false")
    }
    if value.mode == KIRTypedViewMode::KIRViewBytes { return ok(typed_quote_text(typed_base64_bytes(value.bytes))) }
    if kind == "array" {
        let count: Int = result_unwrap(kir_typed_array_len(value))
        let mut text: String = "["
        let mut index: Int = 0
        while index < count {
            let child: Result[String, String] = typed_serialize_view(result_unwrap(kir_typed_array_get(value, index)), quotes)
            if is_err(child) { return child }
            if index > 0 { text = text + "," }
            text = text + result_unwrap(child)
            index = index + 1
        }
        return ok(text + "]")
    }
    if kind == "object" {
        let names: Array[String] = typed_portable_keys(value)
        let mut text: String = "{"
        let mut index: Int = 0
        while index < len(names) {
            let key: String = unwrap_or(array_get(names, index), "")
            let child: Result[String, String] = typed_serialize_view(result_unwrap(kir_typed_object_get(value, key)), quotes)
            if is_err(child) { return child }
            if index > 0 { text = text + "," }
            text = text + "\"" + key + "\":" + result_unwrap(child)
            index = index + 1
        }
        return ok(text + "}")
    }
    return err("typed KIR contains an unsupported portable value")
}

// Serialization is the final portable-output operation. No serializer output
// is parsed or used as a lowering input by source compilation.
pub fn kir_typed_arena_serialize(arena: KIRTypedArena) -> Result[String, String] {
    let structure: Result[Bool, String] = kir_typed_arena_structure_valid(arena)
    if is_err(structure) { return err(unwrap_or(result_error(structure), "invalid typed KIR structure")) }
    let mut quotes: Map[String, String] = {}
    let common: Array[String] = ["", "Int", "Bool", "Nil", "String", "Bytes", "Float", "UInt8", "UInt16", "UInt32", "UInt64", "linux", "windows", "amd64", "kry-ir", "1.0.0"]
    let mut index: Int = 0
    while index < len(common) {
        let text: String = unwrap_or(array_get(common, index), "")
        quotes = map_insert(quotes, text, typed_quote_text(text))
        index = index + 1
    }
    index = 0
    while index < len(arena.declarations.sources) {
        let text: String = unwrap_or(array_get(arena.declarations.sources, index), "")
        quotes = map_insert(quotes, text, typed_quote_text(text))
        index = index + 1
    }
    index = 0
    while index < len(arena.executable.bindings) {
        let binding: KIRTypedBinding = unwrap_or(array_get(arena.executable.bindings, index), KIRTypedBinding{ id: "", name: "", type_name: "", mutable: false, source: "", line: 0, column: 0, span: kir_typed_absent_ref(KIRTypedTable::KIRTableSpans) })
        let texts: Array[String] = [binding.id, binding.name, binding.type_name]
        let mut text_index: Int = 0
        while text_index < len(texts) {
            let text: String = unwrap_or(array_get(texts, text_index), "")
            if !map_contains_key(quotes, text) { quotes = map_insert(quotes, text, typed_quote_text(text)) }
            text_index = text_index + 1
        }
        index = index + 1
    }
    return typed_serialize_view(kir_typed_root_view(arena), quotes)
}

pub fn kir_typed_table_view(arena: KIRTypedArena, table: KIRTypedTable) -> Result[KIRTypedNodeView, String] {
    let count: Result[Int, String] = kir_typed_table_len(arena, table)
    if is_err(count) { return err("invalid typed KIR table") }
    return ok(typed_view_direct_rows(arena, table, result_unwrap(count)))
}

fn typed_parse_uint_text(number_text: String) -> Result[UInt64, String] {
    if number_text == "" || starts_with(number_text, "-") || contains(number_text, ".") || contains(number_text, "e") || contains(number_text, "E") { return err("typed KIR number is not an unsigned integer") }
    let characters: Array[String] = string_chars(number_text)
    if len(characters) == 0 { return err("typed KIR number is empty") }
    let maximum: UInt64 = u64(0) - u64(1)
    let threshold: UInt64 = maximum / u64(10)
    let final_digit: UInt64 = maximum % u64(10)
    let mut result: UInt64 = u64(0)
    let mut index: Int = 0
    while index < len(characters) {
        let character: String = unwrap_or(array_get(characters, index), "")
        if character != "0" && character != "1" && character != "2" && character != "3" && character != "4" && character != "5" && character != "6" && character != "7" && character != "8" && character != "9" { return err("typed KIR number contains a non-digit") }
        let digit: Int = int(character)
        let digit_value: UInt64 = u64(digit)
        if result > threshold || (result == threshold && digit_value > final_digit) { return err("typed KIR integer is outside the UInt64 range") }
        result = result * u64(10) + digit_value
        index = index + 1
    }
    return ok(result)
}


pub fn kir_typed_view_arena(value: KIRTypedNodeView) -> KIRTypedArena { return value.arena }

// The portable schema permits omitted inactive fields. Emission retains active
// payloads and metadata rather than filling every union alternative with zeros.
fn typed_portable_keys(value: KIRTypedNodeView) -> Array[String] {
    let table: KIRTypedTable = value.reference.table
    if table != KIRTypedTable::KIRTableExpressions && table != KIRTypedTable::KIRTableStatements && table != KIRTypedTable::KIRTableValues { return result_unwrap(kir_typed_object_keys(value)) }
    let kind: String = result_unwrap(kir_typed_string(result_unwrap(kir_typed_object_get(value, "kind"))))
    let mut keys: Array[String] = ["kind"]
    if table != KIRTypedTable::KIRTableValues { keys = ["kind", "source", "line", "column", "span"] }
    if table == KIRTypedTable::KIRTableExpressions { keys = array_concat(keys, ["type", "const"]) }
    if table == KIRTypedTable::KIRTableValues || table == KIRTypedTable::KIRTableExpressions {
        if kind == "int" || kind == "float" || kind == "bool" || kind == "string" { keys = array_push(keys, kind) }
        if kind == "uint" { keys = array_concat(keys, ["uint", "uint_bits"]) }
    }
    if table == KIRTypedTable::KIRTableValues {
        if kind == "bytes" { keys = array_push(keys, "bytes") }
        if kind == "array" || kind == "set" { keys = array_push(keys, "array") }
        if kind == "option" { keys = array_concat(keys, ["inner", "present"]) }
        if kind == "result" { keys = array_concat(keys, ["inner", "ok"]) }
        return keys
    }
    if table == KIRTypedTable::KIRTableExpressions {
        if kind == "var" { keys = array_concat(keys, ["name", "binding"]) }
        if kind == "unary" { keys = array_concat(keys, ["operator", "operand"]) }
        if kind == "binary" { keys = array_concat(keys, ["operator", "left", "right"]) }
        if kind == "call" {
            keys = array_concat(keys, ["name", "call_target", "args"])
            let target: String = result_unwrap(kir_typed_string(result_unwrap(kir_typed_object_get(value, "call_target"))))
            if starts_with(target, "builtin:") { keys = array_push(keys, "builtin_id") }
        }
        if kind == "array" || kind == "set" { keys = array_push(keys, "items") }
        if kind == "index" { keys = array_concat(keys, ["base", "left"]) }
        if kind == "field" { keys = array_concat(keys, ["base", "field"]) }
        if kind == "struct" { keys = array_concat(keys, ["struct_name", "struct_type", "fields", "values"]) }
        if kind == "enum" { keys = array_concat(keys, ["enum_type", "enum_variant"]) }
        if kind == "map" { keys = array_concat(keys, ["map_keys", "values"]) }
        if kind == "propagate" { keys = array_push(keys, "operand") }
        return keys
    }
    if kind == "let" || kind == "const" { keys = array_concat(keys, ["name", "binding", "mutable", "const", "annotation", "init"]) }
    if kind == "expr" { keys = array_push(keys, "expr") }
    if kind == "assign" { keys = array_concat(keys, ["target", "value"]) }
    if kind == "if" { keys = array_concat(keys, ["cond", "then", "else"]) }
    if kind == "while" { keys = array_concat(keys, ["cond", "body"]) }
    if kind == "for" { keys = array_concat(keys, ["name", "binding", "iter", "body"]) }
    if kind == "return" { keys = array_push(keys, "return") }
    if kind == "match" { keys = array_concat(keys, ["scrutinee", "arms"]) }
    return keys
}

// Reject non-finite Float64 magnitudes without executing Float arithmetic.
// The overflow midpoint is (2^1024 - 2^970); ties overflow as in Go's decoder.
pub fn kir_typed_float_text_valid(text: String) -> Bool {
    if !kir_typed_number_text_valid(text) { return false }
    let characters: Array[String] = string_chars(text)
    let count: Int = len(characters)
    let mut index: Int = 0
    if unwrap_or(array_get(characters, index), "") == "-" { index = index + 1 }
    let mut before_decimal: Int = 0
    let mut decimal: Bool = false
    let mut digits: Int = 0
    let mut first_nonzero: Int = -1
    let mut significant: Array[String] = []
    while index < count {
        let character: String = unwrap_or(array_get(characters, index), "")
        if character == "e" || character == "E" { break }
        if character == "." { decimal = true }
        else {
            if !decimal { before_decimal = before_decimal + 1 }
            if character != "0" && first_nonzero < 0 { first_nonzero = digits }
            if first_nonzero >= 0 { significant = array_push(significant, character) }
            digits = digits + 1
        }
        index = index + 1
    }
    if first_nonzero < 0 { return true }
    let mut exponent: Int = 0
    let mut negative_exponent: Bool = false
    if index < count {
        index = index + 1
        let sign: String = unwrap_or(array_get(characters, index), "")
        if sign == "-" || sign == "+" { negative_exponent = sign == "-"; index = index + 1 }
        while index < count {
            if exponent < 10000 { exponent = exponent * 10 + int(unwrap_or(array_get(characters, index), "0")) }
            index = index + 1
        }
    }
    if negative_exponent { exponent = -exponent }
    let magnitude: Int = exponent + before_decimal - first_nonzero - 1
    if magnitude < 308 { return true }
    if magnitude > 308 { return false }
    let midpoint: Array[String] = string_chars("")
    index = 0
    while index < len(midpoint) {
        let actual: Int = int(unwrap_or(array_get(significant, index), "0"))
        let maximum: Int = int(unwrap_or(array_get(midpoint, index), "0"))
        if actual < maximum { return true }
        if actual > maximum { return false }
        index = index + 1
    }
    return false
}

pub fn kir_typed_float_payload_present(value: KIRTypedNodeView) -> Bool {
    if value.mode != KIRTypedViewMode::KIRViewRow { return false }
    if value.reference.table == KIRTypedTable::KIRTableExpressions {
        let row: KIRTypedExpression = unwrap_or(array_get(value.arena.executable.expressions, value.reference.index), kir_typed_empty_expression())
        return row.float_text != "" && kir_typed_float_text_valid(row.float_text)
    }
    if value.reference.table == KIRTypedTable::KIRTableValues {
        let row: KIRTypedValue = unwrap_or(array_get(value.arena.values, value.reference.index), kir_typed_empty_value())
        return row.float_text != "" && kir_typed_float_text_valid(row.float_text)
    }
    return false
}

fn typed_base64_digit(character: String) -> Int {
    let alphabet: Array[String] = string_chars("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
    let mut index: Int = 0
    while index < 64 {
        if character == unwrap_or(array_get(alphabet, index), "") { return index }
        index = index + 1
    }
    return -1
}

fn typed_decode_base64(text: String) -> Result[Array[UInt8], String] {
    let characters: Array[String] = string_chars(text)
    let count: Int = len(characters)
    if count % 4 != 0 { return err("portable KIR bytes have malformed base64 length") }
    let mut values: Array[UInt8] = []
    let mut index: Int = 0
    while index < count {
        let first: Int = typed_base64_digit(unwrap_or(array_get(characters, index), ""))
        let second: Int = typed_base64_digit(unwrap_or(array_get(characters, index + 1), ""))
        let third_text: String = unwrap_or(array_get(characters, index + 2), "")
        let fourth_text: String = unwrap_or(array_get(characters, index + 3), "")
        let third: Int = typed_base64_digit(third_text)
        let fourth: Int = typed_base64_digit(fourth_text)
        if first < 0 || second < 0 { return err("portable KIR bytes have malformed base64 digits") }
        values = array_push(values, u8(first * 4 + second / 16))
        if third_text == "=" {
            if fourth_text != "=" || index + 4 != count { return err("portable KIR bytes have malformed base64 padding") }
        } else {
            if third < 0 { return err("portable KIR bytes have malformed base64 digits") }
            values = array_push(values, u8((second % 16) * 16 + third / 4))
            if fourth_text == "=" {
                if index + 4 != count { return err("portable KIR bytes have malformed base64 padding") }
            } else {
                if fourth < 0 { return err("portable KIR bytes have malformed base64 digits") }
                values = array_push(values, u8((third % 4) * 64 + fourth))
            }
        }
        index = index + 4
    }
    return ok(values)
}

pub fn kir_typed_statement_children_valid(value: KIRTypedNodeView) -> Bool {
    if value.mode != KIRTypedViewMode::KIRViewRow || value.reference.table != KIRTypedTable::KIRTableStatements { return false }
    let row: KIRTypedStatement = value.arena.executable.statements[value.reference.index]
    let kind: String = row.kind
    if row.init.present && kind != "let" && kind != "const" { return false }
    if row.expr.present && kind != "expr" { return false }
    if (row.target.present || row.value.present) && kind != "assign" { return false }
    if row.cond.present && kind != "if" && kind != "while" { return false }
    if (row.then_body.count > 0 || row.else_body.count > 0) && kind != "if" { return false }
    if row.body.count > 0 && kind != "while" && kind != "for" { return false }
    if row.iter.present && kind != "for" { return false }
    if row.return_value.present && kind != "return" { return false }
    if (row.scrutinee.present || row.arms.count > 0) && kind != "match" { return false }
    if row.binding.present && kind != "let" && kind != "const" && kind != "for" { return false }
    return true
}
