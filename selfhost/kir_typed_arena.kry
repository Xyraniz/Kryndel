        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) || !kir_typed_ref_is(arena, row.binding, KIRTypedTable::KIRTableBindings) || !kir_typed_ref_is(arena, row.init, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.expr, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.target, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.value, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.cond, KIRTypedTable::KIRTableExpressions) || !kir_typed_range_is(arena, row.then_body, KIRTypedTable::KIRTableStatements) || !kir_typed_range_is(arena, row.else_body, KIRTypedTable::KIRTableStatements) || !kir_typed_range_is(arena, row.body, KIRTypedTable::KIRTableStatements) || !kir_typed_ref_is(arena, row.iter, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.return_value, KIRTypedTable::KIRTableExpressions) || !kir_typed_ref_is(arena, row.scrutinee, KIRTypedTable::KIRTableExpressions) || !kir_typed_range_is(arena, row.arms, KIRTypedTable::KIRTableArms) { return false }
