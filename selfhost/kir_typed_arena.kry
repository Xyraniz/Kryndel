    if is_err(captures) { return err(unwrap_or(result_error(captures), "invalid function captures")) }
    let after_captures: KIRTypedBuildRange = result_unwrap(captures)
    let body: Result[KIRTypedBuildRange, String] = typed_json_statement_range(after_captures.arena, node, "body")
    if is_err(body) { return err(unwrap_or(result_error(body), "invalid function body")) }
    let after_body: KIRTypedBuildRange = result_unwrap(body)
    let executable: KIRTypedExecutable = after_body.arena.executable
    let index: Int = len(executable.functions)
    let row: KIRTypedFunction = KIRTypedFunction{ name: result_unwrap(name), source: result_unwrap(source), line: result_unwrap(line), column: result_unwrap(column), span: after_span.reference, public: result_unwrap(public), worker: result_unwrap(worker), is_unsafe: result_unwrap(unsafe_value), trait_name: result_unwrap(trait_name), module: result_unwrap(module), receiver: result_unwrap(receiver), return_type: result_unwrap(return_type), type_params: after_type_params.range, params: after_params.range, captures: after_captures.range, body: after_body.range }
    let updated: KIRTypedExecutable = KIRTypedExecutable{ functions: array_push(executable.functions, row), parameters: executable.parameters, captures: executable.captures, bindings: executable.bindings, expressions: executable.expressions, statements: executable.statements, arms: executable.arms, patterns: executable.patterns }
    return ok(KIRTypedBuildRef{ arena: typed_with_executable(after_body.arena, updated), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableFunctions, index: index, present: true } })
