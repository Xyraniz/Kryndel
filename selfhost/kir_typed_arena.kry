        if !kir_typed_ref_is(arena, row.span, KIRTypedTable::KIRTableSpans) || !kir_typed_range_is(arena, row.type_params, KIRTypedTable::KIRTableTypeParams) || !kir_typed_range_is(arena, row.params, KIRTypedTable::KIRTableParameters) || !kir_typed_range_is(arena, row.captures, KIRTypedTable::KIRTableCaptures) || !kir_typed_range_is(arena, row.body, KIRTypedTable::KIRTableStatements) { return false }
