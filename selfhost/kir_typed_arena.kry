    if is_err(name) || is_err(source) || is_err(line) || is_err(column) || is_err(public) || is_err(worker) || is_err(unsafe_value) || is_err(trait_name) || is_err(module) || is_err(receiver) || is_err(return_type) { return err("validated KIR function has an invalid scalar field") }
    let span: Result[KIRTypedBuildRef, String] = typed_json_span(arena, node)
