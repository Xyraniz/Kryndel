    if is_err(target) { return err(unwrap_or(result_error(target), "invalid statement target")) }
    let after_target: KIRTypedBuildRef = result_unwrap(target)
    let value: Result[KIRTypedBuildRef, String] = typed_json_expression_ref(after_target.arena, node, "value")
    if is_err(value) { return err(unwrap_or(result_error(value), "invalid statement value")) }
    let after_value: KIRTypedBuildRef = result_unwrap(value)
    let cond: Result[KIRTypedBuildRef, String] = typed_json_expression_ref(after_value.arena, node, "cond")
