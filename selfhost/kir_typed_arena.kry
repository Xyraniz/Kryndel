    while index < result_unwrap(count) {
        let item: Result[Json, String] = json_array_get(result_unwrap(list), index)
        if is_err(item) { return err("validated KIR traits have a missing item") }
        let built: Result[KIRTypedBuildRef, String] = typed_json_trait_row(current, result_unwrap(item))
        if is_err(built) { return err(unwrap_or(result_error(built), "invalid KIR trait")) }
        let row: KIRTypedBuildRef = result_unwrap(built)
        current = row.arena
        edges = array_push(edges, row.reference)
        index = index + 1
    }
    return ok(typed_append_edge_range(current, edges))
}

fn typed_json_trait_impl_method(arena: KIRTypedArena, node: Json) -> Result[KIRTypedBuildRef, String] {
    let name: Result[String, String] = typed_json_string_field(node, "name", "")
    let source: Result[String, String] = typed_json_string_field(node, "source", "")
    let line: Result[Int, String] = typed_json_int_field(node, "line", 0)
    let column: Result[Int, String] = typed_json_int_field(node, "column", 0)
    let target: Result[String, String] = typed_json_string_field(node, "target", "")
    if is_err(name) || is_err(source) || is_err(line) || is_err(column) || is_err(target) { return err("validated KIR trait implementation method has an invalid scalar field") }
    let span: Result[KIRTypedBuildRef, String] = typed_json_span(arena, node)
    if is_err(span) { return err(unwrap_or(result_error(span), "invalid trait implementation method span")) }
    let after_span: KIRTypedBuildRef = result_unwrap(span)
    let declarations: KIRTypedDeclarations = after_span.arena.declarations
    let index: Int = len(declarations.trait_impl_methods)
    let row: KIRTypedTraitImplMethod = KIRTypedTraitImplMethod{ name: result_unwrap(name), source: result_unwrap(source), line: result_unwrap(line), column: result_unwrap(column), span: after_span.reference, target: result_unwrap(target) }
    let updated: KIRTypedDeclarations = KIRTypedDeclarations{ imports: declarations.imports, import_records: declarations.import_records, sources: declarations.sources, structs: declarations.structs, fields: declarations.fields, enums: declarations.enums, traits: declarations.traits, trait_methods: declarations.trait_methods, trait_impls: declarations.trait_impls, trait_impl_methods: array_push(declarations.trait_impl_methods, row), type_params: declarations.type_params }
    return ok(KIRTypedBuildRef{ arena: typed_with_declarations(after_span.arena, updated), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableTraitImplMethods, index: index, present: true } })
}

fn typed_json_trait_impl_method_range(arena: KIRTypedArena, node: Json, key: String) -> Result[KIRTypedBuildRange, String] {
    let list: Result[Json, String] = typed_json_array_field(node, key)
    if is_err(list) { return err(unwrap_or(result_error(list), "invalid trait implementation methods")) }
    let count: Result[Int, String] = json_array_len(result_unwrap(list))
    if is_err(count) { return err("validated KIR trait implementation methods cannot be read") }
    let mut current: KIRTypedArena = arena
    let mut edges: Array[KIRIndexRef] = []
    let mut index: Int = 0
    while index < result_unwrap(count) {
        let item: Result[Json, String] = json_array_get(result_unwrap(list), index)
        if is_err(item) { return err("validated KIR trait implementation methods have a missing item") }
        let built: Result[KIRTypedBuildRef, String] = typed_json_trait_impl_method(current, result_unwrap(item))
        if is_err(built) { return err(unwrap_or(result_error(built), "invalid KIR trait implementation method")) }
        let row: KIRTypedBuildRef = result_unwrap(built)
        current = row.arena
        edges = array_push(edges, row.reference)
        index = index + 1
    }
    return ok(typed_append_edge_range(current, edges))
}

fn typed_json_trait_impl_row(arena: KIRTypedArena, node: Json) -> Result[KIRTypedBuildRef, String] {
    let trait_name: Result[String, String] = typed_json_string_field(node, "trait", "")
    let source: Result[String, String] = typed_json_string_field(node, "source", "")
    let line: Result[Int, String] = typed_json_int_field(node, "line", 0)
    let column: Result[Int, String] = typed_json_int_field(node, "column", 0)
    let for_type: Result[String, String] = typed_json_string_field(node, "for", "")
    let module: Result[String, String] = typed_json_string_field(node, "module", "")
    if is_err(trait_name) || is_err(source) || is_err(line) || is_err(column) || is_err(for_type) || is_err(module) { return err("validated KIR trait implementation has an invalid scalar field") }
    let span: Result[KIRTypedBuildRef, String] = typed_json_span(arena, node)
    if is_err(span) { return err(unwrap_or(result_error(span), "invalid trait implementation span")) }
    let after_span: KIRTypedBuildRef = result_unwrap(span)
    let methods: Result[KIRTypedBuildRange, String] = typed_json_trait_impl_method_range(after_span.arena, node, "methods")
    if is_err(methods) { return err(unwrap_or(result_error(methods), "invalid trait implementation methods")) }
    let after_methods: KIRTypedBuildRange = result_unwrap(methods)
    let declarations: KIRTypedDeclarations = after_methods.arena.declarations
    let index: Int = len(declarations.trait_impls)
    let row: KIRTypedTraitImpl = KIRTypedTraitImpl{ trait_name: result_unwrap(trait_name), source: result_unwrap(source), line: result_unwrap(line), column: result_unwrap(column), span: after_span.reference, for_type: result_unwrap(for_type), module: result_unwrap(module), methods: after_methods.range }
    let updated: KIRTypedDeclarations = KIRTypedDeclarations{ imports: declarations.imports, import_records: declarations.import_records, sources: declarations.sources, structs: declarations.structs, fields: declarations.fields, enums: declarations.enums, traits: declarations.traits, trait_methods: declarations.trait_methods, trait_impls: array_push(declarations.trait_impls, row), trait_impl_methods: declarations.trait_impl_methods, type_params: declarations.type_params }
    return ok(KIRTypedBuildRef{ arena: typed_with_declarations(after_methods.arena, updated), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableTraitImpls, index: index, present: true } })
}

fn typed_json_trait_impl_range(arena: KIRTypedArena, node: Json, key: String) -> Result[KIRTypedBuildRange, String] {
    let list: Result[Json, String] = typed_json_array_field(node, key)
    if is_err(list) { return err(unwrap_or(result_error(list), "invalid trait implementation list")) }
    let count: Result[Int, String] = json_array_len(result_unwrap(list))
    if is_err(count) { return err("validated KIR trait implementations cannot be read") }
    let mut current: KIRTypedArena = arena
    let mut edges: Array[KIRIndexRef] = []
    let mut index: Int = 0
    while index < result_unwrap(count) {
        let item: Result[Json, String] = json_array_get(result_unwrap(list), index)
        if is_err(item) { return err("validated KIR trait implementations have a missing item") }
        let built: Result[KIRTypedBuildRef, String] = typed_json_trait_impl_row(current, result_unwrap(item))
        if is_err(built) { return err(unwrap_or(result_error(built), "invalid KIR trait implementation")) }
        let row: KIRTypedBuildRef = result_unwrap(built)
        current = row.arena
        edges = array_push(edges, row.reference)
        index = index + 1
    }
    return ok(typed_append_edge_range(current, edges))
}

fn typed_json_function_range(arena: KIRTypedArena, node: Json, key: String) -> Result[KIRTypedBuildRange, String] {
    let list: Result[Json, String] = typed_json_array_field(node, key)
    if is_err(list) { return err(unwrap_or(result_error(list), "invalid function list")) }
    let count: Result[Int, String] = json_array_len(result_unwrap(list))
    if is_err(count) { return err("validated KIR function list cannot be read") }
    let mut current: KIRTypedArena = arena
    let mut edges: Array[KIRIndexRef] = []
    let mut index: Int = 0
    while index < result_unwrap(count) {
        let item: Result[Json, String] = json_array_get(result_unwrap(list), index)
        if is_err(item) { return err("validated KIR function list has a missing item") }
        let built: Result[KIRTypedBuildRef, String] = typed_json_function(current, result_unwrap(item))
        if is_err(built) { return err(unwrap_or(result_error(built), "invalid KIR function")) }
        let row: KIRTypedBuildRef = result_unwrap(built)
        current = row.arena
        edges = array_push(edges, row.reference)
        index = index + 1
    }
    return ok(typed_append_edge_range(current, edges))
}

fn typed_json_optional_import_range(arena: KIRTypedArena, node: Json, key: String) -> Result[KIRTypedBuildRange, String] {
    let field: Result[Json, String] = typed_json_optional_field(node, key)
    if is_err(field) || json_kind(result_unwrap(field)) == "null" { return ok(typed_empty_range(arena)) }
    return typed_json_import_range(arena, node, key)
}

fn typed_with_document(arena: KIRTypedArena, header: KIRTypedDocumentHeader) -> KIRTypedArena {
    return KIRTypedArena{ format: header.format, version: header.version, language_version: header.language_version, module: header.module, source: header.source, target: header.target, declarations: arena.declarations, executable: arena.executable, values: arena.values, references: arena.references, source_builder: arena.source_builder, top_functions: header.top_functions, top_statements: header.top_statements }
}

pub fn kir_typed_arena_from_validated_json(document: Json) -> Result[KIRTypedArena, String] {
    if json_kind(document) != "object" { return err("validated KIR document is not an object") }
    let format: Result[String, String] = typed_json_string_field(document, "format", "")
    let version: Result[Int, String] = typed_json_int_field(document, "version", 0)
    let language_version: Result[String, String] = typed_json_string_field(document, "language_version", "")
    let module: Result[String, String] = typed_json_string_field(document, "module", "")
    let source: Result[String, String] = typed_json_string_field(document, "source", "")
    if is_err(format) || is_err(version) || is_err(language_version) || is_err(module) || is_err(source) { return err("validated KIR document has an invalid header") }

    let target_json: Result[Json, String] = json_object_get(document, "target")
    if is_err(target_json) || json_kind(result_unwrap(target_json)) != "object" { return err("validated KIR document has no target object") }
    let target_value: Json = result_unwrap(target_json)
    let target_os: Result[String, String] = typed_json_string_field(target_value, "os", "")
    let target_arch: Result[String, String] = typed_json_string_field(target_value, "arch", "")
    let target_gui: Result[Bool, String] = typed_json_bool_field(target_value, "gui", false)
    if is_err(target_os) || is_err(target_arch) || is_err(target_gui) { return err("validated KIR target has an invalid scalar field") }
    let target: KIRTypedTarget = KIRTypedTarget{ os: result_unwrap(target_os), arch: result_unwrap(target_arch), gui: result_unwrap(target_gui) }

    let imports_json: Result[Json, String] = typed_json_array_field(document, "imports")
    let sources_json: Result[Json, String] = typed_json_array_field(document, "sources")
    if is_err(imports_json) || is_err(sources_json) { return err("validated KIR document has invalid import/source lists") }
    let imports: Result[Array[String], String] = typed_json_string_array(result_unwrap(imports_json))
    let sources: Result[Array[String], String] = typed_json_string_array(result_unwrap(sources_json))
    if is_err(imports) || is_err(sources) { return err("validated KIR document has invalid import/source names") }

    let mut arena: KIRTypedArena = kir_typed_empty_arena()
    let initial_declarations: KIRTypedDeclarations = arena.declarations
    let with_names: KIRTypedDeclarations = KIRTypedDeclarations{ imports: result_unwrap(imports), import_records: initial_declarations.import_records, sources: result_unwrap(sources), structs: initial_declarations.structs, fields: initial_declarations.fields, enums: initial_declarations.enums, traits: initial_declarations.traits, trait_methods: initial_declarations.trait_methods, trait_impls: initial_declarations.trait_impls, trait_impl_methods: initial_declarations.trait_impl_methods, type_params: initial_declarations.type_params }
    arena = typed_with_declarations(arena, with_names)

    let import_records: Result[KIRTypedBuildRange, String] = typed_json_optional_import_range(arena, document, "import_records")
    if is_err(import_records) { return err(unwrap_or(result_error(import_records), "invalid KIR import records")) }
    let after_imports: KIRTypedBuildRange = result_unwrap(import_records)
    let structs: Result[KIRTypedBuildRange, String] = typed_json_struct_range(after_imports.arena, document, "structs")
    if is_err(structs) { return err(unwrap_or(result_error(structs), "invalid KIR structs")) }
    let after_structs: KIRTypedBuildRange = result_unwrap(structs)
    let enums: Result[KIRTypedBuildRange, String] = typed_json_enum_range(after_structs.arena, document, "enums")
    if is_err(enums) { return err(unwrap_or(result_error(enums), "invalid KIR enums")) }
    let after_enums: KIRTypedBuildRange = result_unwrap(enums)
    let traits: Result[KIRTypedBuildRange, String] = typed_json_trait_range(after_enums.arena, document, "traits")
    if is_err(traits) { return err(unwrap_or(result_error(traits), "invalid KIR traits")) }
    let after_traits: KIRTypedBuildRange = result_unwrap(traits)
    let trait_impls: Result[KIRTypedBuildRange, String] = typed_json_trait_impl_range(after_traits.arena, document, "trait_impls")
    if is_err(trait_impls) { return err(unwrap_or(result_error(trait_impls), "invalid KIR trait implementations")) }
    let after_trait_impls: KIRTypedBuildRange = result_unwrap(trait_impls)
    let functions: Result[KIRTypedBuildRange, String] = typed_json_function_range(after_trait_impls.arena, document, "functions")
    if is_err(functions) { return err(unwrap_or(result_error(functions), "invalid KIR functions")) }
    let after_functions: KIRTypedBuildRange = result_unwrap(functions)
    let statements: Result[KIRTypedBuildRange, String] = typed_json_statement_range(after_functions.arena, document, "statements")
    if is_err(statements) { return err(unwrap_or(result_error(statements), "invalid KIR statements")) }
    let after_statements: KIRTypedBuildRange = result_unwrap(statements)

    let header: KIRTypedDocumentHeader = KIRTypedDocumentHeader{ format: result_unwrap(format), version: result_unwrap(version), language_version: result_unwrap(language_version), module: result_unwrap(module), source: result_unwrap(source), target: target, top_functions: after_functions.range, top_statements: after_statements.range }
    let completed: KIRTypedArena = typed_with_document(after_statements.arena, header)
    if !kir_typed_arena_references_valid(completed) { return err("validated KIR produced invalid typed arena references") }
    return ok(completed)
}

fn typed_view_empty_range(arena: KIRTypedArena) -> KIRIndexRange {
    return KIRIndexRange{ table: KIRTypedTable::KIRTableEdges, start: 0, count: 0 }
}

fn typed_view_null(arena: KIRTypedArena) -> KIRTypedNodeView {
    return KIRTypedNodeView{ arena: arena, mode: KIRTypedViewMode::KIRViewNull, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableDocument, index: 0, present: false }, range: typed_view_empty_range(arena), direct_table: KIRTypedTable::KIRTableDocument, direct_start: 0, direct_count: 0, strings: [], bytes: [], text: "", number_text: "", boolean: false }
}

fn typed_view_string(arena: KIRTypedArena, value: String) -> KIRTypedNodeView {
    return KIRTypedNodeView{ arena: arena, mode: KIRTypedViewMode::KIRViewString, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableDocument, index: 0, present: false }, range: typed_view_empty_range(arena), direct_table: KIRTypedTable::KIRTableDocument, direct_start: 0, direct_count: 0, strings: [], bytes: [], text: value, number_text: "", boolean: false }
}

fn typed_view_number(arena: KIRTypedArena, value: String) -> KIRTypedNodeView {
    return KIRTypedNodeView{ arena: arena, mode: KIRTypedViewMode::KIRViewNumber, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableDocument, index: 0, present: false }, range: typed_view_empty_range(arena), direct_table: KIRTypedTable::KIRTableDocument, direct_start: 0, direct_count: 0, strings: [], bytes: [], text: "", number_text: value, boolean: false }
}

fn typed_view_bool(arena: KIRTypedArena, value: Bool) -> KIRTypedNodeView {
    return KIRTypedNodeView{ arena: arena, mode: KIRTypedViewMode::KIRViewBool, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableDocument, index: 0, present: false }, range: typed_view_empty_range(arena), direct_table: KIRTypedTable::KIRTableDocument, direct_start: 0, direct_count: 0, strings: [], bytes: [], text: "", number_text: "", boolean: value }
}

fn typed_view_row(arena: KIRTypedArena, reference: KIRIndexRef) -> Result[KIRTypedNodeView, String] {
    if !reference.present { return ok(typed_view_null(arena)) }
    if !kir_typed_reference_valid(arena, reference) { return err("typed KIR view row reference is out of bounds") }
    return ok(KIRTypedNodeView{ arena: arena, mode: KIRTypedViewMode::KIRViewRow, reference: reference, range: typed_view_empty_range(arena), direct_table: KIRTypedTable::KIRTableDocument, direct_start: 0, direct_count: 0, strings: [], bytes: [], text: "", number_text: "", boolean: false })
}

fn typed_view_direct_rows(arena: KIRTypedArena, table: KIRTypedTable, count: Int) -> KIRTypedNodeView {
    return KIRTypedNodeView{ arena: arena, mode: KIRTypedViewMode::KIRViewTableRange, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableDocument, index: 0, present: false }, range: typed_view_empty_range(arena), direct_table: table, direct_start: 0, direct_count: count, strings: [], bytes: [], text: "", number_text: "", boolean: false }
}

fn typed_view_edges(arena: KIRTypedArena, range: KIRIndexRange, table: KIRTypedTable) -> Result[KIRTypedNodeView, String] {
    if !kir_typed_range_is(arena, range, table) { return err("typed KIR view edge range is invalid") }
    return ok(KIRTypedNodeView{ arena: arena, mode: KIRTypedViewMode::KIRViewEdgeRange, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableDocument, index: 0, present: false }, range: range, direct_table: KIRTypedTable::KIRTableDocument, direct_start: 0, direct_count: 0, strings: [], bytes: [], text: "", number_text: "", boolean: false })
}

fn typed_view_strings(arena: KIRTypedArena, values: Array[String]) -> KIRTypedNodeView {
    return KIRTypedNodeView{ arena: arena, mode: KIRTypedViewMode::KIRViewStrings, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableDocument, index: 0, present: false }, range: typed_view_empty_range(arena), direct_table: KIRTypedTable::KIRTableDocument, direct_start: 0, direct_count: 0, strings: values, bytes: [], text: "", number_text: "", boolean: false }
}

fn typed_view_bytes(arena: KIRTypedArena, values: Array[UInt8]) -> KIRTypedNodeView {
    return KIRTypedNodeView{ arena: arena, mode: KIRTypedViewMode::KIRViewBytes, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableDocument, index: 0, present: false }, range: typed_view_empty_range(arena), direct_table: KIRTypedTable::KIRTableDocument, direct_start: 0, direct_count: 0, strings: [], bytes: values, text: "", number_text: "", boolean: false }
}

pub fn kir_typed_root_view(arena: KIRTypedArena) -> KIRTypedNodeView {
    return KIRTypedNodeView{ arena: arena, mode: KIRTypedViewMode::KIRViewRow, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableDocument, index: 0, present: true }, range: typed_view_empty_range(arena), direct_table: KIRTypedTable::KIRTableDocument, direct_start: 0, direct_count: 0, strings: [], bytes: [], text: "", number_text: "", boolean: false }
}

pub fn kir_typed_empty_array() -> KIRTypedNodeView {
    return typed_view_strings(kir_typed_empty_arena(), [])
}

pub fn kir_typed_kind(value: KIRTypedNodeView) -> String {
    if value.mode == KIRTypedViewMode::KIRViewNull { return "null" }
    if value.mode == KIRTypedViewMode::KIRViewRow { return "object" }
    if value.mode == KIRTypedViewMode::KIRViewEdgeRange || value.mode == KIRTypedViewMode::KIRViewTableRange || value.mode == KIRTypedViewMode::KIRViewStrings || value.mode == KIRTypedViewMode::KIRViewBytes { return "array" }
    if value.mode == KIRTypedViewMode::KIRViewString { return "string" }
    if value.mode == KIRTypedViewMode::KIRViewNumber { return "number" }
    if value.mode == KIRTypedViewMode::KIRViewBool { return "bool" }
    return "invalid"
}

pub fn kir_typed_array_len(value: KIRTypedNodeView) -> Result[Int, String] {
    if value.mode == KIRTypedViewMode::KIRViewEdgeRange {
        if !kir_typed_range_valid(value.arena, value.range) { return err("typed KIR view edge range is out of bounds") }
        return ok(value.range.count)
    }
    if value.mode == KIRTypedViewMode::KIRViewTableRange {
        let table_len: Result[Int, String] = kir_typed_table_len(value.arena, value.direct_table)
        if is_err(table_len) || value.direct_start < 0 || value.direct_count < 0 || value.direct_start > result_unwrap(table_len) || value.direct_count > result_unwrap(table_len) - value.direct_start { return err("typed KIR view table range is out of bounds") }
        return ok(value.direct_count)
    }
    if value.mode == KIRTypedViewMode::KIRViewStrings { return ok(len(value.strings)) }
    if value.mode == KIRTypedViewMode::KIRViewBytes { return ok(len(value.bytes)) }
    return err("typed KIR view is not an array")
}

pub fn kir_typed_array_get(value: KIRTypedNodeView, index: Int) -> Result[KIRTypedNodeView, String] {
    let count: Result[Int, String] = kir_typed_array_len(value)
    if is_err(count) { return err(unwrap_or(result_error(count), "typed KIR view is not an array")) }
    if index < 0 || index >= result_unwrap(count) { return err("typed KIR view array index is out of bounds") }
    if value.mode == KIRTypedViewMode::KIRViewStrings { return ok(typed_view_string(value.arena, unwrap_or(array_get(value.strings, index), ""))) }
    if value.mode == KIRTypedViewMode::KIRViewBytes { return ok(typed_view_number(value.arena, str(unwrap_or(array_get(value.bytes, index), u8(0))))) }
    if value.mode == KIRTypedViewMode::KIRViewTableRange { return typed_view_row(value.arena, KIRIndexRef{ table: value.direct_table, index: value.direct_start + index, present: true }) }
    let edge_index: Int = value.range.start + index
    let edge: Option[KIRIndexRef] = array_get(value.arena.references.edges, edge_index)
    if is_none(edge) { return err("typed KIR view edge reference is missing") }
    return typed_view_row(value.arena, unwrap_or(edge, KIRIndexRef{ table: KIRTypedTable::KIRTableDocument, index: 0, present: false }))
}

pub fn kir_typed_string(value: KIRTypedNodeView) -> Result[String, String] {
    if value.mode != KIRTypedViewMode::KIRViewString { return err("typed KIR view value is not a string") }
    return ok(value.text)
}

pub fn kir_typed_int(value: KIRTypedNodeView) -> Result[Int, String] {
    if value.mode != KIRTypedViewMode::KIRViewNumber { return err("typed KIR view value is not a number") }
    if contains(value.number_text, ".") || contains(value.number_text, "e") || contains(value.number_text, "E") { return err("typed KIR view number is not an integer") }
    return ok(int(value.number_text))
}

pub fn kir_typed_uint(value: KIRTypedNodeView) -> Result[UInt64, String] {
    if value.mode != KIRTypedViewMode::KIRViewNumber { return err("typed KIR view value is not a number") }
    return typed_parse_uint_text(value.number_text)
}

pub fn kir_typed_bool(value: KIRTypedNodeView) -> Result[Bool, String] {
    if value.mode != KIRTypedViewMode::KIRViewBool { return err("typed KIR view value is not a Boolean") }
    return ok(value.boolean)
}

pub fn kir_typed_number_text(value: KIRTypedNodeView) -> String {
    if value.mode != KIRTypedViewMode::KIRViewNumber { return "" }
    return value.number_text
}

fn typed_view_string_field(arena: KIRTypedArena, value: String) -> Result[KIRTypedNodeView, String] { return ok(typed_view_string(arena, value)) }
fn typed_view_int_field(arena: KIRTypedArena, value: Int) -> Result[KIRTypedNodeView, String] { return ok(typed_view_number(arena, str(value))) }
fn typed_view_uint_field(arena: KIRTypedArena, value: UInt64) -> Result[KIRTypedNodeView, String] { return ok(typed_view_number(arena, str(value))) }
fn typed_view_float_field(arena: KIRTypedArena, number_text: String) -> Result[KIRTypedNodeView, String] {
    if number_text == "" { return ok(typed_view_number(arena, "0")) }
    if !kir_typed_float_text_valid(number_text) { return err("typed KIR Float payload has invalid or non-finite numeric text") }
    return ok(typed_view_number(arena, number_text))
}

fn typed_view_bool_field(arena: KIRTypedArena, value: Bool) -> Result[KIRTypedNodeView, String] { return ok(typed_view_bool(arena, value)) }
fn typed_view_reference_field(arena: KIRTypedArena, reference: KIRIndexRef) -> Result[KIRTypedNodeView, String] { return typed_view_row(arena, reference) }
fn typed_view_edge_field(arena: KIRTypedArena, range: KIRIndexRange, table: KIRTypedTable) -> Result[KIRTypedNodeView, String] { return typed_view_edges(arena, range, table) }

fn typed_view_root_field(arena: KIRTypedArena, key: String) -> Result[KIRTypedNodeView, String] {
    let declarations: KIRTypedDeclarations = arena.declarations
    if key == "format" { return typed_view_string_field(arena, arena.format) }
    if key == "version" { return typed_view_int_field(arena, arena.version) }
    if key == "language_version" { return typed_view_string_field(arena, arena.language_version) }
    if key == "module" { return typed_view_string_field(arena, arena.module) }
    if key == "source" { return typed_view_string_field(arena, arena.source) }
    if key == "target" { return typed_view_reference_field(arena, KIRIndexRef{ table: KIRTypedTable::KIRTableTarget, index: 0, present: true }) }
    if key == "imports" { return ok(typed_view_strings(arena, declarations.imports)) }
    if key == "import_records" { return ok(typed_view_direct_rows(arena, KIRTypedTable::KIRTableImportRecords, len(declarations.import_records))) }
    if key == "sources" { return ok(typed_view_strings(arena, declarations.sources)) }
    if key == "structs" { return ok(typed_view_direct_rows(arena, KIRTypedTable::KIRTableStructs, len(declarations.structs))) }
    if key == "enums" { return ok(typed_view_direct_rows(arena, KIRTypedTable::KIRTableEnums, len(declarations.enums))) }
    if key == "traits" { return ok(typed_view_direct_rows(arena, KIRTypedTable::KIRTableTraits, len(declarations.traits))) }
    if key == "trait_impls" { return ok(typed_view_direct_rows(arena, KIRTypedTable::KIRTableTraitImpls, len(declarations.trait_impls))) }
    if key == "functions" { return typed_view_edge_field(arena, arena.top_functions, KIRTypedTable::KIRTableFunctions) }
    if key == "statements" { return typed_view_edge_field(arena, arena.top_statements, KIRTypedTable::KIRTableStatements) }
    return err("typed KIR document has no field " + key)
}

fn typed_view_target_field(arena: KIRTypedArena, key: String) -> Result[KIRTypedNodeView, String] {
    if key == "os" { return typed_view_string_field(arena, arena.target.os) }
    if key == "arch" { return typed_view_string_field(arena, arena.target.arch) }
    if key == "gui" { return typed_view_bool_field(arena, arena.target.gui) }
    return err("typed KIR target has no field " + key)
}

