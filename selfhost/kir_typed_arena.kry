pub fn kir_typed_empty_expression() -> KIRTypedExpression {
    return KIRTypedExpression{ kind: "", source: "", line: 0, column: 0, span: KIRIndexRef{ table: KIRTypedTable::KIRTableSpans, index: 0, present: false }, type_name: "", constant: KIRIndexRef{ table: KIRTypedTable::KIRTableValues, index: 0, present: false }, int_value: 0, uint_value: u64(0), uint_bits: u8(0), float_text: "", bool_value: false, string_value: "", name: "", operator: "", call_target: "", trait_name: "", builtin_id: "", left: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, right: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, operand: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, args: kir_typed_empty_edges(), items: kir_typed_empty_edges(), base: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, field: "", receiver: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, map_keys: kir_typed_empty_edges(), struct_name: "", struct_type: "", generic_arguments: [], fields: [], values: kir_typed_empty_edges(), enum_type: "", enum_variant: "", tail: false, callee: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, lambda: KIRIndexRef{ table: KIRTypedTable::KIRTableFunctions, index: 0, present: false }, binding: KIRIndexRef{ table: KIRTypedTable::KIRTableBindings, index: 0, present: false } }
}

pub fn kir_typed_empty_statement() -> KIRTypedStatement {
    return KIRTypedStatement{ kind: "", source: "", line: 0, column: 0, span: KIRIndexRef{ table: KIRTypedTable::KIRTableSpans, index: 0, present: false }, name: "", binding: KIRIndexRef{ table: KIRTypedTable::KIRTableBindings, index: 0, present: false }, mutable: false, is_const: false, annotation: "", init: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, expr: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, target: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, value: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, cond: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, then_body: kir_typed_empty_edges(), else_body: kir_typed_empty_edges(), body: kir_typed_empty_edges(), iter: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, return_value: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, scrutinee: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, arms: kir_typed_empty_edges() }
}

pub fn kir_typed_empty_value() -> KIRTypedValue {
    return KIRTypedValue{ kind: "", int_value: 0, uint_value: u64(0), uint_bits: u8(0), float_text: "", bool_value: false, string_value: "", bytes: [], array: kir_typed_empty_edges(), inner: KIRIndexRef{ table: KIRTypedTable::KIRTableValues, index: 0, present: false }, present: false, ok: false }
}

fn typed_json_optional_field(value: Json, key: String) -> Result[Json, String] {
    return json_object_get(value, key)
}

fn typed_json_string_field(value: Json, key: String, fallback: String) -> Result[String, String] {
    let field: Result[Json, String] = typed_json_optional_field(value, key)
    if is_err(field) { return ok(fallback) }
    let item: Json = result_unwrap(field)
    if json_kind(item) == "null" { return ok(fallback) }
    return json_string(item)
}

fn typed_json_int_field(value: Json, key: String, fallback: Int) -> Result[Int, String] {
    let field: Result[Json, String] = typed_json_optional_field(value, key)
    if is_err(field) { return ok(fallback) }
    let item: Json = result_unwrap(field)
    if json_kind(item) == "null" { return ok(fallback) }
    return json_int(item)
}

fn typed_json_uint_field(value: Json, key: String, fallback: UInt64) -> Result[UInt64, String] {
    let field: Result[Json, String] = typed_json_optional_field(value, key)
    if is_err(field) { return ok(fallback) }
    let item: Json = result_unwrap(field)
    if json_kind(item) == "null" { return ok(fallback) }
    return json_uint(item)
}

// JSON numbers are retained exactly as portable text. This avoids depending on
// floating-point execution in the selfhost compiler while preserving Float IR.
fn typed_json_float_field(value: Json, key: String) -> Result[String, String] {
    let field: Result[Json, String] = typed_json_optional_field(value, key)
    if is_err(field) || json_kind(result_unwrap(field)) == "null" { return ok("") }
    if json_kind(result_unwrap(field)) != "number" { return err("typed KIR Float payload must be a number") }
    let text: String = json_stringify(result_unwrap(field))
    if !kir_typed_float_text_valid(text) { return err("typed KIR Float payload has invalid or non-finite numeric text") }
    return ok(text)
}

fn typed_json_bool_field(value: Json, key: String, fallback: Bool) -> Result[Bool, String] {
    let field: Result[Json, String] = typed_json_optional_field(value, key)
    if is_err(field) { return ok(fallback) }
    let item: Json = result_unwrap(field)
    if json_kind(item) == "null" { return ok(fallback) }
    return json_bool(item)
}

fn typed_json_string_array(value: Json) -> Result[Array[String], String] {
    if json_kind(value) == "null" {
        let empty: Array[String] = []
        return ok(empty)
    }
    if json_kind(value) != "array" { return err("validated KIR string list is not an array") }
    let count: Result[Int, String] = json_array_len(value)
    if is_err(count) { return err("validated KIR string list cannot be read") }
    let mut values: Array[String] = []
    let mut index: Int = 0
    while index < result_unwrap(count) {
        let child: Result[Json, String] = json_array_get(value, index)
        if is_err(child) { return err("validated KIR string list has a missing item") }
        let decoded: Result[String, String] = json_string(result_unwrap(child))
        if is_err(decoded) { return err("validated KIR string list contains a non-string") }
        values = array_push(values, result_unwrap(decoded))
        index = index + 1
    }
    return ok(values)
}

fn typed_json_span_object(arena: KIRTypedArena, span: Json) -> Result[KIRTypedBuildRef, String] {
    if json_kind(span) == "null" {
        return ok(KIRTypedBuildRef{ arena: arena, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableSpans, index: 0, present: false } })
    }
    if json_kind(span) != "object" { return err("validated KIR span is not an object") }
    let start: Result[Int, String] = typed_json_int_field(span, "start", -1)
    let end: Result[Int, String] = typed_json_int_field(span, "end", -1)
    if is_err(start) || is_err(end) || result_unwrap(start) < 0 || result_unwrap(end) < result_unwrap(start) { return err("validated KIR source span is malformed") }
    let references: KIRTypedReferences = arena.references
    let index: Int = len(references.spans)
    let updated: KIRTypedReferences = KIRTypedReferences{ spans: array_push(references.spans, KIRTypedSourceSpan{ start: result_unwrap(start), end: result_unwrap(end) }), edges: references.edges }
    return ok(KIRTypedBuildRef{ arena: typed_with_references(arena, updated), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableSpans, index: index, present: true } })
}

fn typed_json_span(arena: KIRTypedArena, node: Json) -> Result[KIRTypedBuildRef, String] {
    let field: Result[Json, String] = typed_json_optional_field(node, "span")
    if is_err(field) { return ok(KIRTypedBuildRef{ arena: arena, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableSpans, index: 0, present: false } }) }
    return typed_json_span_object(arena, result_unwrap(field))
}

fn typed_append_edge_range(arena: KIRTypedArena, references: Array[KIRIndexRef]) -> KIRTypedBuildRange {
    let table: KIRTypedReferences = arena.references
    let start: Int = len(table.edges)
    let mut edges: Array[KIRIndexRef] = table.edges
    let mut index: Int = 0
    while index < len(references) {
        edges = array_push(edges, unwrap_or(array_get(references, index), KIRIndexRef{ table: KIRTypedTable::KIRTableEdges, index: 0, present: false }))
        index = index + 1
    }
    let updated: KIRTypedReferences = KIRTypedReferences{ spans: table.spans, edges: edges }
    return KIRTypedBuildRange{ arena: typed_with_references(arena, updated), range: KIRIndexRange{ table: KIRTypedTable::KIRTableEdges, start: start, count: len(references) } }
}

fn typed_json_binding(arena: KIRTypedArena, node: Json) -> Result[KIRTypedBuildRef, String] {
    if json_kind(node) == "null" { return ok(KIRTypedBuildRef{ arena: arena, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableBindings, index: 0, present: false } }) }
    if json_kind(node) != "object" { return err("validated KIR binding is not an object") }
    let id: Result[String, String] = typed_json_string_field(node, "id", "")
    let name: Result[String, String] = typed_json_string_field(node, "name", "")
    let type_name: Result[String, String] = typed_json_string_field(node, "type", "")
    let mutable: Result[Bool, String] = typed_json_bool_field(node, "mutable", false)
    let source: Result[String, String] = typed_json_string_field(node, "source", "")
    let line: Result[Int, String] = typed_json_int_field(node, "line", 0)
    let column: Result[Int, String] = typed_json_int_field(node, "column", 0)
    if is_err(id) || is_err(name) || is_err(type_name) || is_err(mutable) || is_err(source) || is_err(line) || is_err(column) { return err("validated KIR binding has an invalid scalar field") }
    let span: Result[KIRTypedBuildRef, String] = typed_json_span(arena, node)
    if is_err(span) { return err(unwrap_or(result_error(span), "invalid binding span")) }
    let after_span: KIRTypedBuildRef = result_unwrap(span)
    let executable: KIRTypedExecutable = after_span.arena.executable
    let index: Int = len(executable.bindings)
    let row: KIRTypedBinding = KIRTypedBinding{ id: result_unwrap(id), name: result_unwrap(name), type_name: result_unwrap(type_name), mutable: result_unwrap(mutable), source: result_unwrap(source), line: result_unwrap(line), column: result_unwrap(column), span: after_span.reference }
    let updated: KIRTypedExecutable = KIRTypedExecutable{ functions: executable.functions, parameters: executable.parameters, captures: executable.captures, bindings: array_push(executable.bindings, row), expressions: executable.expressions, statements: executable.statements, arms: executable.arms, patterns: executable.patterns }
    return ok(KIRTypedBuildRef{ arena: typed_with_executable(after_span.arena, updated), reference: KIRIndexRef{ table: KIRTypedTable::KIRTableBindings, index: index, present: true } })
}

fn typed_empty_range(arena: KIRTypedArena) -> KIRTypedBuildRange {
    return KIRTypedBuildRange{ arena: arena, range: KIRIndexRange{ table: KIRTypedTable::KIRTableEdges, start: len(arena.references.edges), count: 0 } }
}

fn typed_json_expression_ref(arena: KIRTypedArena, node: Json, key: String) -> Result[KIRTypedBuildRef, String] {
    let field: Result[Json, String] = typed_json_optional_field(node, key)
    if is_err(field) || json_kind(result_unwrap(field)) == "null" {
        return ok(KIRTypedBuildRef{ arena: arena, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false } })
    }
    return typed_json_expression(arena, result_unwrap(field))
}

fn typed_json_value_ref(arena: KIRTypedArena, node: Json, key: String) -> Result[KIRTypedBuildRef, String] {
    let field: Result[Json, String] = typed_json_optional_field(node, key)
    if is_err(field) || json_kind(result_unwrap(field)) == "null" {
        return ok(KIRTypedBuildRef{ arena: arena, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableValues, index: 0, present: false } })
    }
    return typed_json_value(arena, result_unwrap(field))
}

fn typed_json_expression_range(arena: KIRTypedArena, node: Json, key: String) -> Result[KIRTypedBuildRange, String] {
    let field: Result[Json, String] = typed_json_optional_field(node, key)
    if is_err(field) || json_kind(result_unwrap(field)) == "null" { return ok(typed_empty_range(arena)) }
    let list: Json = result_unwrap(field)
    if json_kind(list) != "array" { return err("validated KIR expression list is not an array") }
    let count: Result[Int, String] = json_array_len(list)
    if is_err(count) { return err("validated KIR expression list cannot be read") }
    let mut current: KIRTypedArena = arena
    let mut edges: Array[KIRIndexRef] = []
    let mut index: Int = 0
    while index < result_unwrap(count) {
        let child: Result[Json, String] = json_array_get(list, index)
        if is_err(child) { return err("validated KIR expression list has a missing item") }
        let built: Result[KIRTypedBuildRef, String] = typed_json_expression(current, result_unwrap(child))
        if is_err(built) { return err(unwrap_or(result_error(built), "invalid KIR expression list item")) }
        let item: KIRTypedBuildRef = result_unwrap(built)
        current = item.arena
        edges = array_push(edges, item.reference)
        index = index + 1
    }
    return ok(typed_append_edge_range(current, edges))
}

fn typed_json_value_range(arena: KIRTypedArena, node: Json, key: String) -> Result[KIRTypedBuildRange, String] {
    let field: Result[Json, String] = typed_json_optional_field(node, key)
    if is_err(field) || json_kind(result_unwrap(field)) == "null" { return ok(typed_empty_range(arena)) }
    let list: Json = result_unwrap(field)
    if json_kind(list) != "array" { return err("validated KIR value list is not an array") }
    let count: Result[Int, String] = json_array_len(list)
    if is_err(count) { return err("validated KIR value list cannot be read") }
    let mut current: KIRTypedArena = arena
    let mut edges: Array[KIRIndexRef] = []
    let mut index: Int = 0
    while index < result_unwrap(count) {
        let child: Result[Json, String] = json_array_get(list, index)
        if is_err(child) { return err("validated KIR value list has a missing item") }
        let built: Result[KIRTypedBuildRef, String] = typed_json_value(current, result_unwrap(child))
        if is_err(built) { return err(unwrap_or(result_error(built), "invalid KIR value list item")) }
        let item: KIRTypedBuildRef = result_unwrap(built)
        current = item.arena
        edges = array_push(edges, item.reference)
        index = index + 1
    }
    return ok(typed_append_edge_range(current, edges))
}


fn typed_json_bytes(node: Json, key: String) -> Result[Array[UInt8], String] {
    let field: Result[Json, String] = typed_json_optional_field(node, key)
    if is_err(field) || json_kind(result_unwrap(field)) == "null" {
        let empty: Array[UInt8] = []
        return ok(empty)
    }
    let list: Json = result_unwrap(field)
    if json_kind(list) == "string" { return typed_decode_base64(result_unwrap(json_string(list))) }
    if json_kind(list) != "array" { return err("portable KIR bytes must be base64 text or a byte array") }
    let count: Result[Int, String] = json_array_len(list)
    if is_err(count) { return err("validated KIR byte list cannot be read") }
    let mut values: Array[UInt8] = []
    let mut index: Int = 0
    while index < result_unwrap(count) {
        let child: Result[Json, String] = json_array_get(list, index)
        if is_err(child) { return err("validated KIR byte list has a missing item") }
        let byte: Result[Int, String] = json_int(result_unwrap(child))
        if is_err(byte) || result_unwrap(byte) < 0 || result_unwrap(byte) > 255 { return err("validated KIR byte is outside the UInt8 range") }
        values = array_push(values, u8(result_unwrap(byte)))
        index = index + 1
    }
    return ok(values)
}

fn typed_json_value(arena: KIRTypedArena, node: Json) -> Result[KIRTypedBuildRef, String] {
    if json_kind(node) != "object" { return err("validated KIR value is not an object") }
    let kind: Result[String, String] = typed_json_string_field(node, "kind", "")
    let int_value: Result[Int, String] = typed_json_int_field(node, "int", 0)
    let uint_value: Result[UInt64, String] = typed_json_uint_field(node, "uint", u64(0))
    let uint_bits_value: Result[Int, String] = typed_json_int_field(node, "uint_bits", 0)
    if is_err(uint_bits_value) || result_unwrap(uint_bits_value) < 0 || result_unwrap(uint_bits_value) > 255 { return err("portable KIR UInt width is outside the UInt8 storage range") }
    let float_text: Result[String, String] = typed_json_float_field(node, "float")
    let bool_value: Result[Bool, String] = typed_json_bool_field(node, "bool", false)
    let string_value: Result[String, String] = typed_json_string_field(node, "string", "")
    let present: Result[Bool, String] = typed_json_bool_field(node, "present", false)
    let ok_value: Result[Bool, String] = typed_json_bool_field(node, "ok", false)
    if is_err(kind) || is_err(int_value) || is_err(uint_value) || is_err(uint_bits_value) || is_err(float_text) || is_err(bool_value) || is_err(string_value) || is_err(present) || is_err(ok_value) { return err("validated KIR value has an invalid scalar field") }
    let bytes: Result[Array[UInt8], String] = typed_json_bytes(node, "bytes")
    if is_err(bytes) { return err(unwrap_or(result_error(bytes), "invalid KIR bytes")) }
    let array: Result[KIRTypedBuildRange, String] = typed_json_value_range(arena, node, "array")
    if is_err(array) { return err(unwrap_or(result_error(array), "invalid KIR value array")) }
    let array_value: KIRTypedBuildRange = result_unwrap(array)
    let inner: Result[KIRTypedBuildRef, String] = typed_json_value_ref(array_value.arena, node, "inner")
    if is_err(inner) { return err(unwrap_or(result_error(inner), "invalid KIR inner value")) }
    let after_inner: KIRTypedBuildRef = result_unwrap(inner)
    let row: KIRTypedValue = KIRTypedValue{ kind: result_unwrap(kind), int_value: result_unwrap(int_value), uint_value: result_unwrap(uint_value), uint_bits: u8(result_unwrap(uint_bits_value)), float_text: result_unwrap(float_text), bool_value: result_unwrap(bool_value), string_value: result_unwrap(string_value), bytes: result_unwrap(bytes), array: array_value.range, inner: after_inner.reference, present: result_unwrap(present), ok: result_unwrap(ok_value) }
    let index: Int = len(after_inner.arena.values)
    let updated: KIRTypedArena = typed_with_values(after_inner.arena, array_push(after_inner.arena.values, row))
    return ok(KIRTypedBuildRef{ arena: updated, reference: KIRIndexRef{ table: KIRTypedTable::KIRTableValues, index: index, present: true } })
}

fn typed_json_expression(arena: KIRTypedArena, node: Json) -> Result[KIRTypedBuildRef, String] {
