    if key == "call_target" { return typed_view_string_field(arena, row.call_target) }
    if key == "trait_name" { return typed_view_string_field(arena, row.trait_name) }
    if key == "builtin_id" { return typed_view_string_field(arena, row.builtin_id) }
    if key == "left" { return typed_view_reference_field(arena, row.left) }
    if key == "right" { return typed_view_reference_field(arena, row.right) }
    if key == "operand" { return typed_view_reference_field(arena, row.operand) }
    if key == "args" { return typed_view_edge_field(arena, row.args, KIRTypedTable::KIRTableExpressions) }
    if key == "items" { return typed_view_edge_field(arena, row.items, KIRTypedTable::KIRTableExpressions) }
    if key == "base" { return typed_view_reference_field(arena, row.base) }
    if key == "field" { return typed_view_string_field(arena, row.field) }
    if key == "receiver" { return typed_view_reference_field(arena, row.receiver) }
    if key == "map_keys" { return typed_view_edge_field(arena, row.map_keys, KIRTypedTable::KIRTableExpressions) }
    if key == "struct_name" { return typed_view_string_field(arena, row.struct_name) }
    if key == "struct_type" { return typed_view_string_field(arena, row.struct_type) }
    if key == "generic_arguments" { return ok(typed_view_strings(arena, row.generic_arguments)) }
    if key == "fields" { return ok(typed_view_strings(arena, row.fields)) }
    if key == "values" { return typed_view_edge_field(arena, row.values, KIRTypedTable::KIRTableExpressions) }
    if key == "enum_type" { return typed_view_string_field(arena, row.enum_type) }
    if key == "enum_variant" { return typed_view_string_field(arena, row.enum_variant) }
    if key == "tail" { return typed_view_bool_field(arena, row.tail) }
    if key == "callee" { return typed_view_reference_field(arena, row.callee) }
    if key == "lambda" { return typed_view_reference_field(arena, row.lambda) }
    if key == "binding" { return typed_view_reference_field(arena, row.binding) }
    return err("typed KIR expression has no field " + key)
}

fn typed_view_statement_field(arena: KIRTypedArena, row_index: Int, key: String) -> Result[KIRTypedNodeView, String] {
    let rows: Array[KIRTypedStatement] = arena.executable.statements
    let row_option: Option[KIRTypedStatement] = array_get(rows, row_index)
    if is_none(row_option) { return err("typed KIR statement row is out of bounds") }
    let row: KIRTypedStatement = unwrap_or(row_option, KIRTypedStatement{ kind: "", source: "", line: 0, column: 0, span: KIRIndexRef{ table: KIRTypedTable::KIRTableSpans, index: 0, present: false }, name: "", binding: KIRIndexRef{ table: KIRTypedTable::KIRTableBindings, index: 0, present: false }, mutable: false, is_const: false, annotation: "", init: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, expr: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, target: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, value: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, cond: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, then_body: typed_view_empty_range(arena), else_body: typed_view_empty_range(arena), body: typed_view_empty_range(arena), iter: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, return_value: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, scrutinee: KIRIndexRef{ table: KIRTypedTable::KIRTableExpressions, index: 0, present: false }, arms: typed_view_empty_range(arena) })
    if key == "kind" { return typed_view_string_field(arena, row.kind) }
    if key == "source" { return typed_view_string_field(arena, row.source) }
    if key == "line" { return typed_view_int_field(arena, row.line) }
    if key == "column" { return typed_view_int_field(arena, row.column) }
    if key == "span" { return typed_view_reference_field(arena, row.span) }
    if key == "name" { return typed_view_string_field(arena, row.name) }
    if key == "binding" { return typed_view_reference_field(arena, row.binding) }
    if key == "mutable" { return typed_view_bool_field(arena, row.mutable) }
    if key == "const" { return typed_view_bool_field(arena, row.is_const) }
    if key == "annotation" { return typed_view_string_field(arena, row.annotation) }
    if key == "init" { return typed_view_reference_field(arena, row.init) }
    if key == "expr" { return typed_view_reference_field(arena, row.expr) }
    if key == "target" { return typed_view_reference_field(arena, row.target) }
    if key == "value" { return typed_view_reference_field(arena, row.value) }
    if key == "cond" { return typed_view_reference_field(arena, row.cond) }
    if key == "then" { return typed_view_edge_field(arena, row.then_body, KIRTypedTable::KIRTableStatements) }
    if key == "else" { return typed_view_edge_field(arena, row.else_body, KIRTypedTable::KIRTableStatements) }
    if key == "body" { return typed_view_edge_field(arena, row.body, KIRTypedTable::KIRTableStatements) }
    if key == "iter" { return typed_view_reference_field(arena, row.iter) }
    if key == "return" { return typed_view_reference_field(arena, row.return_value) }
    if key == "scrutinee" { return typed_view_reference_field(arena, row.scrutinee) }
    if key == "arms" { return typed_view_edge_field(arena, row.arms, KIRTypedTable::KIRTableArms) }
    return err("typed KIR statement has no field " + key)
}

fn typed_view_arm_field(arena: KIRTypedArena, row_index: Int, key: String) -> Result[KIRTypedNodeView, String] {
    let rows: Array[KIRTypedArm] = arena.executable.arms
    let row_option: Option[KIRTypedArm] = array_get(rows, row_index)
    if is_none(row_option) { return err("typed KIR match arm row is out of bounds") }
    let row: KIRTypedArm = unwrap_or(row_option, KIRTypedArm{ source: "", line: 0, column: 0, span: KIRIndexRef{ table: KIRTypedTable::KIRTableSpans, index: 0, present: false }, pattern: KIRIndexRef{ table: KIRTypedTable::KIRTablePatterns, index: 0, present: false }, body: typed_view_empty_range(arena) })
    if key == "source" { return typed_view_string_field(arena, row.source) }
    if key == "line" { return typed_view_int_field(arena, row.line) }
    if key == "column" { return typed_view_int_field(arena, row.column) }
    if key == "span" { return typed_view_reference_field(arena, row.span) }
    if key == "pattern" { return typed_view_reference_field(arena, row.pattern) }
    if key == "body" { return typed_view_edge_field(arena, row.body, KIRTypedTable::KIRTableStatements) }
    return err("typed KIR match arm has no field " + key)
}

fn typed_view_pattern_field(arena: KIRTypedArena, row_index: Int, key: String) -> Result[KIRTypedNodeView, String] {
    let rows: Array[KIRTypedPattern] = arena.executable.patterns
    let row_option: Option[KIRTypedPattern] = array_get(rows, row_index)
    if is_none(row_option) { return err("typed KIR pattern row is out of bounds") }
    let row: KIRTypedPattern = unwrap_or(row_option, KIRTypedPattern{ kind: "", source: "", line: 0, column: 0, span: KIRIndexRef{ table: KIRTypedTable::KIRTableSpans, index: 0, present: false }, bool_value: false, int_value: 0, string_value: "", type_name: "", variant: "", binding_name: "", present: false, ok: false, resolved_binding: KIRIndexRef{ table: KIRTypedTable::KIRTableBindings, index: 0, present: false } })
    if key == "kind" { return typed_view_string_field(arena, row.kind) }
    if key == "source" { return typed_view_string_field(arena, row.source) }
    if key == "line" { return typed_view_int_field(arena, row.line) }
    if key == "column" { return typed_view_int_field(arena, row.column) }
    if key == "span" { return typed_view_reference_field(arena, row.span) }
    if key == "bool" { return typed_view_bool_field(arena, row.bool_value) }
    if key == "int" { return typed_view_int_field(arena, row.int_value) }
    if key == "string" { return typed_view_string_field(arena, row.string_value) }
    if key == "type" { return typed_view_string_field(arena, row.type_name) }
    if key == "variant" { return typed_view_string_field(arena, row.variant) }
    if key == "binding" { return typed_view_string_field(arena, row.binding_name) }
    if key == "present" { return typed_view_bool_field(arena, row.present) }
    if key == "ok" { return typed_view_bool_field(arena, row.ok) }
    if key == "resolved_binding" { return typed_view_reference_field(arena, row.resolved_binding) }
    return err("typed KIR pattern has no field " + key)
}

fn typed_view_value_field(arena: KIRTypedArena, row_index: Int, key: String) -> Result[KIRTypedNodeView, String] {
    let row_option: Option[KIRTypedValue] = array_get(arena.values, row_index)
    if is_none(row_option) { return err("typed KIR value row is out of bounds") }
    let row: KIRTypedValue = unwrap_or(row_option, KIRTypedValue{ kind: "", int_value: 0, uint_value: u64(0), uint_bits: u8(0), float_value: 0.0, float_text: "", bool_value: false, string_value: "", bytes: [], array: typed_view_empty_range(arena), inner: KIRIndexRef{ table: KIRTypedTable::KIRTableValues, index: 0, present: false }, present: false, ok: false })
    if key == "kind" { return typed_view_string_field(arena, row.kind) }
    if key == "int" { return typed_view_int_field(arena, row.int_value) }
    if key == "uint" { return typed_view_uint_field(arena, row.uint_value) }
    if key == "uint_bits" { return typed_view_int_field(arena, int(row.uint_bits)) }
    if key == "float" { return typed_view_float_field(arena, row.float_value, row.float_text) }
    if key == "bool" { return typed_view_bool_field(arena, row.bool_value) }
    if key == "string" { return typed_view_string_field(arena, row.string_value) }
    if key == "bytes" { return ok(typed_view_bytes(arena, row.bytes)) }
    if key == "array" { return typed_view_edge_field(arena, row.array, KIRTypedTable::KIRTableValues) }
    if key == "inner" { return typed_view_reference_field(arena, row.inner) }
    if key == "present" { return typed_view_bool_field(arena, row.present) }
    if key == "ok" { return typed_view_bool_field(arena, row.ok) }
    return err("typed KIR value has no field " + key)
}

fn typed_view_row_field(arena: KIRTypedArena, reference: KIRIndexRef, key: String) -> Result[KIRTypedNodeView, String] {
    if !kir_typed_reference_valid(arena, reference) { return err("typed KIR view reference is invalid") }
    if reference.table == KIRTypedTable::KIRTableDocument { return typed_view_root_field(arena, key) }
    if reference.table == KIRTypedTable::KIRTableTarget { return typed_view_target_field(arena, key) }
    if reference.table == KIRTypedTable::KIRTableSpans { return typed_view_span_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableImportRecords { return typed_view_import_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableTypeParams { return typed_view_type_param_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableBindings { return typed_view_binding_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableFields { return typed_view_field_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableStructs { return typed_view_struct_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableEnums { return typed_view_enum_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableTraitMethods { return typed_view_trait_method_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableTraits { return typed_view_trait_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableTraitImplMethods { return typed_view_trait_impl_method_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableTraitImpls { return typed_view_trait_impl_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableParameters { return typed_view_parameter_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableCaptures { return typed_view_capture_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableFunctions { return typed_view_function_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableExpressions { return typed_view_expression_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableStatements { return typed_view_statement_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableArms { return typed_view_arm_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTablePatterns { return typed_view_pattern_field(arena, reference.index, key) }
    if reference.table == KIRTypedTable::KIRTableValues { return typed_view_value_field(arena, reference.index, key) }
    return err("typed KIR view reference does not identify an object row")
}

pub fn kir_typed_object_get(value: KIRTypedNodeView, key: String) -> Result[KIRTypedNodeView, String] {
    if value.mode != KIRTypedViewMode::KIRViewRow { return err("typed KIR view value is not an object") }
    return typed_view_row_field(value.arena, value.reference, key)
}
