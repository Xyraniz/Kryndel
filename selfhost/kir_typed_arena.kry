    let after_items: KIRTypedBuildRange = result_unwrap(items)
    let base: Result[KIRTypedBuildRef, String] = typed_json_expression_ref(after_items.arena, node, "base")
    if is_err(base) { return err(unwrap_or(result_error(base), "invalid expression base")) }
