fn emit_u8_array_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, host_u8_array_label(state))
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind host u8_array runtime")) }
    // rdi=Bytes. Convert the immutable {length, bytes[]} object into a fresh
    // Array[UInt8] with the ordinary qword-per-element array ABI.
    let mut current: EmitState = append_code(result_unwrap(bound), [
        u8(83), u8(85), u8(65), u8(84), u8(65), u8(85), u8(65), u8(86), u8(65), u8(87),
        u8(73), u8(137), u8(252), u8(73), u8(139), u8(44), u8(36),
        u8(72), u8(137), u8(239)
    ])
    current = state_with_array_used(current)
    current = emit_label_call(current, current.assembler.array_alloc_label)
    current = append_code(current, [u8(73), u8(137), u8(198), u8(69), u8(49), u8(255)])
    let loop_label: LabelState = new_label(current)
    let done_label: LabelState = new_label(loop_label.state)
    let bound_loop: Result[EmitState, String] = bind_label(done_label.state, loop_label.label)
    if is_err(bound_loop) { return err(unwrap_or(result_error(bound_loop), "dynamic backend: cannot bind u8_array loop")) }
    current = append_code(result_unwrap(bound_loop), [u8(76), u8(137), u8(248), u8(72), u8(57), u8(232)])
    current = emit_jump(current, done_label.label, true, u8(131))
    current = append_code(current, [
        u8(76), u8(137), u8(250), u8(72), u8(193), u8(226), u8(3), u8(76), u8(1), u8(242),
        u8(72), u8(131), u8(194), u8(8), u8(75), u8(15), u8(182), u8(68), u8(60), u8(8),
        u8(72), u8(137), u8(2), u8(73), u8(255), u8(199)
    ])
    current = emit_jump(current, loop_label.label, false, u8(0))
    let bound_done: Result[EmitState, String] = bind_label(current, done_label.label)
    if is_err(bound_done) { return err(unwrap_or(result_error(bound_done), "dynamic backend: cannot bind u8_array completion")) }
    return ok(append_code(result_unwrap(bound_done), [u8(76), u8(137), u8(240), u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92), u8(93), u8(91), u8(195)]))
}

fn emit_array_set_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, host_array_set_label(state))
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind array_set runtime")) }
    let failure: LabelState = new_label(result_unwrap(bound))
    let mut current: EmitState = append_code(failure.state, [
        u8(83), u8(85), u8(65), u8(84), u8(65), u8(85), u8(65), u8(86), u8(65), u8(87),
        u8(73), u8(137), u8(252), u8(73), u8(137), u8(245), u8(73), u8(137), u8(214),
        u8(73), u8(139), u8(44), u8(36), u8(77), u8(133), u8(237)
    ])
    current = emit_jump(current, failure.label, true, u8(136))
    current = append_code(current, [u8(73), u8(57), u8(237)])
    current = emit_jump(current, failure.label, true, u8(131))
    current = append_code(current, [u8(72), u8(137), u8(239)])
    current = emit_label_call(current, current.assembler.array_alloc_label)
    let array_value: LabelState = new_label(current)
    let copy_done: LabelState = new_label(array_value.state)
    current = append_code(copy_done.state, [
        u8(73), u8(137), u8(199), u8(76), u8(137), u8(230), u8(76), u8(137), u8(255),
        u8(72), u8(137), u8(233), u8(72), u8(255), u8(193), u8(243), u8(72), u8(165),
        u8(76), u8(137), u8(232), u8(72), u8(193), u8(224), u8(3), u8(76), u8(1), u8(248),
        u8(72), u8(131), u8(192), u8(8), u8(76), u8(137), u8(48)
    ])
    current = emit_jump(current, copy_done.label, false, u8(0))
    let bound_copy: Result[EmitState, String] = bind_label(current, copy_done.label)
    if is_err(bound_copy) { return err(unwrap_or(result_error(bound_copy), "dynamic backend: cannot bind array_set copy completion")) }
    current = append_code(result_unwrap(bound_copy), [u8(76), u8(137), u8(248)])
    current = emit_box_call(current, u64(0))
    current = append_code(current, [u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92), u8(93), u8(91), u8(195)])
    let bound_failure: Result[EmitState, String] = bind_label(current, failure.label)
    if is_err(bound_failure) { return err(unwrap_or(result_error(bound_failure), "dynamic backend: cannot bind array_set failure")) }
    current = emit_string(result_unwrap(bound_failure), "array index out of range")
    current = emit_box_call(current, u64(1))
    return ok(append_code(current, [u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(91), u8(195)]))
}

fn emit_array_slice_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, host_array_slice_label(state))
