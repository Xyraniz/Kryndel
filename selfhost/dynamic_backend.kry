        u8(76), u8(1), u8(199), u8(76), u8(137), u8(206), u8(76), u8(41), u8(198)
    ])
    current = emit_label_call(current, host_string_alloc_label(current))
    current = emit_box_call(current, u64(0))
    current = emit_jump(current, done.label, false, u8(0))
    let bound_negative: Result[EmitState, String] = bind_label(current, negative_error.label)
    if is_err(bound_negative) { return err(unwrap_or(result_error(bound_negative), "dynamic backend: cannot bind substring negative error")) }
    current = emit_string(result_unwrap(bound_negative), "substring range is out of bounds")
    current = emit_box_call(current, u64(1))
