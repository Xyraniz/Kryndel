fn state_with_windows_stack_depth(state: EmitState, depth: Int) -> EmitState {
    let a: Assembler = state.assembler
    let updated: Assembler = Assembler{ code_state: a.code_state, labels: a.labels, next_label: a.next_label, jumps: a.jumps, common: AssemblerCommon{ data: a.common.data, data_by_text: a.common.data_by_text, string_data_by_text: a.common.string_data_by_text, data_patches: a.common.data_patches, frame_patch: a.common.frame_patch, string_concat_label: a.common.string_concat_label, string_concat_used: a.common.string_concat_used, array_alloc_label: a.common.array_alloc_label, array_push_label: a.common.array_push_label, array_concat_label: a.common.array_concat_label, array_runtime_used: a.common.array_runtime_used, box_alloc_label: a.common.box_alloc_label, box_runtime_used: a.common.box_runtime_used, host_runtime_used: a.common.host_runtime_used, ffi_runtime_used: a.common.ffi_runtime_used, windows_abi: a.common.windows_abi, windows_stack_depth: depth, import_patches: a.common.import_patches, function_ranges: a.common.function_ranges } }
    return EmitState{ assembler: updated, env: state.env, code_patches: state.code_patches, code_pages: state.code_pages }
