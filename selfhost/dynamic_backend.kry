fn emit_json_literal(state: EmitState, bytes: Array[Int], failure: Int) -> EmitState {
    let mut current: EmitState = state
    for byte in bytes { current = emit_json_expect_byte(current, byte, failure) }
    return current
}

fn emit_json_skip_ws_inline(state: EmitState) -> Result[EmitState, String] {
    let loop_label: LabelState = new_label(state)
    let next_label: LabelState = new_label(loop_label.state)
    let done_label: LabelState = new_label(next_label.state)
    let mut current: EmitState = emit_jump(done_label.state, loop_label.label, false, u8(0))
    let bound_loop: Result[EmitState, String] = bind_label(current, loop_label.label)
    if is_err(bound_loop) { return err(unwrap_or(result_error(bound_loop), "dynamic backend: cannot bind JSON whitespace scan")) }
    current = append_code(result_unwrap(bound_loop), [u8(77), u8(57), u8(238)])
    current = emit_jump(current, done_label.label, true, u8(131))
    current = append_code(current, [u8(75), u8(15), u8(182), u8(68), u8(52), u8(8), u8(60), u8(32)])
    current = emit_jump(current, next_label.label, true, u8(132))
    current = append_code(current, [u8(60), u8(9)])
    current = emit_jump(current, next_label.label, true, u8(132))
    current = append_code(current, [u8(60), u8(10)])
    current = emit_jump(current, next_label.label, true, u8(132))
    current = append_code(current, [u8(60), u8(13)])
    current = emit_jump(current, next_label.label, true, u8(132))
    current = emit_jump(current, done_label.label, false, u8(0))
    let bound_next: Result[EmitState, String] = bind_label(current, next_label.label)
    if is_err(bound_next) { return err(unwrap_or(result_error(bound_next), "dynamic backend: cannot bind JSON whitespace advance")) }
    current = append_code(result_unwrap(bound_next), [u8(73), u8(255), u8(198)])
    current = emit_jump(current, loop_label.label, false, u8(0))
    let bound_done: Result[EmitState, String] = bind_label(current, done_label.label)
    if is_err(bound_done) { return err(unwrap_or(result_error(bound_done), "dynamic backend: cannot bind JSON whitespace completion")) }
    return ok(result_unwrap(bound_done))
}

