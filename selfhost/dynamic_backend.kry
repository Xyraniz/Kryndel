    if is_err(bound_done) { return err(unwrap_or(result_error(bound_done), "dynamic backend: cannot bind map lookup completion")) }
    return ok(append_code(result_unwrap(bound_done), [u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92), u8(93), u8(91), u8(195)]))
