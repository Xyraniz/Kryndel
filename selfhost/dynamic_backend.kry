import "elf_backend"

// Dynamic KIR lowering. This module is the Kryndel implementation of the
// second direct-ELF slice: stack slots, Int/Bool expressions, comparisons,
// assignments, if/else, while, break/continue, and static print values.
// Arrays remain immutable; labels and RIP-relative data references are
// patched with array_set only after all code has been emitted.

struct JumpPatch {
    label: Int,
    position: Int,
}

struct DataPatch {
    displacement: Int,
    instruction_end: Int,
    data_offset: Int,
}

struct Assembler {
    code: Array[UInt8],
    data: Array[UInt8],
    data_by_text: Map[String, Int],
    string_data_by_text: Map[String, Int],
    labels: Array[Int],
    jumps: Array[JumpPatch],
    data_patches: Array[DataPatch],
    frame_patch: Int,
    string_concat_label: Int,
    string_concat_used: Bool,
    array_alloc_label: Int,
    array_push_label: Int,
    array_concat_label: Int,
    array_runtime_used: Bool,
    box_alloc_label: Int,
    box_runtime_used: Bool,
}

struct CompileEnv {
    slots: Map[String, Int],
    static_values: Map[String, String],
    function_labels: Map[String, Int],
    function_returns: Map[String, String],
    next_slot: Int,
    breaks: Array[Int],
    continues: Array[Int],
    end_label: Int,
    trap_label: Int,
    buffer_offset: Int,
    in_function: Bool,
    current_function: String,
}

struct EmitState {
    assembler: Assembler,
    env: CompileEnv,
}

struct LabelState {
    state: EmitState,
    label: Int,
}

fn field(value: Json, key: String) -> Json {
    return result_unwrap(json_object_get(value, key))
}

fn text(value: Json) -> String {
    return result_unwrap(json_string(value))
}

fn i32_bytes(value: Int) -> Array[UInt8] {
    let mut raw: UInt32 = u32(0)
    if value >= 0 {
        raw = u32(value)
    } else {
        raw = u32(4294967296 + value)
    }
    return [
        u8(raw & u32(255)),
        u8((raw >> 8) & u32(255)),
        u8((raw >> 16) & u32(255)),
        u8(raw >> 24)
    ]
}

fn int_u64(value: Int) -> UInt64 {
    if value >= 0 {
        return u64(value)
    }
    return u64(0) - u64(0 - value)
}

fn dyn_u16_bytes(value: UInt16) -> Array[UInt8] {
    return [u8(value & u16(255)), u8(value >> 8)]
}

fn dyn_u32_bytes(value: UInt32) -> Array[UInt8] {
    return [
        u8(value & u32(255)),
        u8((value >> 8) & u32(255)),
        u8((value >> 16) & u32(255)),
        u8(value >> 24)
    ]
}

fn dyn_u64_bytes(value: UInt64) -> Array[UInt8] {
    return [
        u8(value & u64(255)),
        u8((value >> 8) & u64(255)),
        u8((value >> 16) & u64(255)),
        u8((value >> 24) & u64(255)),
        u8((value >> 32) & u64(255)),
        u8((value >> 40) & u64(255)),
        u8((value >> 48) & u64(255)),
        u8(value >> 56)
    ]
}

fn state_with_code(state: EmitState, code: Array[UInt8]) -> EmitState {
    return EmitState{
        assembler: Assembler{ code: code, data: state.assembler.data, data_by_text: state.assembler.data_by_text, string_data_by_text: state.assembler.string_data_by_text, labels: state.assembler.labels, jumps: state.assembler.jumps, data_patches: state.assembler.data_patches, frame_patch: state.assembler.frame_patch, string_concat_label: state.assembler.string_concat_label, string_concat_used: state.assembler.string_concat_used, array_alloc_label: state.assembler.array_alloc_label, array_push_label: state.assembler.array_push_label, array_concat_label: state.assembler.array_concat_label, array_runtime_used: state.assembler.array_runtime_used, box_alloc_label: state.assembler.box_alloc_label, box_runtime_used: state.assembler.box_runtime_used },
        env: state.env,
    }
}

