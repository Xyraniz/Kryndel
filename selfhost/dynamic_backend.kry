    let second: Result[EmitState, String] = emit_expression(pushed, result_unwrap(kir_typed_array_get(arguments, 1)))
    if is_err(second) { return err(expression_error(second)) }
    let mut current: EmitState = append_code(result_unwrap(second), [u8(72), u8(137), u8(198), u8(95), u8(72), u8(133), u8(246)])
    let nil_label: LabelState = new_label(current)
    let join_label: LabelState = new_label(nil_label.state)
    current = emit_jump(join_label.state, nil_label.label, true, u8(136))
    current = append_code(current, [u8(72), u8(59), u8(55)])
    current = emit_jump(current, nil_label.label, true, u8(131))
    current = append_code(current, array_concat([u8(72), u8(139), u8(68), u8(247), u8(8), u8(72), u8(137), u8(199), u8(72), u8(190)], dyn_u64_bytes(u64(1))))
    let boxed: EmitState = state_with_box_used(current)
    current = emit_label_call(boxed, boxed.assembler.common.box_alloc_label)
    current = emit_jump(current, join_label.label, false, u8(0))
    let bound_nil: Result[EmitState, String] = bind_label(current, nil_label.label)
    if is_err(bound_nil) { return err(unwrap_or(result_error(bound_nil), "dynamic backend: cannot bind array_get nil path")) }
    current = emit_int(result_unwrap(bound_nil), 0)
    let bound_join: Result[EmitState, String] = bind_label(current, join_label.label)
    if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind array_get join")) }
    return ok(result_unwrap(bound_join))
}

fn emit_box_alloc_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, state.assembler.common.box_alloc_label)
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind Option/Result allocator")) }
    let mut current: EmitState = append_code(result_unwrap(bound), [
        u8(83), u8(85), u8(72), u8(137), u8(253), u8(72), u8(137), u8(243),
        u8(72), u8(199), u8(199), u8(16), u8(0), u8(0), u8(0)
