        u8(78), u8(137), u8(68), u8(251), u8(8), u8(73), u8(131), u8(192), u8(16), u8(73), u8(1), u8(214), u8(73), u8(255), u8(199)
    ])
    current = emit_jump(current, fill_loop.label, false, u8(0))
    let bound_done: Result[EmitState, String] = bind_label(current, done.label)
    if is_err(bound_done) { return err(unwrap_or(result_error(bound_done), "dynamic backend: cannot bind string_chars completion")) }
    return ok(append_code(result_unwrap(bound_done), [u8(72), u8(137), u8(216), u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92), u8(93), u8(91), u8(195)]))
}

fn emit_process_args_runtime_windows(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, host_process_args_label(state))
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind Windows process_args runtime")) }
    // Windows x64 calls arrive with RSP % 16 == 8. Preserve the nonvolatile
    // registers used by the argv loop, then reserve an aligned frame containing
    // Win64 shadow space, four stack arguments, and its local values.
    let mut current: EmitState = append_code(result_unwrap(bound), [
        u8(85), u8(72), u8(137), u8(229), u8(83), u8(65), u8(84), u8(65), u8(85), u8(65), u8(86), u8(65), u8(87),
        u8(72), u8(129), u8(236), u8(8), u8(1), u8(0), u8(0)
    ])
    current = emit_pe_import_transfer(current, 5, false) // GetCommandLineW()
    current = append_code(current, [
        u8(199), u8(68), u8(36), u8(64), u8(0), u8(0), u8(0), u8(0), // argc = 0
        u8(72), u8(137), u8(193), // RCX = command line
        u8(72), u8(141), u8(84), u8(36), u8(64) // RDX = &argc
    ])
    current = emit_pe_import_transfer(current, 6, false) // CommandLineToArgvW
    current = append_code(current, [u8(72), u8(133), u8(192)])
    current = emit_jump(current, current.env.trap_label, true, u8(132))
    current = append_code(current, [
        u8(68), u8(139), u8(100), u8(36), u8(64), // R12D = argc
        u8(73), u8(137), u8(197), // R13 = argv
        u8(77), u8(133), u8(228) // argc must include argv[0]
    ])
    current = emit_jump(current, current.env.trap_label, true, u8(142))
    current = append_code(current, [u8(76), u8(137), u8(231), u8(72), u8(255), u8(207)]) // RDI = argc - 1
    current = emit_relative_call(current, current.assembler.common.array_alloc_label)
    current = append_code(current, [u8(73), u8(137), u8(198), u8(65), u8(191), u8(1), u8(0), u8(0), u8(0)]) // R14 = result, R15 = argv index 1

    let loop_label: LabelState = new_label(current)
    let done_label: LabelState = new_label(loop_label.state)
    let bound_loop: Result[EmitState, String] = bind_label(done_label.state, loop_label.label)
    if is_err(bound_loop) { return err(unwrap_or(result_error(bound_loop), "dynamic backend: cannot bind Windows process_args loop")) }
    current = append_code(result_unwrap(bound_loop), [u8(77), u8(57), u8(231)]) // cmp r15, r12
    current = emit_jump(current, done_label.label, true, u8(141)) // jge done
    current = append_code(current, [
        u8(76), u8(137), u8(248), u8(72), u8(193), u8(224), u8(3), u8(76), u8(1), u8(232), u8(72), u8(139), u8(24),
        u8(72), u8(137), u8(92), u8(36), u8(96) // save current LPCWSTR
    ])
    current = append_code(current, [
        u8(185), u8(233), u8(253), u8(0), u8(0), u8(49), u8(210), u8(76), u8(139), u8(68), u8(36), u8(96), u8(65), u8(185), u8(255), u8(255), u8(255), u8(255),
        u8(72), u8(199), u8(68), u8(36), u8(32), u8(0), u8(0), u8(0), u8(0),
        u8(72), u8(199), u8(68), u8(36), u8(40), u8(0), u8(0), u8(0), u8(0),
        u8(72), u8(199), u8(68), u8(36), u8(48), u8(0), u8(0), u8(0), u8(0),
        u8(72), u8(199), u8(68), u8(36), u8(56), u8(0), u8(0), u8(0), u8(0)
    ])
    current = emit_pe_import_transfer(current, 8, false) // WideCharToMultiByte size query
    current = append_code(current, [u8(137), u8(68), u8(36), u8(104), u8(133), u8(192)])
    current = emit_jump(current, current.env.trap_label, true, u8(142)) // jle on API failure
    current = append_code(current, [u8(72), u8(137), u8(199), u8(72), u8(131), u8(199), u8(8)]) // capacity includes NUL
    current = emit_heap_alloc(current)
    current = append_code(current, [
        u8(72), u8(137), u8(195), // RBX = Kryndel String allocation
        u8(185), u8(233), u8(253), u8(0), u8(0), u8(49), u8(210), u8(76), u8(139), u8(68), u8(36), u8(96),
        u8(65), u8(185), u8(255), u8(255), u8(255), u8(255),
        u8(72), u8(141), u8(67), u8(8), u8(72), u8(137), u8(68), u8(36), u8(32),
        u8(72), u8(139), u8(68), u8(36), u8(104), u8(72), u8(137), u8(68), u8(36), u8(40),
        u8(72), u8(199), u8(68), u8(36), u8(48), u8(0), u8(0), u8(0), u8(0),
        u8(72), u8(199), u8(68), u8(36), u8(56), u8(0), u8(0), u8(0), u8(0)
    ])
    current = emit_pe_import_transfer(current, 8, false) // convert into the String payload
    current = append_code(current, [u8(133), u8(192)])
    current = emit_jump(current, current.env.trap_label, true, u8(142))
    current = append_code(current, [
        u8(131), u8(232), u8(1), u8(72), u8(137), u8(3), // String length excludes NUL
        u8(76), u8(137), u8(248), u8(72), u8(255), u8(200), u8(72), u8(193), u8(224), u8(3), u8(73), u8(141), u8(78), u8(8),
        u8(72), u8(1), u8(193), u8(72), u8(137), u8(25), // array[index - 1] = String
        u8(73), u8(255), u8(199)
    ])
    current = emit_jump(current, loop_label.label, false, u8(0))
    let bound_done: Result[EmitState, String] = bind_label(current, done_label.label)
    if is_err(bound_done) { return err(unwrap_or(result_error(bound_done), "dynamic backend: cannot bind Windows process_args completion")) }
    current = append_code(result_unwrap(bound_done), [u8(76), u8(137), u8(233)]) // RCX = argv
    current = emit_pe_import_transfer(current, 7, false) // LocalFree(argv)
    current = append_code(current, [u8(76), u8(137), u8(240), u8(72), u8(129), u8(196), u8(8), u8(1), u8(0), u8(0), u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92), u8(91), u8(93), u8(195)])
    return ok(current)
}

fn emit_process_args_runtime(state: EmitState) -> Result[EmitState, String] {
    if state.assembler.common.windows_abi { return emit_process_args_runtime_windows(state) }
    let bound: Result[EmitState, String] = bind_label(state, host_process_args_label(state))
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind process_args runtime")) }
    let mut current: EmitState = append_code(result_unwrap(bound), [
        u8(65), u8(84), u8(65), u8(85), u8(65), u8(86), u8(65), u8(87),
        u8(76), u8(139), u8(101), u8(8), u8(73), u8(255), u8(204), u8(76), u8(137), u8(231), u8(76), u8(137), u8(224)
    ])
    current = emit_label_call(current, current.assembler.common.array_alloc_label)
    current = append_code(current, [u8(73), u8(137), u8(197), u8(69), u8(49), u8(246), u8(76), u8(141), u8(125), u8(24)])
    let loop_label: LabelState = new_label(current)
    let done_label: LabelState = new_label(loop_label.state)
    let bound_loop: Result[EmitState, String] = bind_label(done_label.state, loop_label.label)
    if is_err(bound_loop) { return err(unwrap_or(result_error(bound_loop), "dynamic backend: cannot bind process_args loop")) }
    current = append_code(result_unwrap(bound_loop), [u8(76), u8(137), u8(240), u8(76), u8(57), u8(224)])
    current = emit_jump(current, done_label.label, true, u8(131))
    current = append_code(current, [
        u8(76), u8(137), u8(247), u8(72), u8(193), u8(231), u8(3), u8(76), u8(1), u8(255), u8(76), u8(139), u8(7), u8(69), u8(49), u8(201)
    ])
    let length_loop: LabelState = new_label(current)
    let length_done: LabelState = new_label(length_loop.state)
    let bound_length: Result[EmitState, String] = bind_label(length_done.state, length_loop.label)
    if is_err(bound_length) { return err(unwrap_or(result_error(bound_length), "dynamic backend: cannot bind argv scan")) }
    current = append_code(result_unwrap(bound_length), [u8(67), u8(128), u8(60), u8(8), u8(0)])
    current = emit_jump(current, length_done.label, true, u8(132))
    current = append_code(current, [u8(73), u8(255), u8(193)])
    current = emit_jump(current, length_loop.label, false, u8(0))
    let bound_scan: Result[EmitState, String] = bind_label(current, length_done.label)
    if is_err(bound_scan) { return err(unwrap_or(result_error(bound_scan), "dynamic backend: cannot bind argv scan completion")) }
    current = append_code(result_unwrap(bound_scan), [u8(76), u8(137), u8(199), u8(76), u8(137), u8(206)])
    current = emit_label_call(current, host_string_alloc_label(current))
    current = append_code(current, [
        u8(76), u8(137), u8(234), u8(76), u8(137), u8(247), u8(72), u8(193), u8(231), u8(3), u8(76), u8(1), u8(239), u8(72), u8(131), u8(199), u8(8), u8(72), u8(137), u8(7), u8(73), u8(255), u8(198)
    ])
    current = emit_jump(current, loop_label.label, false, u8(0))
    let bound_done: Result[EmitState, String] = bind_label(current, done_label.label)
    if is_err(bound_done) { return err(unwrap_or(result_error(bound_done), "dynamic backend: cannot bind process_args completion")) }
    return ok(append_code(result_unwrap(bound_done), [u8(76), u8(137), u8(232), u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92), u8(195)]))
}

fn emit_fs_read_text_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, host_fs_read_text_label(state))
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind fs_read_text runtime")) }
    let mut current: EmitState = append_code(result_unwrap(bound), [
        u8(65), u8(84), u8(65), u8(85), u8(65), u8(86), u8(65), u8(87), u8(83), u8(85),
        u8(73), u8(137), u8(252), u8(73), u8(141), u8(124), u8(36), u8(8), u8(73), u8(139), u8(52), u8(36)
    ])
    current = emit_label_call(current, host_string_alloc_label(current))
    current = append_code(current, [
        u8(73), u8(137), u8(197), u8(73), u8(139), u8(77), u8(0), u8(76), u8(1), u8(233), u8(198), u8(65), u8(8), u8(0),
        u8(72), u8(129), u8(236), u8(144), u8(0), u8(0), u8(0), u8(73), u8(141), u8(125), u8(8),
        u8(190), u8(0), u8(0), u8(2), u8(0), u8(72), u8(49), u8(210), u8(184), u8(2), u8(0), u8(0), u8(0), u8(15), u8(5), u8(72), u8(133), u8(192)
    ])
    let open_fail: LabelState = new_label(current)
    let close_fail: LabelState = new_label(open_fail.state)
    let error_label: LabelState = new_label(close_fail.state)
    current = emit_jump(error_label.state, open_fail.label, true, u8(136))
    current = append_code(current, [
        u8(73), u8(137), u8(198), u8(76), u8(137), u8(247), u8(72), u8(137), u8(230), u8(184), u8(5), u8(0), u8(0), u8(0), u8(15), u8(5), u8(72), u8(133), u8(192)
    ])
    current = emit_jump(current, close_fail.label, true, u8(136))
    current = append_code(current, [u8(76), u8(139), u8(124), u8(36), u8(48), u8(77), u8(133), u8(255)])
    let non_zero: LabelState = new_label(current)
    let alloc_size: LabelState = new_label(non_zero.state)
    current = emit_jump(alloc_size.state, non_zero.label, true, u8(133))
    current = emit_int(current, 1)
    current = emit_jump(current, alloc_size.label, false, u8(0))
    let bound_non_zero: Result[EmitState, String] = bind_label(current, non_zero.label)
    if is_err(bound_non_zero) { return err(unwrap_or(result_error(bound_non_zero), "dynamic backend: cannot bind fs_read_text size path")) }
    current = append_code(result_unwrap(bound_non_zero), [u8(76), u8(137), u8(248)])
    let bound_alloc: Result[EmitState, String] = bind_label(current, alloc_size.label)
    if is_err(bound_alloc) { return err(unwrap_or(result_error(bound_alloc), "dynamic backend: cannot bind fs_read_text allocation")) }
    current = append_code(result_unwrap(bound_alloc), [
        u8(72), u8(137), u8(198), u8(72), u8(49), u8(255), u8(186), u8(3), u8(0), u8(0), u8(0), u8(65), u8(186), u8(34), u8(0), u8(0), u8(0), u8(65), u8(184), u8(255), u8(255), u8(255), u8(255), u8(69), u8(49), u8(201), u8(184), u8(9), u8(0), u8(0), u8(0), u8(15), u8(5), u8(72), u8(133), u8(192)
    ])
    current = emit_jump(current, close_fail.label, true, u8(136))
    current = append_code(current, [u8(72), u8(137), u8(195), u8(72), u8(49), u8(237)])
    let read_loop: LabelState = new_label(current)
    let read_done: LabelState = new_label(read_loop.state)
    let bound_read: Result[EmitState, String] = bind_label(read_done.state, read_loop.label)
    if is_err(bound_read) { return err(unwrap_or(result_error(bound_read), "dynamic backend: cannot bind fs_read_text loop")) }
    current = append_code(result_unwrap(bound_read), [u8(76), u8(57), u8(253)])
    current = emit_jump(current, read_done.label, true, u8(131))
    current = append_code(current, [u8(76), u8(137), u8(247), u8(72), u8(141), u8(52), u8(43), u8(76), u8(137), u8(250), u8(72), u8(41), u8(234), u8(49), u8(192), u8(15), u8(5), u8(72), u8(133), u8(192)])
    current = emit_jump(current, close_fail.label, true, u8(142))
    current = append_code(current, [u8(72), u8(1), u8(197)])
    current = emit_jump(current, read_loop.label, false, u8(0))
    let bound_read_done: Result[EmitState, String] = bind_label(current, read_done.label)
    if is_err(bound_read_done) { return err(unwrap_or(result_error(bound_read_done), "dynamic backend: cannot bind fs_read_text completion")) }
    current = append_code(result_unwrap(bound_read_done), [u8(76), u8(137), u8(247), u8(184), u8(3), u8(0), u8(0), u8(0), u8(15), u8(5), u8(72), u8(137), u8(223), u8(76), u8(137), u8(254)])
    current = emit_label_call(current, host_string_alloc_label(current))
    current = append_code(current, [u8(72), u8(129), u8(196), u8(144), u8(0), u8(0), u8(0), u8(93), u8(91), u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92)])
    current = emit_box_call(current, u64(0))
    let return_label: LabelState = new_label(current)
    current = emit_jump(return_label.state, return_label.label, false, u8(0))
    let bound_open: Result[EmitState, String] = bind_label(current, open_fail.label)
    if is_err(bound_open) { return err(unwrap_or(result_error(bound_open), "dynamic backend: cannot bind fs_read_text open failure")) }
    current = emit_jump(result_unwrap(bound_open), error_label.label, false, u8(0))
    let bound_close: Result[EmitState, String] = bind_label(current, close_fail.label)
    if is_err(bound_close) { return err(unwrap_or(result_error(bound_close), "dynamic backend: cannot bind fs_read_text close failure")) }
    current = append_code(result_unwrap(bound_close), [u8(76), u8(137), u8(247), u8(184), u8(3), u8(0), u8(0), u8(0), u8(15), u8(5)])
    current = emit_jump(current, error_label.label, false, u8(0))
    let bound_error: Result[EmitState, String] = bind_label(current, error_label.label)
    if is_err(bound_error) { return err(unwrap_or(result_error(bound_error), "dynamic backend: cannot bind fs_read_text error")) }
    current = append_code(result_unwrap(bound_error), [u8(72), u8(129), u8(196), u8(144), u8(0), u8(0), u8(0), u8(93), u8(91), u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92)])
    current = emit_string(current, "fs_read_text failed")
    current = emit_box_call(current, u64(1))
    let bound_return: Result[EmitState, String] = bind_label(current, return_label.label)
    if is_err(bound_return) { return err(unwrap_or(result_error(bound_return), "dynamic backend: cannot bind fs_read_text return")) }
    return ok(append_code(result_unwrap(bound_return), [u8(195)]))
}

fn emit_fs_write_bytes_runtime(state: EmitState) -> Result[EmitState, String] {
