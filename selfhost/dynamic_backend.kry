            if target == "builtin:err" { tag = u64(1) }
            return ok(emit_box_call(result_unwrap(emitted), tag))
        }
        if target == "builtin:is_some" || target == "builtin:is_none" {
            if result_unwrap(kir_typed_array_len(arguments)) != 1 { return err("dynamic backend: Option predicate expects one argument") }
            return emit_option_predicate(state, argument, target == "builtin:is_none")
        }
        if target == "builtin:is_ok" || target == "builtin:is_err" {
            if result_unwrap(kir_typed_array_len(arguments)) != 1 { return err("dynamic backend: Result predicate expects one argument") }
            return emit_result_predicate(state, argument, target == "builtin:is_err")
        }
        if target == "builtin:unwrap_or" { return emit_unwrap_or(state, expression) }
        if target == "builtin:result_unwrap" {
            if result_unwrap(kir_typed_array_len(arguments)) != 1 { return err("dynamic backend: result_unwrap expects one argument") }
            return emit_result_unwrap(state, argument)
        }
        if target == "builtin:result_error" {
            if result_unwrap(kir_typed_array_len(arguments)) != 1 { return err("dynamic backend: result_error expects one argument") }
            return emit_result_error(state, argument)
        }
        if target == "builtin:u8" || target == "builtin:u16" || target == "builtin:u32" || target == "builtin:u64" {
            if result_unwrap(kir_typed_array_len(arguments)) != 1 { return err("dynamic backend: integer conversion expects one argument") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            let mut bits: Int = 64
            if target == "builtin:u8" { bits = 8 }
            if target == "builtin:u16" { bits = 16 }
            if target == "builtin:u32" { bits = 32 }
            return ok(emit_uint_mask(result_unwrap(emitted), bits))
        }
        return err("dynamic backend: unsupported call '" + target + "'")
    }
    if kind == "bool" {
        let value: Bool = result_unwrap(kir_typed_bool(field(expression, "bool")))
        if value { return ok(emit_int(state, 1)) }
        return ok(emit_int(state, 0))
    }
    if kind == "var" {
        let name: String = text(field(expression, "name"))
        let slot: Option[Int] = map_get(state.env.slots, name)
        if is_none(slot) { return err("dynamic backend: unknown slot '" + name + "'") }
        return ok(emit_load_slot(state, unwrap_or(slot, -1)))
    }
    if kind == "unary" {
        let operand: Result[EmitState, String] = emit_expression(state, field(expression, "operand"))
        if is_err(operand) { return err(expression_error(operand)) }
        let updated: EmitState = result_unwrap(operand)
        let operator: String = text(field(expression, "operator"))
        if operator == "+" { return ok(updated) }
        if operator == "-" { return ok(append_code(updated, [u8(72), u8(247), u8(216)])) }
        if operator == "!" { return ok(append_code(updated, [u8(72), u8(133), u8(192), u8(15), u8(148), u8(192), u8(72), u8(15), u8(182), u8(192)])) }
        if operator == "~" { return ok(append_code(updated, [u8(72), u8(247), u8(208)])) }
        return err("dynamic backend: unsupported unary operator '" + operator + "'")
    }
    if kind == "propagate" { return emit_propagate(state, expression) }
    if kind != "binary" {
        return err("dynamic backend: unsupported expression kind '" + kind + "'")
    }
    let operator: String = text(field(expression, "operator"))
    if operator == "&&" || operator == "||" { return emit_logical_expression(state, expression, operator) }
    let left: Result[EmitState, String] = emit_expression(state, field(expression, "left"))
    if is_err(left) { return err(expression_error(left)) }
    let pushed: EmitState = emit_push_rax(result_unwrap(left))
    let right: Result[EmitState, String] = emit_expression(pushed, field(expression, "right"))
    if is_err(right) { return err(expression_error(right)) }
    let moved: EmitState = append_code(result_unwrap(right), [u8(72), u8(137), u8(193)])
    let popped: Result[EmitState, String] = emit_pop_rax(moved)
    if is_err(popped) { return err(unwrap_or(result_error(popped), "dynamic backend: binary expression stack restore failed")) }
    let combined: EmitState = result_unwrap(popped)
    let left_type: String = expr_type(field(expression, "left"))
    if left_type == "String" {
        if operator != "+" && operator != "==" && operator != "!=" { return err("dynamic backend: unsupported String operator '" + operator + "'") }
        if operator == "+" { return ok(emit_string_concat_call(combined)) }
        let compared: EmitState = append_code(combined, [u8(72), u8(137), u8(199), u8(72), u8(137), u8(206)])
        let equal: EmitState = emit_label_call(compared, host_string_equal_label(compared))
        if operator == "!=" { return ok(append_code(equal, [u8(72), u8(131), u8(240), u8(1)])) }
        return ok(equal)
    }
    let expression_type: String = expr_type(expression)
    if starts_with(expression_type, "Array[") {
        if operator != "+" { return err("dynamic backend: unsupported Array operator '" + operator + "'") }
        return ok(emit_array_concat_call(combined))
    }
    let unsigned: Bool = is_unsigned(expression_type)
    let bits: Int = uint_bits(expression_type)
    if operator == "+" {
        let added: EmitState = append_code(combined, [u8(72), u8(1), u8(200)])
        if !unsigned { return ok(emit_jump(added, state.env.trap_label, true, u8(128))) }
        return ok(emit_uint_mask(added, bits))
    }
    if operator == "-" {
        let subtracted: EmitState = append_code(combined, [u8(72), u8(41), u8(200)])
        if !unsigned { return ok(emit_jump(subtracted, state.env.trap_label, true, u8(128))) }
        return ok(emit_uint_mask(subtracted, bits))
    }
    if operator == "*" {
        let multiplied: EmitState = append_code(combined, [u8(72), u8(15), u8(175), u8(193)])
        if !unsigned { return ok(emit_jump(multiplied, state.env.trap_label, true, u8(128))) }
        return ok(emit_uint_mask(multiplied, bits))
    }
    if operator == "/" || operator == "%" {
        let checked: EmitState = append_code(combined, [u8(72), u8(133), u8(201)])
        let guarded: EmitState = emit_jump(checked, state.env.trap_label, true, u8(132))
        let mut divided: EmitState = guarded
        if unsigned {
            divided = append_code(divided, [u8(72), u8(49), u8(210), u8(72), u8(247), u8(241)])
        } else {
            let safe_division: LabelState = new_label(divided)
            divided = append_code(safe_division.state, array_concat([u8(72), u8(186)], dyn_u64_bytes(u64(1) << 63)))
            divided = append_code(divided, [u8(72), u8(57), u8(208)])
            divided = emit_jump(divided, safe_division.label, true, u8(133))
            divided = append_code(divided, [u8(72), u8(131), u8(249), u8(255)])
            divided = emit_jump(divided, safe_division.label, true, u8(133))
            divided = emit_jump(divided, state.env.trap_label, false, u8(0))
            let bound_safe: Result[EmitState, String] = bind_label(divided, safe_division.label)
            if is_err(bound_safe) { return err(unwrap_or(result_error(bound_safe), "dynamic backend: cannot bind signed division guard")) }
            divided = append_code(result_unwrap(bound_safe), [u8(72), u8(153), u8(72), u8(247), u8(249)])
        }
        if operator == "%" { return ok(emit_uint_mask(append_code(divided, [u8(72), u8(137), u8(208)]), bits)) }
        return ok(emit_uint_mask(divided, bits))
    }
    if operator == "&" { return ok(emit_uint_mask(append_code(combined, [u8(72), u8(33), u8(200)]), bits)) }
    if operator == "^" { return ok(emit_uint_mask(append_code(combined, [u8(72), u8(49), u8(200)]), bits)) }
    if operator == "|" { return ok(emit_uint_mask(append_code(combined, [u8(72), u8(9), u8(200)]), bits)) }
    if operator == "<<" || operator == ">>" {
        let shift_left_type: String = expr_type(field(expression, "left"))
        let mut shift_width: Int = 64
        if starts_with(shift_left_type, "UInt") { shift_width = uint_bits(shift_left_type) }
        let checked_shift: EmitState = append_code(combined, [u8(72), u8(131), u8(249), u8(shift_width)])
        let guarded_shift: EmitState = emit_jump(checked_shift, state.env.trap_label, true, u8(131))
        if operator == "<<" { return ok(emit_uint_mask(append_code(guarded_shift, [u8(72), u8(211), u8(224)]), bits)) }
        return ok(emit_uint_mask(append_code(guarded_shift, [u8(72), u8(211), u8(232)]), bits))
    }
    if operator == "==" || operator == "!=" || operator == "<" || operator == "<=" || operator == ">" || operator == ">=" {
        return ok(append_code(combined, [u8(72), u8(57), u8(200), u8(15), setcc(operator, unsigned), u8(192), u8(72), u8(15), u8(182), u8(192)]))
    }
    return err("dynamic backend: unsupported binary operator '" + operator + "'")
}

fn compile_error(value: Result[EmitState, String]) -> String {
    return "dynamic backend: statement lowering failed: " + unwrap_or(result_error(value), "unknown error")
}

fn is_static_display_candidate(expression: KIRTypedNodeView, bindings: Map[String, String]) -> Bool {
    let kind: String = text(field(expression, "kind"))
    if kind == "int" || kind == "uint" || kind == "string" || kind == "bool" { return true }
    if kind == "var" { return map_contains_key(bindings, text(field(expression, "name"))) }
    if kind == "binary" {
        return is_static_display_candidate(field(expression, "left"), bindings) && is_static_display_candidate(field(expression, "right"), bindings)
    }
    if kind == "call" {
        let target: String = text(field(expression, "call_target"))
        if target != "builtin:str" { return false }
        let arguments: KIRTypedNodeView = field(expression, "args")
        if result_unwrap(kir_typed_array_len(arguments)) != 1 { return false }
        return is_static_display_candidate(result_unwrap(kir_typed_array_get(arguments, 0)), bindings)
    }
    return false
}

fn allocate_slot(state: EmitState, name: String) -> Result[EmitState, String] {
    if map_contains_key(state.env.slots, name) { return err("dynamic backend: shadowed slot '" + name + "'") }
    let offset: Int = state.env.next_slot + 8
    let env: CompileEnv = CompileEnv{ slots: map_insert(state.env.slots, name, offset), static_values: state.env.static_values, struct_fields: state.env.struct_fields, function_labels: state.env.function_labels, function_returns: state.env.function_returns, next_slot: offset, breaks: state.env.breaks, continues: state.env.continues, end_label: state.env.end_label, trap_label: state.env.trap_label, buffer_offset: state.env.buffer_offset, in_function: state.env.in_function, current_function: state.env.current_function }
    return ok(state_with_env(state, env))
}

fn compile_statement(state: EmitState, statement: KIRTypedNodeView) -> Result[EmitState, String] {
    let kind: String = text(field(statement, "kind"))
    if kind == "let" || kind == "const" {
        let name: String = text(field(statement, "name"))
        let allocated: Result[EmitState, String] = allocate_slot(state, name)
        if is_err(allocated) { return err(compile_error(allocated)) }
        let updated: EmitState = result_unwrap(allocated)
        let init: KIRTypedNodeView = field(statement, "init")
        let type_name: String = expr_type(init)
        if state.env.in_function && !is_supported_type(state.env, type_name) { return err("dynamic backend: function '" + state.env.current_function + "' local '" + name + "' has unsupported type '" + type_name + "'") }
        let mut generated: Result[EmitState, String] = err("dynamic backend: initializer was not lowered")
        generated = emit_expression(updated, init)
        if is_err(generated) { return err(expression_error(generated)) }
        let stored: EmitState = emit_store_slot(result_unwrap(generated), unwrap_or(map_get(updated.env.slots, name), -1))
        let mutable: Bool = result_unwrap(kir_typed_bool(field(statement, "mutable")))
        if !mutable {
            let mut display_value: Result[String, String] = err("dynamic backend: initializer is not static display data")
            if type_name == "String" || type_name == "Int" || type_name == "Bool" || starts_with(type_name, "UInt") {
                display_value = eval_display(init, stored.env.static_values)
            }
            if is_ok(display_value) {
                let env: CompileEnv = CompileEnv{ slots: stored.env.slots, static_values: map_insert(stored.env.static_values, name, result_unwrap(display_value)), struct_fields: stored.env.struct_fields, function_labels: stored.env.function_labels, function_returns: stored.env.function_returns, next_slot: stored.env.next_slot, breaks: stored.env.breaks, continues: stored.env.continues, end_label: stored.env.end_label, trap_label: stored.env.trap_label, buffer_offset: stored.env.buffer_offset, in_function: stored.env.in_function, current_function: stored.env.current_function }
                return ok(state_with_env(stored, env))
            }
        }
        return ok(stored)
    }
    if kind == "assign" {
        let target: KIRTypedNodeView = field(statement, "target")
        let name: String = text(field(target, "name"))
        let slot: Option[Int] = map_get(state.env.slots, name)
        if is_none(slot) { return err("dynamic backend: assignment uses unknown slot '" + name + "'") }
        let value: Result[EmitState, String] = emit_expression(state, field(statement, "value"))
        if is_err(value) { return err(expression_error(value)) }
        let stored: EmitState = emit_store_slot(result_unwrap(value), unwrap_or(slot, -1))
        return ok(state_with_env(stored, CompileEnv{ slots: stored.env.slots, static_values: map_remove(stored.env.static_values, name), struct_fields: stored.env.struct_fields, function_labels: stored.env.function_labels, function_returns: stored.env.function_returns, next_slot: stored.env.next_slot, breaks: stored.env.breaks, continues: stored.env.continues, end_label: stored.env.end_label, trap_label: stored.env.trap_label, buffer_offset: stored.env.buffer_offset, in_function: stored.env.in_function, current_function: stored.env.current_function }))
    }
    if kind == "expr" {
        let expression: KIRTypedNodeView = field(statement, "expr")
        let target: String = text(field(expression, "call_target"))
        if starts_with(target, "function:") {
            return emit_function_call(state, expression)
        }
        if target != "builtin:print" && target != "builtin:println" {
            let emitted: Result[EmitState, String] = emit_expression(state, expression)
            if is_err(emitted) { return err(expression_error(emitted)) }
            return ok(result_unwrap(emitted))
        }
        let argument: KIRTypedNodeView = result_unwrap(kir_typed_array_get(field(expression, "args"), 0))
        let mut display_value: Result[String, String] = err("dynamic display expression")
        if is_static_display_candidate(argument, state.env.static_values) {
            display_value = eval_display(argument, state.env.static_values)
        }
        if is_ok(display_value) {
            let mut output: String = result_unwrap(display_value)
            if target == "builtin:println" { output = output + "\n" }
            return emit_write(state, output)
        }
        let type_name: String = expr_type(argument)
        if type_name == "String" {
            let emitted_string: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted_string) { return err(expression_error(emitted_string)) }
            let written_string: Result[EmitState, String] = emit_string_write(result_unwrap(emitted_string))
            if is_err(written_string) { return err(unwrap_or(result_error(written_string), "dynamic backend: string output failed")) }
            if target == "builtin:println" { return emit_write(result_unwrap(written_string), "\n") }
            return written_string
        }
        if type_name == "Bool" {
            return emit_boolean_output(state, argument, target == "builtin:println")
        }
        if is_enum_type(state.env.struct_fields, type_name) {
            return emit_enum_output(state, argument, target == "builtin:println")
        }
        if type_name != "Int" && !starts_with(type_name, "UInt") { return err("dynamic backend: print value has unsupported type '" + type_name + "': " + unwrap_or(result_error(display_value), "dynamic backend: print value is not static")) }
        let generated: Result[EmitState, String] = emit_expression(state, argument)
        if is_err(generated) { return err(expression_error(generated)) }
        let output_state: Result[EmitState, String] = emit_integer(result_unwrap(generated), starts_with(type_name, "UInt"))
        if is_err(output_state) { return err(unwrap_or(result_error(output_state), "dynamic backend: integer output failed")) }
        if target == "builtin:println" { return emit_write(result_unwrap(output_state), "\n") }
        return ok(result_unwrap(output_state))
    }
    if kind == "match" {
        return emit_fieldless_enum_match(state, statement)
    }
    if kind == "if" {
        let else_label: LabelState = new_label(state)
        let condition: Result[EmitState, String] = emit_expression(else_label.state, field(statement, "cond"))
        if is_err(condition) {
            return err(expression_error(condition))
        }
        let tested: EmitState = append_code(result_unwrap(condition), [u8(72), u8(133), u8(192)])
        let guarded: EmitState = emit_jump(tested, else_label.label, true, u8(132))
        let then_state: Result[EmitState, String] = compile_statements(guarded, field(statement, "then"))
        if is_err(then_state) { return err(compile_error(then_state)) }
        if result_unwrap(kir_typed_array_len(field(statement, "else"))) == 0 {
            let bound: Result[EmitState, String] = bind_label(result_unwrap(then_state), else_label.label)
            if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind empty if join")) }
            let then_result: EmitState = result_unwrap(then_state)
            let joined: EmitState = result_unwrap(bound)
            let joined_env: CompileEnv = CompileEnv{ slots: guarded.env.slots, static_values: guarded.env.static_values, struct_fields: guarded.env.struct_fields, function_labels: guarded.env.function_labels, function_returns: guarded.env.function_returns, next_slot: then_result.env.next_slot, breaks: guarded.env.breaks, continues: guarded.env.continues, end_label: guarded.env.end_label, trap_label: guarded.env.trap_label, buffer_offset: guarded.env.buffer_offset, in_function: guarded.env.in_function, current_function: guarded.env.current_function }
            return ok(state_with_env(joined, joined_env))
        }
        let join_label: LabelState = new_label(result_unwrap(then_state))
        let jumped: EmitState = emit_jump(join_label.state, join_label.label, false, u8(0))
        let bound_else: Result[EmitState, String] = bind_label(jumped, else_label.label)
        if is_err(bound_else) { return err(unwrap_or(result_error(bound_else), "dynamic backend: cannot bind else")) }
        let else_base: EmitState = state_with_env(result_unwrap(bound_else), CompileEnv{ slots: guarded.env.slots, static_values: guarded.env.static_values, struct_fields: guarded.env.struct_fields, function_labels: guarded.env.function_labels, function_returns: guarded.env.function_returns, next_slot: guarded.env.next_slot, breaks: guarded.env.breaks, continues: guarded.env.continues, end_label: guarded.env.end_label, trap_label: guarded.env.trap_label, buffer_offset: guarded.env.buffer_offset, in_function: guarded.env.in_function, current_function: guarded.env.current_function })
        let else_state: Result[EmitState, String] = compile_statements(else_base, field(statement, "else"))
        if is_err(else_state) { return err(compile_error(else_state)) }
        let bound_join: Result[EmitState, String] = bind_label(result_unwrap(else_state), join_label.label)
        if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind if join")) }
        let then_result: EmitState = result_unwrap(then_state)
        let else_result: EmitState = result_unwrap(else_state)
        let mut next_slot: Int = then_result.env.next_slot
        if else_result.env.next_slot > next_slot { next_slot = else_result.env.next_slot }
        let joined: EmitState = result_unwrap(bound_join)
        let joined_env: CompileEnv = CompileEnv{ slots: guarded.env.slots, static_values: guarded.env.static_values, struct_fields: guarded.env.struct_fields, function_labels: guarded.env.function_labels, function_returns: guarded.env.function_returns, next_slot: next_slot, breaks: guarded.env.breaks, continues: guarded.env.continues, end_label: guarded.env.end_label, trap_label: guarded.env.trap_label, buffer_offset: guarded.env.buffer_offset, in_function: guarded.env.in_function, current_function: guarded.env.current_function }
        return ok(state_with_env(joined, joined_env))
    }
    if kind == "while" {
        let condition_label: LabelState = new_label(state)
        let end_label: LabelState = new_label(condition_label.state)
        let bound_condition: Result[EmitState, String] = bind_label(end_label.state, condition_label.label)
        if is_err(bound_condition) { return err(unwrap_or(result_error(bound_condition), "dynamic backend: cannot bind loop")) }
        let condition: Result[EmitState, String] = emit_expression(result_unwrap(bound_condition), field(statement, "cond"))
        if is_err(condition) { return err(expression_error(condition)) }
        let tested: EmitState = append_code(result_unwrap(condition), [u8(72), u8(133), u8(192)])
        let guarded: EmitState = emit_jump(tested, end_label.label, true, u8(132))
        let env: CompileEnv = CompileEnv{ slots: guarded.env.slots, static_values: guarded.env.static_values, struct_fields: guarded.env.struct_fields, function_labels: guarded.env.function_labels, function_returns: guarded.env.function_returns, next_slot: guarded.env.next_slot, breaks: array_push(guarded.env.breaks, end_label.label), continues: array_push(guarded.env.continues, condition_label.label), end_label: guarded.env.end_label, trap_label: guarded.env.trap_label, buffer_offset: guarded.env.buffer_offset, in_function: guarded.env.in_function, current_function: guarded.env.current_function }
        let body: Result[EmitState, String] = compile_statements(state_with_env(guarded, env), field(statement, "body"))
        if is_err(body) { return err(compile_error(body)) }
        let body_state: EmitState = result_unwrap(body)
        let restored: EmitState = state_with_env(body_state, CompileEnv{ slots: guarded.env.slots, static_values: guarded.env.static_values, struct_fields: body_state.env.struct_fields, function_labels: body_state.env.function_labels, function_returns: body_state.env.function_returns, next_slot: body_state.env.next_slot, breaks: array_slice(body_state.env.breaks, 0, len(body_state.env.breaks) - 1), continues: array_slice(body_state.env.continues, 0, len(body_state.env.continues) - 1), end_label: body_state.env.end_label, trap_label: body_state.env.trap_label, buffer_offset: body_state.env.buffer_offset, in_function: body_state.env.in_function, current_function: body_state.env.current_function })
        let looped: EmitState = emit_jump(restored, condition_label.label, false, u8(0))
        let bound_end: Result[EmitState, String] = bind_label(looped, end_label.label)
        if is_err(bound_end) { return err(unwrap_or(result_error(bound_end), "dynamic backend: cannot bind loop end")) }
        return ok(result_unwrap(bound_end))
    }
    if kind == "for" {
        let iterator: KIRTypedNodeView = field(statement, "iter")
        if !starts_with(expr_type(iterator), "Array[") { return err("dynamic backend: for requires an Array iterator") }
        let iter_slot: Int = state.env.next_slot + 8
        let index_slot: Int = iter_slot + 8
        let item_slot: Int = index_slot + 8
        let emitted: Result[EmitState, String] = emit_expression(state, iterator)
        if is_err(emitted) { return err(expression_error(emitted)) }
        let mut current: EmitState = emit_store_slot(result_unwrap(emitted), iter_slot)
        current = emit_store_slot(emit_int(current, 0), index_slot)
        let condition_label: LabelState = new_label(current)
        let increment_label: LabelState = new_label(condition_label.state)
        let end_label: LabelState = new_label(increment_label.state)
        let bound_condition: Result[EmitState, String] = bind_label(end_label.state, condition_label.label)
        if is_err(bound_condition) { return err(unwrap_or(result_error(bound_condition), "dynamic backend: cannot bind for loop")) }
        current = emit_load_slot(result_unwrap(bound_condition), iter_slot)
        current = append_code(current, [u8(80)])
        current = emit_load_slot(current, index_slot)
        current = append_code(current, [u8(72), u8(137), u8(193), u8(88), u8(72), u8(133), u8(201)])
        current = emit_jump(current, current.env.trap_label, true, u8(136))
        current = append_code(current, [u8(72), u8(59), u8(8)])
        current = emit_jump(current, end_label.label, true, u8(131))
        current = append_code(current, [u8(72), u8(139), u8(68), u8(200), u8(8)])
        current = emit_store_slot(current, item_slot)
        let loop_env: CompileEnv = CompileEnv{ slots: map_insert(current.env.slots, text(field(statement, "name")), item_slot), static_values: current.env.static_values, struct_fields: current.env.struct_fields, function_labels: current.env.function_labels, function_returns: current.env.function_returns, next_slot: item_slot, breaks: array_push(current.env.breaks, end_label.label), continues: array_push(current.env.continues, increment_label.label), end_label: current.env.end_label, trap_label: current.env.trap_label, buffer_offset: current.env.buffer_offset, in_function: current.env.in_function, current_function: current.env.current_function }
        let body: Result[EmitState, String] = compile_statements(state_with_env(current, loop_env), field(statement, "body"))
        if is_err(body) { return err(compile_error(body)) }
        let body_state: EmitState = result_unwrap(body)
        let restored: CompileEnv = CompileEnv{ slots: state.env.slots, static_values: body_state.env.static_values, struct_fields: body_state.env.struct_fields, function_labels: body_state.env.function_labels, function_returns: body_state.env.function_returns, next_slot: body_state.env.next_slot, breaks: array_slice(body_state.env.breaks, 0, len(body_state.env.breaks) - 1), continues: array_slice(body_state.env.continues, 0, len(body_state.env.continues) - 1), end_label: body_state.env.end_label, trap_label: body_state.env.trap_label, buffer_offset: body_state.env.buffer_offset, in_function: body_state.env.in_function, current_function: body_state.env.current_function }
        current = emit_load_slot(state_with_env(body_state, restored), index_slot)
        current = append_code(current, [u8(72), u8(255), u8(192)])
        current = emit_store_slot(current, index_slot)
        current = emit_jump(current, condition_label.label, false, u8(0))
        let bound_end: Result[EmitState, String] = bind_label(current, end_label.label)
        if is_err(bound_end) { return err(unwrap_or(result_error(bound_end), "dynamic backend: cannot bind for loop end")) }
        return ok(result_unwrap(bound_end))
    }
    if kind == "break" || kind == "continue" {
        let mut labels: Array[Int] = state.env.continues
        if kind == "break" {
            labels = state.env.breaks
        }
        if len(labels) == 0 { return err("dynamic backend: loop control is outside a loop") }
        let label: Int = unwrap_or(array_get(labels, len(labels) - 1), -1)
        return ok(emit_jump(state, label, false, u8(0)))
    }
    if kind == "return" {
        if state.env.in_function {
            let value: KIRTypedNodeView = field(statement, "return")
            let return_type: String = unwrap_or(map_get(state.env.function_returns, state.env.current_function), "Nil")
            let mut current: EmitState = state
            let mut has_value: Bool = false
            if kir_typed_kind(value) != "null" {
                has_value = text(field(value, "kind")) != "nil"
            }
            if has_value {
                if return_type == "Nil" { return err("dynamic backend: Nil function cannot return a value") }
                let emitted: Result[EmitState, String] = emit_expression(current, value)
                if is_err(emitted) { return err(expression_error(emitted)) }
                current = result_unwrap(emitted)
            } else if return_type != "Nil" {
                return err("dynamic backend: scalar function must return a value")
            }
            return ok(append_code(current, [u8(201), u8(195)]))
        }
		let value: KIRTypedNodeView = field(statement, "return")
		if kir_typed_kind(value) != "null" && text(field(value, "kind")) != "nil" {
			let target: String = text(field(value, "call_target"))
			let mut emitted: Result[EmitState, String] = err("dynamic backend: return expression was not lowered")
			if starts_with(target, "function:") { emitted = emit_function_call(state, value) }
			else { emitted = emit_expression(state, value) }
			if is_err(emitted) { return err(expression_error(emitted)) }
			return ok(emit_jump(result_unwrap(emitted), state.env.end_label, false, u8(0)))
		}
        return ok(emit_jump(state, state.env.end_label, false, u8(0)))
    }
    return err("dynamic backend: unsupported statement kind '" + kind + "'")
}

fn compile_statements(state: EmitState, statements: KIRTypedNodeView) -> Result[EmitState, String] {
    let count: Int = result_unwrap(kir_typed_array_len(statements))
    let mut index: Int = 0
    let mut current: EmitState = state
    while index < count {
        let statement: KIRTypedNodeView = result_unwrap(kir_typed_array_get(statements, index))
        let next: Result[EmitState, String] = compile_statement(current, statement)
        if is_err(next) { return err(compile_error(next)) }
        current = result_unwrap(next)
        index = index + 1
    }
    return ok(current)
}

fn patch_code(state: EmitState, position: Int, bytes: Array[UInt8]) -> Result[EmitState, String] {
    if position < 0 || position + len(bytes) > state.code_pages.length { return err("dynamic backend: code patch out of bounds") }
    let mut patches: ChunkedCodePatches = state.code_patches
    let mut offset: Int = 0
    while offset < len(bytes) {
        let absolute_position: Int = position + offset
        let available_in_chunk: Int = 16 - (absolute_position % 16)
        let remaining: Int = len(bytes) - offset
        let mut segment_length: Int = available_in_chunk
        if remaining < segment_length { segment_length = remaining }
        let segment: Array[UInt8] = array_slice(bytes, offset, segment_length)
        patches = chunked_code_patch_push(patches, CodePatch{ position: absolute_position, bytes: segment })
        offset = offset + segment_length
    }
    return ok(EmitState{ assembler: state.assembler, env: state.env, code_patches: patches, code_pages: state.code_pages })
}

fn apply_code_patches(state: EmitState) -> Result[EmitState, String] {
    let patch_count: Int = state.code_patches.length
    let mut patch_index: Int = 0
    let mut next_patch: CodePatch = CodePatch{ position: -1, bytes: [] }
    let mut next_patch_chunk: Int = -1
    if patch_count > 0 {
        next_patch = unwrap_or(chunked_code_patch_get(state.code_patches, 0), CodePatch{ position: -1, bytes: [] })
        if next_patch.position < 0 || next_patch.position + len(next_patch.bytes) > state.code_pages.length { return err("dynamic backend: invalid deferred code patch") }
        next_patch_chunk = next_patch.position / 16
    }
    let mut rebuilt_pages: Array[Array[Array[UInt8]]] = []
    let mut page_index: Int = 0
    while page_index < len(state.code_pages.pages) {
        let old_page: Array[Array[UInt8]] = unwrap_or(array_get(state.code_pages.pages, page_index), [])
        let mut rebuilt_page: Array[Array[UInt8]] = []
        let mut chunk_offset: Int = 0
        while chunk_offset < len(old_page) {
            let chunk_index: Int = page_index * 128 + chunk_offset
            let old_chunk: Array[UInt8] = unwrap_or(array_get(old_page, chunk_offset), [])
            let mut rebuilt_chunk: Array[UInt8] = old_chunk
            if patch_index < patch_count && next_patch_chunk < chunk_index { return err("dynamic backend: deferred code patches are not ordered by position") }
            while patch_index < patch_count && next_patch_chunk == chunk_index {
                let mut patch_offset: Int = 0
                while patch_offset < len(next_patch.bytes) {
                    let local_position: Int = next_patch.position % 16 + patch_offset
                    if local_position >= len(old_chunk) { return err("dynamic backend: deferred patch crosses a code chunk") }
                    let value: UInt8 = unwrap_or(array_get(next_patch.bytes, patch_offset), u8(0))
                    let replaced: Result[Array[UInt8], String] = array_set(rebuilt_chunk, local_position, value)
                    if is_err(replaced) { return err("dynamic backend: cannot replace a patched code byte") }
                    rebuilt_chunk = result_unwrap(replaced)
                    patch_offset = patch_offset + 1
                }
                patch_index = patch_index + 1
                if patch_index < patch_count {
                    next_patch = unwrap_or(chunked_code_patch_get(state.code_patches, patch_index), CodePatch{ position: -1, bytes: [] })
                    if next_patch.position < 0 || next_patch.position + len(next_patch.bytes) > state.code_pages.length { return err("dynamic backend: invalid deferred code patch") }
                    next_patch_chunk = next_patch.position / 16
                    if next_patch_chunk < chunk_index { return err("dynamic backend: deferred code patches are not ordered by position") }
                } else {
                    next_patch_chunk = -1
                }
            }
            rebuilt_page = array_push(rebuilt_page, rebuilt_chunk)
            chunk_offset = chunk_offset + 1
        }
        rebuilt_pages = array_push(rebuilt_pages, rebuilt_page)
        page_index = page_index + 1
    }
    if patch_index != patch_count { return err("dynamic backend: deferred code patch is outside the code chunks") }
    let rebuilt: ChunkedCode = ChunkedCode{ pages: rebuilt_pages, chunk_count: state.code_pages.chunk_count, length: state.code_pages.length }
    return ok(EmitState{ assembler: state.assembler, env: state.env, code_patches: ChunkedCodePatches{ pages: [], length: 0 }, code_pages: rebuilt })
}

fn finalize_jumps(state: EmitState) -> Result[EmitState, String] {
    let mut current: EmitState = state
    let jump_count: Int = current.assembler.jumps.length
    let mut index: Int = 0
    while index < jump_count {
        let patch: JumpPatch = unwrap_or(chunked_jump_get(current.assembler.jumps, index), JumpPatch{ label: -1, position: -1, function: "" })
        let target: Option[Int] = map_get(current.assembler.labels, str(patch.label))
        if is_none(target) || unwrap_or(target, -1) < 0 { return err("dynamic backend: unresolved label " + str(patch.label) + " at patch " + str(patch.position) + " in function '" + patch.function + "' (label count " + str(current.assembler.next_label) + ")") }
        let target_position: Int = unwrap_or(target, -1)
        let updated: Result[EmitState, String] = patch_code(current, patch.position, i32_bytes(target_position - patch.position - 4))
        if is_err(updated) { return err(unwrap_or(result_error(updated), "dynamic backend: jump patch failed")) }
        current = result_unwrap(updated)
        index = index + 1
    }
    return ok(current)
}

fn finalize_data(state: EmitState) -> Result[EmitState, String] {
    let mut current: EmitState = state
    for index in array_indices(current.assembler.common.data_patches) {
        let patch: DataPatch = unwrap_or(array_get(current.assembler.common.data_patches, index), DataPatch{ displacement: -1, instruction_end: -1, data_offset: -1 })
        let data_address: Int = 120 + current.assembler.code_state.code_length + patch.data_offset
        let next_instruction: Int = 120 + patch.instruction_end
        let updated: Result[EmitState, String] = patch_code(current, patch.displacement, i32_bytes(data_address - next_instruction))
        if is_err(updated) { return err(unwrap_or(result_error(updated), "dynamic backend: data patch failed")) }
        current = result_unwrap(updated)
    }
    return ok(current)
}

fn align_frame(value: Int) -> Int {
    let remainder: Int = value % 16
    if remainder == 0 { return value }
    return value + (16 - remainder)
}

fn new_dynamic_state() -> EmitState {
    let assembler: Assembler = Assembler{ code_state: AssemblerCode{ code: [], code_chunks: [], code_length: 0 }, labels: {}, next_label: 0, jumps: ChunkedJumpPatches{ pages: [], length: 0 }, common: AssemblerCommon{ data: [], data_by_text: {}, string_data_by_text: {}, data_patches: [], frame_patch: -1, string_concat_label: -1, string_concat_used: false, array_alloc_label: -1, array_push_label: -1, array_concat_label: -1, array_runtime_used: false, box_alloc_label: -1, box_runtime_used: false, host_runtime_used: false, ffi_runtime_used: false, windows_abi: false, windows_stack_depth: 0, import_patches: [], function_ranges: [] } }
    let env: CompileEnv = CompileEnv{ slots: {}, static_values: {}, struct_fields: {}, function_labels: {}, function_returns: {}, next_slot: 0, breaks: [], continues: [], end_label: -1, trap_label: -1, buffer_offset: 1, in_function: false, current_function: "" }
    return EmitState{ assembler: assembler, env: env, code_patches: ChunkedCodePatches{ pages: [], length: 0 }, code_pages: ChunkedCode{ pages: [], chunk_count: 0, length: 0 } }
}

fn count_slots(statements: KIRTypedNodeView) -> Int {
    let count: Int = result_unwrap(kir_typed_array_len(statements))
    let mut index: Int = 0
    let mut total: Int = 0
    while index < count {
        let statement: KIRTypedNodeView = result_unwrap(kir_typed_array_get(statements, index))
        let kind: String = text(field(statement, "kind"))
        if kind == "let" || kind == "const" {
            total = total + 1
        }
        if kind == "if" {
            total = total + count_slots(field(statement, "then"))
            total = total + count_slots(field(statement, "else"))
        }
        if kind == "while" {
            total = total + count_slots(field(statement, "body"))
        }
        if kind == "for" {
            total = total + 3 + count_slots(field(statement, "body"))
        }
        if kind == "match" {
            total = total + 1
            let arms: KIRTypedNodeView = field(statement, "arms")
            let arm_count: Int = result_unwrap(kir_typed_array_len(arms))
            let mut arm_index: Int = 0
            while arm_index < arm_count {
                let arm: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arms, arm_index))
                total = total + count_slots(field(arm, "body"))
                arm_index = arm_index + 1
            }
        }
        index = index + 1
    }
    return total
}

fn count_function_slots(statements: KIRTypedNodeView, struct_fields: Map[String, KIRTypedNodeView]) -> Result[Int, String] {
    let count: Int = result_unwrap(kir_typed_array_len(statements))
    let mut index: Int = 0
    let mut total: Int = 0
    while index < count {
        let statement: KIRTypedNodeView = result_unwrap(kir_typed_array_get(statements, index))
        let kind: String = text(field(statement, "kind"))
        if kind == "let" || kind == "const" {
            let type_name: String = expr_type(field(statement, "init"))
            if !is_scalar_type(type_name) && !map_contains_key(struct_fields, type_name) { return err("dynamic backend: function local '" + text(field(statement, "name")) + "' has unsupported type '" + type_name + "'") }
            total = total + 1
        }
        if kind == "if" {
            let then_count: Result[Int, String] = count_function_slots(field(statement, "then"), struct_fields)
            if is_err(then_count) { return err(unwrap_or(result_error(then_count), "dynamic backend: function local scan failed")) }
            total = total + result_unwrap(then_count)
            let else_count: Result[Int, String] = count_function_slots(field(statement, "else"), struct_fields)
            if is_err(else_count) { return err(unwrap_or(result_error(else_count), "dynamic backend: function local scan failed")) }
            total = total + result_unwrap(else_count)
        }
        if kind == "while" {
            let body_count: Result[Int, String] = count_function_slots(field(statement, "body"), struct_fields)
            if is_err(body_count) { return err(unwrap_or(result_error(body_count), "dynamic backend: function local scan failed")) }
            total = total + result_unwrap(body_count)
        }
        if kind == "for" {
            total = total + 3
            let body_count: Result[Int, String] = count_function_slots(field(statement, "body"), struct_fields)
            if is_err(body_count) { return err(unwrap_or(result_error(body_count), "dynamic backend: function loop scan failed")) }
            total = total + result_unwrap(body_count)
        }
        if kind == "match" {
            total = total + 1
            let arms: KIRTypedNodeView = field(statement, "arms")
            let arm_count: Int = result_unwrap(kir_typed_array_len(arms))
            let mut arm_index: Int = 0
            while arm_index < arm_count {
                let arm: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arms, arm_index))
                let body_count: Result[Int, String] = count_function_slots(field(arm, "body"), struct_fields)
                if is_err(body_count) { return err(unwrap_or(result_error(body_count), "dynamic backend: function match arm scan failed")) }
                total = total + result_unwrap(body_count)
                arm_index = arm_index + 1
            }
        }
        index = index + 1
    }
    return ok(total)
}

fn collect_struct_fields(structs: KIRTypedNodeView) -> Map[String, KIRTypedNodeView] {
    let mut result: Map[String, KIRTypedNodeView] = {}
    let count: Int = result_unwrap(kir_typed_array_len(structs))
    let mut index: Int = 0
    while index < count {
        let definition: KIRTypedNodeView = result_unwrap(kir_typed_array_get(structs, index))
        result = map_insert(result, text(field(definition, "name")), field(definition, "fields"))
        index = index + 1
    }
    return result
}

fn collect_type_fields(structs: KIRTypedNodeView, enums: KIRTypedNodeView) -> Map[String, KIRTypedNodeView] {
    let mut result: Map[String, KIRTypedNodeView] = collect_struct_fields(structs)
    let count: Int = result_unwrap(kir_typed_array_len(enums))
    let mut index: Int = 0
    while index < count {
        let definition: KIRTypedNodeView = result_unwrap(kir_typed_array_get(enums, index))
        result = map_insert(result, text(field(definition, "name")), field(definition, "variants"))
        index = index + 1
    }
    return result
}

fn enum_variant_index(type_fields: Map[String, KIRTypedNodeView], enum_name: String, variant_name: String) -> Int {
    let variants: Option[KIRTypedNodeView] = map_get(type_fields, enum_name)
    if is_none(variants) { return -1 }
    let values: KIRTypedNodeView = unwrap_or(variants, kir_typed_empty_array())
    let count: Int = result_unwrap(kir_typed_array_len(values))
    let mut index: Int = 0
    while index < count {
        if text(result_unwrap(kir_typed_array_get(values, index))) == variant_name { return index }
        index = index + 1
    }
    return -1
}

fn validate_fieldless_enum_match(statement: KIRTypedNodeView, enum_name: String, variants: KIRTypedNodeView, backend: String) -> Result[Bool, String] {
    let arms: KIRTypedNodeView = field(statement, "arms")
    if kir_typed_kind(arms) != "array" { return err(backend + ": match arms must be an array") }
    let arm_count: Int = result_unwrap(kir_typed_array_len(arms))
    if arm_count == 0 { return err(backend + ": enum match must contain at least one arm") }
    if kir_typed_kind(variants) != "array" { return err(backend + ": enum '" + enum_name + "' has malformed variants") }
    let variant_count: Int = result_unwrap(kir_typed_array_len(variants))
    if variant_count == 0 { return err(backend + ": enum '" + enum_name + "' has no variants") }
    let mut declared: Map[String, Bool] = {}
    let mut variant_index: Int = 0
    while variant_index < variant_count {
        let variant_value: KIRTypedNodeView = result_unwrap(kir_typed_array_get(variants, variant_index))
        if kir_typed_kind(variant_value) != "string" { return err(backend + ": enum '" + enum_name + "' has a malformed variant") }
        let declared_variant_name: String = text(variant_value)
        if declared_variant_name == "" || map_contains_key(declared, declared_variant_name) { return err(backend + ": enum '" + enum_name + "' has an empty or duplicate variant") }
        declared = map_insert(declared, declared_variant_name, true)
        variant_index = variant_index + 1
    }
    let mut seen: Map[String, Bool] = {}
    let mut has_wildcard: Bool = false
    let mut arm_index: Int = 0
    while arm_index < arm_count {
        let arm: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arms, arm_index))
        if kir_typed_kind(arm) != "object" { return err(backend + ": enum match contains a malformed arm") }
        let pattern: KIRTypedNodeView = field(arm, "pattern")
        if kir_typed_kind(pattern) != "object" { return err(backend + ": enum match arm has no pattern") }
        let pattern_kind: String = text(field(pattern, "kind"))
        if pattern_kind == "wildcard" {
            if arm_index != arm_count - 1 { return err(backend + ": wildcard enum match arm must be last") }
            if text(field(pattern, "type")) != "" || text(field(pattern, "variant")) != "" || text(field(pattern, "binding")) != "" { return err(backend + ": malformed wildcard enum match pattern") }
            has_wildcard = true
        } else if pattern_kind == "enum" {
            if text(field(pattern, "type")) != enum_name { return err(backend + ": match pattern type must be '" + enum_name + "'") }
            if text(field(pattern, "binding")) != "" { return err(backend + ": fieldless-enum patterns cannot bind a payload") }
            let pattern_variant_name: String = text(field(pattern, "variant"))
            if !map_contains_key(declared, pattern_variant_name) { return err(backend + ": unknown enum variant '" + enum_name + "::" + pattern_variant_name + "'") }
            if map_contains_key(seen, pattern_variant_name) { return err(backend + ": enum match repeats variant '" + pattern_variant_name + "'") }
            seen = map_insert(seen, pattern_variant_name, true)
        } else {
            return err(backend + ": only fieldless-enum patterns and a final wildcard are supported in match")
        }
        let body: KIRTypedNodeView = field(arm, "body")
        if kir_typed_kind(body) != "array" { return err(backend + ": enum match arm body must be an array") }
        arm_index = arm_index + 1
    }
    if !has_wildcard {
        variant_index = 0
        while variant_index < variant_count {
            let missing_variant_name: String = text(result_unwrap(kir_typed_array_get(variants, variant_index)))
            if !map_contains_key(seen, missing_variant_name) { return err(backend + ": enum match is not exhaustive; missing '" + missing_variant_name + "'") }
            variant_index = variant_index + 1
        }
    }
    return ok(true)
}

fn emit_fieldless_enum_match(state: EmitState, statement: KIRTypedNodeView) -> Result[EmitState, String] {
    let scrutinee: KIRTypedNodeView = field(statement, "scrutinee")
    if kir_typed_kind(scrutinee) != "object" { return err("dynamic backend: match is missing its scrutinee") }
    let enum_name: String = expr_type(scrutinee)
    if !is_enum_type(state.env.struct_fields, enum_name) { return err("dynamic backend: match scrutinee must be a fieldless enum") }
    let variants_option: Option[KIRTypedNodeView] = map_get(state.env.struct_fields, enum_name)
    let variants: KIRTypedNodeView = unwrap_or(variants_option, kir_typed_empty_array())
    let valid: Result[Bool, String] = validate_fieldless_enum_match(statement, enum_name, variants, "dynamic backend")
    if is_err(valid) { return err(unwrap_or(result_error(valid), "dynamic backend: invalid enum match")) }
    let temporary_slot: Int = state.env.next_slot + 8
    let evaluated: Result[EmitState, String] = emit_expression(state, scrutinee)
    if is_err(evaluated) { return err(expression_error(evaluated)) }
    let stored: EmitState = emit_store_slot(result_unwrap(evaluated), temporary_slot)
    let scope: CompileEnv = stored.env
    let join: LabelState = new_label(stored)
    let mut current: EmitState = join.state
    let mut maximum_slot: Int = temporary_slot
    let arms: KIRTypedNodeView = field(statement, "arms")
    let arm_count: Int = result_unwrap(kir_typed_array_len(arms))
    let mut arm_index: Int = 0
    while arm_index < arm_count {
        let arm: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arms, arm_index))
        let pattern: KIRTypedNodeView = field(arm, "pattern")
        let pattern_kind: String = text(field(pattern, "kind"))
        let mut next_arm_label: Int = -1
        if pattern_kind == "enum" {
            let variant_name: String = text(field(pattern, "variant"))
            let tag: Int = enum_variant_index(scope.struct_fields, enum_name, variant_name)
            if tag < 0 { return err("dynamic backend: unknown enum variant '" + enum_name + "::" + variant_name + "'") }
            let next_arm: LabelState = new_label(current)
            next_arm_label = next_arm.label
            current = emit_load_slot(next_arm.state, temporary_slot)
            current = append_code(current, array_concat([u8(72), u8(61)], i32_bytes(tag)))
            current = emit_jump(current, next_arm.label, true, u8(133))
        }
        let arm_scope: EmitState = state_with_scope(current, scope, temporary_slot)
        let body: Result[EmitState, String] = compile_statements(arm_scope, field(arm, "body"))
        if is_err(body) { return err(compile_error(body)) }
        let body_state: EmitState = result_unwrap(body)
        if body_state.env.next_slot > maximum_slot { maximum_slot = body_state.env.next_slot }
        current = emit_jump(body_state, join.label, false, u8(0))
        if next_arm_label >= 0 {
            let bound_next: Result[EmitState, String] = bind_label(current, next_arm_label)
            if is_err(bound_next) { return err(unwrap_or(result_error(bound_next), "dynamic backend: cannot bind enum match arm")) }
            current = state_with_scope(result_unwrap(bound_next), scope, temporary_slot)
        }
        arm_index = arm_index + 1
    }
    let last_arm: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arms, arm_count - 1))
    let last_pattern: KIRTypedNodeView = field(last_arm, "pattern")
    if text(field(last_pattern, "kind")) != "wildcard" { current = emit_jump(current, scope.trap_label, false, u8(0)) }
    let bound_join: Result[EmitState, String] = bind_label(current, join.label)
    if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind enum match join")) }
    return ok(state_with_scope(result_unwrap(bound_join), scope, maximum_slot))
}

fn entry_statements(document: KIRTypedNodeView) -> KIRTypedNodeView {
    let statements: KIRTypedNodeView = field(document, "statements")
    if result_unwrap(kir_typed_array_len(statements)) > 0 {
        return statements
    }
    let functions: KIRTypedNodeView = field(document, "functions")
    let count: Int = result_unwrap(kir_typed_array_len(functions))
    let mut index: Int = 0
    while index < count {
        let function: KIRTypedNodeView = result_unwrap(kir_typed_array_get(functions, index))
        if text(field(function, "name")) == "main" {
            return field(function, "body")
        }
        index = index + 1
    }
    return kir_typed_empty_array()
}

fn is_scalar_type(type_name: String) -> Bool {
    return type_name == "Int" || type_name == "Bool" || type_name == "String" || type_name == "Bytes" || type_name == "Json" || type_name == "FFILibrary" || type_name == "FFISymbol" || type_name == "FFIBuffer" || starts_with(type_name, "UInt") || starts_with(type_name, "Array[") || starts_with(type_name, "Option[") || starts_with(type_name, "Result[") || starts_with(type_name, "Map[")
}

fn prepare_function_labels(state: EmitState, functions: KIRTypedNodeView) -> Result[EmitState, String] {
    let count: Int = result_unwrap(kir_typed_array_len(functions))
    let mut index: Int = 0
    let mut current: EmitState = state
    while index < count {
        let function: KIRTypedNodeView = result_unwrap(kir_typed_array_get(functions, index))
        let name: String = text(field(function, "name"))
        if name != "main" {
            if map_contains_key(current.env.function_labels, name) { return err("dynamic backend: duplicate function '" + name + "'") }
            let parameters: KIRTypedNodeView = field(function, "params")
            let parameter_count: Int = result_unwrap(kir_typed_array_len(parameters))
            if !state.assembler.common.windows_abi && parameter_count > 6 { return err("dynamic backend: function '" + name + "' has too many parameters") }
            let return_type: String = text(field(function, "return"))
            if return_type != "Nil" && !is_supported_type(state.env, return_type) { return err("dynamic backend: function '" + name + "' has unsupported return type '" + return_type + "'") }
            let mut parameter_index: Int = 0
            while parameter_index < parameter_count {
                let parameter: KIRTypedNodeView = result_unwrap(kir_typed_array_get(parameters, parameter_index))
                if !is_supported_type(state.env, text(field(parameter, "type"))) { return err("dynamic backend: function '" + name + "' has an unsupported parameter type") }
                parameter_index = parameter_index + 1
            }
            let created: LabelState = new_label(current)
            let env: CompileEnv = CompileEnv{ slots: created.state.env.slots, static_values: created.state.env.static_values, struct_fields: created.state.env.struct_fields, function_labels: map_insert(created.state.env.function_labels, name, created.label), function_returns: map_insert(created.state.env.function_returns, name, return_type), next_slot: created.state.env.next_slot, breaks: created.state.env.breaks, continues: created.state.env.continues, end_label: created.state.env.end_label, trap_label: created.state.env.trap_label, buffer_offset: created.state.env.buffer_offset, in_function: created.state.env.in_function, current_function: created.state.env.current_function }
            current = state_with_env(created.state, env)
        }
        index = index + 1
    }
    return ok(current)
}

fn emit_function_bodies(state: EmitState, functions: KIRTypedNodeView, index: Int, base_env: CompileEnv) -> Result[EmitState, String] {
    let count: Int = result_unwrap(kir_typed_array_len(functions))
    let mut current: EmitState = state
    let mut current_index: Int = index
    while current_index < count {
            let function: KIRTypedNodeView = result_unwrap(kir_typed_array_get(functions, current_index))
            let name: String = text(field(function, "name"))
        if name != "main" {
            let label: Int = unwrap_or(map_get(base_env.function_labels, name), -1)
            let bound: Result[EmitState, String] = bind_label(current, label)
            if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind function label")) }
            let function_begin: Int = result_unwrap(bound).assembler.code_state.code_length
            let parameters: KIRTypedNodeView = field(function, "params")
            let parameter_count: Int = result_unwrap(kir_typed_array_len(parameters))
            let locals: Result[Int, String] = count_function_slots(field(function, "body"), base_env.struct_fields)
            if is_err(locals) { return err(unwrap_or(result_error(locals), "dynamic backend: function local scan failed")) }
            let next_slot: Int = parameter_count * 8 + result_unwrap(locals) * 8
            let buffer_offset: Int = next_slot + 1
            let function_env: CompileEnv = CompileEnv{ slots: parameter_slots(parameters), static_values: {}, struct_fields: base_env.struct_fields, function_labels: base_env.function_labels, function_returns: base_env.function_returns, next_slot: parameter_count * 8, breaks: [], continues: [], end_label: base_env.end_label, trap_label: base_env.trap_label, buffer_offset: buffer_offset, in_function: true, current_function: name }
            let function_frame: Int = align_frame(buffer_offset + 63)
            let framed: EmitState = emit_function_frame(state_with_env(result_unwrap(bound), function_env), function_frame)
            let mut stored: Result[EmitState, String] = ok(framed)
            let mut parameter_index: Int = 0
            while parameter_index < parameter_count {
                let parameter: KIRTypedNodeView = result_unwrap(kir_typed_array_get(parameters, parameter_index))
                let slot: Int = unwrap_or(map_get(function_env.slots, text(field(parameter, "name"))), -1)
                let next: Result[EmitState, String] = emit_store_arg(result_unwrap(stored), parameter_index, slot)
                if is_err(next) { return err(unwrap_or(result_error(next), "dynamic backend: parameter storage failed")) }
                stored = next
                parameter_index = parameter_index + 1
            }
            let body: Result[EmitState, String] = compile_statements(result_unwrap(stored), field(function, "body"))
            if is_err(body) { return err(compile_error(body)) }
            current = append_code(result_unwrap(body), [u8(201), u8(195)])
            if current.assembler.common.windows_abi {
                let ranges: Array[Array[Int]] = array_push(current.assembler.common.function_ranges, [function_begin, current.assembler.code_state.code_length, function_frame])
                current = state_with_function_ranges(current, ranges)
            }
        }
        current_index = current_index + 1
    }
    return ok(state_with_env(current, base_env))
}

fn expression_uses_runtime(expression: KIRTypedNodeView, target: String) -> Bool {
    if kir_typed_kind(expression) == "null" { return false }
    let kind: String = text(field(expression, "kind"))
    if kind == "call" {
        let call_target: String = text(field(expression, "call_target"))
        if call_target == target {
            let arguments: KIRTypedNodeView = field(expression, "args")
            let argument_count: Int = result_unwrap(kir_typed_array_len(arguments))
            if argument_count != 1 { return true }
            let argument: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
            let argument_type: String = expr_type(argument)
            if target == "builtin:str" && argument_type != "String" { return true }
            if target == "builtin:int" && argument_type == "String" { return true }
        }
        let arguments: KIRTypedNodeView = field(expression, "args")
        let count: Int = result_unwrap(kir_typed_array_len(arguments))
        let mut index: Int = 0
        while index < count {
            if expression_uses_runtime(result_unwrap(kir_typed_array_get(arguments, index)), target) { return true }
            index = index + 1
        }
        return false
    }
    if kind == "binary" {
        return expression_uses_runtime(field(expression, "left"), target) || expression_uses_runtime(field(expression, "right"), target)
    }
    if kind == "unary" || kind == "propagate" {
        return expression_uses_runtime(field(expression, "operand"), target)
    }
    if kind == "index" {
        return expression_uses_runtime(field(expression, "base"), target) || expression_uses_runtime(field(expression, "left"), target)
    }
    if kind == "field" { return expression_uses_runtime(field(expression, "base"), target) }
    if kind == "array" || kind == "set" {
        let items: KIRTypedNodeView = field(expression, "items")
        let count: Int = result_unwrap(kir_typed_array_len(items))
        let mut index: Int = 0
        while index < count {
            if expression_uses_runtime(result_unwrap(kir_typed_array_get(items, index)), target) { return true }
            index = index + 1
        }
        return false
    }
    if kind == "map" {
        let keys: KIRTypedNodeView = field(expression, "map_keys")
        let key_count: Int = result_unwrap(kir_typed_array_len(keys))
        let mut index: Int = 0
        while index < key_count {
            if expression_uses_runtime(result_unwrap(kir_typed_array_get(keys, index)), target) { return true }
            index = index + 1
        }
    }
    if kind == "struct" || kind == "map" {
        let values: KIRTypedNodeView = field(expression, "values")
        let value_count: Int = result_unwrap(kir_typed_array_len(values))
        let mut value_index: Int = 0
        while value_index < value_count {
            if expression_uses_runtime(result_unwrap(kir_typed_array_get(values, value_index)), target) { return true }
            value_index = value_index + 1
        }
    }
    return false
}

fn statements_use_runtime(statements: KIRTypedNodeView, target: String) -> Bool {
    let count: Int = result_unwrap(kir_typed_array_len(statements))
    let mut index: Int = 0
    while index < count {
        let statement: KIRTypedNodeView = result_unwrap(kir_typed_array_get(statements, index))
        let kind: String = text(field(statement, "kind"))
        if kind == "let" || kind == "const" {
            if expression_uses_runtime(field(statement, "init"), target) { return true }
        }
        if kind == "expr" {
            if expression_uses_runtime(field(statement, "expr"), target) { return true }
        }
        if kind == "assign" {
            if expression_uses_runtime(field(statement, "target"), target) { return true }
            if expression_uses_runtime(field(statement, "value"), target) { return true }
        }
        if kind == "if" {
            if expression_uses_runtime(field(statement, "cond"), target) { return true }
            if statements_use_runtime(field(statement, "then"), target) { return true }
            if statements_use_runtime(field(statement, "else"), target) { return true }
        }
        if kind == "while" {
            if expression_uses_runtime(field(statement, "cond"), target) { return true }
            if statements_use_runtime(field(statement, "body"), target) { return true }
        }
        if kind == "return" {
            if expression_uses_runtime(field(statement, "return"), target) { return true }
        }
        if kind == "for" {
            if expression_uses_runtime(field(statement, "iter"), target) { return true }
            if statements_use_runtime(field(statement, "body"), target) { return true }
        }
        if kind == "match" {
            if expression_uses_runtime(field(statement, "scrutinee"), target) { return true }
            let arms: KIRTypedNodeView = field(statement, "arms")
            let arm_count: Int = result_unwrap(kir_typed_array_len(arms))
            let mut arm_index: Int = 0
            while arm_index < arm_count {
                let arm: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arms, arm_index))
                if statements_use_runtime(field(arm, "body"), target) { return true }
                arm_index = arm_index + 1
            }
        }
        if kind == "defer" {
            if expression_uses_runtime(field(statement, "expr"), target) { return true }
        }
        if kind == "unsafe" {
            if statements_use_runtime(field(statement, "body"), target) { return true }
        }
        index = index + 1
    }
    return false
}

fn document_uses_runtime(document: KIRTypedNodeView, target: String) -> Bool {
    if statements_use_runtime(field(document, "statements"), target) { return true }
    let functions: KIRTypedNodeView = field(document, "functions")
    let function_count: Int = result_unwrap(kir_typed_array_len(functions))
    let mut function_index: Int = 0
    while function_index < function_count {
        let function: KIRTypedNodeView = result_unwrap(kir_typed_array_get(functions, function_index))
        if statements_use_runtime(field(function, "body"), target) { return true }
        let parameters: KIRTypedNodeView = field(function, "params")
        let parameter_count: Int = result_unwrap(kir_typed_array_len(parameters))
        let mut parameter_index: Int = 0
        while parameter_index < parameter_count {
            let parameter: KIRTypedNodeView = result_unwrap(kir_typed_array_get(parameters, parameter_index))
            if expression_uses_runtime(field(parameter, "default"), target) { return true }
            parameter_index = parameter_index + 1
        }
        function_index = function_index + 1
    }
    return false
}

fn pe_scalar_type(type_name: String) -> Bool {
    if type_name == "Int" || type_name == "Bool" { return true }
    let type_length: Int = len(string_chars(type_name))
    if type_length == 5 { return type_name == "Bytes" || type_name == "UInt8" }
    if type_length == 6 { return type_name == "String" || type_name == "UInt16" || type_name == "UInt32" || type_name == "UInt64" }
    return false
}

fn pe_array_element_type(type_name: String) -> String {
    if !starts_with(type_name, "Array[") || !ends_with(type_name, "]") { return "" }
    let count: Int = len(string_chars(type_name))
    if count < 8 { return "" }
    let element_type: Result[String, String] = substring(type_name, 6, count - 7)
    if is_err(element_type) { return "" }
    return pe_trim_type_text(result_unwrap(element_type))
}

fn pe_is_supported_array_type(enums: KIRTypedNodeView, type_name: String) -> Bool {
    let element_type: String = pe_array_element_type(type_name)
    return element_type != "" && pe_supported_type(enums, element_type)
}

fn pe_trim_type_text(value: String) -> String {
    if !starts_with(value, " ") && !ends_with(value, " ") { return value }
    let char_count: Int = len(string_chars(value))
    let mut start: Int = 0
    while start < char_count {
        let leading_character: Result[String, String] = substring(value, start, 1)
        if is_err(leading_character) { return "" }
        if result_unwrap(leading_character) != " " { break }
        start = start + 1
    }
    let mut end: Int = char_count
    while end > start {
        let trailing_character: Result[String, String] = substring(value, end - 1, 1)
        if is_err(trailing_character) { return "" }
        if result_unwrap(trailing_character) != " " { break }
        end = end - 1
    }
    let trimmed: Result[String, String] = substring(value, start, end - start)
    if is_err(trimmed) { return "" }
    return result_unwrap(trimmed)
}

fn pe_map_value_type(type_name: String) -> String {
    if !starts_with(type_name, "Map[") || !ends_with(type_name, "]") { return "" }
    if starts_with(type_name, "Map[String,") {
        let count: Int = len(string_chars(type_name))
        if count <= 12 { return "" }
        let value_type: Result[String, String] = substring(type_name, 11, count - 12)
        if is_err(value_type) { return "" }
        return pe_trim_type_text(result_unwrap(value_type))
    }
    let count: Int = len(string_chars(type_name))
    let mut index: Int = 4
    let mut depth: Int = 0
    let mut comma: Int = -1
    while index < count - 1 {
        let current_result: Result[String, String] = substring(type_name, index, 1)
        if is_err(current_result) { return "" }
        let current: String = result_unwrap(current_result)
        if current == "[" {
            depth = depth + 1
        } else if current == "]" {
            if depth > 0 { depth = depth - 1 }
        } else if current == "," && depth == 0 {
            comma = index
            break
        }
        index = index + 1
    }
    if comma < 0 { return "" }
    let key_type: Result[String, String] = substring(type_name, 4, comma - 4)
    if is_err(key_type) || pe_trim_type_text(result_unwrap(key_type)) != "String" { return "" }
    let value_type: Result[String, String] = substring(type_name, comma + 1, count - comma - 2)
    if is_err(value_type) { return "" }
    return pe_trim_type_text(result_unwrap(value_type))
}

fn pe_is_supported_string_map_type(enums: KIRTypedNodeView, type_name: String) -> Bool {
    let value_type: String = pe_map_value_type(type_name)
    return value_type != "" && pe_supported_type(enums, value_type)
}

fn pe_is_supported_option_type(enums: KIRTypedNodeView, struct_fields: Map[String, KIRTypedNodeView], type_name: String) -> Bool {
    let value_type: String = pe_generic_type_argument(type_name, "Option", 0)
    return value_type != "" && (pe_supported_type_with_structs(enums, struct_fields, value_type) || pe_is_supported_array_type(enums, value_type) || pe_is_supported_string_map_type(enums, value_type) || pe_is_ffi_handle_type(value_type) || pe_is_ffi_result_type(value_type) || pe_is_supported_result_type(enums, struct_fields, value_type))
}

fn pe_supported_local_type(enums: KIRTypedNodeView, struct_fields: Map[String, KIRTypedNodeView], type_name: String) -> Bool {
    return type_name == "Json" || pe_supported_type_with_structs(enums, struct_fields, type_name) || pe_is_supported_array_type(enums, type_name) || pe_is_supported_string_map_type(enums, type_name) || pe_is_supported_option_type(enums, struct_fields, type_name) || pe_is_ffi_handle_type(type_name) || pe_is_ffi_result_type(type_name) || pe_is_supported_result_type(enums, struct_fields, type_name)
}

fn pe_validate_json_call(expression: KIRTypedNodeView, enums: KIRTypedNodeView, struct_fields: Map[String, KIRTypedNodeView]) -> Result[Bool, String] {
    let target: String = text(field(expression, "call_target"))
    let result_type: String = pe_compact_type_spaces(expr_type(expression))
    let arguments: KIRTypedNodeView = field(expression, "args")
    let count: Int = result_unwrap(kir_typed_array_len(arguments))
    let mut expected_count: Int = 1
    let mut expected_type: String = ""
    if target == "builtin:json_parse" { expected_type = "Result[Json,String]" }
    else if target == "builtin:json_stringify" || target == "builtin:json_kind" { expected_type = "String" }
    else if target == "builtin:json_object_get" { expected_count = 2; expected_type = "Result[Json,String]" }
    else if target == "builtin:json_object_keys" { expected_type = "Result[Array[String],String]" }
    else if target == "builtin:json_object_keys_allowed" { expected_count = 2; expected_type = "Bool" }
    else if target == "builtin:json_object_fields_empty_except" { expected_count = 4; expected_type = "Bool" }
    else if target == "builtin:json_array_len" { expected_type = "Result[Int,String]" }
    else if target == "builtin:json_array_get" { expected_count = 2; expected_type = "Result[Json,String]" }
    else if target == "builtin:json_string" { expected_type = "Result[String,String]" }
    else if target == "builtin:json_bool" { expected_type = "Result[Bool,String]" }
    else if target == "builtin:json_int" { expected_type = "Result[Int,String]" }
    else if target == "builtin:json_uint" { expected_type = "Result[UInt64,String]" }
    else { return err("PE backend: unsupported JSON builtin '" + target + "'") }
    if count != expected_count || result_type != expected_type { return err("PE backend: '" + target + "' has an incompatible signature") }
    let first: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
    let mut expected_first: String = "Json"
    if target == "builtin:json_parse" { expected_first = "String" }
    if expr_type(first) != expected_first { return err("PE backend: '" + target + "' expects " + expected_first) }
    let checked_first: Result[Bool, String] = pe_validate_expression(first, false, false, enums, struct_fields)
    if is_err(checked_first) { return checked_first }
    if expected_count == 2 {
        let second: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 1))
        let mut expected_second: String = "String"
        if target == "builtin:json_array_get" { expected_second = "Int" }
        if expr_type(second) != expected_second { return err("PE backend: '" + target + "' expects " + expected_second + " as its second argument") }
        return pe_validate_expression(second, false, false, enums, struct_fields)
    }
    if expected_count == 4 {
        let mut index: Int = 1
        while index < 4 {
            let extra: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, index))
            if expr_type(extra) != "String" { return err("PE backend: '" + target + "' expects String arguments after Json") }
            let checked: Result[Bool, String] = pe_validate_expression(extra, false, false, enums, struct_fields)
            if is_err(checked) { return checked }
            index = index + 1
        }
        return ok(true)
    }
    if !pe_is_supported_result_type(enums, struct_fields, result_type) && starts_with(result_type, "Result[") { return err("PE backend: '" + target + "' returns an unsupported Result type") }
    return ok(true)
}

fn pe_is_function_call(expression: KIRTypedNodeView) -> Bool {
    if text(field(expression, "kind")) != "call" { return false }
    let target: String = text(field(expression, "call_target"))
    return starts_with(target, "function:") || target == "builtin:process_args"
}

fn pe_validate_function_arguments(expression: KIRTypedNodeView, enums: KIRTypedNodeView, struct_fields: Map[String, KIRTypedNodeView]) -> Result[Bool, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    let count: Int = result_unwrap(kir_typed_array_len(arguments))
    let mut index: Int = 0
    while index < count {
        let argument: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, index))
        let checked: Result[Bool, String] = pe_validate_expression(argument, false, false, enums, struct_fields)
        if is_err(checked) { return checked }
        index = index + 1
    }
    return ok(true)
}

fn pe_validate_map_expression(expression: KIRTypedNodeView, enums: KIRTypedNodeView, struct_fields: Map[String, KIRTypedNodeView], value_type: String) -> Result[Bool, String] {
    let map_type: String = expr_type(expression)
    if value_type == "" || !pe_supported_type(enums, value_type) { return err("PE backend: maps require String keys and scalar or fieldless-enum values") }
    let kind: String = text(field(expression, "kind"))
    if kind == "var" { return ok(true) }
    if pe_is_function_call(expression) { return pe_validate_function_arguments(expression, enums, struct_fields) }
    if kind != "map" { return err("PE backend: maps require a local literal or an existing local map") }
    let keys: KIRTypedNodeView = field(expression, "map_keys")
    let values: KIRTypedNodeView = field(expression, "values")
    let count: Int = result_unwrap(kir_typed_array_len(keys))
    if result_unwrap(kir_typed_array_len(values)) != count { return err("PE backend: map literal key/value count mismatch") }
    let mut seen: Map[String, Bool] = {}
    let mut index: Int = 0
    while index < count {
        let key: KIRTypedNodeView = result_unwrap(kir_typed_array_get(keys, index))
        let value: KIRTypedNodeView = result_unwrap(kir_typed_array_get(values, index))
        if text(field(key, "kind")) != "string" { return err("PE backend: map literal keys must be String literals") }
        if expr_type(value) != value_type { return err("PE backend: map literal values must match " + value_type) }
        let key_text: String = text(field(key, "string"))
        if map_contains_key(seen, key_text) { return err("PE backend: duplicate map literal key '" + key_text + "'") }
        let checked_value: Result[Bool, String] = pe_validate_expression(value, false, false, enums, struct_fields)
        if is_err(checked_value) { return checked_value }
        seen = map_insert(seen, key_text, true)
        index = index + 1
    }
    return ok(true)
}

fn pe_validate_map_call(expression: KIRTypedNodeView, enums: KIRTypedNodeView, struct_fields: Map[String, KIRTypedNodeView]) -> Result[Bool, String] {
    let target: String = text(field(expression, "call_target"))
    let args: KIRTypedNodeView = field(expression, "args")
    let count: Int = result_unwrap(kir_typed_array_len(args))
    if target == "builtin:map_contains_key" || target == "builtin:map_get" {
        if count != 2 { return err("PE backend: map lookup expects Map[String,T] and String") }
        let map_value: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
        let key: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 1))
        let map_value_type: String = pe_map_value_type(expr_type(map_value))
        if map_value_type == "" || !pe_supported_type(enums, map_value_type) || expr_type(key) != "String" { return err("PE backend: map lookup supports String-keyed maps with scalar or fieldless-enum values") }
        if target == "builtin:map_contains_key" && expr_type(expression) != "Bool" { return err("PE backend: map_contains_key must return Bool") }
        if target == "builtin:map_get" && expr_type(expression) != "Option[" + map_value_type + "]" { return err("PE backend: map_get must return Option[" + map_value_type + "]") }
        let checked_map: Result[Bool, String] = pe_validate_map_expression(map_value, enums, struct_fields, map_value_type)
        if is_err(checked_map) { return checked_map }
        return pe_validate_expression(key, false, false, enums, struct_fields)
    }
    if target == "builtin:unwrap_or" {
        if count != 2 { return err("PE backend: unwrap_or expects a supported Option[T] and a T fallback") }
        let option: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
        let fallback: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 1))
        let value_type: String = pe_generic_type_argument(expr_type(option), "Option", 0)
        if !pe_is_supported_option_type(enums, struct_fields, expr_type(option)) || value_type != expr_type(expression) || expr_type(fallback) != value_type {
            return err("PE backend: unwrap_or requires a supported Option[T] and matching T fallback")
        }
        let checked_option: Result[Bool, String] = pe_validate_expression(option, false, false, enums, struct_fields)
        if is_err(checked_option) { return checked_option }
        return pe_validate_expression(fallback, false, false, enums, struct_fields)
    }
    return err("PE backend: map builtins are not supported except read-only String-keyed lookup")
}

fn pe_validate_ffi_call(expression: KIRTypedNodeView, enums: KIRTypedNodeView, struct_fields: Map[String, KIRTypedNodeView]) -> Result[Bool, String] {
    let target: String = text(field(expression, "call_target"))
    let args: KIRTypedNodeView = field(expression, "args")
    let count: Int = result_unwrap(kir_typed_array_len(args))
    let return_type: String = pe_compact_type_spaces(expr_type(expression))
    if target == "builtin:ffi_library_open" {
        if count != 1 || return_type != "Result[FFILibrary,String]" { return err("PE backend: ffi_library_open expects String and returns Result[FFILibrary,String]") }
        let path: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
        if expr_type(path) != "String" { return err("PE backend: ffi_library_open expects a String path") }
        return pe_validate_expression(path, false, false, enums, struct_fields)
    }
    if target == "builtin:ffi_library_close" {
        if count != 1 || return_type != "Nil" { return err("PE backend: ffi_library_close expects FFILibrary and returns Nil") }
        let library: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
        if expr_type(library) != "FFILibrary" { return err("PE backend: ffi_library_close expects FFILibrary") }
        return pe_validate_expression(library, false, false, enums, struct_fields)
    }
    if target == "builtin:ffi_symbol" {
        if count != 2 || return_type != "Result[FFISymbol,String]" { return err("PE backend: ffi_symbol expects FFILibrary and String and returns Result[FFISymbol,String]") }
        let library: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
        let name: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 1))
        if expr_type(library) != "FFILibrary" || expr_type(name) != "String" { return err("PE backend: ffi_symbol expects FFILibrary and String") }
        let checked_library: Result[Bool, String] = pe_validate_expression(library, false, false, enums, struct_fields)
        if is_err(checked_library) { return checked_library }
        return pe_validate_expression(name, false, false, enums, struct_fields)
    }
    if target == "builtin:ffi_call" {
        if count != 3 || return_type != "Result[Int,String]" { return err("PE backend: ffi_call expects FFISymbol, a literal signature, and Array[Int]") }
        let symbol: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
        let signature: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 1))
        let values: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 2))
        if expr_type(symbol) != "FFISymbol" || expr_type(signature) != "String" || expr_type(values) != "Array[Int]" { return err("PE backend: ffi_call expects FFISymbol, a literal signature, and Array[Int]") }
        let mut arity: Int = -1
        if text(field(values, "kind")) == "array" { arity = result_unwrap(kir_typed_array_len(field(values, "items"))) }
        if arity < 0 && text(field(signature, "kind")) == "string" { arity = pe_ffi_signature_arity(text(field(signature, "string"))) }
        if arity < 0 { return err("PE backend: ffi_call signature must be a literal string") }
        let parsed_signature: Result[String, String] = pe_ffi_signature(signature, arity)
        if is_err(parsed_signature) { return err(unwrap_or(result_error(parsed_signature), "PE backend: invalid FFI signature")) }
        let checked_symbol: Result[Bool, String] = pe_validate_expression(symbol, false, false, enums, struct_fields)
        if is_err(checked_symbol) { return checked_symbol }
        return pe_validate_expression(values, false, false, enums, struct_fields)
    }
    if target == "builtin:ffi_buffer_new" {
        if count != 1 || return_type != "FFIBuffer" { return err("PE backend: ffi_buffer_new expects Bytes and returns FFIBuffer") }
        let bytes: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
        if expr_type(bytes) != "Bytes" { return err("PE backend: ffi_buffer_new expects Bytes") }
        return pe_validate_expression(bytes, false, false, enums, struct_fields)
    }
    if target == "builtin:ffi_buffer_new_sized" {
        if count != 1 || return_type != "Result[FFIBuffer,String]" { return err("PE backend: ffi_buffer_new_sized expects Int and returns Result[FFIBuffer,String]") }
        let capacity: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
        if expr_type(capacity) != "Int" { return err("PE backend: ffi_buffer_new_sized expects Int") }
        return pe_validate_expression(capacity, false, false, enums, struct_fields)
    }
    if target == "builtin:ffi_buffer_address" {
        if count != 1 || return_type != "Result[Int,String]" { return err("PE backend: ffi_buffer_address expects FFIBuffer and returns Result[Int,String]") }
        let buffer: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
        if expr_type(buffer) != "FFIBuffer" { return err("PE backend: ffi_buffer_address expects FFIBuffer") }
        return pe_validate_expression(buffer, false, false, enums, struct_fields)
    }
    if target == "builtin:ffi_buffer_read" {
        if count != 1 || return_type != "Result[Bytes,String]" { return err("PE backend: ffi_buffer_read expects FFIBuffer and returns Result[Bytes,String]") }
        let buffer: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
        if expr_type(buffer) != "FFIBuffer" { return err("PE backend: ffi_buffer_read expects FFIBuffer") }
        return pe_validate_expression(buffer, false, false, enums, struct_fields)
    }
    if target == "builtin:ffi_buffer_close" {
        if count != 1 || return_type != "Nil" { return err("PE backend: ffi_buffer_close expects FFIBuffer and returns Nil") }
        let buffer: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
        if expr_type(buffer) != "FFIBuffer" { return err("PE backend: ffi_buffer_close expects FFIBuffer") }
        return pe_validate_expression(buffer, false, false, enums, struct_fields)
    }
    if target == "builtin:ffi_thread_pin" || target == "builtin:ffi_thread_unpin" {
        if count != 0 || return_type != "Nil" { return err("PE backend: FFI thread pin/unpin expects no arguments and returns Nil") }
        return ok(true)
    }
    return err("PE backend: unknown FFI builtin '" + target + "'")
}

fn pe_is_enum_type(enums: KIRTypedNodeView, type_name: String) -> Bool {
    let count: Int = result_unwrap(kir_typed_array_len(enums))
    let mut index: Int = 0
    while index < count {
        let definition: KIRTypedNodeView = result_unwrap(kir_typed_array_get(enums, index))
        if text(field(definition, "name")) == type_name { return true }
        index = index + 1
    }
    return false
}

fn pe_supported_type(enums: KIRTypedNodeView, type_name: String) -> Bool {
    return pe_scalar_type(type_name) || pe_is_enum_type(enums, type_name)
}

fn pe_is_struct_type(struct_fields: Map[String, KIRTypedNodeView], type_name: String) -> Bool {
    return map_contains_key(struct_fields, type_name)
}
fn pe_supported_type_with_structs(enums: KIRTypedNodeView, struct_fields: Map[String, KIRTypedNodeView], type_name: String) -> Bool {
    return pe_supported_type(enums, type_name) || pe_is_struct_type(struct_fields, type_name)
}


fn pe_struct_field_type_in(fields: KIRTypedNodeView, field_name: String) -> String {
    let field_count: Int = result_unwrap(kir_typed_array_len(fields))
    let mut field_index: Int = 0
    while field_index < field_count {
        let candidate: KIRTypedNodeView = result_unwrap(kir_typed_array_get(fields, field_index))
        if text(field(candidate, "name")) == field_name { return text(field(candidate, "type")) }
        field_index = field_index + 1
    }
    return ""
}

fn pe_struct_field_type(struct_fields: Map[String, KIRTypedNodeView], type_name: String, field_name: String) -> String {
    let fields: KIRTypedNodeView = unwrap_or(map_get(struct_fields, type_name), kir_typed_empty_array())
    return pe_struct_field_type_in(fields, field_name)
}
fn pe_validate_structs(structs: KIRTypedNodeView, enums: KIRTypedNodeView) -> Result[Bool, String] {
    let count: Int = result_unwrap(kir_typed_array_len(structs))
    let mut names: Map[String, Bool] = {}
    let mut struct_index: Int = 0
    while struct_index < count {
        let definition: KIRTypedNodeView = result_unwrap(kir_typed_array_get(structs, struct_index))
        let name: String = text(field(definition, "name"))
        if name == "" || map_contains_key(names, name) || pe_is_enum_type(enums, name) { return err("PE backend: struct names must be non-empty and unique") }
        names = map_insert(names, name, true)
        let fields: KIRTypedNodeView = field(definition, "fields")
        let field_count: Int = result_unwrap(kir_typed_array_len(fields))
        let mut field_names: Map[String, Bool] = {}
        let mut field_index: Int = 0
        while field_index < field_count {
            let declared: KIRTypedNodeView = result_unwrap(kir_typed_array_get(fields, field_index))
            let field_name: String = text(field(declared, "name"))
            let field_type: String = text(field(declared, "type"))
            if field_name == "" || map_contains_key(field_names, field_name) { return err("PE backend: struct '" + name + "' has an empty or duplicate field") }
            if !pe_scalar_type(field_type) && !pe_is_enum_type(enums, field_type) { return err("PE backend: struct '" + name + "' field '" + field_name + "' must have a scalar or enum type") }
            field_names = map_insert(field_names, field_name, true)
            field_index = field_index + 1
        }
        struct_index = struct_index + 1
    }
    return ok(true)
}

fn pe_has_enum_variant(enums: KIRTypedNodeView, type_name: String, variant_name: String) -> Bool {
    let count: Int = result_unwrap(kir_typed_array_len(enums))
    let mut index: Int = 0
    while index < count {
        let definition: KIRTypedNodeView = result_unwrap(kir_typed_array_get(enums, index))
        if text(field(definition, "name")) == type_name {
            let variants: KIRTypedNodeView = field(definition, "variants")
            let variant_count: Int = result_unwrap(kir_typed_array_len(variants))
            let mut variant_index: Int = 0
            while variant_index < variant_count {
                if text(result_unwrap(kir_typed_array_get(variants, variant_index))) == variant_name { return true }
                variant_index = variant_index + 1
            }
            return false
        }
        index = index + 1
    }
    return false
}

fn pe_enum_variants(enums: KIRTypedNodeView, type_name: String) -> KIRTypedNodeView {
    let count: Int = result_unwrap(kir_typed_array_len(enums))
    let mut index: Int = 0
    while index < count {
        let definition: KIRTypedNodeView = result_unwrap(kir_typed_array_get(enums, index))
        if text(field(definition, "name")) == type_name { return field(definition, "variants") }
        index = index + 1
    }
    return kir_typed_empty_array()
}

fn pe_validate_enums(enums: KIRTypedNodeView) -> Result[Bool, String] {
    let count: Int = result_unwrap(kir_typed_array_len(enums))
    let mut names: Map[String, Bool] = {}
    let mut index: Int = 0
    while index < count {
        let definition: KIRTypedNodeView = result_unwrap(kir_typed_array_get(enums, index))
        let name: String = text(field(definition, "name"))
        if name == "" || map_contains_key(names, name) { return err("PE backend: enum names must be non-empty and unique") }
        names = map_insert(names, name, true)
        let variants: KIRTypedNodeView = field(definition, "variants")
        let variant_count: Int = result_unwrap(kir_typed_array_len(variants))
        if variant_count == 0 { return err("PE backend: enum '" + name + "' must declare at least one variant") }
        let mut seen: Map[String, Bool] = {}
        let mut variant_index: Int = 0
        while variant_index < variant_count {
            let variant: String = text(result_unwrap(kir_typed_array_get(variants, variant_index)))
            if variant == "" || map_contains_key(seen, variant) { return err("PE backend: enum '" + name + "' has an empty or duplicate variant") }
            seen = map_insert(seen, variant, true)
            variant_index = variant_index + 1
        }
        index = index + 1
    }
    return ok(true)
}

fn pe_validate_expression(expression: KIRTypedNodeView, allow_nil: Bool, allow_output: Bool, enums: KIRTypedNodeView, struct_fields: Map[String, KIRTypedNodeView]) -> Result[Bool, String] {
    if kir_typed_kind(expression) == "null" { return err("PE backend: missing expression") }
    let kind: String = text(field(expression, "kind"))
    let type_name: String = expr_type(expression)
    if kind == "nil" {
        if allow_nil { return ok(true) }
        return err("PE backend: Nil is only valid as a void return")
    }
    let mut call_target: String = ""
    if kind == "call" { call_target = text(field(expression, "call_target")) }
    let nil_builtin: Bool = kind == "call" && (call_target == "builtin:print" || call_target == "builtin:println" || call_target == "builtin:assert" || call_target == "builtin:assert_eq" || starts_with(call_target, "function:"))
    if starts_with(call_target, "builtin:ffi_") { return pe_validate_ffi_call(expression, enums, struct_fields) }
    if kind == "var" && (type_name == "Json" || pe_is_ffi_handle_type(type_name) || pe_is_ffi_result_type(type_name) || pe_is_supported_result_type(enums, struct_fields, type_name) || pe_is_supported_option_type(enums, struct_fields, type_name) || type_name == "Bytes") { return ok(true) }
    if call_target == "builtin:map_contains_key" || call_target == "builtin:map_get" || call_target == "builtin:unwrap_or" {
        return pe_validate_map_call(expression, enums, struct_fields)
    }
    if call_target == "builtin:is_ok" || call_target == "builtin:is_err" {
        let arguments: KIRTypedNodeView = field(expression, "args")
        if result_unwrap(kir_typed_array_len(arguments)) != 1 || type_name != "Bool" { return err("PE backend: is_ok/is_err expects one Option or Result value and returns Bool") }
        let value: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
        if !pe_is_supported_result_type(enums, struct_fields, expr_type(value)) { return err("PE backend: is_ok/is_err requires a supported Result[T,E]") }
        return pe_validate_expression(value, false, false, enums, struct_fields)
    }
    if call_target == "builtin:is_some" || call_target == "builtin:is_none" {
        let arguments: KIRTypedNodeView = field(expression, "args")
        if result_unwrap(kir_typed_array_len(arguments)) != 1 || type_name != "Bool" { return err("PE backend: is_some/is_none expects one Option value and returns Bool") }
        let value: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
        if !pe_is_supported_option_type(enums, struct_fields, expr_type(value)) { return err("PE backend: is_some/is_none requires a supported Option[T]") }
        return pe_validate_expression(value, false, false, enums, struct_fields)
    }
    if call_target == "builtin:some" || call_target == "builtin:none" {
        let arguments: KIRTypedNodeView = field(expression, "args")
        let count: Int = result_unwrap(kir_typed_array_len(arguments))
        let value_type: String = pe_generic_type_argument(type_name, "Option", 0)
        if value_type == "" || !pe_is_supported_option_type(enums, struct_fields, type_name) { return err("PE backend: some/none requires a supported Option[T] result type") }
        if call_target == "builtin:none" {
            if count != 0 { return err("PE backend: none expects no arguments") }
            return ok(true)
        }
        if count != 1 { return err("PE backend: some expects one argument") }
        let value: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
        if expr_type(value) != value_type { return err("PE backend: some payload does not match Option[T]") }
        return pe_validate_expression(value, false, false, enums, struct_fields)
    }
    if call_target == "builtin:result_unwrap" || call_target == "builtin:result_error" {
        let arguments: KIRTypedNodeView = field(expression, "args")
        if result_unwrap(kir_typed_array_len(arguments)) != 1 { return err("PE backend: result_unwrap/result_error expects one Result value") }
        let value: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
        if !pe_is_supported_result_type(enums, struct_fields, expr_type(value)) { return err("PE backend: result_unwrap/result_error requires a supported Result[T,E], got '" + expr_type(value) + "'") }
        let result_type: String = pe_compact_type_spaces(expr_type(value))
        let mut expected: String = "Option[" + pe_generic_type_argument(result_type, "Result", 1) + "]"
        if call_target == "builtin:result_unwrap" { expected = pe_generic_type_argument(result_type, "Result", 0) }
        if type_name != expected { return err("PE backend: result_unwrap/result_error return type '" + type_name + "' does not match Result payload of '" + result_type + "' (expected '" + expected + "')") }
        return pe_validate_expression(value, false, false, enums, struct_fields)
    }
    if starts_with(call_target, "builtin:map_") { return err("PE backend: map builtins are not supported except read-only String-keyed lookup") }
    if starts_with(call_target, "builtin:array_") && call_target != "builtin:array_push" && call_target != "builtin:array_get" && call_target != "builtin:array_concat" && call_target != "builtin:array_indices" { return err("PE backend: array builtins are not supported except len(Array[T]), array_push, array_get, array_concat, array_indices, and local indexing") }
    if kind == "enum" {
        let enum_name: String = text(field(expression, "enum_type"))
        let variant_name: String = text(field(expression, "enum_variant"))
        if type_name != enum_name || !pe_has_enum_variant(enums, enum_name, variant_name) { return err("PE backend: unknown enum variant '" + enum_name + "::" + variant_name + "'") }
        return ok(true)
    }
    if kind == "struct" {
        let struct_name: String = text(field(expression, "struct_name"))
        if type_name != struct_name { return err("PE backend: unknown struct literal '" + struct_name + "'") }
        if !pe_is_struct_type(struct_fields, struct_name) { return err("PE backend: unknown struct literal '" + struct_name + "'") }
        let declared_fields: KIRTypedNodeView = unwrap_or(map_get(struct_fields, struct_name), kir_typed_empty_array())
        let fields: KIRTypedNodeView = field(expression, "fields")
        let values: KIRTypedNodeView = field(expression, "values")
        let field_count: Int = result_unwrap(kir_typed_array_len(fields))
        if field_count != result_unwrap(kir_typed_array_len(values)) || field_count != result_unwrap(kir_typed_array_len(declared_fields)) { return err("PE backend: struct literal '" + struct_name + "' has mismatched fields and values") }
        let mut seen_fields: Map[String, Bool] = {}
        let mut field_index: Int = 0
        while field_index < field_count {
            let field_name: String = text(result_unwrap(kir_typed_array_get(fields, field_index)))
            let value: KIRTypedNodeView = result_unwrap(kir_typed_array_get(values, field_index))
            let expected_type: String = pe_struct_field_type_in(declared_fields, field_name)
            if expected_type == "" || map_contains_key(seen_fields, field_name) { return err("PE backend: struct literal '" + struct_name + "' references an unknown or duplicate field '" + field_name + "'") }
            if expr_type(value) != expected_type { return err("PE backend: struct literal '" + struct_name + "' field '" + field_name + "' has an incompatible value") }
            let checked_value: Result[Bool, String] = pe_validate_expression(value, false, false, enums, struct_fields)
            if is_err(checked_value) { return checked_value }
            seen_fields = map_insert(seen_fields, field_name, true)
            field_index = field_index + 1
        }
        return ok(true)
    }
    if kind == "field" {
        let base: KIRTypedNodeView = field(expression, "base")
        let base_type: String = expr_type(base)
        let field_name: String = text(field(expression, "field"))
        if text(field(base, "kind")) != "var" { return err("PE backend: field reads require a local scalar-field struct") }
        let expected_type: String = pe_struct_field_type(struct_fields, base_type, field_name)
        if expected_type == "" || expected_type != type_name { return err("PE backend: unknown or mismatched field '" + field_name + "' in struct '" + base_type + "'") }
        return ok(true)
    }
    if kind == "binary" && (starts_with(expr_type(field(expression, "left")), "Array[") || starts_with(expr_type(field(expression, "right")), "Array[")) {
        let left_type: String = expr_type(field(expression, "left"))
        let right_type: String = expr_type(field(expression, "right"))
        if text(field(expression, "operator")) != "+" || left_type != right_type || type_name != left_type || !pe_is_supported_array_type(enums, left_type) {
            return err("PE backend: array concatenation requires '+' and matching supported Array[T] values")
        }
    }
    if starts_with(type_name, "Map[") { return pe_validate_map_expression(expression, enums, struct_fields, pe_map_value_type(type_name)) }
    if starts_with(type_name, "Array[") && !pe_is_supported_array_type(enums, type_name) { return err("PE backend: arrays require scalar or fieldless-enum element types") }
    if pe_is_supported_array_type(enums, type_name) && kind != "array" && kind != "var" && kind != "binary" && !pe_is_function_call(expression) && !(kind == "call" && (call_target == "builtin:array_push" || call_target == "builtin:array_concat" || call_target == "builtin:array_indices" || call_target == "builtin:u8_array")) {
        return err("PE backend: array values must be literals, local variables, concatenations, builtin results, or supported function results")
    }
    if type_name != "Json" && !pe_supported_type_with_structs(enums, struct_fields, type_name) && !pe_is_supported_array_type(enums, type_name) && !pe_is_supported_string_map_type(enums, type_name) && !pe_is_supported_option_type(enums, struct_fields, type_name) && !pe_is_ffi_handle_type(type_name) && !pe_is_supported_result_type(enums, struct_fields, type_name) && !nil_builtin { return err("PE backend: unsupported expression type '" + type_name + "'") }
    if kind == "array" {
        let element_type: String = pe_array_element_type(type_name)
        if element_type == "" || !pe_supported_type(enums, element_type) { return err("PE backend: arrays require scalar or fieldless-enum element types") }
        let items: KIRTypedNodeView = field(expression, "items")
        let count: Int = result_unwrap(kir_typed_array_len(items))
        let mut item_index: Int = 0
        while item_index < count {
            let item: KIRTypedNodeView = result_unwrap(kir_typed_array_get(items, item_index))
            if expr_type(item) != element_type { return err("PE backend: array literal elements must match " + element_type) }
            let checked_item: Result[Bool, String] = pe_validate_expression(item, false, false, enums, struct_fields)
            if is_err(checked_item) { return checked_item }
            item_index = item_index + 1
        }
        return ok(true)
    }
    if kind == "index" {
        let base: KIRTypedNodeView = field(expression, "base")
        let index: KIRTypedNodeView = field(expression, "left")
        let element_type: String = pe_array_element_type(expr_type(base))
        if text(field(base, "kind")) != "var" || element_type == "" || !pe_is_supported_array_type(enums, expr_type(base)) {
            return err("PE backend: indexing is supported only through a local supported array variable")
        }
        if type_name != element_type || expr_type(index) != "Int" { return err("PE backend: array indexing requires an Int index and returns the array element type") }
        let checked_base: Result[Bool, String] = pe_validate_expression(base, false, false, enums, struct_fields)
        if is_err(checked_base) { return checked_base }
        return pe_validate_expression(index, false, false, enums, struct_fields)
    }
    if kind == "int" || kind == "uint" || kind == "bool" || kind == "string" || kind == "var" { return ok(true) }
    if kind == "unary" {
        if pe_is_struct_type(struct_fields, expr_type(field(expression, "operand"))) { return err("PE backend: struct values are not unary operands") }
        let operator: String = text(field(expression, "operator"))
        if operator != "+" && operator != "-" && operator != "!" && operator != "~" { return err("PE backend: unsupported unary operator '" + operator + "'") }
        return pe_validate_expression(field(expression, "operand"), false, false, enums, struct_fields)
    }
    if kind == "propagate" {
        let operand: KIRTypedNodeView = field(expression, "operand")
        let operand_type: String = pe_compact_type_spaces(expr_type(operand))
        let result_type: String = pe_compact_type_spaces(type_name)
        if starts_with(operand_type, "Option[") {
            if pe_generic_type_argument(operand_type, "Option", 0) != result_type { return err("PE backend: Option propagation result type does not match its payload") }
        } else if starts_with(operand_type, "Result[") {
            if pe_generic_type_argument(operand_type, "Result", 0) != result_type { return err("PE backend: Result propagation result type does not match its payload") }
        } else {
            return err("PE backend: '?' requires Option[T] or Result[T,E]")
        }
        return pe_validate_expression(operand, false, false, enums, struct_fields)
    }
    if kind == "binary" {
        if pe_is_struct_type(struct_fields, expr_type(field(expression, "left"))) || pe_is_struct_type(struct_fields, expr_type(field(expression, "right"))) { return err("PE backend: struct values do not support binary operations") }
        if type_name == "String" || expr_type(field(expression, "left")) == "String" { return err("PE backend: String binary operations are not supported") }
        let operator: String = text(field(expression, "operator"))
        if operator != "+" && operator != "-" && operator != "*" && operator != "/" && operator != "%" && operator != "&" && operator != "^" && operator != "|" && operator != "<<" && operator != ">>" && operator != "&&" && operator != "||" && operator != "==" && operator != "!=" && operator != "<" && operator != "<=" && operator != ">" && operator != ">=" {
            return err("PE backend: unsupported binary operator '" + operator + "'")
        }
        let left: Result[Bool, String] = pe_validate_expression(field(expression, "left"), false, false, enums, struct_fields)
        if is_err(left) { return left }
        return pe_validate_expression(field(expression, "right"), false, false, enums, struct_fields)
    }
    if kind == "call" {
        let target: String = call_target
        let args: KIRTypedNodeView = field(expression, "args")
        let count: Int = result_unwrap(kir_typed_array_len(args))
        if starts_with(target, "function:") {
            return pe_validate_function_arguments(expression, enums, struct_fields)
        }
        if target == "builtin:process_args" {
            if count != 0 || type_name != "Array[String]" { return err("PE backend: process_args expects no arguments and returns Array[String]") }
            return ok(true)
        }
        if starts_with(target, "builtin:json_") { return pe_validate_json_call(expression, enums, struct_fields) }
        if target == "builtin:int" {
            if count != 1 { return err("PE backend: int expects one scalar integer argument") }
            let integer_argument: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
            if expr_type(integer_argument) != "Int" && expr_type(integer_argument) != "Bool" && !starts_with(expr_type(integer_argument), "UInt") { return err("PE backend: int supports Int, Bool, and UInt, but not String parsing") }
            return pe_validate_expression(integer_argument, false, false, enums, struct_fields)
        }
        if target == "builtin:str" {
            if count != 1 { return err("PE backend: str expects one integer or Bool argument") }
            let display_argument: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
            let display_type: String = expr_type(display_argument)
            if display_type != "Int" && display_type != "Bool" && !starts_with(display_type, "UInt") { return err("PE backend: str supports Int, Bool, and UInt values") }
            return pe_validate_expression(display_argument, false, false, enums, struct_fields)
        }
        if target == "builtin:len" {
            if count != 1 { return err("PE backend: len expects one supported Array[T] or Bytes argument") }
            let array_argument: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
            if expr_type(array_argument) == "Bytes" { return pe_validate_expression(array_argument, false, false, enums, struct_fields) }
            if !pe_is_supported_array_type(enums, expr_type(array_argument)) { return err("PE backend: len supports only arrays with scalar or fieldless-enum elements; got " + expr_type(array_argument)) }
            let checked_array: Result[Bool, String] = pe_validate_expression(array_argument, false, false, enums, struct_fields)
            if is_err(checked_array) { return checked_array }
            return ok(true)
        }
        if target == "builtin:string_to_bytes" {
            if count != 1 || type_name != "Bytes" { return err("PE backend: string_to_bytes expects one String and returns Bytes") }
            let string_argument: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
            if expr_type(string_argument) != "String" { return err("PE backend: string_to_bytes expects String") }
            return pe_validate_expression(string_argument, false, false, enums, struct_fields)
        }
        if target == "builtin:u8_array" {
            if count != 1 || type_name != "Array[UInt8]" { return err("PE backend: u8_array expects one Bytes value and returns Array[UInt8]") }
            let bytes: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
            if expr_type(bytes) != "Bytes" { return err("PE backend: u8_array expects Bytes") }
            return pe_validate_expression(bytes, false, false, enums, struct_fields)
        }
        if target == "builtin:array_push" {
            if count != 2 { return err("PE backend: array_push expects two arguments") }
            let array_argument: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
            let value_argument: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 1))
            let element_type: String = pe_array_element_type(expr_type(array_argument))
            if !pe_is_supported_array_type(enums, expr_type(array_argument)) || type_name != expr_type(array_argument) || expr_type(value_argument) != element_type {
                return err("PE backend: array_push expects a supported Array[T] and a matching value")
            }
            let checked_array: Result[Bool, String] = pe_validate_expression(array_argument, false, false, enums, struct_fields)
            if is_err(checked_array) { return checked_array }
            return pe_validate_expression(value_argument, false, false, enums, struct_fields)
        }
        if target == "builtin:array_get" {
            if count != 2 { return err("PE backend: array_get expects Array[T] and Int") }
            let array_argument: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
            let index_argument: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 1))
            let element_type: String = pe_array_element_type(expr_type(array_argument))
            if element_type == "" || !pe_is_supported_array_type(enums, expr_type(array_argument)) || expr_type(index_argument) != "Int" || type_name != "Option[" + element_type + "]" {
                return err("PE backend: array_get requires a supported Array[T], an Int index, and returns Option[T]")
            }
            let checked_array: Result[Bool, String] = pe_validate_expression(array_argument, false, false, enums, struct_fields)
            if is_err(checked_array) { return checked_array }
            return pe_validate_expression(index_argument, false, false, enums, struct_fields)
        }
        if target == "builtin:array_indices" {
            if count != 1 || type_name != "Array[Int]" { return err("PE backend: array_indices expects one supported Array[T] and returns Array[Int]") }
            let array_argument: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
            if !pe_is_supported_array_type(enums, expr_type(array_argument)) { return err("PE backend: array_indices supports arrays with scalar or fieldless-enum elements") }
            return pe_validate_expression(array_argument, false, false, enums, struct_fields)
        }
        if target == "builtin:array_concat" {
            if count != 2 { return err("PE backend: array_concat expects two arguments") }
            let left: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
            let right: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 1))
            let array_type: String = expr_type(left)
            if !pe_is_supported_array_type(enums, array_type) || expr_type(right) != array_type || type_name != array_type {
                return err("PE backend: array_concat expects two matching supported Array[T] values")
            }
            let checked_left: Result[Bool, String] = pe_validate_expression(left, false, false, enums, struct_fields)
            if is_err(checked_left) { return checked_left }
            return pe_validate_expression(right, false, false, enums, struct_fields)
        }
        if target == "builtin:u8" || target == "builtin:u16" || target == "builtin:u32" || target == "builtin:u64" {
            if count != 1 { return err("PE backend: unsigned conversion expects one argument") }
            if !starts_with(expr_type(result_unwrap(kir_typed_array_get(args, 0))), "UInt") && expr_type(result_unwrap(kir_typed_array_get(args, 0))) != "Int" { return err("PE backend: unsigned conversion requires an integer") }
            return pe_validate_expression(result_unwrap(kir_typed_array_get(args, 0)), false, false, enums, struct_fields)
        }
        if target == "builtin:assert" {
            if count != 1 || expr_type(result_unwrap(kir_typed_array_get(args, 0))) != "Bool" { return err("PE backend: assert expects one Bool") }
            return pe_validate_expression(result_unwrap(kir_typed_array_get(args, 0)), false, false, enums, struct_fields)
        }
        if target == "builtin:assert_eq" {
            if count != 2 { return err("PE backend: assert_eq expects two scalar arguments") }
            let left: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
            let right: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 1))
            if expr_type(left) != expr_type(right) || pe_is_struct_type(struct_fields, expr_type(left)) || !pe_supported_type(enums, expr_type(left)) || expr_type(left) == "String" { return err("PE backend: assert_eq supports matching scalar or enum arguments") }
            let checked_left: Result[Bool, String] = pe_validate_expression(left, false, false, enums, struct_fields)
            if is_err(checked_left) { return checked_left }
            return pe_validate_expression(right, false, false, enums, struct_fields)
        }
        if !allow_output || (target != "builtin:print" && target != "builtin:println") || count != 1 { return err("PE backend: only statement-form print(value) and println(value) are supported; got '" + target + "'") }
        let output: KIRTypedNodeView = result_unwrap(kir_typed_array_get(args, 0))
        if pe_is_struct_type(struct_fields, expr_type(output)) { return err("PE backend: printing structs is not supported") }
        if starts_with(expr_type(output), "Array[") { return err("PE backend: printing arrays is not supported") }
        if starts_with(expr_type(output), "Map[") { return err("PE backend: printing maps is not supported") }
        return pe_validate_expression(output, false, false, enums, struct_fields)
    }
    return err("PE backend: unsupported expression kind '" + kind + "'")
}

fn pe_validate_statements(statements: KIRTypedNodeView, enums: KIRTypedNodeView, struct_fields: Map[String, KIRTypedNodeView]) -> Result[Bool, String] {
    let count: Int = result_unwrap(kir_typed_array_len(statements))
    let mut index: Int = 0
    while index < count {
        let statement: KIRTypedNodeView = result_unwrap(kir_typed_array_get(statements, index))
        let kind: String = text(field(statement, "kind"))
        if kind == "let" || kind == "const" {
            let init: KIRTypedNodeView = field(statement, "init")
            if starts_with(expr_type(init), "Map[") && !pe_is_supported_string_map_type(enums, expr_type(init)) { return err("PE backend: maps require String keys and scalar or fieldless-enum values") }
            if starts_with(expr_type(init), "Array[") && !pe_is_supported_array_type(enums, expr_type(init)) { return err("PE backend: arrays require scalar or fieldless-enum element types") }
            if !pe_supported_local_type(enums, struct_fields, expr_type(init)) { return err("PE backend: binding '" + text(field(statement, "name")) + "' has an unsupported type") }
            if text(field(init, "kind")) == "call" && starts_with(text(field(init, "call_target")), "builtin:array_") && text(field(init, "call_target")) != "builtin:array_push" && text(field(init, "call_target")) != "builtin:array_concat" && text(field(init, "call_target")) != "builtin:array_indices" { return err("PE backend: array builtins are not supported except len(Array[T]), array_push, array_concat, array_indices, and local indexing") }
            if text(field(init, "kind")) == "call" && starts_with(text(field(init, "call_target")), "builtin:map_") && text(field(init, "call_target")) != "builtin:map_contains_key" { return err("PE backend: map builtins are not supported except read-only String-keyed lookup") }
            if pe_is_supported_array_type(enums, expr_type(init)) && text(field(init, "kind")) != "array" && text(field(init, "kind")) != "var" && text(field(init, "kind")) != "binary" && !pe_is_function_call(init) && !(text(field(init, "kind")) == "call" && (text(field(init, "call_target")) == "builtin:array_push" || text(field(init, "call_target")) == "builtin:array_concat" || text(field(init, "call_target")) == "builtin:array_indices" || text(field(init, "call_target")) == "builtin:u8_array")) { return err("PE backend: array locals require a literal, an existing local, concatenation, u8_array/array builtins, or a function result") }
            if pe_is_supported_string_map_type(enums, expr_type(init)) && text(field(init, "kind")) != "map" && text(field(init, "kind")) != "var" && !pe_is_function_call(init) { return err("PE backend: map locals require a literal, an existing local map, or a function result") }
            if pe_is_struct_type(struct_fields, expr_type(init)) && text(field(init, "kind")) != "struct" && text(field(init, "kind")) != "var" && !pe_is_function_call(init) { return err("PE backend: struct locals require a literal, an existing local struct, or a function result") }
            let checked: Result[Bool, String] = pe_validate_expression(init, false, false, enums, struct_fields)
            if is_err(checked) { return checked }
        } else if kind == "assign" {
            let target: KIRTypedNodeView = field(statement, "target")
            let value: KIRTypedNodeView = field(statement, "value")
            if starts_with(expr_type(target), "Map[") || starts_with(expr_type(value), "Map[") { return err("PE backend: map reassignment is not supported") }
            if starts_with(expr_type(target), "Array[") || starts_with(expr_type(value), "Array[") { return err("PE backend: array mutation and reassignment are not supported") }
            if text(field(target, "kind")) == "index" && starts_with(expr_type(field(target, "base")), "Array[") { return err("PE backend: array element mutation is not supported") }
            if text(field(target, "kind")) != "var" || pe_is_struct_type(struct_fields, expr_type(value)) || !pe_supported_type(enums, expr_type(value)) { return err("PE backend: assignment requires a scalar or enum local") }
            let checked: Result[Bool, String] = pe_validate_expression(value, false, false, enums, struct_fields)
            if is_err(checked) { return checked }
        } else if kind == "expr" {
            let expression: KIRTypedNodeView = field(statement, "expr")
            if text(field(expression, "kind")) != "call" { return err("PE backend: expression statements must be direct calls") }
            let target: String = text(field(expression, "call_target"))
            let checked: Result[Bool, String] = pe_validate_expression(expression, false, target == "builtin:print" || target == "builtin:println", enums, struct_fields)
            if is_err(checked) { return checked }
        } else if kind == "if" {
            let condition: KIRTypedNodeView = field(statement, "cond")
            if expr_type(condition) != "Bool" { return err("PE backend: if condition must be Bool") }
            let checked_condition: Result[Bool, String] = pe_validate_expression(condition, false, false, enums, struct_fields)
            if is_err(checked_condition) { return checked_condition }
            let checked_then: Result[Bool, String] = pe_validate_statements(field(statement, "then"), enums, struct_fields)
            if is_err(checked_then) { return checked_then }
            let checked_else: Result[Bool, String] = pe_validate_statements(field(statement, "else"), enums, struct_fields)
            if is_err(checked_else) { return checked_else }
        } else if kind == "match" {
            let scrutinee: KIRTypedNodeView = field(statement, "scrutinee")
            if kir_typed_kind(scrutinee) != "object" { return err("PE backend: match is missing its scrutinee") }
            let enum_name: String = expr_type(scrutinee)
            if !pe_is_enum_type(enums, enum_name) { return err("PE backend: match scrutinee must be a fieldless enum") }
            let checked_scrutinee: Result[Bool, String] = pe_validate_expression(scrutinee, false, false, enums, struct_fields)
            if is_err(checked_scrutinee) { return checked_scrutinee }
            let variants: KIRTypedNodeView = pe_enum_variants(enums, enum_name)
            let checked_match: Result[Bool, String] = validate_fieldless_enum_match(statement, enum_name, variants, "PE backend")
            if is_err(checked_match) { return checked_match }
            let arms: KIRTypedNodeView = field(statement, "arms")
            let arm_count: Int = result_unwrap(kir_typed_array_len(arms))
            let mut arm_index: Int = 0
            while arm_index < arm_count {
                let arm: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arms, arm_index))
                let checked_body: Result[Bool, String] = pe_validate_statements(field(arm, "body"), enums, struct_fields)
                if is_err(checked_body) { return checked_body }
                arm_index = arm_index + 1
            }
        } else if kind == "while" {
            let condition: KIRTypedNodeView = field(statement, "cond")
            if expr_type(condition) != "Bool" { return err("PE backend: while condition must be Bool") }
            let checked_condition: Result[Bool, String] = pe_validate_expression(condition, false, false, enums, struct_fields)
            if is_err(checked_condition) { return checked_condition }
            let checked_body: Result[Bool, String] = pe_validate_statements(field(statement, "body"), enums, struct_fields)
            if is_err(checked_body) { return checked_body }
        } else if kind == "return" {
            let value: KIRTypedNodeView = field(statement, "return")
            if kir_typed_kind(value) != "null" {
                let checked: Result[Bool, String] = pe_validate_expression(value, true, false, enums, struct_fields)
                if is_err(checked) { return checked }
            }
        } else if kind != "break" && kind != "continue" {
            return err("PE backend: unsupported statement kind '" + kind + "'")
        }
        index = index + 1
    }
    return ok(true)
}

fn pe_validate_document(kir: ValidatedKIR) -> Result[Bool, String] {
    let document: KIRTypedNodeView = validated_kir_typed_root(kir)
    let target: KIRTypedNodeView = field(document, "target")
    if text(field(target, "os")) != "windows" || text(field(target, "arch")) != "amd64" || is_err(kir_typed_bool(field(target, "gui"))) {
        return err("PE backend: target must be windows-amd64 or windows-amd64-gui")
    }
    let enums: KIRTypedNodeView = field(document, "enums")
    let enum_valid: Result[Bool, String] = pe_validate_enums(enums)
    if is_err(enum_valid) { return enum_valid }
    let structs: KIRTypedNodeView = field(document, "structs")
    let struct_fields: Map[String, KIRTypedNodeView] = collect_struct_fields(structs)
    let struct_valid: Result[Bool, String] = pe_validate_structs(structs, enums)
    if is_err(struct_valid) { return struct_valid }
    let checked_top: Result[Bool, String] = pe_validate_statements(field(document, "statements"), enums, struct_fields)
    if is_err(checked_top) { return checked_top }
    let functions: KIRTypedNodeView = field(document, "functions")
    let function_count: Int = result_unwrap(kir_typed_array_len(functions))
    let mut index: Int = 0
    let mut has_main: Bool = false
    while index < function_count {
        let function: KIRTypedNodeView = result_unwrap(kir_typed_array_get(functions, index))
        let name: String = text(field(function, "name"))
        if result_unwrap(kir_typed_bool(field(function, "worker"))) || result_unwrap(kir_typed_bool(field(function, "unsafe"))) || text(field(function, "receiver")) != "" || result_unwrap(kir_typed_array_len(field(function, "type_params"))) != 0 {
            return err("PE backend: worker, unsafe, receiver, and generic functions are not supported")
        }
        if name == "main" {
            has_main = true
            if result_unwrap(kir_typed_array_len(field(function, "params"))) != 0 || text(field(function, "return")) != "Nil" { return err("PE backend: main must have no arguments and return Nil") }
        } else {
            if !pe_supported_local_type(enums, struct_fields, text(field(function, "return"))) && text(field(function, "return")) != "Nil" { return err("PE backend: function '" + name + "' has an unsupported return type") }
        }
        let parameters: KIRTypedNodeView = field(function, "params")
        let parameter_count: Int = result_unwrap(kir_typed_array_len(parameters))
        let mut parameter_index: Int = 0
        while parameter_index < parameter_count {
            let parameter: KIRTypedNodeView = result_unwrap(kir_typed_array_get(parameters, parameter_index))
            if !pe_supported_local_type(enums, struct_fields, text(field(parameter, "type"))) || kir_typed_kind(field(parameter, "default")) != "null" { return err("PE backend: function parameters require supported scalar, enum, struct, or collection types and no defaults") }
            parameter_index = parameter_index + 1
        }
        let checked_body: Result[Bool, String] = pe_validate_statements(field(function, "body"), enums, struct_fields)
        if is_err(checked_body) { return checked_body }
        index = index + 1
    }
    if !has_main && result_unwrap(kir_typed_array_len(field(document, "statements"))) == 0 { return err("PE backend: document has no entry statements or main function") }
    return ok(true)
}

fn lower_dynamic(kir: ValidatedKIR) -> Result[LoweredNativeImage, String] {
    let document: KIRTypedNodeView = validated_kir_typed_root(kir)
    let target: KIRTypedNodeView = field(document, "target")
    let windows_target: Bool = text(field(target, "os")) == "windows" && text(field(target, "arch")) == "amd64"
    let gui_target_result: Result[Bool, String] = kir_typed_bool(field(target, "gui"))
    if is_err(gui_target_result) { return err("dynamic backend: target.gui must be Bool") }
    let gui_target: Bool = result_unwrap(gui_target_result)
    if gui_target && !windows_target { return err("dynamic backend: GUI subsystem targets require windows-amd64") }
    if !windows_target && (text(field(target, "os")) != "linux" || text(field(target, "arch")) != "amd64") { return err("dynamic backend supports linux-amd64 and the current windows-amd64 console/GUI subset") }
    if windows_target {
        let valid: Result[Bool, String] = pe_validate_document(kir)
        if is_err(valid) { return err(unwrap_or(result_error(valid), "PE backend: document validation failed")) }
    }
    let functions: KIRTypedNodeView = field(document, "functions")
    let function_count: Int = result_unwrap(kir_typed_array_len(functions))
    let struct_fields: Map[String, KIRTypedNodeView] = collect_type_fields(field(document, "structs"), field(document, "enums"))
    let statements: KIRTypedNodeView = entry_statements(document)
    let mut state: EmitState = emit_prologue(state_with_windows_abi(new_dynamic_state(), windows_target))
    let end_label: LabelState = new_label(state)
    let trap_label: LabelState = new_label(end_label.state)
    let string_concat_label: LabelState = new_label(trap_label.state)
    let array_alloc_label: LabelState = new_label(string_concat_label.state)
    let array_push_label: LabelState = new_label(array_alloc_label.state)
    let array_concat_label: LabelState = new_label(array_push_label.state)
    let box_alloc_label: LabelState = new_label(array_concat_label.state)
    let struct_reserved_label: LabelState = new_label(box_alloc_label.state)
    let host_string_label: LabelState = new_label(struct_reserved_label.state)
    let host_chars_label: LabelState = new_label(host_string_label.state)
    let host_equal_label: LabelState = new_label(host_chars_label.state)
    let host_map_find_label: LabelState = new_label(host_equal_label.state)
    let host_map_insert_label: LabelState = new_label(host_map_find_label.state)
    let host_substring_label: LabelState = new_label(host_map_insert_label.state)
    let host_int_to_string_label: LabelState = new_label(host_substring_label.state)
    let host_int_from_string_label: LabelState = new_label(host_int_to_string_label.state)
    let host_bytes_label: LabelState = new_label(host_int_from_string_label.state)
    let host_u8_label: LabelState = new_label(host_bytes_label.state)
    let host_process_label: LabelState = new_label(host_u8_label.state)
    let host_read_label: LabelState = new_label(host_process_label.state)
    let host_write_label: LabelState = new_label(host_read_label.state)
    let host_array_set_label: LabelState = new_label(host_write_label.state)
    let host_array_slice_label: LabelState = new_label(host_array_set_label.state)
    let host_json_skip_label: LabelState = new_label(host_array_slice_label.state)
    let host_json_parse_label: LabelState = new_label(host_json_skip_label.state)
    let host_json_kind_label: LabelState = new_label(host_json_parse_label.state)
    let host_json_object_get_label: LabelState = new_label(host_json_kind_label.state)
    let host_json_array_len_label: LabelState = new_label(host_json_object_get_label.state)
    let host_json_array_get_label: LabelState = new_label(host_json_array_len_label.state)
    let host_json_string_label: LabelState = new_label(host_json_array_get_label.state)
    let host_json_bool_label: LabelState = new_label(host_json_string_label.state)
    let host_json_int_label: LabelState = new_label(host_json_bool_label.state)
    let host_json_uint_label: LabelState = new_label(host_json_int_label.state)
    let host_map_remove_label: LabelState = new_label(host_json_uint_label.state)
    let host_json_object_keys_label: LabelState = new_label(host_map_remove_label.state)
    let host_string_less_label: LabelState = new_label(host_json_object_keys_label.state)
    let host_json_string_scan_label: LabelState = new_label(host_string_less_label.state)
    let host_json_object_fields_empty_except_label: LabelState = new_label(host_json_string_scan_label.state)
    let host_json_field_set_lookup_label: LabelState = new_label(host_json_object_fields_empty_except_label.state)
    let host_json_object_keys_allowed_label: LabelState = new_label(host_json_field_set_lookup_label.state)
    let slot_count: Int = count_slots(statements)
    state = state_with_string_concat_label(host_json_object_keys_allowed_label.state, string_concat_label.label)
    state = state_with_array_labels(state, array_alloc_label.label, array_push_label.label, array_concat_label.label)
    state = state_with_box_label(state, box_alloc_label.label)
    state = state_with_env(state, CompileEnv{ slots: {}, static_values: {}, struct_fields: struct_fields, function_labels: {}, function_returns: {}, next_slot: 0, breaks: [], continues: [], end_label: end_label.label, trap_label: trap_label.label, buffer_offset: slot_count * 8 + 1, in_function: false, current_function: "" })
    let prepared: Result[EmitState, String] = prepare_function_labels(state, functions)
    if is_err(prepared) { return err(unwrap_or(result_error(prepared), "dynamic backend: function preparation failed")) }
    state = result_unwrap(prepared)
    let compiled: Result[EmitState, String] = compile_statements(state, statements)
    if is_err(compiled) { return err(compile_error(compiled)) }
    let main_state: EmitState = result_unwrap(compiled)
    let mut lowered: EmitState = main_state
    if function_count > 0 || main_state.assembler.common.string_concat_used || main_state.assembler.common.array_runtime_used || main_state.assembler.common.box_runtime_used || main_state.assembler.common.host_runtime_used {
        lowered = emit_jump(lowered, end_label.label, false, u8(0))
        if windows_target {
            let main_frame: Int = align_frame(main_state.env.buffer_offset + 63)
            lowered = state_with_function_ranges(lowered, array_push(lowered.assembler.common.function_ranges, [0, lowered.assembler.code_state.code_length, main_frame]))
        }
        let emitted: Result[EmitState, String] = emit_function_bodies(lowered, functions, 0, main_state.env)
        if is_err(emitted) { return err(unwrap_or(result_error(emitted), "dynamic backend: function lowering failed")) }
        lowered = result_unwrap(emitted)
    } else if windows_target {
        let main_frame: Int = align_frame(main_state.env.buffer_offset + 63)
        lowered = state_with_function_ranges(lowered, array_push(lowered.assembler.common.function_ranges, [0, lowered.assembler.code_state.code_length, main_frame]))
    }
    if lowered.assembler.common.host_runtime_used {
        // The host slice always emits process_args, whose runtime allocates
        // its result through the shared Array allocator, just like the Go
        // direct backend marks arrayRuntimeUsed while finalizing host code.
        lowered = state_with_array_used(lowered)
        let json_skip_runtime: Result[EmitState, String] = emit_json_skip_runtime(lowered)
        if is_err(json_skip_runtime) { return err(unwrap_or(result_error(json_skip_runtime), "dynamic backend: JSON scanner lowering failed")) }
        lowered = result_unwrap(json_skip_runtime)
        let json_string_scan_runtime: Result[EmitState, String] = emit_json_string_scan_runtime(lowered)
        if is_err(json_string_scan_runtime) { return err(unwrap_or(result_error(json_string_scan_runtime), "dynamic backend: JSON string scanner lowering failed")) }
        lowered = result_unwrap(json_string_scan_runtime)
        let json_parse_runtime: Result[EmitState, String] = emit_json_parse_runtime(lowered)
        if is_err(json_parse_runtime) { return err(unwrap_or(result_error(json_parse_runtime), "dynamic backend: JSON parse lowering failed")) }
        lowered = result_unwrap(json_parse_runtime)
        let json_kind_runtime: Result[EmitState, String] = emit_json_kind_runtime(lowered)
        if is_err(json_kind_runtime) { return err(unwrap_or(result_error(json_kind_runtime), "dynamic backend: JSON kind lowering failed")) }
        lowered = result_unwrap(json_kind_runtime)
        let json_object_get_runtime: Result[EmitState, String] = emit_json_object_get_runtime(lowered)
        if is_err(json_object_get_runtime) { return err(unwrap_or(result_error(json_object_get_runtime), "dynamic backend: JSON object access lowering failed")) }
        lowered = result_unwrap(json_object_get_runtime)
        let json_object_keys_runtime: Result[EmitState, String] = emit_json_object_keys_runtime(lowered)
        if is_err(json_object_keys_runtime) { return err(unwrap_or(result_error(json_object_keys_runtime), "dynamic backend: JSON object keys lowering failed")) }
        lowered = result_unwrap(json_object_keys_runtime)
        let json_field_set_lookup_runtime: Result[EmitState, String] = emit_json_field_set_lookup_runtime(lowered)
        if is_err(json_field_set_lookup_runtime) { return err(unwrap_or(result_error(json_field_set_lookup_runtime), "dynamic backend: JSON field set lookup lowering failed")) }
        lowered = result_unwrap(json_field_set_lookup_runtime)
        let json_object_keys_allowed_runtime: Result[EmitState, String] = emit_json_object_keys_allowed_runtime(lowered)
        if is_err(json_object_keys_allowed_runtime) { return err(unwrap_or(result_error(json_object_keys_allowed_runtime), "dynamic backend: JSON object key allowlist lowering failed")) }
        lowered = result_unwrap(json_object_keys_allowed_runtime)
        let json_array_len_runtime: Result[EmitState, String] = emit_json_array_len_runtime(lowered)
        if is_err(json_array_len_runtime) { return err(unwrap_or(result_error(json_array_len_runtime), "dynamic backend: JSON array length lowering failed")) }
        lowered = result_unwrap(json_array_len_runtime)
        let json_array_get_runtime: Result[EmitState, String] = emit_json_array_get_runtime(lowered)
        if is_err(json_array_get_runtime) { return err(unwrap_or(result_error(json_array_get_runtime), "dynamic backend: JSON array access lowering failed")) }
        lowered = result_unwrap(json_array_get_runtime)
        let json_bool_runtime: Result[EmitState, String] = emit_json_bool_runtime(lowered)
        if is_err(json_bool_runtime) { return err(unwrap_or(result_error(json_bool_runtime), "dynamic backend: JSON bool lowering failed")) }
        lowered = result_unwrap(json_bool_runtime)
        let json_int_runtime: Result[EmitState, String] = emit_json_int_runtime(lowered)
        if is_err(json_int_runtime) { return err(unwrap_or(result_error(json_int_runtime), "dynamic backend: JSON Int lowering failed")) }
        lowered = result_unwrap(json_int_runtime)
        let json_uint_runtime: Result[EmitState, String] = emit_json_uint_runtime(lowered)
        if is_err(json_uint_runtime) { return err(unwrap_or(result_error(json_uint_runtime), "dynamic backend: JSON UInt lowering failed")) }
        lowered = result_unwrap(json_uint_runtime)
        let json_string_runtime: Result[EmitState, String] = emit_json_string_runtime(lowered)
        if is_err(json_string_runtime) { return err(unwrap_or(result_error(json_string_runtime), "dynamic backend: JSON String lowering failed")) }
        lowered = result_unwrap(json_string_runtime)
        let string_runtime: Result[EmitState, String] = emit_string_alloc_runtime(lowered)
        if is_err(string_runtime) { return err(unwrap_or(result_error(string_runtime), "dynamic backend: host String runtime lowering failed")) }
        lowered = result_unwrap(string_runtime)
        let substring_runtime: Result[EmitState, String] = emit_substring_runtime(lowered)
        if is_err(substring_runtime) { return err(unwrap_or(result_error(substring_runtime), "dynamic backend: substring runtime lowering failed")) }
        lowered = result_unwrap(substring_runtime)
        let chars_runtime: Result[EmitState, String] = emit_string_chars_runtime(lowered)
        if is_err(chars_runtime) { return err(unwrap_or(result_error(chars_runtime), "dynamic backend: string_chars runtime lowering failed")) }
        lowered = result_unwrap(chars_runtime)
        if windows_target {
            let int_string_runtime: Result[EmitState, String] = emit_int_to_string_runtime(lowered)
            if is_err(int_string_runtime) { return err(unwrap_or(result_error(int_string_runtime), "dynamic backend: host Int-to-String runtime lowering failed")) }
            lowered = result_unwrap(int_string_runtime)
        } else {
            let int_string_runtime: Result[EmitState, String] = emit_int_to_string_runtime(lowered)
            if is_err(int_string_runtime) { return err(unwrap_or(result_error(int_string_runtime), "dynamic backend: host Int-to-String runtime lowering failed")) }
            lowered = result_unwrap(int_string_runtime)
            let string_int_runtime: Result[EmitState, String] = emit_int_from_string_runtime(lowered)
            if is_err(string_int_runtime) { return err(unwrap_or(result_error(string_int_runtime), "dynamic backend: host String-to-Int runtime lowering failed")) }
            lowered = result_unwrap(string_int_runtime)
        }
        let string_equal_runtime: Result[EmitState, String] = emit_string_equal_runtime(lowered)
        if is_err(string_equal_runtime) { return err(unwrap_or(result_error(string_equal_runtime), "dynamic backend: String equality runtime lowering failed")) }
        lowered = result_unwrap(string_equal_runtime)
        let json_child_runtime: Result[EmitState, String] = emit_json_object_fields_empty_except_runtime(lowered)
        if is_err(json_child_runtime) { return err(unwrap_or(result_error(json_child_runtime), "dynamic backend: JSON child validator lowering failed")) }
        lowered = result_unwrap(json_child_runtime)
        let string_less_runtime: Result[EmitState, String] = emit_string_less_runtime(lowered)
        if is_err(string_less_runtime) { return err(unwrap_or(result_error(string_less_runtime), "dynamic backend: String ordering runtime lowering failed")) }
        lowered = result_unwrap(string_less_runtime)
        let map_find_runtime: Result[EmitState, String] = emit_map_find_runtime(lowered)
        if is_err(map_find_runtime) { return err(unwrap_or(result_error(map_find_runtime), "dynamic backend: map lookup runtime lowering failed")) }
        lowered = result_unwrap(map_find_runtime)
        let map_insert_runtime: Result[EmitState, String] = emit_map_insert_runtime(lowered)
        if is_err(map_insert_runtime) { return err(unwrap_or(result_error(map_insert_runtime), "dynamic backend: map insert runtime lowering failed")) }
        lowered = result_unwrap(map_insert_runtime)
        let map_remove_runtime: Result[EmitState, String] = emit_map_remove_runtime(lowered)
        if is_err(map_remove_runtime) { return err(unwrap_or(result_error(map_remove_runtime), "dynamic backend: map remove runtime lowering failed")) }
        lowered = result_unwrap(map_remove_runtime)
        let bytes_runtime: Result[EmitState, String] = emit_bytes_from_array_runtime(lowered)
        if is_err(bytes_runtime) { return err(unwrap_or(result_error(bytes_runtime), "dynamic backend: host Bytes runtime lowering failed")) }
        lowered = result_unwrap(bytes_runtime)
        let u8_runtime: Result[EmitState, String] = emit_u8_array_runtime(lowered)
        if is_err(u8_runtime) { return err(unwrap_or(result_error(u8_runtime), "dynamic backend: host u8_array runtime lowering failed")) }
        lowered = result_unwrap(u8_runtime)
        let args_runtime: Result[EmitState, String] = emit_process_args_runtime(lowered)
        if is_err(args_runtime) { return err(unwrap_or(result_error(args_runtime), "dynamic backend: process_args runtime lowering failed")) }
        lowered = result_unwrap(args_runtime)
        let read_runtime: Result[EmitState, String] = emit_fs_read_text_runtime(lowered)
        if is_err(read_runtime) { return err(unwrap_or(result_error(read_runtime), "dynamic backend: fs_read_text runtime lowering failed")) }
        lowered = result_unwrap(read_runtime)
        let write_runtime: Result[EmitState, String] = emit_fs_write_bytes_runtime(lowered)
        if is_err(write_runtime) { return err(unwrap_or(result_error(write_runtime), "dynamic backend: fs_write_bytes runtime lowering failed")) }
        lowered = result_unwrap(write_runtime)
        let array_set_runtime: Result[EmitState, String] = emit_array_set_runtime(lowered)
        if is_err(array_set_runtime) { return err(unwrap_or(result_error(array_set_runtime), "dynamic backend: array_set runtime lowering failed")) }
        lowered = result_unwrap(array_set_runtime)
        let array_slice_runtime: Result[EmitState, String] = emit_array_slice_runtime(lowered)
        if is_err(array_slice_runtime) { return err(unwrap_or(result_error(array_slice_runtime), "dynamic backend: array_slice runtime lowering failed")) }
        lowered = result_unwrap(array_slice_runtime)
    }
    if lowered.assembler.common.string_concat_used {
        let runtime: Result[EmitState, String] = emit_string_concat_runtime(lowered)
        if is_err(runtime) { return err(unwrap_or(result_error(runtime), "dynamic backend: String runtime lowering failed")) }
        lowered = result_unwrap(runtime)
    }
    if lowered.assembler.common.array_runtime_used {
        let allocator: Result[EmitState, String] = emit_array_alloc_runtime(lowered)
        if is_err(allocator) { return err(unwrap_or(result_error(allocator), "dynamic backend: Array allocator lowering failed")) }
        let pushed: Result[EmitState, String] = emit_array_push_runtime(result_unwrap(allocator))
        if is_err(pushed) { return err(unwrap_or(result_error(pushed), "dynamic backend: Array push lowering failed")) }
        let concatenated: Result[EmitState, String] = emit_array_concat_runtime(result_unwrap(pushed))
        if is_err(concatenated) { return err(unwrap_or(result_error(concatenated), "dynamic backend: Array concat lowering failed")) }
        lowered = result_unwrap(concatenated)
    }
    if lowered.assembler.common.box_runtime_used {
        let boxed: Result[EmitState, String] = emit_box_alloc_runtime(lowered)
        if is_err(boxed) { return err(unwrap_or(result_error(boxed), "dynamic backend: Option/Result runtime lowering failed")) }
        lowered = result_unwrap(boxed)
    }
    let ended: Result[EmitState, String] = bind_label(lowered, end_label.label)
    if is_err(ended) { return err(unwrap_or(result_error(ended), "dynamic backend: cannot bind end")) }
    let normal: EmitState = emit_exit(result_unwrap(ended), u8(0))
    let trapped: Result[EmitState, String] = bind_label(normal, trap_label.label)
    if is_err(trapped) { return err(unwrap_or(result_error(trapped), "dynamic backend: cannot bind trap")) }
    let failed: EmitState = emit_exit(result_unwrap(trapped), u8(1))
    let prepared_code: Result[EmitState, String] = prepare_code_pages(failed)
    if is_err(prepared_code) { return err(unwrap_or(result_error(prepared_code), "dynamic backend: cannot prepare code chunks for patching")) }
    let page_state: EmitState = result_unwrap(prepared_code)
    let frame: Result[EmitState, String] = patch_code(page_state, page_state.assembler.common.frame_patch, i32_bytes(align_frame(page_state.env.buffer_offset + 63)))
    if is_err(frame) { return err(unwrap_or(result_error(frame), "dynamic backend: frame patch failed")) }
    let jumps: Result[EmitState, String] = finalize_jumps(result_unwrap(frame))
    if is_err(jumps) {
        let message: String = unwrap_or(result_error(jumps), "dynamic backend: jump finalization failed")
        return err(message)
    }
    let jump_patches: Result[EmitState, String] = apply_code_patches(result_unwrap(jumps))
    if is_err(jump_patches) { return err(unwrap_or(result_error(jump_patches), "dynamic backend: jump patch application failed")) }
    let mut data: Result[EmitState, String] = ok(result_unwrap(jump_patches))
    if !windows_target { data = finalize_data(result_unwrap(jump_patches)) }
    if is_err(data) {
        let message: String = unwrap_or(result_error(data), "dynamic backend: data finalization failed")
        return err(message)
    }
    let mut patched: Result[EmitState, String] = data
    if !windows_target { patched = apply_code_patches(result_unwrap(data)) }
    if is_err(patched) { return err(unwrap_or(result_error(patched), "dynamic backend: code patch application failed")) }
    let result: EmitState = flatten_code_pages(result_unwrap(patched))
    let mut imports: Array[NativeImageImport] = []
    let mut data_relocations: Array[NativeImageDataRelocation] = []
    let mut import_relocations: Array[NativeImageImportRelocation] = []
    let mut function_ranges: Array[NativeImageFunctionRange] = []
    if windows_target {
        let needs_heap: Bool = result.assembler.common.string_concat_used || result.assembler.common.array_runtime_used || result.assembler.common.box_runtime_used || result.assembler.common.host_runtime_used || result.assembler.common.ffi_runtime_used
        let import_pairs: Array[Array[String]] = pe_dynamic_imports(needs_heap, result.assembler.common.host_runtime_used, result.assembler.common.ffi_runtime_used)
        for index in array_indices(import_pairs) {
            let pair_option: Option[Array[String]] = array_get(import_pairs, index)
            if is_none(pair_option) { return err("dynamic backend: PE import index is out of bounds") }
            let pair: Array[String] = unwrap_or(pair_option, [])
            if len(pair) != 2 { return err("dynamic backend: malformed PE import table") }
            let library_option: Option[String] = array_get(pair, 0)
            let symbol_option: Option[String] = array_get(pair, 1)
            if is_none(library_option) || is_none(symbol_option) { return err("dynamic backend: malformed PE import table") }
            imports = array_push(imports, NativeImageImport{ library: unwrap_or(library_option, ""), symbol: unwrap_or(symbol_option, "") })
        }
        for index in array_indices(result.assembler.common.data_patches) {
            let patch_option: Option[DataPatch] = array_get(result.assembler.common.data_patches, index)
            if is_none(patch_option) { return err("dynamic backend: data relocation index is out of bounds") }
            let patch: DataPatch = unwrap_or(patch_option, DataPatch{ displacement: 0, instruction_end: 0, data_offset: 0 })
            data_relocations = array_push(data_relocations, NativeImageDataRelocation{ displacement: patch.displacement, instruction_end: patch.instruction_end, data_offset: patch.data_offset })
        }
        for index in array_indices(result.assembler.common.import_patches) {
            let patch_option: Option[PEImportPatch] = array_get(result.assembler.common.import_patches, index)
            if is_none(patch_option) { return err("dynamic backend: PE import relocation index is out of bounds") }
            let patch: PEImportPatch = unwrap_or(patch_option, PEImportPatch{ displacement: 0, instruction_end: 0, import_index: 0 })
            import_relocations = array_push(import_relocations, NativeImageImportRelocation{ displacement: patch.displacement, instruction_end: patch.instruction_end, import_index: patch.import_index })
        }
        for index in array_indices(result.assembler.common.function_ranges) {
            let range_option: Option[Array[Int]] = array_get(result.assembler.common.function_ranges, index)
            if is_none(range_option) { return err("dynamic backend: function range index is out of bounds") }
            let range: Array[Int] = unwrap_or(range_option, [])
            if len(range) != 3 { return err("dynamic backend: malformed PE function range") }
            let start_option: Option[Int] = array_get(range, 0)
            let end_option: Option[Int] = array_get(range, 1)
            let size_option: Option[Int] = array_get(range, 2)
            if is_none(start_option) || is_none(end_option) || is_none(size_option) { return err("dynamic backend: malformed PE function range") }
            function_ranges = array_push(function_ranges, NativeImageFunctionRange{ start: unwrap_or(start_option, 0), end: unwrap_or(end_option, 0), stack_size: unwrap_or(size_option, 0) })
        }
    }
    return ok(LoweredNativeImage{ target_os: text(field(target, "os")), target_arch: text(field(target, "arch")), gui: gui_target, code: result.assembler.code_state.code, data: result.assembler.common.data, imports: imports, data_relocations: data_relocations, import_relocations: import_relocations, function_ranges: function_ranges })
}

fn compile_dynamic(kir: ValidatedKIR) -> Result[Bytes, String] {
    let lowered: Result[LoweredNativeImage, String] = lower_dynamic(kir)
    if is_err(lowered) { return err(unwrap_or(result_error(lowered), "dynamic backend: lowering failed")) }
    return emit_native_image(result_unwrap(lowered))
}

fn has_dynamic_expression(expression: KIRTypedNodeView) -> Bool {
    let kind: String = text(field(expression, "kind"))
    if kind == "array" || kind == "index" { return true }
    if kind == "call" {
        let target: String = text(field(expression, "call_target"))
        if target == "builtin:int" || target == "builtin:len" || target == "builtin:bytes" || target == "builtin:process_args" || target == "builtin:fs_read_text" || target == "builtin:fs_write_bytes" || target == "builtin:array_push" || target == "builtin:array_get" || target == "builtin:array_indices" || target == "builtin:array_concat" || target == "builtin:some" || target == "builtin:none" || target == "builtin:ok" || target == "builtin:err" || target == "builtin:is_some" || target == "builtin:is_none" || target == "builtin:is_ok" || target == "builtin:is_err" || target == "builtin:unwrap_or" || target == "builtin:result_unwrap" || target == "builtin:result_error" {
            return true
        }
        let arguments: KIRTypedNodeView = field(expression, "args")
        let count: Int = result_unwrap(kir_typed_array_len(arguments))
        let mut index: Int = 0
        while index < count {
            if has_dynamic_expression(result_unwrap(kir_typed_array_get(arguments, index))) { return true }
            index = index + 1
        }
        return false
    }
    if kind == "binary" {
        return has_dynamic_expression(field(expression, "left")) || has_dynamic_expression(field(expression, "right"))
    }
    if kind == "unary" { return has_dynamic_expression(field(expression, "operand")) }
    return false
}

fn has_dynamic(statements: KIRTypedNodeView) -> Bool {
    let count: Int = result_unwrap(kir_typed_array_len(statements))
    let mut index: Int = 0
    while index < count {
        let statement: KIRTypedNodeView = result_unwrap(kir_typed_array_get(statements, index))
        let kind: String = text(field(statement, "kind"))
        if kind == "if" || kind == "while" || kind == "assign" || kind == "break" || kind == "continue" { return true }
        if kind == "let" || kind == "const" {
            if result_unwrap(kir_typed_bool(field(statement, "mutable"))) { return true }
            if has_dynamic_expression(field(statement, "init")) { return true }
        }
        if kind == "expr" && has_dynamic_expression(field(statement, "expr")) { return true }
        index = index + 1
    }
    return false
}

pub fn compile_document(document: Json) -> Result[Bytes, String] {
    let validated: Result[ValidatedKIR, String] = validate_kir_document(document)
    if is_err(validated) { return err("KIR validation failed: " + unwrap_or(result_error(validated), "invalid document")) }
    return compile_validated_kir(result_unwrap(validated))
}

pub fn compile_validated_kir(kir: ValidatedKIR) -> Result[Bytes, String] {
    let checked_document: KIRTypedNodeView = validated_kir_typed_root(kir)
    let target: KIRTypedNodeView = field(checked_document, "target")
    let windows_target: Bool = text(field(target, "os")) == "windows"
    if windows_target || result_unwrap(kir_typed_array_len(field(checked_document, "functions"))) > 0 {
        let dynamic: Result[Bytes, String] = compile_dynamic(kir)
        if is_err(dynamic) { return err("dynamic compile failed: " + unwrap_or(result_error(dynamic), "unknown error")) }
        return dynamic
    }
    if has_dynamic(field(checked_document, "statements")) {
        let dynamic: Result[Bytes, String] = compile_dynamic(kir)
        if is_err(dynamic) { return err("dynamic compile failed: " + unwrap_or(result_error(dynamic), "unknown error")) }
        return dynamic
    }
    return compile_kir(kir)
}
