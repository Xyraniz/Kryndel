fn code_chunk_get(values: ChunkedCode, index: Int) -> Array[UInt8] {
    if index < 0 || index >= values.chunk_count { return [] }
    let page_index: Int = index / 128
    let chunk_index: Int = index % 128
    let page: Array[Array[UInt8]] = unwrap_or(array_get(values.pages, page_index), [])
    return unwrap_or(array_get(page, chunk_index), [])
}

fn code_chunk_set(values: ChunkedCode, index: Int, chunk: Array[UInt8]) -> Result[ChunkedCode, String] {
    if index < 0 || index >= values.chunk_count { return err("dynamic backend: code chunk index is out of range") }
    let page_index: Int = index / 128
    let chunk_index: Int = index % 128
    let page: Array[Array[UInt8]] = unwrap_or(array_get(values.pages, page_index), [])
    let updated_page: Result[Array[Array[UInt8]], String] = array_set(page, chunk_index, chunk)
    if is_err(updated_page) { return err(unwrap_or(result_error(updated_page), "dynamic backend: cannot update code page")) }
    let updated_pages: Result[Array[Array[Array[UInt8]]], String] = array_set(values.pages, page_index, result_unwrap(updated_page))
    if is_err(updated_pages) { return err(unwrap_or(result_error(updated_pages), "dynamic backend: cannot update code pages")) }
    return ok(ChunkedCode{ pages: result_unwrap(updated_pages), chunk_count: values.chunk_count, length: values.length })
}

fn new_label(state: EmitState) -> LabelState {
    let label: Int = state.assembler.labels.length
    let labels: ChunkedInts = chunked_int_push(state.assembler.labels, -1)
    return LabelState{ state: state_with_labels(state, labels), label: label }
}

fn bind_label(state: EmitState, label: Int) -> Result[EmitState, String] {
    if label < 0 || label >= state.assembler.labels.length {
        return err("dynamic backend: label " + str(label) + " was already bound or does not exist (position -2, count " + str(state.assembler.labels.length) + ", code " + str(state.assembler.code_length) + ", function '" + state.env.current_function + "')")
    }
    let position: Int = chunked_int_get(state.assembler.labels, label)
    if position != -1 {
        return err("dynamic backend: label " + str(label) + " was already bound or does not exist (position " + str(position) + ", count " + str(state.assembler.labels.length) + ")")
    }
    let updated: Result[ChunkedInts, String] = chunked_int_set(state.assembler.labels, label, state.assembler.code_length)
    if is_err(updated) { return err(unwrap_or(result_error(updated), "dynamic backend: cannot bind label")) }
    return ok(state_with_labels(state, result_unwrap(updated)))
}

fn emit_jump(state: EmitState, label: Int, conditional: Bool, condition: UInt8) -> EmitState {
    let mut instruction: Array[UInt8] = []
    if conditional {
        instruction = [u8(15), condition]
    } else {
        instruction = [u8(233)]
    }
    let position: Int = state.assembler.code_length + len(instruction)
    instruction = array_concat(instruction, [u8(0), u8(0), u8(0), u8(0)])
    let updated: EmitState = append_code(state, instruction)
    return state_with_jumps(updated, chunked_jump_push(updated.assembler.jumps, JumpPatch{ label: label, position: position, function: state.env.current_function }))
}

fn emit_relative_call(state: EmitState, label: Int) -> EmitState {
    let position: Int = state.assembler.code_length + 1
    let updated: EmitState = append_code(state, [u8(232), u8(0), u8(0), u8(0), u8(0)])
    return state_with_jumps(updated, chunked_jump_push(updated.assembler.jumps, JumpPatch{ label: label, position: position, function: state.env.current_function }))
}

fn emit_windows_stack_adjust(state: EmitState, subtract: Bool, amount: Int) -> EmitState {
    if amount == 0 { return state }
    let mut operation: UInt8 = u8(196)
    if subtract { operation = u8(236) }
    if amount <= 127 {
        return append_code(state, [u8(72), u8(131), operation, u8(amount)])
    }
    return append_code(state, array_concat([u8(72), u8(129), operation], i32_bytes(amount)))
}

fn emit_call(state: EmitState, name: String) -> Result[EmitState, String] {
    let label: Option[Int] = map_get(state.env.function_labels, name)
    if is_none(label) { return err("dynamic backend: unknown function '" + name + "'") }
    let mut current: EmitState = state
    let mut adjustment: Int = 0
    if current.assembler.windows_abi {
        adjustment = 32
        let remainder: Int = current.assembler.windows_stack_depth % 16
        if remainder != 0 { adjustment = adjustment + (16 - remainder) }
        current = append_code(current, [u8(72), u8(131), u8(236), u8(adjustment)])
    }
    let called: EmitState = emit_relative_call(current, unwrap_or(label, -1))
    if current.assembler.windows_abi { return ok(append_code(called, [u8(72), u8(131), u8(196), u8(adjustment)])) }
    return ok(called)
}

fn emit_label_call(state: EmitState, label: Int) -> EmitState {
    let mut current: EmitState = state
    let mut adjustment: Int = 0
    if current.assembler.windows_abi {
        adjustment = 32
        let remainder: Int = current.assembler.windows_stack_depth % 16
        if remainder != 0 { adjustment = adjustment + (16 - remainder) }
        current = append_code(current, [u8(72), u8(131), u8(236), u8(adjustment)])
    }
    let called: EmitState = emit_relative_call(current, label)
    if current.assembler.windows_abi { return append_code(called, [u8(72), u8(131), u8(196), u8(adjustment)]) }
    return called
}

fn emit_pe_import_transfer(state: EmitState, import_index: Int, jump: Bool) -> EmitState {
    let start: Int = state.assembler.code_length
    let opcode: UInt8 = u8(255)
    let mut operation: UInt8 = u8(21)
    if jump { operation = u8(37) }
    let with_code: EmitState = append_code(state, [opcode, operation, u8(0), u8(0), u8(0), u8(0)])
    let patch: PEImportPatch = PEImportPatch{ displacement: start + 2, instruction_end: start + 6, import_index: import_index }
    return state_with_import_patches(with_code, array_push(with_code.assembler.import_patches, patch))
}

fn pe_get_process_heap_import_index() -> Int {
    return 3
}

fn pe_heap_alloc_import_index() -> Int {
    return 4
}

fn pe_dynamic_imports(needs_heap: Bool) -> Array[Array[String]] {
    let mut imports: Array[Array[String]] = [
        ["KERNEL32.dll", "GetStdHandle"],
        ["KERNEL32.dll", "WriteFile"],
        ["KERNEL32.dll", "ExitProcess"]
    ]
    if needs_heap {
        // Keep indexes 0-2 stable for console I/O and process exit.
        // The Win32 process heap allocator occupies indexes 3 and 4.
        imports = array_push(imports, ["KERNEL32.dll", "GetProcessHeap"])
        imports = array_push(imports, ["KERNEL32.dll", "HeapAlloc"])
    }
    return imports
}

fn emit_move_arg(state: EmitState, index: Int) -> Result[EmitState, String] {
    if state.assembler.windows_abi {
        if index == 0 { return ok(append_code(state, [u8(72), u8(137), u8(193)])) }
        if index == 1 { return ok(append_code(state, [u8(72), u8(137), u8(194)])) }
        if index == 2 { return ok(append_code(state, [u8(73), u8(137), u8(192)])) }
        if index == 3 { return ok(append_code(state, [u8(73), u8(137), u8(193)])) }
        return err("dynamic backend: Win64 register argument index must be between zero and three")
    }
    if index == 0 { return ok(append_code(state, [u8(72), u8(137), u8(199)])) }
    if index == 1 { return ok(append_code(state, [u8(72), u8(137), u8(198)])) }
    if index == 2 { return ok(append_code(state, [u8(72), u8(137), u8(194)])) }
    if index == 3 { return ok(append_code(state, [u8(72), u8(137), u8(193)])) }
    if index == 4 { return ok(append_code(state, [u8(73), u8(137), u8(192)])) }
    if index == 5 { return ok(append_code(state, [u8(73), u8(137), u8(193)])) }
    return err("dynamic backend: at most six scalar arguments are supported")
}

fn emit_store_arg(state: EmitState, index: Int, slot: Int) -> Result[EmitState, String] {
    let mut moved: EmitState = state
    if state.assembler.windows_abi {
        if index == 0 { moved = append_code(moved, [u8(72), u8(137), u8(200)]) }
        else if index == 1 { moved = append_code(moved, [u8(72), u8(137), u8(208)]) }
        else if index == 2 { moved = append_code(moved, [u8(76), u8(137), u8(192)]) }
        else if index == 3 { moved = append_code(moved, [u8(76), u8(137), u8(200)]) }
        else if index >= 4 {
            let caller_stack_offset: Int = 48 + (index - 4) * 8
            moved = append_code(moved, array_concat([u8(72), u8(139), u8(133)], i32_bytes(caller_stack_offset)))
        } else { return err("dynamic backend: Win64 parameter index is invalid") }
        return ok(emit_store_slot(moved, slot))
    }
    if index == 0 { moved = append_code(moved, [u8(72), u8(137), u8(248)]) }
    else if index == 1 { moved = append_code(moved, [u8(72), u8(137), u8(240)]) }
    else if index == 2 { moved = append_code(moved, [u8(72), u8(137), u8(208)]) }
    else if index == 3 { moved = append_code(moved, [u8(72), u8(137), u8(200)]) }
    else if index == 4 { moved = append_code(moved, [u8(76), u8(137), u8(192)]) }
    else if index == 5 { moved = append_code(moved, [u8(76), u8(137), u8(200)]) }
    else { return err("dynamic backend: at most six scalar arguments are supported") }
    return ok(emit_store_slot(moved, slot))
}

fn parameter_slots(parameters: Json) -> Map[String, Int] {
    let count: Int = result_unwrap(json_array_len(parameters))
    let mut index: Int = 0
    let mut slots: Map[String, Int] = {}
    while index < count {
        let parameter: Json = result_unwrap(json_array_get(parameters, index))
        slots = map_insert(slots, text(field(parameter, "name")), (index + 1) * 8)
        index = index + 1
    }
    return slots
}

fn emit_function_frame(state: EmitState, frame: Int) -> EmitState {
    return append_code(state, array_concat([u8(85), u8(72), u8(137), u8(229), u8(72), u8(129), u8(236)], i32_bytes(frame)))
}

fn emit_prologue(state: EmitState) -> EmitState {
    let code: Array[UInt8] = [u8(85), u8(72), u8(137), u8(229), u8(72), u8(129), u8(236), u8(0), u8(0), u8(0), u8(0)]
    return state_with_frame_patch(state_with_code(state, code), 7)
}

fn emit_exit(state: EmitState, status: UInt8) -> EmitState {
    if state.assembler.windows_abi {
        // The trap target is also reachable from runtime helpers with literal
        // pushes that are not reflected in windows_stack_depth. Align using
        // the live RSP before making the non-returning Win32 call.
        let mut current: EmitState = append_code(state, [
            u8(73), u8(137), u8(227),
            u8(72), u8(131), u8(228), u8(240),
            u8(72), u8(131), u8(236), u8(48),
            u8(76), u8(137), u8(92), u8(36), u8(32),
            u8(185), status, u8(0), u8(0), u8(0)
        ])
        current = emit_pe_import_transfer(current, 2, false)
        return append_code(current, [u8(15), u8(11)])
    }
    return append_code(state, [u8(184), u8(60), u8(0), u8(0), u8(0), u8(191), status, u8(0), u8(0), u8(0), u8(15), u8(5)])
}

fn emit_int(state: EmitState, value: Int) -> EmitState {
    return append_code(state, array_concat([u8(72), u8(184)], dyn_u64_bytes(int_u64(value))))
}

fn emit_uint_mask(state: EmitState, bits: Int) -> EmitState {
    if bits == 0 || bits == 64 {
        return state
    }
    let mask: UInt64 = (u64(1) << bits) - u64(1)
    // AND EAX, imm32 also clears the high half of RAX. Keep this byte form
    // identical to the Go direct backend so self-hosted output stays exact.
    return append_code(state, array_concat([u8(37)], dyn_u32_bytes(u32(mask))))
}

fn emit_uint(state: EmitState, value: UInt64, bits: Int) -> EmitState {
    let loaded: EmitState = append_code(state, array_concat([u8(72), u8(184)], dyn_u64_bytes(value)))
    return emit_uint_mask(loaded, bits)
}

fn emit_load_slot(state: EmitState, slot: Int) -> EmitState {
    return append_code(state, array_concat([u8(72), u8(139), u8(133)], i32_bytes(0 - slot)))
}

fn emit_store_slot(state: EmitState, slot: Int) -> EmitState {
    return append_code(state, array_concat([u8(72), u8(137), u8(133)], i32_bytes(0 - slot)))
}

fn emit_windows_write(state: EmitState) -> Result[EmitState, String] {
    if !state.assembler.windows_abi { return err("dynamic backend: Windows WriteFile helper used for a non-Windows target") }
    let loop_label: LabelState = new_label(state)
    let done_label: LabelState = new_label(loop_label.state)
    let failed_label: LabelState = new_label(done_label.state)
    let large_label: LabelState = new_label(failed_label.state)
    let count_ready_label: LabelState = new_label(large_label.state)
    let after_label: LabelState = new_label(count_ready_label.state)
    let mut current: EmitState = append_code(after_label.state, [
        u8(72), u8(131), u8(236), u8(96),
        u8(72), u8(137), u8(84), u8(36), u8(56),
        u8(76), u8(137), u8(68), u8(36), u8(64),
        u8(72), u8(199), u8(68), u8(36), u8(32), u8(0), u8(0), u8(0), u8(0),
        u8(185), u8(245), u8(255), u8(255), u8(255)
    ])
    current = emit_pe_import_transfer(current, 0, false)
    current = append_code(current, [u8(72), u8(133), u8(192)])
    current = emit_jump(current, failed_label.label, true, u8(132))
    current = append_code(current, [u8(72), u8(131), u8(248), u8(255)])
    current = emit_jump(current, failed_label.label, true, u8(132))
    current = append_code(current, [u8(72), u8(137), u8(68), u8(36), u8(48)])
    let bound_loop: Result[EmitState, String] = bind_label(current, loop_label.label)
    if is_err(bound_loop) { return err(unwrap_or(result_error(bound_loop), "dynamic backend: cannot bind WriteFile loop")) }
    current = append_code(result_unwrap(bound_loop), [u8(72), u8(131), u8(124), u8(36), u8(64), u8(0)])
    current = emit_jump(current, done_label.label, true, u8(132))
    current = append_code(current, [
        u8(72), u8(139), u8(76), u8(36), u8(48),
        u8(72), u8(139), u8(84), u8(36), u8(56),
        u8(131), u8(124), u8(36), u8(68), u8(0)
    ])
    current = emit_jump(current, large_label.label, true, u8(133))
    current = append_code(current, [u8(68), u8(139), u8(68), u8(36), u8(64)])
    current = emit_jump(current, count_ready_label.label, false, u8(0))
    let bound_large: Result[EmitState, String] = bind_label(current, large_label.label)
    if is_err(bound_large) { return err(unwrap_or(result_error(bound_large), "dynamic backend: cannot bind WriteFile large-count path")) }
    current = append_code(result_unwrap(bound_large), [u8(65), u8(184), u8(255), u8(255), u8(255), u8(255)])
    let bound_count: Result[EmitState, String] = bind_label(current, count_ready_label.label)
    if is_err(bound_count) { return err(unwrap_or(result_error(bound_count), "dynamic backend: cannot bind WriteFile count")) }
    current = append_code(result_unwrap(bound_count), [
        u8(199), u8(68), u8(36), u8(40), u8(0), u8(0), u8(0), u8(0),
        u8(76), u8(141), u8(76), u8(36), u8(40)
    ])
    current = emit_pe_import_transfer(current, 1, false)
    current = append_code(current, [u8(133), u8(192)])
    current = emit_jump(current, failed_label.label, true, u8(132))
    current = append_code(current, [u8(139), u8(76), u8(36), u8(40), u8(133), u8(201)])
    current = emit_jump(current, failed_label.label, true, u8(132))
    current = append_code(current, [
        u8(72), u8(1), u8(76), u8(36), u8(56),
        u8(72), u8(41), u8(76), u8(36), u8(64)
    ])
    current = emit_jump(current, loop_label.label, false, u8(0))
    let bound_done: Result[EmitState, String] = bind_label(current, done_label.label)
    if is_err(bound_done) { return err(unwrap_or(result_error(bound_done), "dynamic backend: cannot bind WriteFile success")) }
    current = append_code(result_unwrap(bound_done), [u8(72), u8(131), u8(196), u8(96)])
    current = emit_jump(current, after_label.label, false, u8(0))
    let bound_failed: Result[EmitState, String] = bind_label(current, failed_label.label)
    if is_err(bound_failed) { return err(unwrap_or(result_error(bound_failed), "dynamic backend: cannot bind WriteFile failure")) }
    current = append_code(result_unwrap(bound_failed), [u8(72), u8(131), u8(196), u8(96)])
    current = emit_jump(current, current.env.trap_label, false, u8(0))
    let bound_after: Result[EmitState, String] = bind_label(current, after_label.label)
    if is_err(bound_after) { return err(unwrap_or(result_error(bound_after), "dynamic backend: cannot bind WriteFile continuation")) }
    return ok(result_unwrap(bound_after))
}

fn emit_write(state: EmitState, value: String) -> Result[EmitState, String] {
    let bytes: Array[UInt8] = u8_array(string_to_bytes(value))
    let known_offset: Option[Int] = map_get(state.assembler.data_by_text, value)
    let mut data_offset: Int = 0
    let mut with_data: EmitState = state
    if is_some(known_offset) {
        data_offset = unwrap_or(known_offset, 0)
    } else {
        data_offset = len(state.assembler.data)
        with_data = state_with_data_index(
            state,
            array_concat(state.assembler.data, bytes),
            map_insert(state.assembler.data_by_text, value, data_offset)
        )
    }
    let start: Int = with_data.assembler.code_length
    if with_data.assembler.windows_abi {
        if len(bytes) > 2147483647 { return err("dynamic backend: Windows literal output is too large") }
        let with_code: EmitState = append_code(with_data, array_concat([u8(72), u8(141), u8(21), u8(0), u8(0), u8(0), u8(0), u8(65), u8(184)], i32_bytes(len(bytes))))
        let patch: DataPatch = DataPatch{ displacement: start + 3, instruction_end: start + 7, data_offset: data_offset }
        let patched: EmitState = state_with_data_patches(with_code, array_push(with_code.assembler.data_patches, patch))
        return emit_windows_write(patched)
    }
    let code: Array[UInt8] = array_concat(
        [
            u8(184), u8(1), u8(0), u8(0), u8(0),
            u8(191), u8(1), u8(0), u8(0), u8(0),
            u8(72), u8(141), u8(53), u8(0), u8(0), u8(0), u8(0),
            u8(186)
        ],
        array_concat(i32_bytes(len(bytes)), [u8(15), u8(5)])
    )
    let with_code: EmitState = append_code(with_data, code)
    let patch: DataPatch = DataPatch{ displacement: start + 13, instruction_end: start + 17, data_offset: data_offset }
    return ok(state_with_data_patches(with_code, array_push(with_code.assembler.data_patches, patch)))
}

fn emit_string(state: EmitState, value: String) -> EmitState {
    let known_offset: Option[Int] = map_get(state.assembler.string_data_by_text, value)
    let mut data_offset: Int = 0
    let mut with_data: EmitState = state
    if is_some(known_offset) {
        data_offset = unwrap_or(known_offset, 0)
    } else {
        let bytes: Array[UInt8] = u8_array(string_to_bytes(value))
        let object: Array[UInt8] = array_concat(dyn_u64_bytes(u64(len(bytes))), bytes)
        data_offset = len(state.assembler.data)
        with_data = state_with_string_data_index(
            state,
            array_concat(state.assembler.data, object),
            map_insert(state.assembler.string_data_by_text, value, data_offset)
        )
    }
    let start: Int = with_data.assembler.code_length
    let with_code: EmitState = append_code(with_data, [u8(72), u8(141), u8(5), u8(0), u8(0), u8(0), u8(0)])
    let patch: DataPatch = DataPatch{ displacement: start + 3, instruction_end: start + 7, data_offset: data_offset }
    return state_with_data_patches(with_code, array_push(with_code.assembler.data_patches, patch))
}

fn emit_string_write(state: EmitState) -> Result[EmitState, String] {
    if state.assembler.windows_abi {
        let pointer_and_length: EmitState = append_code(state, [u8(76), u8(139), u8(0), u8(72), u8(141), u8(80), u8(8)])
        return emit_windows_write(pointer_and_length)
    }
    return ok(append_code(state, [u8(72), u8(139), u8(16), u8(72), u8(141), u8(112), u8(8), u8(184), u8(1), u8(0), u8(0), u8(0), u8(191), u8(1), u8(0), u8(0), u8(0), u8(15), u8(5)]))
}

fn emit_boolean_output(state: EmitState, expression: Json, newline: Bool) -> Result[EmitState, String] {
    let emitted: Result[EmitState, String] = emit_expression(state, expression)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let mut current: EmitState = append_code(result_unwrap(emitted), [u8(72), u8(133), u8(192)])
    let false_label: LabelState = new_label(current)
    let join_label: LabelState = new_label(false_label.state)
    current = emit_jump(join_label.state, false_label.label, true, u8(132))
    let written_true: Result[EmitState, String] = emit_write(current, "true")
    if is_err(written_true) { return err(unwrap_or(result_error(written_true), "dynamic backend: true output failed")) }
    current = result_unwrap(written_true)
    current = emit_jump(current, join_label.label, false, u8(0))
    let bound_false: Result[EmitState, String] = bind_label(current, false_label.label)
    if is_err(bound_false) { return err(unwrap_or(result_error(bound_false), "dynamic backend: cannot bind boolean false path")) }
    let written_false: Result[EmitState, String] = emit_write(result_unwrap(bound_false), "false")
    if is_err(written_false) { return err(unwrap_or(result_error(written_false), "dynamic backend: false output failed")) }
    current = result_unwrap(written_false)
    let bound_join: Result[EmitState, String] = bind_label(current, join_label.label)
    if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind boolean output join")) }
    current = result_unwrap(bound_join)
    if newline {
        let line: Result[EmitState, String] = emit_write(current, "\n")
        if is_err(line) { return err(unwrap_or(result_error(line), "dynamic backend: boolean newline output failed")) }
        current = result_unwrap(line)
    }
    return ok(current)
}

fn emit_string_concat_call(state: EmitState) -> EmitState {
    let moved: EmitState = append_code(state, [u8(72), u8(137), u8(199), u8(72), u8(137), u8(206)])
    return emit_label_call(state_with_string_concat_used(moved), moved.assembler.string_concat_label)
}

fn emit_heap_alloc(state: EmitState) -> EmitState {
    if state.assembler.windows_abi {
        // Runtime helpers have different literal push prologues, so align from
        // the live RSP at each Win32 call instead of assuming a fixed depth.
        // Keep the saved RSP after the 32-byte shadow space and restore it
        // without relying on volatile registers across the API call.
        let mut current: EmitState = append_code(state, [
            u8(73), u8(137), u8(227),
            u8(72), u8(131), u8(228), u8(240),
            u8(72), u8(131), u8(236), u8(48),
            u8(76), u8(137), u8(92), u8(36), u8(32)
        ])
        current = emit_pe_import_transfer(current, pe_get_process_heap_import_index(), false)
        current = append_code(current, [
            u8(72), u8(139), u8(100), u8(36), u8(32),
            u8(72), u8(133), u8(192)
        ])
        current = emit_jump(current, current.env.trap_label, true, u8(132))
        current = append_code(current, [
            u8(72), u8(137), u8(193),
            u8(72), u8(49), u8(210),
            u8(73), u8(137), u8(248),
            u8(73), u8(137), u8(227),
            u8(72), u8(131), u8(228), u8(240),
            u8(72), u8(131), u8(236), u8(48),
            u8(76), u8(137), u8(92), u8(36), u8(32)
        ])
        current = emit_pe_import_transfer(current, pe_heap_alloc_import_index(), false)
        current = append_code(current, [
            u8(72), u8(139), u8(100), u8(36), u8(32),
            u8(72), u8(133), u8(192)
        ])
        current = emit_jump(current, current.env.trap_label, true, u8(132))
        return current
    }
    // rdi=requested bytes; return a 16-byte-aligned block from the process
    // break. A shared heap avoids one page mapping per small runtime object.
    let mut current: EmitState = append_code(state, [
        u8(72), u8(137), u8(254), u8(184), u8(12), u8(0), u8(0), u8(0), u8(72), u8(49), u8(255), u8(15), u8(5),
        u8(72), u8(137), u8(194), u8(72), u8(131), u8(198), u8(15)
    ])
    current = emit_jump(current, current.env.trap_label, true, u8(130))
    current = append_code(current, [
        u8(72), u8(129), u8(230), u8(240), u8(255), u8(255), u8(255), u8(72), u8(1), u8(214)
    ])
    current = emit_jump(current, current.env.trap_label, true, u8(130))
    current = append_code(current, [
