    let bound_loop: Result[EmitState, String] = bind_label(current, trailing_loop.label)
    if is_err(bound_loop) { return err(unwrap_or(result_error(bound_loop), "dynamic backend: cannot bind JSON parse trailing loop")) }
    current = append_code(result_unwrap(bound_loop), [u8(77), u8(57), u8(238)])
    current = emit_jump(current, success.label, true, u8(131))
    current = append_code(current, [u8(75), u8(15), u8(182), u8(68), u8(52), u8(8)])
    current = append_code(current, [u8(60), u8(32)])
    current = emit_jump(current, trailing_next.label, true, u8(132))
    current = append_code(current, [u8(60), u8(9)])
    current = emit_jump(current, trailing_next.label, true, u8(132))
    current = append_code(current, [u8(60), u8(10)])
    current = emit_jump(current, trailing_next.label, true, u8(132))
    current = append_code(current, [u8(60), u8(13)])
    current = emit_jump(current, trailing_next.label, true, u8(132))
    current = emit_jump(current, failure.label, false, u8(0))
    let bound_next: Result[EmitState, String] = bind_label(current, trailing_next.label)
    if is_err(bound_next) { return err(unwrap_or(result_error(bound_next), "dynamic backend: cannot bind JSON parse trailing whitespace")) }
    current = append_code(result_unwrap(bound_next), [u8(73), u8(255), u8(198)])
    current = emit_jump(current, trailing_loop.label, false, u8(0))
    let bound_success: Result[EmitState, String] = bind_label(current, success.label)
    if is_err(bound_success) { return err(unwrap_or(result_error(bound_success), "dynamic backend: cannot bind JSON parse success")) }
    current = append_code(result_unwrap(bound_success), [u8(76), u8(137), u8(224)])
    current = emit_box_call(current, u64(0))
    current = append_code(current, [u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92), u8(93), u8(91), u8(195)])
    let bound_failure: Result[EmitState, String] = bind_label(current, failure.label)
    if is_err(bound_failure) { return err(unwrap_or(result_error(bound_failure), "dynamic backend: cannot bind JSON parse failure")) }
    current = emit_string(result_unwrap(bound_failure), "invalid JSON")
    current = emit_box_call(current, u64(1))
