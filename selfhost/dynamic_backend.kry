    let a: Assembler = state.assembler
    let updated: Assembler = Assembler{ code: a.code, code_chunks: a.code_chunks, code_length: a.code_length, data: a.data, data_by_text: a.data_by_text, string_data_by_text: a.string_data_by_text, labels: a.labels, jumps: a.jumps, data_patches: a.data_patches, frame_patch: a.frame_patch, string_concat_label: a.string_concat_label, string_concat_used: a.string_concat_used, array_alloc_label: a.array_alloc_label, array_push_label: a.array_push_label, array_concat_label: a.array_concat_label, array_runtime_used: a.array_runtime_used, box_alloc_label: a.box_alloc_label, box_runtime_used: a.box_runtime_used, host_runtime_used: a.host_runtime_used, windows_abi: a.windows_abi, windows_stack_depth: depth, import_patches: a.import_patches, function_ranges: a.function_ranges }
