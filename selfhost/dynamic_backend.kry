fn state_with_code_chunks(state: EmitState, chunks: Array[Array[UInt8]], length: Int) -> EmitState {
    let mut code: Array[UInt8] = state.assembler.code_state.code
    if len(chunks) == 0 { code = [] }
    return EmitState{
        assembler: Assembler{ code_state: AssemblerCode{ code: code, code_chunks: chunks, code_length: length }, labels: state.assembler.labels, next_label: state.assembler.next_label, jumps: state.assembler.jumps, common: state.assembler.common },
        env: state.env,
        code_patches: state.code_patches,
        code_pages: state.code_pages,
    }
}

fn append_code(state: EmitState, bytes: Array[UInt8]) -> EmitState {
    if len(bytes) == 0 { return state }
    let mut chunks: Array[Array[UInt8]] = state.assembler.code_state.code_chunks
    let mut length: Int = state.assembler.code_state.code_length
    if len(chunks) == 0 && len(state.assembler.code_state.code) > 0 {
        chunks = [state.assembler.code_state.code]
        length = len(state.assembler.code_state.code)
    }
    let chunk_count: Int = len(chunks)
    if chunk_count == 0 {
        return state_with_code_chunks(state, [bytes], length + len(bytes))
    }
    let last_index: Int = chunk_count - 1
    let last: Array[UInt8] = unwrap_or(array_get(chunks, last_index), [])
    if len(last) + len(bytes) <= 256 {
        let combined: Array[UInt8] = array_concat(last, bytes)
        let updated: Result[Array[Array[UInt8]], String] = array_set(chunks, last_index, combined)
        if is_ok(updated) { return state_with_code_chunks(state, result_unwrap(updated), length + len(bytes)) }
    }
    return state_with_code_chunks(state, array_push(chunks, bytes), length + len(bytes))
}

fn materialize_code(state: EmitState) -> EmitState {
    if len(state.assembler.code_state.code_chunks) == 0 { return state }
    let mut code: Array[UInt8] = []
    let mut batch: Array[UInt8] = []
    for chunk in state.assembler.code_state.code_chunks {
        if len(batch) > 0 && len(batch) + len(chunk) > 65536 {
            code = array_concat(code, batch)
            batch = []
        }
        batch = array_concat(batch, chunk)
    }
    code = array_concat(code, batch)
    return state_with_code(state, code)
}

fn prepare_code_pages(state: EmitState) -> Result[EmitState, String] {
    let flattened: EmitState = materialize_code(state)
    let code: Array[UInt8] = flattened.assembler.code_state.code
    let code_length: Int = len(code)
    // Tiny immutable chunks keep patch reconstruction linear: array_push
    // copies its receiver, so rebuilding a 256-byte chunk per patched region
    // repeatedly copied far more bytes than the machine code itself.
    let chunk_count: Int = (code_length + 15) / 16
    let mut pages: Array[Array[Array[UInt8]]] = []
    let mut page: Array[Array[UInt8]] = []
    let mut index: Int = 0
    while index < chunk_count {
        let start: Int = index * 16
        let remaining: Int = code_length - start
        let mut chunk_length: Int = 16
        if remaining < chunk_length { chunk_length = remaining }
        let chunk: Array[UInt8] = array_slice(code, start, chunk_length)
        page = array_push(page, chunk)
        if len(page) == 128 || index + 1 == chunk_count {
            pages = array_push(pages, page)
            page = []
        }
        index = index + 1
    }
    let empty_chunks: Array[Array[UInt8]] = []
    let cleared: EmitState = state_with_code_chunks(flattened, empty_chunks, code_length)
    return ok(EmitState{
        assembler: cleared.assembler,
        env: cleared.env,
        code_patches: cleared.code_patches,
        code_pages: ChunkedCode{ pages: pages, chunk_count: chunk_count, length: code_length },
    })
}

fn flatten_code_pages(state: EmitState) -> EmitState {
    let mut code: Array[UInt8] = []
    let mut batch: Array[UInt8] = []
    for page in state.code_pages.pages {
        for chunk in page {
            if len(batch) > 0 && len(batch) + len(chunk) > 65536 {
                code = array_concat(code, batch)
                batch = []
            }
            batch = array_concat(batch, chunk)
        }
    }
    code = array_concat(code, batch)
    let flattened: EmitState = state_with_code(state, code)
    return EmitState{
        assembler: flattened.assembler,
        env: flattened.env,
        code_patches: ChunkedCodePatches{ pages: [], length: 0 },
        code_pages: ChunkedCode{ pages: [], chunk_count: 0, length: 0 },
    }
}

fn chunked_jump_get(values: ChunkedJumpPatches, index: Int) -> Option[JumpPatch] {
    if index < 0 || index >= values.length { return none() }
    let page_index: Int = index / 16384
    let chunk_index: Int = (index / 128) % 128
    let item_index: Int = index % 128
    let page: Array[Array[JumpPatch]] = unwrap_or(array_get(values.pages, page_index), [])
    let chunk: Array[JumpPatch] = unwrap_or(array_get(page, chunk_index), [])
    return array_get(chunk, item_index)
}

fn chunked_jump_push(values: ChunkedJumpPatches, value: JumpPatch) -> ChunkedJumpPatches {
    if values.length == 0 {
        let chunk: Array[JumpPatch] = [value]
        let page: Array[Array[JumpPatch]] = [chunk]
        return ChunkedJumpPatches{ pages: [page], length: 1 }
    }
    let page_index: Int = (values.length - 1) / 16384
    let chunk_index: Int = ((values.length - 1) / 128) % 128
    let page: Array[Array[JumpPatch]] = unwrap_or(array_get(values.pages, page_index), [])
    if values.length % 128 == 0 {
        let chunk: Array[JumpPatch] = [value]
        if values.length % 16384 == 0 {
            let new_page: Array[Array[JumpPatch]] = [chunk]
            return ChunkedJumpPatches{ pages: array_push(values.pages, new_page), length: values.length + 1 }
        }
        let new_page: Array[Array[JumpPatch]] = array_push(page, chunk)
        let pages: Result[Array[Array[Array[JumpPatch]]], String] = array_set(values.pages, page_index, new_page)
        return ChunkedJumpPatches{ pages: result_unwrap(pages), length: values.length + 1 }
    }
    let last_chunk: Array[JumpPatch] = unwrap_or(array_get(page, chunk_index), [])
    let new_chunk: Array[JumpPatch] = array_push(last_chunk, value)
    let updated_page: Result[Array[Array[JumpPatch]], String] = array_set(page, chunk_index, new_chunk)
    let pages: Result[Array[Array[Array[JumpPatch]]], String] = array_set(values.pages, page_index, result_unwrap(updated_page))
    return ChunkedJumpPatches{ pages: result_unwrap(pages), length: values.length + 1 }
}

fn chunked_code_patch_get(values: ChunkedCodePatches, index: Int) -> Option[CodePatch] {
    if index < 0 || index >= values.length { return none() }
    let page_index: Int = index / 16384
    let chunk_index: Int = (index / 128) % 128
    let item_index: Int = index % 128
    let page: Array[Array[CodePatch]] = unwrap_or(array_get(values.pages, page_index), [])
    let chunk: Array[CodePatch] = unwrap_or(array_get(page, chunk_index), [])
    return array_get(chunk, item_index)
}

fn chunked_code_patch_push(values: ChunkedCodePatches, value: CodePatch) -> ChunkedCodePatches {
    if values.length == 0 {
        let chunk: Array[CodePatch] = [value]
        let page: Array[Array[CodePatch]] = [chunk]
        return ChunkedCodePatches{ pages: [page], length: 1 }
    }
    let page_index: Int = (values.length - 1) / 16384
    let chunk_index: Int = ((values.length - 1) / 128) % 128
    let page: Array[Array[CodePatch]] = unwrap_or(array_get(values.pages, page_index), [])
    if values.length % 128 == 0 {
        let chunk: Array[CodePatch] = [value]
        if values.length % 16384 == 0 {
            let new_page: Array[Array[CodePatch]] = [chunk]
            return ChunkedCodePatches{ pages: array_push(values.pages, new_page), length: values.length + 1 }
        }
        let new_page: Array[Array[CodePatch]] = array_push(page, chunk)
        let pages: Result[Array[Array[Array[CodePatch]]], String] = array_set(values.pages, page_index, new_page)
        return ChunkedCodePatches{ pages: result_unwrap(pages), length: values.length + 1 }
    }
    let last_chunk: Array[CodePatch] = unwrap_or(array_get(page, chunk_index), [])
    let new_chunk: Array[CodePatch] = array_push(last_chunk, value)
    let updated_page: Result[Array[Array[CodePatch]], String] = array_set(page, chunk_index, new_chunk)
    let pages: Result[Array[Array[Array[CodePatch]]], String] = array_set(values.pages, page_index, result_unwrap(updated_page))
    return ChunkedCodePatches{ pages: result_unwrap(pages), length: values.length + 1 }
}

fn new_label(state: EmitState) -> LabelState {
    let label: Int = state.assembler.next_label
    let updated: EmitState = EmitState{
        assembler: Assembler{ code_state: state.assembler.code_state, labels: state.assembler.labels, next_label: label + 1, jumps: state.assembler.jumps, common: state.assembler.common },
        env: state.env,
        code_patches: state.code_patches,
        code_pages: state.code_pages,
    }
    return LabelState{ state: updated, label: label }
}

fn bind_label(state: EmitState, label: Int) -> Result[EmitState, String] {
    let label_key: String = str(label)
    let existing: Option[Int] = map_get(state.assembler.labels, label_key)
    if label < 0 || label >= state.assembler.next_label {
        return err("dynamic backend: label " + str(label) + " was already bound or does not exist (position -2, count " + str(state.assembler.next_label) + ", code " + str(state.assembler.code_state.code_length) + ", function '" + state.env.current_function + "')")
    }
    if is_some(existing) {
        return err("dynamic backend: label " + str(label) + " was already bound or does not exist (position " + str(unwrap_or(existing, -1)) + ", count " + str(state.assembler.next_label) + ")")
    }
    return ok(EmitState{
        assembler: Assembler{ code_state: state.assembler.code_state, labels: map_insert(state.assembler.labels, label_key, state.assembler.code_state.code_length), next_label: state.assembler.next_label, jumps: state.assembler.jumps, common: state.assembler.common },
        env: state.env,
        code_patches: state.code_patches,
        code_pages: state.code_pages,
    })
}

fn emit_jump(state: EmitState, label: Int, conditional: Bool, condition: UInt8) -> EmitState {
    let mut instruction: Array[UInt8] = []
    if conditional {
        instruction = [u8(15), condition]
    } else {
        instruction = [u8(233)]
    }
    let position: Int = state.assembler.code_state.code_length + len(instruction)
    instruction = array_concat(instruction, [u8(0), u8(0), u8(0), u8(0)])
    let updated: EmitState = append_code(state, instruction)
    return state_with_jumps(updated, chunked_jump_push(updated.assembler.jumps, JumpPatch{ label: label, position: position, function: state.env.current_function }))
}

fn emit_relative_call(state: EmitState, label: Int) -> EmitState {
    let position: Int = state.assembler.code_state.code_length + 1
    let updated: EmitState = append_code(state, [u8(232), u8(0), u8(0), u8(0), u8(0)])
    return state_with_jumps(updated, chunked_jump_push(updated.assembler.jumps, JumpPatch{ label: label, position: position, function: state.env.current_function }))
}

fn emit_windows_stack_adjust(state: EmitState, subtract: Bool, amount: Int) -> EmitState {
    if amount == 0 { return state }
    let mut operation: UInt8 = u8(196)
    if subtract { operation = u8(236) }
    if amount <= 127 {
        return append_code(state, [u8(72), u8(131), operation, u8(amount)])
    }
    return append_code(state, array_concat([u8(72), u8(129), operation], i32_bytes(amount)))
}

fn emit_call(state: EmitState, name: String) -> Result[EmitState, String] {
    let label: Option[Int] = map_get(state.env.function_labels, name)
    if is_none(label) { return err("dynamic backend: unknown function '" + name + "'") }
    let mut current: EmitState = state
    let mut adjustment: Int = 0
    if current.assembler.common.windows_abi {
        adjustment = 32
        let remainder: Int = current.assembler.common.windows_stack_depth % 16
        if remainder != 0 { adjustment = adjustment + (16 - remainder) }
        current = append_code(current, [u8(72), u8(131), u8(236), u8(adjustment)])
    }
    let called: EmitState = emit_relative_call(current, unwrap_or(label, -1))
    if current.assembler.common.windows_abi { return ok(append_code(called, [u8(72), u8(131), u8(196), u8(adjustment)])) }
    return ok(called)
}

fn emit_label_call(state: EmitState, label: Int) -> EmitState {
    let mut current: EmitState = state
    let mut adjustment: Int = 0
    if current.assembler.common.windows_abi {
        adjustment = 32
        let remainder: Int = current.assembler.common.windows_stack_depth % 16
        if remainder != 0 { adjustment = adjustment + (16 - remainder) }
        current = append_code(current, [u8(72), u8(131), u8(236), u8(adjustment)])
    }
    let called: EmitState = emit_relative_call(current, label)
    if current.assembler.common.windows_abi { return append_code(called, [u8(72), u8(131), u8(196), u8(adjustment)]) }
    return called
}

fn emit_pe_import_transfer(state: EmitState, import_index: Int, jump: Bool) -> EmitState {
    let start: Int = state.assembler.code_state.code_length
    let opcode: UInt8 = u8(255)
    let mut operation: UInt8 = u8(21)
    if jump { operation = u8(37) }
    let with_code: EmitState = append_code(state, [opcode, operation, u8(0), u8(0), u8(0), u8(0)])
    let patch: PEImportPatch = PEImportPatch{ displacement: start + 2, instruction_end: start + 6, import_index: import_index }
    return state_with_import_patches(with_code, array_push(with_code.assembler.common.import_patches, patch))
}

fn pe_get_process_heap_import_index() -> Int {
    return 3
}

fn pe_heap_alloc_import_index() -> Int {
    return 4
}

fn pe_dynamic_imports(needs_heap: Bool, needs_host_runtime: Bool, needs_ffi_runtime: Bool) -> Array[Array[String]] {
    let mut imports: Array[Array[String]] = [
        ["KERNEL32.dll", "GetStdHandle"],
        ["KERNEL32.dll", "WriteFile"],
        ["KERNEL32.dll", "ExitProcess"]
    ]
    if needs_heap {
        // Keep indexes 0-2 stable for console I/O and process exit.
        // The Win32 process heap allocator occupies indexes 3 and 4.
        imports = array_push(imports, ["KERNEL32.dll", "GetProcessHeap"])
        imports = array_push(imports, ["KERNEL32.dll", "HeapAlloc"])
    }
    if needs_host_runtime || needs_ffi_runtime {
        // Reserve indexes 5-8 whenever host services or FFI are used. FFI
        // emission may happen before a later builtin enables host runtime,
        // so the import table must not depend on source traversal order.
        imports = array_push(imports, ["KERNEL32.dll", "GetCommandLineW"])
        imports = array_push(imports, ["SHELL32.dll", "CommandLineToArgvW"])
        imports = array_push(imports, ["KERNEL32.dll", "LocalFree"])
        imports = array_push(imports, ["KERNEL32.dll", "WideCharToMultiByte"])
    }
    if needs_ffi_runtime {
        // FFI imports have fixed indexes 9-12, after console, heap, and the
        // reserved host block above.
        imports = array_push(imports, ["KERNEL32.dll", "LoadLibraryA"])
        imports = array_push(imports, ["KERNEL32.dll", "GetProcAddress"])
        imports = array_push(imports, ["KERNEL32.dll", "FreeLibrary"])
        imports = array_push(imports, ["KERNEL32.dll", "HeapFree"])
    }
    return imports
}

fn pe_ffi_import_index(offset: Int) -> Int {
    return 9 + offset
}

fn emit_pe_api_import_call(state: EmitState, import_index: Int) -> EmitState {
    let mut adjustment: Int = 32
    let remainder: Int = (state.assembler.common.windows_stack_depth + adjustment) % 16
    if remainder != 0 { adjustment = adjustment + (16 - remainder) }
    let reserved: EmitState = emit_windows_stack_adjust(state, true, adjustment)
    let called: EmitState = emit_pe_import_transfer(reserved, import_index, false)
    return emit_windows_stack_adjust(called, false, adjustment)
}

fn emit_ffi_import_call(state: EmitState, offset: Int) -> EmitState {
    return emit_pe_api_import_call(state, pe_ffi_import_index(offset))
}

fn pe_ffi_signature(signature_expression: KIRTypedNodeView, argument_count: Int) -> Result[String, String] {
    if text(field(signature_expression, "kind")) != "string" { return err("PE backend: ffi_call signature must be a literal string") }
    let raw: String = text(field(signature_expression, "string"))
    let raw_characters: Array[String] = string_chars(raw)
    let mut compact: String = ""
    let mut raw_index: Int = 0
    while raw_index < len(raw_characters) {
        let character: String = unwrap_or(array_get(raw_characters, raw_index), "")
        if character != " " { compact = compact + character }
        raw_index = raw_index + 1
    }
    let characters: Array[String] = string_chars(compact)
    let count: Int = len(characters)
    if count < 3 || (unwrap_or(array_get(characters, 0), "") != "i" && unwrap_or(array_get(characters, 0), "") != "u" && unwrap_or(array_get(characters, 0), "") != "p" && unwrap_or(array_get(characters, 0), "") != "v") || unwrap_or(array_get(characters, 1), "") != "(" || unwrap_or(array_get(characters, count - 1), "") != ")" {
        return err("PE backend: FFI signature must look like i(i,p), p(), or v(i)")
    }
    let result_type: String = unwrap_or(array_get(characters, 0), "")
    let mut normalized: String = result_type + "("
    let mut index: Int = 2
    let mut declared_count: Int = 0
    let mut needs_token: Bool = true
    while index < count - 1 {
        let token: String = unwrap_or(array_get(characters, index), "")
        if token == " " {
            index = index + 1
        } else if needs_token {
            if token != "i" && token != "u" && token != "p" { return err("PE backend: FFI arguments support only i, u, and p") }
            if declared_count > 0 { normalized = normalized + "," }
            normalized = normalized + token
            declared_count = declared_count + 1
            if declared_count > 8 { return err("PE backend: FFI calls support at most 8 arguments") }
            needs_token = false
            index = index + 1
        } else if token == "," {
            needs_token = true
            index = index + 1
        } else {
            return err("PE backend: FFI signature arguments must be comma-separated single-letter types")
        }
    }
    if needs_token && declared_count > 0 { return err("PE backend: FFI signature arguments must be comma-separated single-letter types") }
    if declared_count != argument_count { return err("PE backend: FFI signature declares " + str(declared_count) + " argument(s), got " + str(argument_count)) }
    if argument_count > 8 { return err("PE backend: FFI calls support at most 8 arguments") }
    return ok(normalized + ")")
}

fn pe_ffi_signature_arity(signature: String) -> Int {
    let characters: Array[String] = string_chars(signature)
    let count: Int = len(characters)
    let mut arity: Int = 0
    let mut index: Int = 2
    while index < count - 1 {
        if unwrap_or(array_get(characters, index), "") == "i" || unwrap_or(array_get(characters, index), "") == "u" || unwrap_or(array_get(characters, index), "") == "p" { arity = arity + 1 }
        index = index + 1
    }
    return arity
}

fn pe_is_ffi_handle_type(type_name: String) -> Bool {
    return type_name == "FFILibrary" || type_name == "FFISymbol" || type_name == "FFIBuffer"
}

fn pe_compact_type_spaces(type_name: String) -> String {
    if !contains(type_name, " ") { return type_name }
    let characters: Array[String] = string_chars(type_name)
    let mut compact: String = ""
    let mut index: Int = 0
    while index < len(characters) {
        let character: String = unwrap_or(array_get(characters, index), "")
        if character != " " { compact = compact + character }
        index = index + 1
    }
    return compact
}

fn pe_generic_type_argument(type_name: String, generic_name: String, argument_index: Int) -> String {
    let compact: String = pe_compact_type_spaces(type_name)
    let prefix: String = generic_name + "["
    if !starts_with(compact, prefix) || argument_index < 0 { return "" }
    let characters: Array[String] = string_chars(compact)
    let prefix_length: Int = len(string_chars(prefix))
    let mut depth: Int = 0
    let mut current_argument: Int = 0
    let mut start: Int = prefix_length
    let mut index: Int = prefix_length
    while index < len(characters) {
        let character: String = unwrap_or(array_get(characters, index), "")
        if character == "[" {
            depth = depth + 1
        } else if character == "]" {
            if depth == 0 {
                if current_argument == argument_index { return result_unwrap(substring(compact, start, index - start)) }
                return ""
            }
            depth = depth - 1
        } else if character == "," && depth == 0 {
            if current_argument == argument_index { return result_unwrap(substring(compact, start, index - start)) }
            current_argument = current_argument + 1
            start = index + 1
        }
        index = index + 1
    }
    return ""
}

fn emit_propagate(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    if !state.env.in_function { return err("dynamic backend: '?' is only supported inside a function") }
    let operand: KIRTypedNodeView = field(expression, "operand")
    let operand_type: String = pe_compact_type_spaces(expr_type(operand))
    let value_type: String = pe_compact_type_spaces(expr_type(expression))
    let return_type: String = pe_compact_type_spaces(unwrap_or(map_get(state.env.function_returns, state.env.current_function), ""))
    let is_option: Bool = starts_with(operand_type, "Option[")
    let is_result: Bool = starts_with(operand_type, "Result[")
    if is_option {
        if !starts_with(return_type, "Option[") || pe_generic_type_argument(operand_type, "Option", 0) != value_type {
            return err("dynamic backend: incompatible Option propagation types")
        }
    } else if is_result {
        if !starts_with(return_type, "Result[") || pe_generic_type_argument(operand_type, "Result", 0) != value_type || pe_generic_type_argument(operand_type, "Result", 1) != pe_generic_type_argument(return_type, "Result", 1) {
            return err("dynamic backend: incompatible Result propagation types")
        }
    } else {
        return err("dynamic backend: '?' requires Option[T] or Result[T,E]")
    }

    let emitted: Result[EmitState, String] = emit_expression(state, operand)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let failed_label: LabelState = new_label(result_unwrap(emitted))
    let join_label: LabelState = new_label(failed_label.state)
    let mut current: EmitState = append_code(join_label.state, [u8(72), u8(133), u8(192)])
    if is_option {
        current = emit_jump(current, failed_label.label, true, u8(132))
        current = append_code(current, [u8(72), u8(139), u8(64), u8(8)])
    } else {
        current = emit_jump(current, current.env.trap_label, true, u8(132))
        current = append_code(current, [u8(72), u8(131), u8(56), u8(0)])
        current = emit_jump(current, failed_label.label, true, u8(133))
        current = append_code(current, [u8(72), u8(139), u8(64), u8(8)])
    }
    current = emit_jump(current, join_label.label, false, u8(0))
    let returned_wrapper: Result[EmitState, String] = bind_label(current, failed_label.label)
    if is_err(returned_wrapper) { return err(unwrap_or(result_error(returned_wrapper), "dynamic backend: cannot bind propagation failure path")) }
    current = append_code(result_unwrap(returned_wrapper), [u8(201), u8(195)])
    let bound_join: Result[EmitState, String] = bind_label(current, join_label.label)
    if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind propagation success path")) }
    return ok(result_unwrap(bound_join))
}

fn pe_is_ffi_result_type(type_name: String) -> Bool {
    let compact: String = pe_compact_type_spaces(type_name)
    return compact == "Result[FFILibrary,String]" || compact == "Result[FFISymbol,String]" || compact == "Result[FFIBuffer,String]" || compact == "Result[Int,String]" || compact == "Result[Bytes,String]"
}

fn pe_is_result_type(type_name: String) -> Bool {
    return pe_generic_type_argument(type_name, "Result", 0) != "" && pe_generic_type_argument(type_name, "Result", 1) != ""
}

fn pe_is_supported_result_type(enums: KIRTypedNodeView, struct_fields: Map[String, KIRTypedNodeView], type_name: String) -> Bool {
    let value_type: String = pe_generic_type_argument(type_name, "Result", 0)
    let error_type: String = pe_generic_type_argument(type_name, "Result", 1)
    let supported_value: Bool = value_type == "Json" || pe_supported_type_with_structs(enums, struct_fields, value_type) || pe_is_supported_array_type(enums, value_type) || pe_is_supported_string_map_type(enums, value_type) || pe_is_ffi_handle_type(value_type)
    let supported_error: Bool = pe_supported_type_with_structs(enums, struct_fields, error_type) || pe_is_supported_array_type(enums, error_type) || pe_is_ffi_handle_type(error_type)
    return value_type != "" && error_type != "" && supported_value && supported_error
}

fn emit_move_arg(state: EmitState, index: Int) -> Result[EmitState, String] {
    if state.assembler.common.windows_abi {
        if index == 0 { return ok(append_code(state, [u8(72), u8(137), u8(193)])) }
        if index == 1 { return ok(append_code(state, [u8(72), u8(137), u8(194)])) }
        if index == 2 { return ok(append_code(state, [u8(73), u8(137), u8(192)])) }
        if index == 3 { return ok(append_code(state, [u8(73), u8(137), u8(193)])) }
        return err("dynamic backend: Win64 register argument index must be between zero and three")
    }
    if index == 0 { return ok(append_code(state, [u8(72), u8(137), u8(199)])) }
    if index == 1 { return ok(append_code(state, [u8(72), u8(137), u8(198)])) }
    if index == 2 { return ok(append_code(state, [u8(72), u8(137), u8(194)])) }
    if index == 3 { return ok(append_code(state, [u8(72), u8(137), u8(193)])) }
    if index == 4 { return ok(append_code(state, [u8(73), u8(137), u8(192)])) }
    if index == 5 { return ok(append_code(state, [u8(73), u8(137), u8(193)])) }
    return err("dynamic backend: at most six scalar arguments are supported")
}

fn emit_store_arg(state: EmitState, index: Int, slot: Int) -> Result[EmitState, String] {
    let mut moved: EmitState = state
    if state.assembler.common.windows_abi {
        if index == 0 { moved = append_code(moved, [u8(72), u8(137), u8(200)]) }
        else if index == 1 { moved = append_code(moved, [u8(72), u8(137), u8(208)]) }
        else if index == 2 { moved = append_code(moved, [u8(76), u8(137), u8(192)]) }
        else if index == 3 { moved = append_code(moved, [u8(76), u8(137), u8(200)]) }
        else if index >= 4 {
            let caller_stack_offset: Int = 48 + (index - 4) * 8
            moved = append_code(moved, array_concat([u8(72), u8(139), u8(133)], i32_bytes(caller_stack_offset)))
        } else { return err("dynamic backend: Win64 parameter index is invalid") }
        return ok(emit_store_slot(moved, slot))
    }
    if index == 0 { moved = append_code(moved, [u8(72), u8(137), u8(248)]) }
    else if index == 1 { moved = append_code(moved, [u8(72), u8(137), u8(240)]) }
    else if index == 2 { moved = append_code(moved, [u8(72), u8(137), u8(208)]) }
    else if index == 3 { moved = append_code(moved, [u8(72), u8(137), u8(200)]) }
    else if index == 4 { moved = append_code(moved, [u8(76), u8(137), u8(192)]) }
    else if index == 5 { moved = append_code(moved, [u8(76), u8(137), u8(200)]) }
    else { return err("dynamic backend: at most six scalar arguments are supported") }
    return ok(emit_store_slot(moved, slot))
}

fn parameter_slots(parameters: KIRTypedNodeView) -> Map[String, Int] {
    let count: Int = result_unwrap(kir_typed_array_len(parameters))
    let mut index: Int = 0
    let mut slots: Map[String, Int] = {}
    while index < count {
        let parameter: KIRTypedNodeView = result_unwrap(kir_typed_array_get(parameters, index))
        slots = map_insert(slots, text(field(parameter, "name")), (index + 1) * 8)
        index = index + 1
    }
    return slots
}

fn emit_function_frame(state: EmitState, frame: Int) -> EmitState {
    return append_code(state, array_concat([u8(85), u8(72), u8(137), u8(229), u8(72), u8(129), u8(236)], i32_bytes(frame)))
}

fn emit_prologue(state: EmitState) -> EmitState {
    let code: Array[UInt8] = [u8(85), u8(72), u8(137), u8(229), u8(72), u8(129), u8(236), u8(0), u8(0), u8(0), u8(0)]
    return state_with_frame_patch(state_with_code(state, code), 7)
}

fn emit_exit(state: EmitState, status: UInt8) -> EmitState {
    if state.assembler.common.windows_abi {
        // The trap target is also reachable from runtime helpers with literal
        // pushes that are not reflected in windows_stack_depth. Align using
        // the live RSP before making the non-returning Win32 call.
        let mut current: EmitState = append_code(state, [
            u8(73), u8(137), u8(227),
            u8(72), u8(131), u8(228), u8(240),
            u8(72), u8(131), u8(236), u8(48),
            u8(76), u8(137), u8(92), u8(36), u8(32),
            u8(185), status, u8(0), u8(0), u8(0)
        ])
        current = emit_pe_import_transfer(current, 2, false)
        return append_code(current, [u8(15), u8(11)])
    }
    return append_code(state, [u8(184), u8(60), u8(0), u8(0), u8(0), u8(191), status, u8(0), u8(0), u8(0), u8(15), u8(5)])
}

fn emit_int(state: EmitState, value: Int) -> EmitState {
    return append_code(state, array_concat([u8(72), u8(184)], dyn_u64_bytes(int_u64(value))))
}

fn emit_uint_mask(state: EmitState, bits: Int) -> EmitState {
    if bits == 0 || bits == 64 {
        return state
    }
    let mask: UInt64 = (u64(1) << bits) - u64(1)
    // AND EAX, imm32 also clears the high half of RAX. Keep this byte form
    // identical to the Go direct backend so self-hosted output stays exact.
    return append_code(state, array_concat([u8(37)], dyn_u32_bytes(u32(mask))))
}

fn emit_uint(state: EmitState, value: UInt64, bits: Int) -> EmitState {
    let loaded: EmitState = append_code(state, array_concat([u8(72), u8(184)], dyn_u64_bytes(value)))
    return emit_uint_mask(loaded, bits)
}

fn emit_load_slot(state: EmitState, slot: Int) -> EmitState {
    return append_code(state, array_concat([u8(72), u8(139), u8(133)], i32_bytes(0 - slot)))
}

fn emit_store_slot(state: EmitState, slot: Int) -> EmitState {
    return append_code(state, array_concat([u8(72), u8(137), u8(133)], i32_bytes(0 - slot)))
}

fn emit_windows_write(state: EmitState) -> Result[EmitState, String] {
    if !state.assembler.common.windows_abi { return err("dynamic backend: Windows WriteFile helper used for a non-Windows target") }
    let loop_label: LabelState = new_label(state)
    let done_label: LabelState = new_label(loop_label.state)
    let failed_label: LabelState = new_label(done_label.state)
    let large_label: LabelState = new_label(failed_label.state)
    let count_ready_label: LabelState = new_label(large_label.state)
    let after_label: LabelState = new_label(count_ready_label.state)
    let mut current: EmitState = append_code(after_label.state, [
        u8(72), u8(131), u8(236), u8(96),
        u8(72), u8(137), u8(84), u8(36), u8(56),
        u8(76), u8(137), u8(68), u8(36), u8(64),
        u8(72), u8(199), u8(68), u8(36), u8(32), u8(0), u8(0), u8(0), u8(0),
        u8(185), u8(245), u8(255), u8(255), u8(255)
    ])
    current = emit_pe_import_transfer(current, 0, false)
    current = append_code(current, [u8(72), u8(133), u8(192)])
    current = emit_jump(current, failed_label.label, true, u8(132))
    current = append_code(current, [u8(72), u8(131), u8(248), u8(255)])
    current = emit_jump(current, failed_label.label, true, u8(132))
    current = append_code(current, [u8(72), u8(137), u8(68), u8(36), u8(48)])
    let bound_loop: Result[EmitState, String] = bind_label(current, loop_label.label)
    if is_err(bound_loop) { return err(unwrap_or(result_error(bound_loop), "dynamic backend: cannot bind WriteFile loop")) }
    current = append_code(result_unwrap(bound_loop), [u8(72), u8(131), u8(124), u8(36), u8(64), u8(0)])
    current = emit_jump(current, done_label.label, true, u8(132))
    current = append_code(current, [
        u8(72), u8(139), u8(76), u8(36), u8(48),
        u8(72), u8(139), u8(84), u8(36), u8(56),
        u8(131), u8(124), u8(36), u8(68), u8(0)
    ])
    current = emit_jump(current, large_label.label, true, u8(133))
    current = append_code(current, [u8(68), u8(139), u8(68), u8(36), u8(64)])
    current = emit_jump(current, count_ready_label.label, false, u8(0))
    let bound_large: Result[EmitState, String] = bind_label(current, large_label.label)
    if is_err(bound_large) { return err(unwrap_or(result_error(bound_large), "dynamic backend: cannot bind WriteFile large-count path")) }
    current = append_code(result_unwrap(bound_large), [u8(65), u8(184), u8(255), u8(255), u8(255), u8(255)])
    let bound_count: Result[EmitState, String] = bind_label(current, count_ready_label.label)
    if is_err(bound_count) { return err(unwrap_or(result_error(bound_count), "dynamic backend: cannot bind WriteFile count")) }
    current = append_code(result_unwrap(bound_count), [
        u8(199), u8(68), u8(36), u8(40), u8(0), u8(0), u8(0), u8(0),
        u8(76), u8(141), u8(76), u8(36), u8(40)
    ])
    current = emit_pe_import_transfer(current, 1, false)
    current = append_code(current, [u8(133), u8(192)])
    current = emit_jump(current, failed_label.label, true, u8(132))
    current = append_code(current, [u8(139), u8(76), u8(36), u8(40), u8(133), u8(201)])
    current = emit_jump(current, failed_label.label, true, u8(132))
    current = append_code(current, [
        u8(72), u8(1), u8(76), u8(36), u8(56),
        u8(72), u8(41), u8(76), u8(36), u8(64)
    ])
    current = emit_jump(current, loop_label.label, false, u8(0))
    let bound_done: Result[EmitState, String] = bind_label(current, done_label.label)
    if is_err(bound_done) { return err(unwrap_or(result_error(bound_done), "dynamic backend: cannot bind WriteFile success")) }
    current = append_code(result_unwrap(bound_done), [u8(72), u8(131), u8(196), u8(96)])
    current = emit_jump(current, after_label.label, false, u8(0))
    let bound_failed: Result[EmitState, String] = bind_label(current, failed_label.label)
    if is_err(bound_failed) { return err(unwrap_or(result_error(bound_failed), "dynamic backend: cannot bind WriteFile failure")) }
    current = append_code(result_unwrap(bound_failed), [u8(72), u8(131), u8(196), u8(96)])
    current = emit_jump(current, current.env.trap_label, false, u8(0))
    let bound_after: Result[EmitState, String] = bind_label(current, after_label.label)
    if is_err(bound_after) { return err(unwrap_or(result_error(bound_after), "dynamic backend: cannot bind WriteFile continuation")) }
    return ok(result_unwrap(bound_after))
}

fn emit_write(state: EmitState, value: String) -> Result[EmitState, String] {
    let bytes: Array[UInt8] = u8_array(string_to_bytes(value))
    let known_offset: Option[Int] = map_get(state.assembler.common.data_by_text, value)
    let mut data_offset: Int = 0
    let mut with_data: EmitState = state
    if is_some(known_offset) {
        data_offset = unwrap_or(known_offset, 0)
    } else {
        data_offset = len(state.assembler.common.data)
        with_data = state_with_data_index(
            state,
            array_concat(state.assembler.common.data, bytes),
            map_insert(state.assembler.common.data_by_text, value, data_offset)
        )
    }
    let start: Int = with_data.assembler.code_state.code_length
    if with_data.assembler.common.windows_abi {
        if len(bytes) > 2147483647 { return err("dynamic backend: Windows literal output is too large") }
        let with_code: EmitState = append_code(with_data, array_concat([u8(72), u8(141), u8(21), u8(0), u8(0), u8(0), u8(0), u8(65), u8(184)], i32_bytes(len(bytes))))
        let patch: DataPatch = DataPatch{ displacement: start + 3, instruction_end: start + 7, data_offset: data_offset }
        let patched: EmitState = state_with_data_patches(with_code, array_push(with_code.assembler.common.data_patches, patch))
        return emit_windows_write(patched)
    }
    let code: Array[UInt8] = array_concat(
        [
            u8(184), u8(1), u8(0), u8(0), u8(0),
            u8(191), u8(1), u8(0), u8(0), u8(0),
            u8(72), u8(141), u8(53), u8(0), u8(0), u8(0), u8(0),
            u8(186)
        ],
        array_concat(i32_bytes(len(bytes)), [u8(15), u8(5)])
    )
    let with_code: EmitState = append_code(with_data, code)
    let patch: DataPatch = DataPatch{ displacement: start + 13, instruction_end: start + 17, data_offset: data_offset }
    return ok(state_with_data_patches(with_code, array_push(with_code.assembler.common.data_patches, patch)))
}

fn emit_string(state: EmitState, value: String) -> EmitState {
    let known_offset: Option[Int] = map_get(state.assembler.common.string_data_by_text, value)
    let mut data_offset: Int = 0
    let mut with_data: EmitState = state
    if is_some(known_offset) {
        data_offset = unwrap_or(known_offset, 0)
    } else {
        let bytes: Array[UInt8] = u8_array(string_to_bytes(value))
        let object: Array[UInt8] = array_concat(dyn_u64_bytes(u64(len(bytes))), bytes)
        data_offset = len(state.assembler.common.data)
        with_data = state_with_string_data_index(
            state,
            array_concat(state.assembler.common.data, object),
            map_insert(state.assembler.common.string_data_by_text, value, data_offset)
        )
    }
    let start: Int = with_data.assembler.code_state.code_length
    let with_code: EmitState = append_code(with_data, [u8(72), u8(141), u8(5), u8(0), u8(0), u8(0), u8(0)])
    let patch: DataPatch = DataPatch{ displacement: start + 3, instruction_end: start + 7, data_offset: data_offset }
    return state_with_data_patches(with_code, array_push(with_code.assembler.common.data_patches, patch))
}

fn emit_string_write(state: EmitState) -> Result[EmitState, String] {
    if state.assembler.common.windows_abi {
        let pointer_and_length: EmitState = append_code(state, [u8(76), u8(139), u8(0), u8(72), u8(141), u8(80), u8(8)])
        return emit_windows_write(pointer_and_length)
    }
    return ok(append_code(state, [u8(72), u8(139), u8(16), u8(72), u8(141), u8(112), u8(8), u8(184), u8(1), u8(0), u8(0), u8(0), u8(191), u8(1), u8(0), u8(0), u8(0), u8(15), u8(5)]))
}

fn enum_output_name(enum_name: String) -> String {
    let prefix: String = "@kry_enum_module_"
    if !starts_with(enum_name, prefix) { return enum_name }
    let characters: Array[String] = string_chars(enum_name)
    let mut separator: Int = len(string_chars(prefix))
    while separator < len(characters) {
        if unwrap_or(array_get(characters, separator), "") == "_" { break }
        separator = separator + 1
    }
    if separator >= len(characters) - 1 { return enum_name }
    let display_name: Result[String, String] = substring(enum_name, separator + 1, len(characters) - separator - 1)
    if is_err(display_name) { return enum_name }
    return result_unwrap(display_name)
}

fn emit_enum_output(state: EmitState, expression: KIRTypedNodeView, newline: Bool) -> Result[EmitState, String] {
    let emitted: Result[EmitState, String] = emit_expression(state, expression)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let mut current: EmitState = result_unwrap(emitted)
    let enum_name: String = expr_type(expression)
    let display_name: String = enum_output_name(enum_name)
    let variants_option: Option[KIRTypedNodeView] = map_get(current.env.struct_fields, enum_name)
    if is_none(variants_option) { return err("dynamic backend: enum output has no variants for '" + enum_name + "'") }
    let variants: KIRTypedNodeView = unwrap_or(variants_option, kir_typed_empty_array())
    let variant_count: Int = result_unwrap(kir_typed_array_len(variants))
    if variant_count == 0 { return err("dynamic backend: enum output has no variants for '" + enum_name + "'") }
    let end_label: LabelState = new_label(current)
    current = end_label.state
    let mut index: Int = 0
    while index < variant_count {
        let variant_name: String = text(result_unwrap(kir_typed_array_get(variants, index)))
        let next_label: LabelState = new_label(current)
        current = append_code(next_label.state, array_concat([u8(72), u8(61)], i32_bytes(index)))
        current = emit_jump(current, next_label.label, true, u8(133))
        let written: Result[EmitState, String] = emit_write(current, display_name + "::" + variant_name)
        if is_err(written) { return err(unwrap_or(result_error(written), "dynamic backend: enum output failed")) }
        current = result_unwrap(written)
        if newline {
            let line: Result[EmitState, String] = emit_write(current, "\n")
            if is_err(line) { return err(unwrap_or(result_error(line), "dynamic backend: enum newline output failed")) }
            current = result_unwrap(line)
        }
        current = emit_jump(current, end_label.label, false, u8(0))
        let bound_next: Result[EmitState, String] = bind_label(current, next_label.label)
        if is_err(bound_next) { return err(unwrap_or(result_error(bound_next), "dynamic backend: cannot bind enum output branch")) }
        current = result_unwrap(bound_next)
        index = index + 1
    }
    current = emit_jump(current, current.env.trap_label, false, u8(0))
    let bound_end: Result[EmitState, String] = bind_label(current, end_label.label)
    if is_err(bound_end) { return err(unwrap_or(result_error(bound_end), "dynamic backend: cannot bind enum output join")) }
    return ok(result_unwrap(bound_end))
}

fn emit_boolean_output(state: EmitState, expression: KIRTypedNodeView, newline: Bool) -> Result[EmitState, String] {
    let emitted: Result[EmitState, String] = emit_expression(state, expression)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let mut current: EmitState = append_code(result_unwrap(emitted), [u8(72), u8(133), u8(192)])
    let false_label: LabelState = new_label(current)
    let join_label: LabelState = new_label(false_label.state)
    current = emit_jump(join_label.state, false_label.label, true, u8(132))
    let written_true: Result[EmitState, String] = emit_write(current, "true")
    if is_err(written_true) { return err(unwrap_or(result_error(written_true), "dynamic backend: true output failed")) }
    current = result_unwrap(written_true)
    current = emit_jump(current, join_label.label, false, u8(0))
    let bound_false: Result[EmitState, String] = bind_label(current, false_label.label)
    if is_err(bound_false) { return err(unwrap_or(result_error(bound_false), "dynamic backend: cannot bind boolean false path")) }
    let written_false: Result[EmitState, String] = emit_write(result_unwrap(bound_false), "false")
    if is_err(written_false) { return err(unwrap_or(result_error(written_false), "dynamic backend: false output failed")) }
    current = result_unwrap(written_false)
    let bound_join: Result[EmitState, String] = bind_label(current, join_label.label)
    if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind boolean output join")) }
    current = result_unwrap(bound_join)
    if newline {
        let line: Result[EmitState, String] = emit_write(current, "\n")
        if is_err(line) { return err(unwrap_or(result_error(line), "dynamic backend: boolean newline output failed")) }
        current = result_unwrap(line)
    }
    return ok(current)
}

fn emit_string_concat_call(state: EmitState) -> EmitState {
    let moved: EmitState = append_code(state, [u8(72), u8(137), u8(199), u8(72), u8(137), u8(206)])
    return emit_label_call(state_with_string_concat_used(moved), moved.assembler.common.string_concat_label)
}

fn emit_heap_alloc(state: EmitState) -> EmitState {
    if state.assembler.common.windows_abi {
        // Runtime helpers have different literal push prologues, so align from
        // the live RSP at each Win32 call instead of assuming a fixed depth.
        // Keep the saved RSP after the 32-byte shadow space and restore it
        // without relying on volatile registers across the API call.
        let mut current: EmitState = append_code(state, [
            u8(73), u8(137), u8(227),
            u8(72), u8(131), u8(228), u8(240),
            u8(72), u8(131), u8(236), u8(48),
            u8(76), u8(137), u8(92), u8(36), u8(32)
        ])
        current = emit_pe_import_transfer(current, pe_get_process_heap_import_index(), false)
        current = append_code(current, [
            u8(72), u8(139), u8(100), u8(36), u8(32),
            u8(72), u8(133), u8(192)
        ])
        current = emit_jump(current, current.env.trap_label, true, u8(132))
        current = append_code(current, [
            u8(72), u8(137), u8(193),
            u8(72), u8(49), u8(210),
            u8(73), u8(137), u8(248),
            u8(73), u8(137), u8(227),
            u8(72), u8(131), u8(228), u8(240),
            u8(72), u8(131), u8(236), u8(48),
            u8(76), u8(137), u8(92), u8(36), u8(32)
        ])
        current = emit_pe_import_transfer(current, pe_heap_alloc_import_index(), false)
        current = append_code(current, [
            u8(72), u8(139), u8(100), u8(36), u8(32),
            u8(72), u8(133), u8(192)
        ])
        current = emit_jump(current, current.env.trap_label, true, u8(132))
        return current
    }
    // rdi=requested bytes; return a 16-byte-aligned block from the process
    // break. A shared heap avoids one page mapping per small runtime object.
    let mut current: EmitState = append_code(state, [
        u8(72), u8(137), u8(254), u8(184), u8(12), u8(0), u8(0), u8(0), u8(72), u8(49), u8(255), u8(15), u8(5),
        u8(72), u8(137), u8(194), u8(72), u8(131), u8(198), u8(15)
    ])
    current = emit_jump(current, current.env.trap_label, true, u8(130))
    current = append_code(current, [
        u8(72), u8(129), u8(230), u8(240), u8(255), u8(255), u8(255), u8(72), u8(1), u8(214)
    ])
    current = emit_jump(current, current.env.trap_label, true, u8(130))
    current = append_code(current, [
        u8(72), u8(137), u8(247), u8(184), u8(12), u8(0), u8(0), u8(0), u8(15), u8(5), u8(72), u8(57), u8(248)
    ])
    current = emit_jump(current, current.env.trap_label, true, u8(133))
    return append_code(current, [u8(72), u8(137), u8(208)])
}

fn emit_string_concat_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, state.assembler.common.string_concat_label)
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind String runtime")) }
    let mut current: EmitState = append_code(result_unwrap(bound), [
        u8(83), u8(85), u8(65), u8(84), u8(65), u8(85), u8(65), u8(86), u8(65), u8(87),
        u8(73), u8(137), u8(252), u8(73), u8(137), u8(245),
        u8(73), u8(139), u8(4), u8(36), u8(73), u8(137), u8(198),
        u8(73), u8(139), u8(69), u8(0), u8(73), u8(137), u8(199),
        u8(76), u8(137), u8(245), u8(77), u8(1), u8(254)
    ])
    current = emit_jump(current, current.env.trap_label, true, u8(128))
    current = append_code(current, [u8(76), u8(137), u8(247), u8(72), u8(131), u8(199), u8(8)])
    current = emit_heap_alloc(current)
    current = append_code(current, [
        u8(72), u8(137), u8(195), u8(76), u8(137), u8(51),
        u8(77), u8(141), u8(100), u8(36), u8(8), u8(76), u8(137), u8(230), u8(72), u8(141), u8(123), u8(8),
        u8(72), u8(137), u8(233), u8(243), u8(164),
        u8(77), u8(141), u8(109), u8(8), u8(76), u8(137), u8(238), u8(72), u8(141), u8(123), u8(8), u8(72), u8(1), u8(239),
        u8(76), u8(137), u8(249), u8(243), u8(164),
        u8(72), u8(137), u8(216), u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92), u8(93), u8(91), u8(195)
    ])
    return ok(current)
}

fn emit_array_alloc_call(state: EmitState) -> EmitState {
    let moved: EmitState = append_code(state, [u8(72), u8(137), u8(199)])
    return emit_label_call(state_with_array_used(moved), moved.assembler.common.array_alloc_label)
}

fn emit_array_literal(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let items: KIRTypedNodeView = field(expression, "items")
    let count: Int = result_unwrap(kir_typed_array_len(items))
    let allocated: EmitState = emit_int(state, count)
    let called: EmitState = emit_array_alloc_call(allocated)
    let mut current: EmitState = append_code(called, [u8(80)])
    let mut index: Int = 0
    while index < count {
        let item: KIRTypedNodeView = result_unwrap(kir_typed_array_get(items, index))
        let emitted: Result[EmitState, String] = emit_expression(current, item)
        if is_err(emitted) { return err(expression_error(emitted)) }
        current = append_code(result_unwrap(emitted), [u8(73), u8(137), u8(192), u8(72), u8(139), u8(12), u8(36)])
        current = append_code(current, array_concat([u8(72), u8(186)], dyn_u64_bytes(u64(8 + index * 8))))
        current = append_code(current, [u8(72), u8(1), u8(202), u8(76), u8(137), u8(2)])
        index = index + 1
    }
    return ok(append_code(current, [u8(88)]))
}

fn emit_struct_literal(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let fields: KIRTypedNodeView = field(expression, "fields")
    let values: KIRTypedNodeView = field(expression, "values")
    let count: Int = result_unwrap(kir_typed_array_len(values))
    if result_unwrap(kir_typed_array_len(fields)) != count { return err("dynamic backend: struct literal field count mismatch") }
    let type_name: String = expr_type(expression)
    if !map_contains_key(state.env.struct_fields, type_name) { return err("dynamic backend: unknown struct '" + type_name + "'") }
    let allocated: EmitState = emit_int(state, count)
    let called: EmitState = emit_array_alloc_call(allocated)
    let mut current: EmitState = append_code(called, [u8(80)])
    let mut index: Int = 0
    while index < count {
        let field_name: String = text(result_unwrap(kir_typed_array_get(fields, index)))
        let field_index: Int = struct_field_index(current.env, type_name, field_name)
        if field_index < 0 { return err("dynamic backend: unknown field '" + field_name + "' in struct '" + type_name + "'") }
        let value: KIRTypedNodeView = result_unwrap(kir_typed_array_get(values, index))
        let emitted: Result[EmitState, String] = emit_expression(current, value)
        if is_err(emitted) { return err(expression_error(emitted)) }
        current = append_code(result_unwrap(emitted), [u8(73), u8(137), u8(192), u8(72), u8(139), u8(12), u8(36)])
        current = append_code(current, array_concat([u8(72), u8(186)], dyn_u64_bytes(u64((field_index + 1) * 8))))
        current = append_code(current, [u8(72), u8(1), u8(202), u8(76), u8(137), u8(2)])
        index = index + 1
    }
    return ok(append_code(current, [u8(88)]))
}

fn emit_struct_field(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let base: KIRTypedNodeView = field(expression, "base")
    let type_name: String = expr_type(base)
    let field_name: String = text(field(expression, "field"))
    let field_index: Int = struct_field_index(state.env, type_name, field_name)
    if field_index < 0 { return err("dynamic backend: unknown field '" + field_name + "' in struct '" + type_name + "'") }
    let emitted: Result[EmitState, String] = emit_expression(state, base)
    if is_err(emitted) { return err(expression_error(emitted)) }
    return ok(append_code(result_unwrap(emitted), array_concat([u8(72), u8(139), u8(128)], i32_bytes((field_index + 1) * 8))))
}

fn emit_array_indices(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    if result_unwrap(kir_typed_array_len(arguments)) != 1 || !starts_with(expr_type(result_unwrap(kir_typed_array_get(arguments, 0))), "Array[") { return err("dynamic backend: array_indices expects one Array argument") }
    let emitted: Result[EmitState, String] = emit_expression(state, result_unwrap(kir_typed_array_get(arguments, 0)))
    if is_err(emitted) { return err(expression_error(emitted)) }
    let mut current: EmitState = emit_push_rax(result_unwrap(emitted))
    current = append_code(current, [u8(72), u8(139), u8(4), u8(36), u8(72), u8(139), u8(0)])
    current = emit_array_alloc_call(current)
    current = append_code(current, [u8(80), u8(72), u8(49), u8(201)])
    let loop_label: LabelState = new_label(current)
    let done_label: LabelState = new_label(loop_label.state)
    let bound_loop: Result[EmitState, String] = bind_label(done_label.state, loop_label.label)
    if is_err(bound_loop) { return err(unwrap_or(result_error(bound_loop), "dynamic backend: cannot bind array_indices loop")) }
    current = append_code(result_unwrap(bound_loop), [u8(72), u8(139), u8(84), u8(36), u8(8), u8(72), u8(59), u8(10)])
    current = emit_jump(current, done_label.label, true, u8(131))
    current = append_code(current, [u8(72), u8(139), u8(20), u8(36), u8(73), u8(137), u8(200), u8(73), u8(193), u8(224), u8(3), u8(73), u8(131), u8(192), u8(8), u8(76), u8(1), u8(194), u8(72), u8(137), u8(10), u8(72), u8(255), u8(193)])
    current = emit_jump(current, loop_label.label, false, u8(0))
    let bound_done: Result[EmitState, String] = bind_label(current, done_label.label)
    if is_err(bound_done) { return err(unwrap_or(result_error(bound_done), "dynamic backend: cannot bind array_indices completion")) }
    let completed: EmitState = append_code(result_unwrap(bound_done), [u8(88), u8(72), u8(131), u8(196), u8(8)])
    if completed.assembler.common.windows_abi { return ok(state_with_windows_stack_depth(completed, completed.assembler.common.windows_stack_depth - 8)) }
    return ok(completed)
}

fn emit_array_index(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let base: KIRTypedNodeView = field(expression, "base")
    if !starts_with(expr_type(base), "Array[") { return err("dynamic backend: indexing requires Array[T]") }
    let emitted_base: Result[EmitState, String] = emit_expression(state, base)
    if is_err(emitted_base) { return err(expression_error(emitted_base)) }
    let pushed: EmitState = append_code(result_unwrap(emitted_base), [u8(80)])
    let emitted_index: Result[EmitState, String] = emit_expression(pushed, field(expression, "left"))
    if is_err(emitted_index) { return err(expression_error(emitted_index)) }
    let combined: EmitState = append_code(result_unwrap(emitted_index), [u8(72), u8(137), u8(193), u8(88), u8(72), u8(133), u8(201)])
    let checked_sign: EmitState = emit_jump(combined, state.env.trap_label, true, u8(136))
    let checked_bounds: EmitState = append_code(checked_sign, [u8(72), u8(59), u8(8)])
    let guarded: EmitState = emit_jump(checked_bounds, state.env.trap_label, true, u8(131))
    return ok(append_code(guarded, [u8(72), u8(139), u8(68), u8(200), u8(8)]))
}

fn emit_array_push_call(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    if result_unwrap(kir_typed_array_len(arguments)) != 2 { return err("dynamic backend: array_push expects two arguments") }
    let first: Result[EmitState, String] = emit_expression(state, result_unwrap(kir_typed_array_get(arguments, 0)))
    if is_err(first) { return err(expression_error(first)) }
    let pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
    let second: Result[EmitState, String] = emit_expression(pushed, result_unwrap(kir_typed_array_get(arguments, 1)))
    if is_err(second) { return err(expression_error(second)) }
    let combined: EmitState = append_code(result_unwrap(second), [u8(72), u8(137), u8(198), u8(88), u8(72), u8(137), u8(199)])
    return ok(emit_label_call(state_with_array_used(combined), combined.assembler.common.array_push_label))
}

fn emit_array_concat_call(state: EmitState) -> EmitState {
    let moved: EmitState = append_code(state, [u8(72), u8(137), u8(199), u8(72), u8(137), u8(206)])
    return emit_label_call(state_with_array_used(moved), moved.assembler.common.array_concat_label)
}

fn emit_array_alloc_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, state.assembler.common.array_alloc_label)
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind Array allocator")) }
    let mut current: EmitState = append_code(result_unwrap(bound), [
        u8(83), u8(85), u8(72), u8(137), u8(253), u8(72), u8(137), u8(248), u8(72), u8(255), u8(192)
    ])
    current = emit_jump(current, current.env.trap_label, true, u8(128))
    current = append_code(current, [u8(72), u8(193), u8(224), u8(3)])
    current = emit_jump(current, current.env.trap_label, true, u8(128))
    current = append_code(current, [u8(72), u8(137), u8(199)])
    current = emit_heap_alloc(current)
    return ok(append_code(current, [u8(72), u8(137), u8(40), u8(93), u8(91), u8(195)]))
}

fn emit_array_push_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, state.assembler.common.array_push_label)
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind Array push runtime")) }
    let mut current: EmitState = append_code(result_unwrap(bound), [
        u8(83), u8(85), u8(65), u8(84), u8(65), u8(85), u8(65), u8(86), u8(65), u8(87),
        u8(73), u8(137), u8(252), u8(73), u8(137), u8(245), u8(73), u8(139), u8(4), u8(36), u8(73), u8(137), u8(198),
        u8(77), u8(137), u8(247), u8(73), u8(131), u8(199), u8(1)
    ])
    if current.assembler.common.windows_abi { current = append_code(current, [u8(86), u8(87)]) }
    current = emit_jump(current, current.env.trap_label, true, u8(128))
    current = append_code(current, [u8(76), u8(137), u8(255)])
    if current.assembler.common.windows_abi {
        // The helper has eight saved registers, so reserve shadow space plus
        // eight bytes to align RSP at the Win64 call boundary.
        current = emit_windows_stack_adjust(current, true, 40)
        current = emit_relative_call(current, current.assembler.common.array_alloc_label)
        current = emit_windows_stack_adjust(current, false, 40)
    } else {
        current = emit_label_call(current, current.assembler.common.array_alloc_label)
    }
    current = append_code(current, [
        u8(72), u8(137), u8(195), u8(73), u8(141), u8(116), u8(36), u8(8), u8(72), u8(141), u8(123), u8(8),
        u8(76), u8(137), u8(241), u8(243), u8(72), u8(165), u8(76), u8(137), u8(242), u8(72), u8(193), u8(226), u8(3),
        u8(72), u8(1), u8(218), u8(72), u8(131), u8(194), u8(8), u8(76), u8(137), u8(42), u8(72), u8(137), u8(216)
    ])
    if current.assembler.common.windows_abi { current = append_code(current, [u8(95), u8(94)]) }
    return ok(append_code(current, [u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92), u8(93), u8(91), u8(195)]))
}

fn emit_array_concat_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, state.assembler.common.array_concat_label)
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind Array concat runtime")) }
    let mut current: EmitState = append_code(result_unwrap(bound), [
        u8(83), u8(85), u8(65), u8(84), u8(65), u8(85), u8(65), u8(86), u8(65), u8(87),
        u8(73), u8(137), u8(252), u8(73), u8(137), u8(245), u8(73), u8(139), u8(4), u8(36), u8(73), u8(137), u8(198),
        u8(73), u8(139), u8(69), u8(0), u8(73), u8(137), u8(199), u8(76), u8(137), u8(245), u8(76), u8(1), u8(253)
    ])
    if current.assembler.common.windows_abi { current = append_code(current, [u8(86), u8(87)]) }
    current = emit_jump(current, current.env.trap_label, true, u8(128))
    current = append_code(current, [u8(72), u8(137), u8(239)])
    if current.assembler.common.windows_abi {
        // Six saved registers plus RDI/RSI leave RSP eight bytes off alignment.
        current = emit_windows_stack_adjust(current, true, 40)
        current = emit_relative_call(current, current.assembler.common.array_alloc_label)
        current = emit_windows_stack_adjust(current, false, 40)
    } else {
        current = emit_label_call(current, current.assembler.common.array_alloc_label)
    }
    current = append_code(current, [
        u8(72), u8(137), u8(195), u8(73), u8(141), u8(116), u8(36), u8(8), u8(72), u8(141), u8(123), u8(8),
        u8(76), u8(137), u8(241), u8(243), u8(72), u8(165), u8(73), u8(141), u8(117), u8(8), u8(76), u8(137), u8(249), u8(243), u8(72), u8(165)
    ])
    current = append_code(current, [u8(72), u8(137), u8(216)])
    if current.assembler.common.windows_abi { current = append_code(current, [u8(95), u8(94)]) }
    return ok(append_code(current, [u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92), u8(93), u8(91), u8(195)]))
}

fn map_key_kind(type_name: String) -> UInt64 {
    if starts_with(type_name, "Map[String,") { return u64(1) }
    return u64(0)
}

fn emit_map_literal(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let keys: KIRTypedNodeView = field(expression, "map_keys")
    let values: KIRTypedNodeView = field(expression, "values")
    let count: Int = result_unwrap(kir_typed_array_len(keys))
    if result_unwrap(kir_typed_array_len(values)) != count { return err("dynamic backend: map literal key/value count mismatch") }
    let mut current: EmitState = emit_array_alloc_call(emit_int(state, count * 2))
    current = append_code(current, [u8(80)])
    let mut index: Int = 0
    while index < count {
        let key: Result[EmitState, String] = emit_expression(current, result_unwrap(kir_typed_array_get(keys, index)))
        if is_err(key) { return err(expression_error(key)) }
        current = append_code(result_unwrap(key), [u8(80)])
        let value: Result[EmitState, String] = emit_expression(current, result_unwrap(kir_typed_array_get(values, index)))
        if is_err(value) { return err(expression_error(value)) }
        current = append_code(result_unwrap(value), [
            u8(73), u8(137), u8(192), u8(88), u8(72), u8(139), u8(12), u8(36), u8(72), u8(186)
        ])
        current = append_code(current, dyn_u64_bytes(u64(8 + index * 16)))
        current = append_code(current, [u8(72), u8(1), u8(202), u8(72), u8(137), u8(2), u8(72), u8(131), u8(194), u8(8), u8(76), u8(137), u8(2)])
        index = index + 1
    }
    return ok(append_code(current, [u8(88)]))
}

fn emit_map_get_call(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    if result_unwrap(kir_typed_array_len(arguments)) != 2 { return err("dynamic backend: map_get expects two arguments") }
    let map_value: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
    let key: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 1))
    let first: Result[EmitState, String] = emit_expression(state, map_value)
    if is_err(first) { return err(expression_error(first)) }
    let pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
    let second: Result[EmitState, String] = emit_expression(pushed, key)
    if is_err(second) { return err(expression_error(second)) }
    let moved: EmitState = append_code(result_unwrap(second), [u8(72), u8(137), u8(198), u8(95), u8(72), u8(186)])
    let marked: EmitState = state_with_array_used(state_with_box_used(state_with_host_used(moved)))
    let with_kind: EmitState = append_code(marked, dyn_u64_bytes(map_key_kind(expr_type(map_value))))
    let found: EmitState = emit_label_call(with_kind, host_map_find_label(with_kind))
    let none_label: LabelState = new_label(found)
    let done_label: LabelState = new_label(none_label.state)
    let mut current: EmitState = append_code(done_label.state, [u8(72), u8(133), u8(192)])
    current = emit_jump(current, none_label.label, true, u8(132))
    current = append_code(current, [u8(72), u8(139), u8(0)])
    current = emit_box_call(current, u64(1))
    current = emit_jump(current, done_label.label, false, u8(0))
    let bound_none: Result[EmitState, String] = bind_label(current, none_label.label)
    if is_err(bound_none) { return err(unwrap_or(result_error(bound_none), "dynamic backend: cannot bind map_get none path")) }
    current = emit_int(result_unwrap(bound_none), 0)
    let bound_done: Result[EmitState, String] = bind_label(current, done_label.label)
    if is_err(bound_done) { return err(unwrap_or(result_error(bound_done), "dynamic backend: cannot bind map_get completion")) }
    return ok(result_unwrap(bound_done))
}

fn emit_map_contains_call(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    if result_unwrap(kir_typed_array_len(arguments)) != 2 { return err("dynamic backend: map_contains_key expects two arguments") }
    let map_value: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
    let key: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 1))
    let first: Result[EmitState, String] = emit_expression(state, map_value)
    if is_err(first) { return err(expression_error(first)) }
    let pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
    let second: Result[EmitState, String] = emit_expression(pushed, key)
    if is_err(second) { return err(expression_error(second)) }
    let moved: EmitState = append_code(result_unwrap(second), [u8(72), u8(137), u8(198), u8(95), u8(72), u8(186)])
    let marked: EmitState = state_with_array_used(state_with_host_used(moved))
    let with_kind: EmitState = append_code(marked, dyn_u64_bytes(map_key_kind(expr_type(map_value))))
    let found: EmitState = emit_label_call(with_kind, host_map_find_label(with_kind))
    return ok(append_code(found, [u8(72), u8(133), u8(192), u8(15), u8(149), u8(192), u8(72), u8(15), u8(182), u8(192)]))
}

fn emit_map_insert_call(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    if result_unwrap(kir_typed_array_len(arguments)) != 3 { return err("dynamic backend: map_insert expects three arguments") }
    let map_value: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
    let key: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 1))
    let value: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 2))
    let first: Result[EmitState, String] = emit_expression(state, map_value)
    if is_err(first) { return err(expression_error(first)) }
    let first_pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
    let second: Result[EmitState, String] = emit_expression(first_pushed, key)
    if is_err(second) { return err(expression_error(second)) }
    let second_pushed: EmitState = append_code(result_unwrap(second), [u8(80)])
    let third: Result[EmitState, String] = emit_expression(second_pushed, value)
    if is_err(third) { return err(expression_error(third)) }
    let moved: EmitState = append_code(result_unwrap(third), [u8(72), u8(137), u8(193), u8(94), u8(95), u8(72), u8(186)])
    let marked: EmitState = state_with_array_used(state_with_host_used(moved))
    let with_kind: EmitState = append_code(marked, dyn_u64_bytes(map_key_kind(expr_type(map_value))))
    return ok(emit_label_call(with_kind, host_map_insert_label(with_kind)))
}

fn emit_map_remove_call(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    if result_unwrap(kir_typed_array_len(arguments)) != 2 { return err("dynamic backend: map_remove expects two arguments") }
    let map_value: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
    let key: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 1))
    if !starts_with(expr_type(map_value), "Map[") { return err("dynamic backend: map_remove expects Map[K,V] and K") }
    let first: Result[EmitState, String] = emit_expression(state, map_value)
    if is_err(first) { return err(expression_error(first)) }
    let pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
    let second: Result[EmitState, String] = emit_expression(pushed, key)
    if is_err(second) { return err(expression_error(second)) }
    let moved: EmitState = append_code(result_unwrap(second), [u8(72), u8(137), u8(198), u8(95), u8(72), u8(186)])
    let marked: EmitState = state_with_array_used(state_with_host_used(moved))
    let with_kind: EmitState = append_code(marked, dyn_u64_bytes(map_key_kind(expr_type(map_value))))
    return ok(emit_label_call(with_kind, host_map_remove_label(with_kind)))
}

fn emit_array_set_call(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    if result_unwrap(kir_typed_array_len(arguments)) != 3 { return err("dynamic backend: array_set expects three arguments") }
    let array_value: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
    let index: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 1))
    let replacement: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 2))
    if !starts_with(expr_type(array_value), "Array[") || expr_type(index) != "Int" || expr_type(array_value) != "Array[" + expr_type(replacement) + "]" {
        return err("dynamic backend: array_set expects Array[T], Int, and T")
    }
    let first: Result[EmitState, String] = emit_expression(state, array_value)
    if is_err(first) { return err(expression_error(first)) }
    let first_pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
    let second: Result[EmitState, String] = emit_expression(first_pushed, index)
    if is_err(second) { return err(expression_error(second)) }
    let second_pushed: EmitState = append_code(result_unwrap(second), [u8(80)])
    let third: Result[EmitState, String] = emit_expression(second_pushed, replacement)
    if is_err(third) { return err(expression_error(third)) }
    let moved: EmitState = append_code(result_unwrap(third), [u8(72), u8(137), u8(194), u8(94), u8(95)])
    let marked: EmitState = state_with_box_used(state_with_array_used(state_with_host_used(moved)))
    return ok(emit_label_call(marked, host_array_set_label(marked)))
}

fn emit_array_slice_call(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    if result_unwrap(kir_typed_array_len(arguments)) != 3 { return err("dynamic backend: array_slice expects three arguments") }
    let array_value: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
    let start: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 1))
    let length: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 2))
    if !starts_with(expr_type(array_value), "Array[") || expr_type(start) != "Int" || expr_type(length) != "Int" {
        return err("dynamic backend: array_slice expects Array[T], Int, and Int")
    }
    let first: Result[EmitState, String] = emit_expression(state, array_value)
    if is_err(first) { return err(expression_error(first)) }
    let first_pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
    let second: Result[EmitState, String] = emit_expression(first_pushed, start)
    if is_err(second) { return err(expression_error(second)) }
    let second_pushed: EmitState = append_code(result_unwrap(second), [u8(80)])
    let third: Result[EmitState, String] = emit_expression(second_pushed, length)
    if is_err(third) { return err(expression_error(third)) }
    let moved: EmitState = append_code(result_unwrap(third), [u8(72), u8(137), u8(194), u8(94), u8(95)])
    let marked: EmitState = state_with_array_used(state_with_host_used(moved))
    return ok(emit_label_call(marked, host_array_slice_label(marked)))
}

fn emit_box_call(state: EmitState, tag: UInt64) -> EmitState {
    let moved: EmitState = append_code(state, array_concat([u8(72), u8(137), u8(199), u8(72), u8(190)], dyn_u64_bytes(tag)))
    let used: EmitState = state_with_box_used(moved)
    return emit_label_call(used, used.assembler.common.box_alloc_label)
}

fn emit_ffi_stack_drop(state: EmitState, amount: Int) -> EmitState {
    let dropped: EmitState = emit_windows_stack_adjust(state, false, amount)
    return state_with_windows_stack_depth(dropped, state.assembler.common.windows_stack_depth - amount)
}

fn emit_ffi_cstring(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    if expr_type(expression) != "String" { return err("dynamic backend: FFI library and symbol names must be String") }
    let emitted: Result[EmitState, String] = emit_expression(state, expression)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let source_saved: EmitState = emit_push_rax(result_unwrap(emitted))
    let mut current: EmitState = append_code(source_saved, [u8(72), u8(139), u8(4), u8(36), u8(72), u8(139), u8(56), u8(72), u8(255), u8(199)])
    current = emit_heap_alloc(current)
    let destination_saved: EmitState = emit_push_rax(current)
    current = append_code(destination_saved, [
        u8(72), u8(139), u8(68), u8(36), u8(8),
        u8(72), u8(139), u8(8), u8(72), u8(141), u8(112), u8(8),
        u8(72), u8(139), u8(60), u8(36), u8(243), u8(164), u8(198), u8(7), u8(0)
    ])
    let popped_destination: Result[EmitState, String] = emit_pop_rax(current)
    if is_err(popped_destination) { return err(unwrap_or(result_error(popped_destination), "dynamic backend: FFI string destination stack underflow")) }
    return ok(emit_ffi_stack_drop(result_unwrap(popped_destination), 8))
}

fn emit_ffi_free_cstring_keep_result(state: EmitState) -> EmitState {
    let mut current: EmitState = emit_pe_api_import_call(state, pe_get_process_heap_import_index())
    current = append_code(current, [u8(72), u8(137), u8(193), u8(49), u8(210), u8(76), u8(139), u8(68), u8(36), u8(8)])
    current = emit_ffi_import_call(current, 3)
    current = append_code(current, [u8(72), u8(133), u8(192)])
    current = emit_jump(current, current.env.trap_label, true, u8(132))
    current = append_code(current, [u8(72), u8(139), u8(4), u8(36)])
    return emit_ffi_stack_drop(current, 16)
}

fn emit_ffi_error(state: EmitState, message: String) -> EmitState {
    return emit_box_call(emit_string(state, message), u64(1))
}

fn emit_ffi_library_open(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let marked: EmitState = state_with_ffi_used(state)
    let arguments: KIRTypedNodeView = field(expression, "args")
    let path: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
    let cstring: Result[EmitState, String] = emit_ffi_cstring(marked, path)
    if is_err(cstring) { return err(unwrap_or(result_error(cstring), "dynamic backend: FFI path lowering failed")) }
    let saved_path: EmitState = emit_push_rax(result_unwrap(cstring))
    let mut current: EmitState = append_code(saved_path, [u8(72), u8(139), u8(12), u8(36)])
    current = emit_ffi_import_call(current, 0)
    let saved_module: EmitState = emit_push_rax(current)
    current = emit_ffi_free_cstring_keep_result(saved_module)
    let failed_label: LabelState = new_label(current)
    let join_label: LabelState = new_label(failed_label.state)
    current = append_code(join_label.state, [u8(72), u8(133), u8(192)])
    current = emit_jump(current, failed_label.label, true, u8(132))
    let saved_handle: EmitState = emit_push_rax(current)
    current = append_code(saved_handle, [u8(72), u8(199), u8(199), u8(16), u8(0), u8(0), u8(0)])
    current = emit_heap_alloc(current)
    current = append_code(current, [u8(72), u8(139), u8(20), u8(36), u8(72), u8(137), u8(16), u8(72), u8(199), u8(64), u8(8), u8(0), u8(0), u8(0), u8(0)])
    current = emit_ffi_stack_drop(current, 8)
    current = emit_box_call(current, u64(0))
    current = emit_jump(current, join_label.label, false, u8(0))
    let bound_failed: Result[EmitState, String] = bind_label(current, failed_label.label)
    if is_err(bound_failed) { return err(unwrap_or(result_error(bound_failed), "dynamic backend: cannot bind ffi_library_open error path")) }
    let failed: EmitState = emit_ffi_error(result_unwrap(bound_failed), "LoadLibraryA failed")
    let bound_join: Result[EmitState, String] = bind_label(failed, join_label.label)
    if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind ffi_library_open result")) }
    return ok(result_unwrap(bound_join))
}

fn emit_ffi_symbol(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let marked: EmitState = state_with_ffi_used(state)
    let arguments: KIRTypedNodeView = field(expression, "args")
    let library: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
    let symbol_name: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 1))
    let emitted_library: Result[EmitState, String] = emit_expression(marked, library)
    if is_err(emitted_library) { return err(expression_error(emitted_library)) }
    let saved_library: EmitState = emit_push_rax(result_unwrap(emitted_library))
    let cstring: Result[EmitState, String] = emit_ffi_cstring(saved_library, symbol_name)
    if is_err(cstring) { return err(unwrap_or(result_error(cstring), "dynamic backend: FFI symbol name lowering failed")) }
    let saved_name: EmitState = emit_push_rax(result_unwrap(cstring))
    let invalid_label: LabelState = new_label(saved_name)
    let missing_label: LabelState = new_label(invalid_label.state)
    let join_label: LabelState = new_label(missing_label.state)
    let mut current: EmitState = append_code(join_label.state, [u8(72), u8(139), u8(68), u8(36), u8(8), u8(72), u8(133), u8(192)])
    current = emit_jump(current, invalid_label.label, true, u8(132))
    current = append_code(current, [u8(72), u8(131), u8(120), u8(8), u8(0)])
    current = emit_jump(current, invalid_label.label, true, u8(133))
    current = append_code(current, [u8(72), u8(139), u8(8), u8(72), u8(139), u8(84), u8(36), u8(0)])
    current = emit_ffi_import_call(current, 1)
    let saved_address: EmitState = emit_push_rax(current)
    current = emit_ffi_free_cstring_keep_result(saved_address)
    current = append_code(current, [u8(72), u8(133), u8(192)])
    current = emit_jump(current, missing_label.label, true, u8(132))
    let saved_proc: EmitState = emit_push_rax(current)
    current = append_code(saved_proc, [u8(72), u8(199), u8(199), u8(16), u8(0), u8(0), u8(0)])
    current = emit_heap_alloc(current)
    current = append_code(current, [
        u8(72), u8(139), u8(20), u8(36), u8(72), u8(137), u8(16),
        u8(72), u8(139), u8(76), u8(36), u8(8), u8(72), u8(137), u8(72), u8(8)
    ])
    current = emit_ffi_stack_drop(current, 16)
    current = emit_box_call(current, u64(0))
    current = emit_jump(current, join_label.label, false, u8(0))
    let invalid_state: EmitState = state_with_windows_stack_depth(current, saved_name.assembler.common.windows_stack_depth)
    let bound_invalid: Result[EmitState, String] = bind_label(invalid_state, invalid_label.label)
    if is_err(bound_invalid) { return err(unwrap_or(result_error(bound_invalid), "dynamic backend: cannot bind ffi_symbol invalid path")) }
    let zero_result: EmitState = emit_push_rax(emit_int(result_unwrap(bound_invalid), 0))
    current = emit_ffi_free_cstring_keep_result(zero_result)
    current = emit_ffi_stack_drop(current, 8)
    current = emit_ffi_error(current, "invalid or closed FFILibrary handle")
    let missing_state: EmitState = state_with_windows_stack_depth(current, saved_library.assembler.common.windows_stack_depth)
    let bound_missing: Result[EmitState, String] = bind_label(missing_state, missing_label.label)
    if is_err(bound_missing) { return err(unwrap_or(result_error(bound_missing), "dynamic backend: cannot bind ffi_symbol missing path")) }
    current = emit_ffi_stack_drop(result_unwrap(bound_missing), 8)
    current = emit_ffi_error(current, "GetProcAddress failed")
    let bound_join: Result[EmitState, String] = bind_label(current, join_label.label)
    if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind ffi_symbol result")) }
    return ok(result_unwrap(bound_join))
}

fn emit_ffi_call_target(state: EmitState, expression: KIRTypedNodeView, signature: String) -> Result[EmitState, String] {
    let marked: EmitState = state_with_ffi_used(state)
    let arguments: KIRTypedNodeView = field(expression, "args")
    let symbol: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
    let values: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 2))
    let arity: Int = pe_ffi_signature_arity(signature)
    let emitted_symbol: Result[EmitState, String] = emit_expression(marked, symbol)
    if is_err(emitted_symbol) { return err(expression_error(emitted_symbol)) }
    let saved_symbol: EmitState = emit_push_rax(result_unwrap(emitted_symbol))
    let emitted_values: Result[EmitState, String] = emit_expression(saved_symbol, values)
    if is_err(emitted_values) { return err(expression_error(emitted_values)) }
    let saved_values: EmitState = emit_push_rax(result_unwrap(emitted_values))
    let invalid_label: LabelState = new_label(saved_values)
    let join_label: LabelState = new_label(invalid_label.state)
    let mut current: EmitState = append_code(join_label.state, [
        u8(72), u8(139), u8(4), u8(36), u8(72), u8(133), u8(192)
    ])
    current = emit_jump(current, invalid_label.label, true, u8(132))
    current = append_code(current, [u8(72), u8(129), u8(56)])
    current = append_code(current, i32_bytes(arity))
    current = emit_jump(current, invalid_label.label, true, u8(133))
    current = append_code(current, [u8(72), u8(139), u8(68), u8(36), u8(8), u8(72), u8(133), u8(192)])
    current = emit_jump(current, invalid_label.label, true, u8(132))
    current = append_code(current, [u8(72), u8(139), u8(72), u8(8), u8(72), u8(131), u8(121), u8(8), u8(0)])
    current = emit_jump(current, invalid_label.label, true, u8(133))
    let mut stack_argument_count: Int = arity - 4
    if stack_argument_count < 0 { stack_argument_count = 0 }
    let outgoing: Int = 32 + stack_argument_count * 8
    let mut adjustment: Int = outgoing
    let remainder: Int = (current.assembler.common.windows_stack_depth + outgoing) % 16
    if remainder != 0 { adjustment = adjustment + (16 - remainder) }
    current = emit_windows_stack_adjust(current, true, adjustment)
    current = append_code(current, array_concat([u8(76), u8(139), u8(148), u8(36)], i32_bytes(adjustment)))
    current = append_code(current, array_concat([u8(72), u8(139), u8(132), u8(36)], i32_bytes(adjustment + 8)))
    current = append_code(current, [u8(76), u8(139), u8(24)])
    let mut index: Int = 0
    while index < arity && index < 4 {
        if index == 0 { current = append_code(current, [u8(73), u8(139), u8(74), u8(8)]) }
        else if index == 1 { current = append_code(current, [u8(73), u8(139), u8(82), u8(16)]) }
        else if index == 2 { current = append_code(current, [u8(77), u8(139), u8(66), u8(24)]) }
        else { current = append_code(current, [u8(77), u8(139), u8(74), u8(32)]) }
        index = index + 1
    }
    while index < arity {
        let value_offset: Int = 8 + index * 8
        let stack_offset: Int = 32 + (index - 4) * 8
        current = append_code(current, array_concat([u8(73), u8(139), u8(130)], i32_bytes(value_offset)))
        current = append_code(current, array_concat([u8(72), u8(137), u8(132), u8(36)], i32_bytes(stack_offset)))
        index = index + 1
    }
    current = append_code(current, [u8(65), u8(255), u8(211)])
    if result_unwrap(substring(signature, 0, 1)) == "v" { current = append_code(current, [u8(49), u8(192)]) }
    current = emit_windows_stack_adjust(current, false, adjustment)
    current = emit_ffi_stack_drop(current, 16)
    current = emit_box_call(current, u64(0))
    current = emit_jump(current, join_label.label, false, u8(0))
    let invalid_state: EmitState = state_with_windows_stack_depth(current, saved_values.assembler.common.windows_stack_depth)
    let bound_invalid: Result[EmitState, String] = bind_label(invalid_state, invalid_label.label)
    if is_err(bound_invalid) { return err(unwrap_or(result_error(bound_invalid), "dynamic backend: cannot bind ffi_call error path")) }
    current = emit_ffi_stack_drop(result_unwrap(bound_invalid), 16)
    current = emit_ffi_error(current, "invalid FFISymbol or FFI argument count")
    let bound_join: Result[EmitState, String] = bind_label(current, join_label.label)
    if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind ffi_call result")) }
    return ok(result_unwrap(bound_join))
}

fn emit_ffi_library_close(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    let library: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
    let emitted: Result[EmitState, String] = emit_expression(state_with_ffi_used(state), library)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let mut current: EmitState = append_code(emit_push_rax(result_unwrap(emitted)), [u8(72), u8(133), u8(192)])
    current = emit_jump(current, current.env.trap_label, true, u8(132))
    current = append_code(current, [u8(72), u8(131), u8(120), u8(8), u8(0)])
    current = emit_jump(current, current.env.trap_label, true, u8(133))
    current = append_code(current, [u8(72), u8(139), u8(8)])
    current = emit_ffi_import_call(current, 2)
    current = append_code(current, [u8(72), u8(133), u8(192)])
    current = emit_jump(current, current.env.trap_label, true, u8(132))
    current = append_code(current, [u8(72), u8(139), u8(4), u8(36), u8(72), u8(199), u8(64), u8(8), u8(1), u8(0), u8(0), u8(0)])
    current = emit_ffi_stack_drop(current, 8)
    return ok(emit_int(current, 0))
}

fn emit_ffi_buffer_new(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    let bytes: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
    let emitted: Result[EmitState, String] = emit_expression(state_with_ffi_used(state), bytes)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let saved_input: EmitState = emit_push_rax(result_unwrap(emitted))
    let mut current: EmitState = append_code(saved_input, [u8(72), u8(139), u8(4), u8(36), u8(72), u8(139), u8(56), u8(72), u8(255), u8(199)])
    current = emit_heap_alloc(current)
    let saved_data: EmitState = emit_push_rax(current)
    current = append_code(saved_data, [
        u8(72), u8(139), u8(68), u8(36), u8(8), u8(72), u8(139), u8(8), u8(72), u8(141), u8(112), u8(8),
        u8(72), u8(139), u8(60), u8(36), u8(243), u8(164), u8(198), u8(7), u8(0),
        u8(72), u8(199), u8(199), u8(32), u8(0), u8(0), u8(0)
    ])
    current = emit_heap_alloc(current)
    current = append_code(current, [
        u8(72), u8(139), u8(20), u8(36), u8(72), u8(137), u8(16),
        u8(72), u8(139), u8(76), u8(36), u8(8), u8(72), u8(139), u8(9),
        u8(72), u8(137), u8(72), u8(8), u8(72), u8(137), u8(72), u8(16),
        u8(72), u8(199), u8(64), u8(24), u8(0), u8(0), u8(0), u8(0)
    ])
    return ok(emit_ffi_stack_drop(current, 16))
}

fn emit_ffi_buffer_new_sized(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    let capacity: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
    let emitted: Result[EmitState, String] = emit_expression(state_with_ffi_used(state), capacity)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let saved_capacity: EmitState = emit_push_rax(result_unwrap(emitted))
    let invalid_label: LabelState = new_label(saved_capacity)
    let join_label: LabelState = new_label(invalid_label.state)
    let mut current: EmitState = append_code(join_label.state, [u8(72), u8(139), u8(4), u8(36), u8(72), u8(131), u8(248), u8(1)])
    current = emit_jump(current, invalid_label.label, true, u8(140))
    current = append_code(current, [u8(72), u8(61), u8(0), u8(0), u8(0), u8(1)])
    current = emit_jump(current, invalid_label.label, true, u8(143))
    current = append_code(current, [u8(72), u8(139), u8(60), u8(36), u8(72), u8(255), u8(199)])
    current = emit_heap_alloc(current)
    let saved_data: EmitState = emit_push_rax(current)
    current = append_code(saved_data, [
        u8(72), u8(139), u8(76), u8(36), u8(8), u8(72), u8(255), u8(193), u8(72), u8(139), u8(60), u8(36),
        u8(49), u8(192), u8(243), u8(170), u8(72), u8(199), u8(199), u8(32), u8(0), u8(0), u8(0)
    ])
    current = emit_heap_alloc(current)
    current = append_code(current, [
        u8(72), u8(139), u8(20), u8(36), u8(72), u8(137), u8(16),
        u8(72), u8(139), u8(76), u8(36), u8(8), u8(72), u8(137), u8(72), u8(8), u8(72), u8(137), u8(72), u8(16),
        u8(72), u8(199), u8(64), u8(24), u8(0), u8(0), u8(0), u8(0)
    ])
    current = emit_ffi_stack_drop(current, 16)
    current = emit_box_call(current, u64(0))
    current = emit_jump(current, join_label.label, false, u8(0))
    let invalid_state: EmitState = state_with_windows_stack_depth(current, saved_capacity.assembler.common.windows_stack_depth)
    let bound_invalid: Result[EmitState, String] = bind_label(invalid_state, invalid_label.label)
    if is_err(bound_invalid) { return err(unwrap_or(result_error(bound_invalid), "dynamic backend: cannot bind ffi_buffer_new_sized range error")) }
    let cleaned: EmitState = emit_ffi_stack_drop(result_unwrap(bound_invalid), 8)
    let failed: EmitState = emit_ffi_error(cleaned, "FFI buffer capacity must be in 1..16777216 bytes")
    let bound_join: Result[EmitState, String] = bind_label(failed, join_label.label)
    if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind ffi_buffer_new_sized result")) }
    return ok(result_unwrap(bound_join))
}

fn emit_ffi_buffer_address(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    let buffer: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
    let emitted: Result[EmitState, String] = emit_expression(state_with_ffi_used(state), buffer)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let saved_buffer: EmitState = emit_push_rax(result_unwrap(emitted))
    let invalid_label: LabelState = new_label(saved_buffer)
    let join_label: LabelState = new_label(invalid_label.state)
    let mut current: EmitState = append_code(join_label.state, [u8(72), u8(139), u8(4), u8(36), u8(72), u8(133), u8(192)])
    current = emit_jump(current, invalid_label.label, true, u8(132))
    current = append_code(current, [u8(72), u8(131), u8(120), u8(24), u8(0)])
    current = emit_jump(current, invalid_label.label, true, u8(133))
    current = append_code(current, [u8(72), u8(139), u8(0), u8(72), u8(133), u8(192)])
    current = emit_jump(current, invalid_label.label, true, u8(132))
    current = emit_ffi_stack_drop(current, 8)
    current = emit_box_call(current, u64(0))
    current = emit_jump(current, join_label.label, false, u8(0))
    let invalid_state: EmitState = state_with_windows_stack_depth(current, saved_buffer.assembler.common.windows_stack_depth)
    let bound_invalid: Result[EmitState, String] = bind_label(invalid_state, invalid_label.label)
    if is_err(bound_invalid) { return err(unwrap_or(result_error(bound_invalid), "dynamic backend: cannot bind ffi_buffer_address invalid path")) }
    let cleaned: EmitState = emit_ffi_stack_drop(result_unwrap(bound_invalid), 8)
    let failed: EmitState = emit_ffi_error(cleaned, "invalid or closed FFIBuffer handle")
    let bound_join: Result[EmitState, String] = bind_label(failed, join_label.label)
    if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind ffi_buffer_address result")) }
    return ok(result_unwrap(bound_join))
}

fn emit_ffi_buffer_read(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    let buffer: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
    let emitted: Result[EmitState, String] = emit_expression(state_with_ffi_used(state), buffer)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let saved_buffer: EmitState = emit_push_rax(result_unwrap(emitted))
    let invalid_label: LabelState = new_label(saved_buffer)
    let join_label: LabelState = new_label(invalid_label.state)
    let mut current: EmitState = append_code(join_label.state, [u8(72), u8(139), u8(4), u8(36), u8(72), u8(133), u8(192)])
