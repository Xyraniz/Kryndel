    let bound_end_two: Result[EmitState, String] = bind_label(current, end_two.label)
    if is_err(bound_end_two) { return err(unwrap_or(result_error(bound_end_two), "dynamic backend: cannot bind substring end 3-byte path")) }
    current = append_code(result_unwrap(bound_end_two), [u8(72), u8(199), u8(193), u8(2), u8(0), u8(0), u8(0)])
    current = emit_jump(current, end_advance.label, false, u8(0))
    let bound_end_one: Result[EmitState, String] = bind_label(current, end_one.label)
    if is_err(bound_end_one) { return err(unwrap_or(result_error(bound_end_one), "dynamic backend: cannot bind substring end 2-byte path")) }
    current = append_code(result_unwrap(bound_end_one), [u8(72), u8(199), u8(193), u8(1), u8(0), u8(0), u8(0)])
    let bound_end_advance: Result[EmitState, String] = bind_label(current, end_advance.label)
    if is_err(bound_end_advance) { return err(unwrap_or(result_error(bound_end_advance), "dynamic backend: cannot bind substring end advance")) }
    current = append_code(result_unwrap(bound_end_advance), [u8(72), u8(137), u8(216), u8(72), u8(1), u8(200)])
    current = emit_jump(current, end_error.label, true, u8(128))
    current = append_code(current, [u8(76), u8(57), u8(248)])
    current = emit_jump(current, end_error.label, true, u8(135))
    current = append_code(current, [u8(72), u8(137), u8(195), u8(73), u8(255), u8(206)])
    current = emit_jump(current, end_loop.label, false, u8(0))
    let bound_end_found: Result[EmitState, String] = bind_label(current, end_found.label)
    if is_err(bound_end_found) { return err(unwrap_or(result_error(bound_end_found), "dynamic backend: cannot bind substring end found")) }
    current = append_code(result_unwrap(bound_end_found), [
        u8(73), u8(137), u8(217), u8(76), u8(137), u8(231), u8(72), u8(131), u8(199), u8(8),
        u8(76), u8(1), u8(199), u8(76), u8(137), u8(206), u8(76), u8(41), u8(198)
    ])
    current = emit_label_call(current, host_string_alloc_label(current))
    current = emit_box_call(current, u64(0))
    current = emit_jump(current, done.label, false, u8(0))
    let bound_negative: Result[EmitState, String] = bind_label(current, negative_error.label)
    if is_err(bound_negative) { return err(unwrap_or(result_error(bound_negative), "dynamic backend: cannot bind substring negative error")) }
    current = emit_string(result_unwrap(bound_negative), "substring range is out of bounds")
    current = emit_box_call(current, u64(1))
    current = emit_jump(current, done.label, false, u8(0))
    let bound_start_error: Result[EmitState, String] = bind_label(current, start_error.label)
    if is_err(bound_start_error) { return err(unwrap_or(result_error(bound_start_error), "dynamic backend: cannot bind substring start error")) }
    current = emit_string(result_unwrap(bound_start_error), "substring range is out of bounds")
    current = emit_box_call(current, u64(1))
    current = emit_jump(current, done.label, false, u8(0))
    let bound_end_error: Result[EmitState, String] = bind_label(current, end_error.label)
    if is_err(bound_end_error) { return err(unwrap_or(result_error(bound_end_error), "dynamic backend: cannot bind substring end error")) }
    current = emit_string(result_unwrap(bound_end_error), "substring range is out of bounds")
    current = emit_box_call(current, u64(1))
    let bound_done: Result[EmitState, String] = bind_label(current, done.label)
    if is_err(bound_done) { return err(unwrap_or(result_error(bound_done), "dynamic backend: cannot bind substring completion")) }
    return ok(append_code(result_unwrap(bound_done), [u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92), u8(93), u8(91), u8(195)]))
}

fn emit_int_to_string_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, host_int_to_string_label(state))
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind host Int-to-String runtime")) }
    let bool_false: LabelState = new_label(result_unwrap(bound))
    let numeric: LabelState = new_label(bool_false.state)
    let signed: LabelState = new_label(numeric.state)
    let digits: LabelState = new_label(signed.state)
    let digit_loop: LabelState = new_label(digits.state)
    let add_sign: LabelState = new_label(digit_loop.state)
    let ready: LabelState = new_label(add_sign.state)
    let restore: LabelState = new_label(ready.state)
    let mut current: EmitState = append_code(restore.state, [
        u8(83), u8(85), u8(65), u8(84), u8(65), u8(85), u8(65), u8(86), u8(65), u8(87),
        u8(73), u8(137), u8(252), u8(73), u8(137), u8(245),
        u8(73), u8(131), u8(253), u8(2)
    ])
    current = emit_jump(current, numeric.label, true, u8(133))
    current = append_code(current, [u8(77), u8(133), u8(228)])
    current = emit_jump(current, bool_false.label, true, u8(132))
    current = emit_string(current, "true")
    current = emit_jump(current, restore.label, false, u8(0))
    let bound_false: Result[EmitState, String] = bind_label(current, bool_false.label)
    if is_err(bound_false) { return err(unwrap_or(result_error(bound_false), "dynamic backend: cannot bind Int-to-String false path")) }
    current = emit_string(result_unwrap(bound_false), "false")
    current = emit_jump(current, restore.label, false, u8(0))
    let bound_numeric: Result[EmitState, String] = bind_label(current, numeric.label)
    if is_err(bound_numeric) { return err(unwrap_or(result_error(bound_numeric), "dynamic backend: cannot bind Int-to-String numeric path")) }
    current = append_code(result_unwrap(bound_numeric), [
        u8(72), u8(131), u8(236), u8(32),
        u8(76), u8(141), u8(116), u8(36), u8(32),
        u8(69), u8(49), u8(255), u8(77), u8(133), u8(237)
    ])
    current = emit_jump(current, signed.label, true, u8(132))
    current = emit_jump(current, digits.label, false, u8(0))
    let bound_signed: Result[EmitState, String] = bind_label(current, signed.label)
    if is_err(bound_signed) { return err(unwrap_or(result_error(bound_signed), "dynamic backend: cannot bind Int-to-String signed path")) }
    current = append_code(result_unwrap(bound_signed), [u8(77), u8(133), u8(228)])
    current = emit_jump(current, digits.label, true, u8(137))
    current = append_code(current, [u8(65), u8(183), u8(1), u8(73), u8(247), u8(220)])
    let bound_digits: Result[EmitState, String] = bind_label(current, digits.label)
    if is_err(bound_digits) { return err(unwrap_or(result_error(bound_digits), "dynamic backend: cannot bind Int-to-String digits")) }
    current = result_unwrap(bound_digits)
    let bound_loop: Result[EmitState, String] = bind_label(current, digit_loop.label)
    if is_err(bound_loop) { return err(unwrap_or(result_error(bound_loop), "dynamic backend: cannot bind Int-to-String digit loop")) }
    current = append_code(result_unwrap(bound_loop), [
        u8(72), u8(49), u8(210), u8(76), u8(137), u8(224),
        u8(72), u8(199), u8(193), u8(10), u8(0), u8(0), u8(0),
        u8(72), u8(247), u8(241), u8(128), u8(194), u8(48),
        u8(73), u8(255), u8(206), u8(65), u8(136), u8(22),
        u8(73), u8(137), u8(196), u8(77), u8(133), u8(228)
    ])
    current = emit_jump(current, digit_loop.label, true, u8(133))
    current = emit_jump(current, add_sign.label, false, u8(0))
    let bound_sign: Result[EmitState, String] = bind_label(current, add_sign.label)
    if is_err(bound_sign) { return err(unwrap_or(result_error(bound_sign), "dynamic backend: cannot bind Int-to-String sign")) }
    current = append_code(result_unwrap(bound_sign), [u8(69), u8(132), u8(255)])
    current = emit_jump(current, ready.label, true, u8(132))
    current = append_code(current, [u8(73), u8(255), u8(206), u8(65), u8(198), u8(6), u8(45)])
    let bound_ready: Result[EmitState, String] = bind_label(current, ready.label)
    if is_err(bound_ready) { return err(unwrap_or(result_error(bound_ready), "dynamic backend: cannot bind Int-to-String ready path")) }
    current = append_code(result_unwrap(bound_ready), [
        u8(72), u8(141), u8(116), u8(36), u8(32), u8(76), u8(41), u8(246), u8(76), u8(137), u8(247)
    ])
    current = emit_label_call(current, host_string_alloc_label(current))
    current = append_code(current, [u8(72), u8(131), u8(196), u8(32)])
    let bound_restore: Result[EmitState, String] = bind_label(current, restore.label)
    if is_err(bound_restore) { return err(unwrap_or(result_error(bound_restore), "dynamic backend: cannot bind Int-to-String restore")) }
    return ok(append_code(result_unwrap(bound_restore), [u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92), u8(93), u8(91), u8(195)]))
}

