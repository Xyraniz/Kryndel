fn map_key_kind(type_name: String) -> UInt64 {
    if starts_with(type_name, "Map[String,") { return u64(1) }
    return u64(0)
}

fn emit_map_literal(state: EmitState, expression: Json) -> Result[EmitState, String] {
    let keys: Json = field(expression, "map_keys")
    let values: Json = field(expression, "values")
    let count: Int = result_unwrap(json_array_len(keys))
    if result_unwrap(json_array_len(values)) != count { return err("dynamic backend: map literal key/value count mismatch") }
    let mut current: EmitState = emit_array_alloc_call(emit_int(state, count * 2))
    current = append_code(current, [u8(80)])
    let mut index: Int = 0
    while index < count {
        let key: Result[EmitState, String] = emit_expression(current, result_unwrap(json_array_get(keys, index)))
        if is_err(key) { return err(expression_error(key)) }
        current = append_code(result_unwrap(key), [u8(80)])
        let value: Result[EmitState, String] = emit_expression(current, result_unwrap(json_array_get(values, index)))
        if is_err(value) { return err(expression_error(value)) }
        current = append_code(result_unwrap(value), [
            u8(73), u8(137), u8(192), u8(88), u8(72), u8(139), u8(12), u8(36), u8(72), u8(186)
        ])
        current = append_code(current, dyn_u64_bytes(u64(8 + index * 16)))
        current = append_code(current, [u8(72), u8(1), u8(202), u8(72), u8(137), u8(2), u8(72), u8(131), u8(194), u8(8), u8(76), u8(137), u8(2)])
        index = index + 1
    }
    return ok(append_code(current, [u8(88)]))
}

fn emit_map_get_call(state: EmitState, expression: Json) -> Result[EmitState, String] {
    let arguments: Json = field(expression, "args")
    if result_unwrap(json_array_len(arguments)) != 2 { return err("dynamic backend: map_get expects two arguments") }
    let map_value: Json = result_unwrap(json_array_get(arguments, 0))
    let key: Json = result_unwrap(json_array_get(arguments, 1))
    let first: Result[EmitState, String] = emit_expression(state, map_value)
    if is_err(first) { return err(expression_error(first)) }
    let pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
    let second: Result[EmitState, String] = emit_expression(pushed, key)
    if is_err(second) { return err(expression_error(second)) }
    let moved: EmitState = append_code(result_unwrap(second), [u8(72), u8(137), u8(198), u8(95), u8(72), u8(186)])
    let marked: EmitState = state_with_array_used(state_with_box_used(state_with_host_used(moved)))
    let with_kind: EmitState = append_code(marked, dyn_u64_bytes(map_key_kind(expr_type(map_value))))
    let found: EmitState = emit_label_call(with_kind, host_map_find_label(with_kind))
    let none_label: LabelState = new_label(found)
    let done_label: LabelState = new_label(none_label.state)
    let mut current: EmitState = append_code(done_label.state, [u8(72), u8(133), u8(192)])
    current = emit_jump(current, none_label.label, true, u8(132))
    current = append_code(current, [u8(72), u8(139), u8(0)])
    current = emit_box_call(current, u64(1))
    current = emit_jump(current, done_label.label, false, u8(0))
    let bound_none: Result[EmitState, String] = bind_label(current, none_label.label)
    if is_err(bound_none) { return err(unwrap_or(result_error(bound_none), "dynamic backend: cannot bind map_get none path")) }
    current = emit_int(result_unwrap(bound_none), 0)
    let bound_done: Result[EmitState, String] = bind_label(current, done_label.label)
    if is_err(bound_done) { return err(unwrap_or(result_error(bound_done), "dynamic backend: cannot bind map_get completion")) }
    return ok(result_unwrap(bound_done))
}

fn emit_map_contains_call(state: EmitState, expression: Json) -> Result[EmitState, String] {
    let arguments: Json = field(expression, "args")
    if result_unwrap(json_array_len(arguments)) != 2 { return err("dynamic backend: map_contains_key expects two arguments") }
    let map_value: Json = result_unwrap(json_array_get(arguments, 0))
    let key: Json = result_unwrap(json_array_get(arguments, 1))
    let first: Result[EmitState, String] = emit_expression(state, map_value)
    if is_err(first) { return err(expression_error(first)) }
    let pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
    let second: Result[EmitState, String] = emit_expression(pushed, key)
    if is_err(second) { return err(expression_error(second)) }
    let moved: EmitState = append_code(result_unwrap(second), [u8(72), u8(137), u8(198), u8(95), u8(72), u8(186)])
    let marked: EmitState = state_with_array_used(state_with_host_used(moved))
    let with_kind: EmitState = append_code(marked, dyn_u64_bytes(map_key_kind(expr_type(map_value))))
    let found: EmitState = emit_label_call(with_kind, host_map_find_label(with_kind))
    return ok(append_code(found, [u8(72), u8(133), u8(192), u8(15), u8(149), u8(192), u8(72), u8(15), u8(182), u8(192)]))
}

fn emit_map_insert_call(state: EmitState, expression: Json) -> Result[EmitState, String] {
    let arguments: Json = field(expression, "args")
    if result_unwrap(json_array_len(arguments)) != 3 { return err("dynamic backend: map_insert expects three arguments") }
    let map_value: Json = result_unwrap(json_array_get(arguments, 0))
    let key: Json = result_unwrap(json_array_get(arguments, 1))
    let value: Json = result_unwrap(json_array_get(arguments, 2))
    let first: Result[EmitState, String] = emit_expression(state, map_value)
    if is_err(first) { return err(expression_error(first)) }
    let first_pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
    let second: Result[EmitState, String] = emit_expression(first_pushed, key)
    if is_err(second) { return err(expression_error(second)) }
    let second_pushed: EmitState = append_code(result_unwrap(second), [u8(80)])
    let third: Result[EmitState, String] = emit_expression(second_pushed, value)
    if is_err(third) { return err(expression_error(third)) }
    let moved: EmitState = append_code(result_unwrap(third), [u8(72), u8(137), u8(193), u8(94), u8(95), u8(72), u8(186)])
    let marked: EmitState = state_with_array_used(state_with_host_used(moved))
    let with_kind: EmitState = append_code(marked, dyn_u64_bytes(map_key_kind(expr_type(map_value))))
    return ok(emit_label_call(with_kind, host_map_insert_label(with_kind)))
}

fn emit_map_remove_call(state: EmitState, expression: Json) -> Result[EmitState, String] {
    let arguments: Json = field(expression, "args")
    if result_unwrap(json_array_len(arguments)) != 2 { return err("dynamic backend: map_remove expects two arguments") }
    let map_value: Json = result_unwrap(json_array_get(arguments, 0))
    let key: Json = result_unwrap(json_array_get(arguments, 1))
    if !starts_with(expr_type(map_value), "Map[") { return err("dynamic backend: map_remove expects Map[K,V] and K") }
    let first: Result[EmitState, String] = emit_expression(state, map_value)
    if is_err(first) { return err(expression_error(first)) }
    let pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
    let second: Result[EmitState, String] = emit_expression(pushed, key)
    if is_err(second) { return err(expression_error(second)) }
    let moved: EmitState = append_code(result_unwrap(second), [u8(72), u8(137), u8(198), u8(95), u8(72), u8(186)])
    let marked: EmitState = state_with_array_used(state_with_host_used(moved))
    let with_kind: EmitState = append_code(marked, dyn_u64_bytes(map_key_kind(expr_type(map_value))))
    return ok(emit_label_call(with_kind, host_map_remove_label(with_kind)))
}

fn emit_array_set_call(state: EmitState, expression: Json) -> Result[EmitState, String] {
    let arguments: Json = field(expression, "args")
    if result_unwrap(json_array_len(arguments)) != 3 { return err("dynamic backend: array_set expects three arguments") }
    let array_value: Json = result_unwrap(json_array_get(arguments, 0))
    let index: Json = result_unwrap(json_array_get(arguments, 1))
    let replacement: Json = result_unwrap(json_array_get(arguments, 2))
    if !starts_with(expr_type(array_value), "Array[") || expr_type(index) != "Int" || expr_type(array_value) != "Array[" + expr_type(replacement) + "]" {
        return err("dynamic backend: array_set expects Array[T], Int, and T")
    }
    let first: Result[EmitState, String] = emit_expression(state, array_value)
    if is_err(first) { return err(expression_error(first)) }
    let first_pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
    let second: Result[EmitState, String] = emit_expression(first_pushed, index)
    if is_err(second) { return err(expression_error(second)) }
    let second_pushed: EmitState = append_code(result_unwrap(second), [u8(80)])
    let third: Result[EmitState, String] = emit_expression(second_pushed, replacement)
    if is_err(third) { return err(expression_error(third)) }
    let moved: EmitState = append_code(result_unwrap(third), [u8(72), u8(137), u8(194), u8(94), u8(95)])
    let marked: EmitState = state_with_box_used(state_with_array_used(state_with_host_used(moved)))
    return ok(emit_label_call(marked, host_array_set_label(marked)))
}

