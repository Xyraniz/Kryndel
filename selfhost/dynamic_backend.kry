    current = append_code(result_unwrap(bound_string), [u8(72), u8(137), u8(199), u8(76), u8(137), u8(238)])
    current = emit_label_call(current, host_string_equal_label(current))
    current = append_code(current, [u8(72), u8(133), u8(192)])
    current = emit_jump(current, found.label, true, u8(133))
    current = append_code(current, [u8(73), u8(131), u8(199), u8(2)])
    current = emit_jump(current, loop_label.label, false, u8(0))
    let bound_scalar: Result[EmitState, String] = bind_label(current, scalar_key.label)
    if is_err(bound_scalar) { return err(unwrap_or(result_error(bound_scalar), "dynamic backend: cannot bind map scalar key path")) }
    current = append_code(result_unwrap(bound_scalar), [u8(76), u8(57), u8(232)])
    current = emit_jump(current, found.label, true, u8(132))
    current = append_code(current, [u8(73), u8(131), u8(199), u8(2)])
    current = emit_jump(current, loop_label.label, false, u8(0))
    let bound_found: Result[EmitState, String] = bind_label(current, found.label)
    if is_err(bound_found) { return err(unwrap_or(result_error(bound_found), "dynamic backend: cannot bind map lookup success")) }
    current = append_code(result_unwrap(bound_found), [u8(72), u8(141), u8(67), u8(8)])
    current = emit_jump(current, done.label, false, u8(0))
    let bound_not_found: Result[EmitState, String] = bind_label(current, not_found.label)
    if is_err(bound_not_found) { return err(unwrap_or(result_error(bound_not_found), "dynamic backend: cannot bind map lookup miss")) }
    current = append_code(result_unwrap(bound_not_found), [u8(72), u8(49), u8(192)])
