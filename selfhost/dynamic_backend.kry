fn emit_map_find_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, host_map_find_label(state))
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind map lookup runtime")) }
