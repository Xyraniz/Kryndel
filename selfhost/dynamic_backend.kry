    return ok(emit_label_call(marked, host_array_slice_label(marked)))
}

fn emit_box_call(state: EmitState, tag: UInt64) -> EmitState {
    let moved: EmitState = append_code(state, array_concat([u8(72), u8(137), u8(199), u8(72), u8(190)], dyn_u64_bytes(tag)))
    let used: EmitState = state_with_box_used(moved)
    return emit_label_call(used, used.assembler.box_alloc_label)
}

fn emit_option_predicate(state: EmitState, expression: Json, none: Bool) -> Result[EmitState, String] {
    let emitted: Result[EmitState, String] = emit_expression(state, expression)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let mut set: UInt8 = u8(149)
    if none { set = u8(148) }
    return ok(append_code(result_unwrap(emitted), [u8(72), u8(133), u8(192), u8(15), set, u8(192), u8(72), u8(15), u8(182), u8(192)]))
}

fn emit_result_predicate(state: EmitState, expression: Json, failed: Bool) -> Result[EmitState, String] {
    let emitted: Result[EmitState, String] = emit_expression(state, expression)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let nil_label: LabelState = new_label(result_unwrap(emitted))
    let join_label: LabelState = new_label(nil_label.state)
    let mut current: EmitState = append_code(join_label.state, [u8(72), u8(133), u8(192)])
    current = emit_jump(current, nil_label.label, true, u8(132))
    current = append_code(current, [u8(72), u8(131), u8(56), u8(0)])
    let mut set: UInt8 = u8(148)
    if failed { set = u8(149) }
    current = append_code(current, [u8(15), set, u8(192), u8(72), u8(15), u8(182), u8(192)])
    current = emit_jump(current, join_label.label, false, u8(0))
    let bound_nil: Result[EmitState, String] = bind_label(current, nil_label.label)
    if is_err(bound_nil) { return err(unwrap_or(result_error(bound_nil), "dynamic backend: cannot bind Result predicate nil path")) }
    current = emit_int(result_unwrap(bound_nil), 0)
    let bound_join: Result[EmitState, String] = bind_label(current, join_label.label)
    if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind Result predicate join")) }
    return ok(result_unwrap(bound_join))
}

fn emit_unwrap_or(state: EmitState, expression: Json) -> Result[EmitState, String] {
    let arguments: Json = field(expression, "args")
    if result_unwrap(json_array_len(arguments)) != 2 { return err("dynamic backend: unwrap_or expects two arguments") }
    let first: Result[EmitState, String] = emit_expression(state, result_unwrap(json_array_get(arguments, 0)))
    if is_err(first) { return err(expression_error(first)) }
    let pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
    let second: Result[EmitState, String] = emit_expression(pushed, result_unwrap(json_array_get(arguments, 1)))
    if is_err(second) { return err(expression_error(second)) }
    let mut current: EmitState = append_code(result_unwrap(second), [u8(72), u8(137), u8(198), u8(95), u8(72), u8(133), u8(255)])
    let none_label: LabelState = new_label(current)
    let join_label: LabelState = new_label(none_label.state)
    current = emit_jump(join_label.state, none_label.label, true, u8(132))
    current = append_code(current, [u8(72), u8(139), u8(71), u8(8)])
    current = emit_jump(current, join_label.label, false, u8(0))
    let bound_none: Result[EmitState, String] = bind_label(current, none_label.label)
    if is_err(bound_none) { return err(unwrap_or(result_error(bound_none), "dynamic backend: cannot bind unwrap_or none path")) }
    current = append_code(result_unwrap(bound_none), [u8(72), u8(137), u8(240)])
    let bound_join: Result[EmitState, String] = bind_label(current, join_label.label)
    if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind unwrap_or join")) }
    return ok(result_unwrap(bound_join))
}

fn emit_result_unwrap(state: EmitState, expression: Json) -> Result[EmitState, String] {
    let emitted: Result[EmitState, String] = emit_expression(state, expression)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let mut current: EmitState = append_code(result_unwrap(emitted), [u8(72), u8(133), u8(192)])
    current = emit_jump(current, current.env.trap_label, true, u8(132))
    current = append_code(current, [u8(72), u8(131), u8(56), u8(0)])
    current = emit_jump(current, current.env.trap_label, true, u8(133))
    return ok(append_code(current, [u8(72), u8(139), u8(64), u8(8)]))
}

fn emit_result_error(state: EmitState, expression: Json) -> Result[EmitState, String] {
    let emitted: Result[EmitState, String] = emit_expression(state, expression)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let nil_label: LabelState = new_label(result_unwrap(emitted))
