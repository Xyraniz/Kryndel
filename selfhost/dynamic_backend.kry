    current = emit_heap_alloc(current)
    return ok(append_code(current, [u8(72), u8(137), u8(24), u8(72), u8(137), u8(104), u8(8), u8(93), u8(91), u8(195)]))
}

fn emit_string_alloc_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, host_string_alloc_label(state))
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind host String allocator")) }
    let mut current: EmitState = append_code(result_unwrap(bound), [
        u8(83), u8(85), u8(65), u8(84), u8(65), u8(85), u8(65), u8(86),
        u8(73), u8(137), u8(254), u8(73), u8(137), u8(245),
        u8(72), u8(137), u8(240), u8(72), u8(131), u8(192), u8(8)
    ])
    current = emit_jump(current, current.env.trap_label, true, u8(128))
    current = append_code(current, [u8(72), u8(137), u8(199)])
    current = emit_heap_alloc(current)
    current = append_code(current, [
        u8(73), u8(137), u8(196), u8(76), u8(137), u8(40),
        u8(72), u8(141), u8(120), u8(8), u8(76), u8(137), u8(246), u8(76), u8(137), u8(233), u8(243), u8(164),
        u8(76), u8(137), u8(224), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92), u8(93), u8(91), u8(195)
    ])
    return ok(current)
}

fn emit_substring_call(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    if result_unwrap(kir_typed_array_len(arguments)) != 3 { return err("dynamic backend: substring expects String, Int, and Int") }
    let source: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
    let start: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 1))
    let length: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 2))
    if expr_type(source) != "String" || expr_type(start) != "Int" || expr_type(length) != "Int" {
        return err("dynamic backend: substring expects String, Int, and Int")
    }
    let first: Result[EmitState, String] = emit_expression(state, source)
    if is_err(first) { return err(expression_error(first)) }
    let first_pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
    let second: Result[EmitState, String] = emit_expression(first_pushed, start)
    if is_err(second) { return err(expression_error(second)) }
    let second_pushed: EmitState = append_code(result_unwrap(second), [u8(80)])
    let third: Result[EmitState, String] = emit_expression(second_pushed, length)
    if is_err(third) { return err(expression_error(third)) }
    let moved: EmitState = append_code(result_unwrap(third), [u8(72), u8(137), u8(194), u8(94), u8(95)])
    let marked: EmitState = state_with_host_used(moved)
    return ok(emit_label_call(marked, host_substring_label(marked)))
}

fn emit_substring_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, host_substring_label(state))
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind substring runtime")) }
    let negative_error: LabelState = new_label(result_unwrap(bound))
    let start_error: LabelState = new_label(negative_error.state)
    let end_error: LabelState = new_label(start_error.state)
