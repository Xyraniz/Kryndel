    current = emit_jump(current, start_advance.label, false, u8(0))
    let bound_start_three: Result[EmitState, String] = bind_label(current, start_three.label)
    if is_err(bound_start_three) { return err(unwrap_or(result_error(bound_start_three), "dynamic backend: cannot bind substring start 4-byte path")) }
    current = append_code(result_unwrap(bound_start_three), [u8(72), u8(199), u8(193), u8(3), u8(0), u8(0), u8(0)])
    current = emit_jump(current, start_advance.label, false, u8(0))
    let bound_start_two: Result[EmitState, String] = bind_label(current, start_two.label)
    if is_err(bound_start_two) { return err(unwrap_or(result_error(bound_start_two), "dynamic backend: cannot bind substring start 3-byte path")) }
    current = append_code(result_unwrap(bound_start_two), [u8(72), u8(199), u8(193), u8(2), u8(0), u8(0), u8(0)])
    current = emit_jump(current, start_advance.label, false, u8(0))
