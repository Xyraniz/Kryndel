fn emit_array_alloc_call(state: EmitState) -> EmitState {
    let moved: EmitState = append_code(state, [u8(72), u8(137), u8(199)])
    return emit_label_call(state_with_array_used(moved), moved.assembler.array_alloc_label)
}

fn emit_array_literal(state: EmitState, expression: Json) -> Result[EmitState, String] {
    let items: Json = field(expression, "items")
    let count: Int = result_unwrap(json_array_len(items))
    let allocated: EmitState = emit_int(state, count)
    let called: EmitState = emit_array_alloc_call(allocated)
    let mut current: EmitState = append_code(called, [u8(80)])
    let mut index: Int = 0
    while index < count {
        let item: Json = result_unwrap(json_array_get(items, index))
        let emitted: Result[EmitState, String] = emit_expression(current, item)
        if is_err(emitted) { return err(expression_error(emitted)) }
        current = append_code(result_unwrap(emitted), [u8(73), u8(137), u8(192), u8(72), u8(139), u8(12), u8(36)])
        current = append_code(current, array_concat([u8(72), u8(186)], dyn_u64_bytes(u64(8 + index * 8))))
        current = append_code(current, [u8(72), u8(1), u8(202), u8(76), u8(137), u8(2)])
        index = index + 1
    }
    return ok(append_code(current, [u8(88)]))
}

fn emit_array_index(state: EmitState, expression: Json) -> Result[EmitState, String] {
    let base: Json = field(expression, "base")
    if !starts_with(expr_type(base), "Array[") { return err("dynamic backend: indexing requires Array[T]") }
    let emitted_base: Result[EmitState, String] = emit_expression(state, base)
    if is_err(emitted_base) { return err(expression_error(emitted_base)) }
    let pushed: EmitState = append_code(result_unwrap(emitted_base), [u8(80)])
    let emitted_index: Result[EmitState, String] = emit_expression(pushed, field(expression, "left"))
    if is_err(emitted_index) { return err(expression_error(emitted_index)) }
    let combined: EmitState = append_code(result_unwrap(emitted_index), [u8(72), u8(137), u8(193), u8(88), u8(72), u8(133), u8(201)])
    let checked_sign: EmitState = emit_jump(combined, state.env.trap_label, true, u8(136))
    let checked_bounds: EmitState = append_code(checked_sign, [u8(72), u8(59), u8(8)])
    let guarded: EmitState = emit_jump(checked_bounds, state.env.trap_label, true, u8(131))
    return ok(append_code(guarded, [u8(72), u8(139), u8(68), u8(200), u8(8)]))
}

fn emit_array_push_call(state: EmitState, expression: Json) -> Result[EmitState, String] {
    let arguments: Json = field(expression, "args")
    if result_unwrap(json_array_len(arguments)) != 2 { return err("dynamic backend: array_push expects two arguments") }
    let first: Result[EmitState, String] = emit_expression(state, result_unwrap(json_array_get(arguments, 0)))
    if is_err(first) { return err(expression_error(first)) }
    let pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
    let second: Result[EmitState, String] = emit_expression(pushed, result_unwrap(json_array_get(arguments, 1)))
    if is_err(second) { return err(expression_error(second)) }
    let combined: EmitState = append_code(result_unwrap(second), [u8(72), u8(137), u8(198), u8(88), u8(72), u8(137), u8(199)])
    return ok(emit_label_call(state_with_array_used(combined), combined.assembler.array_push_label))
}

