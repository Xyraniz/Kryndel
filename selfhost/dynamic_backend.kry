    current = emit_jump(current, join_label.label, false, u8(0))
    let bound_nil: Result[EmitState, String] = bind_label(current, nil_label.label)
    if is_err(bound_nil) { return err(unwrap_or(result_error(bound_nil), "dynamic backend: cannot bind array_get nil path")) }
    current = emit_int(result_unwrap(bound_nil), 0)
    let bound_join: Result[EmitState, String] = bind_label(current, join_label.label)
    if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind array_get join")) }
    return ok(result_unwrap(bound_join))
}

fn emit_box_alloc_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, state.assembler.box_alloc_label)
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind Option/Result allocator")) }
    let mut current: EmitState = append_code(result_unwrap(bound), [
        u8(83), u8(85), u8(72), u8(137), u8(253), u8(72), u8(137), u8(243),
        u8(72), u8(49), u8(255), u8(72), u8(190), u8(16), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0),
        u8(186), u8(3), u8(0), u8(0), u8(0), u8(65), u8(186), u8(34), u8(0), u8(0), u8(0),
        u8(65), u8(184), u8(255), u8(255), u8(255), u8(255), u8(69), u8(49), u8(201),
        u8(184), u8(9), u8(0), u8(0), u8(0), u8(15), u8(5), u8(72), u8(133), u8(192)
    ])
    current = emit_jump(current, current.env.trap_label, true, u8(136))
    return ok(append_code(current, [u8(72), u8(137), u8(24), u8(72), u8(137), u8(104), u8(8), u8(93), u8(91), u8(195)]))
}

fn emit_integer(state: EmitState, unsigned: Bool) -> Result[EmitState, String] {
    let mut current: EmitState = append_code(state, array_concat([u8(76), u8(141), u8(133)], i32_bytes(0 - state.env.buffer_offset)))
    current = append_code(current, array_concat([u8(73), u8(185)], dyn_u64_bytes(u64(10))))
    let zero_label: LabelState = new_label(current)
    let digits_label: LabelState = new_label(zero_label.state)
    let sign_label: LabelState = new_label(digits_label.state)
    let ready_label: LabelState = new_label(sign_label.state)
    current = append_code(ready_label.state, [u8(69), u8(49), u8(210), u8(72), u8(133), u8(192)])
    current = emit_jump(current, zero_label.label, true, u8(132))
    if !unsigned {
        current = emit_jump(current, digits_label.label, true, u8(137))
        current = append_code(current, [u8(65), u8(178), u8(1), u8(72), u8(247), u8(216)])
        current = emit_jump(current, current.env.trap_label, true, u8(128))
    }
    let bound_digits: Result[EmitState, String] = bind_label(current, digits_label.label)
    if is_err(bound_digits) { return err(unwrap_or(result_error(bound_digits), "dynamic backend: cannot bind integer digits")) }
    current = result_unwrap(bound_digits)
    let loop_label: LabelState = new_label(current)
    let bound_loop: Result[EmitState, String] = bind_label(loop_label.state, loop_label.label)
    if is_err(bound_loop) { return err(unwrap_or(result_error(bound_loop), "dynamic backend: cannot bind integer loop")) }
    current = append_code(result_unwrap(bound_loop), [u8(72), u8(49), u8(210), u8(73), u8(247), u8(241), u8(128), u8(194), u8(48), u8(73), u8(255), u8(200), u8(65), u8(136), u8(16), u8(72), u8(133), u8(192)])
    current = emit_jump(current, loop_label.label, true, u8(133))
    current = emit_jump(current, sign_label.label, false, u8(0))
    let bound_zero: Result[EmitState, String] = bind_label(current, zero_label.label)
    if is_err(bound_zero) { return err(unwrap_or(result_error(bound_zero), "dynamic backend: cannot bind integer zero")) }
    current = append_code(result_unwrap(bound_zero), [u8(73), u8(255), u8(200), u8(65), u8(198), u8(0), u8(48)])
    current = emit_jump(current, sign_label.label, false, u8(0))
    let bound_sign: Result[EmitState, String] = bind_label(current, sign_label.label)
    if is_err(bound_sign) { return err(unwrap_or(result_error(bound_sign), "dynamic backend: cannot bind integer sign")) }
    current = result_unwrap(bound_sign)
    if !unsigned {
        current = append_code(current, [u8(69), u8(132), u8(210)])
        current = emit_jump(current, ready_label.label, true, u8(132))
        current = append_code(current, [u8(73), u8(255), u8(200), u8(65), u8(198), u8(0), u8(45)])
    }
    let bound_ready: Result[EmitState, String] = bind_label(current, ready_label.label)
    if is_err(bound_ready) { return err(unwrap_or(result_error(bound_ready), "dynamic backend: cannot bind integer output")) }
    current = append_code(result_unwrap(bound_ready), [u8(184), u8(1), u8(0), u8(0), u8(0), u8(191), u8(1), u8(0), u8(0), u8(0), u8(76), u8(137), u8(198), u8(72), u8(141), u8(149)])
    current = append_code(current, i32_bytes(0 - state.env.buffer_offset))
    current = append_code(current, [u8(72), u8(41), u8(242), u8(15), u8(5)])
    return ok(current)
}

fn expr_type(expression: Json) -> String {
    return text(field(expression, "type"))
}

fn is_unsigned(type_name: String) -> Bool {
    return starts_with(type_name, "UInt")
}

fn uint_bits(type_name: String) -> Int {
    if type_name == "UInt8" { return 8 }
    if type_name == "UInt16" { return 16 }
    if type_name == "UInt32" { return 32 }
    if type_name == "UInt64" { return 64 }
    return 0
}

fn setcc(operator: String, unsigned: Bool) -> UInt8 {
    if operator == "==" { return u8(148) }
    if operator == "!=" { return u8(149) }
    if operator == "<" {
        if unsigned { return u8(146) }
        return u8(156)
    }
    if operator == "<=" {
        if unsigned { return u8(150) }
        return u8(158)
    }
    if operator == ">" {
        if unsigned { return u8(151) }
        return u8(159)
    }
    if unsigned { return u8(147) }
    return u8(157)
}

fn expression_error(value: Result[EmitState, String]) -> String {
    return unwrap_or(result_error(value), "dynamic backend: expression lowering failed")
}

fn emit_function_call(state: EmitState, expression: Json) -> Result[EmitState, String] {
    let arguments: Json = field(expression, "args")
    let count: Int = result_unwrap(json_array_len(arguments))
    if count > 6 { return err("dynamic backend: at most six scalar arguments are supported") }
    let mut index: Int = 0
    let mut current: EmitState = state
    while index < count {
        let argument: Json = result_unwrap(json_array_get(arguments, index))
        let emitted: Result[EmitState, String] = emit_expression(current, argument)
        if is_err(emitted) { return err(expression_error(emitted)) }
        let moved: Result[EmitState, String] = emit_move_arg(result_unwrap(emitted), index)
        if is_err(moved) { return err(unwrap_or(result_error(moved), "dynamic backend: argument register failed")) }
        current = result_unwrap(moved)
        index = index + 1
    }
    return emit_call(current, text(field(expression, "name")))
}

fn emit_expression(state: EmitState, expression: Json) -> Result[EmitState, String] {
    let constant: Json = field(expression, "const")
    if json_kind(constant) == "object" {
        let constant_kind: String = text(field(constant, "kind"))
        if constant_kind == "int" { return ok(emit_int(state, result_unwrap(json_int(field(constant, "int"))))) }
        if constant_kind == "uint" {
            return ok(emit_uint(state, result_unwrap(json_uint(field(constant, "uint"))), result_unwrap(json_int(field(constant, "uint_bits")))))
        }
        if constant_kind == "bool" {
            if result_unwrap(json_bool(field(constant, "bool"))) { return ok(emit_int(state, 1)) }
            return ok(emit_int(state, 0))
        }
        if constant_kind == "string" { return ok(emit_string(state, text(field(constant, "string")))) }
    }
    let kind: String = text(field(expression, "kind"))
    if kind == "int" {
        return ok(emit_int(state, result_unwrap(json_int(field(expression, "int")))))
    }
    if kind == "uint" {
        return ok(emit_uint(state, result_unwrap(json_uint(field(expression, "uint"))), result_unwrap(json_int(field(expression, "uint_bits")))))
    }
    if kind == "string" {
        return ok(emit_string(state, text(field(expression, "string"))))
    }
    if kind == "array" {
        return emit_array_literal(state, expression)
    }
    if kind == "index" {
        return emit_array_index(state, expression)
    }
    if kind == "call" {
        let target: String = text(field(expression, "call_target"))
        if starts_with(target, "function:") { return emit_function_call(state, expression) }
        let arguments: Json = field(expression, "args")
        if target == "builtin:none" {
            if result_unwrap(json_array_len(arguments)) != 0 { return err("dynamic backend: none expects no arguments") }
            return ok(emit_int(state, 0))
        }
        let argument: Json = result_unwrap(json_array_get(arguments, 0))
        if target == "builtin:len" {
            if result_unwrap(json_array_len(arguments)) != 1 || !starts_with(expr_type(argument), "Array[") { return err("dynamic backend: len supports Array[T] only") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            return ok(append_code(result_unwrap(emitted), [u8(72), u8(139), u8(0)]))
        }
        if target == "builtin:array_push" { return emit_array_push_call(state, expression) }
        if target == "builtin:array_get" { return emit_array_get(state, expression) }
        if target == "builtin:array_concat" {
            if result_unwrap(json_array_len(arguments)) != 2 { return err("dynamic backend: array_concat expects two arguments") }
            let first: Result[EmitState, String] = emit_expression(state, result_unwrap(json_array_get(arguments, 0)))
            if is_err(first) { return err(expression_error(first)) }
            let pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
            let second: Result[EmitState, String] = emit_expression(pushed, result_unwrap(json_array_get(arguments, 1)))
            if is_err(second) { return err(expression_error(second)) }
            let combined: EmitState = append_code(result_unwrap(second), [u8(72), u8(137), u8(193), u8(88)])
            return ok(emit_array_concat_call(combined))
        }
        if target == "builtin:some" {
            if result_unwrap(json_array_len(arguments)) != 1 { return err("dynamic backend: some expects one argument") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            return ok(emit_box_call(result_unwrap(emitted), u64(1)))
        }
        if target == "builtin:ok" || target == "builtin:err" {
            if result_unwrap(json_array_len(arguments)) != 1 { return err("dynamic backend: Result constructor expects one argument") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            let mut tag: UInt64 = u64(0)
            if target == "builtin:err" { tag = u64(1) }
            return ok(emit_box_call(result_unwrap(emitted), tag))
        }
        if target == "builtin:is_some" || target == "builtin:is_none" {
            if result_unwrap(json_array_len(arguments)) != 1 { return err("dynamic backend: Option predicate expects one argument") }
            return emit_option_predicate(state, argument, target == "builtin:is_none")
        }
        if target == "builtin:is_ok" || target == "builtin:is_err" {
            if result_unwrap(json_array_len(arguments)) != 1 { return err("dynamic backend: Result predicate expects one argument") }
            return emit_result_predicate(state, argument, target == "builtin:is_err")
        }
        if target == "builtin:unwrap_or" { return emit_unwrap_or(state, expression) }
        if target == "builtin:result_unwrap" {
            if result_unwrap(json_array_len(arguments)) != 1 { return err("dynamic backend: result_unwrap expects one argument") }
            return emit_result_unwrap(state, argument)
        }
        if target == "builtin:result_error" {
            if result_unwrap(json_array_len(arguments)) != 1 { return err("dynamic backend: result_error expects one argument") }
            return emit_result_error(state, argument)
        }
        let value: UInt64 = u64(result_unwrap(json_int(field(argument, "int"))))
        if target == "builtin:u8" { return ok(emit_uint(state, value, 8)) }
        if target == "builtin:u16" { return ok(emit_uint(state, value, 16)) }
        if target == "builtin:u32" { return ok(emit_uint(state, value, 32)) }
        if target == "builtin:u64" { return ok(emit_uint(state, value, 64)) }
        return err("dynamic backend: unsupported call '" + target + "'")
    }
    if kind == "bool" {
        let value: Bool = result_unwrap(json_bool(field(expression, "bool")))
        if value { return ok(emit_int(state, 1)) }
        return ok(emit_int(state, 0))
    }
    if kind == "var" {
        let name: String = text(field(expression, "name"))
        let slot: Option[Int] = map_get(state.env.slots, name)
        if is_none(slot) { return err("dynamic backend: unknown slot '" + name + "'") }
        return ok(emit_load_slot(state, unwrap_or(slot, -1)))
    }
    if kind == "unary" {
        let operand: Result[EmitState, String] = emit_expression(state, field(expression, "operand"))
        if is_err(operand) { return err(expression_error(operand)) }
        let updated: EmitState = result_unwrap(operand)
        let operator: String = text(field(expression, "operator"))
        if operator == "-" { return ok(append_code(updated, [u8(72), u8(247), u8(216)])) }
        if operator == "!" { return ok(append_code(updated, [u8(72), u8(133), u8(192), u8(15), u8(148), u8(192), u8(72), u8(15), u8(182), u8(192)])) }
        return err("dynamic backend: unsupported unary operator '" + operator + "'")
    }
    if kind != "binary" {
        return err("dynamic backend: unsupported expression kind '" + kind + "'")
    }
    let left: Result[EmitState, String] = emit_expression(state, field(expression, "left"))
    if is_err(left) { return err(expression_error(left)) }
    let pushed: EmitState = append_code(result_unwrap(left), [u8(80)])
    let right: Result[EmitState, String] = emit_expression(pushed, field(expression, "right"))
    if is_err(right) { return err(expression_error(right)) }
    let combined: EmitState = append_code(result_unwrap(right), [u8(72), u8(137), u8(193), u8(88)])
    let operator: String = text(field(expression, "operator"))
    let expression_type: String = expr_type(expression)
    if expression_type == "String" {
        if operator != "+" { return err("dynamic backend: unsupported String operator '" + operator + "'") }
        return ok(emit_string_concat_call(combined))
    }
    if starts_with(expression_type, "Array[") {
        if operator != "+" { return err("dynamic backend: unsupported Array operator '" + operator + "'") }
        return ok(emit_array_concat_call(combined))
    }
    let unsigned: Bool = is_unsigned(expression_type)
    let bits: Int = uint_bits(expression_type)
    if operator == "+" {
        let added: EmitState = append_code(combined, [u8(72), u8(1), u8(200)])
        if !unsigned { return ok(emit_jump(added, state.env.trap_label, true, u8(128))) }
        return ok(emit_uint_mask(added, bits))
    }
    if operator == "-" {
        let subtracted: EmitState = append_code(combined, [u8(72), u8(41), u8(200)])
        if !unsigned { return ok(emit_jump(subtracted, state.env.trap_label, true, u8(128))) }
        return ok(emit_uint_mask(subtracted, bits))
    }
    if operator == "*" {
        let multiplied: EmitState = append_code(combined, [u8(72), u8(15), u8(175), u8(193)])
        if !unsigned { return ok(emit_jump(multiplied, state.env.trap_label, true, u8(128))) }
        return ok(emit_uint_mask(multiplied, bits))
    }
    if operator == "/" || operator == "%" {
        let checked: EmitState = append_code(combined, [u8(72), u8(133), u8(201)])
        let guarded: EmitState = emit_jump(checked, state.env.trap_label, true, u8(132))
        let divided: EmitState = append_code(guarded, [u8(72), u8(153), u8(72), u8(247), u8(249)])
        if operator == "%" { return ok(emit_uint_mask(append_code(divided, [u8(72), u8(137), u8(208)]), bits)) }
        return ok(emit_uint_mask(divided, bits))
    }
    if operator == "&" { return ok(emit_uint_mask(append_code(combined, [u8(72), u8(33), u8(200)]), bits)) }
    if operator == "^" { return ok(emit_uint_mask(append_code(combined, [u8(72), u8(49), u8(200)]), bits)) }
    if operator == "|" { return ok(emit_uint_mask(append_code(combined, [u8(72), u8(9), u8(200)]), bits)) }
    if operator == "<<" { return ok(emit_uint_mask(append_code(combined, [u8(72), u8(211), u8(224)]), bits)) }
    if operator == ">>" { return ok(emit_uint_mask(append_code(combined, [u8(72), u8(211), u8(232)]), bits)) }
    if operator == "&&" { return ok(append_code(combined, [u8(72), u8(33), u8(200)])) }
    if operator == "||" { return ok(append_code(combined, [u8(72), u8(9), u8(200)])) }
    if operator == "==" || operator == "!=" || operator == "<" || operator == "<=" || operator == ">" || operator == ">=" {
        return ok(append_code(combined, [u8(72), u8(57), u8(200), u8(15), setcc(operator, unsigned), u8(192), u8(72), u8(15), u8(182), u8(192)]))
    }
    return err("dynamic backend: unsupported binary operator '" + operator + "'")
}

fn compile_error(value: Result[EmitState, String]) -> String {
    return unwrap_or(result_error(value), "dynamic backend: statement lowering failed")
}

fn allocate_slot(state: EmitState, name: String) -> Result[EmitState, String] {
    if map_contains_key(state.env.slots, name) { return err("dynamic backend: shadowed slot '" + name + "'") }
    let offset: Int = state.env.next_slot + 8
    let env: CompileEnv = CompileEnv{ slots: map_insert(state.env.slots, name, offset), static_values: state.env.static_values, function_labels: state.env.function_labels, function_returns: state.env.function_returns, next_slot: offset, breaks: state.env.breaks, continues: state.env.continues, end_label: state.env.end_label, trap_label: state.env.trap_label, buffer_offset: state.env.buffer_offset, in_function: state.env.in_function, current_function: state.env.current_function }
    return ok(state_with_env(state, env))
}

fn compile_statement(state: EmitState, statement: Json) -> Result[EmitState, String] {
    let kind: String = text(field(statement, "kind"))
    if kind == "let" || kind == "const" {
        let name: String = text(field(statement, "name"))
        let allocated: Result[EmitState, String] = allocate_slot(state, name)
        if is_err(allocated) { return err(compile_error(allocated)) }
        let updated: EmitState = result_unwrap(allocated)
        let init: Json = field(statement, "init")
        let type_name: String = expr_type(init)
        if state.env.in_function && !is_scalar_type(type_name) { return err("dynamic backend: function local has unsupported type '" + type_name + "'") }
        let mut generated: Result[EmitState, String] = err("dynamic backend: initializer was not lowered")
        generated = emit_expression(updated, init)
        if is_err(generated) { return err(expression_error(generated)) }
        let stored: EmitState = emit_store_slot(result_unwrap(generated), unwrap_or(map_get(updated.env.slots, name), -1))
        let mutable: Bool = result_unwrap(json_bool(field(statement, "mutable")))
        if !mutable {
            let mut display_value: Result[String, String] = err("dynamic backend: initializer is not static display data")
            if type_name == "String" || type_name == "Int" || type_name == "Bool" || starts_with(type_name, "UInt") {
                display_value = eval_display(init, stored.env.static_values)
            }
            if is_ok(display_value) {
                let env: CompileEnv = CompileEnv{ slots: stored.env.slots, static_values: map_insert(stored.env.static_values, name, result_unwrap(display_value)), function_labels: stored.env.function_labels, function_returns: stored.env.function_returns, next_slot: stored.env.next_slot, breaks: stored.env.breaks, continues: stored.env.continues, end_label: stored.env.end_label, trap_label: stored.env.trap_label, buffer_offset: stored.env.buffer_offset, in_function: stored.env.in_function, current_function: stored.env.current_function }
                return ok(state_with_env(stored, env))
            }
        }
        return ok(stored)
    }
    if kind == "assign" {
        let target: Json = field(statement, "target")
        let name: String = text(field(target, "name"))
        let slot: Option[Int] = map_get(state.env.slots, name)
        if is_none(slot) { return err("dynamic backend: assignment uses unknown slot '" + name + "'") }
        let value: Result[EmitState, String] = emit_expression(state, field(statement, "value"))
        if is_err(value) { return err(expression_error(value)) }
        let stored: EmitState = emit_store_slot(result_unwrap(value), unwrap_or(slot, -1))
        return ok(state_with_env(stored, CompileEnv{ slots: stored.env.slots, static_values: map_remove(stored.env.static_values, name), function_labels: stored.env.function_labels, function_returns: stored.env.function_returns, next_slot: stored.env.next_slot, breaks: stored.env.breaks, continues: stored.env.continues, end_label: stored.env.end_label, trap_label: stored.env.trap_label, buffer_offset: stored.env.buffer_offset, in_function: stored.env.in_function, current_function: stored.env.current_function }))
    }
    if kind == "expr" {
        let expression: Json = field(statement, "expr")
        let target: String = text(field(expression, "call_target"))
        if starts_with(target, "function:") {
            return emit_function_call(state, expression)
        }
        if target != "builtin:print" && target != "builtin:println" { return err("dynamic backend: only print, println, and zero-argument functions are supported") }
        let argument: Json = result_unwrap(json_array_get(field(expression, "args"), 0))
        let display_value: Result[String, String] = eval_display(argument, state.env.static_values)
        if is_ok(display_value) {
            let mut output: String = result_unwrap(display_value)
            if target == "builtin:println" { output = output + "\n" }
            return ok(emit_write(state, output))
        }
        let type_name: String = expr_type(argument)
        if type_name == "String" {
            let emitted_string: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted_string) { return err(expression_error(emitted_string)) }
            let written_string: EmitState = emit_string_write(result_unwrap(emitted_string))
            if target == "builtin:println" { return ok(emit_write(written_string, "\n")) }
            return ok(written_string)
        }
        if type_name == "Bool" {
            return emit_boolean_output(state, argument, target == "builtin:println")
        }
        if type_name != "Int" && !starts_with(type_name, "UInt") { return err(unwrap_or(result_error(display_value), "dynamic backend: print value is not static")) }
        let generated: Result[EmitState, String] = emit_expression(state, argument)
        if is_err(generated) { return err(expression_error(generated)) }
        let output_state: Result[EmitState, String] = emit_integer(result_unwrap(generated), starts_with(type_name, "UInt"))
        if is_err(output_state) { return err(unwrap_or(result_error(output_state), "dynamic backend: integer output failed")) }
        if target == "builtin:println" { return ok(emit_write(result_unwrap(output_state), "\n")) }
        return ok(result_unwrap(output_state))
    }
    if kind == "if" {
        let else_label: LabelState = new_label(state)
        let condition: Result[EmitState, String] = emit_expression(else_label.state, field(statement, "cond"))
        if is_err(condition) { return err(expression_error(condition)) }
        let tested: EmitState = append_code(result_unwrap(condition), [u8(72), u8(133), u8(192)])
        let guarded: EmitState = emit_jump(tested, else_label.label, true, u8(132))
        let then_state: Result[EmitState, String] = compile_statements(guarded, field(statement, "then"))
        if is_err(then_state) { return err(compile_error(then_state)) }
        if result_unwrap(json_array_len(field(statement, "else"))) == 0 {
            let bound: Result[EmitState, String] = bind_label(result_unwrap(then_state), else_label.label)
            if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind empty if join")) }
            return ok(result_unwrap(bound))
        }
        let join_label: LabelState = new_label(result_unwrap(then_state))
        let jumped: EmitState = emit_jump(join_label.state, join_label.label, false, u8(0))
        let bound_else: Result[EmitState, String] = bind_label(jumped, else_label.label)
        if is_err(bound_else) { return err(unwrap_or(result_error(bound_else), "dynamic backend: cannot bind else")) }
        let else_state: Result[EmitState, String] = compile_statements(result_unwrap(bound_else), field(statement, "else"))
        if is_err(else_state) { return err(compile_error(else_state)) }
        let bound_join: Result[EmitState, String] = bind_label(result_unwrap(else_state), join_label.label)
        if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind if join")) }
        return ok(result_unwrap(bound_join))
    }
    if kind == "while" {
        let condition_label: LabelState = new_label(state)
        let end_label: LabelState = new_label(condition_label.state)
        let bound_condition: Result[EmitState, String] = bind_label(end_label.state, condition_label.label)
        if is_err(bound_condition) { return err(unwrap_or(result_error(bound_condition), "dynamic backend: cannot bind loop")) }
        let condition: Result[EmitState, String] = emit_expression(result_unwrap(bound_condition), field(statement, "cond"))
        if is_err(condition) { return err(expression_error(condition)) }
        let tested: EmitState = append_code(result_unwrap(condition), [u8(72), u8(133), u8(192)])
        let guarded: EmitState = emit_jump(tested, end_label.label, true, u8(132))
        let env: CompileEnv = CompileEnv{ slots: guarded.env.slots, static_values: guarded.env.static_values, function_labels: guarded.env.function_labels, function_returns: guarded.env.function_returns, next_slot: guarded.env.next_slot, breaks: array_push(guarded.env.breaks, end_label.label), continues: array_push(guarded.env.continues, condition_label.label), end_label: guarded.env.end_label, trap_label: guarded.env.trap_label, buffer_offset: guarded.env.buffer_offset, in_function: guarded.env.in_function, current_function: guarded.env.current_function }
        let body: Result[EmitState, String] = compile_statements(state_with_env(guarded, env), field(statement, "body"))
        if is_err(body) { return err(compile_error(body)) }
        let body_state: EmitState = result_unwrap(body)
        let restored: EmitState = state_with_env(body_state, CompileEnv{ slots: body_state.env.slots, static_values: body_state.env.static_values, function_labels: body_state.env.function_labels, function_returns: body_state.env.function_returns, next_slot: body_state.env.next_slot, breaks: array_slice(body_state.env.breaks, 0, len(body_state.env.breaks) - 1), continues: array_slice(body_state.env.continues, 0, len(body_state.env.continues) - 1), end_label: body_state.env.end_label, trap_label: body_state.env.trap_label, buffer_offset: body_state.env.buffer_offset, in_function: body_state.env.in_function, current_function: body_state.env.current_function })
        let looped: EmitState = emit_jump(restored, condition_label.label, false, u8(0))
        let bound_end: Result[EmitState, String] = bind_label(looped, end_label.label)
        if is_err(bound_end) { return err(unwrap_or(result_error(bound_end), "dynamic backend: cannot bind loop end")) }
        return ok(result_unwrap(bound_end))
    }
    if kind == "break" || kind == "continue" {
        let mut labels: Array[Int] = state.env.continues
        if kind == "break" {
            labels = state.env.breaks
        }
        if len(labels) == 0 { return err("dynamic backend: loop control is outside a loop") }
        let label: Int = unwrap_or(array_get(labels, len(labels) - 1), -1)
        return ok(emit_jump(state, label, false, u8(0)))
    }
    if kind == "return" {
        if state.env.in_function {
            let value: Json = field(statement, "return")
            let return_type: String = unwrap_or(map_get(state.env.function_returns, state.env.current_function), "Nil")
            let mut current: EmitState = state
            let mut has_value: Bool = false
            if json_kind(value) != "null" {
                has_value = text(field(value, "kind")) != "nil"
            }
            if has_value {
                if return_type == "Nil" { return err("dynamic backend: Nil function cannot return a value") }
                let emitted: Result[EmitState, String] = emit_expression(current, value)
                if is_err(emitted) { return err(expression_error(emitted)) }
                current = result_unwrap(emitted)
            } else if return_type != "Nil" {
                return err("dynamic backend: scalar function must return a value")
            }
            return ok(append_code(current, [u8(201), u8(195)]))
        }
        return ok(emit_jump(state, state.env.end_label, false, u8(0)))
    }
    return err("dynamic backend: unsupported statement kind '" + kind + "'")
}

fn compile_statements(state: EmitState, statements: Json) -> Result[EmitState, String] {
    let count: Int = result_unwrap(json_array_len(statements))
    let mut index: Int = 0
    let mut current: EmitState = state
    while index < count {
        let statement: Json = result_unwrap(json_array_get(statements, index))
        let next: Result[EmitState, String] = compile_statement(current, statement)
        if is_err(next) { return err(compile_error(next)) }
        current = result_unwrap(next)
        index = index + 1
    }
    return ok(current)
}

fn patch_code(state: EmitState, position: Int, bytes: Array[UInt8]) -> Result[EmitState, String] {
    let mut current: EmitState = state
    for offset in array_indices(bytes) {
        let replacement: UInt8 = unwrap_or(array_get(bytes, offset), u8(0))
        let updated: Result[Array[UInt8], String] = array_set(current.assembler.code, position + offset, replacement)
        if is_err(updated) { return err(unwrap_or(result_error(updated), "dynamic backend: code patch out of bounds")) }
        current = state_with_code(current, result_unwrap(updated))
    }
    return ok(current)
}

fn finalize_jumps(state: EmitState) -> Result[EmitState, String] {
    let mut current: EmitState = state
    for index in array_indices(current.assembler.jumps) {
        let patch: JumpPatch = unwrap_or(array_get(current.assembler.jumps, index), JumpPatch{ label: -1, position: -1 })
        let target: Int = unwrap_or(array_get(current.assembler.labels, patch.label), -1)
        if target < 0 { return err("dynamic backend: unresolved label") }
        let updated: Result[EmitState, String] = patch_code(current, patch.position, i32_bytes(target - patch.position - 4))
        if is_err(updated) { return err(unwrap_or(result_error(updated), "dynamic backend: jump patch failed")) }
        current = result_unwrap(updated)
    }
    return ok(current)
}

fn finalize_data(state: EmitState) -> Result[EmitState, String] {
    let mut current: EmitState = state
    for index in array_indices(current.assembler.data_patches) {
        let patch: DataPatch = unwrap_or(array_get(current.assembler.data_patches, index), DataPatch{ displacement: -1, instruction_end: -1, data_offset: -1 })
        let data_address: Int = 120 + len(current.assembler.code) + patch.data_offset
        let next_instruction: Int = 120 + patch.instruction_end
        let updated: Result[EmitState, String] = patch_code(current, patch.displacement, i32_bytes(data_address - next_instruction))
        if is_err(updated) { return err(unwrap_or(result_error(updated), "dynamic backend: data patch failed")) }
        current = result_unwrap(updated)
    }
    return ok(current)
}

fn align_frame(value: Int) -> Int {
    let remainder: Int = value % 16
    if remainder == 0 { return value }
    return value + (16 - remainder)
}

fn emit_dynamic_elf(code: Array[UInt8], data: Array[UInt8]) -> Bytes {
    let file_size: Int = 120 + len(code) + len(data)
    let mut file: Array[UInt8] = []
    file = array_concat(file, [u8(127), u8(69), u8(76), u8(70), u8(2), u8(1), u8(1), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0)])
    file = array_concat(file, dyn_u16_bytes(u16(2)))
    file = array_concat(file, dyn_u16_bytes(u16(62)))
    file = array_concat(file, dyn_u32_bytes(u32(1)))
    file = array_concat(file, dyn_u64_bytes(u64(4194424)))
    file = array_concat(file, dyn_u64_bytes(u64(64)))
    file = array_concat(file, dyn_u64_bytes(u64(0)))
    file = array_concat(file, dyn_u32_bytes(u32(0)))
    file = array_concat(file, dyn_u16_bytes(u16(64)))
    file = array_concat(file, dyn_u16_bytes(u16(56)))
    file = array_concat(file, dyn_u16_bytes(u16(1)))
    file = array_concat(file, dyn_u16_bytes(u16(0)))
    file = array_concat(file, dyn_u16_bytes(u16(0)))
    file = array_concat(file, dyn_u16_bytes(u16(0)))
    file = array_concat(file, dyn_u32_bytes(u32(1)))
    file = array_concat(file, dyn_u32_bytes(u32(5)))
    file = array_concat(file, dyn_u64_bytes(u64(0)))
    file = array_concat(file, dyn_u64_bytes(u64(4194304)))
    file = array_concat(file, dyn_u64_bytes(u64(4194304)))
    file = array_concat(file, dyn_u64_bytes(u64(file_size)))
    file = array_concat(file, dyn_u64_bytes(u64(file_size)))
    file = array_concat(file, dyn_u64_bytes(u64(4096)))
    file = array_concat(file, code)
    file = array_concat(file, data)
    return bytes_from_u8(file)
}

fn new_dynamic_state() -> EmitState {
    let assembler: Assembler = Assembler{ code: [], data: [], data_by_text: {}, string_data_by_text: {}, labels: [], jumps: [], data_patches: [], frame_patch: -1, string_concat_label: -1, string_concat_used: false, array_alloc_label: -1, array_push_label: -1, array_concat_label: -1, array_runtime_used: false, box_alloc_label: -1, box_runtime_used: false }
    let env: CompileEnv = CompileEnv{ slots: {}, static_values: {}, function_labels: {}, function_returns: {}, next_slot: 0, breaks: [], continues: [], end_label: -1, trap_label: -1, buffer_offset: 1, in_function: false, current_function: "" }
    return EmitState{ assembler: assembler, env: env }
}

fn count_slots(statements: Json) -> Int {
    let count: Int = result_unwrap(json_array_len(statements))
    let mut index: Int = 0
    let mut total: Int = 0
    while index < count {
        let statement: Json = result_unwrap(json_array_get(statements, index))
        let kind: String = text(field(statement, "kind"))
        if kind == "let" || kind == "const" {
            total = total + 1
        }
        if kind == "if" {
            total = total + count_slots(field(statement, "then"))
            total = total + count_slots(field(statement, "else"))
        }
        if kind == "while" {
            total = total + count_slots(field(statement, "body"))
        }
        index = index + 1
    }
    return total
}

fn count_function_slots(statements: Json) -> Result[Int, String] {
    let count: Int = result_unwrap(json_array_len(statements))
    let mut index: Int = 0
    let mut total: Int = 0
    while index < count {
        let statement: Json = result_unwrap(json_array_get(statements, index))
        let kind: String = text(field(statement, "kind"))
        if kind == "let" || kind == "const" {
            let type_name: String = expr_type(field(statement, "init"))
            if !is_scalar_type(type_name) { return err("dynamic backend: function local has unsupported type '" + type_name + "'") }
            total = total + 1
        }
        if kind == "if" {
            let then_count: Result[Int, String] = count_function_slots(field(statement, "then"))
            if is_err(then_count) { return err(unwrap_or(result_error(then_count), "dynamic backend: function local scan failed")) }
            total = total + result_unwrap(then_count)
            let else_count: Result[Int, String] = count_function_slots(field(statement, "else"))
            if is_err(else_count) { return err(unwrap_or(result_error(else_count), "dynamic backend: function local scan failed")) }
            total = total + result_unwrap(else_count)
        }
        if kind == "while" {
            let body_count: Result[Int, String] = count_function_slots(field(statement, "body"))
            if is_err(body_count) { return err(unwrap_or(result_error(body_count), "dynamic backend: function local scan failed")) }
            total = total + result_unwrap(body_count)
        }
        index = index + 1
    }
    return ok(total)
}

fn entry_statements(document: Json) -> Json {
    let statements: Json = field(document, "statements")
    if result_unwrap(json_array_len(statements)) > 0 {
        return statements
    }
    let functions: Json = field(document, "functions")
    let count: Int = result_unwrap(json_array_len(functions))
    let mut index: Int = 0
    while index < count {
        let function: Json = result_unwrap(json_array_get(functions, index))
        if text(field(function, "name")) == "main" {
            return field(function, "body")
        }
        index = index + 1
    }
    return result_unwrap(json_parse("[]"))
}

fn is_scalar_type(type_name: String) -> Bool {
    return type_name == "Int" || type_name == "Bool" || type_name == "String" || type_name == "Json" || starts_with(type_name, "UInt") || starts_with(type_name, "Array[") || starts_with(type_name, "Option[") || starts_with(type_name, "Result[") || starts_with(type_name, "Map[")
}

fn prepare_function_labels(state: EmitState, functions: Json) -> Result[EmitState, String] {
    let count: Int = result_unwrap(json_array_len(functions))
    let mut index: Int = 0
    let mut current: EmitState = state
    while index < count {
        let function: Json = result_unwrap(json_array_get(functions, index))
        let name: String = text(field(function, "name"))
        if name != "main" {
            if map_contains_key(current.env.function_labels, name) { return err("dynamic backend: duplicate function '" + name + "'") }
            let parameters: Json = field(function, "params")
            let parameter_count: Int = result_unwrap(json_array_len(parameters))
            if parameter_count > 6 { return err("dynamic backend: function '" + name + "' has too many parameters") }
            let return_type: String = text(field(function, "return"))
            if return_type != "Nil" && !is_scalar_type(return_type) { return err("dynamic backend: function '" + name + "' has unsupported return type '" + return_type + "'") }
            let mut parameter_index: Int = 0
            while parameter_index < parameter_count {
                let parameter: Json = result_unwrap(json_array_get(parameters, parameter_index))
                if !is_scalar_type(text(field(parameter, "type"))) { return err("dynamic backend: function '" + name + "' has an unsupported parameter type") }
                parameter_index = parameter_index + 1
            }
            let created: LabelState = new_label(current)
            let env: CompileEnv = CompileEnv{ slots: created.state.env.slots, static_values: created.state.env.static_values, function_labels: map_insert(created.state.env.function_labels, name, created.label), function_returns: map_insert(created.state.env.function_returns, name, return_type), next_slot: created.state.env.next_slot, breaks: created.state.env.breaks, continues: created.state.env.continues, end_label: created.state.env.end_label, trap_label: created.state.env.trap_label, buffer_offset: created.state.env.buffer_offset, in_function: created.state.env.in_function, current_function: created.state.env.current_function }
            current = state_with_env(created.state, env)
        }
        index = index + 1
    }
    return ok(current)
}

fn emit_function_bodies(state: EmitState, functions: Json, index: Int, base_env: CompileEnv) -> Result[EmitState, String] {
    let count: Int = result_unwrap(json_array_len(functions))
    if index >= count { return ok(state_with_env(state, base_env)) }
    let function: Json = result_unwrap(json_array_get(functions, index))
    let name: String = text(field(function, "name"))
    if name == "main" {
        return emit_function_bodies(state, functions, index + 1, base_env)
    }
    let label: Int = unwrap_or(map_get(base_env.function_labels, name), -1)
    let bound: Result[EmitState, String] = bind_label(state, label)
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind function label")) }
    let parameters: Json = field(function, "params")
    let parameter_count: Int = result_unwrap(json_array_len(parameters))
    let locals: Result[Int, String] = count_function_slots(field(function, "body"))
    if is_err(locals) { return err(unwrap_or(result_error(locals), "dynamic backend: function local scan failed")) }
    let next_slot: Int = parameter_count * 8 + result_unwrap(locals) * 8
    let buffer_offset: Int = next_slot + 1
    let function_env: CompileEnv = CompileEnv{ slots: parameter_slots(parameters), static_values: {}, function_labels: base_env.function_labels, function_returns: base_env.function_returns, next_slot: parameter_count * 8, breaks: [], continues: [], end_label: base_env.end_label, trap_label: base_env.trap_label, buffer_offset: buffer_offset, in_function: true, current_function: name }
    let framed: EmitState = emit_function_frame(state_with_env(result_unwrap(bound), function_env), align_frame(buffer_offset + 63))
    let mut stored: Result[EmitState, String] = ok(framed)
    let mut parameter_index: Int = 0
    while parameter_index < parameter_count {
        let parameter: Json = result_unwrap(json_array_get(parameters, parameter_index))
        let slot: Int = unwrap_or(map_get(function_env.slots, text(field(parameter, "name"))), -1)
        let next: Result[EmitState, String] = emit_store_arg(result_unwrap(stored), parameter_index, slot)
        if is_err(next) { return err(unwrap_or(result_error(next), "dynamic backend: parameter storage failed")) }
        stored = next
        parameter_index = parameter_index + 1
    }
    let body: Result[EmitState, String] = compile_statements(result_unwrap(stored), field(function, "body"))
    if is_err(body) { return err(compile_error(body)) }
    let returned: EmitState = append_code(result_unwrap(body), [u8(201), u8(195)])
    return emit_function_bodies(returned, functions, index + 1, base_env)
}

fn compile_dynamic(document: Json) -> Result[Bytes, String] {
    let target: Json = field(document, "target")
    if text(field(target, "os")) != "linux" || text(field(target, "arch")) != "amd64" { return err("dynamic backend supports only linux-amd64") }
    let functions: Json = field(document, "functions")
    let statements: Json = entry_statements(document)
    let mut state: EmitState = emit_prologue(new_dynamic_state())
    let end_label: LabelState = new_label(state)
    let trap_label: LabelState = new_label(end_label.state)
    let string_concat_label: LabelState = new_label(trap_label.state)
    let array_alloc_label: LabelState = new_label(string_concat_label.state)
    let array_push_label: LabelState = new_label(array_alloc_label.state)
    let array_concat_label: LabelState = new_label(array_push_label.state)
    let box_alloc_label: LabelState = new_label(array_concat_label.state)
    let slot_count: Int = count_slots(statements)
    state = state_with_string_concat_label(box_alloc_label.state, string_concat_label.label)
    state = state_with_array_labels(state, array_alloc_label.label, array_push_label.label, array_concat_label.label)
    state = state_with_box_label(state, box_alloc_label.label)
    state = state_with_env(state, CompileEnv{ slots: {}, static_values: {}, function_labels: {}, function_returns: {}, next_slot: 0, breaks: [], continues: [], end_label: end_label.label, trap_label: trap_label.label, buffer_offset: slot_count * 8 + 1, in_function: false, current_function: "" })
    let prepared: Result[EmitState, String] = prepare_function_labels(state, functions)
    if is_err(prepared) { return err(unwrap_or(result_error(prepared), "dynamic backend: function preparation failed")) }
    state = result_unwrap(prepared)
    let compiled: Result[EmitState, String] = compile_statements(state, statements)
    if is_err(compiled) { return err(compile_error(compiled)) }
    let main_state: EmitState = result_unwrap(compiled)
    let mut lowered: EmitState = main_state
    let function_count: Int = result_unwrap(json_array_len(functions))
    if function_count > 0 || main_state.assembler.string_concat_used || main_state.assembler.array_runtime_used || main_state.assembler.box_runtime_used {
        lowered = emit_jump(lowered, end_label.label, false, u8(0))
        let emitted: Result[EmitState, String] = emit_function_bodies(lowered, functions, 0, main_state.env)
        if is_err(emitted) { return err(unwrap_or(result_error(emitted), "dynamic backend: function lowering failed")) }
        lowered = result_unwrap(emitted)
    }
    if lowered.assembler.string_concat_used {
        let runtime: Result[EmitState, String] = emit_string_concat_runtime(lowered)
        if is_err(runtime) { return err(unwrap_or(result_error(runtime), "dynamic backend: String runtime lowering failed")) }
        lowered = result_unwrap(runtime)
    }
    if lowered.assembler.array_runtime_used {
        let allocator: Result[EmitState, String] = emit_array_alloc_runtime(lowered)
        if is_err(allocator) { return err(unwrap_or(result_error(allocator), "dynamic backend: Array allocator lowering failed")) }
        let pushed: Result[EmitState, String] = emit_array_push_runtime(result_unwrap(allocator))
        if is_err(pushed) { return err(unwrap_or(result_error(pushed), "dynamic backend: Array push lowering failed")) }
        let concatenated: Result[EmitState, String] = emit_array_concat_runtime(result_unwrap(pushed))
        if is_err(concatenated) { return err(unwrap_or(result_error(concatenated), "dynamic backend: Array concat lowering failed")) }
        lowered = result_unwrap(concatenated)
    }
    if lowered.assembler.box_runtime_used {
        let boxed: Result[EmitState, String] = emit_box_alloc_runtime(lowered)
        if is_err(boxed) { return err(unwrap_or(result_error(boxed), "dynamic backend: Option/Result runtime lowering failed")) }
        lowered = result_unwrap(boxed)
    }
    let ended: Result[EmitState, String] = bind_label(lowered, end_label.label)
    if is_err(ended) { return err(unwrap_or(result_error(ended), "dynamic backend: cannot bind end")) }
    let normal: EmitState = emit_exit(result_unwrap(ended), u8(0))
    let trapped: Result[EmitState, String] = bind_label(normal, trap_label.label)
    if is_err(trapped) { return err(unwrap_or(result_error(trapped), "dynamic backend: cannot bind trap")) }
    let failed: EmitState = emit_exit(result_unwrap(trapped), u8(1))
    let frame: Result[EmitState, String] = patch_code(failed, failed.assembler.frame_patch, i32_bytes(align_frame(failed.env.buffer_offset + 63)))
    if is_err(frame) { return err(unwrap_or(result_error(frame), "dynamic backend: frame patch failed")) }
    let jumps: Result[EmitState, String] = finalize_jumps(result_unwrap(frame))
    if is_err(jumps) { return err(unwrap_or(result_error(jumps), "dynamic backend: jump finalization failed")) }
    let data: Result[EmitState, String] = finalize_data(result_unwrap(jumps))
    if is_err(data) { return err(unwrap_or(result_error(data), "dynamic backend: data finalization failed")) }
    let result: EmitState = result_unwrap(data)
    return ok(emit_dynamic_elf(result.assembler.code, result.assembler.data))
}

fn has_dynamic_expression(expression: Json) -> Bool {
    let kind: String = text(field(expression, "kind"))
    if kind == "array" || kind == "index" { return true }
    if kind == "call" {
        let target: String = text(field(expression, "call_target"))
        if target == "builtin:len" || target == "builtin:array_push" || target == "builtin:array_get" || target == "builtin:array_concat" || target == "builtin:some" || target == "builtin:none" || target == "builtin:ok" || target == "builtin:err" || target == "builtin:is_some" || target == "builtin:is_none" || target == "builtin:is_ok" || target == "builtin:is_err" || target == "builtin:unwrap_or" || target == "builtin:result_unwrap" || target == "builtin:result_error" {
            return true
        }
        let arguments: Json = field(expression, "args")
        let count: Int = result_unwrap(json_array_len(arguments))
        let mut index: Int = 0
        while index < count {
            if has_dynamic_expression(result_unwrap(json_array_get(arguments, index))) { return true }
            index = index + 1
        }
        return false
    }
    if kind == "binary" {
        return has_dynamic_expression(field(expression, "left")) || has_dynamic_expression(field(expression, "right"))
    }
    if kind == "unary" { return has_dynamic_expression(field(expression, "operand")) }
    return false
}

fn has_dynamic(statements: Json) -> Bool {
    let count: Int = result_unwrap(json_array_len(statements))
    let mut index: Int = 0
    while index < count {
        let statement: Json = result_unwrap(json_array_get(statements, index))
        let kind: String = text(field(statement, "kind"))
        if kind == "if" || kind == "while" || kind == "assign" || kind == "break" || kind == "continue" { return true }
        if kind == "let" || kind == "const" {
            if result_unwrap(json_bool(field(statement, "mutable"))) { return true }
            if has_dynamic_expression(field(statement, "init")) { return true }
        }
        if kind == "expr" && has_dynamic_expression(field(statement, "expr")) { return true }
        index = index + 1
    }
    return false
}

pub fn compile_document(document: Json) -> Result[Bytes, String] {
    if result_unwrap(json_array_len(field(document, "functions"))) > 0 { return compile_dynamic(document) }
    if has_dynamic(field(document, "statements")) { return compile_dynamic(document) }
    return compile_kir(document)
}
