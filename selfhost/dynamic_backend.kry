fn emit_push_rax(state: EmitState) -> EmitState {
    let depth: Int = state.assembler.common.windows_stack_depth
    let pushed: EmitState = append_code(state, [u8(80)])
    if !state.assembler.common.windows_abi { return pushed }
    return state_with_windows_stack_depth(pushed, depth + 8)
}

fn emit_pop_rax(state: EmitState) -> Result[EmitState, String] {
    if state.assembler.common.windows_abi && state.assembler.common.windows_stack_depth < 8 {
        return err("dynamic backend: Win64 temporary stack underflow")
    }
    let popped: EmitState = append_code(state, [u8(88)])
    if !state.assembler.common.windows_abi { return ok(popped) }
    return ok(state_with_windows_stack_depth(popped, state.assembler.common.windows_stack_depth - 8))
}

