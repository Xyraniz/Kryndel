fn state_with_code_chunks(state: EmitState, chunks: Array[Array[UInt8]], length: Int) -> EmitState {
    let mut code: Array[UInt8] = state.assembler.code
    if len(chunks) == 0 { code = [] }
    return EmitState{
        assembler: Assembler{ code: code, code_chunks: chunks, code_length: length, data: state.assembler.data, data_by_text: state.assembler.data_by_text, string_data_by_text: state.assembler.string_data_by_text, labels: state.assembler.labels, jumps: state.assembler.jumps, data_patches: state.assembler.data_patches, frame_patch: state.assembler.frame_patch, string_concat_label: state.assembler.string_concat_label, string_concat_used: state.assembler.string_concat_used, array_alloc_label: state.assembler.array_alloc_label, array_push_label: state.assembler.array_push_label, array_concat_label: state.assembler.array_concat_label, array_runtime_used: state.assembler.array_runtime_used, box_alloc_label: state.assembler.box_alloc_label, box_runtime_used: state.assembler.box_runtime_used, host_runtime_used: state.assembler.host_runtime_used, windows_abi: state.assembler.windows_abi, windows_stack_depth: state.assembler.windows_stack_depth, import_patches: state.assembler.import_patches, function_ranges: state.assembler.function_ranges },
        env: state.env,
        code_patches: state.code_patches,
        code_pages: state.code_pages,
    }
}

fn append_code(state: EmitState, bytes: Array[UInt8]) -> EmitState {
    if len(bytes) == 0 { return state }
    let mut chunks: Array[Array[UInt8]] = state.assembler.code_chunks
    let mut length: Int = state.assembler.code_length
    if len(chunks) == 0 && len(state.assembler.code) > 0 {
        chunks = [state.assembler.code]
        length = len(state.assembler.code)
    }
    let chunk_count: Int = len(chunks)
    if chunk_count == 0 {
        return state_with_code_chunks(state, [bytes], length + len(bytes))
    }
    let last_index: Int = chunk_count - 1
    let last: Array[UInt8] = unwrap_or(array_get(chunks, last_index), [])
    if len(last) + len(bytes) <= 256 {
        let combined: Array[UInt8] = array_concat(last, bytes)
        let updated: Result[Array[Array[UInt8]], String] = array_set(chunks, last_index, combined)
        if is_ok(updated) { return state_with_code_chunks(state, result_unwrap(updated), length + len(bytes)) }
    }
    return state_with_code_chunks(state, array_push(chunks, bytes), length + len(bytes))
}

fn materialize_code(state: EmitState) -> EmitState {
    if len(state.assembler.code_chunks) == 0 { return state }
    let mut code: Array[UInt8] = []
    let mut batch: Array[UInt8] = []
    for chunk in state.assembler.code_chunks {
        if len(batch) > 0 && len(batch) + len(chunk) > 65536 {
            code = array_concat(code, batch)
            batch = []
        }
        batch = array_concat(batch, chunk)
    }
    code = array_concat(code, batch)
    return state_with_code(state, code)
}

fn prepare_code_pages(state: EmitState) -> Result[EmitState, String] {
    let flattened: EmitState = materialize_code(state)
    let code: Array[UInt8] = flattened.assembler.code
    let code_length: Int = len(code)
    let chunk_count: Int = (code_length + 255) / 256
    let mut pages: Array[Array[Array[UInt8]]] = []
    let mut page: Array[Array[UInt8]] = []
    let mut index: Int = 0
    while index < chunk_count {
        let start: Int = index * 256
        let remaining: Int = code_length - start
        let mut chunk_length: Int = 256
        if remaining < chunk_length { chunk_length = remaining }
        let chunk: Array[UInt8] = array_slice(code, start, chunk_length)
        page = array_push(page, chunk)
        if len(page) == 128 || index + 1 == chunk_count {
            pages = array_push(pages, page)
            page = []
        }
        index = index + 1
    }
    let empty_chunks: Array[Array[UInt8]] = []
    let cleared: EmitState = state_with_code_chunks(flattened, empty_chunks, code_length)
    return ok(EmitState{
        assembler: cleared.assembler,
        env: cleared.env,
        code_patches: cleared.code_patches,
        code_pages: ChunkedCode{ pages: pages, chunk_count: chunk_count, length: code_length },
    })
}

fn flatten_code_pages(state: EmitState) -> EmitState {
    let mut code: Array[UInt8] = []
    let mut batch: Array[UInt8] = []
    for page in state.code_pages.pages {
        for chunk in page {
            if len(batch) > 0 && len(batch) + len(chunk) > 65536 {
                code = array_concat(code, batch)
                batch = []
            }
            batch = array_concat(batch, chunk)
        }
    }
    code = array_concat(code, batch)
    let flattened: EmitState = state_with_code(state, code)
    return EmitState{
        assembler: flattened.assembler,
        env: flattened.env,
        code_patches: ChunkedCodePatches{ pages: [], length: 0 },
        code_pages: ChunkedCode{ pages: [], chunk_count: 0, length: 0 },
    }
}

fn chunked_int_get(values: ChunkedInts, index: Int) -> Int {
    if index < 0 || index >= values.length { return -1 }
    let page_index: Int = index / 16384
    let chunk_index: Int = (index / 128) % 128
    let item_index: Int = index % 128
    let page: Array[Array[Int]] = unwrap_or(array_get(values.pages, page_index), [])
    let chunk: Array[Int] = unwrap_or(array_get(page, chunk_index), [])
    return unwrap_or(array_get(chunk, item_index), -1)
}

fn chunked_int_set(values: ChunkedInts, index: Int, value: Int) -> Result[ChunkedInts, String] {
    if index < 0 || index >= values.length { return err("dynamic backend: chunked label index is out of range") }
    let page_index: Int = index / 16384
    let chunk_index: Int = (index / 128) % 128
    let item_index: Int = index % 128
    let page: Array[Array[Int]] = unwrap_or(array_get(values.pages, page_index), [])
    let chunk: Array[Int] = unwrap_or(array_get(page, chunk_index), [])
    let updated_chunk: Result[Array[Int], String] = array_set(chunk, item_index, value)
    if is_err(updated_chunk) { return err(unwrap_or(result_error(updated_chunk), "dynamic backend: cannot update label chunk")) }
    let updated_page: Result[Array[Array[Int]], String] = array_set(page, chunk_index, result_unwrap(updated_chunk))
    if is_err(updated_page) { return err(unwrap_or(result_error(updated_page), "dynamic backend: cannot update label page")) }
    let updated_pages: Result[Array[Array[Array[Int]]], String] = array_set(values.pages, page_index, result_unwrap(updated_page))
    if is_err(updated_pages) { return err(unwrap_or(result_error(updated_pages), "dynamic backend: cannot update label pages")) }
    return ok(ChunkedInts{ pages: result_unwrap(updated_pages), length: values.length })
}

fn chunked_int_push(values: ChunkedInts, value: Int) -> ChunkedInts {
    if values.length == 0 {
        let chunk: Array[Int] = [value]
        let page: Array[Array[Int]] = [chunk]
        return ChunkedInts{ pages: [page], length: 1 }
    }
    let page_index: Int = (values.length - 1) / 16384
    let chunk_index: Int = ((values.length - 1) / 128) % 128
    let page: Array[Array[Int]] = unwrap_or(array_get(values.pages, page_index), [])
    if values.length % 128 == 0 {
        let chunk: Array[Int] = [value]
        if values.length % 16384 == 0 {
            let new_page: Array[Array[Int]] = [chunk]
            return ChunkedInts{ pages: array_push(values.pages, new_page), length: values.length + 1 }
        }
        let new_page: Array[Array[Int]] = array_push(page, chunk)
        let pages: Result[Array[Array[Array[Int]]], String] = array_set(values.pages, page_index, new_page)
        return ChunkedInts{ pages: result_unwrap(pages), length: values.length + 1 }
    }
    let last_chunk: Array[Int] = unwrap_or(array_get(page, chunk_index), [])
    let new_chunk: Array[Int] = array_push(last_chunk, value)
    let updated_page: Result[Array[Array[Int]], String] = array_set(page, chunk_index, new_chunk)
    let pages: Result[Array[Array[Array[Int]]], String] = array_set(values.pages, page_index, result_unwrap(updated_page))
    return ChunkedInts{ pages: result_unwrap(pages), length: values.length + 1 }
}

fn chunked_jump_get(values: ChunkedJumpPatches, index: Int) -> Option[JumpPatch] {
    if index < 0 || index >= values.length { return none() }
    let page_index: Int = index / 16384
    let chunk_index: Int = (index / 128) % 128
    let item_index: Int = index % 128
    let page: Array[Array[JumpPatch]] = unwrap_or(array_get(values.pages, page_index), [])
    let chunk: Array[JumpPatch] = unwrap_or(array_get(page, chunk_index), [])
    return array_get(chunk, item_index)
}

