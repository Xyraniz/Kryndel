        u8(65), u8(84), u8(65), u8(85), u8(65), u8(86), u8(65), u8(87), u8(83), u8(85),
        u8(73), u8(137), u8(252), u8(73), u8(141), u8(124), u8(36), u8(8), u8(73), u8(139), u8(52), u8(36)
    ])
    current = emit_label_call(current, host_string_alloc_label(current))
    current = append_code(current, [
        u8(73), u8(137), u8(197), u8(73), u8(139), u8(77), u8(0), u8(76), u8(1), u8(233), u8(198), u8(65), u8(8), u8(0),
        u8(72), u8(129), u8(236), u8(144), u8(0), u8(0), u8(0), u8(73), u8(141), u8(125), u8(8),
        u8(190), u8(0), u8(0), u8(2), u8(0), u8(72), u8(49), u8(210), u8(184), u8(2), u8(0), u8(0), u8(0), u8(15), u8(5), u8(72), u8(133), u8(192)
    ])
    let open_fail: LabelState = new_label(current)
    let close_fail: LabelState = new_label(open_fail.state)
    let error_label: LabelState = new_label(close_fail.state)
    current = emit_jump(error_label.state, open_fail.label, true, u8(136))
    current = append_code(current, [
        u8(73), u8(137), u8(198), u8(76), u8(137), u8(247), u8(72), u8(137), u8(230), u8(184), u8(5), u8(0), u8(0), u8(0), u8(15), u8(5), u8(72), u8(133), u8(192)
    ])
    current = emit_jump(current, close_fail.label, true, u8(136))
    current = append_code(current, [u8(76), u8(139), u8(124), u8(36), u8(48), u8(77), u8(133), u8(255)])
    let non_zero: LabelState = new_label(current)
    let alloc_size: LabelState = new_label(non_zero.state)
    current = emit_jump(alloc_size.state, non_zero.label, true, u8(133))
    current = emit_int(current, 1)
    current = emit_jump(current, alloc_size.label, false, u8(0))
    let bound_non_zero: Result[EmitState, String] = bind_label(current, non_zero.label)
    if is_err(bound_non_zero) { return err(unwrap_or(result_error(bound_non_zero), "dynamic backend: cannot bind fs_read_text size path")) }
    current = append_code(result_unwrap(bound_non_zero), [u8(76), u8(137), u8(248)])
    let bound_alloc: Result[EmitState, String] = bind_label(current, alloc_size.label)
    if is_err(bound_alloc) { return err(unwrap_or(result_error(bound_alloc), "dynamic backend: cannot bind fs_read_text allocation")) }
    current = append_code(result_unwrap(bound_alloc), [
        u8(72), u8(137), u8(198), u8(72), u8(49), u8(255), u8(186), u8(3), u8(0), u8(0), u8(0), u8(65), u8(186), u8(34), u8(0), u8(0), u8(0), u8(65), u8(184), u8(255), u8(255), u8(255), u8(255), u8(69), u8(49), u8(201), u8(184), u8(9), u8(0), u8(0), u8(0), u8(15), u8(5), u8(72), u8(133), u8(192)
    ])
    current = emit_jump(current, close_fail.label, true, u8(136))
    current = append_code(current, [u8(72), u8(137), u8(195), u8(72), u8(49), u8(237)])
    let read_loop: LabelState = new_label(current)
    let read_done: LabelState = new_label(read_loop.state)
    let bound_read: Result[EmitState, String] = bind_label(read_done.state, read_loop.label)
    if is_err(bound_read) { return err(unwrap_or(result_error(bound_read), "dynamic backend: cannot bind fs_read_text loop")) }
    current = append_code(result_unwrap(bound_read), [u8(76), u8(57), u8(253)])
    current = emit_jump(current, read_done.label, true, u8(131))
    current = append_code(current, [u8(76), u8(137), u8(247), u8(72), u8(141), u8(52), u8(43), u8(76), u8(137), u8(250), u8(72), u8(41), u8(234), u8(49), u8(192), u8(15), u8(5), u8(72), u8(133), u8(192)])
    current = emit_jump(current, close_fail.label, true, u8(142))
    current = append_code(current, [u8(72), u8(1), u8(197)])
    current = emit_jump(current, read_loop.label, false, u8(0))
    let bound_read_done: Result[EmitState, String] = bind_label(current, read_done.label)
    if is_err(bound_read_done) { return err(unwrap_or(result_error(bound_read_done), "dynamic backend: cannot bind fs_read_text completion")) }
    current = append_code(result_unwrap(bound_read_done), [u8(76), u8(137), u8(247), u8(184), u8(3), u8(0), u8(0), u8(0), u8(15), u8(5), u8(72), u8(137), u8(223), u8(76), u8(137), u8(254)])
    current = emit_label_call(current, host_string_alloc_label(current))
    current = append_code(current, [u8(72), u8(129), u8(196), u8(144), u8(0), u8(0), u8(0), u8(93), u8(91), u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92)])
    current = emit_box_call(current, u64(0))
    let return_label: LabelState = new_label(current)
    current = emit_jump(return_label.state, return_label.label, false, u8(0))
    let bound_open: Result[EmitState, String] = bind_label(current, open_fail.label)
    if is_err(bound_open) { return err(unwrap_or(result_error(bound_open), "dynamic backend: cannot bind fs_read_text open failure")) }
    current = emit_jump(result_unwrap(bound_open), error_label.label, false, u8(0))
    let bound_close: Result[EmitState, String] = bind_label(current, close_fail.label)
    if is_err(bound_close) { return err(unwrap_or(result_error(bound_close), "dynamic backend: cannot bind fs_read_text close failure")) }
    current = append_code(result_unwrap(bound_close), [u8(76), u8(137), u8(247), u8(184), u8(3), u8(0), u8(0), u8(0), u8(15), u8(5)])
    current = emit_jump(current, error_label.label, false, u8(0))
    let bound_error: Result[EmitState, String] = bind_label(current, error_label.label)
    if is_err(bound_error) { return err(unwrap_or(result_error(bound_error), "dynamic backend: cannot bind fs_read_text error")) }
    current = append_code(result_unwrap(bound_error), [u8(72), u8(129), u8(196), u8(144), u8(0), u8(0), u8(0), u8(93), u8(91), u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92)])
    current = emit_string(current, "fs_read_text failed")
    current = emit_box_call(current, u64(1))
    let bound_return: Result[EmitState, String] = bind_label(current, return_label.label)
    if is_err(bound_return) { return err(unwrap_or(result_error(bound_return), "dynamic backend: cannot bind fs_read_text return")) }
    return ok(append_code(result_unwrap(bound_return), [u8(195)]))
}

fn emit_fs_write_bytes_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, host_fs_write_bytes_label(state))
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind fs_write_bytes runtime")) }
    let mut current: EmitState = append_code(result_unwrap(bound), [
        u8(65), u8(84), u8(65), u8(85), u8(65), u8(86), u8(65), u8(87), u8(83), u8(85),
        u8(73), u8(137), u8(252), u8(73), u8(137), u8(245), u8(73), u8(141), u8(124), u8(36), u8(8), u8(73), u8(139), u8(52), u8(36)
    ])
    current = emit_label_call(current, host_string_alloc_label(current))
    current = append_code(current, [
        u8(73), u8(137), u8(199), u8(73), u8(139), u8(79), u8(0), u8(76), u8(1), u8(249), u8(198), u8(65), u8(8), u8(0), u8(73), u8(141), u8(127), u8(8),
        u8(72), u8(199), u8(198), u8(65), u8(2), u8(0), u8(0), u8(186), u8(182), u8(1), u8(0), u8(0), u8(184), u8(2), u8(0), u8(0), u8(0), u8(15), u8(5), u8(72), u8(133), u8(192)
    ])
    let open_fail: LabelState = new_label(current)
    let close_fail: LabelState = new_label(open_fail.state)
    let error_label: LabelState = new_label(close_fail.state)
    current = emit_jump(error_label.state, open_fail.label, true, u8(136))
    current = append_code(current, [u8(73), u8(137), u8(198), u8(72), u8(49), u8(237)])
    let write_loop: LabelState = new_label(current)
    let write_done: LabelState = new_label(write_loop.state)
    let bound_loop: Result[EmitState, String] = bind_label(write_done.state, write_loop.label)
    if is_err(bound_loop) { return err(unwrap_or(result_error(bound_loop), "dynamic backend: cannot bind fs_write_bytes loop")) }
    current = append_code(result_unwrap(bound_loop), [u8(73), u8(59), u8(109), u8(0)])
    current = emit_jump(current, write_done.label, true, u8(131))
    current = append_code(current, [u8(76), u8(137), u8(247), u8(73), u8(141), u8(117), u8(8), u8(72), u8(1), u8(238), u8(73), u8(139), u8(85), u8(0), u8(72), u8(41), u8(234), u8(184), u8(1), u8(0), u8(0), u8(0), u8(15), u8(5), u8(72), u8(133), u8(192)])
    current = emit_jump(current, close_fail.label, true, u8(142))
    current = append_code(current, [u8(72), u8(1), u8(197)])
    current = emit_jump(current, write_loop.label, false, u8(0))
    let bound_done: Result[EmitState, String] = bind_label(current, write_done.label)
    if is_err(bound_done) { return err(unwrap_or(result_error(bound_done), "dynamic backend: cannot bind fs_write_bytes completion")) }
    current = append_code(result_unwrap(bound_done), [u8(76), u8(137), u8(247), u8(184), u8(3), u8(0), u8(0), u8(0), u8(15), u8(5), u8(93), u8(91), u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92)])
    current = emit_int(current, 0)
    current = emit_box_call(current, u64(0))
    let return_label: LabelState = new_label(current)
    current = emit_jump(return_label.state, return_label.label, false, u8(0))
    let bound_open: Result[EmitState, String] = bind_label(current, open_fail.label)
    if is_err(bound_open) { return err(unwrap_or(result_error(bound_open), "dynamic backend: cannot bind fs_write_bytes open failure")) }
    current = emit_jump(result_unwrap(bound_open), error_label.label, false, u8(0))
    let bound_close: Result[EmitState, String] = bind_label(current, close_fail.label)
    if is_err(bound_close) { return err(unwrap_or(result_error(bound_close), "dynamic backend: cannot bind fs_write_bytes close failure")) }
    current = append_code(result_unwrap(bound_close), [u8(76), u8(137), u8(247), u8(184), u8(3), u8(0), u8(0), u8(0), u8(15), u8(5)])
    current = emit_jump(current, error_label.label, false, u8(0))
    let bound_error: Result[EmitState, String] = bind_label(current, error_label.label)
    if is_err(bound_error) { return err(unwrap_or(result_error(bound_error), "dynamic backend: cannot bind fs_write_bytes error")) }
    current = append_code(result_unwrap(bound_error), [u8(93), u8(91), u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92)])
    current = emit_string(current, "fs_write_bytes failed")
    current = emit_box_call(current, u64(1))
    let bound_return: Result[EmitState, String] = bind_label(current, return_label.label)
    if is_err(bound_return) { return err(unwrap_or(result_error(bound_return), "dynamic backend: cannot bind fs_write_bytes return")) }
    return ok(append_code(result_unwrap(bound_return), [u8(195)]))
}

fn emit_integer(state: EmitState, unsigned: Bool) -> Result[EmitState, String] {
    let mut current: EmitState = append_code(state, array_concat([u8(76), u8(141), u8(133)], i32_bytes(0 - state.env.buffer_offset)))
    current = append_code(current, array_concat([u8(73), u8(185)], dyn_u64_bytes(u64(10))))
    let zero_label: LabelState = new_label(current)
    let digits_label: LabelState = new_label(zero_label.state)
    let sign_label: LabelState = new_label(digits_label.state)
    let ready_label: LabelState = new_label(sign_label.state)
    current = append_code(ready_label.state, [u8(69), u8(49), u8(210), u8(72), u8(133), u8(192)])
    current = emit_jump(current, zero_label.label, true, u8(132))
    if !unsigned {
        current = emit_jump(current, digits_label.label, true, u8(137))
        current = append_code(current, [u8(65), u8(178), u8(1), u8(72), u8(247), u8(216)])
        // MinInt remains a valid unsigned magnitude for decimal division;
        // trapping after negation would reject a valid Int display value.
    }
    let bound_digits: Result[EmitState, String] = bind_label(current, digits_label.label)
    if is_err(bound_digits) { return err(unwrap_or(result_error(bound_digits), "dynamic backend: cannot bind integer digits")) }
    current = result_unwrap(bound_digits)
    let loop_label: LabelState = new_label(current)
    let bound_loop: Result[EmitState, String] = bind_label(loop_label.state, loop_label.label)
    if is_err(bound_loop) { return err(unwrap_or(result_error(bound_loop), "dynamic backend: cannot bind integer loop")) }
    current = append_code(result_unwrap(bound_loop), [u8(72), u8(49), u8(210), u8(73), u8(247), u8(241), u8(128), u8(194), u8(48), u8(73), u8(255), u8(200), u8(65), u8(136), u8(16), u8(72), u8(133), u8(192)])
    current = emit_jump(current, loop_label.label, true, u8(133))
    current = emit_jump(current, sign_label.label, false, u8(0))
    let bound_zero: Result[EmitState, String] = bind_label(current, zero_label.label)
    if is_err(bound_zero) { return err(unwrap_or(result_error(bound_zero), "dynamic backend: cannot bind integer zero")) }
    current = append_code(result_unwrap(bound_zero), [u8(73), u8(255), u8(200), u8(65), u8(198), u8(0), u8(48)])
    current = emit_jump(current, sign_label.label, false, u8(0))
    let bound_sign: Result[EmitState, String] = bind_label(current, sign_label.label)
    if is_err(bound_sign) { return err(unwrap_or(result_error(bound_sign), "dynamic backend: cannot bind integer sign")) }
    current = result_unwrap(bound_sign)
    if !unsigned {
        current = append_code(current, [u8(69), u8(132), u8(210)])
        current = emit_jump(current, ready_label.label, true, u8(132))
        current = append_code(current, [u8(73), u8(255), u8(200), u8(65), u8(198), u8(0), u8(45)])
    }
    let bound_ready: Result[EmitState, String] = bind_label(current, ready_label.label)
    if is_err(bound_ready) { return err(unwrap_or(result_error(bound_ready), "dynamic backend: cannot bind integer output")) }
    if state.assembler.windows_abi {
        current = append_code(result_unwrap(bound_ready), [u8(76), u8(137), u8(194), u8(76), u8(141), u8(133)])
        current = append_code(current, i32_bytes(0 - state.env.buffer_offset))
        current = append_code(current, [u8(73), u8(41), u8(208)])
        return emit_windows_write(current)
    }
    current = append_code(result_unwrap(bound_ready), [u8(184), u8(1), u8(0), u8(0), u8(0), u8(191), u8(1), u8(0), u8(0), u8(0), u8(76), u8(137), u8(198), u8(72), u8(141), u8(149)])
    current = append_code(current, i32_bytes(0 - state.env.buffer_offset))
    current = append_code(current, [u8(72), u8(41), u8(242), u8(15), u8(5)])
    return ok(current)
}

fn expr_type(expression: Json) -> String {
    return text(field(expression, "type"))
}

fn is_unsigned(type_name: String) -> Bool {
    return starts_with(type_name, "UInt")
}

fn uint_bits(type_name: String) -> Int {
    if type_name == "UInt8" { return 8 }
    if type_name == "UInt16" { return 16 }
    if type_name == "UInt32" { return 32 }
    if type_name == "UInt64" { return 64 }
    return 0
}

fn setcc(operator: String, unsigned: Bool) -> UInt8 {
    if operator == "==" { return u8(148) }
    if operator == "!=" { return u8(149) }
    if operator == "<" {
        if unsigned { return u8(146) }
        return u8(156)
    }
    if operator == "<=" {
        if unsigned { return u8(150) }
        return u8(158)
    }
    if operator == ">" {
        if unsigned { return u8(151) }
        return u8(159)
    }
    if unsigned { return u8(147) }
    return u8(157)
}

fn expression_error(value: Result[EmitState, String]) -> String {
    return "dynamic backend: expression lowering failed: " + unwrap_or(result_error(value), "unknown error")
}

fn struct_field_list(env: CompileEnv, type_name: String) -> Json {
    return unwrap_or(map_get(env.struct_fields, type_name), result_unwrap(json_parse("[]")))
}

fn struct_field_index(env: CompileEnv, type_name: String, field_name: String) -> Int {
    let fields: Json = struct_field_list(env, type_name)
    let count: Int = result_unwrap(json_array_len(fields))
    let mut index: Int = 0
    while index < count {
        let candidate: Json = result_unwrap(json_array_get(fields, index))
        if text(field(candidate, "name")) == field_name { return index }
        index = index + 1
    }
    return -1
}

fn is_supported_type(env: CompileEnv, type_name: String) -> Bool {
    return is_scalar_type(type_name) || map_contains_key(env.struct_fields, type_name)
}

fn is_enum_type(type_fields: Map[String, Json], type_name: String) -> Bool {
    let variants: Option[Json] = map_get(type_fields, type_name)
    if is_none(variants) { return false }
    let values: Json = unwrap_or(variants, result_unwrap(json_parse("[]")))
    if result_unwrap(json_array_len(values)) == 0 { return false }
    return json_kind(result_unwrap(json_array_get(values, 0))) == "string"
}

fn emit_function_call(state: EmitState, expression: Json) -> Result[EmitState, String] {
    let arguments: Json = field(expression, "args")
    let count_result: Result[Int, String] = json_array_len(arguments)
    if is_err(count_result) { return err("dynamic backend: function argument list is not an array: " + unwrap_or(result_error(count_result), "unknown error")) }
    let count: Int = result_unwrap(count_result)
    if !state.assembler.windows_abi && count > 6 { return err("dynamic backend: at most six scalar arguments are supported") }
    let mut index: Int = 0
    let mut current: EmitState = state
    while index < count {
        let argument: Json = result_unwrap(json_array_get(arguments, index))
        let emitted: Result[EmitState, String] = emit_expression(current, argument)
        if is_err(emitted) { return err(expression_error(emitted)) }
        current = emit_push_rax(result_unwrap(emitted))
        index = index + 1
    }
    if state.assembler.windows_abi {
        return emit_windows_function_call(current, text(field(expression, "name")), count)
    }
    let mut reverse: Int = count - 1
    while reverse >= 0 {
        let popped: Result[EmitState, String] = emit_pop_arg(current, reverse)
        if is_err(popped) { return err(unwrap_or(result_error(popped), "dynamic backend: argument register failed")) }
        current = result_unwrap(popped)
        reverse = reverse - 1
    }
    return emit_call(current, text(field(expression, "name")))
}

fn emit_windows_rsp_load_rax(state: EmitState, offset: Int) -> EmitState {
    return append_code(state, array_concat([u8(72), u8(139), u8(132), u8(36)], i32_bytes(offset)))
}

fn emit_windows_rsp_store_rax(state: EmitState, offset: Int) -> EmitState {
    return append_code(state, array_concat([u8(72), u8(137), u8(132), u8(36)], i32_bytes(offset)))
}

fn emit_windows_rsp_load_argument(state: EmitState, index: Int, offset: Int) -> Result[EmitState, String] {
    let mut instruction: Array[UInt8] = []
    if index == 0 { instruction = [u8(72), u8(139), u8(140), u8(36)] }
    else if index == 1 { instruction = [u8(72), u8(139), u8(148), u8(36)] }
    else if index == 2 { instruction = [u8(76), u8(139), u8(132), u8(36)] }
    else if index == 3 { instruction = [u8(76), u8(139), u8(140), u8(36)] }
    else { return err("dynamic backend: Win64 register argument index must be between zero and three") }
    return ok(append_code(state, array_concat(instruction, i32_bytes(offset))))
}

fn emit_windows_function_call(state: EmitState, name: String, count: Int) -> Result[EmitState, String] {
    let label: Option[Int] = map_get(state.env.function_labels, name)
    if is_none(label) { return err("dynamic backend: unknown function '" + name + "'") }
    let staged_bytes: Int = count * 8
    if state.assembler.windows_stack_depth < staged_bytes { return err("dynamic backend: Win64 argument stack underflow") }

    let mut stack_argument_count: Int = count - 4
    if stack_argument_count < 0 { stack_argument_count = 0 }
    let outgoing_bytes: Int = 32 + stack_argument_count * 8
    let alignment: Int = (state.assembler.windows_stack_depth + outgoing_bytes) % 16
    let mut adjustment: Int = outgoing_bytes
    if alignment != 0 { adjustment = adjustment + (16 - alignment) }
    let mut current: EmitState = emit_windows_stack_adjust(state, true, adjustment)

    // The fifth and later arguments are placed after the 32-byte shadow area.
    // Their staged source values remain above the reserved outgoing area.
    let mut index: Int = 4
    while index < count {
        let stack_source_offset: Int = adjustment + (count - index - 1) * 8
        current = emit_windows_rsp_load_rax(current, stack_source_offset)
        current = emit_windows_rsp_store_rax(current, 32 + (index - 4) * 8)
        index = index + 1
    }

    index = 0
    while index < count && index < 4 {
        let register_source_offset: Int = adjustment + (count - index - 1) * 8
        let loaded: Result[EmitState, String] = emit_windows_rsp_load_argument(current, index, register_source_offset)
        if is_err(loaded) { return err(unwrap_or(result_error(loaded), "dynamic backend: Win64 register argument load failed")) }
        current = result_unwrap(loaded)
        index = index + 1
    }

    current = emit_relative_call(current, unwrap_or(label, -1))
    current = emit_windows_stack_adjust(current, false, adjustment + staged_bytes)
    current = state_with_windows_stack_depth(current, state.assembler.windows_stack_depth - staged_bytes)
    return ok(current)
}

fn emit_pop_arg(state: EmitState, index: Int) -> Result[EmitState, String] {
    if state.assembler.windows_abi {
        if state.assembler.windows_stack_depth < 8 { return err("dynamic backend: Win64 argument stack underflow") }
        let mut popped: EmitState = state
        if index == 0 { popped = append_code(state, [u8(89)]) }
        else if index == 1 { popped = append_code(state, [u8(90)]) }
        else if index == 2 { popped = append_code(state, [u8(65), u8(88)]) }
        else if index == 3 { popped = append_code(state, [u8(65), u8(89)]) }
        else { return err("dynamic backend: Win64 register argument index must be between zero and three") }
        return ok(state_with_windows_stack_depth(popped, state.assembler.windows_stack_depth - 8))
    }
    if index == 0 { return ok(append_code(state, [u8(95)])) }
    if index == 1 { return ok(append_code(state, [u8(94)])) }
    if index == 2 { return ok(append_code(state, [u8(90)])) }
    if index == 3 { return ok(append_code(state, [u8(89)])) }
    if index == 4 { return ok(append_code(state, [u8(65), u8(88)])) }
    if index == 5 { return ok(append_code(state, [u8(65), u8(89)])) }
    return err("dynamic backend: at most six scalar arguments are supported")
}

fn emit_assert_call(state: EmitState, expression: Json, equal: Bool) -> Result[EmitState, String] {
    let arguments: Json = field(expression, "args")
    let count: Int = result_unwrap(json_array_len(arguments))
    if equal {
        if count != 2 { return err("dynamic backend: assert_eq expects two arguments") }
        let left: Json = result_unwrap(json_array_get(arguments, 0))
        let right: Json = result_unwrap(json_array_get(arguments, 1))
        let type_name: String = expr_type(left)
        if type_name != expr_type(right) || (!is_enum_type(state.env.struct_fields, type_name) && type_name != "Int" && type_name != "Bool" && !starts_with(type_name, "UInt")) { return err("dynamic backend: assert_eq supports matching Int, UInt, Bool, or enum values") }
        let first: Result[EmitState, String] = emit_expression(state, left)
        if is_err(first) { return err(expression_error(first)) }
        let pushed: EmitState = emit_push_rax(result_unwrap(first))
        let second: Result[EmitState, String] = emit_expression(pushed, right)
        if is_err(second) { return err(expression_error(second)) }
        let moved: EmitState = append_code(result_unwrap(second), [u8(72), u8(137), u8(193)])
        let popped: Result[EmitState, String] = emit_pop_rax(moved)
        if is_err(popped) { return err(unwrap_or(result_error(popped), "dynamic backend: assert_eq stack restore failed")) }
        let compared: EmitState = append_code(result_unwrap(popped), [u8(72), u8(57), u8(200)])
        let failed: EmitState = emit_jump(compared, compared.env.trap_label, true, u8(133))
        return ok(emit_int(failed, 0))
    }
    if count != 1 || expr_type(result_unwrap(json_array_get(arguments, 0))) != "Bool" { return err("dynamic backend: assert expects one Bool argument") }
    let emitted: Result[EmitState, String] = emit_expression(state, result_unwrap(json_array_get(arguments, 0)))
    if is_err(emitted) { return err(expression_error(emitted)) }
    let tested: EmitState = append_code(result_unwrap(emitted), [u8(72), u8(133), u8(192)])
    let failed: EmitState = emit_jump(tested, tested.env.trap_label, true, u8(132))
    return ok(emit_int(failed, 0))
}

fn emit_string_predicate(state: EmitState, expression: Json, mode: String) -> Result[EmitState, String] {
    let arguments: Json = field(expression, "args")
    if result_unwrap(json_array_len(arguments)) != 2 { return err("dynamic backend: " + mode + " expects two String arguments") }
    let haystack: Json = result_unwrap(json_array_get(arguments, 0))
    let needle: Json = result_unwrap(json_array_get(arguments, 1))
    if expr_type(haystack) != "String" || expr_type(needle) != "String" { return err("dynamic backend: " + mode + " expects two String arguments") }
    let first: Result[EmitState, String] = emit_expression(state, haystack)
    if is_err(first) { return err(expression_error(first)) }
    let pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
    let second: Result[EmitState, String] = emit_expression(pushed, needle)
    if is_err(second) { return err(expression_error(second)) }
    let mut current: EmitState = append_code(result_unwrap(second), [
        u8(72), u8(137), u8(193), u8(88), u8(73), u8(137), u8(192), u8(73), u8(137), u8(201),
        u8(77), u8(139), u8(16), u8(77), u8(139), u8(25)
    ])
    let false_label: LabelState = new_label(current)
    let found_label: LabelState = new_label(false_label.state)
    let done_label: LabelState = new_label(found_label.state)
    if mode == "contains" || mode == "starts_with" || mode == "ends_with" {
        current = append_code(done_label.state, [u8(77), u8(57), u8(218)])
        current = emit_jump(current, false_label.label, true, u8(130))
    } else {
        current = done_label.state
    }
    if mode == "ends_with" {
        current = append_code(current, [u8(76), u8(137), u8(210), u8(76), u8(41), u8(218)])
    } else {
        current = append_code(current, [u8(72), u8(49), u8(210)])
    }
    let inner_label: LabelState = new_label(current)
    let mismatch_label: LabelState = new_label(inner_label.state)
    current = mismatch_label.state
    let mut outer_label: Int = inner_label.label
    if mode == "contains" {
        let created: LabelState = new_label(mismatch_label.state)
        outer_label = created.label
        current = created.state
        let bound_outer: Result[EmitState, String] = bind_label(current, outer_label)
        if is_err(bound_outer) { return err(unwrap_or(result_error(bound_outer), "dynamic backend: cannot bind string predicate outer loop")) }
        current = result_unwrap(bound_outer)
        current = append_code(current, [u8(76), u8(137), u8(208), u8(76), u8(41), u8(216), u8(72), u8(57), u8(194)])
        current = emit_jump(current, false_label.label, true, u8(135))
    }
    current = append_code(current, [u8(72), u8(49), u8(246)])
    let bound_inner: Result[EmitState, String] = bind_label(current, inner_label.label)
    if is_err(bound_inner) { return err(unwrap_or(result_error(bound_inner), "dynamic backend: cannot bind string predicate inner loop")) }
    current = append_code(result_unwrap(bound_inner), [u8(76), u8(57), u8(222)])
    current = emit_jump(current, found_label.label, true, u8(132))
    current = append_code(current, [
        u8(72), u8(137), u8(215), u8(72), u8(1), u8(247), u8(73), u8(15), u8(182), u8(68), u8(56), u8(8),
        u8(65), u8(15), u8(182), u8(76), u8(49), u8(8), u8(57), u8(200)
    ])
    current = emit_jump(current, mismatch_label.label, true, u8(133))
    current = append_code(current, [u8(72), u8(255), u8(198)])
    current = emit_jump(current, inner_label.label, false, u8(0))
    let bound_mismatch: Result[EmitState, String] = bind_label(current, mismatch_label.label)
    if is_err(bound_mismatch) { return err(unwrap_or(result_error(bound_mismatch), "dynamic backend: cannot bind string predicate mismatch")) }
    current = result_unwrap(bound_mismatch)
    if mode == "contains" {
        current = append_code(current, [u8(72), u8(255), u8(194)])
        current = emit_jump(current, outer_label, false, u8(0))
    } else {
        current = emit_jump(current, false_label.label, false, u8(0))
    }
    let bound_found: Result[EmitState, String] = bind_label(current, found_label.label)
    if is_err(bound_found) { return err(unwrap_or(result_error(bound_found), "dynamic backend: cannot bind string predicate found")) }
    current = emit_int(result_unwrap(bound_found), 1)
    current = emit_jump(current, done_label.label, false, u8(0))
    let bound_false: Result[EmitState, String] = bind_label(current, false_label.label)
    if is_err(bound_false) { return err(unwrap_or(result_error(bound_false), "dynamic backend: cannot bind string predicate false")) }
    current = emit_int(result_unwrap(bound_false), 0)
    let bound_done: Result[EmitState, String] = bind_label(current, done_label.label)
    if is_err(bound_done) { return err(unwrap_or(result_error(bound_done), "dynamic backend: cannot bind string predicate completion")) }
    return ok(result_unwrap(bound_done))
}

fn emit_logical_expression(state: EmitState, expression: Json, operator: String) -> Result[EmitState, String] {
    let decisive_label: LabelState = new_label(state)
    let done_label: LabelState = new_label(decisive_label.state)
    let left: Result[EmitState, String] = emit_expression(done_label.state, field(expression, "left"))
    if is_err(left) { return err(expression_error(left)) }
    let tested_left: EmitState = append_code(result_unwrap(left), [u8(72), u8(133), u8(192)])
    let mut short_condition: UInt8 = u8(132)
    if operator == "||" { short_condition = u8(133) }
    let branch: EmitState = emit_jump(tested_left, decisive_label.label, true, short_condition)
    let right: Result[EmitState, String] = emit_expression(branch, field(expression, "right"))
    if is_err(right) { return err(expression_error(right)) }
    let normalized: EmitState = append_code(result_unwrap(right), [u8(72), u8(133), u8(192), u8(15), u8(149), u8(192), u8(72), u8(15), u8(182), u8(192)])
    let skip_decisive: EmitState = emit_jump(normalized, done_label.label, false, u8(0))
    let bound_decisive: Result[EmitState, String] = bind_label(skip_decisive, decisive_label.label)
    if is_err(bound_decisive) { return err(unwrap_or(result_error(bound_decisive), "dynamic backend: cannot bind logical short-circuit path")) }
    let mut decisive_value: Int = 0
    if operator == "||" { decisive_value = 1 }
    let decisive: EmitState = emit_int(result_unwrap(bound_decisive), decisive_value)
    let bound_done: Result[EmitState, String] = bind_label(decisive, done_label.label)
    if is_err(bound_done) { return err(unwrap_or(result_error(bound_done), "dynamic backend: cannot bind logical expression completion")) }
    return ok(result_unwrap(bound_done))
}

fn emit_expression(state: EmitState, expression: Json) -> Result[EmitState, String] {
    let constant: Json = field(expression, "const")
    if json_kind(constant) == "object" {
        let constant_kind: String = text(field(constant, "kind"))
        if constant_kind == "int" { return ok(emit_int(state, result_unwrap(json_int(field(constant, "int"))))) }
        if constant_kind == "uint" {
            return ok(emit_uint(state, result_unwrap(json_uint(field(constant, "uint"))), result_unwrap(json_int(field(constant, "uint_bits")))))
        }
        if constant_kind == "bool" {
            if result_unwrap(json_bool(field(constant, "bool"))) { return ok(emit_int(state, 1)) }
            return ok(emit_int(state, 0))
        }
        if constant_kind == "string" {
            let value: String = text(field(constant, "string"))
            return ok(emit_string(state, value))
        }
    }
    let kind: String = text(field(expression, "kind"))
    if kind == "int" {
        return ok(emit_int(state, result_unwrap(json_int(field(expression, "int")))))
    }
    if kind == "uint" {
        return ok(emit_uint(state, result_unwrap(json_uint(field(expression, "uint"))), result_unwrap(json_int(field(expression, "uint_bits")))))
    }
    if kind == "string" {
        return ok(emit_string(state, text(field(expression, "string"))))
    }
    if kind == "enum" {
        let enum_name: String = text(field(expression, "enum_type"))
        let variant_name: String = text(field(expression, "enum_variant"))
        let variant: Int = enum_variant_index(state.env.struct_fields, enum_name, variant_name)
        if variant < 0 || expr_type(expression) != enum_name { return err("dynamic backend: unknown enum variant '" + enum_name + "::" + variant_name + "'") }
        return ok(emit_int(state, variant))
    }
    if kind == "struct" {
        return emit_struct_literal(state, expression)
    }
    if kind == "array" {
        return emit_array_literal(state, expression)
    }
    if kind == "map" {
        return emit_map_literal(state, expression)
    }
    if kind == "index" {
        return emit_array_index(state, expression)
    }
    if kind == "field" {
        return emit_struct_field(state, expression)
    }
    if kind == "call" {
        let target: String = text(field(expression, "call_target"))
        if starts_with(target, "function:") { return emit_function_call(state, expression) }
        let arguments: Json = field(expression, "args")
        if target == "builtin:assert" { return emit_assert_call(state, expression, false) }
        if target == "builtin:assert_eq" { return emit_assert_call(state, expression, true) }
        if target == "builtin:none" {
            if result_unwrap(json_array_len(arguments)) != 0 { return err("dynamic backend: none expects no arguments") }
            return ok(emit_int(state, 0))
        }
        if target == "builtin:process_args" {
            if result_unwrap(json_array_len(arguments)) != 0 { return err("dynamic backend: process_args expects no arguments") }
            let marked: EmitState = state_with_array_used(state_with_host_used(state))
            return ok(emit_label_call(marked, host_process_args_label(marked)))
        }
        if target == "builtin:int" {
            if result_unwrap(json_array_len(arguments)) != 1 { return err("dynamic backend: int expects one numeric, Bool, or String argument") }
            let integer_argument: Json = result_unwrap(json_array_get(arguments, 0))
            let type_name: String = expr_type(integer_argument)
            if type_name == "Int" || type_name == "Bool" { return emit_expression(state, integer_argument) }
            if starts_with(type_name, "UInt") {
                let emitted: Result[EmitState, String] = emit_expression(state, integer_argument)
                if is_err(emitted) { return err(expression_error(emitted)) }
                let tested: EmitState = append_code(result_unwrap(emitted), [u8(72), u8(133), u8(192)])
                return ok(emit_jump(tested, tested.env.trap_label, true, u8(136)))
            }
            if type_name == "String" {
                let emitted: Result[EmitState, String] = emit_expression(state, integer_argument)
                if is_err(emitted) { return err(expression_error(emitted)) }
                let marked: EmitState = state_with_host_used(append_code(result_unwrap(emitted), [u8(72), u8(137), u8(199)]))
                return ok(emit_label_call(marked, host_int_from_string_label(marked)))
            }
            return err("dynamic backend: int does not support type '" + type_name + "'")
        }
        if target == "builtin:str" {
            if result_unwrap(json_array_len(arguments)) != 1 { return err("dynamic backend: str expects one Display argument") }
            let display_argument: Json = result_unwrap(json_array_get(arguments, 0))
            let type_name: String = expr_type(display_argument)
            if type_name == "String" { return emit_expression(state, display_argument) }
            let mut display_kind: UInt64 = u64(0)
            if type_name == "Bool" {
                display_kind = u64(2)
            } else if type_name == "Int" {
                display_kind = u64(0)
            } else if starts_with(type_name, "UInt") {
                display_kind = u64(1)
            } else {
                return err("dynamic backend: str does not support type '" + type_name + "'")
            }
            let emitted: Result[EmitState, String] = emit_expression(state, display_argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            let moved: EmitState = append_code(result_unwrap(emitted), array_concat([u8(72), u8(137), u8(199), u8(72), u8(190)], dyn_u64_bytes(display_kind)))
            let marked: EmitState = state_with_host_used(moved)
            return ok(emit_label_call(marked, host_int_to_string_label(marked)))
        }
        if target == "builtin:contains" || target == "builtin:starts_with" || target == "builtin:ends_with" {
            let mut mode: String = "contains"
            if target == "builtin:starts_with" { mode = "starts_with" }
            if target == "builtin:ends_with" { mode = "ends_with" }
    return emit_string_predicate(state, expression, mode)
}
        if target == "builtin:substring" { return emit_substring_call(state, expression) }
        if target == "builtin:string_chars" {
            let char_argument: Json = result_unwrap(json_array_get(arguments, 0))
            if result_unwrap(json_array_len(arguments)) != 1 || expr_type(char_argument) != "String" { return err("dynamic backend: string_chars expects one String argument") }
            let emitted: Result[EmitState, String] = emit_expression(state, char_argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            let moved: EmitState = append_code(result_unwrap(emitted), [u8(72), u8(137), u8(199)])
            let marked: EmitState = state_with_array_used(state_with_host_used(moved))
            return ok(emit_label_call(marked, host_string_chars_label(marked)))
        }
        let argument: Json = result_unwrap(json_array_get(arguments, 0))
        if target == "builtin:len" {
            if result_unwrap(json_array_len(arguments)) != 1 || (!starts_with(expr_type(argument), "Array[") && expr_type(argument) != "Bytes") { return err("dynamic backend: len supports Array[T] and Bytes") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            return ok(append_code(result_unwrap(emitted), [u8(72), u8(139), u8(0)]))
        }
        if target == "builtin:bytes" {
            if result_unwrap(json_array_len(arguments)) != 1 || expr_type(argument) != "Array[Int]" { return err("dynamic backend: bytes expects Array[Int]") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            let moved: EmitState = append_code(result_unwrap(emitted), [u8(72), u8(137), u8(199)])
            let marked: EmitState = state_with_array_used(state_with_host_used(moved))
            return ok(emit_label_call(marked, host_bytes_from_array_label(marked)))
        }
        if target == "builtin:bytes_from_u8" {
            if result_unwrap(json_array_len(arguments)) != 1 || expr_type(argument) != "Array[UInt8]" { return err("dynamic backend: bytes_from_u8 expects Array[UInt8]") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            let moved: EmitState = append_code(result_unwrap(emitted), [u8(72), u8(137), u8(199)])
            let marked: EmitState = state_with_array_used(state_with_host_used(moved))
            return ok(emit_label_call(marked, host_bytes_from_array_label(marked)))
        }
        if target == "builtin:u8_array" {
            if result_unwrap(json_array_len(arguments)) != 1 || expr_type(argument) != "Bytes" { return err("dynamic backend: u8_array expects Bytes") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            let moved: EmitState = append_code(result_unwrap(emitted), [u8(72), u8(137), u8(199)])
            let marked: EmitState = state_with_array_used(state_with_host_used(moved))
            return ok(emit_label_call(marked, host_u8_array_label(marked)))
        }
        if target == "builtin:string_to_bytes" {
            if result_unwrap(json_array_len(arguments)) != 1 || expr_type(argument) != "String" { return err("dynamic backend: string_to_bytes expects String") }
            return emit_expression(state, argument)
        }
        if target == "builtin:json_parse" {
            if result_unwrap(json_array_len(arguments)) != 1 || expr_type(argument) != "String" { return err("dynamic backend: json_parse expects one String argument") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            let moved: EmitState = append_code(result_unwrap(emitted), [u8(72), u8(137), u8(199)])
            let marked: EmitState = state_with_box_used(state_with_host_used(moved))
            return ok(emit_label_call(marked, host_json_parse_label(marked)))
        }
        if target == "builtin:json_stringify" {
            if result_unwrap(json_array_len(arguments)) != 1 || expr_type(argument) != "Json" { return err("dynamic backend: json_stringify expects one Json argument") }
            return emit_expression(state, argument)
        }
        if target == "builtin:json_kind" {
            if result_unwrap(json_array_len(arguments)) != 1 || expr_type(argument) != "Json" { return err("dynamic backend: json_kind expects one Json argument") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            let moved: EmitState = append_code(result_unwrap(emitted), [u8(72), u8(137), u8(199)])
            let marked: EmitState = state_with_host_used(moved)
            return ok(emit_label_call(marked, host_json_kind_label(marked)))
        }
        if target == "builtin:json_array_len" {
            if result_unwrap(json_array_len(arguments)) != 1 || expr_type(argument) != "Json" { return err("dynamic backend: json_array_len expects one Json argument") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            let moved: EmitState = append_code(result_unwrap(emitted), [u8(72), u8(137), u8(199)])
            let marked: EmitState = state_with_box_used(state_with_host_used(moved))
            return ok(emit_label_call(marked, host_json_array_len_label(marked)))
        }
        if target == "builtin:json_object_get" {
            if result_unwrap(json_array_len(arguments)) != 2 || expr_type(argument) != "Json" { return err("dynamic backend: json_object_get expects Json and String") }
            let key_argument: Json = result_unwrap(json_array_get(arguments, 1))
            if expr_type(key_argument) != "String" { return err("dynamic backend: json_object_get expects Json and String") }
            let first: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(first) { return err(expression_error(first)) }
            let pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
            let second: Result[EmitState, String] = emit_expression(pushed, key_argument)
            if is_err(second) { return err(expression_error(second)) }
            let moved: EmitState = append_code(result_unwrap(second), [u8(72), u8(137), u8(198), u8(95)])
            let marked: EmitState = state_with_box_used(state_with_host_used(moved))
            return ok(emit_label_call(marked, host_json_object_get_label(marked)))
        }
        if target == "builtin:json_array_get" {
            if result_unwrap(json_array_len(arguments)) != 2 || expr_type(argument) != "Json" { return err("dynamic backend: json_array_get expects Json and Int") }
            let index_argument: Json = result_unwrap(json_array_get(arguments, 1))
            if expr_type(index_argument) != "Int" { return err("dynamic backend: json_array_get expects Json and Int") }
            let first: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(first) { return err(expression_error(first)) }
            let pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
            let second: Result[EmitState, String] = emit_expression(pushed, index_argument)
            if is_err(second) { return err(expression_error(second)) }
            let moved: EmitState = append_code(result_unwrap(second), [u8(72), u8(137), u8(198), u8(95)])
            let marked: EmitState = state_with_box_used(state_with_host_used(moved))
            return ok(emit_label_call(marked, host_json_array_get_label(marked)))
        }
        if target == "builtin:json_string" {
            if result_unwrap(json_array_len(arguments)) != 1 || expr_type(argument) != "Json" { return err("dynamic backend: json_string expects one Json argument") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            let moved: EmitState = append_code(result_unwrap(emitted), [u8(72), u8(137), u8(199)])
            let marked: EmitState = state_with_box_used(state_with_host_used(moved))
            return ok(emit_label_call(marked, host_json_string_label(marked)))
        }
        if target == "builtin:json_bool" {
            if result_unwrap(json_array_len(arguments)) != 1 || expr_type(argument) != "Json" { return err("dynamic backend: json_bool expects one Json argument") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            let moved: EmitState = append_code(result_unwrap(emitted), [u8(72), u8(137), u8(199)])
            let marked: EmitState = state_with_box_used(state_with_host_used(moved))
            return ok(emit_label_call(marked, host_json_bool_label(marked)))
        }
        if target == "builtin:json_int" {
            if result_unwrap(json_array_len(arguments)) != 1 || expr_type(argument) != "Json" { return err("dynamic backend: json_int expects one Json argument") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            let moved: EmitState = append_code(result_unwrap(emitted), [u8(72), u8(137), u8(199)])
            let marked: EmitState = state_with_box_used(state_with_host_used(moved))
            return ok(emit_label_call(marked, host_json_int_label(marked)))
        }
        if target == "builtin:json_uint" {
            if result_unwrap(json_array_len(arguments)) != 1 || expr_type(argument) != "Json" { return err("dynamic backend: json_uint expects one Json argument") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            let moved: EmitState = append_code(result_unwrap(emitted), [u8(72), u8(137), u8(199)])
            let marked: EmitState = state_with_box_used(state_with_host_used(moved))
            return ok(emit_label_call(marked, host_json_uint_label(marked)))
        }
        if target == "builtin:map_get" { return emit_map_get_call(state, expression) }
        if target == "builtin:map_contains_key" { return emit_map_contains_call(state, expression) }
        if target == "builtin:map_insert" { return emit_map_insert_call(state, expression) }
        if target == "builtin:map_remove" { return emit_map_remove_call(state, expression) }
        if target == "builtin:array_set" { return emit_array_set_call(state, expression) }
        if target == "builtin:array_slice" { return emit_array_slice_call(state, expression) }
        if target == "builtin:fs_read_text" {
            if result_unwrap(json_array_len(arguments)) != 1 { return err("dynamic backend: fs_read_text expects one argument") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            let moved: EmitState = append_code(result_unwrap(emitted), [u8(72), u8(137), u8(199)])
            let marked: EmitState = state_with_box_used(state_with_host_used(moved))
            return ok(emit_label_call(marked, host_fs_read_text_label(marked)))
        }
        if target == "builtin:fs_write_bytes" {
            if result_unwrap(json_array_len(arguments)) != 2 || expr_type(argument) != "String" { return err("dynamic backend: fs_write_bytes expects String and Bytes") }
            let bytes_argument: Json = result_unwrap(json_array_get(arguments, 1))
            if expr_type(bytes_argument) != "Bytes" { return err("dynamic backend: fs_write_bytes expects String and Bytes") }
            let path: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(path) { return err(expression_error(path)) }
            let pushed: EmitState = append_code(result_unwrap(path), [u8(80)])
            let bytes_value: Result[EmitState, String] = emit_expression(pushed, bytes_argument)
            if is_err(bytes_value) { return err(expression_error(bytes_value)) }
            let moved: EmitState = append_code(result_unwrap(bytes_value), [u8(72), u8(137), u8(198), u8(95)])
            let marked: EmitState = state_with_box_used(state_with_host_used(moved))
            return ok(emit_label_call(marked, host_fs_write_bytes_label(marked)))
        }
        if target == "builtin:array_push" { return emit_array_push_call(state, expression) }
        if target == "builtin:array_get" { return emit_array_get(state, expression) }
        if target == "builtin:array_indices" { return emit_array_indices(state, expression) }
        if target == "builtin:array_concat" {
            if result_unwrap(json_array_len(arguments)) != 2 { return err("dynamic backend: array_concat expects two arguments") }
            let first: Result[EmitState, String] = emit_expression(state, result_unwrap(json_array_get(arguments, 0)))
            if is_err(first) { return err(expression_error(first)) }
            let pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
            let second: Result[EmitState, String] = emit_expression(pushed, result_unwrap(json_array_get(arguments, 1)))
            if is_err(second) { return err(expression_error(second)) }
            let combined: EmitState = append_code(result_unwrap(second), [u8(72), u8(137), u8(193), u8(88)])
            return ok(emit_array_concat_call(combined))
        }
        if target == "builtin:some" {
            if result_unwrap(json_array_len(arguments)) != 1 { return err("dynamic backend: some expects one argument") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            return ok(emit_box_call(result_unwrap(emitted), u64(1)))
        }
        if target == "builtin:ok" || target == "builtin:err" {
            if result_unwrap(json_array_len(arguments)) != 1 { return err("dynamic backend: Result constructor expects one argument") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            let mut tag: UInt64 = u64(0)
            if target == "builtin:err" { tag = u64(1) }
            return ok(emit_box_call(result_unwrap(emitted), tag))
        }
        if target == "builtin:is_some" || target == "builtin:is_none" {
            if result_unwrap(json_array_len(arguments)) != 1 { return err("dynamic backend: Option predicate expects one argument") }
            return emit_option_predicate(state, argument, target == "builtin:is_none")
        }
        if target == "builtin:is_ok" || target == "builtin:is_err" {
            if result_unwrap(json_array_len(arguments)) != 1 { return err("dynamic backend: Result predicate expects one argument") }
            return emit_result_predicate(state, argument, target == "builtin:is_err")
        }
        if target == "builtin:unwrap_or" { return emit_unwrap_or(state, expression) }
        if target == "builtin:result_unwrap" {
            if result_unwrap(json_array_len(arguments)) != 1 { return err("dynamic backend: result_unwrap expects one argument") }
            return emit_result_unwrap(state, argument)
        }
        if target == "builtin:result_error" {
            if result_unwrap(json_array_len(arguments)) != 1 { return err("dynamic backend: result_error expects one argument") }
            return emit_result_error(state, argument)
        }
        if target == "builtin:u8" || target == "builtin:u16" || target == "builtin:u32" || target == "builtin:u64" {
            if result_unwrap(json_array_len(arguments)) != 1 { return err("dynamic backend: integer conversion expects one argument") }
            let emitted: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted) { return err(expression_error(emitted)) }
            let mut bits: Int = 64
            if target == "builtin:u8" { bits = 8 }
            if target == "builtin:u16" { bits = 16 }
            if target == "builtin:u32" { bits = 32 }
            return ok(emit_uint_mask(result_unwrap(emitted), bits))
        }
        return err("dynamic backend: unsupported call '" + target + "'")
    }
    if kind == "bool" {
        let value: Bool = result_unwrap(json_bool(field(expression, "bool")))
        if value { return ok(emit_int(state, 1)) }
        return ok(emit_int(state, 0))
    }
    if kind == "var" {
        let name: String = text(field(expression, "name"))
        let slot: Option[Int] = map_get(state.env.slots, name)
        if is_none(slot) { return err("dynamic backend: unknown slot '" + name + "'") }
        return ok(emit_load_slot(state, unwrap_or(slot, -1)))
    }
    if kind == "unary" {
        let operand: Result[EmitState, String] = emit_expression(state, field(expression, "operand"))
        if is_err(operand) { return err(expression_error(operand)) }
        let updated: EmitState = result_unwrap(operand)
        let operator: String = text(field(expression, "operator"))
        if operator == "+" { return ok(updated) }
        if operator == "-" { return ok(append_code(updated, [u8(72), u8(247), u8(216)])) }
        if operator == "!" { return ok(append_code(updated, [u8(72), u8(133), u8(192), u8(15), u8(148), u8(192), u8(72), u8(15), u8(182), u8(192)])) }
        if operator == "~" { return ok(append_code(updated, [u8(72), u8(247), u8(208)])) }
        return err("dynamic backend: unsupported unary operator '" + operator + "'")
    }
    if kind != "binary" {
        return err("dynamic backend: unsupported expression kind '" + kind + "'")
    }
    let operator: String = text(field(expression, "operator"))
    if operator == "&&" || operator == "||" { return emit_logical_expression(state, expression, operator) }
    let left: Result[EmitState, String] = emit_expression(state, field(expression, "left"))
    if is_err(left) { return err(expression_error(left)) }
    let pushed: EmitState = emit_push_rax(result_unwrap(left))
    let right: Result[EmitState, String] = emit_expression(pushed, field(expression, "right"))
    if is_err(right) { return err(expression_error(right)) }
    let moved: EmitState = append_code(result_unwrap(right), [u8(72), u8(137), u8(193)])
    let popped: Result[EmitState, String] = emit_pop_rax(moved)
    if is_err(popped) { return err(unwrap_or(result_error(popped), "dynamic backend: binary expression stack restore failed")) }
    let combined: EmitState = result_unwrap(popped)
    let left_type: String = expr_type(field(expression, "left"))
    if left_type == "String" {
        if operator != "+" && operator != "==" && operator != "!=" { return err("dynamic backend: unsupported String operator '" + operator + "'") }
        if operator == "+" { return ok(emit_string_concat_call(combined)) }
        let compared: EmitState = append_code(combined, [u8(72), u8(137), u8(199), u8(72), u8(137), u8(206)])
        let equal: EmitState = emit_label_call(compared, host_string_equal_label(compared))
        if operator == "!=" { return ok(append_code(equal, [u8(72), u8(131), u8(240), u8(1)])) }
        return ok(equal)
    }
    let expression_type: String = expr_type(expression)
    if starts_with(expression_type, "Array[") {
        if operator != "+" { return err("dynamic backend: unsupported Array operator '" + operator + "'") }
        return ok(emit_array_concat_call(combined))
    }
    let unsigned: Bool = is_unsigned(expression_type)
    let bits: Int = uint_bits(expression_type)
    if operator == "+" {
        let added: EmitState = append_code(combined, [u8(72), u8(1), u8(200)])
        if !unsigned { return ok(emit_jump(added, state.env.trap_label, true, u8(128))) }
        return ok(emit_uint_mask(added, bits))
    }
    if operator == "-" {
        let subtracted: EmitState = append_code(combined, [u8(72), u8(41), u8(200)])
        if !unsigned { return ok(emit_jump(subtracted, state.env.trap_label, true, u8(128))) }
        return ok(emit_uint_mask(subtracted, bits))
    }
    if operator == "*" {
        let multiplied: EmitState = append_code(combined, [u8(72), u8(15), u8(175), u8(193)])
        if !unsigned { return ok(emit_jump(multiplied, state.env.trap_label, true, u8(128))) }
        return ok(emit_uint_mask(multiplied, bits))
    }
    if operator == "/" || operator == "%" {
        let checked: EmitState = append_code(combined, [u8(72), u8(133), u8(201)])
        let guarded: EmitState = emit_jump(checked, state.env.trap_label, true, u8(132))
        let mut divided: EmitState = guarded
        if unsigned {
            divided = append_code(divided, [u8(72), u8(49), u8(210), u8(72), u8(247), u8(241)])
        } else {
            let safe_division: LabelState = new_label(divided)
            divided = append_code(safe_division.state, array_concat([u8(72), u8(186)], dyn_u64_bytes(u64(1) << 63)))
            divided = append_code(divided, [u8(72), u8(57), u8(208)])
            divided = emit_jump(divided, safe_division.label, true, u8(133))
            divided = append_code(divided, [u8(72), u8(131), u8(249), u8(255)])
            divided = emit_jump(divided, safe_division.label, true, u8(133))
            divided = emit_jump(divided, state.env.trap_label, false, u8(0))
            let bound_safe: Result[EmitState, String] = bind_label(divided, safe_division.label)
            if is_err(bound_safe) { return err(unwrap_or(result_error(bound_safe), "dynamic backend: cannot bind signed division guard")) }
            divided = append_code(result_unwrap(bound_safe), [u8(72), u8(153), u8(72), u8(247), u8(249)])
        }
        if operator == "%" { return ok(emit_uint_mask(append_code(divided, [u8(72), u8(137), u8(208)]), bits)) }
        return ok(emit_uint_mask(divided, bits))
    }
    if operator == "&" { return ok(emit_uint_mask(append_code(combined, [u8(72), u8(33), u8(200)]), bits)) }
    if operator == "^" { return ok(emit_uint_mask(append_code(combined, [u8(72), u8(49), u8(200)]), bits)) }
    if operator == "|" { return ok(emit_uint_mask(append_code(combined, [u8(72), u8(9), u8(200)]), bits)) }
    if operator == "<<" || operator == ">>" {
        let shift_left_type: String = expr_type(field(expression, "left"))
        let mut shift_width: Int = 64
        if starts_with(shift_left_type, "UInt") { shift_width = uint_bits(shift_left_type) }
        let checked_shift: EmitState = append_code(combined, [u8(72), u8(131), u8(249), u8(shift_width)])
        let guarded_shift: EmitState = emit_jump(checked_shift, state.env.trap_label, true, u8(131))
        if operator == "<<" { return ok(emit_uint_mask(append_code(guarded_shift, [u8(72), u8(211), u8(224)]), bits)) }
        return ok(emit_uint_mask(append_code(guarded_shift, [u8(72), u8(211), u8(232)]), bits))
    }
    if operator == "==" || operator == "!=" || operator == "<" || operator == "<=" || operator == ">" || operator == ">=" {
        return ok(append_code(combined, [u8(72), u8(57), u8(200), u8(15), setcc(operator, unsigned), u8(192), u8(72), u8(15), u8(182), u8(192)]))
    }
    return err("dynamic backend: unsupported binary operator '" + operator + "'")
}

fn compile_error(value: Result[EmitState, String]) -> String {
    return "dynamic backend: statement lowering failed: " + unwrap_or(result_error(value), "unknown error")
}

fn is_static_display_candidate(expression: Json, bindings: Map[String, String]) -> Bool {
    let kind: String = text(field(expression, "kind"))
    if kind == "int" || kind == "uint" || kind == "string" || kind == "bool" { return true }
    if kind == "var" { return map_contains_key(bindings, text(field(expression, "name"))) }
    if kind == "binary" {
        return is_static_display_candidate(field(expression, "left"), bindings) && is_static_display_candidate(field(expression, "right"), bindings)
    }
    if kind == "call" {
        let target: String = text(field(expression, "call_target"))
        if target != "builtin:str" { return false }
        let arguments: Json = field(expression, "args")
        if result_unwrap(json_array_len(arguments)) != 1 { return false }
        return is_static_display_candidate(result_unwrap(json_array_get(arguments, 0)), bindings)
    }
    return false
}

fn allocate_slot(state: EmitState, name: String) -> Result[EmitState, String] {
    if map_contains_key(state.env.slots, name) { return err("dynamic backend: shadowed slot '" + name + "'") }
    let offset: Int = state.env.next_slot + 8
    let env: CompileEnv = CompileEnv{ slots: map_insert(state.env.slots, name, offset), static_values: state.env.static_values, struct_fields: state.env.struct_fields, function_labels: state.env.function_labels, function_returns: state.env.function_returns, next_slot: offset, breaks: state.env.breaks, continues: state.env.continues, end_label: state.env.end_label, trap_label: state.env.trap_label, buffer_offset: state.env.buffer_offset, in_function: state.env.in_function, current_function: state.env.current_function }
    return ok(state_with_env(state, env))
}

fn compile_statement(state: EmitState, statement: Json) -> Result[EmitState, String] {
    let kind: String = text(field(statement, "kind"))
    if kind == "let" || kind == "const" {
        let name: String = text(field(statement, "name"))
        let allocated: Result[EmitState, String] = allocate_slot(state, name)
        if is_err(allocated) { return err(compile_error(allocated)) }
        let updated: EmitState = result_unwrap(allocated)
        let init: Json = field(statement, "init")
        let type_name: String = expr_type(init)
        if state.env.in_function && !is_supported_type(state.env, type_name) { return err("dynamic backend: function '" + state.env.current_function + "' local '" + name + "' has unsupported type '" + type_name + "'") }
        let mut generated: Result[EmitState, String] = err("dynamic backend: initializer was not lowered")
        generated = emit_expression(updated, init)
        if is_err(generated) { return err(expression_error(generated)) }
        let stored: EmitState = emit_store_slot(result_unwrap(generated), unwrap_or(map_get(updated.env.slots, name), -1))
        let mutable: Bool = result_unwrap(json_bool(field(statement, "mutable")))
        if !mutable {
            let mut display_value: Result[String, String] = err("dynamic backend: initializer is not static display data")
            if type_name == "String" || type_name == "Int" || type_name == "Bool" || starts_with(type_name, "UInt") {
                display_value = eval_display(init, stored.env.static_values)
            }
            if is_ok(display_value) {
                let env: CompileEnv = CompileEnv{ slots: stored.env.slots, static_values: map_insert(stored.env.static_values, name, result_unwrap(display_value)), struct_fields: stored.env.struct_fields, function_labels: stored.env.function_labels, function_returns: stored.env.function_returns, next_slot: stored.env.next_slot, breaks: stored.env.breaks, continues: stored.env.continues, end_label: stored.env.end_label, trap_label: stored.env.trap_label, buffer_offset: stored.env.buffer_offset, in_function: stored.env.in_function, current_function: stored.env.current_function }
                return ok(state_with_env(stored, env))
            }
        }
        return ok(stored)
    }
    if kind == "assign" {
        let target: Json = field(statement, "target")
        let name: String = text(field(target, "name"))
        let slot: Option[Int] = map_get(state.env.slots, name)
        if is_none(slot) { return err("dynamic backend: assignment uses unknown slot '" + name + "'") }
        let value: Result[EmitState, String] = emit_expression(state, field(statement, "value"))
        if is_err(value) { return err(expression_error(value)) }
        let stored: EmitState = emit_store_slot(result_unwrap(value), unwrap_or(slot, -1))
        return ok(state_with_env(stored, CompileEnv{ slots: stored.env.slots, static_values: map_remove(stored.env.static_values, name), struct_fields: stored.env.struct_fields, function_labels: stored.env.function_labels, function_returns: stored.env.function_returns, next_slot: stored.env.next_slot, breaks: stored.env.breaks, continues: stored.env.continues, end_label: stored.env.end_label, trap_label: stored.env.trap_label, buffer_offset: stored.env.buffer_offset, in_function: stored.env.in_function, current_function: stored.env.current_function }))
    }
    if kind == "expr" {
        let expression: Json = field(statement, "expr")
        let target: String = text(field(expression, "call_target"))
        if starts_with(target, "function:") {
            return emit_function_call(state, expression)
        }
        if target != "builtin:print" && target != "builtin:println" {
            let emitted: Result[EmitState, String] = emit_expression(state, expression)
            if is_err(emitted) { return err(expression_error(emitted)) }
            return ok(result_unwrap(emitted))
        }
        let argument: Json = result_unwrap(json_array_get(field(expression, "args"), 0))
        let mut display_value: Result[String, String] = err("dynamic display expression")
        if is_static_display_candidate(argument, state.env.static_values) {
            display_value = eval_display(argument, state.env.static_values)
        }
        if is_ok(display_value) {
            let mut output: String = result_unwrap(display_value)
            if target == "builtin:println" { output = output + "\n" }
            return emit_write(state, output)
        }
        let type_name: String = expr_type(argument)
        if type_name == "String" {
            let emitted_string: Result[EmitState, String] = emit_expression(state, argument)
            if is_err(emitted_string) { return err(expression_error(emitted_string)) }
            let written_string: Result[EmitState, String] = emit_string_write(result_unwrap(emitted_string))
            if is_err(written_string) { return err(unwrap_or(result_error(written_string), "dynamic backend: string output failed")) }
            if target == "builtin:println" { return emit_write(result_unwrap(written_string), "\n") }
            return written_string
        }
        if type_name == "Bool" {
            return emit_boolean_output(state, argument, target == "builtin:println")
        }
        if type_name != "Int" && !starts_with(type_name, "UInt") { return err("dynamic backend: print value has unsupported type '" + type_name + "': " + unwrap_or(result_error(display_value), "dynamic backend: print value is not static")) }
        let generated: Result[EmitState, String] = emit_expression(state, argument)
        if is_err(generated) { return err(expression_error(generated)) }
        let output_state: Result[EmitState, String] = emit_integer(result_unwrap(generated), starts_with(type_name, "UInt"))
        if is_err(output_state) { return err(unwrap_or(result_error(output_state), "dynamic backend: integer output failed")) }
        if target == "builtin:println" { return emit_write(result_unwrap(output_state), "\n") }
        return ok(result_unwrap(output_state))
    }
    if kind == "if" {
        let else_label: LabelState = new_label(state)
        let condition: Result[EmitState, String] = emit_expression(else_label.state, field(statement, "cond"))
        if is_err(condition) {
            return err(expression_error(condition))
        }
        let tested: EmitState = append_code(result_unwrap(condition), [u8(72), u8(133), u8(192)])
        let guarded: EmitState = emit_jump(tested, else_label.label, true, u8(132))
        let then_state: Result[EmitState, String] = compile_statements(guarded, field(statement, "then"))
        if is_err(then_state) { return err(compile_error(then_state)) }
        if result_unwrap(json_array_len(field(statement, "else"))) == 0 {
            let bound: Result[EmitState, String] = bind_label(result_unwrap(then_state), else_label.label)
            if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind empty if join")) }
            let then_result: EmitState = result_unwrap(then_state)
            let joined: EmitState = result_unwrap(bound)
            let joined_env: CompileEnv = CompileEnv{ slots: guarded.env.slots, static_values: guarded.env.static_values, struct_fields: guarded.env.struct_fields, function_labels: guarded.env.function_labels, function_returns: guarded.env.function_returns, next_slot: then_result.env.next_slot, breaks: guarded.env.breaks, continues: guarded.env.continues, end_label: guarded.env.end_label, trap_label: guarded.env.trap_label, buffer_offset: guarded.env.buffer_offset, in_function: guarded.env.in_function, current_function: guarded.env.current_function }
            return ok(state_with_env(joined, joined_env))
        }
        let join_label: LabelState = new_label(result_unwrap(then_state))
        let jumped: EmitState = emit_jump(join_label.state, join_label.label, false, u8(0))
        let bound_else: Result[EmitState, String] = bind_label(jumped, else_label.label)
        if is_err(bound_else) { return err(unwrap_or(result_error(bound_else), "dynamic backend: cannot bind else")) }
        let else_base: EmitState = state_with_env(result_unwrap(bound_else), CompileEnv{ slots: guarded.env.slots, static_values: guarded.env.static_values, struct_fields: guarded.env.struct_fields, function_labels: guarded.env.function_labels, function_returns: guarded.env.function_returns, next_slot: guarded.env.next_slot, breaks: guarded.env.breaks, continues: guarded.env.continues, end_label: guarded.env.end_label, trap_label: guarded.env.trap_label, buffer_offset: guarded.env.buffer_offset, in_function: guarded.env.in_function, current_function: guarded.env.current_function })
        let else_state: Result[EmitState, String] = compile_statements(else_base, field(statement, "else"))
        if is_err(else_state) { return err(compile_error(else_state)) }
        let bound_join: Result[EmitState, String] = bind_label(result_unwrap(else_state), join_label.label)
        if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind if join")) }
        let then_result: EmitState = result_unwrap(then_state)
        let else_result: EmitState = result_unwrap(else_state)
        let mut next_slot: Int = then_result.env.next_slot
        if else_result.env.next_slot > next_slot { next_slot = else_result.env.next_slot }
        let joined: EmitState = result_unwrap(bound_join)
        let joined_env: CompileEnv = CompileEnv{ slots: guarded.env.slots, static_values: guarded.env.static_values, struct_fields: guarded.env.struct_fields, function_labels: guarded.env.function_labels, function_returns: guarded.env.function_returns, next_slot: next_slot, breaks: guarded.env.breaks, continues: guarded.env.continues, end_label: guarded.env.end_label, trap_label: guarded.env.trap_label, buffer_offset: guarded.env.buffer_offset, in_function: guarded.env.in_function, current_function: guarded.env.current_function }
        return ok(state_with_env(joined, joined_env))
    }
    if kind == "while" {
        let condition_label: LabelState = new_label(state)
        let end_label: LabelState = new_label(condition_label.state)
        let bound_condition: Result[EmitState, String] = bind_label(end_label.state, condition_label.label)
        if is_err(bound_condition) { return err(unwrap_or(result_error(bound_condition), "dynamic backend: cannot bind loop")) }
        let condition: Result[EmitState, String] = emit_expression(result_unwrap(bound_condition), field(statement, "cond"))
        if is_err(condition) { return err(expression_error(condition)) }
        let tested: EmitState = append_code(result_unwrap(condition), [u8(72), u8(133), u8(192)])
        let guarded: EmitState = emit_jump(tested, end_label.label, true, u8(132))
        let env: CompileEnv = CompileEnv{ slots: guarded.env.slots, static_values: guarded.env.static_values, struct_fields: guarded.env.struct_fields, function_labels: guarded.env.function_labels, function_returns: guarded.env.function_returns, next_slot: guarded.env.next_slot, breaks: array_push(guarded.env.breaks, end_label.label), continues: array_push(guarded.env.continues, condition_label.label), end_label: guarded.env.end_label, trap_label: guarded.env.trap_label, buffer_offset: guarded.env.buffer_offset, in_function: guarded.env.in_function, current_function: guarded.env.current_function }
        let body: Result[EmitState, String] = compile_statements(state_with_env(guarded, env), field(statement, "body"))
        if is_err(body) { return err(compile_error(body)) }
        let body_state: EmitState = result_unwrap(body)
        let restored: EmitState = state_with_env(body_state, CompileEnv{ slots: body_state.env.slots, static_values: body_state.env.static_values, struct_fields: body_state.env.struct_fields, function_labels: body_state.env.function_labels, function_returns: body_state.env.function_returns, next_slot: body_state.env.next_slot, breaks: array_slice(body_state.env.breaks, 0, len(body_state.env.breaks) - 1), continues: array_slice(body_state.env.continues, 0, len(body_state.env.continues) - 1), end_label: body_state.env.end_label, trap_label: body_state.env.trap_label, buffer_offset: body_state.env.buffer_offset, in_function: body_state.env.in_function, current_function: body_state.env.current_function })
        let looped: EmitState = emit_jump(restored, condition_label.label, false, u8(0))
        let bound_end: Result[EmitState, String] = bind_label(looped, end_label.label)
        if is_err(bound_end) { return err(unwrap_or(result_error(bound_end), "dynamic backend: cannot bind loop end")) }
        return ok(result_unwrap(bound_end))
    }
    if kind == "for" {
        let iterator: Json = field(statement, "iter")
        if !starts_with(expr_type(iterator), "Array[") { return err("dynamic backend: for requires an Array iterator") }
        let iter_slot: Int = state.env.next_slot + 8
        let index_slot: Int = iter_slot + 8
        let item_slot: Int = index_slot + 8
        let emitted: Result[EmitState, String] = emit_expression(state, iterator)
        if is_err(emitted) { return err(expression_error(emitted)) }
        let mut current: EmitState = emit_store_slot(result_unwrap(emitted), iter_slot)
        current = emit_store_slot(emit_int(current, 0), index_slot)
        let condition_label: LabelState = new_label(current)
        let increment_label: LabelState = new_label(condition_label.state)
        let end_label: LabelState = new_label(increment_label.state)
        let bound_condition: Result[EmitState, String] = bind_label(end_label.state, condition_label.label)
        if is_err(bound_condition) { return err(unwrap_or(result_error(bound_condition), "dynamic backend: cannot bind for loop")) }
        current = emit_load_slot(result_unwrap(bound_condition), iter_slot)
        current = append_code(current, [u8(80)])
        current = emit_load_slot(current, index_slot)
        current = append_code(current, [u8(72), u8(137), u8(193), u8(88), u8(72), u8(133), u8(201)])
        current = emit_jump(current, current.env.trap_label, true, u8(136))
        current = append_code(current, [u8(72), u8(59), u8(8)])
        current = emit_jump(current, end_label.label, true, u8(131))
        current = append_code(current, [u8(72), u8(139), u8(68), u8(200), u8(8)])
        current = emit_store_slot(current, item_slot)
        let loop_env: CompileEnv = CompileEnv{ slots: map_insert(current.env.slots, text(field(statement, "name")), item_slot), static_values: current.env.static_values, struct_fields: current.env.struct_fields, function_labels: current.env.function_labels, function_returns: current.env.function_returns, next_slot: item_slot, breaks: array_push(current.env.breaks, end_label.label), continues: array_push(current.env.continues, increment_label.label), end_label: current.env.end_label, trap_label: current.env.trap_label, buffer_offset: current.env.buffer_offset, in_function: current.env.in_function, current_function: current.env.current_function }
        let body: Result[EmitState, String] = compile_statements(state_with_env(current, loop_env), field(statement, "body"))
        if is_err(body) { return err(compile_error(body)) }
        let body_state: EmitState = result_unwrap(body)
        let restored: CompileEnv = CompileEnv{ slots: state.env.slots, static_values: body_state.env.static_values, struct_fields: body_state.env.struct_fields, function_labels: body_state.env.function_labels, function_returns: body_state.env.function_returns, next_slot: body_state.env.next_slot, breaks: array_slice(body_state.env.breaks, 0, len(body_state.env.breaks) - 1), continues: array_slice(body_state.env.continues, 0, len(body_state.env.continues) - 1), end_label: body_state.env.end_label, trap_label: body_state.env.trap_label, buffer_offset: body_state.env.buffer_offset, in_function: body_state.env.in_function, current_function: body_state.env.current_function }
        current = emit_load_slot(state_with_env(body_state, restored), index_slot)
        current = append_code(current, [u8(72), u8(255), u8(192)])
        current = emit_store_slot(current, index_slot)
        current = emit_jump(current, condition_label.label, false, u8(0))
        let bound_end: Result[EmitState, String] = bind_label(current, end_label.label)
        if is_err(bound_end) { return err(unwrap_or(result_error(bound_end), "dynamic backend: cannot bind for loop end")) }
        return ok(result_unwrap(bound_end))
    }
    if kind == "break" || kind == "continue" {
        let mut labels: Array[Int] = state.env.continues
        if kind == "break" {
            labels = state.env.breaks
        }
        if len(labels) == 0 { return err("dynamic backend: loop control is outside a loop") }
        let label: Int = unwrap_or(array_get(labels, len(labels) - 1), -1)
        return ok(emit_jump(state, label, false, u8(0)))
    }
    if kind == "return" {
        if state.env.in_function {
            let value: Json = field(statement, "return")
            let return_type: String = unwrap_or(map_get(state.env.function_returns, state.env.current_function), "Nil")
            let mut current: EmitState = state
            let mut has_value: Bool = false
            if json_kind(value) != "null" {
                has_value = text(field(value, "kind")) != "nil"
            }
            if has_value {
                if return_type == "Nil" { return err("dynamic backend: Nil function cannot return a value") }
                let emitted: Result[EmitState, String] = emit_expression(current, value)
                if is_err(emitted) { return err(expression_error(emitted)) }
                current = result_unwrap(emitted)
            } else if return_type != "Nil" {
                return err("dynamic backend: scalar function must return a value")
            }
            return ok(append_code(current, [u8(201), u8(195)]))
        }
		let value: Json = field(statement, "return")
		if json_kind(value) != "null" && text(field(value, "kind")) != "nil" {
			let target: String = text(field(value, "call_target"))
			let mut emitted: Result[EmitState, String] = err("dynamic backend: return expression was not lowered")
			if starts_with(target, "function:") { emitted = emit_function_call(state, value) }
			else { emitted = emit_expression(state, value) }
			if is_err(emitted) { return err(expression_error(emitted)) }
			return ok(emit_jump(result_unwrap(emitted), state.env.end_label, false, u8(0)))
		}
        return ok(emit_jump(state, state.env.end_label, false, u8(0)))
    }
    return err("dynamic backend: unsupported statement kind '" + kind + "'")
}

fn compile_statements(state: EmitState, statements: Json) -> Result[EmitState, String] {
    let count: Int = result_unwrap(json_array_len(statements))
    let mut index: Int = 0
    let mut current: EmitState = state
    while index < count {
        let statement: Json = result_unwrap(json_array_get(statements, index))
        let next: Result[EmitState, String] = compile_statement(current, statement)
        if is_err(next) { return err(compile_error(next)) }
        current = result_unwrap(next)
        index = index + 1
    }
    return ok(current)
}

fn patch_code(state: EmitState, position: Int, bytes: Array[UInt8]) -> Result[EmitState, String] {
    if position < 0 || position + len(bytes) > state.code_pages.length { return err("dynamic backend: code patch out of bounds") }
    let patches: ChunkedCodePatches = chunked_code_patch_push(state.code_patches, CodePatch{ position: position, bytes: bytes })
    return ok(EmitState{ assembler: state.assembler, env: state.env, code_patches: patches, code_pages: state.code_pages })
}

fn apply_code_patches(state: EmitState) -> Result[EmitState, String] {
    let mut current: EmitState = state
    let patch_count: Int = current.code_patches.length
    let mut patch_index: Int = 0
    while patch_index < patch_count {
        let patch: CodePatch = unwrap_or(chunked_code_patch_get(current.code_patches, patch_index), CodePatch{ position: -1, bytes: [] })
        if patch.position < 0 || patch.position + len(patch.bytes) > current.code_pages.length { return err("dynamic backend: invalid deferred code patch") }
        let mut offset: Int = 0
        while offset < len(patch.bytes) {
            let absolute_position: Int = patch.position + offset
            let chunk_index: Int = absolute_position / 256
            let local_position: Int = absolute_position % 256
            let chunk: Array[UInt8] = code_chunk_get(current.code_pages, chunk_index)
            if len(chunk) == 0 || local_position >= len(chunk) { return err("dynamic backend: deferred patch has no code chunk") }
            let mut updated_chunk: Array[UInt8] = chunk
            let mut segment_length: Int = 0
            while offset + segment_length < len(patch.bytes) && local_position + segment_length < len(chunk) {
                let replacement: UInt8 = unwrap_or(array_get(patch.bytes, offset + segment_length), u8(0))
                let updated: Result[Array[UInt8], String] = array_set(updated_chunk, local_position + segment_length, replacement)
                if is_err(updated) { return err(unwrap_or(result_error(updated), "dynamic backend: deferred code chunk patch failed")) }
                updated_chunk = result_unwrap(updated)
                segment_length = segment_length + 1
            }
            let pages: Result[ChunkedCode, String] = code_chunk_set(current.code_pages, chunk_index, updated_chunk)
            if is_err(pages) { return err(unwrap_or(result_error(pages), "dynamic backend: cannot apply deferred code patch")) }
            current = EmitState{ assembler: current.assembler, env: current.env, code_patches: current.code_patches, code_pages: result_unwrap(pages) }
            offset = offset + segment_length
        }
        patch_index = patch_index + 1
    }
    return ok(current)
}

fn finalize_jumps(state: EmitState) -> Result[EmitState, String] {
    let mut current: EmitState = state
    let jump_count: Int = current.assembler.jumps.length
    let mut index: Int = 0
    while index < jump_count {
        let patch: JumpPatch = unwrap_or(chunked_jump_get(current.assembler.jumps, index), JumpPatch{ label: -1, position: -1, function: "" })
        let target: Int = chunked_int_get(current.assembler.labels, patch.label)
        if target < 0 { return err("dynamic backend: unresolved label " + str(patch.label) + " at patch " + str(patch.position) + " in function '" + patch.function + "' (label count " + str(current.assembler.labels.length) + ")") }
        let updated: Result[EmitState, String] = patch_code(current, patch.position, i32_bytes(target - patch.position - 4))
        if is_err(updated) { return err(unwrap_or(result_error(updated), "dynamic backend: jump patch failed")) }
        current = result_unwrap(updated)
        index = index + 1
    }
    return ok(current)
}

fn finalize_data(state: EmitState) -> Result[EmitState, String] {
    let mut current: EmitState = state
    for index in array_indices(current.assembler.data_patches) {
        let patch: DataPatch = unwrap_or(array_get(current.assembler.data_patches, index), DataPatch{ displacement: -1, instruction_end: -1, data_offset: -1 })
        let data_address: Int = 120 + current.assembler.code_length + patch.data_offset
        let next_instruction: Int = 120 + patch.instruction_end
        let updated: Result[EmitState, String] = patch_code(current, patch.displacement, i32_bytes(data_address - next_instruction))
        if is_err(updated) { return err(unwrap_or(result_error(updated), "dynamic backend: data patch failed")) }
        current = result_unwrap(updated)
    }
    return ok(current)
}

fn align_frame(value: Int) -> Int {
    let remainder: Int = value % 16
    if remainder == 0 { return value }
    return value + (16 - remainder)
}

fn emit_dynamic_elf(code: Array[UInt8], data: Array[UInt8]) -> Bytes {
    let file_size: Int = 120 + len(code) + len(data)
    let mut file: Array[UInt8] = []
    file = array_concat(file, [u8(127), u8(69), u8(76), u8(70), u8(2), u8(1), u8(1), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0)])
    file = array_concat(file, dyn_u16_bytes(u16(2)))
    file = array_concat(file, dyn_u16_bytes(u16(62)))
    file = array_concat(file, dyn_u32_bytes(u32(1)))
    file = array_concat(file, dyn_u64_bytes(u64(4194424)))
    file = array_concat(file, dyn_u64_bytes(u64(64)))
    file = array_concat(file, dyn_u64_bytes(u64(0)))
    file = array_concat(file, dyn_u32_bytes(u32(0)))
    file = array_concat(file, dyn_u16_bytes(u16(64)))
    file = array_concat(file, dyn_u16_bytes(u16(56)))
    file = array_concat(file, dyn_u16_bytes(u16(1)))
    file = array_concat(file, dyn_u16_bytes(u16(0)))
    file = array_concat(file, dyn_u16_bytes(u16(0)))
    file = array_concat(file, dyn_u16_bytes(u16(0)))
    file = array_concat(file, dyn_u32_bytes(u32(1)))
    file = array_concat(file, dyn_u32_bytes(u32(5)))
    file = array_concat(file, dyn_u64_bytes(u64(0)))
    file = array_concat(file, dyn_u64_bytes(u64(4194304)))
    file = array_concat(file, dyn_u64_bytes(u64(4194304)))
    file = array_concat(file, dyn_u64_bytes(u64(file_size)))
    file = array_concat(file, dyn_u64_bytes(u64(file_size)))
    file = array_concat(file, dyn_u64_bytes(u64(4096)))
    file = array_concat(file, code)
    file = array_concat(file, data)
    return bytes_from_u8(file)
}

fn new_dynamic_state() -> EmitState {
    let assembler: Assembler = Assembler{ code: [], code_chunks: [], code_length: 0, data: [], data_by_text: {}, string_data_by_text: {}, labels: ChunkedInts{ pages: [], length: 0 }, jumps: ChunkedJumpPatches{ pages: [], length: 0 }, data_patches: [], frame_patch: -1, string_concat_label: -1, string_concat_used: false, array_alloc_label: -1, array_push_label: -1, array_concat_label: -1, array_runtime_used: false, box_alloc_label: -1, box_runtime_used: false, host_runtime_used: false, windows_abi: false, windows_stack_depth: 0, import_patches: [], function_ranges: [] }
    let env: CompileEnv = CompileEnv{ slots: {}, static_values: {}, struct_fields: {}, function_labels: {}, function_returns: {}, next_slot: 0, breaks: [], continues: [], end_label: -1, trap_label: -1, buffer_offset: 1, in_function: false, current_function: "" }
    return EmitState{ assembler: assembler, env: env, code_patches: ChunkedCodePatches{ pages: [], length: 0 }, code_pages: ChunkedCode{ pages: [], chunk_count: 0, length: 0 } }
}

fn count_slots(statements: Json) -> Int {
    let count: Int = result_unwrap(json_array_len(statements))
    let mut index: Int = 0
    let mut total: Int = 0
    while index < count {
        let statement: Json = result_unwrap(json_array_get(statements, index))
        let kind: String = text(field(statement, "kind"))
        if kind == "let" || kind == "const" {
            total = total + 1
        }
        if kind == "if" {
            total = total + count_slots(field(statement, "then"))
            total = total + count_slots(field(statement, "else"))
        }
        if kind == "while" {
            total = total + count_slots(field(statement, "body"))
        }
        if kind == "for" {
            total = total + 3 + count_slots(field(statement, "body"))
        }
        index = index + 1
    }
    return total
}

fn count_function_slots(statements: Json, struct_fields: Map[String, Json]) -> Result[Int, String] {
    let count: Int = result_unwrap(json_array_len(statements))
    let mut index: Int = 0
    let mut total: Int = 0
    while index < count {
        let statement: Json = result_unwrap(json_array_get(statements, index))
        let kind: String = text(field(statement, "kind"))
        if kind == "let" || kind == "const" {
            let type_name: String = expr_type(field(statement, "init"))
            if !is_scalar_type(type_name) && !map_contains_key(struct_fields, type_name) { return err("dynamic backend: function local '" + text(field(statement, "name")) + "' has unsupported type '" + type_name + "'") }
            total = total + 1
        }
        if kind == "if" {
            let then_count: Result[Int, String] = count_function_slots(field(statement, "then"), struct_fields)
            if is_err(then_count) { return err(unwrap_or(result_error(then_count), "dynamic backend: function local scan failed")) }
            total = total + result_unwrap(then_count)
            let else_count: Result[Int, String] = count_function_slots(field(statement, "else"), struct_fields)
            if is_err(else_count) { return err(unwrap_or(result_error(else_count), "dynamic backend: function local scan failed")) }
            total = total + result_unwrap(else_count)
        }
        if kind == "while" {
            let body_count: Result[Int, String] = count_function_slots(field(statement, "body"), struct_fields)
            if is_err(body_count) { return err(unwrap_or(result_error(body_count), "dynamic backend: function local scan failed")) }
            total = total + result_unwrap(body_count)
        }
        if kind == "for" {
            total = total + 3
            let body_count: Result[Int, String] = count_function_slots(field(statement, "body"), struct_fields)
            if is_err(body_count) { return err(unwrap_or(result_error(body_count), "dynamic backend: function loop scan failed")) }
            total = total + result_unwrap(body_count)
        }
        index = index + 1
    }
    return ok(total)
}

fn collect_struct_fields(structs: Json) -> Map[String, Json] {
    let mut result: Map[String, Json] = {}
    let count: Int = result_unwrap(json_array_len(structs))
    let mut index: Int = 0
    while index < count {
        let definition: Json = result_unwrap(json_array_get(structs, index))
        result = map_insert(result, text(field(definition, "name")), field(definition, "fields"))
        index = index + 1
    }
    return result
}

fn collect_type_fields(structs: Json, enums: Json) -> Map[String, Json] {
    let mut result: Map[String, Json] = collect_struct_fields(structs)
    let count: Int = result_unwrap(json_array_len(enums))
    let mut index: Int = 0
    while index < count {
        let definition: Json = result_unwrap(json_array_get(enums, index))
        result = map_insert(result, text(field(definition, "name")), field(definition, "variants"))
        index = index + 1
    }
    return result
}

fn enum_variant_index(type_fields: Map[String, Json], enum_name: String, variant_name: String) -> Int {
    let variants: Option[Json] = map_get(type_fields, enum_name)
    if is_none(variants) { return -1 }
    let values: Json = unwrap_or(variants, result_unwrap(json_parse("[]")))
    let count: Int = result_unwrap(json_array_len(values))
    let mut index: Int = 0
    while index < count {
        if text(result_unwrap(json_array_get(values, index))) == variant_name { return index }
        index = index + 1
    }
    return -1
}

fn entry_statements(document: Json) -> Json {
    let statements: Json = field(document, "statements")
    if result_unwrap(json_array_len(statements)) > 0 {
        return statements
    }
    let functions: Json = field(document, "functions")
    let count: Int = result_unwrap(json_array_len(functions))
    let mut index: Int = 0
    while index < count {
        let function: Json = result_unwrap(json_array_get(functions, index))
        if text(field(function, "name")) == "main" {
            return field(function, "body")
        }
        index = index + 1
    }
    return result_unwrap(json_parse("[]"))
}

fn is_scalar_type(type_name: String) -> Bool {
    return type_name == "Int" || type_name == "Bool" || type_name == "String" || type_name == "Bytes" || type_name == "Json" || starts_with(type_name, "UInt") || starts_with(type_name, "Array[") || starts_with(type_name, "Option[") || starts_with(type_name, "Result[") || starts_with(type_name, "Map[")
}

fn prepare_function_labels(state: EmitState, functions: Json) -> Result[EmitState, String] {
    let count: Int = result_unwrap(json_array_len(functions))
    let mut index: Int = 0
    let mut current: EmitState = state
    while index < count {
        let function: Json = result_unwrap(json_array_get(functions, index))
        let name: String = text(field(function, "name"))
        if name != "main" {
            if map_contains_key(current.env.function_labels, name) { return err("dynamic backend: duplicate function '" + name + "'") }
            let parameters: Json = field(function, "params")
            let parameter_count: Int = result_unwrap(json_array_len(parameters))
            if !state.assembler.windows_abi && parameter_count > 6 { return err("dynamic backend: function '" + name + "' has too many parameters") }
            let return_type: String = text(field(function, "return"))
            if return_type != "Nil" && !is_supported_type(state.env, return_type) { return err("dynamic backend: function '" + name + "' has unsupported return type '" + return_type + "'") }
            let mut parameter_index: Int = 0
            while parameter_index < parameter_count {
                let parameter: Json = result_unwrap(json_array_get(parameters, parameter_index))
                if !is_supported_type(state.env, text(field(parameter, "type"))) { return err("dynamic backend: function '" + name + "' has an unsupported parameter type") }
                parameter_index = parameter_index + 1
            }
            let created: LabelState = new_label(current)
            let env: CompileEnv = CompileEnv{ slots: created.state.env.slots, static_values: created.state.env.static_values, struct_fields: created.state.env.struct_fields, function_labels: map_insert(created.state.env.function_labels, name, created.label), function_returns: map_insert(created.state.env.function_returns, name, return_type), next_slot: created.state.env.next_slot, breaks: created.state.env.breaks, continues: created.state.env.continues, end_label: created.state.env.end_label, trap_label: created.state.env.trap_label, buffer_offset: created.state.env.buffer_offset, in_function: created.state.env.in_function, current_function: created.state.env.current_function }
            current = state_with_env(created.state, env)
        }
        index = index + 1
    }
    return ok(current)
}

fn emit_function_bodies(state: EmitState, functions: Json, index: Int, base_env: CompileEnv) -> Result[EmitState, String] {
    let count: Int = result_unwrap(json_array_len(functions))
    let mut current: EmitState = state
    let mut current_index: Int = index
    while current_index < count {
            let function: Json = result_unwrap(json_array_get(functions, current_index))
            let name: String = text(field(function, "name"))
        if name != "main" {
            let label: Int = unwrap_or(map_get(base_env.function_labels, name), -1)
            let bound: Result[EmitState, String] = bind_label(current, label)
            if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind function label")) }
            let function_begin: Int = result_unwrap(bound).assembler.code_length
            let parameters: Json = field(function, "params")
            let parameter_count: Int = result_unwrap(json_array_len(parameters))
            let locals: Result[Int, String] = count_function_slots(field(function, "body"), base_env.struct_fields)
            if is_err(locals) { return err(unwrap_or(result_error(locals), "dynamic backend: function local scan failed")) }
            let next_slot: Int = parameter_count * 8 + result_unwrap(locals) * 8
            let buffer_offset: Int = next_slot + 1
            let function_env: CompileEnv = CompileEnv{ slots: parameter_slots(parameters), static_values: {}, struct_fields: base_env.struct_fields, function_labels: base_env.function_labels, function_returns: base_env.function_returns, next_slot: parameter_count * 8, breaks: [], continues: [], end_label: base_env.end_label, trap_label: base_env.trap_label, buffer_offset: buffer_offset, in_function: true, current_function: name }
            let function_frame: Int = align_frame(buffer_offset + 63)
            let framed: EmitState = emit_function_frame(state_with_env(result_unwrap(bound), function_env), function_frame)
            let mut stored: Result[EmitState, String] = ok(framed)
            let mut parameter_index: Int = 0
            while parameter_index < parameter_count {
                let parameter: Json = result_unwrap(json_array_get(parameters, parameter_index))
                let slot: Int = unwrap_or(map_get(function_env.slots, text(field(parameter, "name"))), -1)
                let next: Result[EmitState, String] = emit_store_arg(result_unwrap(stored), parameter_index, slot)
                if is_err(next) { return err(unwrap_or(result_error(next), "dynamic backend: parameter storage failed")) }
                stored = next
                parameter_index = parameter_index + 1
            }
            let body: Result[EmitState, String] = compile_statements(result_unwrap(stored), field(function, "body"))
            if is_err(body) { return err(compile_error(body)) }
            current = append_code(result_unwrap(body), [u8(201), u8(195)])
            if current.assembler.windows_abi {
                let ranges: Array[Array[Int]] = array_push(current.assembler.function_ranges, [function_begin, current.assembler.code_length, function_frame])
                current = state_with_function_ranges(current, ranges)
            }
        }
        current_index = current_index + 1
    }
    return ok(state_with_env(current, base_env))
}

fn expression_uses_runtime(expression: Json, target: String) -> Bool {
    if json_kind(expression) == "null" { return false }
    let kind: String = text(field(expression, "kind"))
    if kind == "call" {
        let call_target: String = text(field(expression, "call_target"))
        if call_target == target {
            let arguments: Json = field(expression, "args")
            let argument_count: Int = result_unwrap(json_array_len(arguments))
            if argument_count != 1 { return true }
            let argument: Json = result_unwrap(json_array_get(arguments, 0))
            let argument_type: String = expr_type(argument)
            if target == "builtin:str" && argument_type != "String" { return true }
            if target == "builtin:int" && argument_type == "String" { return true }
        }
        let arguments: Json = field(expression, "args")
        let count: Int = result_unwrap(json_array_len(arguments))
        let mut index: Int = 0
        while index < count {
            if expression_uses_runtime(result_unwrap(json_array_get(arguments, index)), target) { return true }
            index = index + 1
        }
        return false
    }
    if kind == "binary" {
        return expression_uses_runtime(field(expression, "left"), target) || expression_uses_runtime(field(expression, "right"), target)
    }
    if kind == "unary" || kind == "propagate" {
        return expression_uses_runtime(field(expression, "operand"), target)
    }
    if kind == "index" {
        return expression_uses_runtime(field(expression, "base"), target) || expression_uses_runtime(field(expression, "left"), target)
    }
    if kind == "field" { return expression_uses_runtime(field(expression, "base"), target) }
    if kind == "array" || kind == "set" {
        let items: Json = field(expression, "items")
        let count: Int = result_unwrap(json_array_len(items))
        let mut index: Int = 0
        while index < count {
            if expression_uses_runtime(result_unwrap(json_array_get(items, index)), target) { return true }
            index = index + 1
        }
        return false
    }
    if kind == "map" {
        let keys: Json = field(expression, "map_keys")
        let key_count: Int = result_unwrap(json_array_len(keys))
        let mut index: Int = 0
        while index < key_count {
            if expression_uses_runtime(result_unwrap(json_array_get(keys, index)), target) { return true }
            index = index + 1
        }
    }
    if kind == "struct" || kind == "map" {
        let values: Json = field(expression, "values")
        let value_count: Int = result_unwrap(json_array_len(values))
        let mut value_index: Int = 0
        while value_index < value_count {
            if expression_uses_runtime(result_unwrap(json_array_get(values, value_index)), target) { return true }
            value_index = value_index + 1
        }
    }
    return false
}

fn statements_use_runtime(statements: Json, target: String) -> Bool {
    let count: Int = result_unwrap(json_array_len(statements))
    let mut index: Int = 0
    while index < count {
        let statement: Json = result_unwrap(json_array_get(statements, index))
        let kind: String = text(field(statement, "kind"))
        if kind == "let" || kind == "const" {
            if expression_uses_runtime(field(statement, "init"), target) { return true }
        }
        if kind == "expr" {
            if expression_uses_runtime(field(statement, "expr"), target) { return true }
        }
        if kind == "assign" {
            if expression_uses_runtime(field(statement, "target"), target) { return true }
            if expression_uses_runtime(field(statement, "value"), target) { return true }
        }
        if kind == "if" {
            if expression_uses_runtime(field(statement, "cond"), target) { return true }
            if statements_use_runtime(field(statement, "then"), target) { return true }
            if statements_use_runtime(field(statement, "else"), target) { return true }
        }
        if kind == "while" {
            if expression_uses_runtime(field(statement, "cond"), target) { return true }
            if statements_use_runtime(field(statement, "body"), target) { return true }
        }
        if kind == "return" {
            if expression_uses_runtime(field(statement, "return"), target) { return true }
        }
        if kind == "for" {
            if expression_uses_runtime(field(statement, "iter"), target) { return true }
            if statements_use_runtime(field(statement, "body"), target) { return true }
        }
        if kind == "match" {
            if expression_uses_runtime(field(statement, "scrutinee"), target) { return true }
            let arms: Json = field(statement, "arms")
            let arm_count: Int = result_unwrap(json_array_len(arms))
            let mut arm_index: Int = 0
            while arm_index < arm_count {
                let arm: Json = result_unwrap(json_array_get(arms, arm_index))
                if statements_use_runtime(field(arm, "body"), target) { return true }
                arm_index = arm_index + 1
            }
        }
        if kind == "defer" {
            if expression_uses_runtime(field(statement, "expr"), target) { return true }
        }
        if kind == "unsafe" {
            if statements_use_runtime(field(statement, "body"), target) { return true }
        }
        index = index + 1
    }
    return false
}

fn document_uses_runtime(document: Json, target: String) -> Bool {
    if statements_use_runtime(field(document, "statements"), target) { return true }
    let functions: Json = field(document, "functions")
    let function_count: Int = result_unwrap(json_array_len(functions))
    let mut function_index: Int = 0
    while function_index < function_count {
        let function: Json = result_unwrap(json_array_get(functions, function_index))
        if statements_use_runtime(field(function, "body"), target) { return true }
        let parameters: Json = field(function, "params")
        let parameter_count: Int = result_unwrap(json_array_len(parameters))
        let mut parameter_index: Int = 0
        while parameter_index < parameter_count {
            let parameter: Json = result_unwrap(json_array_get(parameters, parameter_index))
            if expression_uses_runtime(field(parameter, "default"), target) { return true }
            parameter_index = parameter_index + 1
        }
        function_index = function_index + 1
    }
    return false
}

fn pe_scalar_type(type_name: String) -> Bool {
    return type_name == "Int" || type_name == "Bool" || type_name == "String" || type_name == "UInt8" || type_name == "UInt16" || type_name == "UInt32" || type_name == "UInt64"
}

fn pe_array_element_type(type_name: String) -> String {
    if !starts_with(type_name, "Array[") || !ends_with(type_name, "]") { return "" }
    let characters: Array[String] = string_chars(type_name)
    let count: Int = len(characters)
    if count < 8 { return "" }
    let element_type: Result[String, String] = substring(type_name, 6, count - 7)
    if is_err(element_type) { return "" }
    return pe_trim_type_text(result_unwrap(element_type))
}

fn pe_is_supported_array_type(enums: Json, type_name: String) -> Bool {
    let element_type: String = pe_array_element_type(type_name)
    return element_type != "" && pe_supported_type(enums, element_type)
}

fn pe_trim_type_text(value: String) -> String {
    let char_count: Int = len(string_chars(value))
    let mut start: Int = 0
    while start < char_count {
        let leading_character: Result[String, String] = substring(value, start, 1)
        if is_err(leading_character) { return "" }
        if result_unwrap(leading_character) != " " { break }
        start = start + 1
    }
    let mut end: Int = char_count
    while end > start {
        let trailing_character: Result[String, String] = substring(value, end - 1, 1)
        if is_err(trailing_character) { return "" }
        if result_unwrap(trailing_character) != " " { break }
        end = end - 1
    }
    let trimmed: Result[String, String] = substring(value, start, end - start)
    if is_err(trimmed) { return "" }
    return result_unwrap(trimmed)
}

fn pe_map_value_type(type_name: String) -> String {
    if !starts_with(type_name, "Map[") || !ends_with(type_name, "]") { return "" }
    let characters: Array[String] = string_chars(type_name)
    let count: Int = len(characters)
    let mut index: Int = 4
    let mut depth: Int = 0
    let mut comma: Int = -1
    while index < count - 1 {
        let current_result: Result[String, String] = substring(type_name, index, 1)
        if is_err(current_result) { return "" }
        let current: String = result_unwrap(current_result)
        if current == "[" {
            depth = depth + 1
        } else if current == "]" {
            if depth > 0 { depth = depth - 1 }
        } else if current == "," && depth == 0 {
            comma = index
            break
        }
        index = index + 1
    }
    if comma < 0 { return "" }
    let key_type: Result[String, String] = substring(type_name, 4, comma - 4)
    if is_err(key_type) || pe_trim_type_text(result_unwrap(key_type)) != "String" { return "" }
    let value_type: Result[String, String] = substring(type_name, comma + 1, count - comma - 2)
    if is_err(value_type) { return "" }
    return pe_trim_type_text(result_unwrap(value_type))
}

fn pe_is_supported_string_map_type(enums: Json, type_name: String) -> Bool {
    let value_type: String = pe_map_value_type(type_name)
    return value_type != "" && pe_supported_type(enums, value_type)
}

fn pe_supported_local_type(enums: Json, structs: Json, type_name: String) -> Bool {
    return pe_supported_type_with_structs(enums, structs, type_name) || pe_is_supported_array_type(enums, type_name) || pe_is_supported_string_map_type(enums, type_name)
}

fn pe_is_function_call(expression: Json) -> Bool {
    return text(field(expression, "kind")) == "call" && starts_with(text(field(expression, "call_target")), "function:")
}

fn pe_validate_function_arguments(expression: Json, enums: Json, structs: Json) -> Result[Bool, String] {
    let arguments: Json = field(expression, "args")
    let count: Int = result_unwrap(json_array_len(arguments))
    let mut index: Int = 0
    while index < count {
        let argument: Json = result_unwrap(json_array_get(arguments, index))
        if pe_is_struct_type(structs, expr_type(argument)) { return err("PE backend: struct function arguments are not supported") }
        let checked: Result[Bool, String] = pe_validate_expression(argument, false, false, enums, structs)
        if is_err(checked) { return checked }
        index = index + 1
    }
    return ok(true)
}

fn pe_validate_map_expression(expression: Json, enums: Json, structs: Json) -> Result[Bool, String] {
    let map_type: String = expr_type(expression)
    let value_type: String = pe_map_value_type(map_type)
    if value_type == "" || !pe_supported_type(enums, value_type) { return err("PE backend: maps require String keys and scalar or fieldless-enum values") }
    let kind: String = text(field(expression, "kind"))
    if kind == "var" { return ok(true) }
    if pe_is_function_call(expression) { return pe_validate_function_arguments(expression, enums, structs) }
    if kind != "map" { return err("PE backend: maps require a local literal or an existing local map") }
    let keys: Json = field(expression, "map_keys")
    let values: Json = field(expression, "values")
    let count: Int = result_unwrap(json_array_len(keys))
    if result_unwrap(json_array_len(values)) != count { return err("PE backend: map literal key/value count mismatch") }
    let mut seen: Map[String, Bool] = {}
    let mut index: Int = 0
    while index < count {
        let key: Json = result_unwrap(json_array_get(keys, index))
        let value: Json = result_unwrap(json_array_get(values, index))
        if text(field(key, "kind")) != "string" { return err("PE backend: map literal keys must be String literals") }
        if expr_type(value) != value_type { return err("PE backend: map literal values must match " + value_type) }
        let key_text: String = text(field(key, "string"))
        if map_contains_key(seen, key_text) { return err("PE backend: duplicate map literal key '" + key_text + "'") }
        let checked_value: Result[Bool, String] = pe_validate_expression(value, false, false, enums, structs)
        if is_err(checked_value) { return checked_value }
        seen = map_insert(seen, key_text, true)
        index = index + 1
    }
    return ok(true)
}

fn pe_validate_map_call(expression: Json, enums: Json, structs: Json) -> Result[Bool, String] {
    let target: String = text(field(expression, "call_target"))
    let args: Json = field(expression, "args")
    let count: Int = result_unwrap(json_array_len(args))
    if target == "builtin:map_contains_key" || target == "builtin:map_get" {
        if count != 2 { return err("PE backend: map lookup expects Map[String,T] and String") }
        let map_value: Json = result_unwrap(json_array_get(args, 0))
        let key: Json = result_unwrap(json_array_get(args, 1))
        let map_value_type: String = pe_map_value_type(expr_type(map_value))
        if map_value_type == "" || !pe_supported_type(enums, map_value_type) || expr_type(key) != "String" { return err("PE backend: map lookup supports String-keyed maps with scalar or fieldless-enum values") }
        if target == "builtin:map_contains_key" && expr_type(expression) != "Bool" { return err("PE backend: map_contains_key must return Bool") }
        if target == "builtin:map_get" && expr_type(expression) != "Option[" + map_value_type + "]" { return err("PE backend: map_get must return Option[" + map_value_type + "]") }
        let checked_map: Result[Bool, String] = pe_validate_map_expression(map_value, enums, structs)
        if is_err(checked_map) { return checked_map }
        return pe_validate_expression(key, false, false, enums, structs)
    }
    if target == "builtin:unwrap_or" {
        if count != 2 { return err("PE backend: unwrap_or expects a supported Option[T] and a T fallback") }
        let option: Json = result_unwrap(json_array_get(args, 0))
        let fallback: Json = result_unwrap(json_array_get(args, 1))
        if text(field(option, "kind")) != "call" || text(field(option, "call_target")) != "builtin:map_get" {
            return err("PE backend: unwrap_or supports only a direct map_get with a matching fallback")
        }
        let lookup_args: Json = field(option, "args")
        if result_unwrap(json_array_len(lookup_args)) != 2 { return err("PE backend: unwrap_or map_get expects two arguments") }
        let map_value: Json = result_unwrap(json_array_get(lookup_args, 0))
        let value_type: String = pe_map_value_type(expr_type(map_value))
        if value_type == "" || expr_type(option) != "Option[" + value_type + "]" || expr_type(expression) != value_type || expr_type(fallback) != value_type {
            return err("PE backend: unwrap_or map_get requires a fallback matching the map value type")
        }
        let checked_option: Result[Bool, String] = pe_validate_map_call(option, enums, structs)
        if is_err(checked_option) { return checked_option }
        return pe_validate_expression(fallback, false, false, enums, structs)
    }
    return err("PE backend: map builtins are not supported except read-only String-keyed lookup")
}

fn pe_is_enum_type(enums: Json, type_name: String) -> Bool {
    let count: Int = result_unwrap(json_array_len(enums))
    let mut index: Int = 0
    while index < count {
        let definition: Json = result_unwrap(json_array_get(enums, index))
        if text(field(definition, "name")) == type_name { return true }
        index = index + 1
    }
    return false
}

fn pe_supported_type(enums: Json, type_name: String) -> Bool {
    return pe_scalar_type(type_name) || pe_is_enum_type(enums, type_name)
}

fn pe_is_struct_type(structs: Json, type_name: String) -> Bool {
    let count: Int = result_unwrap(json_array_len(structs))
    let mut index: Int = 0
    while index < count {
        let definition: Json = result_unwrap(json_array_get(structs, index))
        if text(field(definition, "name")) == type_name { return true }
        index = index + 1
    }
    return false
}

fn pe_supported_type_with_structs(enums: Json, structs: Json, type_name: String) -> Bool {
    return pe_supported_type(enums, type_name) || pe_is_struct_type(structs, type_name)
}

fn pe_struct_field_type(structs: Json, type_name: String, field_name: String) -> String {
    let count: Int = result_unwrap(json_array_len(structs))
    let mut struct_index: Int = 0
    while struct_index < count {
        let definition: Json = result_unwrap(json_array_get(structs, struct_index))
        if text(field(definition, "name")) == type_name {
            let fields: Json = field(definition, "fields")
            let field_count: Int = result_unwrap(json_array_len(fields))
            let mut field_index: Int = 0
            while field_index < field_count {
                let candidate: Json = result_unwrap(json_array_get(fields, field_index))
                if text(field(candidate, "name")) == field_name { return text(field(candidate, "type")) }
                field_index = field_index + 1
            }
            return ""
        }
        struct_index = struct_index + 1
    }
    return ""
}

fn pe_validate_structs(structs: Json, enums: Json) -> Result[Bool, String] {
    let count: Int = result_unwrap(json_array_len(structs))
    let mut names: Map[String, Bool] = {}
    let mut struct_index: Int = 0
    while struct_index < count {
        let definition: Json = result_unwrap(json_array_get(structs, struct_index))
        let name: String = text(field(definition, "name"))
        if name == "" || map_contains_key(names, name) || pe_is_enum_type(enums, name) { return err("PE backend: struct names must be non-empty and unique") }
        names = map_insert(names, name, true)
        let fields: Json = field(definition, "fields")
        let field_count: Int = result_unwrap(json_array_len(fields))
        let mut field_names: Map[String, Bool] = {}
        let mut field_index: Int = 0
        while field_index < field_count {
            let declared: Json = result_unwrap(json_array_get(fields, field_index))
            let field_name: String = text(field(declared, "name"))
            let field_type: String = text(field(declared, "type"))
            if field_name == "" || map_contains_key(field_names, field_name) { return err("PE backend: struct '" + name + "' has an empty or duplicate field") }
            if !pe_scalar_type(field_type) && !pe_is_enum_type(enums, field_type) { return err("PE backend: struct '" + name + "' field '" + field_name + "' must have a scalar or enum type") }
            field_names = map_insert(field_names, field_name, true)
            field_index = field_index + 1
        }
        struct_index = struct_index + 1
    }
    return ok(true)
}

fn pe_has_enum_variant(enums: Json, type_name: String, variant_name: String) -> Bool {
    let count: Int = result_unwrap(json_array_len(enums))
    let mut index: Int = 0
    while index < count {
        let definition: Json = result_unwrap(json_array_get(enums, index))
        if text(field(definition, "name")) == type_name {
            let variants: Json = field(definition, "variants")
            let variant_count: Int = result_unwrap(json_array_len(variants))
            let mut variant_index: Int = 0
            while variant_index < variant_count {
                if text(result_unwrap(json_array_get(variants, variant_index))) == variant_name { return true }
                variant_index = variant_index + 1
            }
            return false
        }
        index = index + 1
    }
    return false
}

fn pe_validate_enums(enums: Json) -> Result[Bool, String] {
    let count: Int = result_unwrap(json_array_len(enums))
    let mut names: Map[String, Bool] = {}
    let mut index: Int = 0
    while index < count {
        let definition: Json = result_unwrap(json_array_get(enums, index))
        let name: String = text(field(definition, "name"))
        if name == "" || map_contains_key(names, name) { return err("PE backend: enum names must be non-empty and unique") }
        names = map_insert(names, name, true)
        let variants: Json = field(definition, "variants")
        let variant_count: Int = result_unwrap(json_array_len(variants))
        if variant_count == 0 { return err("PE backend: enum '" + name + "' must declare at least one variant") }
        let mut seen: Map[String, Bool] = {}
        let mut variant_index: Int = 0
        while variant_index < variant_count {
            let variant: String = text(result_unwrap(json_array_get(variants, variant_index)))
            if variant == "" || map_contains_key(seen, variant) { return err("PE backend: enum '" + name + "' has an empty or duplicate variant") }
            seen = map_insert(seen, variant, true)
            variant_index = variant_index + 1
        }
        index = index + 1
    }
    return ok(true)
}

fn pe_validate_expression(expression: Json, allow_nil: Bool, allow_output: Bool, enums: Json, structs: Json) -> Result[Bool, String] {
    if json_kind(expression) == "null" { return err("PE backend: missing expression") }
    let kind: String = text(field(expression, "kind"))
    let type_name: String = expr_type(expression)
    if kind == "nil" {
        if allow_nil { return ok(true) }
        return err("PE backend: Nil is only valid as a void return")
    }
    let mut call_target: String = ""
    if kind == "call" { call_target = text(field(expression, "call_target")) }
    let nil_builtin: Bool = kind == "call" && (call_target == "builtin:print" || call_target == "builtin:println" || call_target == "builtin:assert" || call_target == "builtin:assert_eq" || starts_with(call_target, "function:"))
    if call_target == "builtin:map_contains_key" || call_target == "builtin:map_get" || call_target == "builtin:unwrap_or" {
        return pe_validate_map_call(expression, enums, structs)
    }
    if starts_with(call_target, "builtin:map_") { return err("PE backend: map builtins are not supported except read-only String-keyed lookup") }
    if starts_with(call_target, "builtin:array_") { return err("PE backend: array builtins are not supported except len(Array[T]) and local indexing") }
    if kind == "enum" {
        let enum_name: String = text(field(expression, "enum_type"))
        let variant_name: String = text(field(expression, "enum_variant"))
        if type_name != enum_name || !pe_has_enum_variant(enums, enum_name, variant_name) { return err("PE backend: unknown enum variant '" + enum_name + "::" + variant_name + "'") }
        return ok(true)
    }
    if kind == "struct" {
        let struct_name: String = text(field(expression, "struct_name"))
        if type_name != struct_name || !pe_is_struct_type(structs, struct_name) { return err("PE backend: unknown struct literal '" + struct_name + "'") }
        let mut struct_index: Int = 0
        let mut declared_fields: Json = result_unwrap(json_parse("[]"))
        while struct_index < result_unwrap(json_array_len(structs)) {
            let definition: Json = result_unwrap(json_array_get(structs, struct_index))
            if text(field(definition, "name")) == struct_name { declared_fields = field(definition, "fields") }
            struct_index = struct_index + 1
        }
        let fields: Json = field(expression, "fields")
        let values: Json = field(expression, "values")
        let field_count: Int = result_unwrap(json_array_len(fields))
        if field_count != result_unwrap(json_array_len(values)) || field_count != result_unwrap(json_array_len(declared_fields)) { return err("PE backend: struct literal '" + struct_name + "' has mismatched fields and values") }
        let mut seen_fields: Map[String, Bool] = {}
        let mut field_index: Int = 0
        while field_index < field_count {
            let field_name: String = text(result_unwrap(json_array_get(fields, field_index)))
            let value: Json = result_unwrap(json_array_get(values, field_index))
            let expected_type: String = pe_struct_field_type(structs, struct_name, field_name)
            if expected_type == "" || map_contains_key(seen_fields, field_name) { return err("PE backend: struct literal '" + struct_name + "' references an unknown or duplicate field '" + field_name + "'") }
            if expr_type(value) != expected_type { return err("PE backend: struct literal '" + struct_name + "' field '" + field_name + "' has an incompatible value") }
            let checked_value: Result[Bool, String] = pe_validate_expression(value, false, false, enums, structs)
            if is_err(checked_value) { return checked_value }
            seen_fields = map_insert(seen_fields, field_name, true)
            field_index = field_index + 1
        }
        return ok(true)
    }
    if kind == "field" {
        let base: Json = field(expression, "base")
        let base_type: String = expr_type(base)
        let field_name: String = text(field(expression, "field"))
        if text(field(base, "kind")) != "var" || !pe_is_struct_type(structs, base_type) { return err("PE backend: field reads require a local scalar-field struct") }
        let expected_type: String = pe_struct_field_type(structs, base_type, field_name)
        if expected_type == "" || expected_type != type_name { return err("PE backend: unknown or mismatched field '" + field_name + "' in struct '" + base_type + "'") }
        return ok(true)
    }
    if kind == "binary" && (starts_with(expr_type(field(expression, "left")), "Array[") || starts_with(expr_type(field(expression, "right")), "Array[")) {
        return err("PE backend: array binary operations are not supported")
    }
    if starts_with(type_name, "Map[") { return pe_validate_map_expression(expression, enums, structs) }
    if starts_with(type_name, "Array[") && !pe_is_supported_array_type(enums, type_name) { return err("PE backend: arrays require scalar or fieldless-enum element types") }
    if pe_is_supported_array_type(enums, type_name) && kind != "array" && kind != "var" && !pe_is_function_call(expression) {
        return err("PE backend: array values are only supported as literals and local variables")
    }
    if !pe_supported_type_with_structs(enums, structs, type_name) && !pe_is_supported_array_type(enums, type_name) && !nil_builtin { return err("PE backend: unsupported expression type '" + type_name + "'") }
    if kind == "array" {
        let element_type: String = pe_array_element_type(type_name)
        if element_type == "" || !pe_supported_type(enums, element_type) { return err("PE backend: arrays require scalar or fieldless-enum element types") }
        let items: Json = field(expression, "items")
        let count: Int = result_unwrap(json_array_len(items))
        let mut item_index: Int = 0
        while item_index < count {
            let item: Json = result_unwrap(json_array_get(items, item_index))
            if expr_type(item) != element_type { return err("PE backend: array literal elements must match " + element_type) }
            let checked_item: Result[Bool, String] = pe_validate_expression(item, false, false, enums, structs)
            if is_err(checked_item) { return checked_item }
            item_index = item_index + 1
        }
        return ok(true)
    }
    if kind == "index" {
        let base: Json = field(expression, "base")
        let index: Json = field(expression, "left")
        let element_type: String = pe_array_element_type(expr_type(base))
        if text(field(base, "kind")) != "var" || element_type == "" || !pe_is_supported_array_type(enums, expr_type(base)) {
            return err("PE backend: indexing is supported only through a local supported array variable")
        }
        if type_name != element_type || expr_type(index) != "Int" { return err("PE backend: array indexing requires an Int index and returns the array element type") }
        let checked_base: Result[Bool, String] = pe_validate_expression(base, false, false, enums, structs)
        if is_err(checked_base) { return checked_base }
        return pe_validate_expression(index, false, false, enums, structs)
    }
    if kind == "int" || kind == "uint" || kind == "bool" || kind == "string" || kind == "var" { return ok(true) }
    if kind == "unary" {
        if pe_is_struct_type(structs, expr_type(field(expression, "operand"))) { return err("PE backend: struct values are not unary operands") }
        let operator: String = text(field(expression, "operator"))
        if operator != "+" && operator != "-" && operator != "!" && operator != "~" { return err("PE backend: unsupported unary operator '" + operator + "'") }
        return pe_validate_expression(field(expression, "operand"), false, false, enums, structs)
    }
    if kind == "binary" {
        if pe_is_struct_type(structs, expr_type(field(expression, "left"))) || pe_is_struct_type(structs, expr_type(field(expression, "right"))) { return err("PE backend: struct values do not support binary operations") }
        if type_name == "String" || expr_type(field(expression, "left")) == "String" { return err("PE backend: String binary operations are not supported") }
        let operator: String = text(field(expression, "operator"))
        if operator != "+" && operator != "-" && operator != "*" && operator != "/" && operator != "%" && operator != "&" && operator != "^" && operator != "|" && operator != "<<" && operator != ">>" && operator != "&&" && operator != "||" && operator != "==" && operator != "!=" && operator != "<" && operator != "<=" && operator != ">" && operator != ">=" {
            return err("PE backend: unsupported binary operator '" + operator + "'")
        }
        let left: Result[Bool, String] = pe_validate_expression(field(expression, "left"), false, false, enums, structs)
        if is_err(left) { return left }
        return pe_validate_expression(field(expression, "right"), false, false, enums, structs)
    }
    if kind == "call" {
        if pe_is_struct_type(structs, type_name) { return err("PE backend: struct function returns are not supported") }
        let target: String = call_target
        let args: Json = field(expression, "args")
        let count: Int = result_unwrap(json_array_len(args))
        if starts_with(target, "function:") {
            return pe_validate_function_arguments(expression, enums, structs)
        }
        if target == "builtin:int" {
            if count != 1 { return err("PE backend: int expects one scalar integer argument") }
            let integer_argument: Json = result_unwrap(json_array_get(args, 0))
            if expr_type(integer_argument) != "Int" && expr_type(integer_argument) != "Bool" && !starts_with(expr_type(integer_argument), "UInt") { return err("PE backend: int supports Int, Bool, and UInt, but not String parsing") }
            return pe_validate_expression(integer_argument, false, false, enums, structs)
        }
        if target == "builtin:str" {
            if count != 1 { return err("PE backend: str expects one integer or Bool argument") }
            let display_argument: Json = result_unwrap(json_array_get(args, 0))
            let display_type: String = expr_type(display_argument)
            if display_type != "Int" && display_type != "Bool" && !starts_with(display_type, "UInt") { return err("PE backend: str supports Int, Bool, and UInt values") }
            return pe_validate_expression(display_argument, false, false, enums, structs)
        }
        if target == "builtin:len" {
            if count != 1 { return err("PE backend: len expects one supported Array[T] argument") }
            let array_argument: Json = result_unwrap(json_array_get(args, 0))
            if !pe_is_supported_array_type(enums, expr_type(array_argument)) { return err("PE backend: len supports only arrays with scalar or fieldless-enum elements") }
            let checked_array: Result[Bool, String] = pe_validate_expression(array_argument, false, false, enums, structs)
            if is_err(checked_array) { return checked_array }
            return ok(true)
        }
        if target == "builtin:u8" || target == "builtin:u16" || target == "builtin:u32" || target == "builtin:u64" {
            if count != 1 { return err("PE backend: unsigned conversion expects one argument") }
            if !starts_with(expr_type(result_unwrap(json_array_get(args, 0))), "UInt") && expr_type(result_unwrap(json_array_get(args, 0))) != "Int" { return err("PE backend: unsigned conversion requires an integer") }
            return pe_validate_expression(result_unwrap(json_array_get(args, 0)), false, false, enums, structs)
        }
        if target == "builtin:assert" {
            if count != 1 || expr_type(result_unwrap(json_array_get(args, 0))) != "Bool" { return err("PE backend: assert expects one Bool") }
            return pe_validate_expression(result_unwrap(json_array_get(args, 0)), false, false, enums, structs)
        }
        if target == "builtin:assert_eq" {
            if count != 2 { return err("PE backend: assert_eq expects two scalar arguments") }
            let left: Json = result_unwrap(json_array_get(args, 0))
            let right: Json = result_unwrap(json_array_get(args, 1))
            if expr_type(left) != expr_type(right) || pe_is_struct_type(structs, expr_type(left)) || !pe_supported_type(enums, expr_type(left)) || expr_type(left) == "String" { return err("PE backend: assert_eq supports matching scalar or enum arguments") }
            let checked_left: Result[Bool, String] = pe_validate_expression(left, false, false, enums, structs)
            if is_err(checked_left) { return checked_left }
            return pe_validate_expression(right, false, false, enums, structs)
        }
        if !allow_output || (target != "builtin:print" && target != "builtin:println") || count != 1 { return err("PE backend: only statement-form print(value) and println(value) are supported") }
        let output: Json = result_unwrap(json_array_get(args, 0))
        if pe_is_enum_type(enums, expr_type(output)) { return err("PE backend: printing enum values is not supported") }
        if pe_is_struct_type(structs, expr_type(output)) { return err("PE backend: printing structs is not supported") }
        if starts_with(expr_type(output), "Array[") { return err("PE backend: printing arrays is not supported") }
        if starts_with(expr_type(output), "Map[") { return err("PE backend: printing maps is not supported") }
        return pe_validate_expression(output, false, false, enums, structs)
    }
    return err("PE backend: unsupported expression kind '" + kind + "'")
}

fn pe_validate_statements(statements: Json, enums: Json, structs: Json) -> Result[Bool, String] {
    let count: Int = result_unwrap(json_array_len(statements))
    let mut index: Int = 0
    while index < count {
        let statement: Json = result_unwrap(json_array_get(statements, index))
        let kind: String = text(field(statement, "kind"))
        if kind == "let" || kind == "const" {
            let init: Json = field(statement, "init")
            if starts_with(expr_type(init), "Map[") && !pe_is_supported_string_map_type(enums, expr_type(init)) { return err("PE backend: maps require String keys and scalar or fieldless-enum values") }
            if starts_with(expr_type(init), "Array[") && !pe_is_supported_array_type(enums, expr_type(init)) { return err("PE backend: arrays require scalar or fieldless-enum element types") }
            if !pe_supported_local_type(enums, structs, expr_type(init)) { return err("PE backend: binding '" + text(field(statement, "name")) + "' has an unsupported type") }
            if text(field(init, "kind")) == "call" && starts_with(text(field(init, "call_target")), "builtin:array_") { return err("PE backend: array builtins are not supported except len(Array[T]) and local indexing") }
            if text(field(init, "kind")) == "call" && starts_with(text(field(init, "call_target")), "builtin:map_") && text(field(init, "call_target")) != "builtin:map_contains_key" { return err("PE backend: map builtins are not supported except read-only String-keyed lookup") }
            if starts_with(expr_type(init), "Array[") && text(field(init, "kind")) == "binary" { return err("PE backend: array binary operations are not supported") }
            if pe_is_supported_array_type(enums, expr_type(init)) && text(field(init, "kind")) != "array" && text(field(init, "kind")) != "var" && !pe_is_function_call(init) { return err("PE backend: array locals require a literal, an existing local array, or a function result") }
            if pe_is_supported_string_map_type(enums, expr_type(init)) && text(field(init, "kind")) != "map" && text(field(init, "kind")) != "var" && !pe_is_function_call(init) { return err("PE backend: map locals require a literal, an existing local map, or a function result") }
            if pe_is_struct_type(structs, expr_type(init)) && text(field(init, "kind")) != "struct" { return err("PE backend: struct bindings require a local struct literal") }
            let checked: Result[Bool, String] = pe_validate_expression(init, false, false, enums, structs)
            if is_err(checked) { return checked }
        } else if kind == "assign" {
            let target: Json = field(statement, "target")
            let value: Json = field(statement, "value")
            if starts_with(expr_type(target), "Map[") || starts_with(expr_type(value), "Map[") { return err("PE backend: map reassignment is not supported") }
            if starts_with(expr_type(target), "Array[") || starts_with(expr_type(value), "Array[") { return err("PE backend: array mutation and reassignment are not supported") }
            if text(field(target, "kind")) == "index" && starts_with(expr_type(field(target, "base")), "Array[") { return err("PE backend: array element mutation is not supported") }
            if text(field(target, "kind")) != "var" || pe_is_struct_type(structs, expr_type(value)) || !pe_supported_type(enums, expr_type(value)) { return err("PE backend: assignment requires a scalar or enum local") }
            let checked: Result[Bool, String] = pe_validate_expression(value, false, false, enums, structs)
            if is_err(checked) { return checked }
        } else if kind == "expr" {
            let expression: Json = field(statement, "expr")
            if text(field(expression, "kind")) != "call" { return err("PE backend: expression statements must be direct calls") }
            let target: String = text(field(expression, "call_target"))
            let checked: Result[Bool, String] = pe_validate_expression(expression, false, target == "builtin:print" || target == "builtin:println", enums, structs)
            if is_err(checked) { return checked }
        } else if kind == "if" {
            let condition: Json = field(statement, "cond")
            if expr_type(condition) != "Bool" { return err("PE backend: if condition must be Bool") }
            let checked_condition: Result[Bool, String] = pe_validate_expression(condition, false, false, enums, structs)
            if is_err(checked_condition) { return checked_condition }
            let checked_then: Result[Bool, String] = pe_validate_statements(field(statement, "then"), enums, structs)
            if is_err(checked_then) { return checked_then }
            let checked_else: Result[Bool, String] = pe_validate_statements(field(statement, "else"), enums, structs)
            if is_err(checked_else) { return checked_else }
        } else if kind == "while" {
            let condition: Json = field(statement, "cond")
            if expr_type(condition) != "Bool" { return err("PE backend: while condition must be Bool") }
            let checked_condition: Result[Bool, String] = pe_validate_expression(condition, false, false, enums, structs)
            if is_err(checked_condition) { return checked_condition }
            let checked_body: Result[Bool, String] = pe_validate_statements(field(statement, "body"), enums, structs)
            if is_err(checked_body) { return checked_body }
        } else if kind == "return" {
            let value: Json = field(statement, "return")
            if json_kind(value) != "null" {
                if pe_is_struct_type(structs, expr_type(value)) { return err("PE backend: struct returns are not supported") }
                let checked: Result[Bool, String] = pe_validate_expression(value, true, false, enums, structs)
                if is_err(checked) { return checked }
            }
        } else if kind != "break" && kind != "continue" {
            return err("PE backend: unsupported statement kind '" + kind + "'")
        }
        index = index + 1
    }
    return ok(true)
}

fn pe_validate_document(document: Json) -> Result[Bool, String] {
    let target: Json = field(document, "target")
    if text(field(target, "os")) != "windows" || text(field(target, "arch")) != "amd64" || result_unwrap(json_bool(field(target, "gui"))) {
        return err("PE backend: target must be windows-amd64 console")
    }
    let enums: Json = field(document, "enums")
    let enum_valid: Result[Bool, String] = pe_validate_enums(enums)
    if is_err(enum_valid) { return enum_valid }
    let structs: Json = field(document, "structs")
    let struct_valid: Result[Bool, String] = pe_validate_structs(structs, enums)
    if is_err(struct_valid) { return struct_valid }
    let checked_top: Result[Bool, String] = pe_validate_statements(field(document, "statements"), enums, structs)
    if is_err(checked_top) { return checked_top }
    let functions: Json = field(document, "functions")
    let function_count: Int = result_unwrap(json_array_len(functions))
    let mut index: Int = 0
    let mut has_main: Bool = false
    while index < function_count {
        let function: Json = result_unwrap(json_array_get(functions, index))
        let name: String = text(field(function, "name"))
        if result_unwrap(json_bool(field(function, "worker"))) || result_unwrap(json_bool(field(function, "unsafe"))) || text(field(function, "receiver")) != "" || result_unwrap(json_array_len(field(function, "type_params"))) != 0 {
            return err("PE backend: worker, unsafe, receiver, and generic functions are not supported")
        }
        if name == "main" {
            has_main = true
            if result_unwrap(json_array_len(field(function, "params"))) != 0 || text(field(function, "return")) != "Nil" { return err("PE backend: main must have no arguments and return Nil") }
        } else {
            if pe_is_struct_type(structs, text(field(function, "return"))) { return err("PE backend: struct function returns are not supported") }
            if !pe_supported_local_type(enums, structs, text(field(function, "return"))) && text(field(function, "return")) != "Nil" { return err("PE backend: function '" + name + "' has an unsupported return type") }
        }
        let parameters: Json = field(function, "params")
        let parameter_count: Int = result_unwrap(json_array_len(parameters))
        let mut parameter_index: Int = 0
        while parameter_index < parameter_count {
            let parameter: Json = result_unwrap(json_array_get(parameters, parameter_index))
            if pe_is_struct_type(structs, text(field(parameter, "type"))) || !pe_supported_local_type(enums, structs, text(field(parameter, "type"))) || json_kind(field(parameter, "default")) != "null" { return err("PE backend: function parameters require supported scalar, enum, or collection types and no defaults") }
            parameter_index = parameter_index + 1
        }
        let checked_body: Result[Bool, String] = pe_validate_statements(field(function, "body"), enums, structs)
        if is_err(checked_body) { return checked_body }
        index = index + 1
    }
    if !has_main && result_unwrap(json_array_len(field(document, "statements"))) == 0 { return err("PE backend: document has no entry statements or main function") }
    return ok(true)
}

fn compile_dynamic(document: Json) -> Result[Bytes, String] {
    let target: Json = field(document, "target")
    let windows_target: Bool = text(field(target, "os")) == "windows" && text(field(target, "arch")) == "amd64"
    if !windows_target && (text(field(target, "os")) != "linux" || text(field(target, "arch")) != "amd64") { return err("dynamic backend supports linux-amd64 and a scalar windows-amd64 subset") }
    if windows_target {
        let valid: Result[Bool, String] = pe_validate_document(document)
        if is_err(valid) { return err(unwrap_or(result_error(valid), "PE backend: document validation failed")) }
    }
    let functions: Json = field(document, "functions")
    let function_count: Int = result_unwrap(json_array_len(functions))
    let struct_fields: Map[String, Json] = collect_type_fields(field(document, "structs"), field(document, "enums"))
    let statements: Json = entry_statements(document)
    let uses_int_to_string: Bool = document_uses_runtime(document, "builtin:str")
    let uses_int_from_string: Bool = document_uses_runtime(document, "builtin:int")
    let mut state: EmitState = emit_prologue(state_with_windows_abi(new_dynamic_state(), windows_target))
    let end_label: LabelState = new_label(state)
    let trap_label: LabelState = new_label(end_label.state)
    let string_concat_label: LabelState = new_label(trap_label.state)
    let array_alloc_label: LabelState = new_label(string_concat_label.state)
    let array_push_label: LabelState = new_label(array_alloc_label.state)
    let array_concat_label: LabelState = new_label(array_push_label.state)
    let box_alloc_label: LabelState = new_label(array_concat_label.state)
    let struct_reserved_label: LabelState = new_label(box_alloc_label.state)
    let host_string_label: LabelState = new_label(struct_reserved_label.state)
    let host_chars_label: LabelState = new_label(host_string_label.state)
    let host_equal_label: LabelState = new_label(host_chars_label.state)
    let host_map_find_label: LabelState = new_label(host_equal_label.state)
    let host_map_insert_label: LabelState = new_label(host_map_find_label.state)
    let host_substring_label: LabelState = new_label(host_map_insert_label.state)
    let host_int_to_string_label: LabelState = new_label(host_substring_label.state)
    let host_int_from_string_label: LabelState = new_label(host_int_to_string_label.state)
    let host_bytes_label: LabelState = new_label(host_int_from_string_label.state)
    let host_u8_label: LabelState = new_label(host_bytes_label.state)
    let host_process_label: LabelState = new_label(host_u8_label.state)
    let host_read_label: LabelState = new_label(host_process_label.state)
    let host_write_label: LabelState = new_label(host_read_label.state)
    let host_array_set_label: LabelState = new_label(host_write_label.state)
    let host_array_slice_label: LabelState = new_label(host_array_set_label.state)
    let host_json_skip_label: LabelState = new_label(host_array_slice_label.state)
    let host_json_parse_label: LabelState = new_label(host_json_skip_label.state)
    let host_json_kind_label: LabelState = new_label(host_json_parse_label.state)
    let host_json_object_get_label: LabelState = new_label(host_json_kind_label.state)
    let host_json_array_len_label: LabelState = new_label(host_json_object_get_label.state)
    let host_json_array_get_label: LabelState = new_label(host_json_array_len_label.state)
    let host_json_string_label: LabelState = new_label(host_json_array_get_label.state)
    let host_json_bool_label: LabelState = new_label(host_json_string_label.state)
    let host_json_int_label: LabelState = new_label(host_json_bool_label.state)
    let host_json_uint_label: LabelState = new_label(host_json_int_label.state)
    let host_map_remove_label: LabelState = new_label(host_json_uint_label.state)
    let slot_count: Int = count_slots(statements)
    state = state_with_string_concat_label(host_map_remove_label.state, string_concat_label.label)
    state = state_with_array_labels(state, array_alloc_label.label, array_push_label.label, array_concat_label.label)
    state = state_with_box_label(state, box_alloc_label.label)
    state = state_with_env(state, CompileEnv{ slots: {}, static_values: {}, struct_fields: struct_fields, function_labels: {}, function_returns: {}, next_slot: 0, breaks: [], continues: [], end_label: end_label.label, trap_label: trap_label.label, buffer_offset: slot_count * 8 + 1, in_function: false, current_function: "" })
    let prepared: Result[EmitState, String] = prepare_function_labels(state, functions)
    if is_err(prepared) { return err(unwrap_or(result_error(prepared), "dynamic backend: function preparation failed")) }
    state = result_unwrap(prepared)
    let compiled: Result[EmitState, String] = compile_statements(state, statements)
    if is_err(compiled) { return err(compile_error(compiled)) }
    let main_state: EmitState = result_unwrap(compiled)
    let mut lowered: EmitState = main_state
    if function_count > 0 || main_state.assembler.string_concat_used || main_state.assembler.array_runtime_used || main_state.assembler.box_runtime_used || main_state.assembler.host_runtime_used {
        lowered = emit_jump(lowered, end_label.label, false, u8(0))
        if windows_target {
            let main_frame: Int = align_frame(main_state.env.buffer_offset + 63)
            lowered = state_with_function_ranges(lowered, array_push(lowered.assembler.function_ranges, [0, lowered.assembler.code_length, main_frame]))
        }
        let emitted: Result[EmitState, String] = emit_function_bodies(lowered, functions, 0, main_state.env)
        if is_err(emitted) { return err(unwrap_or(result_error(emitted), "dynamic backend: function lowering failed")) }
        lowered = result_unwrap(emitted)
    } else if windows_target {
        let main_frame: Int = align_frame(main_state.env.buffer_offset + 63)
        lowered = state_with_function_ranges(lowered, array_push(lowered.assembler.function_ranges, [0, lowered.assembler.code_length, main_frame]))
    }
    if lowered.assembler.host_runtime_used {
        // The host slice always emits process_args, whose runtime allocates
        // its result through the shared Array allocator, just like the Go
        // direct backend marks arrayRuntimeUsed while finalizing host code.
        lowered = state_with_array_used(lowered)
        let json_skip_runtime: Result[EmitState, String] = emit_json_skip_runtime(lowered)
        if is_err(json_skip_runtime) { return err(unwrap_or(result_error(json_skip_runtime), "dynamic backend: JSON scanner lowering failed")) }
        lowered = result_unwrap(json_skip_runtime)
        let json_parse_runtime: Result[EmitState, String] = emit_json_parse_runtime(lowered)
        if is_err(json_parse_runtime) { return err(unwrap_or(result_error(json_parse_runtime), "dynamic backend: JSON parse lowering failed")) }
        lowered = result_unwrap(json_parse_runtime)
        let json_kind_runtime: Result[EmitState, String] = emit_json_kind_runtime(lowered)
        if is_err(json_kind_runtime) { return err(unwrap_or(result_error(json_kind_runtime), "dynamic backend: JSON kind lowering failed")) }
        lowered = result_unwrap(json_kind_runtime)
        let json_object_get_runtime: Result[EmitState, String] = emit_json_object_get_runtime(lowered)
        if is_err(json_object_get_runtime) { return err(unwrap_or(result_error(json_object_get_runtime), "dynamic backend: JSON object access lowering failed")) }
        lowered = result_unwrap(json_object_get_runtime)
        let json_array_len_runtime: Result[EmitState, String] = emit_json_array_len_runtime(lowered)
        if is_err(json_array_len_runtime) { return err(unwrap_or(result_error(json_array_len_runtime), "dynamic backend: JSON array length lowering failed")) }
        lowered = result_unwrap(json_array_len_runtime)
        let json_array_get_runtime: Result[EmitState, String] = emit_json_array_get_runtime(lowered)
        if is_err(json_array_get_runtime) { return err(unwrap_or(result_error(json_array_get_runtime), "dynamic backend: JSON array access lowering failed")) }
        lowered = result_unwrap(json_array_get_runtime)
        let json_bool_runtime: Result[EmitState, String] = emit_json_bool_runtime(lowered)
        if is_err(json_bool_runtime) { return err(unwrap_or(result_error(json_bool_runtime), "dynamic backend: JSON bool lowering failed")) }
        lowered = result_unwrap(json_bool_runtime)
        let json_int_runtime: Result[EmitState, String] = emit_json_int_runtime(lowered)
        if is_err(json_int_runtime) { return err(unwrap_or(result_error(json_int_runtime), "dynamic backend: JSON Int lowering failed")) }
        lowered = result_unwrap(json_int_runtime)
        let json_uint_runtime: Result[EmitState, String] = emit_json_uint_runtime(lowered)
        if is_err(json_uint_runtime) { return err(unwrap_or(result_error(json_uint_runtime), "dynamic backend: JSON UInt lowering failed")) }
        lowered = result_unwrap(json_uint_runtime)
        let json_string_runtime: Result[EmitState, String] = emit_json_string_runtime(lowered)
        if is_err(json_string_runtime) { return err(unwrap_or(result_error(json_string_runtime), "dynamic backend: JSON String lowering failed")) }
        lowered = result_unwrap(json_string_runtime)
        let string_runtime: Result[EmitState, String] = emit_string_alloc_runtime(lowered)
        if is_err(string_runtime) { return err(unwrap_or(result_error(string_runtime), "dynamic backend: host String runtime lowering failed")) }
        lowered = result_unwrap(string_runtime)
        let substring_runtime: Result[EmitState, String] = emit_substring_runtime(lowered)
        if is_err(substring_runtime) { return err(unwrap_or(result_error(substring_runtime), "dynamic backend: substring runtime lowering failed")) }
        lowered = result_unwrap(substring_runtime)
        let chars_runtime: Result[EmitState, String] = emit_string_chars_runtime(lowered)
        if is_err(chars_runtime) { return err(unwrap_or(result_error(chars_runtime), "dynamic backend: string_chars runtime lowering failed")) }
        lowered = result_unwrap(chars_runtime)
        if uses_int_to_string {
            let int_string_runtime: Result[EmitState, String] = emit_int_to_string_runtime(lowered)
            if is_err(int_string_runtime) { return err(unwrap_or(result_error(int_string_runtime), "dynamic backend: host Int-to-String runtime lowering failed")) }
            lowered = result_unwrap(int_string_runtime)
        }
        if uses_int_from_string {
            let string_int_runtime: Result[EmitState, String] = emit_int_from_string_runtime(lowered)
            if is_err(string_int_runtime) { return err(unwrap_or(result_error(string_int_runtime), "dynamic backend: host String-to-Int runtime lowering failed")) }
            lowered = result_unwrap(string_int_runtime)
        }
        let string_equal_runtime: Result[EmitState, String] = emit_string_equal_runtime(lowered)
        if is_err(string_equal_runtime) { return err(unwrap_or(result_error(string_equal_runtime), "dynamic backend: String equality runtime lowering failed")) }
        lowered = result_unwrap(string_equal_runtime)
        let map_find_runtime: Result[EmitState, String] = emit_map_find_runtime(lowered)
        if is_err(map_find_runtime) { return err(unwrap_or(result_error(map_find_runtime), "dynamic backend: map lookup runtime lowering failed")) }
        lowered = result_unwrap(map_find_runtime)
        let map_insert_runtime: Result[EmitState, String] = emit_map_insert_runtime(lowered)
        if is_err(map_insert_runtime) { return err(unwrap_or(result_error(map_insert_runtime), "dynamic backend: map insert runtime lowering failed")) }
        lowered = result_unwrap(map_insert_runtime)
        let map_remove_runtime: Result[EmitState, String] = emit_map_remove_runtime(lowered)
        if is_err(map_remove_runtime) { return err(unwrap_or(result_error(map_remove_runtime), "dynamic backend: map remove runtime lowering failed")) }
        lowered = result_unwrap(map_remove_runtime)
        let bytes_runtime: Result[EmitState, String] = emit_bytes_from_array_runtime(lowered)
        if is_err(bytes_runtime) { return err(unwrap_or(result_error(bytes_runtime), "dynamic backend: host Bytes runtime lowering failed")) }
        lowered = result_unwrap(bytes_runtime)
        let u8_runtime: Result[EmitState, String] = emit_u8_array_runtime(lowered)
        if is_err(u8_runtime) { return err(unwrap_or(result_error(u8_runtime), "dynamic backend: host u8_array runtime lowering failed")) }
        lowered = result_unwrap(u8_runtime)
        let args_runtime: Result[EmitState, String] = emit_process_args_runtime(lowered)
        if is_err(args_runtime) { return err(unwrap_or(result_error(args_runtime), "dynamic backend: process_args runtime lowering failed")) }
        lowered = result_unwrap(args_runtime)
        let read_runtime: Result[EmitState, String] = emit_fs_read_text_runtime(lowered)
        if is_err(read_runtime) { return err(unwrap_or(result_error(read_runtime), "dynamic backend: fs_read_text runtime lowering failed")) }
        lowered = result_unwrap(read_runtime)
        let write_runtime: Result[EmitState, String] = emit_fs_write_bytes_runtime(lowered)
        if is_err(write_runtime) { return err(unwrap_or(result_error(write_runtime), "dynamic backend: fs_write_bytes runtime lowering failed")) }
        lowered = result_unwrap(write_runtime)
        let array_set_runtime: Result[EmitState, String] = emit_array_set_runtime(lowered)
        if is_err(array_set_runtime) { return err(unwrap_or(result_error(array_set_runtime), "dynamic backend: array_set runtime lowering failed")) }
        lowered = result_unwrap(array_set_runtime)
        let array_slice_runtime: Result[EmitState, String] = emit_array_slice_runtime(lowered)
        if is_err(array_slice_runtime) { return err(unwrap_or(result_error(array_slice_runtime), "dynamic backend: array_slice runtime lowering failed")) }
        lowered = result_unwrap(array_slice_runtime)
    }
    if lowered.assembler.string_concat_used {
        let runtime: Result[EmitState, String] = emit_string_concat_runtime(lowered)
        if is_err(runtime) { return err(unwrap_or(result_error(runtime), "dynamic backend: String runtime lowering failed")) }
        lowered = result_unwrap(runtime)
    }
    if lowered.assembler.array_runtime_used {
        let allocator: Result[EmitState, String] = emit_array_alloc_runtime(lowered)
        if is_err(allocator) { return err(unwrap_or(result_error(allocator), "dynamic backend: Array allocator lowering failed")) }
        let pushed: Result[EmitState, String] = emit_array_push_runtime(result_unwrap(allocator))
        if is_err(pushed) { return err(unwrap_or(result_error(pushed), "dynamic backend: Array push lowering failed")) }
        let concatenated: Result[EmitState, String] = emit_array_concat_runtime(result_unwrap(pushed))
        if is_err(concatenated) { return err(unwrap_or(result_error(concatenated), "dynamic backend: Array concat lowering failed")) }
        lowered = result_unwrap(concatenated)
    }
    if lowered.assembler.box_runtime_used {
        let boxed: Result[EmitState, String] = emit_box_alloc_runtime(lowered)
        if is_err(boxed) { return err(unwrap_or(result_error(boxed), "dynamic backend: Option/Result runtime lowering failed")) }
        lowered = result_unwrap(boxed)
    }
    let ended: Result[EmitState, String] = bind_label(lowered, end_label.label)
    if is_err(ended) { return err(unwrap_or(result_error(ended), "dynamic backend: cannot bind end")) }
    let normal: EmitState = emit_exit(result_unwrap(ended), u8(0))
    let trapped: Result[EmitState, String] = bind_label(normal, trap_label.label)
    if is_err(trapped) { return err(unwrap_or(result_error(trapped), "dynamic backend: cannot bind trap")) }
    let failed: EmitState = emit_exit(result_unwrap(trapped), u8(1))
    let prepared_code: Result[EmitState, String] = prepare_code_pages(failed)
    if is_err(prepared_code) { return err(unwrap_or(result_error(prepared_code), "dynamic backend: cannot prepare code chunks for patching")) }
    let page_state: EmitState = result_unwrap(prepared_code)
    let frame: Result[EmitState, String] = patch_code(page_state, page_state.assembler.frame_patch, i32_bytes(align_frame(page_state.env.buffer_offset + 63)))
    if is_err(frame) { return err(unwrap_or(result_error(frame), "dynamic backend: frame patch failed")) }
    let jumps: Result[EmitState, String] = finalize_jumps(result_unwrap(frame))
    if is_err(jumps) {
        let message: String = unwrap_or(result_error(jumps), "dynamic backend: jump finalization failed")
        return err(message)
    }
    let mut data: Result[EmitState, String] = ok(result_unwrap(jumps))
    if !windows_target { data = finalize_data(result_unwrap(jumps)) }
    if is_err(data) {
        let message: String = unwrap_or(result_error(data), "dynamic backend: data finalization failed")
        return err(message)
    }
    let patched: Result[EmitState, String] = apply_code_patches(result_unwrap(data))
    if is_err(patched) { return err(unwrap_or(result_error(patched), "dynamic backend: code patch application failed")) }
    let result: EmitState = flatten_code_pages(result_unwrap(patched))
    if windows_target {
        let mut data_patches: Array[Array[Int]] = []
        for index in array_indices(result.assembler.data_patches) {
            let patch: DataPatch = unwrap_or(array_get(result.assembler.data_patches, index), DataPatch{ displacement: -1, instruction_end: -1, data_offset: -1 })
            data_patches = array_push(data_patches, [patch.displacement, patch.instruction_end, patch.data_offset])
        }
        let mut import_patches: Array[Array[Int]] = []
        for index in array_indices(result.assembler.import_patches) {
            let patch: PEImportPatch = unwrap_or(array_get(result.assembler.import_patches, index), PEImportPatch{ displacement: -1, instruction_end: -1, import_index: -1 })
            import_patches = array_push(import_patches, [patch.displacement, patch.instruction_end, patch.import_index])
        }
        let needs_heap: Bool = result.assembler.string_concat_used || result.assembler.array_runtime_used || result.assembler.box_runtime_used || result.assembler.host_runtime_used
        let imports: Array[Array[String]] = pe_dynamic_imports(needs_heap)
        return emit_pe32plus_with_imports_and_data_patches(result.assembler.code, result.assembler.data, imports, data_patches, import_patches, result.assembler.function_ranges)
    }
    return ok(emit_dynamic_elf(result.assembler.code, result.assembler.data))
}

fn has_dynamic_expression(expression: Json) -> Bool {
    let kind: String = text(field(expression, "kind"))
    if kind == "array" || kind == "index" { return true }
    if kind == "call" {
        let target: String = text(field(expression, "call_target"))
        if target == "builtin:int" || target == "builtin:len" || target == "builtin:bytes" || target == "builtin:process_args" || target == "builtin:fs_read_text" || target == "builtin:fs_write_bytes" || target == "builtin:array_push" || target == "builtin:array_get" || target == "builtin:array_indices" || target == "builtin:array_concat" || target == "builtin:some" || target == "builtin:none" || target == "builtin:ok" || target == "builtin:err" || target == "builtin:is_some" || target == "builtin:is_none" || target == "builtin:is_ok" || target == "builtin:is_err" || target == "builtin:unwrap_or" || target == "builtin:result_unwrap" || target == "builtin:result_error" {
            return true
        }
        let arguments: Json = field(expression, "args")
        let count: Int = result_unwrap(json_array_len(arguments))
        let mut index: Int = 0
        while index < count {
            if has_dynamic_expression(result_unwrap(json_array_get(arguments, index))) { return true }
            index = index + 1
        }
        return false
    }
    if kind == "binary" {
        return has_dynamic_expression(field(expression, "left")) || has_dynamic_expression(field(expression, "right"))
    }
    if kind == "unary" { return has_dynamic_expression(field(expression, "operand")) }
    return false
}

fn has_dynamic(statements: Json) -> Bool {
    let count: Int = result_unwrap(json_array_len(statements))
    let mut index: Int = 0
    while index < count {
        let statement: Json = result_unwrap(json_array_get(statements, index))
        let kind: String = text(field(statement, "kind"))
        if kind == "if" || kind == "while" || kind == "assign" || kind == "break" || kind == "continue" { return true }
        if kind == "let" || kind == "const" {
            if result_unwrap(json_bool(field(statement, "mutable"))) { return true }
            if has_dynamic_expression(field(statement, "init")) { return true }
        }
        if kind == "expr" && has_dynamic_expression(field(statement, "expr")) { return true }
        index = index + 1
    }
    return false
}

pub fn compile_document(document: Json) -> Result[Bytes, String] {
    if result_unwrap(json_array_len(field(document, "functions"))) > 0 {
        let dynamic: Result[Bytes, String] = compile_dynamic(document)
        if is_err(dynamic) { return err("dynamic compile failed: " + unwrap_or(result_error(dynamic), "unknown error")) }
        return dynamic
    }
    if has_dynamic(field(document, "statements")) {
        let dynamic: Result[Bytes, String] = compile_dynamic(document)
        if is_err(dynamic) { return err("dynamic compile failed: " + unwrap_or(result_error(dynamic), "unknown error")) }
        return dynamic
    }
    return compile_kir(document)
}
