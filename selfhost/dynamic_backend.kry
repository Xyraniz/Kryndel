fn emit_json_parse_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, host_json_parse_label(state))
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind JSON parse runtime")) }
    let failure: LabelState = new_label(result_unwrap(bound))
    let trailing_loop: LabelState = new_label(failure.state)
    let trailing_next: LabelState = new_label(trailing_loop.state)
    let success: LabelState = new_label(trailing_next.state)
    let mut current: EmitState = append_code(success.state, [
        u8(83), u8(85), u8(65), u8(84), u8(65), u8(85), u8(65), u8(86), u8(65), u8(87),
        u8(73), u8(137), u8(252), u8(77), u8(139), u8(44), u8(36), u8(72), u8(49), u8(246), u8(49), u8(210)
    ])
