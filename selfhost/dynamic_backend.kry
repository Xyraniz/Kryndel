    let bound_done: Result[EmitState, String] = bind_label(current, done.label)
    if is_err(bound_done) { return err(unwrap_or(result_error(bound_done), "dynamic backend: cannot bind substring completion")) }
    return ok(append_code(result_unwrap(bound_done), [u8(65), u8(95), u8(65), u8(94), u8(65), u8(93), u8(65), u8(92), u8(93), u8(91), u8(195)]))
}

fn emit_int_to_string_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, host_int_to_string_label(state))
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind host Int-to-String runtime")) }
    let bool_false: LabelState = new_label(result_unwrap(bound))
    let numeric: LabelState = new_label(bool_false.state)
    let signed: LabelState = new_label(numeric.state)
    let digits: LabelState = new_label(signed.state)
    let digit_loop: LabelState = new_label(digits.state)
    let add_sign: LabelState = new_label(digit_loop.state)
    let ready: LabelState = new_label(add_sign.state)
