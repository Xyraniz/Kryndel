    let count_two: LabelState = new_label(count_one.state)
    let count_three: LabelState = new_label(count_two.state)
    let count_advance: LabelState = new_label(count_three.state)
    let allocate: LabelState = new_label(count_advance.state)
    let bound_count: Result[EmitState, String] = bind_label(allocate.state, count_loop.label)
    if is_err(bound_count) { return err(unwrap_or(result_error(bound_count), "dynamic backend: cannot bind string_chars count loop")) }
    current = append_code(result_unwrap(bound_count), [u8(77), u8(57), u8(238)])
    current = emit_jump(current, allocate.label, true, u8(131))
    current = append_code(current, [u8(75), u8(15), u8(182), u8(68), u8(52), u8(8), u8(60), u8(128)])
    current = emit_jump(current, count_one.label, true, u8(130))
    current = append_code(current, [u8(60), u8(224)])
    current = emit_jump(current, count_two.label, true, u8(130))
    current = append_code(current, [u8(60), u8(240)])
    current = emit_jump(current, count_three.label, true, u8(130))
    current = append_code(current, [u8(73), u8(131), u8(198), u8(4)])
    current = emit_jump(current, count_advance.label, false, u8(0))
