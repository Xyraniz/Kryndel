    current = append_code(current, [u8(77), u8(133), u8(246)])
    current = emit_jump(current, negative_error.label, true, u8(136))
    let bound_start_loop: Result[EmitState, String] = bind_label(current, start_loop.label)
    if is_err(bound_start_loop) { return err(unwrap_or(result_error(bound_start_loop), "dynamic backend: cannot bind substring start loop")) }
    current = append_code(result_unwrap(bound_start_loop), [u8(76), u8(57), u8(237)])
    current = emit_jump(current, start_found.label, true, u8(132))
    current = append_code(current, [u8(76), u8(57), u8(251)])
    current = emit_jump(current, start_error.label, true, u8(131))
