import "elf_backend"
import "native_image"
import "validated_kir"
import "kir_typed_arena"

// Dynamic KIR lowering. This module is the Kryndel implementation of the
// second direct-ELF slice: stack slots, Int/Bool expressions, comparisons,
// assignments, if/else, while, break/continue, and static print values.
// Arrays remain immutable; labels and RIP-relative data references are
// patched with array_set only after all code has been emitted.

struct JumpPatch {
    label: Int,
    position: Int,
    function: String,
}

struct DataPatch {
    displacement: Int,
    instruction_end: Int,
    data_offset: Int,
}

struct PEImportPatch {
    displacement: Int,
    instruction_end: Int,
    import_index: Int,
}

struct ChunkedJumpPatches {
    pages: Array[Array[Array[JumpPatch]]],
    length: Int,
}

struct CodePatch {
    position: Int,
    bytes: Array[UInt8],
}

struct ChunkedCodePatches {
    pages: Array[Array[Array[CodePatch]]],
    length: Int,
}

struct ChunkedCode {
    pages: Array[Array[Array[UInt8]]],
    chunk_count: Int,
    length: Int,
}

struct AssemblerCode {
    code: Array[UInt8],
    code_chunks: Array[Array[UInt8]],
    code_length: Int,
}

struct AssemblerCommon {
    data: Array[UInt8],
    data_by_text: Map[String, Int],
    string_data_by_text: Map[String, Int],
    data_patches: Array[DataPatch],
    frame_patch: Int,
    string_concat_label: Int,
    string_concat_used: Bool,
    array_alloc_label: Int,
    array_push_label: Int,
    array_concat_label: Int,
    array_runtime_used: Bool,
    box_alloc_label: Int,
    box_runtime_used: Bool,
    host_runtime_used: Bool,
    ffi_runtime_used: Bool,
    windows_abi: Bool,
    windows_stack_depth: Int,
    import_patches: Array[PEImportPatch],
    function_ranges: Array[Array[Int]],
}

struct Assembler {
    code_state: AssemblerCode,
    labels: Map[String, Int],
    next_label: Int,
    jumps: ChunkedJumpPatches,
    common: AssemblerCommon,
}

struct CompileEnv {
    slots: Map[String, Int],
    static_values: Map[String, String],
    struct_fields: Map[String, KIRTypedNodeView],
    function_labels: Map[String, Int],
    function_returns: Map[String, String],
    next_slot: Int,
    breaks: Array[Int],
    continues: Array[Int],
    end_label: Int,
    trap_label: Int,
    buffer_offset: Int,
    in_function: Bool,
    current_function: String,
}

struct EmitState {
    assembler: Assembler,
    env: CompileEnv,
    code_patches: ChunkedCodePatches,
    code_pages: ChunkedCode,
}

struct LabelState {
    state: EmitState,
    label: Int,
}

fn field(value: KIRTypedNodeView, key: String) -> KIRTypedNodeView {
    return result_unwrap(kir_typed_object_get(value, key))
}

fn text(value: KIRTypedNodeView) -> String {
    return result_unwrap(kir_typed_string(value))
}

fn i32_bytes(value: Int) -> Array[UInt8] {
    let mut raw: UInt32 = u32(0)
    if value >= 0 {
        raw = u32(value)
    } else {
        raw = u32(4294967296 + value)
    }
    return [
        u8(raw & u32(255)),
        u8((raw >> 8) & u32(255)),
        u8((raw >> 16) & u32(255)),
        u8(raw >> 24)
    ]
}

fn int_u64(value: Int) -> UInt64 {
    if value >= 0 {
        return u64(value)
    }
    return u64(0) - u64(0 - value)
}

fn dyn_u16_bytes(value: UInt16) -> Array[UInt8] {
    return [u8(value & u16(255)), u8(value >> 8)]
}

fn dyn_u32_bytes(value: UInt32) -> Array[UInt8] {
    return [
        u8(value & u32(255)),
        u8((value >> 8) & u32(255)),
        u8((value >> 16) & u32(255)),
        u8(value >> 24)
    ]
}

fn dyn_u64_bytes(value: UInt64) -> Array[UInt8] {
    return [
        u8(value & u64(255)),
        u8((value >> 8) & u64(255)),
        u8((value >> 16) & u64(255)),
        u8((value >> 24) & u64(255)),
        u8((value >> 32) & u64(255)),
        u8((value >> 40) & u64(255)),
        u8((value >> 48) & u64(255)),
        u8(value >> 56)
    ]
}

fn state_with_code(state: EmitState, code: Array[UInt8]) -> EmitState {
    return EmitState{
        assembler: Assembler{ code_state: AssemblerCode{ code: code, code_chunks: [], code_length: len(code) }, labels: state.assembler.labels, next_label: state.assembler.next_label, jumps: state.assembler.jumps, common: state.assembler.common },
        env: state.env,
        code_patches: state.code_patches,
        code_pages: ChunkedCode{ pages: [], chunk_count: 0, length: 0 },
    }
}

