    current = append_code(current, [u8(72), u8(131), u8(120), u8(24), u8(0)])
    current = emit_jump(current, invalid_label.label, true, u8(133))
    current = append_code(current, [u8(72), u8(139), u8(72), u8(8), u8(72), u8(137), u8(207), u8(72), u8(131), u8(199), u8(8)])
    current = emit_heap_alloc(current)
    let saved_bytes: EmitState = emit_push_rax(current)
    current = append_code(saved_bytes, [
        u8(72), u8(139), u8(60), u8(36), u8(72), u8(139), u8(76), u8(36), u8(8), u8(72), u8(139), u8(81), u8(8),
        u8(72), u8(137), u8(23), u8(72), u8(139), u8(49), u8(72), u8(141), u8(127), u8(8), u8(72), u8(137), u8(209), u8(243), u8(164),
        u8(72), u8(139), u8(4), u8(36)
    ])
    current = emit_ffi_stack_drop(current, 16)
    current = emit_box_call(current, u64(0))
    current = emit_jump(current, join_label.label, false, u8(0))
    let invalid_state: EmitState = state_with_windows_stack_depth(current, saved_buffer.assembler.common.windows_stack_depth)
    let bound_invalid: Result[EmitState, String] = bind_label(invalid_state, invalid_label.label)
    if is_err(bound_invalid) { return err(unwrap_or(result_error(bound_invalid), "dynamic backend: cannot bind ffi_buffer_read invalid path")) }
    let cleaned: EmitState = emit_ffi_stack_drop(result_unwrap(bound_invalid), 8)
    let failed: EmitState = emit_ffi_error(cleaned, "invalid or closed FFIBuffer handle")
    let bound_join: Result[EmitState, String] = bind_label(failed, join_label.label)
    if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind ffi_buffer_read result")) }
    return ok(result_unwrap(bound_join))
}

fn emit_ffi_buffer_close(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    let buffer: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 0))
    let emitted: Result[EmitState, String] = emit_expression(state_with_ffi_used(state), buffer)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let mut current: EmitState = emit_push_rax(result_unwrap(emitted))
    current = append_code(current, [u8(72), u8(139), u8(4), u8(36), u8(72), u8(133), u8(192)])
    current = emit_jump(current, current.env.trap_label, true, u8(132))
    current = append_code(current, [u8(72), u8(131), u8(120), u8(24), u8(0)])
    current = emit_jump(current, current.env.trap_label, true, u8(133))
    current = emit_pe_api_import_call(current, pe_get_process_heap_import_index())
    current = append_code(current, [u8(72), u8(137), u8(193), u8(49), u8(210), u8(72), u8(139), u8(4), u8(36), u8(76), u8(139), u8(0)])
    current = emit_ffi_import_call(current, 3)
    current = append_code(current, [u8(72), u8(133), u8(192)])
    current = emit_jump(current, current.env.trap_label, true, u8(132))
    current = append_code(current, [u8(72), u8(139), u8(20), u8(36), u8(72), u8(199), u8(2), u8(0), u8(0), u8(0), u8(0), u8(72), u8(199), u8(66), u8(24), u8(1), u8(0), u8(0), u8(0)])
    current = emit_ffi_stack_drop(current, 8)
    return ok(emit_int(current, 0))
}

fn emit_ffi_call(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    let signature_expression: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 1))
    let array_expression: KIRTypedNodeView = result_unwrap(kir_typed_array_get(arguments, 2))
    let literal_count: Int = -1
    let mut count: Int = literal_count
    if text(field(array_expression, "kind")) == "array" { count = result_unwrap(kir_typed_array_len(field(array_expression, "items"))) }
    let checked_signature: Result[String, String] = pe_ffi_signature(signature_expression, count)
    if count < 0 {
        let raw: String = text(field(signature_expression, "string"))
        let normalized: Result[String, String] = pe_ffi_signature(signature_expression, pe_ffi_signature_arity(raw))
        if is_err(normalized) { return err(unwrap_or(result_error(normalized), "dynamic backend: invalid FFI signature")) }
        return emit_ffi_call_target(state, expression, result_unwrap(normalized))
    }
    if is_err(checked_signature) { return err(unwrap_or(result_error(checked_signature), "dynamic backend: invalid FFI signature")) }
    return emit_ffi_call_target(state, expression, result_unwrap(checked_signature))
}

fn emit_option_predicate(state: EmitState, expression: KIRTypedNodeView, none: Bool) -> Result[EmitState, String] {
    let emitted: Result[EmitState, String] = emit_expression(state, expression)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let mut set: UInt8 = u8(149)
    if none { set = u8(148) }
    return ok(append_code(result_unwrap(emitted), [u8(72), u8(133), u8(192), u8(15), set, u8(192), u8(72), u8(15), u8(182), u8(192)]))
}

fn emit_result_predicate(state: EmitState, expression: KIRTypedNodeView, failed: Bool) -> Result[EmitState, String] {
    let emitted: Result[EmitState, String] = emit_expression(state, expression)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let nil_label: LabelState = new_label(result_unwrap(emitted))
    let join_label: LabelState = new_label(nil_label.state)
    let mut current: EmitState = append_code(join_label.state, [u8(72), u8(133), u8(192)])
    current = emit_jump(current, nil_label.label, true, u8(132))
    current = append_code(current, [u8(72), u8(131), u8(56), u8(0)])
    let mut set: UInt8 = u8(148)
    if failed { set = u8(149) }
    current = append_code(current, [u8(15), set, u8(192), u8(72), u8(15), u8(182), u8(192)])
    current = emit_jump(current, join_label.label, false, u8(0))
    let bound_nil: Result[EmitState, String] = bind_label(current, nil_label.label)
    if is_err(bound_nil) { return err(unwrap_or(result_error(bound_nil), "dynamic backend: cannot bind Result predicate nil path")) }
    current = emit_int(result_unwrap(bound_nil), 0)
    let bound_join: Result[EmitState, String] = bind_label(current, join_label.label)
    if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind Result predicate join")) }
    return ok(result_unwrap(bound_join))
}

fn emit_unwrap_or(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    if result_unwrap(kir_typed_array_len(arguments)) != 2 { return err("dynamic backend: unwrap_or expects two arguments") }
    let first: Result[EmitState, String] = emit_expression(state, result_unwrap(kir_typed_array_get(arguments, 0)))
    if is_err(first) { return err(expression_error(first)) }
    let pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
    let second: Result[EmitState, String] = emit_expression(pushed, result_unwrap(kir_typed_array_get(arguments, 1)))
    if is_err(second) { return err(expression_error(second)) }
    let mut current: EmitState = append_code(result_unwrap(second), [u8(72), u8(137), u8(198), u8(95), u8(72), u8(133), u8(255)])
    let none_label: LabelState = new_label(current)
    let join_label: LabelState = new_label(none_label.state)
    current = emit_jump(join_label.state, none_label.label, true, u8(132))
    current = append_code(current, [u8(72), u8(139), u8(71), u8(8)])
    current = emit_jump(current, join_label.label, false, u8(0))
    let bound_none: Result[EmitState, String] = bind_label(current, none_label.label)
    if is_err(bound_none) { return err(unwrap_or(result_error(bound_none), "dynamic backend: cannot bind unwrap_or none path")) }
    current = append_code(result_unwrap(bound_none), [u8(72), u8(137), u8(240)])
    let bound_join: Result[EmitState, String] = bind_label(current, join_label.label)
    if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind unwrap_or join")) }
    return ok(result_unwrap(bound_join))
}

fn emit_result_unwrap(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let emitted: Result[EmitState, String] = emit_expression(state, expression)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let mut current: EmitState = append_code(result_unwrap(emitted), [u8(72), u8(133), u8(192)])
    current = emit_jump(current, current.env.trap_label, true, u8(132))
    current = append_code(current, [u8(72), u8(131), u8(56), u8(0)])
    current = emit_jump(current, current.env.trap_label, true, u8(133))
    return ok(append_code(current, [u8(72), u8(139), u8(64), u8(8)]))
}

fn emit_result_error(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let emitted: Result[EmitState, String] = emit_expression(state, expression)
    if is_err(emitted) { return err(expression_error(emitted)) }
    let nil_label: LabelState = new_label(result_unwrap(emitted))
    let join_label: LabelState = new_label(nil_label.state)
    let mut current: EmitState = append_code(join_label.state, [u8(72), u8(133), u8(192)])
    current = emit_jump(current, nil_label.label, true, u8(132))
    current = append_code(current, [u8(72), u8(131), u8(56), u8(0)])
    current = emit_jump(current, nil_label.label, true, u8(132))
    current = append_code(current, array_concat([u8(72), u8(139), u8(120), u8(8), u8(72), u8(190)], dyn_u64_bytes(u64(1))))
    let boxed: EmitState = state_with_box_used(current)
    current = emit_label_call(boxed, boxed.assembler.common.box_alloc_label)
    current = emit_jump(current, join_label.label, false, u8(0))
    let bound_nil: Result[EmitState, String] = bind_label(current, nil_label.label)
    if is_err(bound_nil) { return err(unwrap_or(result_error(bound_nil), "dynamic backend: cannot bind result_error nil path")) }
    current = emit_int(result_unwrap(bound_nil), 0)
    let bound_join: Result[EmitState, String] = bind_label(current, join_label.label)
    if is_err(bound_join) { return err(unwrap_or(result_error(bound_join), "dynamic backend: cannot bind result_error join")) }
    return ok(result_unwrap(bound_join))
}

fn emit_array_get(state: EmitState, expression: KIRTypedNodeView) -> Result[EmitState, String] {
    let arguments: KIRTypedNodeView = field(expression, "args")
    if result_unwrap(kir_typed_array_len(arguments)) != 2 { return err("dynamic backend: array_get expects two arguments") }
