    let failure: LabelState = new_label(result_unwrap(bound))
    let trailing_loop: LabelState = new_label(failure.state)
    let trailing_next: LabelState = new_label(trailing_loop.state)
    let success: LabelState = new_label(trailing_next.state)
    let mut current: EmitState = append_code(success.state, [
