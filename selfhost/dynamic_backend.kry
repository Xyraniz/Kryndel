    return EmitState{
        assembler: Assembler{ code: code, code_chunks: [], code_length: len(code), data: state.assembler.data, data_by_text: state.assembler.data_by_text, string_data_by_text: state.assembler.string_data_by_text, labels: state.assembler.labels, jumps: state.assembler.jumps, data_patches: state.assembler.data_patches, frame_patch: state.assembler.frame_patch, string_concat_label: state.assembler.string_concat_label, string_concat_used: state.assembler.string_concat_used, array_alloc_label: state.assembler.array_alloc_label, array_push_label: state.assembler.array_push_label, array_concat_label: state.assembler.array_concat_label, array_runtime_used: state.assembler.array_runtime_used, box_alloc_label: state.assembler.box_alloc_label, box_runtime_used: state.assembler.box_runtime_used, host_runtime_used: state.assembler.host_runtime_used, windows_abi: state.assembler.windows_abi, windows_stack_depth: state.assembler.windows_stack_depth, import_patches: state.assembler.import_patches, function_ranges: state.assembler.function_ranges },
        env: state.env,
        code_patches: state.code_patches,
        code_pages: ChunkedCode{ pages: [], chunk_count: 0, length: 0 },
    }
}

