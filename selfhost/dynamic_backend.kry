fn emit_string_chars_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, host_string_chars_label(state))
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind string_chars runtime")) }
    // rdi=String. Count UTF-8 code points, then put each String header and its
    // one-to-four bytes in a compact arena instead of mmaping one page per
    // character. This matters when the source compiler tokenizes large files.
    let mut current: EmitState = append_code(result_unwrap(bound), [
        u8(83), u8(85), u8(65), u8(84), u8(65), u8(85), u8(65), u8(86), u8(65), u8(87),
        u8(73), u8(137), u8(252), u8(77), u8(139), u8(44), u8(36), u8(77), u8(49), u8(246), u8(77), u8(49), u8(255)
    ])
    current = state_with_array_used(current)
    let count_loop: LabelState = new_label(current)
