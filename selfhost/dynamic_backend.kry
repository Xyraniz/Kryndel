fn emit_json_call_aligned(state: EmitState, label: Int) -> EmitState {
    // Runtime helpers can be entered with different live RSP alignments on PE.
    // Preserve the caller's RBP while using it to restore the original stack.
    let mut current: EmitState = append_code(state, [u8(85), u8(72), u8(137), u8(229), u8(72), u8(131), u8(228), u8(240)])
    if current.assembler.common.windows_abi { current = append_code(current, [u8(72), u8(131), u8(236), u8(32)]) }
    current = emit_relative_call(current, label)
    return append_code(current, [u8(72), u8(137), u8(236), u8(93)])
}

fn emit_json_expect_byte(state: EmitState, value: Int, failure: Int) -> EmitState {
    let mut current: EmitState = append_code(state, [u8(77), u8(57), u8(238)])
    current = emit_jump(current, failure, true, u8(131))
