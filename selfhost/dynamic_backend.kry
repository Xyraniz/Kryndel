    if is_err(bound_loop) { return err(unwrap_or(result_error(bound_loop), "dynamic backend: cannot bind Bytes loop")) }
    current = append_code(result_unwrap(bound_loop), [u8(76), u8(137), u8(248), u8(72), u8(57), u8(232)])
    current = emit_jump(current, done_label.label, true, u8(131))
    current = append_code(current, [
        u8(76), u8(137), u8(255), u8(72), u8(193), u8(231), u8(3), u8(76), u8(1), u8(231), u8(72), u8(131), u8(199), u8(8), u8(72), u8(139), u8(7), u8(72), u8(133), u8(192)
