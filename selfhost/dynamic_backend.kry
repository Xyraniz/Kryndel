fn emit_string_equal_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, host_string_equal_label(state))
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind String equality runtime")) }
    let pointer_equal: LabelState = new_label(result_unwrap(bound))
    let false_label: LabelState = new_label(pointer_equal.state)
    let loop_label: LabelState = new_label(false_label.state)
    let done_label: LabelState = new_label(loop_label.state)
    let mut current: EmitState = append_code(done_label.state, [
        u8(83), u8(85), u8(65), u8(84), u8(65), u8(85), u8(65), u8(86),
        u8(73), u8(137), u8(252), u8(73), u8(137), u8(245), u8(77), u8(57), u8(236)
    ])
    current = emit_jump(current, pointer_equal.label, true, u8(132))
    current = append_code(current, [u8(73), u8(139), u8(4), u8(36), u8(73), u8(59), u8(69), u8(0)])
    current = emit_jump(current, false_label.label, true, u8(133))
    current = append_code(current, [u8(77), u8(49), u8(246)])
    let bound_loop: Result[EmitState, String] = bind_label(current, loop_label.label)
    if is_err(bound_loop) { return err(unwrap_or(result_error(bound_loop), "dynamic backend: cannot bind String equality loop")) }
    current = append_code(result_unwrap(bound_loop), [u8(77), u8(59), u8(52), u8(36)])
    current = emit_jump(current, pointer_equal.label, true, u8(131))
    current = append_code(current, [
        u8(75), u8(15), u8(182), u8(68), u8(52), u8(8), u8(75), u8(15), u8(182), u8(84), u8(53), u8(8), u8(72), u8(57), u8(208)
    ])
    current = emit_jump(current, false_label.label, true, u8(133))
    current = append_code(current, [u8(73), u8(255), u8(198)])
    current = emit_jump(current, loop_label.label, false, u8(0))
    let bound_pointer: Result[EmitState, String] = bind_label(current, pointer_equal.label)
    if is_err(bound_pointer) { return err(unwrap_or(result_error(bound_pointer), "dynamic backend: cannot bind String equality success")) }
    current = emit_int(result_unwrap(bound_pointer), 1)
    current = emit_jump(current, done_label.label, false, u8(0))
    let bound_false: Result[EmitState, String] = bind_label(current, false_label.label)
    if is_err(bound_false) { return err(unwrap_or(result_error(bound_false), "dynamic backend: cannot bind String equality failure")) }
    current = emit_int(result_unwrap(bound_false), 0)
    let bound_done: Result[EmitState, String] = bind_label(current, done_label.label)
    if is_err(bound_done) { return err(unwrap_or(result_error(bound_done), "dynamic backend: cannot bind String equality completion")) }
    return ok(append_code(result_unwrap(bound_done), [u8(65), u8(94), u8(65), u8(93), u8(65), u8(92), u8(93), u8(91), u8(195)]))
}

