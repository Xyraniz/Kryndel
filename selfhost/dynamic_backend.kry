    if is_err(bound_start_one) { return err(unwrap_or(result_error(bound_start_one), "dynamic backend: cannot bind substring start 2-byte path")) }
    current = append_code(result_unwrap(bound_start_one), [u8(72), u8(199), u8(193), u8(1), u8(0), u8(0), u8(0)])
