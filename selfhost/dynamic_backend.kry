fn emit_substring_call(state: EmitState, expression: Json) -> Result[EmitState, String] {
    let arguments: Json = field(expression, "args")
    if result_unwrap(json_array_len(arguments)) != 3 { return err("dynamic backend: substring expects String, Int, and Int") }
    let source: Json = result_unwrap(json_array_get(arguments, 0))
    let start: Json = result_unwrap(json_array_get(arguments, 1))
    let length: Json = result_unwrap(json_array_get(arguments, 2))
    if expr_type(source) != "String" || expr_type(start) != "Int" || expr_type(length) != "Int" {
        return err("dynamic backend: substring expects String, Int, and Int")
    }
    let first: Result[EmitState, String] = emit_expression(state, source)
    if is_err(first) { return err(expression_error(first)) }
    let first_pushed: EmitState = append_code(result_unwrap(first), [u8(80)])
    let second: Result[EmitState, String] = emit_expression(first_pushed, start)
    if is_err(second) { return err(expression_error(second)) }
    let second_pushed: EmitState = append_code(result_unwrap(second), [u8(80)])
    let third: Result[EmitState, String] = emit_expression(second_pushed, length)
    if is_err(third) { return err(expression_error(third)) }
    let moved: EmitState = append_code(result_unwrap(third), [u8(72), u8(137), u8(194), u8(94), u8(95)])
    let marked: EmitState = state_with_host_used(moved)
    return ok(emit_label_call(marked, host_substring_label(marked)))
}

fn emit_substring_runtime(state: EmitState) -> Result[EmitState, String] {
    let bound: Result[EmitState, String] = bind_label(state, host_substring_label(state))
    if is_err(bound) { return err(unwrap_or(result_error(bound), "dynamic backend: cannot bind substring runtime")) }
    let negative_error: LabelState = new_label(result_unwrap(bound))
