import "dynamic_backend"
import "validated_kir"

fn malformed_document(target_os: String) -> String {
    let mut os_json: String = "\"linux\""
    if target_os == "windows" { os_json = "\"windows\"" }
    return "{\"format\":\"kry-ir\",\"version\":5,\"language_version\":\"1.0.0\",\"module\":\"\",\"source\":\"bad.kry\",\"target\":{\"os\":" + os_json + ",\"arch\":\"amd64\",\"gui\":false},\"imports\":[],\"sources\":[],\"structs\":[],\"enums\":[],\"traits\":[],\"trait_impls\":[],\"functions\":[],\"statements\":[{\"kind\":\"expr\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"expr\":{\"kind\":\"int\",\"type\":\"Int\",\"int\":1}}]}"
}

fn dangling_function_document(target_os: String) -> String {
    let mut os_json: String = "\"linux\""
    if target_os == "windows" { os_json = "\"windows\"" }
    return "{\"format\":\"kry-ir\",\"version\":5,\"language_version\":\"1.0.0\",\"module\":\"\",\"source\":\"bad.kry\",\"target\":{\"os\":" + os_json + ",\"arch\":\"amd64\",\"gui\":false},\"imports\":[],\"sources\":[],\"structs\":[],\"enums\":[],\"traits\":[],\"trait_impls\":[],\"functions\":[],\"statements\":[{\"kind\":\"expr\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"expr\":{\"kind\":\"call\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"Nil\",\"const\":null,\"name\":\"ghost\",\"call_target\":\"function:ghost\",\"args\":[]}}]}"
}

fn function_call_document(target_os: String, args: String, result_type: String) -> String {
    let mut os_json: String = "\"linux\""
    if target_os == "windows" { os_json = "\"windows\"" }
    return "{\"format\":\"kry-ir\",\"version\":5,\"language_version\":\"1.0.0\",\"module\":\"\",\"source\":\"bad.kry\",\"target\":{\"os\":" + os_json + ",\"arch\":\"amd64\",\"gui\":false},\"imports\":[],\"sources\":[],\"structs\":[],\"enums\":[],\"traits\":[],\"trait_impls\":[],\"functions\":[{\"name\":\"f\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"public\":false,\"worker\":false,\"unsafe\":false,\"trait\":\"\",\"module\":\"\",\"receiver\":null,\"return\":\"Int\",\"type_params\":[],\"params\":[{\"name\":\"x\",\"type\":\"Int\",\"default\":null,\"binding\":{\"name\":\"x\",\"type\":\"Int\",\"mutable\":false,\"source\":\"bad.kry\",\"line\":1,\"column\":1}}],\"captures\":[],\"body\":[]}],\"statements\":[{\"kind\":\"expr\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"expr\":{\"kind\":\"call\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"" + result_type + "\",\"const\":null,\"name\":\"f\",\"call_target\":\"function:f\",\"args\":" + args + "}}]}"
}

fn malformed_pattern_document(target_os: String) -> String {
    let mut os_json: String = "\"linux\""
    if target_os == "windows" { os_json = "\"windows\"" }
    return "{\"format\":\"kry-ir\",\"version\":5,\"language_version\":\"1.0.0\",\"module\":\"\",\"source\":\"bad.kry\",\"target\":{\"os\":" + os_json + ",\"arch\":\"amd64\",\"gui\":false},\"imports\":[],\"sources\":[],\"structs\":[],\"enums\":[{\"name\":\"E\",\"public\":false,\"module\":\"\",\"variants\":[\"A\"]}],\"traits\":[],\"trait_impls\":[],\"functions\":[],\"statements\":[{\"kind\":\"match\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"scrutinee\":{\"kind\":\"enum\",\"source\":\"bad.kry\",\"line\":1,\"column\":7,\"type\":\"E\",\"enum_type\":\"E\",\"enum_variant\":\"A\"},\"arms\":[{\"pattern\":{\"kind\":\"enum\",\"type\":\"E\",\"variant\":\"A\",\"binding\":\"\"},\"body\":[]}]}]}"
}

fn unexpected_statement_child_document(target_os: String) -> String {
    let mut os_json: String = "\"linux\""
    if target_os == "windows" { os_json = "\"windows\"" }
    return "{\"format\":\"kry-ir\",\"version\":5,\"language_version\":\"1.0.0\",\"module\":\"\",\"source\":\"bad.kry\",\"target\":{\"os\":" + os_json + ",\"arch\":\"amd64\",\"gui\":false},\"imports\":[],\"sources\":[],\"structs\":[],\"enums\":[],\"traits\":[],\"trait_impls\":[],\"functions\":[],\"statements\":[{\"kind\":\"break\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"expr\":{\"kind\":\"int\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"Int\",\"int\":1}}]}"
}

fn unknown_expression_field_document(target_os: String) -> String {
    let mut os_json: String = "\"linux\""
    if target_os == "windows" { os_json = "\"windows\"" }
    let escaped_value: String = "\"quote \\\" brace {,}[]\""
    return "{\"format\":\"kry-ir\",\"version\":5,\"language_version\":\"1.0.0\",\"module\":\"\",\"source\":\"bad.kry\",\"target\":{\"os\":" + os_json + ",\"arch\":\"amd64\",\"gui\":false},\"imports\":[],\"sources\":[],\"structs\":[],\"enums\":[],\"traits\":[],\"trait_impls\":[],\"functions\":[],\"statements\":[{\"kind\":\"expr\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"expr\":{\"kind\":\"int\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"Int\",\"int\":1,\"string\":" + escaped_value + ",\"unexpected\":true}}]}"
}

fn unexpected_expression_child_document(target_os: String, child_name: String, child_value: String) -> String {
    let mut os_json: String = "\"linux\""
    if target_os == "windows" { os_json = "\"windows\"" }
    let expression: String = "{\"kind\":\"int\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"Int\",\"const\":null,\"int\":1,\"" + child_name + "\":" + child_value + "}"
    return "{\"format\":\"kry-ir\",\"version\":5,\"language_version\":\"1.0.0\",\"module\":\"\",\"source\":\"bad.kry\",\"target\":{\"os\":" + os_json + ",\"arch\":\"amd64\",\"gui\":false},\"imports\":[],\"sources\":[],\"structs\":[],\"enums\":[],\"traits\":[],\"trait_impls\":[],\"functions\":[],\"statements\":[{\"kind\":\"expr\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"expr\":" + expression + "}]}"
}

fn generated_document(target_os: String, structs: String, enums: String, statements: String) -> String {
    let mut os_json: String = "\"linux\""
    if target_os == "windows" { os_json = "\"windows\"" }
    return "{\"format\":\"kry-ir\",\"version\":5,\"language_version\":\"1.0.0\",\"module\":\"\",\"source\":\"bad.kry\",\"target\":{\"os\":" + os_json + ",\"arch\":\"amd64\",\"gui\":false},\"imports\":[],\"sources\":[],\"structs\":" + structs + ",\"enums\":" + enums + ",\"traits\":[],\"trait_impls\":[],\"functions\":[],\"statements\":" + statements + "}"
}

fn generated_expression_statement(expression: String) -> String {
    return "[{\"kind\":\"expr\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"expr\":" + expression + "}]"
}

fn generated_int_expression(value: Int) -> String {
    return "{\"kind\":\"int\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"Int\",\"const\":null,\"int\":" + str(value) + "}"
}

fn generated_string_expression() -> String {
    return "{\"kind\":\"string\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"String\",\"const\":null,\"string\":\"bad\"}"
}

fn generated_variable_expression(type_name: String) -> String {
    return "{\"kind\":\"var\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"" + type_name + "\",\"const\":null,\"name\":\"value\",\"binding\":{\"name\":\"value\",\"type\":\"" + type_name + "\",\"mutable\":false,\"source\":\"bad.kry\",\"line\":1,\"column\":1}}"
}

fn malformed_constant_document(target_os: String, constant: String) -> String {
    let expression: String = "{\"kind\":\"int\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"UInt8\",\"const\":" + constant + ",\"int\":1}"
    return generated_document(target_os, "[]", "[]", generated_expression_statement(expression))
}

fn unknown_struct_field_document(target_os: String) -> String {
    let structs: String = "[{\"name\":\"Point\",\"public\":false,\"module\":\"\",\"type_params\":[],\"fields\":[{\"name\":\"x\",\"public\":false,\"type\":\"Int\"}]}]"
    let expression: String = "{\"kind\":\"struct\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"Point\",\"const\":null,\"struct_name\":\"Point\",\"fields\":[\"ghost\"],\"values\":[" + generated_int_expression(1) + "]}"
    return generated_document(target_os, structs, "[]", generated_expression_statement(expression))
}

fn unknown_struct_reference_document(target_os: String) -> String {
    let expression: String = "{\"kind\":\"struct\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"Missing\",\"const\":null,\"struct_name\":\"Missing\",\"fields\":[],\"values\":[]}"
    return generated_document(target_os, "[]", "[]", generated_expression_statement(expression))
}

fn duplicate_struct_field_document(target_os: String) -> String {
    let structs: String = "[{\"name\":\"Point\",\"public\":false,\"module\":\"\",\"type_params\":[],\"fields\":[{\"name\":\"x\",\"public\":false,\"type\":\"Int\"},{\"name\":\"x\",\"public\":false,\"type\":\"Int\"}]}]"
    return generated_document(target_os, structs, "[]", "[]")
}

fn duplicate_struct_declaration_document(target_os: String) -> String {
    let declaration: String = "{\"name\":\"Point\",\"public\":false,\"module\":\"\",\"type_params\":[],\"fields\":[]}"
    return generated_document(target_os, "[" + declaration + "," + declaration + "]", "[]", "[]")
}

fn valid_struct_document() -> String {
    let declaration: String = "[{\"name\":\"Point\",\"public\":false,\"module\":\"\",\"type_params\":[],\"fields\":[{\"name\":\"x\",\"public\":false,\"type\":\"Int\"}]}]"
    return generated_document("linux", declaration, "[]", "[]")
}

fn valid_generic_struct_document() -> String {
    let declaration: String = "[{\"name\":\"Envelope\",\"public\":false,\"module\":\"\",\"type_params\":[{\"name\":\"T\",\"constraint\":\"\"}],\"fields\":[{\"name\":\"payload\",\"public\":false,\"type\":\"Option[Array[T]]\"}]}]"
    let value: String = "{\"kind\":\"var\",\"source\":\"valid.kry\",\"line\":1,\"column\":1,\"type\":\"Option[Array[Int]]\",\"name\":\"payload\",\"binding\":{\"name\":\"payload\",\"type\":\"Option[Array[Int]]\",\"mutable\":false,\"source\":\"valid.kry\",\"line\":1,\"column\":1}}"
    let expression: String = "{\"kind\":\"struct\",\"source\":\"valid.kry\",\"line\":1,\"column\":1,\"type\":\"Envelope[Int]\",\"const\":null,\"struct_name\":\"Envelope\",\"struct_type\":\"Envelope[Int]\",\"fields\":[\"payload\"],\"values\":[" + value + "]}"
    return generated_document("linux", declaration, "[]", generated_expression_statement(expression))
}

fn valid_unicode_type_identifier_document(target_os: String) -> String {
    let declaration: String = "[{\"name\":\"Envelope\",\"public\":false,\"module\":\"\",\"type_params\":[{\"name\":\"Δ\",\"constraint\":\"\"}],\"fields\":[{\"name\":\"payload\",\"public\":false,\"type\":\"Δ\"}]}]"
    return generated_document(target_os, declaration, "[]", "[]")
}

fn malformed_generic_struct_document(target_os: String, type_params: String, field_type: String, instance_type: String) -> String {
    let declaration: String = "[{\"name\":\"Envelope\",\"public\":false,\"module\":\"\",\"type_params\":" + type_params + ",\"fields\":[{\"name\":\"payload\",\"public\":false,\"type\":\"" + field_type + "\"}]}]"
    let expression: String = "{\"kind\":\"struct\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"" + instance_type + "\",\"const\":null,\"struct_name\":\"Envelope\",\"struct_type\":\"" + instance_type + "\",\"fields\":[\"payload\"],\"values\":[" + generated_int_expression(1) + "]}"
    return generated_document(target_os, declaration, "[]", generated_expression_statement(expression))
}

fn constrained_generic_struct_document(target_os: String, constraint: String, instance_type: String, value: String) -> String {
    let declaration: String = "[{\"name\":\"Number\",\"public\":false,\"module\":\"\",\"type_params\":[{\"name\":\"T\",\"constraint\":\"" + constraint + "\"}],\"fields\":[{\"name\":\"value\",\"public\":false,\"type\":\"T\"}]}]"
    let expression: String = "{\"kind\":\"struct\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"" + instance_type + "\",\"const\":null,\"struct_name\":\"Number\",\"struct_type\":\"" + instance_type + "\",\"fields\":[\"value\"],\"values\":[" + value + "]}"
    return generated_document(target_os, declaration, "[]", generated_expression_statement(expression))
}

fn nested_generic_constraint_document(target_os: String, outer_constraint: String) -> String {
    let declarations: String = "[{\"name\":\"Inner\",\"public\":false,\"module\":\"\",\"type_params\":[{\"name\":\"T\",\"constraint\":\"Numeric\"}],\"fields\":[{\"name\":\"value\",\"public\":false,\"type\":\"T\"}]},{\"name\":\"Outer\",\"public\":false,\"module\":\"\",\"type_params\":[{\"name\":\"T\",\"constraint\":\"" + outer_constraint + "\"}],\"fields\":[{\"name\":\"inner\",\"public\":false,\"type\":\"Inner[T]\"}]}]"
    return generated_document(target_os, declarations, "[]", "[]")
}

fn struct_field_type_document(target_os: String, field_type: String) -> String {
    let declarations: String = "[{\"name\":\"Holder\",\"public\":false,\"module\":\"\",\"type_params\":[],\"fields\":[{\"name\":\"value\",\"public\":false,\"type\":\"" + field_type + "\"}]}]"
    return generated_document(target_os, declarations, "[]", "[]")
}

fn function_signature_type_document(target_os: String, parameter_type: String, return_type: String) -> String {
    let mut os_json: String = "\"linux\""
    if target_os == "windows" { os_json = "\"windows\"" }
    let binding: String = "{\"name\":\"value\",\"type\":\"" + parameter_type + "\",\"mutable\":false,\"source\":\"bad.kry\",\"line\":1,\"column\":1}"
    let parameter: String = "{\"name\":\"value\",\"type\":\"" + parameter_type + "\",\"default\":null,\"binding\":" + binding + "}"
    let function: String = "{\"name\":\"accept\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"public\":false,\"worker\":false,\"unsafe\":false,\"trait\":\"\",\"module\":\"\",\"receiver\":null,\"return\":\"" + return_type + "\",\"type_params\":[],\"params\":[" + parameter + "],\"captures\":[],\"body\":[]}"
    return "{\"format\":\"kry-ir\",\"version\":5,\"language_version\":\"1.0.0\",\"module\":\"\",\"source\":\"bad.kry\",\"target\":{\"os\":" + os_json + ",\"arch\":\"amd64\",\"gui\":false},\"imports\":[],\"sources\":[],\"structs\":[],\"enums\":[],\"traits\":[],\"trait_impls\":[],\"functions\":[" + function + "],\"statements\":[]}"
}

fn unknown_enum_variant_document(target_os: String) -> String {
    let enums: String = "[{\"name\":\"Color\",\"public\":false,\"module\":\"\",\"variants\":[\"Red\"]}]"
    let expression: String = "{\"kind\":\"enum\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"Color\",\"const\":null,\"enum_type\":\"Color\",\"enum_variant\":\"Blue\"}"
    return generated_document(target_os, "[]", enums, generated_expression_statement(expression))
}

fn unknown_enum_pattern_document(target_os: String) -> String {
    let enums: String = "[{\"name\":\"Color\",\"public\":false,\"module\":\"\",\"variants\":[\"Red\"]}]"
    let scrutinee: String = "{\"kind\":\"enum\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"Color\",\"const\":null,\"enum_type\":\"Color\",\"enum_variant\":\"Red\"}"
    let statement: String = "[{\"kind\":\"match\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"scrutinee\":" + scrutinee + ",\"arms\":[{\"pattern\":{\"kind\":\"enum\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"Color\",\"variant\":\"Blue\",\"binding\":\"\"},\"body\":[]}]}]"
    return generated_document(target_os, "[]", enums, statement)
}

fn duplicate_enum_variant_document(target_os: String) -> String {
    let enums: String = "[{\"name\":\"Color\",\"public\":false,\"module\":\"\",\"variants\":[\"Red\",\"Red\"]}]"
    return generated_document(target_os, "[]", enums, "[]")
}

fn duplicate_enum_declaration_document(target_os: String) -> String {
    let declaration: String = "{\"name\":\"Color\",\"public\":false,\"module\":\"\",\"variants\":[\"Red\"]}"
    return generated_document(target_os, "[]", "[" + declaration + "," + declaration + "]", "[]")
}

fn invalid_operator_document(target_os: String, unary: Bool) -> String {
    let mut expression: String = "{\"kind\":\"binary\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"Int\",\"const\":null,\"operator\":\"??\",\"left\":" + generated_int_expression(1) + ",\"right\":" + generated_int_expression(2) + "}"
    if unary { expression = "{\"kind\":\"unary\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"Int\",\"const\":null,\"operator\":\"?\",\"operand\":" + generated_int_expression(1) + "}" }
    return generated_document(target_os, "[]", "[]", generated_expression_statement(expression))
}

fn rejected_before_lowering(document_text: String) -> Bool {
    let parsed: Result[Json, String] = json_parse(document_text)
    if is_err(parsed) { return false }
    let compiled: Result[Bytes, String] = compile_document(result_unwrap(parsed))
    if is_ok(compiled) { return false }
    return starts_with(unwrap_or(result_error(compiled), ""), "KIR validation failed:")
}

fn rejected_by_generated_path(document_text: String) -> Bool {
    let parsed: Result[Json, String] = json_parse(document_text)
    if is_err(parsed) { return false }
    let compiled: Result[Bytes, String] = compile_generated_document(result_unwrap(parsed))
    if is_ok(compiled) { return false }
    return starts_with(unwrap_or(result_error(compiled), ""), "KIR validation failed:")
}

fn accepted_by_generated_path(document_text: String) -> Bool {
    let parsed: Result[Json, String] = json_parse(document_text)
    if is_err(parsed) { return false }
    let compiled: Result[Bytes, String] = compile_generated_document(result_unwrap(parsed))
    if is_ok(compiled) { return true }
    return !starts_with(unwrap_or(result_error(compiled), ""), "KIR validation failed:")
}

fn valid_generated_kir(document_text: String) -> Bool {
    let parsed: Result[Json, String] = json_parse(document_text)
    if is_err(parsed) { return false }
    let validated: Result[ValidatedKIR, String] = validate_generated_kir_document(result_unwrap(parsed))
    return is_ok(validated)
}

fn main() -> Nil {
    assert_eq(rejected_before_lowering(malformed_document("linux")), true)
    assert_eq(rejected_before_lowering(malformed_document("windows")), true)
    assert_eq(rejected_before_lowering(dangling_function_document("linux")), true)
    assert_eq(rejected_before_lowering(dangling_function_document("windows")), true)
    assert_eq(rejected_before_lowering(malformed_pattern_document("linux")), true)
    assert_eq(rejected_before_lowering(malformed_pattern_document("windows")), true)
    assert_eq(rejected_before_lowering(unexpected_statement_child_document("linux")), true)
    assert_eq(rejected_before_lowering(unexpected_statement_child_document("windows")), true)
    assert_eq(rejected_before_lowering(unknown_expression_field_document("linux")), true)
    assert_eq(rejected_before_lowering(unknown_expression_field_document("windows")), true)
    assert_eq(rejected_before_lowering(unexpected_expression_child_document("linux", "left", generated_int_expression(2))), true)
    assert_eq(rejected_before_lowering(unexpected_expression_child_document("windows", "args", "[" + generated_int_expression(2) + "]")), true)
    assert_eq(rejected_by_generated_path(unexpected_expression_child_document("windows", "args", "[" + generated_int_expression(2) + "]")), true)
    assert_eq(rejected_before_lowering(function_call_document("linux", "[]", "Int")), true)
    assert_eq(rejected_before_lowering(function_call_document("windows", "[]", "Int")), true)
    assert_eq(rejected_before_lowering(function_call_document("linux", "[{\"kind\":\"string\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"String\",\"string\":\"wrong\"}]", "Int")), true)
    assert_eq(rejected_before_lowering(function_call_document("windows", "[{\"kind\":\"int\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"Int\",\"int\":1}]", "String")), true)
    assert_eq(rejected_by_generated_path(function_call_document("windows", "[{\"kind\":\"int\",\"source\":\"bad.kry\",\"line\":1,\"column\":1,\"type\":\"Int\",\"int\":1}]", "String")), true)
    assert_eq(rejected_by_generated_path(dangling_function_document("linux")), true)
    assert_eq(valid_generated_kir(unknown_expression_field_document("linux")), true)
    assert_eq(valid_generated_kir(valid_unicode_type_identifier_document("linux")), true)
    assert_eq(rejected_by_generated_path(malformed_constant_document("linux", "{\"kind\":\"mystery\"}")), true)
    assert_eq(rejected_by_generated_path(malformed_constant_document("linux", "{\"kind\":\"int\"}")), true)
    assert_eq(rejected_by_generated_path(malformed_constant_document("windows", "{\"kind\":\"uint\",\"uint\":255,\"uint_bits\":2}")), true)
    assert_eq(rejected_by_generated_path(malformed_constant_document("windows", "{\"kind\":\"uint\",\"uint\":256,\"uint_bits\":8}")), true)
    assert_eq(rejected_by_generated_path(unknown_struct_field_document("linux")), true)
    assert_eq(rejected_by_generated_path(unknown_struct_reference_document("windows")), true)
    assert_eq(rejected_by_generated_path(duplicate_struct_field_document("linux")), true)
    assert_eq(rejected_by_generated_path(duplicate_struct_declaration_document("windows")), true)
    assert_eq(rejected_by_generated_path(unknown_enum_variant_document("linux")), true)
    assert_eq(rejected_by_generated_path(unknown_enum_pattern_document("windows")), true)
    assert_eq(rejected_by_generated_path(duplicate_enum_variant_document("windows")), true)
    assert_eq(rejected_by_generated_path(duplicate_enum_declaration_document("linux")), true)
    assert_eq(rejected_by_generated_path(invalid_operator_document("linux", true)), true)
    assert_eq(rejected_by_generated_path(invalid_operator_document("windows", false)), true)
    assert_eq(accepted_by_generated_path(valid_struct_document()), true)
    assert_eq(valid_generated_kir(valid_generic_struct_document()), true)
    assert_eq(valid_generated_kir(constrained_generic_struct_document("linux", "Numeric", "Number[Int]", generated_int_expression(1))), true)
    assert_eq(valid_generated_kir(constrained_generic_struct_document("linux", "Any", "Number[FFIBuffer]", generated_variable_expression("FFIBuffer"))), true)
    assert_eq(valid_generated_kir(constrained_generic_struct_document("linux", "Any", "Number[Array[FFIBuffer]]", generated_variable_expression("Array[FFIBuffer]"))), true)
    assert_eq(rejected_before_lowering(constrained_generic_struct_document("linux", "Any", "Number[MadeUp]", generated_variable_expression("MadeUp"))), true)
    assert_eq(rejected_before_lowering(constrained_generic_struct_document("linux", "Numeric", "Number[String]", generated_string_expression())), true)
    assert_eq(rejected_by_generated_path(constrained_generic_struct_document("windows", "Numeric", "Number[String]", generated_string_expression())), true)
    assert_eq(valid_generated_kir(constrained_generic_struct_document("linux", "Copy", "Number[Array[Int]]", generated_variable_expression("Array[Int]"))), true)
    assert_eq(valid_generated_kir(constrained_generic_struct_document("linux", "Copy", "Number[Map[String,Int]]", generated_variable_expression("Map[String,Int]"))), true)
    assert_eq(rejected_before_lowering(constrained_generic_struct_document("linux", "Copy", "Number[FFIBuffer]", generated_variable_expression("FFIBuffer"))), true)
    assert_eq(valid_generated_kir(nested_generic_constraint_document("linux", "Numeric")), true)
    assert_eq(rejected_before_lowering(nested_generic_constraint_document("linux", "Copy")), true)
    assert_eq(rejected_by_generated_path(nested_generic_constraint_document("windows", "Copy")), true)
    assert_eq(valid_generated_kir(struct_field_type_document("linux", "Array[FFIBuffer]")), true)
    assert_eq(rejected_before_lowering(struct_field_type_document("linux", "MadeUp")), true)
    assert_eq(valid_generated_kir(function_signature_type_document("linux", "FFIBuffer", "Nil")), true)
    assert_eq(rejected_before_lowering(function_signature_type_document("linux", "MadeUp", "Nil")), true)
    assert_eq(rejected_before_lowering(function_signature_type_document("linux", "Int", "MadeUp")), true)
    assert_eq(rejected_before_lowering(malformed_generic_struct_document("linux", "[{\"name\":\"T\",\"constraint\":\"\"}]", "T", "Envelope[String]")), true)
    assert_eq(rejected_by_generated_path(malformed_generic_struct_document("windows", "[{\"name\":\"T\",\"constraint\":\"\"}]", "T", "Envelope[String]")), true)
    assert_eq(rejected_by_generated_path(malformed_generic_struct_document("linux", "[{\"name\":\"T\",\"constraint\":\"\"}]", "T", "Envelope[Int, String]")), true)
    assert_eq(rejected_by_generated_path(malformed_generic_struct_document("windows", "[{\"name\":\"T\",\"constraint\":\"\"}]", "T[Int]", "Envelope[Int]")), true)
    assert_eq(rejected_by_generated_path(malformed_generic_struct_document("linux", "[{\"name\":\"T\",\"constraint\":\"Mystery\"}]", "T", "Envelope[Int]")), true)
    return nil
}
