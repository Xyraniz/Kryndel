// Self-hosted PE32+ AMD64 image writer.
//
// Input code is a single .text section beginning at RVA 0x1000. Data is
// copied into .rdata. A private absolute pointer anchor in .rdata exercises
// the DIR64 relocation path; generated code references remain RIP-relative.
// IAT references are `[dispOffset, instructionEnd, importIndex]`, where
// importIndex selects a `(dll, symbol)` row supplied to the generalized writer.
// The compatibility wrappers keep the console imports in their original order.
// Data references are `[dispOffset, instructionEnd, dataOffset]`. Function ranges are
// `[begin, end, frameSize]`; ranges must describe the standard RBP frame
// prolog emitted by the current x64 backend.

fn pe_u16(value: Int) -> Array[UInt8] {
    let raw: UInt16 = u16(value)
    return [u8(raw & u16(255)), u8(raw >> 8)]
}

fn pe_u32(value: Int) -> Array[UInt8] {
    let raw: UInt32 = u32(value)
    return [
        u8(raw & u32(255)),
        u8((raw >> 8) & u32(255)),
        u8((raw >> 16) & u32(255)),
        u8(raw >> 24)
    ]
}

fn pe_u64(value: Int) -> Array[UInt8] {
    let raw: UInt64 = u64(value)
    return [
        u8(raw & u64(255)),
        u8((raw >> 8) & u64(255)),
        u8((raw >> 16) & u64(255)),
        u8((raw >> 24) & u64(255)),
        u8((raw >> 32) & u64(255)),
        u8((raw >> 40) & u64(255)),
        u8((raw >> 48) & u64(255)),
        u8(raw >> 56)
    ]
}

fn pe_i32(value: Int) -> Array[UInt8] {
    if value >= 0 {
        return pe_u32(value)
    }
    return pe_u32(4294967296 + value)
}

fn pe_preferred_image_base() -> Int {
    return 5368709120
}

fn pe_append(left: Array[UInt8], right: Array[UInt8]) -> Array[UInt8] {
    return array_concat(left, right)
}

fn pe_zeros(count: Int) -> Array[UInt8] {
    let mut result: Array[UInt8] = []
    let mut index: Int = 0
    while index < count {
        result = array_push(result, u8(0))
        index = index + 1
    }
    return result
}

fn pe_pad_to(value: Array[UInt8], alignment: Int) -> Array[UInt8] {
    let mut result: Array[UInt8] = value
    while len(result) % alignment != 0 {
        result = array_push(result, u8(0))
    }
    return result
}

fn pe_aligned_size(value: Int, alignment: Int) -> Result[Int, String] {
    if value < 0 || alignment <= 0 {
        return err("PE: invalid alignment input")
    }
    if value > 4294967295 - (alignment - 1) {
        return err("PE: aligned size exceeds the 32-bit image range")
    }
    let remainder: Int = value % alignment
    if remainder == 0 {
        return ok(value)
    }
    return ok(value + alignment - remainder)
}

fn pe_patch_u32(bytes: Array[UInt8], offset: Int, value: Int) -> Result[Array[UInt8], String] {
    if offset < 0 || offset > len(bytes) - 4 || value < 0 || value > 4294967295 {
        return err("PE: 32-bit patch is outside the image")
    }
    let encoded: Array[UInt8] = pe_u32(value)
    let mut result: Array[UInt8] = bytes
    let mut byte_index: Int = 0
    while byte_index < 4 {
        let replacement: UInt8 = unwrap_or(array_get(encoded, byte_index), u8(0))
        let updated: Result[Array[UInt8], String] = array_set(result, offset + byte_index, replacement)
        if is_err(updated) {
            return err("PE: failed to patch a 32-bit field")
        }
        result = result_unwrap(updated)
        byte_index = byte_index + 1
    }
    return ok(result)
}

fn pe_patch_i32(bytes: Array[UInt8], offset: Int, value: Int) -> Result[Array[UInt8], String] {
    if offset < 0 || offset > len(bytes) - 4 || value < -2147483648 || value > 2147483647 {
        return err("PE: RIP-relative displacement is outside signed 32-bit range")
    }
    let encoded: Array[UInt8] = pe_i32(value)
    let mut result: Array[UInt8] = bytes
    let mut byte_index: Int = 0
    while byte_index < 4 {
        let replacement: UInt8 = unwrap_or(array_get(encoded, byte_index), u8(0))
        let updated: Result[Array[UInt8], String] = array_set(result, offset + byte_index, replacement)
        if is_err(updated) {
            return err("PE: failed to patch a RIP-relative displacement")
        }
        result = result_unwrap(updated)
        byte_index = byte_index + 1
    }
    return ok(result)
}

fn pe_indexed_int(values: Array[Int], index: Int, label: String) -> Result[Int, String] {
    if index < 0 || index >= len(values) {
        return err("PE: malformed " + label + " entry")
    }
    let selected: Option[Int] = array_get(values, index)
    if is_none(selected) {
        return err("PE: malformed " + label + " entry")
    }
    return ok(unwrap_or(selected, 0))
}

fn pe_u32_at(bytes: Array[UInt8], offset: Int) -> Int {
    let a: Int = int(unwrap_or(array_get(bytes, offset), u8(0)))
    let b: Int = int(unwrap_or(array_get(bytes, offset + 1), u8(0)))
    let c: Int = int(unwrap_or(array_get(bytes, offset + 2), u8(0)))
    let d: Int = int(unwrap_or(array_get(bytes, offset + 3), u8(0)))
    return a + b * 256 + c * 65536 + d * 16777216
}

fn pe_sort_ranges(ranges: Array[Array[Int]]) -> Result[Array[Array[Int]], String] {
    let mut sorted: Array[Array[Int]] = ranges
    let mut gap: Int = len(sorted) / 2
    while gap > 0 {
      let mut index: Int = gap
      while index < len(sorted) {
        let selected: Option[Array[Int]] = array_get(sorted, index)
        if is_none(selected) {
            return err("PE: malformed function range")
        }
        let current: Array[Int] = unwrap_or(selected, [])
        let current_begin: Result[Int, String] = pe_indexed_int(current, 0, "function range")
        if is_err(current_begin) { return err(unwrap_or(result_error(current_begin), "PE: malformed function range")) }
        let mut cursor: Int = index
        while cursor >= gap {
            let previous_option: Option[Array[Int]] = array_get(sorted, cursor - gap)
            if is_none(previous_option) {
                return err("PE: malformed function range")
            }
            let previous: Array[Int] = unwrap_or(previous_option, [])
            let previous_begin: Result[Int, String] = pe_indexed_int(previous, 0, "function range")
            if is_err(previous_begin) { return err(unwrap_or(result_error(previous_begin), "PE: malformed function range")) }
            if result_unwrap(previous_begin) <= result_unwrap(current_begin) {
                break
            }
            let shift: Result[Array[Array[Int]], String] = array_set(sorted, cursor, previous)
            if is_err(shift) { return err("PE: failed to sort function ranges") }
            sorted = result_unwrap(shift)
            cursor = cursor - gap
        }
        let insert: Result[Array[Array[Int]], String] = array_set(sorted, cursor, current)
        if is_err(insert) { return err("PE: failed to sort function ranges") }
        sorted = result_unwrap(insert)
        index = index + 1
      }
      gap = gap / 2
    }
    return ok(sorted)
}

fn pe_validate_ranges(code: Array[UInt8], ranges: Array[Array[Int]]) -> Result[Array[Array[Int]], String] {
    let code_size: Int = len(code)
    if code_size <= 0 || len(ranges) == 0 {
        return err("PE: .text and at least one unwindable function range are required")
    }
    if len(ranges) > 89478485 {
        return err("PE: too many function unwind ranges")
    }
    let sorted_result: Result[Array[Array[Int]], String] = pe_sort_ranges(ranges)
    if is_err(sorted_result) { return err(unwrap_or(result_error(sorted_result), "PE: function range sorting failed")) }
    let sorted: Array[Array[Int]] = result_unwrap(sorted_result)
    let mut previous_end: Int = 0
    let mut index: Int = 0
    while index < len(sorted) {
        let entry_option: Option[Array[Int]] = array_get(sorted, index)
        if is_none(entry_option) { return err("PE: malformed function range") }
        let entry: Array[Int] = unwrap_or(entry_option, [])
        if len(entry) != 3 { return err("PE: function ranges must be [begin,end,frameSize]") }
        let begin_result: Result[Int, String] = pe_indexed_int(entry, 0, "function range")
        let end_result: Result[Int, String] = pe_indexed_int(entry, 1, "function range")
        let frame_result: Result[Int, String] = pe_indexed_int(entry, 2, "function range")
        if is_err(begin_result) || is_err(end_result) || is_err(frame_result) {
            return err("PE: malformed function range")
        }
        let begin: Int = result_unwrap(begin_result)
        let end: Int = result_unwrap(end_result)
        let frame: Int = result_unwrap(frame_result)
        if begin < 0 || begin >= end || end > code_size || (index > 0 && begin < previous_end) {
            return err("PE: overlapping or invalid function unwind range")
        }
        if frame < 16 || frame % 16 != 0 || frame > 524280 {
            return err("PE: frame size must be 16-byte aligned and at most 524280 bytes")
        }
        if begin + 11 > end ||
            unwrap_or(array_get(code, begin), u8(0)) != u8(85) ||
            unwrap_or(array_get(code, begin + 1), u8(0)) != u8(72) ||
            unwrap_or(array_get(code, begin + 2), u8(0)) != u8(137) ||
            unwrap_or(array_get(code, begin + 3), u8(0)) != u8(229) ||
            unwrap_or(array_get(code, begin + 4), u8(0)) != u8(72) ||
            unwrap_or(array_get(code, begin + 5), u8(0)) != u8(129) ||
            unwrap_or(array_get(code, begin + 6), u8(0)) != u8(236) ||
            pe_u32_at(code, begin + 7) != frame {
            return err("PE: function does not start with the supported RBP frame prolog")
        }
        if 4096 + end > 4294967295 {
            return err("PE: function RVA exceeds the 32-bit image range")
        }
        if index == 0 && begin != 0 {
            return err("PE: the entry function must begin at .text offset zero")
        }
        previous_end = end
        index = index + 1
    }
    return ok(sorted)
}

fn pe_validate_patches(code_size: Int, patches: Array[Array[Int]], imports: Bool, import_count: Int) -> Result[Bool, String] {
    let mut index: Int = 0
    while index < len(patches) {
        let patch_option: Option[Array[Int]] = array_get(patches, index)
        if is_none(patch_option) { return err("PE: malformed code patch") }
        let patch: Array[Int] = unwrap_or(patch_option, [])
        if len(patch) != 3 { return err("PE: patches must have exactly three integers") }
        let displacement_result: Result[Int, String] = pe_indexed_int(patch, 0, "code patch")
        let instruction_end_result: Result[Int, String] = pe_indexed_int(patch, 1, "code patch")
        let target_result: Result[Int, String] = pe_indexed_int(patch, 2, "code patch")
        if is_err(displacement_result) || is_err(instruction_end_result) || is_err(target_result) {
            return err("PE: malformed code patch")
        }
        let displacement: Int = result_unwrap(displacement_result)
        let instruction_end: Int = result_unwrap(instruction_end_result)
        let target: Int = result_unwrap(target_result)
        if displacement < 0 || displacement > code_size - 4 || instruction_end < displacement + 4 || instruction_end > code_size {
            return err("PE: code patch displacement or instruction boundary is invalid")
        }
        if imports {
            if target < 0 || target >= import_count { return err("PE: import patch index is outside the import table") }
        } else if target < 0 {
            return err("PE: data offset cannot be negative")
        }
        index = index + 1
    }
    return ok(true)
}

fn pe_validate_patch_sets(patches: Array[Array[Int]]) -> Result[Bool, String] {
    let mut sorted: Array[Array[Int]] = patches
    let mut gap: Int = len(sorted) / 2
    while gap > 0 {
        let mut index: Int = gap
        while index < len(sorted) {
            let current: Array[Int] = unwrap_or(array_get(sorted, index), [])
            let current_displacement: Int = unwrap_or(array_get(current, 0), -1)
            let mut cursor: Int = index
            while cursor >= gap {
                let previous: Array[Int] = unwrap_or(array_get(sorted, cursor - gap), [])
                let previous_displacement: Int = unwrap_or(array_get(previous, 0), -1)
                if previous_displacement <= current_displacement { break }
                let shift: Result[Array[Array[Int]], String] = array_set(sorted, cursor, previous)
                if is_err(shift) { return err("PE: failed to order code patches") }
                sorted = result_unwrap(shift)
                cursor = cursor - gap
            }
            let insert: Result[Array[Array[Int]], String] = array_set(sorted, cursor, current)
            if is_err(insert) { return err("PE: failed to order code patches") }
            sorted = result_unwrap(insert)
            index = index + 1
        }
        gap = gap / 2
    }
    let mut overlap_index: Int = 1
    while overlap_index < len(sorted) {
        let overlap_previous: Array[Int] = unwrap_or(array_get(sorted, overlap_index - 1), [])
        let overlap_current: Array[Int] = unwrap_or(array_get(sorted, overlap_index), [])
        if unwrap_or(array_get(overlap_previous, 0), -1) + 4 > unwrap_or(array_get(overlap_current, 0), -1) {
            return err("PE: code patch fields overlap")
        }
        overlap_index = overlap_index + 1
    }
    return ok(true)
}

fn pe_frame_unwind(frame: Int) -> Array[UInt8] {
    let mut info: Array[UInt8] = [u8(1), u8(11), u8(0), u8(80)]
    if frame <= 128 {
        info = array_concat(info, [u8(11), u8(((frame / 8) - 1) * 16 + 2)])
        info = array_concat(info, [u8(4), u8(3), u8(1), u8(80)])
        let updated: Result[Array[UInt8], String] = array_set(info, 2, u8(3))
        if is_ok(updated) { info = result_unwrap(updated) }
    } else {
        info = array_concat(info, [u8(11), u8(1)])
        info = array_concat(info, pe_u16(frame / 8))
        info = array_concat(info, [u8(4), u8(3), u8(1), u8(80)])
        let updated: Result[Array[UInt8], String] = array_set(info, 2, u8(4))
        if is_ok(updated) { info = result_unwrap(updated) }
    }
    return pe_pad_to(info, 4)
}

fn pe_build_pdata(ranges: Array[Array[Int]], pdata_rva: Int) -> Result[Array[UInt8], String] {
    let table_size: Int = len(ranges) * 12
    if table_size > 2147483647 - table_size {
        return err("PE: unwind section exceeds the supported array size")
    }
    let mut pdata: Array[UInt8] = pe_zeros(table_size)
    let mut unwind_records: Array[UInt8] = []
    let mut index: Int = 0
    while index < len(ranges) {
        let entry: Array[Int] = unwrap_or(array_get(ranges, index), [])
        let begin: Int = unwrap_or(array_get(entry, 0), -1)
        let end: Int = unwrap_or(array_get(entry, 1), -1)
        let frame: Int = unwrap_or(array_get(entry, 2), -1)
        let unwind_rva: Int = pdata_rva + table_size + index * 12
        if unwind_rva > 4294967295 || unwind_rva + 12 > 4294967295 {
            return err("PE: unwind info exceeds the 32-bit RVA range")
        }
        let begin_patch: Result[Array[UInt8], String] = pe_patch_u32(pdata, index * 12, 4096 + begin)
        if is_err(begin_patch) { return err(unwrap_or(result_error(begin_patch), "PE: failed to write unwind table")) }
        pdata = result_unwrap(begin_patch)
        let end_patch: Result[Array[UInt8], String] = pe_patch_u32(pdata, index * 12 + 4, 4096 + end)
        if is_err(end_patch) { return err(unwrap_or(result_error(end_patch), "PE: failed to write unwind table")) }
        pdata = result_unwrap(end_patch)
        let info_patch: Result[Array[UInt8], String] = pe_patch_u32(pdata, index * 12 + 8, unwind_rva)
        if is_err(info_patch) { return err(unwrap_or(result_error(info_patch), "PE: failed to write unwind table")) }
        pdata = result_unwrap(info_patch)
        let unwind: Array[UInt8] = pe_frame_unwind(frame)
        if len(unwind) != 12 { return err("PE: internal unwind record size is invalid") }
        let mut unwind_index: Int = 0
        while unwind_index < len(unwind) {
            unwind_records = array_push(unwind_records, unwrap_or(array_get(unwind, unwind_index), u8(0)))
            unwind_index = unwind_index + 1
        }
        index = index + 1
    }
    pdata = array_concat(pdata, unwind_records)
    return ok(pdata)
}

fn pe_build_reloc(rdata_rva: Int, anchor_offset: Int) -> Result[Array[UInt8], String] {
    if rdata_rva < 0 || anchor_offset < 0 || anchor_offset > 4294967295 - rdata_rva - 8 {
        return err("PE: base relocation anchor is outside the image")
    }
    let page_rva: Int = rdata_rva + (anchor_offset / 4096) * 4096
    let page_offset: Int = anchor_offset % 4096
    if page_rva > 4294963200 || page_rva % 4096 != 0 || page_offset < 0 || page_offset > 4088 {
        return err("PE: base relocation anchor cannot be represented")
    }
    // IMAGE_REL_BASED_DIR64 plus an ABSOLUTE pad to make SizeOfBlock a
    // four-byte multiple. The Windows loader adjusts this pointer if the
    // image is not loaded at its preferred ImageBase.
    let relocation: Int = 40960 + page_offset
    let mut block: Array[UInt8] = pe_u32(page_rva)
    block = pe_append(block, pe_u32(12))
    block = pe_append(block, pe_u16(relocation))
    block = pe_append(block, pe_u16(0))
    return ok(block)
}

fn pe_import_field(imports: Array[Array[String]], index: Int, field: Int) -> Result[String, String] {
    if index < 0 || index >= len(imports) || field < 0 || field > 1 {
        return err("PE: malformed import descriptor")
    }
    let descriptor: Array[String] = unwrap_or(array_get(imports, index), [])
    if len(descriptor) != 2 { return err("PE: imports must be [dll, symbol] pairs") }
    let value: Option[String] = array_get(descriptor, field)
    if is_none(value) { return err("PE: malformed import descriptor") }
    return ok(unwrap_or(value, ""))
}

fn pe_validate_imports(imports: Array[Array[String]]) -> Result[Bool, String] {
    let mut index: Int = 0
    while index < len(imports) {
        let dll_result: Result[String, String] = pe_import_field(imports, index, 0)
        let symbol_result: Result[String, String] = pe_import_field(imports, index, 1)
        if is_err(dll_result) || is_err(symbol_result) {
            return err("PE: imports must be [dll, symbol] pairs")
        }
        let dll: String = result_unwrap(dll_result)
        let symbol: String = result_unwrap(symbol_result)
        let dll_bytes: Array[UInt8] = u8_array(string_to_bytes(dll))
        let symbol_bytes: Array[UInt8] = u8_array(string_to_bytes(symbol))
        if len(dll_bytes) == 0 || len(symbol_bytes) == 0 {
            return err("PE: import DLL and symbol names cannot be empty")
        }
        let mut byte_index: Int = 0
        while byte_index < len(dll_bytes) {
            if unwrap_or(array_get(dll_bytes, byte_index), u8(0)) == u8(0) {
                return err("PE: import DLL names cannot contain NUL")
            }
            byte_index = byte_index + 1
        }
        byte_index = 0
        while byte_index < len(symbol_bytes) {
            if unwrap_or(array_get(symbol_bytes, byte_index), u8(0)) == u8(0) {
                return err("PE: import symbol names cannot contain NUL")
            }
            byte_index = byte_index + 1
        }
        index = index + 1
    }
    return ok(true)
}

fn pe_import_unique_dlls(imports: Array[Array[String]]) -> Result[Array[String], String] {
    let mut dlls: Array[String] = []
    let mut index: Int = 0
    while index < len(imports) {
        let dll_result: Result[String, String] = pe_import_field(imports, index, 0)
        if is_err(dll_result) { return err("PE: malformed import descriptor") }
        let dll: String = result_unwrap(dll_result)
        let mut seen: Bool = false
        let mut prior: Int = 0
        while prior < len(dlls) {
            if unwrap_or(array_get(dlls, prior), "") == dll { seen = true }
            prior = prior + 1
        }
        if !seen { dlls = array_push(dlls, dll) }
        index = index + 1
    }
    return ok(dlls)
}

fn pe_import_layout(imports: Array[Array[String]]) -> Result[Array[Int], String] {
    let dlls_result: Result[Array[String], String] = pe_import_unique_dlls(imports)
    if is_err(dlls_result) { return err("PE: malformed import table") }
    let dlls: Array[String] = result_unwrap(dlls_result)
    let dll_count: Int = len(dlls)
    let directory_size: Int = (dll_count + 1) * 20
    if len(imports) == 0 { return ok([directory_size, 0, 0]) }
    let mut dll_names_size: Int = 0
    let mut group: Int = 0
    while group < dll_count {
        let dll_bytes: Array[UInt8] = u8_array(string_to_bytes(unwrap_or(array_get(dlls, group), "")))
        dll_names_size = dll_names_size + len(dll_bytes) + 1
        group = group + 1
    }
    let names_and_dlls: Result[Int, String] = pe_aligned_size(directory_size + dll_names_size, 8)
    if is_err(names_and_dlls) { return err("PE: import table exceeds the supported size") }
    let thunk_size: Int = (len(imports) + dll_count) * 8
    let iat_offset: Int = result_unwrap(names_and_dlls) + thunk_size
    let iat_size: Int = thunk_size
    if iat_offset > 2147483647 - iat_size || iat_offset + iat_size > 4294967295 {
        return err("PE: import address table exceeds the image range")
    }
    return ok([directory_size, iat_offset, iat_size])
}

fn pe_import_iat_slots(imports: Array[Array[String]]) -> Result[Array[Int], String] {
    let dlls_result: Result[Array[String], String] = pe_import_unique_dlls(imports)
    if is_err(dlls_result) { return err("PE: malformed import table") }
    let dlls: Array[String] = result_unwrap(dlls_result)
    let mut slots: Array[Int] = []
    let mut index: Int = 0
    while index < len(imports) {
        slots = array_push(slots, 0)
        index = index + 1
    }
    let mut group_base: Int = 0
    let mut group: Int = 0
    while group < len(dlls) {
        let group_dll: String = unwrap_or(array_get(dlls, group), "")
        let mut group_count: Int = 0
        index = 0
        while index < len(imports) {
            let import_dll: Result[String, String] = pe_import_field(imports, index, 0)
            if is_err(import_dll) { return err("PE: malformed import table") }
            if result_unwrap(import_dll) == group_dll {
                let save_slot: Result[Array[Int], String] = array_set(slots, index, group_base + group_count)
                if is_err(save_slot) { return err("PE: failed to save import address slot") }
                slots = result_unwrap(save_slot)
                group_count = group_count + 1
            }
            index = index + 1
        }
        group_base = group_base + group_count + 1
        group = group + 1
    }
    return ok(slots)
}

fn pe_import_data(idata_rva: Int, imports: Array[Array[String]]) -> Result[Array[UInt8], String] {
    let validation: Result[Bool, String] = pe_validate_imports(imports)
    if is_err(validation) { return err("PE: invalid import descriptors") }
    let layout_result: Result[Array[Int], String] = pe_import_layout(imports)
    if is_err(layout_result) { return err("PE: import table layout failed") }
    let layout: Array[Int] = result_unwrap(layout_result)
    let directory_size: Int = unwrap_or(array_get(layout, 0), 0)
    let iat_offset: Int = unwrap_or(array_get(layout, 1), 0)
    let iat_size: Int = unwrap_or(array_get(layout, 2), 0)
    if idata_rva < 0 || idata_rva > 4294967295 - directory_size - iat_offset - iat_size {
        return err("PE: import section exceeds the 32-bit RVA range")
    }
    let dlls_result: Result[Array[String], String] = pe_import_unique_dlls(imports)
    if is_err(dlls_result) { return err("PE: malformed import table") }
    let dlls: Array[String] = result_unwrap(dlls_result)
    let dll_count: Int = len(dlls)
    let mut idata: Array[UInt8] = pe_zeros(directory_size)
    let mut dll_offsets: Array[Int] = []
    let mut dll_names: Array[UInt8] = []
    let mut group: Int = 0
    while group < dll_count {
        let dll_for_name: String = unwrap_or(array_get(dlls, group), "")
        dll_offsets = array_push(dll_offsets, directory_size + len(dll_names))
        dll_names = pe_append(dll_names, u8_array(string_to_bytes(dll_for_name)))
        dll_names = array_push(dll_names, u8(0))
        group = group + 1
    }
    idata = pe_append(idata, dll_names)
    if len(imports) == 0 { return ok(idata) }
    idata = pe_pad_to(idata, 8)
    let ilt_offset: Int = len(idata)
    let thunk_region_size: Int = (len(imports) + dll_count) * 8
    let name_data_offset: Int = iat_offset + iat_size
    if len(imports) > 0 && (ilt_offset + thunk_region_size != iat_offset || name_data_offset < iat_offset) {
        return err("PE: import lookup table layout is inconsistent")
    }
    let mut import_name_offsets: Array[Int] = []
    let mut index: Int = 0
    while index < len(imports) {
        import_name_offsets = array_push(import_name_offsets, 0)
        index = index + 1
    }
    let mut name_records: Array[UInt8] = []
    group = 0
    while group < dll_count {
        let dll_for_symbols: String = unwrap_or(array_get(dlls, group), "")
        index = 0
        while index < len(imports) {
            let import_dll_for_symbols: Result[String, String] = pe_import_field(imports, index, 0)
            if is_err(import_dll_for_symbols) { return err("PE: malformed import table") }
            if result_unwrap(import_dll_for_symbols) == dll_for_symbols {
                let symbol_name_offset: Int = name_data_offset + len(name_records)
                let save_offset: Result[Array[Int], String] = array_set(import_name_offsets, index, symbol_name_offset)
                if is_err(save_offset) { return err("PE: failed to save import name offset") }
                import_name_offsets = result_unwrap(save_offset)
                let symbol: Result[String, String] = pe_import_field(imports, index, 1)
                if is_err(symbol) { return err("PE: malformed import table") }
                name_records = pe_append(name_records, pe_u16(0))
                name_records = pe_append(name_records, u8_array(string_to_bytes(result_unwrap(symbol))))
                name_records = array_push(name_records, u8(0))
                name_records = pe_pad_to(name_records, 2)
            }
            index = index + 1
        }
        group = group + 1
    }

    let mut first_thunk: Int = 0
    let mut descriptor_index: Int = 0
    group = 0
    while group < dll_count {
        let dll_for_descriptors: String = unwrap_or(array_get(dlls, group), "")
        let group_first: Int = first_thunk
        index = 0
        while index < len(imports) {
            let import_dll_for_lookup: Result[String, String] = pe_import_field(imports, index, 0)
            if is_err(import_dll_for_lookup) { return err("PE: malformed import table") }
            if result_unwrap(import_dll_for_lookup) == dll_for_descriptors {
                let lookup_name_offset: Int = unwrap_or(array_get(import_name_offsets, index), -1)
                if lookup_name_offset < 0 { return err("PE: import name offset is invalid") }
                let name_rva: Int = idata_rva + lookup_name_offset
                let thunk: Array[UInt8] = pe_u64(name_rva)
                idata = pe_append(idata, thunk)
                index = index + 1
            } else {
                index = index + 1
            }
        }
        idata = pe_append(idata, pe_u64(0))
        let descriptor_offset: Int = descriptor_index * 20
        let ilt_rva: Int = idata_rva + ilt_offset + group_first * 8
        let iat_rva: Int = idata_rva + iat_offset + group_first * 8
        let original_patch: Result[Array[UInt8], String] = pe_patch_u32(idata, descriptor_offset, ilt_rva)
        if is_err(original_patch) { return err("PE: failed to write import lookup descriptor") }
        idata = result_unwrap(original_patch)
        let name_patch: Result[Array[UInt8], String] = pe_patch_u32(idata, descriptor_offset + 12, idata_rva + unwrap_or(array_get(dll_offsets, group), 0))
        if is_err(name_patch) { return err("PE: failed to write import DLL descriptor") }
        idata = result_unwrap(name_patch)
        let address_patch: Result[Array[UInt8], String] = pe_patch_u32(idata, descriptor_offset + 16, iat_rva)
        if is_err(address_patch) { return err("PE: failed to write import address descriptor") }
        idata = result_unwrap(address_patch)
        let mut members: Int = 0
        index = 0
        while index < len(imports) {
            let import_dll_for_count: Result[String, String] = pe_import_field(imports, index, 0)
            if is_err(import_dll_for_count) { return err("PE: malformed import table") }
            if result_unwrap(import_dll_for_count) == dll_for_descriptors { members = members + 1 }
            index = index + 1
        }
        first_thunk = first_thunk + members + 1
        descriptor_index = descriptor_index + 1
        group = group + 1
    }
    if len(idata) != iat_offset { return err("PE: import lookup table size is inconsistent") }
    group = 0
    while group < dll_count {
        let dll_for_iat: String = unwrap_or(array_get(dlls, group), "")
        index = 0
        while index < len(imports) {
            let import_dll_for_iat: Result[String, String] = pe_import_field(imports, index, 0)
            if is_err(import_dll_for_iat) { return err("PE: malformed import table") }
            if result_unwrap(import_dll_for_iat) == dll_for_iat {
                let iat_name_offset: Int = unwrap_or(array_get(import_name_offsets, index), -1)
                if iat_name_offset < 0 { return err("PE: import name offset is invalid") }
                idata = pe_append(idata, pe_u64(idata_rva + iat_name_offset))
            }
            index = index + 1
        }
        idata = pe_append(idata, pe_u64(0))
        group = group + 1
    }
    if len(idata) != name_data_offset { return err("PE: import address table size is inconsistent") }
    idata = pe_append(idata, name_records)
    if len(idata) > 4294967295 - idata_rva { return err("PE: import data exceeds the 32-bit RVA range") }
    return ok(idata)
}

fn pe_section_header(name: String, rva: Int, virtual_size: Int, raw_size: Int, raw_pointer: Int, flags: Int) -> Array[UInt8] {
    let mut result: Array[UInt8] = u8_array(string_to_bytes(name))
    while len(result) < 8 { result = array_push(result, u8(0)) }
    result = pe_append(result, pe_u32(virtual_size))
    result = pe_append(result, pe_u32(rva))
    result = pe_append(result, pe_u32(raw_size))
    result = pe_append(result, pe_u32(raw_pointer))
    result = pe_append(result, pe_zeros(12))
    result = pe_append(result, pe_u32(flags))
    return result
}

fn pe_optional_header(layout: Array[Int]) -> Array[UInt8] {
    let code_size: Int = unwrap_or(array_get(layout, 0), 0)
    let data_raw_size: Int = unwrap_or(array_get(layout, 1), 0)
    let idata_raw_size: Int = unwrap_or(array_get(layout, 2), 0)
    let pdata_raw_size: Int = unwrap_or(array_get(layout, 3), 0)
    let reloc_raw_size: Int = unwrap_or(array_get(layout, 4), 0)
    let image_size: Int = unwrap_or(array_get(layout, 5), 0)
    let rdata_rva: Int = unwrap_or(array_get(layout, 6), 0)
    let idata_rva: Int = unwrap_or(array_get(layout, 7), 0)
    let pdata_rva: Int = unwrap_or(array_get(layout, 8), 0)
    let exception_size: Int = unwrap_or(array_get(layout, 9), 0)
    let iat_rva: Int = unwrap_or(array_get(layout, 10), 0)
    let reloc_rva: Int = unwrap_or(array_get(layout, 11), 0)
    let reloc_size: Int = unwrap_or(array_get(layout, 12), 0)
    let import_directory_size: Int = unwrap_or(array_get(layout, 13), 0)
    let iat_size: Int = unwrap_or(array_get(layout, 14), 0)
    let code_aligned: Int = result_unwrap(pe_aligned_size(code_size, 512))
    let initialized_size: Int = data_raw_size + idata_raw_size + pdata_raw_size + reloc_raw_size
    let mut optional: Array[UInt8] = []
    optional = pe_append(optional, pe_u16(523))
    optional = pe_append(optional, [u8(1), u8(0)])
    optional = pe_append(optional, pe_u32(code_aligned))
    optional = pe_append(optional, pe_u32(initialized_size))
    optional = pe_append(optional, pe_u32(0))
    optional = pe_append(optional, pe_u32(4096))
    optional = pe_append(optional, pe_u32(4096))
    optional = pe_append(optional, pe_u64(pe_preferred_image_base()))
    optional = pe_append(optional, pe_u32(4096))
    optional = pe_append(optional, pe_u32(512))
    optional = pe_append(optional, pe_u16(6))
    optional = pe_append(optional, pe_u16(0))
    optional = pe_append(optional, pe_u16(0))
    optional = pe_append(optional, pe_u16(0))
    optional = pe_append(optional, pe_u16(6))
    optional = pe_append(optional, pe_u16(0))
    optional = pe_append(optional, pe_u32(0))
    optional = pe_append(optional, pe_u32(image_size))
    optional = pe_append(optional, pe_u32(1024))
    optional = pe_append(optional, pe_u32(0))
    optional = pe_append(optional, pe_u16(3))
    optional = pe_append(optional, pe_u16(352))
    optional = pe_append(optional, pe_u64(1048576))
    optional = pe_append(optional, pe_u64(4096))
    optional = pe_append(optional, pe_u64(1048576))
    optional = pe_append(optional, pe_u64(4096))
    optional = pe_append(optional, pe_u32(0))
    optional = pe_append(optional, pe_u32(16))
    let mut directory_index: Int = 0
    while directory_index < 16 {
        if directory_index == 1 {
            optional = pe_append(optional, pe_u32(idata_rva))
            optional = pe_append(optional, pe_u32(import_directory_size))
        } else if directory_index == 3 {
            optional = pe_append(optional, pe_u32(pdata_rva))
            optional = pe_append(optional, pe_u32(exception_size))
        } else if directory_index == 5 {
            optional = pe_append(optional, pe_u32(reloc_rva))
            optional = pe_append(optional, pe_u32(reloc_size))
        } else if directory_index == 12 {
            optional = pe_append(optional, pe_u32(iat_rva))
            optional = pe_append(optional, pe_u32(iat_size))
        } else {
            optional = pe_append(optional, pe_zeros(8))
        }
        directory_index = directory_index + 1
    }
    return optional
}

fn pe_build_headers(layout: Array[Int]) -> Result[Array[UInt8], String] {
    let code_size: Int = unwrap_or(array_get(layout, 0), 0)
    let data_size: Int = unwrap_or(array_get(layout, 1), 0)
    let idata_size: Int = unwrap_or(array_get(layout, 2), 0)
    let pdata_size: Int = unwrap_or(array_get(layout, 3), 0)
    let reloc_size: Int = unwrap_or(array_get(layout, 4), 0)
    let exception_size: Int = unwrap_or(array_get(layout, 5), 0)
    let import_directory_size: Int = unwrap_or(array_get(layout, 6), 0)
    let iat_offset: Int = unwrap_or(array_get(layout, 7), 0)
    let iat_size: Int = unwrap_or(array_get(layout, 8), 0)
    let code_raw_size_result: Result[Int, String] = pe_aligned_size(code_size, 512)
    let data_raw_size_result: Result[Int, String] = pe_aligned_size(data_size, 512)
    let idata_raw_size_result: Result[Int, String] = pe_aligned_size(idata_size, 512)
    let pdata_raw_size_result: Result[Int, String] = pe_aligned_size(pdata_size, 512)
    let reloc_raw_size_result: Result[Int, String] = pe_aligned_size(reloc_size, 512)
    if is_err(code_raw_size_result) || is_err(data_raw_size_result) || is_err(idata_raw_size_result) || is_err(pdata_raw_size_result) || is_err(reloc_raw_size_result) {
        return err("PE: section raw size exceeds the file range")
    }
    let code_raw: Int = 1024
    let data_raw: Int = code_raw + result_unwrap(code_raw_size_result)
    let idata_raw: Int = data_raw + result_unwrap(data_raw_size_result)
    let pdata_raw: Int = idata_raw + result_unwrap(idata_raw_size_result)
    let reloc_raw: Int = pdata_raw + result_unwrap(pdata_raw_size_result)
    let rdata_rva: Int = 4096 + result_unwrap(pe_aligned_size(code_size, 4096))
    let idata_rva: Int = rdata_rva + result_unwrap(pe_aligned_size(data_size, 4096))
    let pdata_rva: Int = idata_rva + result_unwrap(pe_aligned_size(idata_size, 4096))
    let reloc_rva: Int = pdata_rva + result_unwrap(pe_aligned_size(pdata_size, 4096))
    let image_size: Int = reloc_rva + result_unwrap(pe_aligned_size(reloc_size, 4096))
    let mut iat_rva: Int = 0
    if iat_size > 0 { iat_rva = idata_rva + iat_offset }
    let mut header: Array[UInt8] = pe_zeros(128)
    let magic0: Result[Array[UInt8], String] = array_set(header, 0, u8(77))
    if is_err(magic0) { return err("PE: failed to write DOS signature") }
    header = result_unwrap(magic0)
    let magic1: Result[Array[UInt8], String] = array_set(header, 1, u8(90))
    if is_err(magic1) { return err("PE: failed to write DOS signature") }
    header = result_unwrap(magic1)
    let dos_pointer: Result[Array[UInt8], String] = pe_patch_u32(header, 60, 128)
    if is_err(dos_pointer) { return err("PE: failed to write DOS header offset") }
    header = result_unwrap(dos_pointer)
    if len(header) != 128 { return err("PE: DOS header size is invalid") }
    header = pe_append(header, [u8(80), u8(69), u8(0), u8(0)])
    header = pe_append(header, pe_u16(34404))
    header = pe_append(header, pe_u16(5))
    header = pe_append(header, pe_u32(0))
    header = pe_append(header, pe_u32(0))
    header = pe_append(header, pe_u32(0))
    header = pe_append(header, pe_u16(240))
    header = pe_append(header, pe_u16(34))
    let optional_layout: Array[Int] = [code_size, result_unwrap(data_raw_size_result), result_unwrap(idata_raw_size_result), result_unwrap(pdata_raw_size_result), result_unwrap(reloc_raw_size_result), image_size, rdata_rva, idata_rva, pdata_rva, exception_size, iat_rva, reloc_rva, reloc_size, import_directory_size, iat_size]
    let optional: Array[UInt8] = pe_optional_header(optional_layout)
    if len(optional) != 240 { return err("PE: optional header size is invalid") }
    header = pe_append(header, optional)
    header = pe_append(header, pe_section_header(".text", 4096, code_size, result_unwrap(code_raw_size_result), code_raw, 1610612768))
    header = pe_append(header, pe_section_header(".rdata", rdata_rva, data_size, result_unwrap(data_raw_size_result), data_raw, 1073741888))
    header = pe_append(header, pe_section_header(".idata", idata_rva, idata_size, result_unwrap(idata_raw_size_result), idata_raw, 3221225536))
    header = pe_append(header, pe_section_header(".pdata", pdata_rva, pdata_size, result_unwrap(pdata_raw_size_result), pdata_raw, 1073741888))
    header = pe_append(header, pe_section_header(".reloc", reloc_rva, reloc_size, result_unwrap(reloc_raw_size_result), reloc_raw, 1107296320))
    if len(header) > 1024 { return err("PE: headers exceed the configured 0x400-byte header area") }
    header = pe_append(header, pe_zeros(1024 - len(header)))
    return ok(header)
}

fn pe_apply_patches(code: Array[UInt8], data: Array[UInt8], patch_layout: Array[Int], iat_slots: Array[Int], import_patches: Array[Array[Int]], data_patches: Array[Array[Int]]) -> Result[Array[UInt8], String] {
    let data_rva: Int = unwrap_or(array_get(patch_layout, 0), -1)
    let idata_rva: Int = unwrap_or(array_get(patch_layout, 1), -1)
    let iat_offset: Int = unwrap_or(array_get(patch_layout, 2), -1)
    if data_rva < 0 || idata_rva < 0 || iat_offset < 0 { return err("PE: patch layout is malformed") }
    let mut patched: Array[UInt8] = code
    let mut data_index: Int = 0
    while data_index < len(data_patches) {
        let patch: Array[Int] = unwrap_or(array_get(data_patches, data_index), [])
        let displacement: Int = unwrap_or(array_get(patch, 0), -1)
        let instruction_end: Int = unwrap_or(array_get(patch, 1), -1)
        let data_offset: Int = unwrap_or(array_get(patch, 2), -1)
        if data_offset > len(data) { return err("PE: .rdata reference points past the data section") }
        let delta: Int = data_rva + data_offset - 4096 - instruction_end
        let update: Result[Array[UInt8], String] = pe_patch_i32(patched, displacement, delta)
        if is_err(update) { return err(unwrap_or(result_error(update), "PE: .rdata reference cannot be encoded")) }
        patched = result_unwrap(update)
        data_index = data_index + 1
    }
    let mut import_index: Int = 0
    while import_index < len(import_patches) {
        let import_patch: Array[Int] = unwrap_or(array_get(import_patches, import_index), [])
        let import_displacement: Int = unwrap_or(array_get(import_patch, 0), -1)
        let import_instruction_end: Int = unwrap_or(array_get(import_patch, 1), -1)
        let import_number: Int = unwrap_or(array_get(import_patch, 2), -1)
        let iat_slot: Option[Int] = array_get(iat_slots, import_number)
        if is_none(iat_slot) { return err("PE: import patch index is outside the import table") }
        let iat_rva: Int = idata_rva + iat_offset + unwrap_or(iat_slot, -1) * 8
        let import_delta: Int = iat_rva - 4096 - import_instruction_end
        let import_update: Result[Array[UInt8], String] = pe_patch_i32(patched, import_displacement, import_delta)
        if is_err(import_update) { return err(unwrap_or(result_error(import_update), "PE: IAT reference cannot be encoded")) }
        patched = result_unwrap(import_update)
        import_index = import_index + 1
    }
    return ok(patched)
}

pub fn emit_pe32plus(code: Array[UInt8], data: Array[UInt8], import_patches: Array[Array[Int]], function_ranges: Array[Array[Int]]) -> Result[Bytes, String] {
    return emit_pe32plus_with_imports_and_data_patches(code, data, pe_console_imports(), [], import_patches, function_ranges)
}

pub fn emit_pe32plus_with_data_patches(code: Array[UInt8], data: Array[UInt8], data_patches: Array[Array[Int]], import_patches: Array[Array[Int]], function_ranges: Array[Array[Int]]) -> Result[Bytes, String] {
    return emit_pe32plus_with_imports_and_data_patches(code, data, pe_console_imports(), data_patches, import_patches, function_ranges)
}

pub fn emit_pe32plus_with_imports(code: Array[UInt8], data: Array[UInt8], imports: Array[Array[String]], import_patches: Array[Array[Int]], function_ranges: Array[Array[Int]]) -> Result[Bytes, String] {
    return emit_pe32plus_with_imports_and_data_patches(code, data, imports, [], import_patches, function_ranges)
}

fn pe_console_imports() -> Array[Array[String]] {
    return [["KERNEL32.dll", "GetStdHandle"], ["KERNEL32.dll", "WriteFile"], ["KERNEL32.dll", "ExitProcess"]]
}

pub fn emit_pe32plus_with_imports_and_data_patches(code: Array[UInt8], data: Array[UInt8], imports: Array[Array[String]], data_patches: Array[Array[Int]], import_patches: Array[Array[Int]], function_ranges: Array[Array[Int]]) -> Result[Bytes, String] {
    if len(code) == 0 || len(code) > 2147483000 || len(data) > 2147483000 {
        return err("PE: code or data section has an invalid size")
    }
    let imports_valid: Result[Bool, String] = pe_validate_imports(imports)
    if is_err(imports_valid) { return err(unwrap_or(result_error(imports_valid), "PE: invalid import descriptors")) }
    let iat_slots_result: Result[Array[Int], String] = pe_import_iat_slots(imports)
    if is_err(iat_slots_result) { return err(unwrap_or(result_error(iat_slots_result), "PE: import slot mapping failed")) }
    let iat_slots: Array[Int] = result_unwrap(iat_slots_result)
    let mut actual_data: Array[UInt8] = data
    if len(actual_data) == 0 { actual_data = [u8(0)] }
    let user_data_size: Int = len(actual_data)
    actual_data = pe_pad_to(actual_data, 8)
    if len(actual_data) % 4096 > 4088 {
        actual_data = pe_append(actual_data, pe_zeros(4096 - (len(actual_data) % 4096)))
    }
    let relocation_anchor_offset: Int = len(actual_data)
    actual_data = pe_append(actual_data, pe_u64(pe_preferred_image_base() + 4096))
    let ranges_result: Result[Array[Array[Int]], String] = pe_validate_ranges(code, function_ranges)
    if is_err(ranges_result) { return err(unwrap_or(result_error(ranges_result), "PE: invalid function unwind ranges")) }
    let sorted_ranges: Array[Array[Int]] = result_unwrap(ranges_result)
    let import_valid: Result[Bool, String] = pe_validate_patches(len(code), import_patches, true, len(imports))
    if is_err(import_valid) { return err(unwrap_or(result_error(import_valid), "PE: invalid import patches")) }
    let data_valid: Result[Bool, String] = pe_validate_patches(len(code), data_patches, false, 0)
    if is_err(data_valid) { return err(unwrap_or(result_error(data_valid), "PE: invalid data patches")) }
    let all_patches: Array[Array[Int]] = array_concat(import_patches, data_patches)
    let disjoint_patches: Result[Bool, String] = pe_validate_patch_sets(all_patches)
    if is_err(disjoint_patches) { return err(unwrap_or(result_error(disjoint_patches), "PE: overlapping data/import patches")) }
    let mut patch_index: Int = 0
    while patch_index < len(data_patches) {
        let patch: Array[Int] = unwrap_or(array_get(data_patches, patch_index), [])
        if unwrap_or(array_get(patch, 2), -1) > user_data_size {
            return err("PE: .rdata reference points past the data section")
        }
        patch_index = patch_index + 1
    }

    let code_virtual_result: Result[Int, String] = pe_aligned_size(len(code), 4096)
    if is_err(code_virtual_result) { return err(unwrap_or(result_error(code_virtual_result), "PE: .text alignment failed")) }
    let data_virtual_result: Result[Int, String] = pe_aligned_size(len(actual_data), 4096)
    if is_err(data_virtual_result) { return err(unwrap_or(result_error(data_virtual_result), "PE: .rdata alignment failed")) }
    let rdata_rva: Int = 4096 + result_unwrap(code_virtual_result)
    let idata_rva: Int = rdata_rva + result_unwrap(data_virtual_result)
    if idata_rva > 4294967295 { return err("PE: .idata RVA exceeds the 32-bit image range") }
    let import_layout_result: Result[Array[Int], String] = pe_import_layout(imports)
    if is_err(import_layout_result) { return err(unwrap_or(result_error(import_layout_result), "PE: import table layout failed")) }
    let import_layout: Array[Int] = result_unwrap(import_layout_result)
    let import_directory_size: Int = unwrap_or(array_get(import_layout, 0), 0)
    let iat_offset: Int = unwrap_or(array_get(import_layout, 1), 0)
    let iat_size: Int = unwrap_or(array_get(import_layout, 2), 0)
    let idata_result: Result[Array[UInt8], String] = pe_import_data(idata_rva, imports)
    if is_err(idata_result) { return err(unwrap_or(result_error(idata_result), "PE: import table generation failed")) }
    let idata: Array[UInt8] = result_unwrap(idata_result)
    let idata_virtual_result: Result[Int, String] = pe_aligned_size(len(idata), 4096)
    if is_err(idata_virtual_result) { return err(unwrap_or(result_error(idata_virtual_result), "PE: .idata alignment failed")) }
    let pdata_rva: Int = idata_rva + result_unwrap(idata_virtual_result)
    if pdata_rva > 4294967295 { return err("PE: .pdata RVA exceeds the 32-bit image range") }
    let pdata_result: Result[Array[UInt8], String] = pe_build_pdata(sorted_ranges, pdata_rva)
    if is_err(pdata_result) { return err(unwrap_or(result_error(pdata_result), "PE: unwind data generation failed")) }
    let pdata: Array[UInt8] = result_unwrap(pdata_result)
    let pdata_virtual_result: Result[Int, String] = pe_aligned_size(len(pdata), 4096)
    if is_err(pdata_virtual_result) { return err(unwrap_or(result_error(pdata_virtual_result), "PE: .pdata alignment failed")) }
    let reloc_rva: Int = pdata_rva + result_unwrap(pdata_virtual_result)
    if reloc_rva > 4294967295 { return err("PE: .reloc RVA exceeds the 32-bit image range") }
    let reloc_result: Result[Array[UInt8], String] = pe_build_reloc(rdata_rva, relocation_anchor_offset)
    if is_err(reloc_result) { return err(unwrap_or(result_error(reloc_result), "PE: base relocation generation failed")) }
    let reloc: Array[UInt8] = result_unwrap(reloc_result)
    let reloc_virtual_result: Result[Int, String] = pe_aligned_size(len(reloc), 4096)
    if is_err(reloc_virtual_result) { return err(unwrap_or(result_error(reloc_virtual_result), "PE: .reloc alignment failed")) }
    let image_size: Int = reloc_rva + result_unwrap(reloc_virtual_result)
    if image_size > 4294967295 { return err("PE: image size exceeds the 32-bit range") }

    let code_raw_result: Result[Int, String] = pe_aligned_size(len(code), 512)
    let data_raw_result: Result[Int, String] = pe_aligned_size(len(actual_data), 512)
    let idata_raw_result: Result[Int, String] = pe_aligned_size(len(idata), 512)
    let pdata_raw_result: Result[Int, String] = pe_aligned_size(len(pdata), 512)
    let reloc_raw_result: Result[Int, String] = pe_aligned_size(len(reloc), 512)
    if is_err(code_raw_result) || is_err(data_raw_result) || is_err(idata_raw_result) || is_err(pdata_raw_result) || is_err(reloc_raw_result) {
        return err("PE: file section alignment failed")
    }
    let code_raw: Int = result_unwrap(code_raw_result)
    let data_raw: Int = result_unwrap(data_raw_result)
    let idata_raw: Int = result_unwrap(idata_raw_result)
    let pdata_raw: Int = result_unwrap(pdata_raw_result)
    let reloc_raw: Int = result_unwrap(reloc_raw_result)
    let rdata_pointer: Int = 1024 + code_raw
    let idata_pointer: Int = rdata_pointer + data_raw
    let pdata_pointer: Int = idata_pointer + idata_raw
    let reloc_pointer: Int = pdata_pointer + pdata_raw
    let file_size: Int = reloc_pointer + reloc_raw
    if file_size > 2147483647 { return err("PE: executable exceeds the supported in-memory file size") }

    let patch_layout: Array[Int] = [rdata_rva, idata_rva, iat_offset]
    let patched_code_result: Result[Array[UInt8], String] = pe_apply_patches(code, actual_data, patch_layout, iat_slots, import_patches, data_patches)
    if is_err(patched_code_result) { return err(unwrap_or(result_error(patched_code_result), "PE: code relocation failed")) }
    let patched_code: Array[UInt8] = result_unwrap(patched_code_result)
    let header_layout: Array[Int] = [len(code), len(actual_data), len(idata), len(pdata), len(reloc), len(sorted_ranges) * 12, import_directory_size, iat_offset, iat_size]
    let headers_result: Result[Array[UInt8], String] = pe_build_headers(header_layout)
    if is_err(headers_result) { return err(unwrap_or(result_error(headers_result), "PE: header generation failed")) }
    let mut file: Array[UInt8] = result_unwrap(headers_result)
    file = pe_append(file, patched_code)
    file = pe_append(file, pe_zeros(code_raw - len(code)))
    file = pe_append(file, actual_data)
    file = pe_append(file, pe_zeros(data_raw - len(actual_data)))
    file = pe_append(file, idata)
    file = pe_append(file, pe_zeros(idata_raw - len(idata)))
    file = pe_append(file, pdata)
    file = pe_append(file, pe_zeros(pdata_raw - len(pdata)))
    file = pe_append(file, reloc)
    file = pe_append(file, pe_zeros(reloc_raw - len(reloc)))
    if len(file) != file_size { return err("PE: generated file size does not match its headers") }
    return ok(bytes_from_u8(file))
}
