import "std/env"
import "packages/discord"

fn respond_to_ping(context_json: String) -> String {
    let context: Json = result_unwrap(json_parse(context_json))
    let raw_command: Json = result_unwrap(json_object_get(context, "command"))
    let command: String = result_unwrap(json_string(raw_command))
    if command == "ping" { return "Pong!" }
    return ""
}

fn main() -> Result[Nil, String] {
    let token: Result[String, String] = require("DISCORD_TOKEN")
    match token {
        ok(secret) => {
            let intents: Array[String] = ["Guilds", "GuildMessages", "MessageContent"]
            let client: Result[Bot, String] = bot(secret, intents)
            match client {
                ok(connected) => {
                    let configured: Result[Bot, String] = connected.with_shard(0, 1)
                    match configured {
                        ok(sharded) => {
                            let prefixed: Result[Bot, String] = sharded.with_prefixes(["!"])
                            match prefixed {
                                ok(client) => {
                                    let registration: Result[Nil, String] = poly_register("discord.on_prefix_command.ping", "respond_to_ping", 0)
                                    match registration {
                                        ok(_) => { return client.run() }
                                        err(problem) => { return err(problem) }
                                    }
                                }
                                err(problem) => { return err(problem) }
                            }
                        }
                        err(problem) => { return err(problem) }
                    }
                }
                err(problem) => {
                    return err(problem)
                }
            }
        }
        err(problem) => {
            return err(problem)
        }
    }
}
