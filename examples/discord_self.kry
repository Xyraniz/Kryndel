import "std/env"
import "discord-self"

fn set_activity_when_ready(event_json: String) -> String {
    let event: Json = result_unwrap(json_parse(event_json))
    let raw_name: Json = result_unwrap(json_object_get(event, "name"))
    let name: String = result_unwrap(json_string(raw_name))
    if name == "READY" {
        let activity: String = result_unwrap(rpc_activity_json("Kryndel", 0, "Kryndel runtime", ""))
        let result: Result[Nil, String] = set_presence_json("online", "[" + activity + "]", false)
        match result {
            ok(_) => {}
            err(problem) => { println("Could not update presence: " + problem) }
        }
    }
    return ""
}

fn inspect_self_account(
    client: Client,
    user_id: String,
    guild_id: String,
    channel_id: String,
    invite_code: String,
    sticker_id: String,
    sticker_pack_id: String,
    join_request_id: String
) -> Result[Nil, String] {
    let guild_preview: Json = client.fetch_guild_preview(guild_id)?
    let guild_profile: Json = client.fetch_guild_profile(guild_id)?
    let stage_instance: Json = client.fetch_stage_instance(channel_id)?
    let user_profile: Json = client.fetch_user_profile(user_id)?
    let private_channels: Json = client.fetch_private_channels()?
    let relationships: Json = client.fetch_relationships()?
    let connections: Json = client.fetch_connections()?
    let notes: Json = client.fetch_notes()?
    let note: Json = client.fetch_note(user_id)?
    let invite: Json = client.fetch_invite(invite_code)?
    let widget: Json = client.fetch_widget(guild_id)?
    let sticker: Json = client.fetch_sticker(sticker_id)?
    let sticker_pack: Json = client.fetch_sticker_pack(sticker_pack_id)?
    let verification: Json = client.fetch_member_verification(guild_id, false, invite_code)?
    let join_request: Json = client.fetch_join_request(join_request_id)?
    let join_request_guilds: Json = client.join_request_guilds()?
    let settings: Json = client.fetch_settings()?
    let tracking_settings: Json = client.fetch_tracking_settings()?
    let friend_suggestions: Json = client.friend_suggestions()?
    return ok(nil)
}

fn update_self_note(client: Client, user_id: String, note: String) -> Result[Nil, String] {
    return client.edit_note(user_id, note)
}

fn main() -> Result[Nil, String] {
    let token: String = require("DISCORD_USER_TOKEN")?
    let client: Client = self_client(token)?
    let registered: Result[Nil, String] = poly_register("discord_self.on_event", "set_activity_when_ready", 0)
    match registered {
        ok(_) => { return client.run() }
        err(problem) => { return err(problem) }
    }
}
