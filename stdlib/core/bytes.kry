pub fn new(value: Array) -> Bytes {
    return bytes(value)
}

pub fn from_string(value: String) -> Bytes {
    return string_to_bytes(value)
}

pub fn to_string(value: Bytes) -> String {
    return bytes_to_string(value)
}

pub fn length(value: Bytes) -> Int {
    return len(value)
}

pub fn get(value: Bytes, index: Int) -> Int {
    return value[index]
}

pub fn concat(left: Bytes, right: Bytes) -> Bytes {
    return left + right
}
