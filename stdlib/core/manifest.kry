// Strict kry.toml subset parser written in Kryndel source.
// The bootstrap still uses packages.py as a differential oracle.

struct Dependency {
    name: String
    requirement: String
}

struct Manifest {
    name: String
    version: String
    edition: String
    dependencies: Array
}

enum ManifestResult {
    Ok(Manifest)
    Error(String)
}

fn result_error(code: String, message: String) -> ManifestResult {
    return ManifestResult.Error(code + " " + message)
}

fn is_digit(value: String) -> Bool {
    return value >= "0" and value <= "9"
}

fn digits(value: String) -> Bool {
    if value == "" {
        return false
    }
    let mut index: Int = 0
    while index < len(value) {
        if !is_digit(value[index]) {
            return false
        }
        index = index + 1
    }
    return true
}

fn identifier(value: String) -> Bool {
    if value == "" {
        return false
    }
    let first: String = value[0]
    if !((first >= "A" and first <= "Z") or (first >= "a" and first <= "z")) {
        return false
    }
    let mut index: Int = 1
    while index < len(value) {
        let character: String = value[index]
        if !((character >= "A" and character <= "Z") or (character >= "a" and character <= "z") or (character >= "0" and character <= "9") or character == "_" or character == "-") {
            return false
        }
        index = index + 1
    }
    return true
}

fn trim(value: String) -> String {
    let mut start: Int = 0
    let mut end: Int = len(value)
    while start < end and (value[start] == " " or value[start] == "\t" or value[start] == "\r") {
        start = start + 1
    }
    while end > start and (value[end - 1] == " " or value[end - 1] == "\t" or value[end - 1] == "\r") {
        end = end - 1
    }
    let mut result: String = ""
    let mut index: Int = start
    while index < end {
        result = result + value[index]
        index = index + 1
    }
    return result
}

fn find(value: String, needle: String) -> Int {
    if needle == "" {
        return 0
    }
    if len(needle) > len(value) {
        return -1
    }
    let mut index: Int = 0
    while index + len(needle) <= len(value) {
        let mut matches: Bool = true
        let mut offset: Int = 0
        while offset < len(needle) {
            if value[index + offset] != needle[offset] {
                matches = false
            }
            offset = offset + 1
        }
        if matches {
            return index
        }
        index = index + 1
    }
    return -1
}

fn slice(value: String, start: Int, end: Int) -> String {
    let mut result: String = ""
    let mut index: Int = start
    while index < end {
        result = result + value[index]
        index = index + 1
    }
    return result
}

fn full_version(value: String) -> Bool {
    let first: Int = find(value, ".")
    if first <= 0 {
        return false
    }
    let second: Int = find(slice(value, first + 1, len(value)), ".")
    if second < 0 {
        return false
    }
    let second_absolute: Int = first + 1 + second
    if second_absolute <= first + 1 or second_absolute >= len(value) - 1 {
        return false
    }
    let major: String = slice(value, 0, first)
    let minor: String = slice(value, first + 1, second_absolute)
    let patch: String = slice(value, second_absolute + 1, len(value))
    if !digits(major) or !digits(minor) or !digits(patch) {
        return false
    }
    if len(major) > 1 and major[0] == "0" {
        return false
    }
    if len(minor) > 1 and minor[0] == "0" {
        return false
    }
    if len(patch) > 1 and patch[0] == "0" {
        return false
    }
    return true
}

fn partial_version(value: String) -> Bool {
    let first: Int = find(value, ".")
    if first < 0 {
        return digits(value)
    }
    if first == 0 or first == len(value) - 1 or find(slice(value, first + 1, len(value)), ".") >= 0 {
        return false
    }
    let major: String = slice(value, 0, first)
    let minor: String = slice(value, first + 1, len(value))
    return digits(major) and digits(minor)
}

fn requirement(value: String) -> Bool {
    if value == "" {
        return false
    }
    if len(value) >= 5 and slice(value, 0, 5) == "path:" {
        let path: String = slice(value, 5, len(value))
        return path != "" and path[0] != "/" and find(path, "\\") < 0
    }
    if value[0] == "^" or value[0] == "~" {
        return partial_version(slice(value, 1, len(value)))
    }
    if len(value) >= 4 and slice(value, 0, 2) == ">=" {
        let comma: Int = find(value, ",")
        if comma < 0 or comma + 1 >= len(value) or slice(value, comma + 1, comma + 2) != "<" {
            return false
        }
        return full_version(slice(value, 2, comma)) and full_version(slice(value, comma + 2, len(value)))
    }
    return full_version(value)
}

fn parse_assignment(raw_line: String) -> Tuple {
    let equals: Int = find(raw_line, "=")
    if equals < 0 {
        return ("error", "manifest assignment must be key = \"value\"", "")
    }
    let key: String = trim(slice(raw_line, 0, equals))
    let raw_value: String = trim(slice(raw_line, equals + 1, len(raw_line)))
    if !identifier(key) or len(raw_value) < 2 or raw_value[0] != "\"" or raw_value[len(raw_value) - 1] != "\"" {
        return ("error", "unsupported manifest syntax", "")
    }
    let value: String = slice(raw_value, 1, len(raw_value) - 1)
    if find(value, "\\") >= 0 or find(value, "\"") >= 0 {
        return ("error", "unsupported string escape", "")
    }
    return ("ok", key, value)
}

pub fn parse(text: String) -> ManifestResult {
    let mut section: String = ""
    let mut package_name: String = ""
    let mut package_version: String = ""
    let mut package_edition: String = ""
    let mut has_name: Bool = false
    let mut has_version: Bool = false
    let mut has_edition: Bool = false
    let mut dependencies: Array = []
    let mut cursor: Int = 0
    while cursor < len(text) {
        let remaining: String = slice(text, cursor, len(text))
        let newline: Int = find(remaining, "\n")
        let mut line: String = remaining
        if newline >= 0 {
            line = slice(remaining, 0, newline)
            cursor = cursor + newline + 1
        } else {
            cursor = len(text)
        }
        let cleaned: String = trim(line)
        if cleaned == "" or cleaned[0] == "#" {
            continue
        }
        if cleaned[0] == "[" and cleaned[len(cleaned) - 1] == "]" {
            section = slice(cleaned, 1, len(cleaned) - 1)
            if section != "package" and section != "dependencies" {
                return result_error("KRY5001", "unsupported manifest section")
            }
            continue
        }
        if section != "package" and section != "dependencies" {
            return result_error("KRY5001", "manifest assignment is outside a supported section")
        }
        let assignment: Tuple = parse_assignment(cleaned)
        if assignment[0] == "error" {
            return result_error("KRY5001", assignment[1])
        }
        let key: String = assignment[1]
        let value: String = assignment[2]
        if section == "package" {
            if key == "name" {
                if has_name { return result_error("KRY5001", "duplicate manifest key name") }
                package_name = value
                has_name = true
            } else if key == "version" {
                if has_version { return result_error("KRY5001", "duplicate manifest key version") }
                package_version = value
                has_version = true
            } else if key == "edition" {
                if has_edition { return result_error("KRY5001", "duplicate manifest key edition") }
                package_edition = value
                has_edition = true
            } else {
                return result_error("KRY5001", "[package] contains an unsupported key")
            }
        } else {
            if !identifier(key) or !requirement(value) {
                return result_error("KRY5002", "invalid dependency declaration")
            }
            let mut index: Int = 0
            while index < len(dependencies) {
                let existing: Dependency = dependencies[index]
                if existing.name == key {
                    return result_error("KRY5001", "duplicate dependency declaration")
                }
                index = index + 1
            }
            let dependency: Dependency = Dependency { name: key, requirement: value }
            dependencies = array_push(dependencies, dependency)
        }
    }
    if !has_name or !has_version or !has_edition {
        return result_error("KRY5001", "[package] must contain exactly name, version, and edition")
    }
    if !identifier(package_name) or package_name == "." or package_name == ".." {
        return result_error("KRY5002", "invalid package name")
    }
    if !full_version(package_version) or !digits(package_edition) {
        return result_error("KRY5002", "invalid package version or edition")
    }
    return ManifestResult.Ok(Manifest {
        name: package_name,
        version: package_version,
        edition: package_edition,
        dependencies: dependencies,
    })
}

pub fn read(path: String) -> ManifestResult {
    return parse(fs.read_text(path))
}
