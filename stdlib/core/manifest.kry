// Strict kry.toml subset parser written in Kryndel source.
// The bootstrap still uses packages.py as a differential oracle.

struct Dependency {
    name: String
    requirement: String
}

struct Manifest {
    name: String
    version: String
    edition: String
    dependencies: Array
}

enum ManifestResult {
    Ok(Manifest)
    Error(String)
}

fn result_error(code: String, message: String) -> ManifestResult {
    return ManifestResult.Error(code + " " + message)
}

fn is_digit(value: String) -> Bool {
    return value >= "0" and value <= "9"
}

fn digits(value: String) -> Bool {
    if value == "" {
        return false
    }
    let mut index: Int = 0
    while index < len(value) {
        if !is_digit(value[index]) {
            return false
        }
        index = index + 1
    }
    return true
}

fn identifier(value: String) -> Bool {
    if value == "" {
        return false
    }
    let first: String = value[0]
    if !((first >= "A" and first <= "Z") or (first >= "a" and first <= "z")) {
        return false
    }
    let mut index: Int = 1
    while index < len(value) {
        let character: String = value[index]
        if !((character >= "A" and character <= "Z") or (character >= "a" and character <= "z") or (character >= "0" and character <= "9") or character == "_" or character == "-") {
            return false
        }
        index = index + 1
    }
    return true
}

fn trim(value: String) -> String {
    let mut start: Int = 0
    let mut end: Int = len(value)
    while start < end and (value[start] == " " or value[start] == "\t" or value[start] == "\r") {
        start = start + 1
    }
    while end > start and (value[end - 1] == " " or value[end - 1] == "\t" or value[end - 1] == "\r") {
        end = end - 1
    }
    let mut result: String = ""
    let mut index: Int = start
    while index < end {
        result = result + value[index]
        index = index + 1
    }
    return result
}

fn find(value: String, needle: String) -> Int {
    if needle == "" {
        return 0
    }
    if len(needle) > len(value) {
        return -1
    }
    let mut index: Int = 0
    while index + len(needle) <= len(value) {
        let mut matches: Bool = true
        let mut offset: Int = 0
        while offset < len(needle) {
            if value[index + offset] != needle[offset] {
                matches = false
            }
            offset = offset + 1
        }
        if matches {
            return index
        }
        index = index + 1
    }
    return -1
}

fn slice(value: String, start: Int, end: Int) -> String {
    let mut result: String = ""
    let mut index: Int = start
    while index < end {
        result = result + value[index]
        index = index + 1
    }
    return result
}

fn full_version(value: String) -> Bool {
    let first: Int = find(value, ".")
    if first <= 0 {
        return false
    }
    let second: Int = find(slice(value, first + 1, len(value)), ".")
    if second < 0 {
        return false
    }
    let second_absolute: Int = first + 1 + second
    if second_absolute <= first + 1 or second_absolute >= len(value) - 1 {
        return false
    }
    let major: String = slice(value, 0, first)
    let minor: String = slice(value, first + 1, second_absolute)
    let patch: String = slice(value, second_absolute + 1, len(value))
    if !digits(major) or !digits(minor) or !digits(patch) {
        return false
    }
    if len(major) > 1 and major[0] == "0" {
        return false
    }
    if len(minor) > 1 and minor[0] == "0" {
        return false
    }
    if len(patch) > 1 and patch[0] == "0" {
        return false
    }
    return true
}

fn version_at_least(left: String, right: String) -> Bool {
    let left_major: Int = int(slice(left, 0, find(left, ".")))
    let right_major: Int = int(slice(right, 0, find(right, ".")))
    if left_major != right_major {
        return left_major > right_major
    }
    let left_minor_start: Int = find(left, ".") + 1
    let right_minor_start: Int = find(right, ".") + 1
    let left_second: Int = find(slice(left, left_minor_start, len(left)), ".")
    let right_second: Int = find(slice(right, right_minor_start, len(right)), ".")
    let left_minor: Int = int(slice(left, left_minor_start, left_minor_start + left_second))
    let right_minor: Int = int(slice(right, right_minor_start, right_minor_start + right_second))
    if left_minor != right_minor {
        return left_minor > right_minor
    }
    let left_patch: Int = int(slice(left, left_minor_start + left_second + 1, len(left)))
    let right_patch: Int = int(slice(right, right_minor_start + right_second + 1, len(right)))
    return left_patch >= right_patch
}

fn partial_version(value: String) -> Bool {
    let first: Int = find(value, ".")
    if first < 0 {
        return digits(value)
    }
    if first == 0 or first == len(value) - 1 or find(slice(value, first + 1, len(value)), ".") >= 0 {
        return false
    }
    let major: String = slice(value, 0, first)
    let minor: String = slice(value, first + 1, len(value))
    return digits(major) and digits(minor)
}

fn requirement_error(value: String) -> String {
    if len(value) >= 5 and slice(value, 0, 5) == "path:" {
        let path: String = slice(value, 5, len(value))
        if path == "" {
            return "KRY5012"
        }
        if path[0] == "/" {
            return "KRY5010"
        }
        return ""
    }
    if value == "" or (value[0] != "^" and value[0] != "~" and value[0] != ">" and !full_version(value)) {
        return "KRY5012"
    }
    if !requirement(value) {
        return "KRY5012"
    }
    return ""
}

fn requirement(value: String) -> Bool {
    if value == "" {
        return false
    }
    if len(value) >= 5 and slice(value, 0, 5) == "path:" {
        let path: String = slice(value, 5, len(value))
        return path != "" and path[0] != "/" and find(path, "\\") < 0
    }
    if value[0] == "^" or value[0] == "~" {
        return partial_version(slice(value, 1, len(value)))
    }
    if len(value) >= 4 and slice(value, 0, 2) == ">=" {
        let comma: Int = find(value, ",")
        if comma < 0 or comma + 1 >= len(value) or slice(value, comma + 1, comma + 2) != "<" {
            return false
        }
        let lower: String = slice(value, 2, comma)
        let upper: String = slice(value, comma + 2, len(value))
        if !full_version(lower) or !full_version(upper) {
            return false
        }
        return !version_at_least(lower, upper)
    }
    return full_version(value)
}

fn parse_assignment(raw_line: String) -> Tuple {
    let equals: Int = find(raw_line, "=")
    if equals < 0 {
        return ("error", "manifest assignment must be key = \"value\"", "")
    }
    let key: String = trim(slice(raw_line, 0, equals))
    let raw_value: String = trim(slice(raw_line, equals + 1, len(raw_line)))
    if !identifier(key) or len(raw_value) < 2 or raw_value[0] != "\"" or raw_value[len(raw_value) - 1] != "\"" {
        return ("error", "unsupported manifest syntax", "")
    }
    let value: String = slice(raw_value, 1, len(raw_value) - 1)
    if find(value, "\\") >= 0 or find(value, "\"") >= 0 {
        return ("error", "unsupported string escape", "")
    }
    return ("ok", key, value)
}

pub fn parse(text: String) -> ManifestResult {
    let mut section: String = ""
    let mut package_name: String = ""
    let mut package_version: String = ""
    let mut package_edition: String = ""
    let mut has_name: Bool = false
    let mut has_version: Bool = false
    let mut has_edition: Bool = false
    let mut dependencies: Array = []
    let mut cursor: Int = 0
    while cursor < len(text) {
        let remaining: String = slice(text, cursor, len(text))
        let newline: Int = find(remaining, "\n")
        let mut line: String = remaining
        if newline >= 0 {
            line = slice(remaining, 0, newline)
            cursor = cursor + newline + 1
        } else {
            cursor = len(text)
        }
        let cleaned: String = trim(line)
        if cleaned == "" or cleaned[0] == "#" {
            continue
        }
        if cleaned[0] == "[" and cleaned[len(cleaned) - 1] == "]" {
            section = slice(cleaned, 1, len(cleaned) - 1)
            if section != "package" and section != "dependencies" {
                return result_error("KRY5001", "unsupported manifest section")
            }
            continue
        }
        if section != "package" and section != "dependencies" {
            return result_error("KRY5001", "manifest assignment is outside a supported section")
        }
        let assignment: Tuple = parse_assignment(cleaned)
        if assignment[0] == "error" {
            return result_error("KRY5001", assignment[1])
        }
        let key: String = assignment[1]
        let value: String = assignment[2]
        if section == "package" {
            if key == "name" {
                if has_name { return result_error("KRY5001", "duplicate manifest key name") }
                package_name = value
                has_name = true
            } else if key == "version" {
                if has_version { return result_error("KRY5001", "duplicate manifest key version") }
                package_version = value
                has_version = true
            } else if key == "edition" {
                if has_edition { return result_error("KRY5001", "duplicate manifest key edition") }
                package_edition = value
                has_edition = true
            } else {
                return result_error("KRY5001", "[package] contains an unsupported key")
            }
        } else {
            if !identifier(key) {
                return result_error("KRY5002", "invalid dependency declaration")
            }
            let requirement_code: String = requirement_error(value)
            if requirement_code != "" {
                return result_error(requirement_code, "invalid version requirement")
            }
            let mut index: Int = 0
            while index < len(dependencies) {
                let existing: Dependency = dependencies[index]
                if existing.name == key {
                    return result_error("KRY5001", "duplicate dependency declaration")
                }
                index = index + 1
            }
            let dependency: Dependency = Dependency { name: key, requirement: value }
            dependencies = array_push(dependencies, dependency)
        }
    }
    if !has_name or !has_version or !has_edition {
        return result_error("KRY5001", "[package] must contain exactly name, version, and edition")
    }
    if !identifier(package_name) or package_name == "." or package_name == ".." {
        return result_error("KRY5002", "invalid package name")
    }
    if !full_version(package_version) {
        return result_error("KRY5003", "invalid semantic version")
    }
    if !digits(package_edition) {
        return result_error("KRY5002", "invalid edition")
    }
    return ManifestResult.Ok(Manifest {
        name: package_name,
        version: package_version,
        edition: package_edition,
        dependencies: dependencies,
    })
}

struct LockEntry {
    name: String
    version: String
    checksum: String
    source: String
    dependencies: Array
}

struct Lockfile {
    entries: Array
}

enum LockfileResult {
    Ok(String)
    Error(String)
}

fn json_string(value: String) -> String {
    return "\"" + value + "\""
}

fn join_strings(values: Array, start: Int, end: Int, separator: String) -> String {
    if start >= end {
        return ""
    }
    if end - start == 1 {
        return values[start]
    }
    let middle: Int = int(start + (end - start) / 2)
    let left: String = join_strings(values, start, middle, separator)
    let right: String = join_strings(values, middle, end, separator)
    return left + separator + right
}

fn dependencies_json(dependencies: Array) -> String {
    let mut values: Array = []
    let mut index: Int = 0
    while index < len(dependencies) {
        values = array_push(values, json_string(dependencies[index]))
        index = index + 1
    }
    if len(values) == 0 {
        return "[]"
    }
    return "[\n        " + join_strings(values, 0, len(values), ",\n        ") + "\n      ]"
}

fn hex_digit(value: String) -> Bool {
    return (value >= "0" and value <= "9") or (value >= "a" and value <= "f") or (value >= "A" and value <= "F")
}

fn checksum(value: String) -> Bool {
    if len(value) != 64 {
        return false
    }
    let mut index: Int = 0
    while index < len(value) {
        if !hex_digit(value[index]) {
            return false
        }
        index = index + 1
    }
    return true
}

fn lock_entry_ordered(entry: LockEntry, previous: String) -> Bool {
    if !identifier(entry.name) or !full_version(entry.version) or !checksum(entry.checksum) or (entry.source != "path" and entry.source != "registry") {
        return false
    }
    if previous != "" and entry.name <= previous {
        return false
    }
    let mut index: Int = 0
    let mut last: String = ""
    while index < len(entry.dependencies) {
        let dependency: String = entry.dependencies[index]
        if !identifier(dependency) or (last != "" and dependency <= last) {
            return false
        }
        last = dependency
        index = index + 1
    }
    return true
}

fn lock_entry_json(entry: LockEntry) -> String {
    return "    {\n      \"checksum\": " + json_string(entry.checksum) + ",\n      \"dependencies\": " + dependencies_json(entry.dependencies) + ",\n      \"name\": " + json_string(entry.name) + ",\n      \"source\": " + json_string(entry.source) + ",\n      \"version\": " + json_string(entry.version) + "\n    }"
}

pub fn lock_entry(name: String, version: String, checksum: String, source: String, dependencies: Array) -> LockEntry {
    return LockEntry {
        name: name,
        version: version,
        checksum: checksum,
        source: source,
        dependencies: dependencies,
    }
}

pub fn lockfile(entries: Array) -> Lockfile {
    return Lockfile { entries: entries }
}

pub fn lockfile_json(value: Lockfile) -> LockfileResult {
    let mut encoded: Array = []
    let mut index: Int = 0
    let mut previous: String = ""
    while index < len(value.entries) {
        let entry: LockEntry = value.entries[index]
        if !lock_entry_ordered(entry, previous) {
            return LockfileResult.Error("KRY5009 invalid lockfile entry order or metadata")
        }
        encoded = array_push(encoded, lock_entry_json(entry))
        previous = entry.name
        index = index + 1
    }
    let package_json: String = join_strings(encoded, 0, len(encoded), ",\n")
    return LockfileResult.Ok("{\n  \"format\": \"kryndel-lock\",\n  \"packages\": [\n" + package_json + "\n  ],\n  \"version\": 1\n}\n")
}

pub fn read(path: String) -> ManifestResult {
    return parse(fs.read_text(path))
}
