// Controlled filesystem operations rooted by the embedding runtime.
// Paths are relative POSIX paths; metadata is a nominal FileMetadata value.

pub fn read_bytes(path: String) -> Bytes {
    return fs.read_bytes(path)
}

pub fn read_text(path: String) -> String {
    return fs.read_text(path)
}

pub fn write_bytes(path: String, value: Bytes) -> Void {
    return fs.write_bytes(path, value)
}

pub fn list_dir(path: String) -> Array {
    return fs.list_dir(path)
}

pub fn stat(path: String) -> FileMetadata {
    return fs.stat(path)
}
