// Source-level lexer seam for the current language subset.
// Tokens use normalized text; the Python lexer remains the typed-value oracle.

struct Span {
    start: Int
    end: Int
    line: Int
    column: Int
}

struct Token {
    kind: String
    text: String
    span: Span
}

struct Diagnostic {
    severity: String
    code: String
    message: String
    span: Span
    notes: Array
    help: String
}

struct Scan {
    kind: String
    text: String
    start: Int
    end: Int
    line: Int
    column: Int
    next: Int
    next_line: Int
    next_column: Int
    error_code: String
    error_message: String
}

struct LexerResult {
    tokens: Array
    diagnostics: Array
}

fn span(start: Int, end: Int, line: Int, column: Int) -> Span {
    return Span { start: start, end: end, line: line, column: column }
}

fn token(kind: String, text: String, location: Span) -> Token {
    return Token { kind: kind, text: text, span: location }
}

fn diagnostic(code: String, message: String, location: Span) -> Diagnostic {
    return Diagnostic {
        severity: "error",
        code: code,
        message: message,
        span: location,
        notes: [],
        help: "",
    }
}

fn classify_identifier(value: String) -> String {
    if value == "let" { return "LET" }
    if value == "mut" { return "MUT" }
    if value == "fn" { return "FN" }
    if value == "if" { return "IF" }
    if value == "else" { return "ELSE" }
    if value == "while" { return "WHILE" }
    if value == "return" { return "RETURN" }
    if value == "true" { return "TRUE" }
    if value == "false" { return "FALSE" }
    if value == "nil" { return "NIL" }
    if value == "and" { return "AND" }
    if value == "or" { return "OR" }
    if value == "not" { return "NOT" }
    if value == "break" { return "BREAK" }
    if value == "continue" { return "CONTINUE" }
    if value == "struct" { return "STRUCT" }
    if value == "enum" { return "ENUM" }
    if value == "match" { return "MATCH" }
    if value == "import" { return "IMPORT" }
    if value == "pub" { return "PUB" }
    return "IDENT"
}

fn is_letter(value: String) -> Bool {
    return (value >= "A" and value <= "Z") or (value >= "a" and value <= "z") or value == "_"
}

fn is_digit(value: String) -> Bool {
    return value >= "0" and value <= "9"
}

fn char_at(text: String, index: Int) -> String {
    if index < 0 or index >= len(text) {
        return ""
    }
    return text[index]
}

fn finish_chunks(chunks: Array, start: Int, end: Int) -> String {
    if start >= end { return "" }
    if end - start == 1 { return chunks[start] }
    let middle: Int = int(start + (end - start) / 2)
    return finish_chunks(chunks, start, middle) + finish_chunks(chunks, middle, end)
}

fn scan_identifier(text: String, start: Int, line: Int, column: Int) -> Scan {
    let mut index: Int = start
    while index < len(text) and (is_letter(char_at(text, index)) or is_digit(char_at(text, index))) {
        index = index + 1
    }
    let mut value: String = ""
    let mut cursor: Int = start
    while cursor < index {
        value = value + text[cursor]
        cursor = cursor + 1
    }
    return Scan {
        kind: classify_identifier(value),
        text: value,
        start: start,
        end: index,
        line: line,
        column: column,
        next: index,
        next_line: line,
        next_column: column + index - start,
        error_code: "",
        error_message: "",
    }
}

fn scan_number(text: String, start: Int, line: Int, column: Int) -> Scan {
    let mut index: Int = start
    while index < len(text) and is_digit(char_at(text, index)) {
        index = index + 1
    }
    let mut kind: String = "INT"
    if char_at(text, index) == "." and is_digit(char_at(text, index + 1)) {
        kind = "FLOAT"
        index = index + 1
        while index < len(text) and is_digit(char_at(text, index)) {
            index = index + 1
        }
    }
    let mut value: String = ""
    let mut cursor: Int = start
    while cursor < index {
        value = value + text[cursor]
        cursor = cursor + 1
    }
    return Scan {
        kind: kind,
        text: value,
        start: start,
        end: index,
        line: line,
        column: column,
        next: index,
        next_line: line,
        next_column: column + index - start,
        error_code: "",
        error_message: "",
    }
}

fn escaped(value: String) -> String {
    if value == "n" { return "\n" }
    if value == "r" { return "\r" }
    if value == "t" { return "\t" }
    if value == "\"" { return "\"" }
    if value == "\\" { return "\\" }
    if value == "0" { return "\0" }
    return ""
}

fn scan_string(text: String, start: Int, line: Int, column: Int) -> Scan {
    let mut index: Int = start + 1
    let mut value_parts: Array = []
    let mut error_code: String = ""
    let mut error_message: String = ""
    while index < len(text) and text[index] != "\"" {
        let character: String = text[index]
        if character == "\n" {
            return Scan {
                kind: "",
                text: "",
                start: start,
                end: index + 1,
                line: line,
                column: column,
                next: index + 1,
                next_line: line + 1,
                next_column: 1,
                error_code: "KRY1004",
                error_message: "newline in string literal",
            }
        }
        if character == "\\" {
            if index + 1 >= len(text) {
                return Scan {
                    kind: "",
                    text: "",
                    start: start,
                    end: index + 1,
                    line: line,
                    column: column,
                    next: index + 1,
                    next_line: line,
                    next_column: column + index + 1 - start,
                    error_code: "KRY1006",
                    error_message: "unterminated string literal",
                }
            }
            let escaped_value: String = escaped(text[index + 1])
            if escaped_value == "" {
                if error_code == "" {
                    error_code = "KRY1005"
                    error_message = "unknown escape sequence"
                }
                value_parts = array_push(value_parts, text[index + 1])
            } else {
                value_parts = array_push(value_parts, escaped_value)
            }
            index = index + 2
        } else {
            value_parts = array_push(value_parts, character)
            index = index + 1
        }
    }
    if index >= len(text) {
        return Scan {
            kind: "",
            text: "",
            start: start,
            end: index,
            line: line,
            column: column,
            next: index,
            next_line: line,
            next_column: column + index - start,
            error_code: "KRY1006",
            error_message: "unterminated string literal",
        }
    }
    return Scan {
        kind: "STRING",
        text: finish_chunks(value_parts, 0, len(value_parts)),
        start: start,
        end: index + 1,
        line: line,
        column: column,
        next: index + 1,
        next_line: line,
        next_column: column + index + 1 - start,
        error_code: error_code,
        error_message: error_message,
    }
}

fn one_kind(value: String) -> String {
    if value == "(" { return "LPAREN" }
    if value == ")" { return "RPAREN" }
    if value == "{" { return "LBRACE" }
    if value == "}" { return "RBRACE" }
    if value == "[" { return "LBRACKET" }
    if value == "]" { return "RBRACKET" }
    if value == "," { return "COMMA" }
    if value == ":" { return "COLON" }
    if value == ";" { return "SEMICOLON" }
    if value == "." { return "DOT" }
    if value == "+" { return "PLUS" }
    if value == "-" { return "MINUS" }
    if value == "*" { return "STAR" }
    if value == "/" { return "SLASH" }
    if value == "%" { return "PERCENT" }
    if value == "=" { return "EQUAL" }
    if value == "<" { return "LT" }
    if value == ">" { return "GT" }
    if value == "!" { return "BANG" }
    if value == "@" { return "AT" }
    return ""
}

fn two_kind(value: String) -> String {
    if value == "->" { return "ARROW" }
    if value == "==" { return "EQEQ" }
    if value == "!=" { return "NEQ" }
    if value == "<=" { return "LTE" }
    if value == ">=" { return "GTE" }
    if value == "&&" { return "ANDAND" }
    if value == "||" { return "OROR" }
    if value == "=>" { return "FATARROW" }
    return ""
}

pub fn lex(text: String) -> LexerResult {
    let mut tokens: Array = []
    let mut diagnostics: Array = []
    let mut index: Int = 0
    let mut line: Int = 1
    let mut column: Int = 1
    while index < len(text) {
        let character: String = text[index]
        if character == " " or character == "\t" or character == "\r" {
            index = index + 1
            column = column + 1
            continue
        }
        if character == "\n" {
            index = index + 1
            line = line + 1
            column = 1
            continue
        }
        if character == "/" and index + 1 < len(text) and text[index + 1] == "/" {
            index = index + 2
            column = column + 2
            while index < len(text) and text[index] != "\n" {
                index = index + 1
                column = column + 1
            }
            continue
        }
        if character == "/" and index + 1 < len(text) and text[index + 1] == "*" {
            let comment_start: Int = index
            let comment_line: Int = line
            let comment_column: Int = column
            let mut depth: Int = 1
            index = index + 2
            column = column + 2
            while index < len(text) and depth > 0 {
                if index + 1 < len(text) and text[index] == "/" and text[index + 1] == "*" {
                    depth = depth + 1
                    index = index + 2
                    column = column + 2
                } else if index + 1 < len(text) and text[index] == "*" and text[index + 1] == "/" {
                    depth = depth - 1
                    index = index + 2
                    column = column + 2
                } else if text[index] == "\n" {
                    index = index + 1
                    line = line + 1
                    column = 1
                } else {
                    index = index + 1
                    column = column + 1
                }
            }
            if depth > 0 {
                diagnostics = array_push(diagnostics, diagnostic("KRY1002", "unterminated block comment", span(comment_start, index, comment_line, comment_column)))
            }
            continue
        }
        if is_letter(character) {
            let scanned: Scan = scan_identifier(text, index, line, column)
            tokens = array_push(tokens, token(scanned.kind, scanned.text, span(scanned.start, scanned.end, scanned.line, scanned.column)))
            index = scanned.next
            column = scanned.next_column
            continue
        }
        if is_digit(character) {
            let scanned: Scan = scan_number(text, index, line, column)
            tokens = array_push(tokens, token(scanned.kind, scanned.text, span(scanned.start, scanned.end, scanned.line, scanned.column)))
            index = scanned.next
            column = scanned.next_column
            continue
        }
        if character == "\"" {
            let scanned: Scan = scan_string(text, index, line, column)
            if scanned.error_code != "" {
                diagnostics = array_push(diagnostics, diagnostic(scanned.error_code, scanned.error_message, span(scanned.start, scanned.end, scanned.line, scanned.column)))
            }
            if scanned.kind != "" {
                tokens = array_push(tokens, token(scanned.kind, scanned.text, span(scanned.start, scanned.end, scanned.line, scanned.column)))
            }
            index = scanned.next
            line = scanned.next_line
            column = scanned.next_column
            continue
        }
        let pair: String = character + char_at(text, index + 1)
        let pair_kind: String = two_kind(pair)
        if pair_kind != "" {
            tokens = array_push(tokens, token(pair_kind, pair, span(index, index + 2, line, column)))
            index = index + 2
            column = column + 2
            continue
        }
        let single_kind: String = one_kind(character)
        if single_kind != "" {
            tokens = array_push(tokens, token(single_kind, character, span(index, index + 1, line, column)))
            index = index + 1
            column = column + 1
            continue
        }
        diagnostics = array_push(diagnostics, diagnostic("KRY1001", "unexpected character", span(index, index + 1, line, column)))
        index = index + 1
        column = column + 1
    }
    tokens = array_push(tokens, token("EOF", "", span(len(text), len(text) + 1, line, column)))
    return LexerResult { tokens: tokens, diagnostics: diagnostics }
}

pub fn read(path: String) -> LexerResult {
    return lex(fs.read_text(path))
}
