// Core Result contract for the non-generic 0.1 bootstrap.
// Ok carries an Int and Error carries a diagnostic String.
pub enum Result { Ok(Int) Error(String) }

// Safe constructors keep Result creation in Kryndel source.
pub fn ok(value: Int) -> Result {
    return Result.Ok(value)
}

pub fn error(message: String) -> Result {
    return Result.Error(message)
}

pub fn is_ok(value: Result) -> Bool {
    let mut result: Bool = false
    match value {
        Result.Ok(_) => result = true
        Result.Error(_) => result = false
    }
    return result
}

pub fn is_error(value: Result) -> Bool {
    let mut result: Bool = false
    match value {
        Result.Ok(_) => result = false
        Result.Error(_) => result = true
    }
    return result
}

// unwrap_or is deliberately total: failed results return the caller's fallback.
pub fn unwrap_or(value: Result, fallback: Int) -> Int {
    let mut result: Int = fallback
    match value {
        Result.Ok(number) => result = number
        Result.Error(_) => result = fallback
    }
    return result
}

pub fn get_or(value: Result, fallback: Int) -> Int {
    return unwrap_or(value, fallback)
}
