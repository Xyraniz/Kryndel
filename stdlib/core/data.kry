// Deterministic data-core contracts for the future native toolchain.
// These declarations execute through the bootstrap today; they do not claim
// that the compiler or runtime is independent of Python.

struct StringSlice {
    value: String
    start: Int
    end: Int
}

struct BytesSlice {
    value: Bytes
    start: Int
    end: Int
}

struct StringBuilder {
    chunks: Array
}

struct SpanRecord {
    start: Int
    end: Int
    line: Int
    column: Int
}

struct TokenRecord {
    kind: String
    text: String
    span: SpanRecord
}

struct AstRecord {
    kind: String
    text: String
    span: SpanRecord
    children: Array
}

struct DiagnosticRecord {
    severity: String
    code: String
    message: String
    span: SpanRecord
    notes: Array
    help: String
}

enum StringSliceResult {
    Ok(StringSlice)
    Error(String)
}

enum BytesSliceResult {
    Ok(BytesSlice)
    Error(String)
}

enum StringReadResult {
    Ok(String)
    Error(String)
}

enum BytesReadResult {
    Ok(Int)
    Error(String)
}

fn valid_bounds(start: Int, end: Int, length: Int) -> Bool {
    return start >= 0 and end >= start and end <= length
}

pub fn string_slice(value: String, start: Int, end: Int) -> StringSliceResult {
    if !valid_bounds(start, end, len(value)) {
        return StringSliceResult.Error("KRY6202 invalid StringSlice bounds")
    }
    return StringSliceResult.Ok(StringSlice { value: value, start: start, end: end })
}

pub fn string_slice_length(value: StringSlice) -> Int {
    return value.end - value.start
}

pub fn string_slice_get(value: StringSlice, index: Int) -> StringReadResult {
    if index < 0 or index >= string_slice_length(value) {
        return StringReadResult.Error("KRY6104 StringSlice index out of bounds")
    }
    return StringReadResult.Ok(value.value[value.start + index])
}

pub fn bytes_slice(value: Bytes, start: Int, end: Int) -> BytesSliceResult {
    if !valid_bounds(start, end, len(value)) {
        return BytesSliceResult.Error("KRY6202 invalid BytesSlice bounds")
    }
    return BytesSliceResult.Ok(BytesSlice { value: value, start: start, end: end })
}

pub fn bytes_slice_length(value: BytesSlice) -> Int {
    return value.end - value.start
}

pub fn bytes_slice_get(value: BytesSlice, index: Int) -> BytesReadResult {
    if index < 0 or index >= bytes_slice_length(value) {
        return BytesReadResult.Error("KRY6104 BytesSlice index out of bounds")
    }
    return BytesReadResult.Ok(value.value[value.start + index])
}

pub fn string_slice_to_string(value: StringSlice) -> String {
    let mut builder: StringBuilder = string_builder_new()
    let mut index: Int = 0
    while index < string_slice_length(value) {
        builder = string_builder_append(builder, value.value[value.start + index])
        index = index + 1
    }
    return string_builder_finish(builder)
}

pub fn bytes_slice_to_bytes(value: BytesSlice) -> Bytes {
    let mut items: Array = []
    let mut index: Int = 0
    while index < bytes_slice_length(value) {
        items = array_push(items, value.value[value.start + index])
        index = index + 1
    }
    return bytes(items)
}

pub fn string_builder_new() -> StringBuilder {
    return StringBuilder { chunks: [] }
}

pub fn string_builder_append(builder: StringBuilder, value: String) -> StringBuilder {
    return StringBuilder { chunks: array_push(builder.chunks, value) }
}

fn finish_chunks(chunks: Array, start: Int, end: Int) -> String {
    if start >= end {
        return ""
    }
    if end - start == 1 {
        return chunks[start]
    }
    let middle: Int = int(start + (end - start) / 2)
    return finish_chunks(chunks, start, middle) + finish_chunks(chunks, middle, end)
}

pub fn string_builder_finish(builder: StringBuilder) -> String {
    return finish_chunks(builder.chunks, 0, len(builder.chunks))
}

pub fn span(start: Int, end: Int, line: Int, column: Int) -> SpanRecord {
    return SpanRecord { start: start, end: end, line: line, column: column }
}

pub fn token(kind: String, text: String, location: SpanRecord) -> TokenRecord {
    return TokenRecord { kind: kind, text: text, span: location }
}

pub fn ast(kind: String, text: String, location: SpanRecord, children: Array) -> AstRecord {
    return AstRecord { kind: kind, text: text, span: location, children: children }
}

pub fn diagnostic(severity: String, code: String, message: String, location: SpanRecord, notes: Array, help: String) -> DiagnosticRecord {
    return DiagnosticRecord {
        severity: severity,
        code: code,
        message: message,
        span: location,
        notes: notes,
        help: help,
    }
}
