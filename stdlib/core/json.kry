// Source-level JSON parser for the normalized KEXE payload subset.
// It returns nominal values and does not decode host mappings or modules yet.
// The Python JSON parser remains the production oracle.

struct JsonMember {
    key: String
    value: JsonValue
}

enum JsonValue {
    Null
    Bool(Bool)
    Int(Int)
    Float(Float)
    String(String)
    Array(Array)
    Object(Array)
}

struct ParseState {
    value: JsonValue
    next: Int
    error: String
}

struct StringState {
    value: String
    next: Int
    error: String
}

enum JsonResult {
    Ok(JsonValue)
    Error(String)
}

fn empty_value() -> JsonValue {
    return JsonValue.Null
}

fn parse_error(message: String) -> ParseState {
    return ParseState { value: empty_value(), next: 0, error: "KRY6304 " + message }
}

fn json_error(message: String) -> JsonResult {
    return JsonResult.Error("KRY6304 " + message)
}

fn is_space(character: String) -> Bool {
    return character == " " or character == "\n" or character == "\r" or character == "\t"
}

fn skip_space(text: String, start: Int) -> Int {
    let mut index: Int = start
    while index < len(text) and is_space(text[index]) {
        index = index + 1
    }
    return index
}

fn is_digit(character: String) -> Bool {
    return character == "0" or character == "1" or character == "2" or character == "3" or character == "4" or character == "5" or character == "6" or character == "7" or character == "8" or character == "9"
}

fn is_number_character(character: String) -> Bool {
    return is_digit(character) or character == "-" or character == "+" or character == "." or character == "e" or character == "E"
}

fn starts_with(text: String, start: Int, expected: String) -> Bool {
    if start < 0 or start + len(expected) > len(text) { return false }
    let mut index: Int = 0
    while index < len(expected) {
        if text[start + index] != expected[index] { return false }
        index = index + 1
    }
    return true
}

fn string_error(message: String, index: Int) -> StringState {
    return StringState { value: "", next: index, error: "KRY6304 " + message }
}

fn parse_string(text: String, start: Int) -> StringState {
    if start >= len(text) or text[start] != "\"" { return string_error("JSON string must start with quote", start) }
    let mut index: Int = start + 1
    let mut result: String = ""
    while index < len(text) {
        let character: String = text[index]
        if character == "\"" {
            return StringState { value: result, next: index + 1, error: "" }
        }
        if character == "\\" {
            index = index + 1
            if index >= len(text) { return string_error("unterminated JSON escape", index) }
            let escaped: String = text[index]
            if escaped == "\"" { result = result + "\"" }
            else if escaped == "\\" { result = result + "\\" }
            else if escaped == "/" { result = result + "/" }
            else if escaped == "b" { result = result + bytes_to_string(bytes([8])) }
            else if escaped == "f" { result = result + bytes_to_string(bytes([12])) }
            else if escaped == "n" { result = result + "\n" }
            else if escaped == "r" { result = result + "\r" }
            else if escaped == "t" { result = result + "\t" }
            else if escaped == "u" { return string_error("unicode JSON escapes are outside source subset", index) }
            else { return string_error("invalid JSON escape", index) }
        } else {
            result = result + character
        }
        index = index + 1
    }
    return string_error("unterminated JSON string", index)
}

fn valid_number(raw: String) -> Bool {
    let mut index: Int = 0
    if len(raw) == 0 { return false }
    if raw[index] == "-" {
        index = index + 1
        if index >= len(raw) { return false }
    }
    if raw[index] == "0" {
        index = index + 1
        if index < len(raw) and is_digit(raw[index]) { return false }
    } else {
        if !is_digit(raw[index]) { return false }
        while index < len(raw) and is_digit(raw[index]) { index = index + 1 }
    }
    if index < len(raw) and raw[index] == "." {
        index = index + 1
        let decimal_start: Int = index
        while index < len(raw) and is_digit(raw[index]) { index = index + 1 }
        if decimal_start == index { return false }
    }
    if index < len(raw) and (raw[index] == "e" or raw[index] == "E") {
        index = index + 1
        if index < len(raw) and (raw[index] == "+" or raw[index] == "-") { index = index + 1 }
        let exponent_start: Int = index
        while index < len(raw) and is_digit(raw[index]) { index = index + 1 }
        if exponent_start == index { return false }
    }
    return index == len(raw)
}

fn parse_number(text: String, start: Int) -> ParseState {
    let mut index: Int = start
    while index < len(text) and is_number_character(text[index]) {
        index = index + 1
    }
    if index == start { return parse_error("JSON number is empty") }
    let raw: String = text_slice(text, start, index)
    if !valid_number(raw) { return parse_error("invalid JSON number") }
    let mut decimal: Bool = false
    let mut cursor: Int = 0
    while cursor < len(raw) {
        if raw[cursor] == "." or raw[cursor] == "e" or raw[cursor] == "E" { decimal = true }
        cursor = cursor + 1
    }
    if decimal {
        return ParseState { value: JsonValue.Float(float(raw)), next: index, error: "" }
    }
    return ParseState { value: JsonValue.Int(int(raw)), next: index, error: "" }
}

fn text_slice(text: String, start: Int, end: Int) -> String {
    let mut result: String = ""
    let mut index: Int = start
    while index < end {
        result = result + text[index]
        index = index + 1
    }
    return result
}

fn parse_array(text: String, start: Int) -> ParseState {
    let mut index: Int = skip_space(text, start + 1)
    let mut values: Array = []
    if index < len(text) and text[index] == "]" {
        return ParseState { value: JsonValue.Array(values), next: index + 1, error: "" }
    }
    while index < len(text) {
        let parsed: ParseState = parse_value(text, index)
        if parsed.error != "" { return parsed }
        values = array_push(values, parsed.value)
        index = skip_space(text, parsed.next)
        if index < len(text) and text[index] == "]" {
            return ParseState { value: JsonValue.Array(values), next: index + 1, error: "" }
        }
        if index >= len(text) or text[index] != "," { return parse_error("expected comma or closing array bracket") }
        index = skip_space(text, index + 1)
    }
    return parse_error("unterminated JSON array")
}

fn parse_object(text: String, start: Int) -> ParseState {
    let mut index: Int = skip_space(text, start + 1)
    let mut members: Array = []
    if index < len(text) and text[index] == "}" {
        return ParseState { value: JsonValue.Object(members), next: index + 1, error: "" }
    }
    while index < len(text) {
        let key: StringState = parse_string(text, index)
        if key.error != "" { return parse_error(key.error) }
        index = skip_space(text, key.next)
        if index >= len(text) or text[index] != ":" { return parse_error("expected colon after JSON object key") }
        index = skip_space(text, index + 1)
        let parsed: ParseState = parse_value(text, index)
        if parsed.error != "" { return parsed }
        members = array_push(members, JsonMember { key: key.value, value: parsed.value })
        index = skip_space(text, parsed.next)
        if index < len(text) and text[index] == "}" {
            return ParseState { value: JsonValue.Object(members), next: index + 1, error: "" }
        }
        if index >= len(text) or text[index] != "," { return parse_error("expected comma or closing object brace") }
        index = skip_space(text, index + 1)
    }
    return parse_error("unterminated JSON object")
}

fn parse_value(text: String, start: Int) -> ParseState {
    let index: Int = skip_space(text, start)
    if index >= len(text) { return parse_error("JSON value is missing") }
    let character: String = text[index]
    if character == "n" and starts_with(text, index, "null") {
        return ParseState { value: JsonValue.Null, next: index + 4, error: "" }
    }
    if character == "t" and starts_with(text, index, "true") {
        return ParseState { value: JsonValue.Bool(true), next: index + 4, error: "" }
    }
    if character == "f" and starts_with(text, index, "false") {
        return ParseState { value: JsonValue.Bool(false), next: index + 5, error: "" }
    }
    if character == "\"" {
        let parsed_string: StringState = parse_string(text, index)
        if parsed_string.error != "" { return parse_error(parsed_string.error) }
        return ParseState { value: JsonValue.String(parsed_string.value), next: parsed_string.next, error: "" }
    }
    if character == "[" { return parse_array(text, index) }
    if character == "{" { return parse_object(text, index) }
    if character == "-" or is_digit(character) { return parse_number(text, index) }
    return parse_error("invalid JSON value")
}

pub fn parse(text: String) -> JsonResult {
    let parsed: ParseState = parse_value(text, 0)
    if parsed.error != "" { return JsonResult.Error(parsed.error) }
    let end: Int = skip_space(text, parsed.next)
    if end != len(text) { return json_error("trailing JSON input") }
    return JsonResult.Ok(parsed.value)
}


struct BytecodeInstruction {
    op: String
    line: Int
    text: String
    text2: String
    number: Int
    names: Array
}

struct BytecodeFunction {
    name: String
    arity: Int
    parameters: Array
    constants: Array
    categories: Array
    instructions: Array
}

struct BytecodeModule {
    name: String
    entry: String
    version: Int
    functions: Array
}

enum BytecodeResult {
    Ok(BytecodeModule)
    Error(String)
}

fn schema_error(message: String) -> BytecodeResult {
    return BytecodeResult.Error("KRY6305 " + message)
}

fn object_items(value: JsonValue) -> Array {
    match value {
        JsonValue.Object(items) => return items
        _ => return []
    }
    return []
}

fn array_items(value: JsonValue) -> Array {
    match value {
        JsonValue.Array(items) => return items
        _ => return []
    }
    return []
}

fn is_null(value: JsonValue) -> Bool {
    match value {
        JsonValue.Null => return true
        _ => return false
    }
    return false
}

fn is_structured(value: JsonValue) -> Bool {
    match value {
        JsonValue.Array(_) => return true
        JsonValue.Object(_) => return true
        _ => return false
    }
    return false
}

fn object_field(value: JsonValue, key: String) -> JsonValue {
    let members: Array = object_items(value)
    let mut index: Int = 0
    while index < len(members) {
        let member: JsonMember = members[index]
        if member.key == key { return member.value }
        index = index + 1
    }
    return JsonValue.Null
}

fn string_field(value: JsonValue, key: String) -> String {
    let field: JsonValue = object_field(value, key)
    match field {
        JsonValue.String(text) => return text
        _ => return ""
    }
    return ""
}

fn int_field(value: JsonValue, key: String) -> Int {
    let field: JsonValue = object_field(value, key)
    match field {
        JsonValue.Int(number) => return number
        _ => return -1
    }
    return -1
}

fn scalar_text(value: JsonValue) -> String {
    match value {
        JsonValue.Null => return ""
        JsonValue.Bool(flag) => {
            if flag { return "true" }
            return "false"
        }
        JsonValue.Int(number) => return str(number)
        JsonValue.Float(number) => return str(number)
        JsonValue.String(text) => return text
        _ => return ""
    }
    return ""
}

fn strings_array(value: JsonValue) -> Array {
    let values: Array = array_items(value)
    let mut result: Array = []
    let mut index: Int = 0
    while index < len(values) {
        let item: JsonValue = values[index]
        match item {
            JsonValue.String(text) => result = array_push(result, text)
            _ => return []
        }
        index = index + 1
    }
    return result
}

fn is_array_value(value: JsonValue) -> Bool {
    match value {
        JsonValue.Array(_) => return true
        _ => return false
    }
    return false
}

fn string_array_is_valid(value: JsonValue) -> Bool {
    match value {
        JsonValue.Array(items) => {
            let mut index: Int = 0
            while index < len(items) {
                let item: JsonValue = items[index]
                match item {
                    JsonValue.String(text) => {
                        if text == "" { return false }
                    }
                    _ => return false
                }
                index = index + 1
            }
            return true
        }
        _ => return false
    }
    return false
}

fn unique_strings_value(values: Array) -> Bool {
    let mut index: Int = 0
    while index < len(values) {
        let value: String = values[index]
        if value == "" { return false }
        let mut other: Int = 0
        while other < index {
            if value == values[other] { return false }
            other = other + 1
        }
        index = index + 1
    }
    return true
}

fn contains_string(values: Array, expected: String) -> Bool {
    let mut index: Int = 0
    while index < len(values) {
        if values[index] == expected { return true }
        index = index + 1
    }
    return false
}

fn object_has_exact_keys(value: JsonValue, expected: Array) -> Bool {
    match value {
        JsonValue.Object(items) => {
            if len(items) != len(expected) { return false }
            let mut expected_index: Int = 0
            while expected_index < len(expected) {
                let expected_key: String = expected[expected_index]
                let mut matches: Int = 0
                let mut item_index: Int = 0
                while item_index < len(items) {
                    let member: JsonMember = items[item_index]
                    if member.key == expected_key { matches = matches + 1 }
                    item_index = item_index + 1
                }
                if matches != 1 { return false }
                expected_index = expected_index + 1
            }
            return true
        }
        _ => return false
    }
    return false
}

fn constant_category_value(value: JsonValue) -> String {
    match value {
        JsonValue.Int(_) => return "int"
        JsonValue.Float(_) => return "float"
        JsonValue.Bool(_) => return "bool"
        JsonValue.String(_) => return "string"
        _ => return ""
    }
    return ""
}

fn instruction_error(line: Int, message: String) -> BytecodeInstruction {
    return BytecodeInstruction { op: "ERROR", line: line, text: "KRY6305 " + message, text2: "", number: 0, names: [] }
}

fn decode_instruction(value: JsonValue, constants: Array) -> BytecodeInstruction {
    match value {
        JsonValue.Object(_) => { }
        _ => return instruction_error(0, "instruction must be an object")
    }
    if !object_has_exact_keys(value, ["op", "arg", "line"]) {
        return instruction_error(0, "instruction keys are not canonical")
    }
    let op: String = string_field(value, "op")
    let line: Int = int_field(value, "line")
    if op == "" or line < 0 { return instruction_error(line, "invalid instruction header") }
    let argument: JsonValue = object_field(value, "arg")
    if op == "PUSH_CONST" {
        match argument {
            JsonValue.Int(number) => {
                if number < 0 or number >= len(constants) { return instruction_error(line, "invalid PUSH_CONST index") }
                let category: String = constant_category_value(constants[number])
                if category == "" { return instruction_error(line, "PUSH_CONST requires a scalar constant") }
                return BytecodeInstruction { op: op, line: line, text: category, text2: "", number: number, names: [] }
            }
            _ => return instruction_error(line, "invalid PUSH_CONST argument")
        }
    }
    if op == "PUSH_NIL" or op == "POP" or op == "DUP" or op == "INDEX" or op == "RETURN" {
        if !is_null(argument) { return instruction_error(line, "invalid no-argument instruction") }
        return BytecodeInstruction { op: op, line: line, text: "", text2: "", number: 0, names: [] }
    }
    if op == "LOAD" or op == "STORE" or op == "STORE_RESULT" or op == "GET_FIELD" or op == "UNARY" or op == "BINARY" or op == "PUSH_CALLABLE" {
        match argument {
            JsonValue.String(text) => {
                if text == "" { return instruction_error(line, "invalid string instruction argument") }
                return BytecodeInstruction { op: op, line: line, text: text, text2: "", number: 0, names: [] }
            }
            _ => return instruction_error(line, "invalid string instruction argument")
        }
    }
    if op == "JUMP" or op == "JUMP_IF_FALSE" or op == "JUMP_IF_TRUE" {
        match argument {
            JsonValue.Int(number) => {
                if number < 0 { return instruction_error(line, "invalid jump target") }
                return BytecodeInstruction { op: op, line: line, text: "", text2: "", number: number, names: [] }
            }
            _ => return instruction_error(line, "invalid jump target")
        }
    }
    if op == "CALL" {
        match argument {
            JsonValue.Array(items) => {
                if len(items) != 2 { return instruction_error(line, "invalid CALL metadata") }
                let first_item: JsonValue = items[0]
                let second_item: JsonValue = items[1]
                match first_item {
                    JsonValue.String(name) => {
                        match second_item {
                            JsonValue.Int(arity) => {
                                if name == "" or arity < 0 { return instruction_error(line, "invalid CALL metadata") }
                                return BytecodeInstruction { op: op, line: line, text: name, text2: "", number: arity, names: [] }
                            }
                            _ => return instruction_error(line, "invalid CALL metadata")
                        }
                    }
                    _ => return instruction_error(line, "invalid CALL metadata")
                }
            }
            _ => return instruction_error(line, "invalid CALL metadata")
        }
    }
    if op == "MAKE_STRUCT" {
        if !object_has_exact_keys(argument, ["type", "fields"]) { return instruction_error(line, "invalid MAKE_STRUCT metadata") }
        let type_name: String = string_field(argument, "type")
        let fields_value: JsonValue = object_field(argument, "fields")
        if type_name == "" or !string_array_is_valid(fields_value) { return instruction_error(line, "invalid MAKE_STRUCT metadata") }
        let fields: Array = strings_array(fields_value)
        if !unique_strings_value(fields) { return instruction_error(line, "invalid MAKE_STRUCT metadata") }
        return BytecodeInstruction { op: op, line: line, text: type_name, text2: "", number: 0, names: fields }
    }
    if op == "MAKE_ENUM" {
        let has_unit_shape: Bool = object_has_exact_keys(argument, ["type", "variant"])
        let has_payload_shape: Bool = object_has_exact_keys(argument, ["type", "variant", "arity"])
        if !has_unit_shape and !has_payload_shape { return instruction_error(line, "invalid MAKE_ENUM metadata") }
        let type_name: String = string_field(argument, "type")
        let variant_name: String = string_field(argument, "variant")
        let mut arity: Int = 0
        if has_payload_shape { arity = int_field(argument, "arity") }
        if type_name == "" or variant_name == "" or arity < 0 { return instruction_error(line, "invalid MAKE_ENUM metadata") }
        return BytecodeInstruction { op: op, line: line, text: type_name, text2: variant_name, number: arity, names: [] }
    }
    if op == "MATCH_ENUM" {
        if !object_has_exact_keys(argument, ["type", "variant", "arity"]) { return instruction_error(line, "invalid MATCH_ENUM metadata") }
        let type_name: String = string_field(argument, "type")
        let variant_name: String = string_field(argument, "variant")
        let arity: Int = int_field(argument, "arity")
        if type_name == "" or variant_name == "" or arity < 0 { return instruction_error(line, "invalid MATCH_ENUM metadata") }
        return BytecodeInstruction { op: op, line: line, text: type_name, text2: variant_name, number: arity, names: [] }
    }
    if op == "BIND_ENUM" {
        if !object_has_exact_keys(argument, ["source", "bindings", "arity"]) { return instruction_error(line, "invalid BIND_ENUM metadata") }
        let source: String = string_field(argument, "source")
        let bindings_value: JsonValue = object_field(argument, "bindings")
        let arity: Int = int_field(argument, "arity")
        if source == "" or arity < 0 or !string_array_is_valid(bindings_value) { return instruction_error(line, "invalid BIND_ENUM metadata") }
        let bindings: Array = strings_array(bindings_value)
        if len(bindings) != arity or !unique_strings_value(bindings) { return instruction_error(line, "invalid BIND_ENUM metadata") }
        return BytecodeInstruction { op: op, line: line, text: source, text2: "", number: arity, names: bindings }
    }
    if op == "MAKE_ARRAY" or op == "MAKE_TUPLE" {
        match argument {
            JsonValue.Int(number) => {
                if number < 0 { return instruction_error(line, "invalid sequence arity") }
                return BytecodeInstruction { op: op, line: line, text: "", text2: "", number: number, names: [] }
            }
            _ => return instruction_error(line, "invalid sequence arity")
        }
    }
    return instruction_error(line, "unsupported source schema opcode")
}

fn function_error(message: String) -> BytecodeFunction {
    return BytecodeFunction { name: "ERROR", arity: 0, parameters: [], constants: [message], categories: [], instructions: [] }
}

fn decode_function(value: JsonValue) -> BytecodeFunction {
    if !object_has_exact_keys(value, ["name", "arity", "parameters", "constants", "instructions"]) {
        return function_error("KRY6305 function keys are not canonical")
    }
    let name: String = string_field(value, "name")
    let arity: Int = int_field(value, "arity")
    let parameters_value: JsonValue = object_field(value, "parameters")
    let constants_value: JsonValue = object_field(value, "constants")
    let instructions_value: JsonValue = object_field(value, "instructions")
    if name == "" or arity < 0 or !is_array_value(parameters_value) or !is_array_value(constants_value) or !is_array_value(instructions_value) {
        return function_error("KRY6305 malformed function metadata")
    }
    let parameters: Array = strings_array(parameters_value)
    if len(parameters) != arity or !unique_strings_value(parameters) { return function_error("KRY6305 invalid function parameters") }
    let constants_values: Array = array_items(constants_value)
    let mut constants: Array = []
    let mut categories: Array = []
    let mut constant_index: Int = 0
    while constant_index < len(constants_values) {
        let constant_value: JsonValue = constants_values[constant_index]
        let category: String = constant_category_value(constant_value)
        if category == "" { return function_error("KRY6305 unsupported constant category") }
        constants = array_push(constants, scalar_text(constant_value))
        categories = array_push(categories, category)
        constant_index = constant_index + 1
    }
    let instruction_values: Array = array_items(instructions_value)
    let mut instructions: Array = []
    let mut instruction_index: Int = 0
    while instruction_index < len(instruction_values) {
        let decoded: BytecodeInstruction = decode_instruction(instruction_values[instruction_index], constants_values)
        if decoded.op == "ERROR" { return function_error(decoded.text) }
        instructions = array_push(instructions, decoded)
        instruction_index = instruction_index + 1
    }
    return BytecodeFunction { name: name, arity: arity, parameters: parameters, constants: constants, categories: categories, instructions: instructions }
}

fn duplicate_function_keys(members: Array) -> Bool {
    let mut index: Int = 0
    while index < len(members) {
        let member: JsonMember = members[index]
        if member.key == "" { return true }
        let mut other: Int = 0
        while other < index {
            let previous: JsonMember = members[other]
            if previous.key == member.key { return true }
            other = other + 1
        }
        index = index + 1
    }
    return false
}

fn decode_functions(value: JsonValue) -> Array {
    match value {
        JsonValue.Object(members) => {
            if duplicate_function_keys(members) { return [function_error("KRY6305 duplicate function name")] }
            let mut functions: Array = []
            let mut index: Int = 0
            while index < len(members) {
                let member: JsonMember = members[index]
                let decoded: BytecodeFunction = decode_function(member.value)
                if decoded.name == "ERROR" { return [decoded] }
                if decoded.name != member.key { return [function_error("KRY6305 function key/name mismatch")] }
                functions = array_push(functions, decoded)
                index = index + 1
            }
            return functions
        }
        _ => return [function_error("KRY6305 functions must be an object")]
    }
    return [function_error("KRY6305 functions must be an object")]
}

pub fn decode_bytecode(text: String) -> BytecodeResult {
    let parsed: JsonResult = parse(text)
    match parsed {
        JsonResult.Error(message) => return BytecodeResult.Error(message)
        JsonResult.Ok(value) => {
            if !object_has_exact_keys(value, ["format", "version", "name", "entry", "functions"]) {
                return schema_error("invalid bytecode module schema")
            }
            if string_field(value, "format") != "kryndel-bytecode" { return schema_error("invalid bytecode format") }
            if int_field(value, "version") != 1 { return schema_error("unsupported bytecode version") }
            let name: String = string_field(value, "name")
            let entry: String = string_field(value, "entry")
            if name == "" or entry == "" { return schema_error("missing bytecode module identity") }
            let functions: Array = decode_functions(object_field(value, "functions"))
            if len(functions) == 1 {
                let first: BytecodeFunction = functions[0]
                if first.name == "ERROR" { return schema_error(first.constants[0]) }
            }
            if len(functions) == 0 { return schema_error("bytecode functions object is empty") }
            let mut entry_found: Bool = false
            let mut index: Int = 0
            while index < len(functions) {
                let function_value: BytecodeFunction = functions[index]
                if function_value.name == entry { entry_found = true }
                index = index + 1
            }
            if !entry_found { return schema_error("bytecode entry function is missing") }
            return BytecodeResult.Ok(BytecodeModule { name: name, entry: entry, version: 1, functions: functions })
        }
    }
    return schema_error("unreachable bytecode decoder state")
}


enum EncodeResult {
    Ok(String)
    Error(String)
}

fn encode_error(message: String) -> EncodeResult {
    return EncodeResult.Error("KRY6305 " + message)
}

fn spaces(level: Int) -> String {
    let mut result: String = ""
    let mut index: Int = 0
    while index < level * 2 {
        result = result + " "
        index = index + 1
    }
    return result
}

fn quote_json(value: String) -> String {
    let mut result: String = "\""
    let mut index: Int = 0
    while index < len(value) {
        let character: String = value[index]
        if character == "\"" { result = result + "\\\"" }
        else if character == "\\" { result = result + "\\\\" }
        else if character == "\n" { result = result + "\\n" }
        else if character == "\r" { result = result + "\\r" }
        else if character == "\t" { result = result + "\\t" }
        else { result = result + character }
        index = index + 1
    }
    return result + "\""
}

fn encode_string_array(values: Array, level: Int) -> String {
    if len(values) == 0 { return "[]" }
    let mut result: String = "[\n"
    let mut index: Int = 0
    while index < len(values) {
        let value: String = values[index]
        result = result + spaces(level + 1) + quote_json(value)
        if index + 1 < len(values) { result = result + "," }
        result = result + "\n"
        index = index + 1
    }
    return result + spaces(level) + "]"
}

fn constant_category_for(value: BytecodeFunction, index: Int) -> String {
    let mut instruction_index: Int = 0
    while instruction_index < len(value.instructions) {
        let instruction_value: BytecodeInstruction = value.instructions[instruction_index]
        if instruction_value.op == "PUSH_CONST" and instruction_value.number == index {
            return instruction_value.text
        }
        instruction_index = instruction_index + 1
    }
    return "string"
}

fn encode_constant(value: BytecodeFunction, index: Int) -> String {
    let raw: String = value.constants[index]
    let mut category: String = constant_category_for(value, index)
    if index < len(value.categories) { category = value.categories[index] }
    if category == "int" { return str(int(raw)) }
    if category == "float" { return str(float(raw)) }
    if category == "bool" {
        if raw == "true" { return "true" }
        return "false"
    }
    return quote_json(raw)
}

fn encode_constants(value: BytecodeFunction, level: Int) -> String {
    if len(value.constants) == 0 { return "[]" }
    let mut result: String = "[\n"
    let mut index: Int = 0
    while index < len(value.constants) {
        result = result + spaces(level + 1) + encode_constant(value, index)
        if index + 1 < len(value.constants) { result = result + "," }
        result = result + "\n"
        index = index + 1
    }
    return result + spaces(level) + "]"
}

fn encode_call_argument(value: BytecodeInstruction, level: Int) -> String {
    return "[\n" + spaces(level + 1) + quote_json(value.text) + ",\n" + spaces(level + 1) + str(value.number) + "\n" + spaces(level) + "]"
}

fn encode_struct_argument(value: BytecodeInstruction, level: Int) -> String {
    return "{\n" + spaces(level + 1) + "\"fields\": " + encode_string_array(value.names, level + 1) + ",\n" + spaces(level + 1) + "\"type\": " + quote_json(value.text) + "\n" + spaces(level) + "}"
}

fn encode_make_enum_argument(value: BytecodeInstruction, level: Int) -> String {
    if value.number == 0 {
        return "{\n" + spaces(level + 1) + "\"type\": " + quote_json(value.text) + ",\n" + spaces(level + 1) + "\"variant\": " + quote_json(value.text2) + "\n" + spaces(level) + "}"
    }
    return "{\n" + spaces(level + 1) + "\"arity\": " + str(value.number) + ",\n" + spaces(level + 1) + "\"type\": " + quote_json(value.text) + ",\n" + spaces(level + 1) + "\"variant\": " + quote_json(value.text2) + "\n" + spaces(level) + "}"
}

fn encode_match_argument(value: BytecodeInstruction, level: Int) -> String {
    return "{\n" + spaces(level + 1) + "\"arity\": " + str(value.number) + ",\n" + spaces(level + 1) + "\"type\": " + quote_json(value.text) + ",\n" + spaces(level + 1) + "\"variant\": " + quote_json(value.text2) + "\n" + spaces(level) + "}"
}

fn encode_bind_argument(value: BytecodeInstruction, level: Int) -> String {
    return "{\n" + spaces(level + 1) + "\"arity\": " + str(value.number) + ",\n" + spaces(level + 1) + "\"bindings\": " + encode_string_array(value.names, level + 1) + ",\n" + spaces(level + 1) + "\"source\": " + quote_json(value.text) + "\n" + spaces(level) + "}"
}

fn encode_instruction_argument(value: BytecodeInstruction, level: Int) -> String {
    if value.op == "PUSH_NIL" or value.op == "POP" or value.op == "DUP" or value.op == "INDEX" or value.op == "RETURN" { return "null" }
    if value.op == "PUSH_CONST" or value.op == "MAKE_ARRAY" or value.op == "MAKE_TUPLE" or value.op == "JUMP" or value.op == "JUMP_IF_FALSE" or value.op == "JUMP_IF_TRUE" { return str(value.number) }
    if value.op == "CALL" { return encode_call_argument(value, level) }
    if value.op == "MAKE_STRUCT" { return encode_struct_argument(value, level) }
    if value.op == "MAKE_ENUM" { return encode_make_enum_argument(value, level) }
    if value.op == "MATCH_ENUM" { return encode_match_argument(value, level) }
    if value.op == "BIND_ENUM" { return encode_bind_argument(value, level) }
    return quote_json(value.text)
}

fn encode_instruction(value: BytecodeInstruction, level: Int) -> String {
    return spaces(level) + "{\n" + spaces(level + 1) + "\"arg\": " + encode_instruction_argument(value, level + 1) + ",\n" + spaces(level + 1) + "\"line\": " + str(value.line) + ",\n" + spaces(level + 1) + "\"op\": " + quote_json(value.op) + "\n" + spaces(level) + "}"
}

fn encode_instruction_array(values: Array, level: Int) -> String {
    if len(values) == 0 { return "[]" }
    let mut result: String = "[\n"
    let mut index: Int = 0
    while index < len(values) {
        let value: BytecodeInstruction = values[index]
        result = result + encode_instruction(value, level + 1)
        if index + 1 < len(values) { result = result + "," }
        result = result + "\n"
        index = index + 1
    }
    return result + spaces(level) + "]"
}

fn encode_function(value: BytecodeFunction, level: Int) -> String {
    return spaces(level) + quote_json(value.name) + ": {\n" + spaces(level + 1) + "\"arity\": " + str(value.arity) + ",\n" + spaces(level + 1) + "\"constants\": " + encode_constants(value, level + 1) + ",\n" + spaces(level + 1) + "\"instructions\": " + encode_instruction_array(value.instructions, level + 1) + ",\n" + spaces(level + 1) + "\"name\": " + quote_json(value.name) + ",\n" + spaces(level + 1) + "\"parameters\": " + encode_string_array(value.parameters, level + 1) + "\n" + spaces(level) + "}"
}

fn encode_functions(values: Array) -> String {
    if len(values) == 0 { return "{}" }
    let mut result: String = "{\n"
    let mut index: Int = 0
    while index < len(values) {
        let value: BytecodeFunction = values[index]
        result = result + encode_function(value, 2)
        if index + 1 < len(values) { result = result + "," }
        result = result + "\n"
        index = index + 1
    }
    return result + spaces(1) + "}"
}

pub fn encode_bytecode(value: BytecodeModule) -> EncodeResult {
    if value.version != 1 or value.name == "" or value.entry == "" or len(value.functions) == 0 {
        return encode_error("invalid bytecode module for serialization")
    }
    let mut entry_found: Bool = false
    let mut index: Int = 0
    while index < len(value.functions) {
        let function_value: BytecodeFunction = value.functions[index]
        if function_value.name == value.entry { entry_found = true }
        index = index + 1
    }
    if !entry_found { return encode_error("bytecode entry function is missing") }
    let result: String = "{\n" + spaces(1) + "\"entry\": " + quote_json(value.entry) + ",\n" + spaces(1) + "\"format\": \"kryndel-bytecode\",\n" + spaces(1) + "\"functions\": " + encode_functions(value.functions) + ",\n" + spaces(1) + "\"name\": " + quote_json(value.name) + ",\n" + spaces(1) + "\"version\": 1\n}\n"
    return EncodeResult.Ok(result)
}

pub fn decode_bytecode_file(path: String) -> BytecodeResult {
    return decode_bytecode(fs.read_text(path))
}


pub fn decode_bytecode_bytes(value: Bytes) -> BytecodeResult {
    return decode_bytecode(bytes_to_string(value))
}
