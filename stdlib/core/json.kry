// Source-level JSON parser for the normalized KEXE payload subset.
// It returns nominal values and does not decode host mappings or modules yet.
// The Python JSON parser remains the production oracle.

struct JsonMember {
    key: String
    value: JsonValue
}

enum JsonValue {
    Null
    Bool(Bool)
    Int(Int)
    Float(Float)
    String(String)
    Array(Array)
    Object(Array)
}

struct ParseState {
    value: JsonValue
    next: Int
    error: String
}

struct StringState {
    value: String
    next: Int
    error: String
}

enum JsonResult {
    Ok(JsonValue)
    Error(String)
}

fn empty_value() -> JsonValue {
    return JsonValue.Null
}

fn parse_error(message: String) -> ParseState {
    return ParseState { value: empty_value(), next: 0, error: "KRY6304 " + message }
}

fn json_error(message: String) -> JsonResult {
    return JsonResult.Error("KRY6304 " + message)
}

fn is_space(character: String) -> Bool {
    return character == " " or character == "\n" or character == "\r" or character == "\t"
}

fn skip_space(text: String, start: Int) -> Int {
    let mut index: Int = start
    while index < len(text) and is_space(text[index]) {
        index = index + 1
    }
    return index
}

fn is_digit(character: String) -> Bool {
    return character == "0" or character == "1" or character == "2" or character == "3" or character == "4" or character == "5" or character == "6" or character == "7" or character == "8" or character == "9"
}

fn is_number_character(character: String) -> Bool {
    return is_digit(character) or character == "-" or character == "+" or character == "." or character == "e" or character == "E"
}

fn starts_with(text: String, start: Int, expected: String) -> Bool {
    if start < 0 or start + len(expected) > len(text) { return false }
    let mut index: Int = 0
    while index < len(expected) {
        if text[start + index] != expected[index] { return false }
        index = index + 1
    }
    return true
}

fn string_error(message: String, index: Int) -> StringState {
    return StringState { value: "", next: index, error: "KRY6304 " + message }
}

fn parse_string(text: String, start: Int) -> StringState {
    if start >= len(text) or text[start] != "\"" { return string_error("JSON string must start with quote", start) }
    let mut index: Int = start + 1
    let mut result: String = ""
    while index < len(text) {
        let character: String = text[index]
        if character == "\"" {
            return StringState { value: result, next: index + 1, error: "" }
        }
        if character == "\\" {
            index = index + 1
            if index >= len(text) { return string_error("unterminated JSON escape", index) }
            let escaped: String = text[index]
            if escaped == "\"" { result = result + "\"" }
            else if escaped == "\\" { result = result + "\\" }
            else if escaped == "/" { result = result + "/" }
            else if escaped == "b" { result = result + bytes_to_string(bytes([8])) }
            else if escaped == "f" { result = result + bytes_to_string(bytes([12])) }
            else if escaped == "n" { result = result + "\n" }
            else if escaped == "r" { result = result + "\r" }
            else if escaped == "t" { result = result + "\t" }
            else if escaped == "u" { return string_error("unicode JSON escapes are outside source subset", index) }
            else { return string_error("invalid JSON escape", index) }
        } else {
            result = result + character
        }
        index = index + 1
    }
    return string_error("unterminated JSON string", index)
}

fn valid_number(raw: String) -> Bool {
    let mut index: Int = 0
    if len(raw) == 0 { return false }
    if raw[index] == "-" {
        index = index + 1
        if index >= len(raw) { return false }
    }
    if raw[index] == "0" {
        index = index + 1
        if index < len(raw) and is_digit(raw[index]) { return false }
    } else {
        if !is_digit(raw[index]) { return false }
        while index < len(raw) and is_digit(raw[index]) { index = index + 1 }
    }
    if index < len(raw) and raw[index] == "." {
        index = index + 1
        let decimal_start: Int = index
        while index < len(raw) and is_digit(raw[index]) { index = index + 1 }
        if decimal_start == index { return false }
    }
    if index < len(raw) and (raw[index] == "e" or raw[index] == "E") {
        index = index + 1
        if index < len(raw) and (raw[index] == "+" or raw[index] == "-") { index = index + 1 }
        let exponent_start: Int = index
        while index < len(raw) and is_digit(raw[index]) { index = index + 1 }
        if exponent_start == index { return false }
    }
    return index == len(raw)
}

fn parse_number(text: String, start: Int) -> ParseState {
    let mut index: Int = start
    while index < len(text) and is_number_character(text[index]) {
        index = index + 1
    }
    if index == start { return parse_error("JSON number is empty") }
    let raw: String = text_slice(text, start, index)
    if !valid_number(raw) { return parse_error("invalid JSON number") }
    let mut decimal: Bool = false
    let mut cursor: Int = 0
    while cursor < len(raw) {
        if raw[cursor] == "." or raw[cursor] == "e" or raw[cursor] == "E" { decimal = true }
        cursor = cursor + 1
    }
    if decimal {
        return ParseState { value: JsonValue.Float(float(raw)), next: index, error: "" }
    }
    return ParseState { value: JsonValue.Int(int(raw)), next: index, error: "" }
}

fn text_slice(text: String, start: Int, end: Int) -> String {
    let mut result: String = ""
    let mut index: Int = start
    while index < end {
        result = result + text[index]
        index = index + 1
    }
    return result
}

fn parse_array(text: String, start: Int) -> ParseState {
    let mut index: Int = skip_space(text, start + 1)
    let mut values: Array = []
    if index < len(text) and text[index] == "]" {
        return ParseState { value: JsonValue.Array(values), next: index + 1, error: "" }
    }
    while index < len(text) {
        let parsed: ParseState = parse_value(text, index)
        if parsed.error != "" { return parsed }
        values = array_push(values, parsed.value)
        index = skip_space(text, parsed.next)
        if index < len(text) and text[index] == "]" {
            return ParseState { value: JsonValue.Array(values), next: index + 1, error: "" }
        }
        if index >= len(text) or text[index] != "," { return parse_error("expected comma or closing array bracket") }
        index = skip_space(text, index + 1)
    }
    return parse_error("unterminated JSON array")
}

fn parse_object(text: String, start: Int) -> ParseState {
    let mut index: Int = skip_space(text, start + 1)
    let mut members: Array = []
    if index < len(text) and text[index] == "}" {
        return ParseState { value: JsonValue.Object(members), next: index + 1, error: "" }
    }
    while index < len(text) {
        let key: StringState = parse_string(text, index)
        if key.error != "" { return parse_error(key.error) }
        index = skip_space(text, key.next)
        if index >= len(text) or text[index] != ":" { return parse_error("expected colon after JSON object key") }
        index = skip_space(text, index + 1)
        let parsed: ParseState = parse_value(text, index)
        if parsed.error != "" { return parsed }
        members = array_push(members, JsonMember { key: key.value, value: parsed.value })
        index = skip_space(text, parsed.next)
        if index < len(text) and text[index] == "}" {
            return ParseState { value: JsonValue.Object(members), next: index + 1, error: "" }
        }
        if index >= len(text) or text[index] != "," { return parse_error("expected comma or closing object brace") }
        index = skip_space(text, index + 1)
    }
    return parse_error("unterminated JSON object")
}

fn parse_value(text: String, start: Int) -> ParseState {
    let index: Int = skip_space(text, start)
    if index >= len(text) { return parse_error("JSON value is missing") }
    let character: String = text[index]
    if character == "n" and starts_with(text, index, "null") {
        return ParseState { value: JsonValue.Null, next: index + 4, error: "" }
    }
    if character == "t" and starts_with(text, index, "true") {
        return ParseState { value: JsonValue.Bool(true), next: index + 4, error: "" }
    }
    if character == "f" and starts_with(text, index, "false") {
        return ParseState { value: JsonValue.Bool(false), next: index + 5, error: "" }
    }
    if character == "\"" {
        let parsed_string: StringState = parse_string(text, index)
        if parsed_string.error != "" { return parse_error(parsed_string.error) }
        return ParseState { value: JsonValue.String(parsed_string.value), next: parsed_string.next, error: "" }
    }
    if character == "[" { return parse_array(text, index) }
    if character == "{" { return parse_object(text, index) }
    if character == "-" or is_digit(character) { return parse_number(text, index) }
    return parse_error("invalid JSON value")
}

pub fn parse(text: String) -> JsonResult {
    let parsed: ParseState = parse_value(text, 0)
    if parsed.error != "" { return JsonResult.Error(parsed.error) }
    let end: Int = skip_space(text, parsed.next)
    if end != len(text) { return json_error("trailing JSON input") }
    return JsonResult.Ok(parsed.value)
}


struct BytecodeInstruction {
    op: String
    line: Int
    text: String
    text2: String
    number: Int
    names: Array
}

struct BytecodeFunction {
    name: String
    arity: Int
    parameters: Array
    constants: Array
    instructions: Array
}

struct BytecodeModule {
    name: String
    entry: String
    version: Int
    functions: Array
}

enum BytecodeResult {
    Ok(BytecodeModule)
    Error(String)
}

fn schema_error(message: String) -> BytecodeResult {
    return BytecodeResult.Error("KRY6305 " + message)
}

fn object_items(value: JsonValue) -> Array {
    match value {
        JsonValue.Object(items) => return items
        _ => return []
    }
    return []
}

fn array_items(value: JsonValue) -> Array {
    match value {
        JsonValue.Array(items) => return items
        _ => return []
    }
    return []
}

fn is_null(value: JsonValue) -> Bool {
    match value {
        JsonValue.Null => return true
        _ => return false
    }
    return false
}

fn is_structured(value: JsonValue) -> Bool {
    match value {
        JsonValue.Array(_) => return true
        JsonValue.Object(_) => return true
        _ => return false
    }
    return false
}

fn object_field(value: JsonValue, key: String) -> JsonValue {
    let members: Array = object_items(value)
    let mut index: Int = 0
    while index < len(members) {
        let member: JsonMember = members[index]
        if member.key == key { return member.value }
        index = index + 1
    }
    return JsonValue.Null
}

fn string_field(value: JsonValue, key: String) -> String {
    let field: JsonValue = object_field(value, key)
    match field {
        JsonValue.String(text) => return text
        _ => return ""
    }
    return ""
}

fn int_field(value: JsonValue, key: String) -> Int {
    let field: JsonValue = object_field(value, key)
    match field {
        JsonValue.Int(number) => return number
        _ => return -1
    }
    return -1
}

fn scalar_text(value: JsonValue) -> String {
    match value {
        JsonValue.Null => return ""
        JsonValue.Bool(flag) => {
            if flag { return "true" }
            return "false"
        }
        JsonValue.Int(number) => return str(number)
        JsonValue.Float(number) => return str(number)
        JsonValue.String(text) => return text
        _ => return ""
    }
    return ""
}

fn strings_array(value: JsonValue) -> Array {
    let values: Array = array_items(value)
    let mut result: Array = []
    let mut index: Int = 0
    while index < len(values) {
        let item: JsonValue = values[index]
        match item {
            JsonValue.String(text) => result = array_push(result, text)
            _ => return []
        }
        index = index + 1
    }
    return result
}

fn decode_instruction(value: JsonValue) -> BytecodeInstruction {
    let op: String = string_field(value, "op")
    let line: Int = int_field(value, "line")
    let argument: JsonValue = object_field(value, "arg")
    if op == "PUSH_CONST" {
        match argument {
            JsonValue.Int(number) => return BytecodeInstruction { op: op, line: line, text: "", text2: "", number: number, names: [] }
            _ => return BytecodeInstruction { op: "ERROR", line: line, text: "KRY6305 invalid PUSH_CONST argument", text2: "", number: 0, names: [] }
        }
    }
    if op == "PUSH_NIL" or op == "POP" or op == "RETURN" {
        if !is_null(argument) { return BytecodeInstruction { op: "ERROR", line: line, text: "KRY6305 invalid no-argument instruction", text2: "", number: 0, names: [] } }
        return BytecodeInstruction { op: op, line: line, text: "", text2: "", number: 0, names: [] }
    }
    if op == "LOAD" or op == "STORE" {
        match argument {
            JsonValue.String(text) => return BytecodeInstruction { op: op, line: line, text: text, text2: "", number: 0, names: [] }
            _ => return BytecodeInstruction { op: "ERROR", line: line, text: "KRY6305 invalid name instruction", text2: "", number: 0, names: [] }
        }
    }
    if op == "JUMP" or op == "JUMP_IF_FALSE" {
        match argument {
            JsonValue.Int(number) => return BytecodeInstruction { op: op, line: line, text: "", text2: "", number: number, names: [] }
            _ => return BytecodeInstruction { op: "ERROR", line: line, text: "KRY6305 invalid jump target", text2: "", number: 0, names: [] }
        }
    }
    return BytecodeInstruction { op: "ERROR", line: line, text: "KRY6305 unsupported source schema opcode", text2: "", number: 0, names: [] }
}

fn decode_function(value: JsonValue) -> BytecodeFunction {
    let name: String = string_field(value, "name")
    let arity: Int = int_field(value, "arity")
    let parameters: Array = strings_array(object_field(value, "parameters"))
    let constants_values: Array = array_items(object_field(value, "constants"))
    let mut constants: Array = []
    let mut constant_index: Int = 0
    while constant_index < len(constants_values) {
        let constant_value: JsonValue = constants_values[constant_index]
        let text: String = scalar_text(constant_value)
        if is_structured(constant_value) {
            return BytecodeFunction { name: "ERROR", arity: 0, parameters: [], constants: ["KRY6305 unsupported structured constant"], instructions: [] }
        }
        constants = array_push(constants, text)
        constant_index = constant_index + 1
    }
    let instruction_values: Array = array_items(object_field(value, "instructions"))
    let mut instructions: Array = []
    let mut instruction_index: Int = 0
    while instruction_index < len(instruction_values) {
        let decoded: BytecodeInstruction = decode_instruction(instruction_values[instruction_index])
        if decoded.op == "ERROR" {
            return BytecodeFunction { name: "ERROR", arity: 0, parameters: [], constants: [decoded.text], instructions: [] }
        }
        instructions = array_push(instructions, decoded)
        instruction_index = instruction_index + 1
    }
    return BytecodeFunction { name: name, arity: arity, parameters: parameters, constants: constants, instructions: instructions }
}

fn decode_functions(value: JsonValue) -> Array {
    let members: Array = object_items(value)
    let mut functions: Array = []
    let mut index: Int = 0
    while index < len(members) {
        let member: JsonMember = members[index]
        let decoded: BytecodeFunction = decode_function(member.value)
        if decoded.name == "ERROR" { return [decoded] }
        functions = array_push(functions, decoded)
        index = index + 1
    }
    return functions
}

pub fn decode_bytecode(text: String) -> BytecodeResult {
    let parsed: JsonResult = parse(text)
    match parsed {
        JsonResult.Error(message) => return BytecodeResult.Error(message)
        JsonResult.Ok(value) => {
            if string_field(value, "format") != "kryndel-bytecode" { return schema_error("invalid bytecode format") }
            if int_field(value, "version") != 1 { return schema_error("unsupported bytecode version") }
            let name: String = string_field(value, "name")
            let entry: String = string_field(value, "entry")
            if name == "" or entry == "" { return schema_error("missing bytecode module identity") }
            let functions: Array = decode_functions(object_field(value, "functions"))
            if len(functions) == 1 {
                let first: BytecodeFunction = functions[0]
                if first.name == "ERROR" { return schema_error(first.constants[0]) }
            }
            if len(functions) == 0 { return schema_error("bytecode functions object is empty") }
            return BytecodeResult.Ok(BytecodeModule { name: name, entry: entry, version: 1, functions: functions })
        }
    }
    return schema_error("unreachable bytecode decoder state")
}


pub fn decode_bytecode_file(path: String) -> BytecodeResult {
    return decode_bytecode(fs.read_text(path))
}
