// Source-level runtime seam for normalized bytecode-v1 records.
// This module now covers the executable v1 subset through nominal source values,
// but it is still interpreted by the Python bootstrap and is not native yet.

struct InstructionRecord {
    op: String
    line: Int
    text: String
    text2: String
    number: Int
    names: Array
}

struct FunctionRecord {
    name: String
    arity: Int
    parameters: Array
    constants: Array
    instructions: Array
}

struct ModuleRecord {
    name: String
    entry: String
    version: Int
    functions: Array
}

struct Binding {
    name: String
    value: Value
}

struct Value {
    kind: String
    text: String
    number: Int
    values: Array
    names: Array
    float_number: Float
    bool_value: Bool
}

enum RuntimeResult {
    Ok(Value)
    Error(String)
}

fn runtime_error(message: String) -> RuntimeResult {
    return RuntimeResult.Error(message)
}

fn runtime_ok(value: Value) -> RuntimeResult {
    return RuntimeResult.Ok(value)
}

fn nil_value() -> Value {
    return Value { kind: "Nil", text: "", number: 0, values: [], names: [], float_number: 0.0, bool_value: false }
}

fn string_value(value: String) -> Value {
    return Value { kind: "String", text: value, number: 0, values: [], names: [], float_number: 0.0, bool_value: false }
}

fn int_value(value: Int) -> Value {
    return Value { kind: "Int", text: "", number: value, values: [], names: [], float_number: 0.0, bool_value: false }
}

fn float_value(value: Float) -> Value {
    return Value { kind: "Float", text: "", number: 0, values: [], names: [], float_number: value, bool_value: false }
}

fn bool_value(value: Bool) -> Value {
    return Value { kind: "Bool", text: "", number: 0, values: [], names: [], float_number: 0.0, bool_value: value }
}

fn struct_value(type_name: String, values: Array, names: Array) -> Value {
    return Value { kind: type_name, text: "", number: 0, values: values, names: names, float_number: 0.0, bool_value: false }
}

fn enum_value(type_name: String, variant_name: String, values: Array) -> Value {
    return Value { kind: type_name, text: variant_name, number: 0, values: values, names: [], float_number: 0.0, bool_value: false }
}

fn array_value(values: Array) -> Value {
    return Value { kind: "Array", text: "", number: 0, values: values, names: [], float_number: 0.0, bool_value: false }
}

fn tuple_value(values: Array) -> Value {
    return Value { kind: "Tuple", text: "", number: 0, values: values, names: [], float_number: 0.0, bool_value: false }
}

fn typed_constant(raw: String, category: String) -> Value {
    if category == "int" { return int_value(int(raw)) }
    if category == "float" { return float_value(float(raw)) }
    if category == "bool" { return bool_value(raw == "true") }
    return string_value(raw)
}

pub fn decode_constant(raw: String, category: String) -> RuntimeResult {
    if category == "nil" { return runtime_ok(nil_value()) }
    if category != "int" and category != "float" and category != "bool" and category != "string" and category != "text" {
        return runtime_error("KRY7006 unsupported constant category")
    }
    return runtime_ok(typed_constant(raw, category))
}

fn find_function(functions: Array, name: String) -> FunctionRecord {
    let mut index: Int = 0
    while index < len(functions) {
        let function_value: FunctionRecord = functions[index]
        if function_value.name == name { return function_value }
        index = index + 1
    }
    return FunctionRecord { name: "", arity: 0, parameters: [], constants: [], instructions: [] }
}

fn find_local(locals: Array, name: String) -> Value {
    let mut index: Int = len(locals) - 1
    while index >= 0 {
        let binding: Binding = locals[index]
        if binding.name == name { return binding.value }
        index = index - 1
    }
    return nil_value()
}

fn set_local(locals: Array, name: String, value: Value) -> Array {
    let mut index: Int = 0
    while index < len(locals) {
        let binding: Binding = locals[index]
        if binding.name == name {
            let mut updated: Array = []
            let mut cursor: Int = 0
            while cursor < len(locals) {
                if cursor == index {
                    updated = array_push(updated, Binding { name: name, value: value })
                } else {
                    updated = array_push(updated, locals[cursor])
                }
                cursor = cursor + 1
            }
            return updated
        }
        index = index + 1
    }
    return array_push(locals, Binding { name: name, value: value })
}

fn pop_value(stack: Array) -> Value {
    return stack[len(stack) - 1]
}

fn pop_many(stack: Array, count: Int) -> Array {
    let mut result: Array = []
    let start: Int = len(stack) - count
    let mut index: Int = start
    while index < len(stack) {
        result = array_push(result, stack[index])
        index = index + 1
    }
    return result
}

fn remove_many(stack: Array, count: Int) -> Array {
    let end: Int = len(stack) - count
    let mut result: Array = []
    let mut index: Int = 0
    while index < end {
        result = array_push(result, stack[index])
        index = index + 1
    }
    return result
}

fn take_arguments(stack: Array, count: Int) -> Array {
    if count == 0 { return [] }
    return pop_many(stack, count)
}

fn field_value(value: Value, name: String) -> RuntimeResult {
    let mut index: Int = 0
    while index < len(value.names) {
        if value.names[index] == name { return runtime_ok(value.values[index]) }
        index = index + 1
    }
    return runtime_error("KRY7004 struct field is missing")
}

fn value_equal(left: Value, right: Value) -> Bool {
    if left.kind != right.kind or left.text != right.text { return false }
    if left.kind == "Nil" { return true }
    if left.kind == "Int" { return left.number == right.number }
    if left.kind == "Float" { return left.float_number == right.float_number }
    if left.kind == "Bool" { return left.bool_value == right.bool_value }
    if left.kind == "String" { return left.text == right.text }
    if len(left.values) != len(right.values) or len(left.names) != len(right.names) { return false }
    let mut index: Int = 0
    while index < len(left.values) {
        let left_value: Value = left.values[index]
        let right_value: Value = right.values[index]
        if !value_equal(left_value, right_value) { return false }
        index = index + 1
    }
    return true
}

fn truthy(value: Value) -> Bool {
    if value.kind == "Nil" { return false }
    if value.kind == "Bool" { return value.bool_value }
    if value.kind == "Int" { return value.number != 0 }
    if value.kind == "Float" { return value.float_number != 0.0 }
    if value.kind == "String" { return len(value.text) != 0 }
    return true
}

fn stringify_value(value: Value) -> String {
    if value.kind == "Nil" { return "nil" }
    if value.kind == "Int" { return str(value.number) }
    if value.kind == "Float" { return str(value.float_number) }
    if value.kind == "Bool" {
        if value.bool_value { return "true" }
        return "false"
    }
    if value.kind == "String" { return value.text }
    if value.kind == "Array" { return "Array(" + str(len(value.values)) + ")" }
    if value.kind == "Tuple" { return "Tuple(" + str(len(value.values)) + ")" }
    if value.text != "" { return value.kind + "." + value.text }
    return value.kind
}

fn append_values(left: Array, right: Array) -> Array {
    let mut result: Array = []
    let mut index: Int = 0
    while index < len(left) {
        result = array_push(result, left[index])
        index = index + 1
    }
    index = 0
    while index < len(right) {
        result = array_push(result, right[index])
        index = index + 1
    }
    return result
}

fn binary_value(operator: String, left: Value, right: Value) -> RuntimeResult {
    if operator == "+" {
        if left.kind == "Int" and right.kind == "Int" { return runtime_ok(int_value(left.number + right.number)) }
        if left.kind == "Float" and right.kind == "Float" { return runtime_ok(float_value(left.float_number + right.float_number)) }
        if left.kind == "String" and right.kind == "String" { return runtime_ok(string_value(left.text + right.text)) }
        if left.kind == "Array" and right.kind == "Array" { return runtime_ok(array_value(append_values(left.values, right.values))) }
        if left.kind == "Tuple" and right.kind == "Tuple" { return runtime_ok(tuple_value(append_values(left.values, right.values))) }
    }
    if operator == "-" and left.kind == "Int" and right.kind == "Int" { return runtime_ok(int_value(left.number - right.number)) }
    if operator == "*" and left.kind == "Int" and right.kind == "Int" { return runtime_ok(int_value(left.number * right.number)) }
    if operator == "/" and left.kind == "Int" and right.kind == "Int" {
        if right.number == 0 { return runtime_error("KRY6202 division by zero") }
        return runtime_ok(int_value(int(left.number / right.number)))
    }
    if operator == "%" and left.kind == "Int" and right.kind == "Int" {
        if right.number == 0 { return runtime_error("KRY6202 division by zero") }
        return runtime_ok(int_value(left.number % right.number))
    }
    if operator == "==" { return runtime_ok(bool_value(value_equal(left, right))) }
    if operator == "!=" { return runtime_ok(bool_value(!value_equal(left, right))) }
    if operator == "<" and left.kind == "Int" and right.kind == "Int" { return runtime_ok(bool_value(left.number < right.number)) }
    if operator == "<=" and left.kind == "Int" and right.kind == "Int" { return runtime_ok(bool_value(left.number <= right.number)) }
    if operator == ">" and left.kind == "Int" and right.kind == "Int" { return runtime_ok(bool_value(left.number > right.number)) }
    if operator == ">=" and left.kind == "Int" and right.kind == "Int" { return runtime_ok(bool_value(left.number >= right.number)) }
    return runtime_error("KRY6203 incompatible value operation")
}

fn unary_value(operator: String, value: Value) -> RuntimeResult {
    if operator == "!" { return runtime_ok(bool_value(!truthy(value))) }
    if operator == "-" and value.kind == "Int" { return runtime_ok(int_value(-value.number)) }
    if operator == "-" and value.kind == "Float" { return runtime_ok(float_value(-value.float_number)) }
    return runtime_error("KRY6203 incompatible unary operation")
}

fn index_value(target: Value, index: Value) -> RuntimeResult {
    if index.kind != "Int" { return runtime_error("KRY6102 sequence index must be Int") }
    if target.kind == "String" {
        if index.number < 0 or index.number >= len(target.text) { return runtime_error("KRY6104 sequence index out of bounds") }
        return runtime_ok(string_value(target.text[index.number]))
    }
    if target.kind != "Array" and target.kind != "Tuple" and target.kind != "Bytes" {
        return runtime_error("KRY6103 indexing requires String, Array, Tuple, or Bytes")
    }
    if index.number < 0 or index.number >= len(target.values) { return runtime_error("KRY6104 sequence index out of bounds") }
    return runtime_ok(target.values[index.number])
}

fn call_builtin(name: String, arguments: Array) -> RuntimeResult {
    if name == "print" or name == "println" {
        let mut output: String = ""
        let mut index: Int = 0
        while index < len(arguments) {
            let value: Value = arguments[index]
            if index > 0 { output = output + " " }
            output = output + stringify_value(value)
            index = index + 1
        }
        if name == "println" { println(output) }
        else { print(output) }
        return runtime_ok(nil_value())
    }
    if name == "str" {
        if len(arguments) != 1 { return runtime_error("KRY7003 invalid str arity") }
        return runtime_ok(string_value(stringify_value(arguments[0])))
    }
    if name == "int" {
        if len(arguments) != 1 { return runtime_error("KRY7003 invalid int arity") }
        let value: Value = arguments[0]
        if value.kind == "Int" { return runtime_ok(value) }
        if value.kind == "String" { return runtime_ok(int_value(int(value.text))) }
        return runtime_error("KRY6202 conversion is not representable")
    }
    if name == "float" {
        if len(arguments) != 1 { return runtime_error("KRY7003 invalid float arity") }
        let value: Value = arguments[0]
        if value.kind == "Float" { return runtime_ok(value) }
        if value.kind == "Int" { return runtime_ok(float_value(float(value.number))) }
        if value.kind == "String" { return runtime_ok(float_value(float(value.text))) }
        return runtime_error("KRY6202 conversion is not representable")
    }
    if name == "abs" {
        if len(arguments) != 1 { return runtime_error("KRY6202 abs requires a numeric value") }
        let value: Value = arguments[0]
        if value.kind == "Int" {
            if value.number < 0 { return runtime_ok(int_value(-value.number)) }
            return runtime_ok(value)
        }
        if value.kind == "Float" {
            if value.float_number < 0.0 { return runtime_ok(float_value(-value.float_number)) }
            return runtime_ok(value)
        }
        return runtime_error("KRY6202 abs requires a numeric value")
    }
    if name == "sqrt" {
        if len(arguments) != 1 { return runtime_error("KRY6202 sqrt requires a non-negative number") }
        let input: Value = arguments[0]
        let mut number: Float = input.float_number
        if input.kind == "Int" { number = float(input.number) }
        if input.kind != "Int" and input.kind != "Float" or number < 0.0 { return runtime_error("KRY6202 sqrt requires a non-negative number") }
        if number == 0.0 { return runtime_ok(float_value(0.0)) }
        let mut guess: Float = number
        if guess < 1.0 { guess = 1.0 }
        let mut step: Int = 0
        while step < 24 {
            guess = (guess + number / guess) / 2.0
            step = step + 1
        }
        return runtime_ok(float_value(guess))
    }
    if name == "len" {
        if len(arguments) != 1 { return runtime_error("KRY7003 invalid len arity") }
        let value: Value = arguments[0]
        if value.kind == "String" { return runtime_ok(int_value(len(value.text))) }
        if value.kind == "Array" or value.kind == "Tuple" or value.kind == "Bytes" { return runtime_ok(int_value(len(value.values))) }
        return runtime_error("KRY6105 len requires String, Array, Tuple, or Bytes")
    }
    if name == "bytes" {
        if len(arguments) != 1 or arguments[0].kind != "Array" { return runtime_error("KRY6202 bytes requires an Array of Int octets") }
        let input: Array = arguments[0].values
        let mut index: Int = 0
        while index < len(input) {
            let item: Value = input[index]
            if item.kind != "Int" or item.number < 0 or item.number > 255 { return runtime_error("KRY6202 byte at array index " + str(index) + " must be an Int in the range 0..255") }
            index = index + 1
        }
        return runtime_ok(Value { kind: "Bytes", text: "", number: 0, values: input, names: [], float_number: 0.0, bool_value: false })
    }
    if name == "array_push" {
        if len(arguments) != 2 or arguments[0].kind != "Array" { return runtime_error("KRY6203 array_push requires an Array") }
        return runtime_ok(array_value(append_values(arguments[0].values, [arguments[1]])))
    }
    if name == "assert" {
        if len(arguments) != 1 or arguments[0].kind != "Bool" or !arguments[0].bool_value { return runtime_error("KRY6401 assertion failed") }
        return runtime_ok(nil_value())
    }
    if name == "assert_eq" {
        if len(arguments) != 2 or !value_equal(arguments[0], arguments[1]) { return runtime_error("KRY6402 assertion failed: expected " + stringify_value(arguments[1]) + ", found " + stringify_value(arguments[0])) }
        return runtime_ok(nil_value())
    }
    return runtime_error("KRY7003 unknown callable")
}

fn run_function(function_value: FunctionRecord, arguments: Array, module: ModuleRecord) -> RuntimeResult {
    if len(arguments) != function_value.arity { return runtime_error("KRY7003 function arity mismatch") }
    let mut locals: Array = []
    let mut parameter_index: Int = 0
    while parameter_index < function_value.arity {
        let parameter: String = function_value.parameters[parameter_index]
        locals = set_local(locals, parameter, arguments[parameter_index])
        parameter_index = parameter_index + 1
    }
    let mut stack: Array = []
    let mut index: Int = 0
    while index < len(function_value.instructions) {
        let instruction: InstructionRecord = function_value.instructions[index]
        if instruction.op == "PUSH_CONST" {
            if instruction.number < 0 or instruction.number >= len(function_value.constants) {
                return runtime_error("KRY7001 invalid constant index")
            }
            stack = array_push(stack, typed_constant(function_value.constants[instruction.number], instruction.text))
        } else if instruction.op == "PUSH_NIL" {
            stack = array_push(stack, nil_value())
        } else if instruction.op == "PUSH_CALLABLE" {
            stack = array_push(stack, string_value(instruction.text))
        } else if instruction.op == "LOAD" {
            stack = array_push(stack, find_local(locals, instruction.text))
        } else if instruction.op == "STORE" or instruction.op == "STORE_RESULT" {
            if len(stack) == 0 { return runtime_error("KRY7002 stack underflow") }
            let value: Value = pop_value(stack)
            stack = remove_many(stack, 1)
            locals = set_local(locals, instruction.text, value)
            if instruction.op == "STORE_RESULT" { stack = array_push(stack, value) }
        } else if instruction.op == "MAKE_STRUCT" {
            if instruction.number != 0 { return runtime_error("KRY7004 malformed MAKE_STRUCT metadata") }
            if len(stack) < len(instruction.names) { return runtime_error("KRY7002 stack underflow") }
            let values: Array = pop_many(stack, len(instruction.names))
            stack = remove_many(stack, len(instruction.names))
            stack = array_push(stack, struct_value(instruction.text, values, instruction.names))
        } else if instruction.op == "MAKE_ENUM" {
            if instruction.text == "" or instruction.text2 == "" or instruction.number < 0 { return runtime_error("KRY7004 malformed MAKE_ENUM metadata") }
            if len(stack) < instruction.number { return runtime_error("KRY7002 stack underflow") }
            let values: Array = pop_many(stack, instruction.number)
            stack = remove_many(stack, instruction.number)
            stack = array_push(stack, enum_value(instruction.text, instruction.text2, values))
        } else if instruction.op == "MAKE_ARRAY" or instruction.op == "MAKE_TUPLE" {
            if instruction.number < 0 or len(stack) < instruction.number { return runtime_error("KRY7002 stack underflow") }
            let values: Array = pop_many(stack, instruction.number)
            stack = remove_many(stack, instruction.number)
            if instruction.op == "MAKE_ARRAY" { stack = array_push(stack, array_value(values)) }
            else { stack = array_push(stack, tuple_value(values)) }
        } else if instruction.op == "INDEX" {
            if len(stack) < 2 { return runtime_error("KRY7002 stack underflow") }
            let index_value_raw: Value = pop_value(stack)
            let target: Value = stack[len(stack) - 2]
            stack = remove_many(stack, 2)
            let indexed: RuntimeResult = index_value(target, index_value_raw)
            match indexed {
                RuntimeResult.Ok(value) => stack = array_push(stack, value)
                RuntimeResult.Error(message) => return runtime_error(message)
            }
        } else if instruction.op == "MATCH_ENUM" {
            if len(stack) == 0 { return runtime_error("KRY7002 stack underflow") }
            let target: Value = pop_value(stack)
            stack = remove_many(stack, 1)
            let matched: Bool = target.kind == instruction.text and target.text == instruction.text2 and len(target.values) == instruction.number
            stack = array_push(stack, bool_value(matched))
        } else if instruction.op == "BIND_ENUM" {
            let target: Value = find_local(locals, instruction.text)
            if target.kind == "Nil" or len(target.values) != instruction.number { return runtime_error("KRY7004 cannot bind enum payloads") }
            let mut binding_index: Int = 0
            while binding_index < instruction.number {
                let binding_name: String = instruction.names[binding_index]
                if binding_name != "" { locals = set_local(locals, binding_name, target.values[binding_index]) }
                binding_index = binding_index + 1
            }
        } else if instruction.op == "GET_FIELD" {
            if len(stack) == 0 { return runtime_error("KRY7002 stack underflow") }
            let target: Value = pop_value(stack)
            stack = remove_many(stack, 1)
            let field: RuntimeResult = field_value(target, instruction.text)
            match field {
                RuntimeResult.Ok(value) => stack = array_push(stack, value)
                RuntimeResult.Error(message) => return runtime_error(message)
            }
        } else if instruction.op == "POP" {
            if len(stack) == 0 { return runtime_error("KRY7002 stack underflow") }
            stack = remove_many(stack, 1)
        } else if instruction.op == "DUP" {
            if len(stack) == 0 { return runtime_error("KRY7002 stack underflow") }
            stack = array_push(stack, pop_value(stack))
        } else if instruction.op == "UNARY" {
            if len(stack) == 0 { return runtime_error("KRY7002 stack underflow") }
            let operand: Value = pop_value(stack)
            stack = remove_many(stack, 1)
            let result: RuntimeResult = unary_value(instruction.text, operand)
            match result {
                RuntimeResult.Ok(value) => stack = array_push(stack, value)
                RuntimeResult.Error(message) => return runtime_error(message)
            }
        } else if instruction.op == "BINARY" {
            if len(stack) < 2 { return runtime_error("KRY7002 stack underflow") }
            let right: Value = pop_value(stack)
            let left: Value = stack[len(stack) - 2]
            stack = remove_many(stack, 2)
            let result: RuntimeResult = binary_value(instruction.text, left, right)
            match result {
                RuntimeResult.Ok(value) => stack = array_push(stack, value)
                RuntimeResult.Error(message) => return runtime_error(message)
            }
        } else if instruction.op == "JUMP" {
            if instruction.number < 0 or instruction.number > len(function_value.instructions) { return runtime_error("KRY7004 invalid jump target") }
            index = instruction.number
            if index == len(function_value.instructions) { return runtime_error("KRY7005 function ended without RETURN") }
            continue
        } else if instruction.op == "JUMP_IF_FALSE" or instruction.op == "JUMP_IF_TRUE" {
            if len(stack) == 0 { return runtime_error("KRY7002 stack underflow") }
            let condition: Value = pop_value(stack)
            stack = remove_many(stack, 1)
            let mut take_jump: Bool = truthy(condition)
            if instruction.op == "JUMP_IF_FALSE" { take_jump = !truthy(condition) }
            if take_jump {
                if instruction.number < 0 or instruction.number > len(function_value.instructions) { return runtime_error("KRY7004 invalid jump target") }
                index = instruction.number
                if index == len(function_value.instructions) { return runtime_error("KRY7005 function ended without RETURN") }
                continue
            }
        } else if instruction.op == "CALL" {
            if instruction.number < 0 or len(stack) < instruction.number { return runtime_error("KRY7002 stack underflow") }
            let arguments_value: Array = take_arguments(stack, instruction.number)
            stack = remove_many(stack, instruction.number)
            let callee: FunctionRecord = find_function(module.functions, instruction.text)
            let mut called: RuntimeResult = call_builtin(instruction.text, arguments_value)
            if callee.name != "" { called = run_function(callee, arguments_value, module) }
            match called {
                RuntimeResult.Ok(value) => stack = array_push(stack, value)
                RuntimeResult.Error(message) => return runtime_error(message)
            }
        } else if instruction.op == "RETURN" {
            if len(stack) == 0 { return runtime_ok(nil_value()) }
            return runtime_ok(pop_value(stack))
        } else {
            return runtime_error("KRY7004 unsupported opcode")
        }
        index = index + 1
    }
    return runtime_error("KRY7005 function ended without RETURN")
}

pub fn run(value: ModuleRecord) -> RuntimeResult {
    if value.version != 1 { return runtime_error("KRY7005 unsupported bytecode version") }
    let main: FunctionRecord = find_function(value.functions, value.entry)
    if main.name == "" { return runtime_error("KRY7005 entry function missing") }
    return run_function(main, [], value)
}
