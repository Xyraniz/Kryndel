// Crypto utilities for hashing and encryption
// Provides SHA256, HMAC, and random bytes generation

pub fn sha256(data: Bytes) -> Bytes {
    return crypto_sha256(data)
}

pub fn sha256_hex(data: Bytes) -> String {
    return hex_encode(crypto_sha256(data))
}

pub fn hmac_sha256(key: Bytes, data: Bytes) -> Bytes {
    return crypto_hmac_sha256(key, data)
}

pub fn random_bytes(length: Int) -> Result[Bytes, String] {
    return crypto_random_bytes(length)
}

pub fn uuid_v4() -> Result[String, String] {
    let bytes_result: Result[Bytes, String] = crypto_random_bytes(16)
    match bytes_result {
        ok(bytes) => {
            // Set version 4 bits
            bytes[6] = (bytes[6] & 0x0F) | 0x40
            // Set variant bits
            bytes[8] = (bytes[8] & 0x3F) | 0x80
            
            let hex: String = hex_encode(bytes)
            return ok(hex[0:8] + "-" + hex[8:12] + "-" + hex[12:16] + "-" + hex[16:20] + "-" + hex[20:32])
        }
        err(e) => { return err(e) }
    }
}
