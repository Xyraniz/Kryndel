        let mut route: String = "/store/published-listings/skus/" + sku_id
        if !localize { route = route + "?localize=false" }
        return json_parse(self.request("GET", route, "")?)
    }

    pub fn fetch_published_store_listings(application_id: String, localize: Bool = true) -> Result[Json, String] {
        if !valid_user_snowflake(application_id) { return err("application_id must be a Discord snowflake") }
        let mut route: String = "/store/published-listings/skus?application_id=" + application_id
        if !localize { route = route + "&localize=false" }
        return json_parse(self.request("GET", route, "")?)
    }

    pub fn fetch_primary_store_listing(application_id: String, localize: Bool = true) -> Result[Json, String] {
        if !valid_user_snowflake(application_id) { return err("application_id must be a Discord snowflake") }
        let mut route: String = "/store/published-listings/applications/" + application_id
        if !localize { route = route + "?localize=false" }
