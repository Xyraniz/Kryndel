        if !valid_template_code(gift_code) { return err("gift_code must contain only letters, digits, '-' or '_'") }
        let route: String = "/entitlements/gift-codes/" + gift_code + "?with_application=" + bool_query_value(with_application)
            + "&with_subscription_plan=" + bool_query_value(with_subscription_plan)
        return json_parse(self.request("GET", route, "")?)
    }

