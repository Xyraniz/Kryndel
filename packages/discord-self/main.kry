// Isolated account API built on Kryndel's shared Discord transport.
import "discord"

pub struct Client {
    private inner: Bot,
}

fn valid_user_snowflake(value: String) -> Bool {
    if len(value) < 1 || len(value) > 20 { return false }
    for point in codepoints(value) {
        if point < 48 || point > 57 { return false }
    }
    return true
}

fn valid_invite_code(value: String) -> Bool {
    if len(value) < 1 || len(value) > 100 { return false }
    for point in codepoints(value) {
        let digit: Bool = point >= 48 && point <= 57
        let lower: Bool = point >= 97 && point <= 122
        let upper: Bool = point >= 65 && point <= 90
        if !digit && !lower && !upper && point != 45 && point != 95 { return false }
    }
    return true
}

fn bool_query_value(value: Bool) -> String {
    if value { return "true" }
    return "false"
}

pub fn self_client(token: String) -> Result[Client, String] {
    let inner: Bot = user_account_client(token)?
    return ok(Client{inner: inner})
}

// These are usable inside discord_self.on_event callbacks while Client.run is active.
pub fn set_presence_json(status: String, activities_json: String, afk: Bool) -> Result[Nil, String] {
    return gateway_set_presence_json(status, activities_json, afk)
}

pub fn set_voice_state(guild_id: String, channel_id: String, self_mute: Bool, self_deaf: Bool) -> Result[Nil, String] {
    return gateway_set_voice_state(guild_id, channel_id, self_mute, self_deaf)
}

impl Client {
    pub fn run() -> Result[Nil, String] {
        return self.inner.run()
    }

    pub fn request(method: String, route: String, body: String) -> Result[String, String] {
        return self.inner.request(method, route, body)
    }

    pub fn current_user() -> Result[Json, String] {
        return self.inner.get_current_user()
    }

    pub fn fetch_user(user_id: String) -> Result[Json, String] {
        return self.inner.get_user(user_id)
    }

    pub fn fetch_guild(guild_id: String) -> Result[Json, String] {
        return self.inner.get_guild(guild_id)
    }

    pub fn fetch_guild_member(guild_id: String, user_id: String) -> Result[Json, String] {
        return self.inner.get_guild_member(guild_id, user_id)
    }

    pub fn list_guild_members(guild_id: String, after: String, limit: Int) -> Result[Json, String] {
        return self.inner.list_guild_members(guild_id, after, limit)
    }

    pub fn search_guild_members(guild_id: String, query: String, limit: Int) -> Result[Json, String] {
        return self.inner.search_guild_members(guild_id, query, limit)
    }

    pub fn fetch_channel(channel_id: String) -> Result[Json, String] {
        return self.inner.get_channel(channel_id)
    }

    pub fn fetch_message(channel_id: String, message_id: String) -> Result[Json, String] {
        return self.inner.get_message(channel_id, message_id)
    }

    pub fn fetch_guilds(with_counts: Bool = true) -> Result[Json, String] {
        let mut include_counts: String = "false"
        if with_counts { include_counts = "true" }
        let response: String = self.request("GET", "/users/@me/guilds?with_counts=" + include_counts, "")?
        return json_parse(response)
    }

    pub fn guilds() -> Result[Json, String] {
        return self.fetch_guilds(false)
    }

    pub fn fetch_guild_preview(guild_id: String) -> Result[Json, String] {
        if !valid_user_snowflake(guild_id) { return err("guild_id must be a Discord snowflake") }
        return json_parse(self.request("GET", "/guilds/" + guild_id + "/preview", "")?)
    }

    pub fn fetch_guild_profile(guild_id: String) -> Result[Json, String] {
        if !valid_user_snowflake(guild_id) { return err("guild_id must be a Discord snowflake") }
        return json_parse(self.request("GET", "/guilds/" + guild_id + "/profile", "")?)
    }

    pub fn fetch_stage_instance(channel_id: String) -> Result[Json, String] {
        if !valid_user_snowflake(channel_id) { return err("channel_id must be a Discord snowflake") }
        return json_parse(self.request("GET", "/stage-instances/" + channel_id, "")?)
    }

    pub fn fetch_user_profile(
        user_id: String,
        with_mutual_guilds: Bool = true,
        with_mutual_friends_count: Bool = false,
        with_mutual_friends: Bool = true,
        guild_id: String = ""
    ) -> Result[Json, String] {
        if !valid_user_snowflake(user_id) { return err("user_id must be a Discord snowflake") }
        if guild_id != "" && !valid_user_snowflake(guild_id) { return err("guild_id must be empty or a Discord snowflake") }
        let mut route: String = "/users/" + user_id + "/profile?with_mutual_guilds=" + bool_query_value(with_mutual_guilds)
        route = route + "&with_mutual_friends=" + bool_query_value(with_mutual_friends)
        route = route + "&with_mutual_friends_count=" + bool_query_value(with_mutual_friends_count)
        if guild_id != "" { route = route + "&guild_id=" + guild_id }
        return json_parse(self.request("GET", route, "")?)
    }

    pub fn fetch_private_channels() -> Result[Json, String] {
        return json_parse(self.request("GET", "/users/@me/channels", "")?)
    }

    pub fn fetch_relationships() -> Result[Json, String] {
        return json_parse(self.request("GET", "/users/@me/relationships", "")?)
    }

    pub fn fetch_connections() -> Result[Json, String] {
        return json_parse(self.request("GET", "/users/@me/connections", "")?)
    }

    pub fn fetch_notes() -> Result[Json, String] {
        return json_parse(self.request("GET", "/users/@me/notes", "")?)
    }

    pub fn fetch_note(user_id: String) -> Result[Json, String] {
        if !valid_user_snowflake(user_id) { return err("user_id must be a Discord snowflake") }
        return json_parse(self.request("GET", "/users/@me/notes/" + user_id, "")?)
    }

    pub fn edit_note(user_id: String, note: String) -> Result[Nil, String] {
        if !valid_user_snowflake(user_id) { return err("user_id must be a Discord snowflake") }
        let quoted_note: String = json_quote(note)?
        let body: String = "{\"note\":" + quoted_note + "}"
        let _response: String = self.request("PUT", "/users/@me/notes/" + user_id, body)?
        return ok(nil)
    }

    pub fn fetch_invite(
        invite_code: String,
        with_counts: Bool = true,
        with_permissions: Bool = true,
        with_profile: Bool = true,
        scheduled_event_id: String = ""
    ) -> Result[Json, String] {
        if !valid_invite_code(invite_code) { return err("invite_code must contain only letters, digits, '-' or '_'") }
        if scheduled_event_id != "" && !valid_user_snowflake(scheduled_event_id) {
            return err("scheduled_event_id must be empty or a Discord snowflake")
        }
        let mut route: String = "/invites/" + invite_code + "?with_counts=" + bool_query_value(with_counts)
        route = route + "&with_expiration=true&with_permissions=" + bool_query_value(with_permissions)
        route = route + "&with_profile=" + bool_query_value(with_profile)
        if scheduled_event_id != "" { route = route + "&guild_scheduled_event_id=" + scheduled_event_id }
        return json_parse(self.request("GET", route, "")?)
    }

    pub fn fetch_widget(guild_id: String) -> Result[Json, String] {
        if !valid_user_snowflake(guild_id) { return err("guild_id must be a Discord snowflake") }
        return json_parse(self.request("GET", "/guilds/" + guild_id + "/widget.json", "")?)
    }

    pub fn fetch_sticker(sticker_id: String) -> Result[Json, String] {
        if !valid_user_snowflake(sticker_id) { return err("sticker_id must be a Discord snowflake") }
        return json_parse(self.request("GET", "/stickers/" + sticker_id, "")?)
    }

    pub fn fetch_sticker_pack(pack_id: String) -> Result[Json, String] {
        if !valid_user_snowflake(pack_id) { return err("pack_id must be a Discord snowflake") }
        return json_parse(self.request("GET", "/sticker-packs/" + pack_id, "")?)
    }

    pub fn fetch_member_verification(
        guild_id: String,
        with_guild: Bool = true,
        invite: String = ""
    ) -> Result[Json, String] {
        if !valid_user_snowflake(guild_id) { return err("guild_id must be a Discord snowflake") }
        if invite != "" && !valid_invite_code(invite) { return err("invite must be empty or a valid invite code") }
        let mut route: String = "/guilds/" + guild_id + "/member-verification?with_guild=" + bool_query_value(with_guild)
        if invite != "" { route = route + "&invite_code=" + invite }
        return json_parse(self.request("GET", route, "")?)
    }

    pub fn fetch_join_request(request_id: String) -> Result[Json, String] {
        if !valid_user_snowflake(request_id) { return err("request_id must be a Discord snowflake") }
        return json_parse(self.request("GET", "/join-requests/" + request_id, "")?)
    }

    pub fn join_request_guilds() -> Result[Json, String] {
        return json_parse(self.request("GET", "/users/@me/join-request-guilds", "")?)
    }

    pub fn fetch_settings() -> Result[Json, String] {
        let response: Json = json_parse(self.request("GET", "/users/@me/settings-proto/1", "")?)?
        return json_object_get(response, "settings")
    }

    pub fn fetch_tracking_settings() -> Result[Json, String] {
        return json_parse(self.request("GET", "/users/@me/consent", "")?)
    }

    pub fn friend_suggestions() -> Result[Json, String] {
        return json_parse(self.request("GET", "/friend-suggestions", "")?)
    }

    pub fn send_message(channel_id: String, content: String) -> Result[Json, String] {
        return self.inner.send_message(channel_id, content)
    }

    pub fn send_files(channel_id: String, content: String, filenames: Array[String], file_data: Array[Bytes]) -> Result[Json, String] {
        return self.inner.send_files(channel_id, content, filenames, file_data)
    }

    pub fn edit_message(channel_id: String, message_id: String, content: String) -> Result[Json, String] {
        return self.inner.edit_message(channel_id, message_id, content)
    }

    pub fn delete_message(channel_id: String, message_id: String) -> Result[Nil, String] {
        return self.inner.delete_message(channel_id, message_id)
    }

    pub fn create_dm(user_id: String) -> Result[Json, String] {
        return self.inner.create_dm(user_id)
    }

    pub fn set_presence_json(status: String, activities_json: String, afk: Bool) -> Result[Nil, String] {
        return self.inner.set_presence_json(status, activities_json, afk)
    }

    pub fn set_voice_state(guild_id: String, channel_id: String, self_mute: Bool, self_deaf: Bool) -> Result[Nil, String] {
        return self.inner.set_voice_state(guild_id, channel_id, self_mute, self_deaf)
    }

    pub fn join_voice(guild_id: String, channel_id: String, self_mute: Bool, self_deaf: Bool) -> Result[Nil, String] {
        if channel_id == "" { return err("channel_id must be a Discord voice channel ID") }
        return self.inner.set_voice_state(guild_id, channel_id, self_mute, self_deaf)
    }

    pub fn leave_voice(guild_id: String) -> Result[Nil, String] {
        return self.inner.set_voice_state(guild_id, "", false, false)
    }
}
