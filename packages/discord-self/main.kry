    }

    pub fn fetch_primary_store_listings(application_ids: Array[String], localize: Bool = true) -> Result[Json, String] {
        if len(application_ids) == 0 { return json_parse("[]") }
        if len(application_ids) > 100 { return err("application_ids must contain at most 100 Discord snowflakes") }
        let mut route: String = "/store/published-listings/applications?"
        let mut first: Bool = true
        for application_id in application_ids {
            if !valid_user_snowflake(application_id) { return err("application_ids must contain only Discord snowflakes") }
            if !first { route = route + "&" }
            route = route + "application_ids=" + application_id
            first = false
        }
        if !localize { route = route + "&localize=false" }
        return json_parse(self.request("GET", route, "")?)
    }

    pub fn fetch_sku_subscription_plans(
        sku_id: String,
        country_code: String = "",
        payment_source_id: String = "",
        with_unpublished: Bool = false
    ) -> Result[Json, String] {
        if !valid_user_snowflake(sku_id) { return err("sku_id must be a Discord snowflake") }
        if country_code != "" && !valid_country_code(country_code) { return err("country_code must be empty or two letters") }
        if payment_source_id != "" && !valid_user_snowflake(payment_source_id) { return err("payment_source_id must be empty or a Discord snowflake") }
        let mut route: String = "/store/published-listings/skus/" + sku_id + "/subscription-plans"
        let mut first: Bool = true
        if country_code != "" {
            route = route + "?country_code=" + country_code
            first = false
        }
        if payment_source_id != "" {
            if first { route = route + "?" } else { route = route + "&" }
            route = route + "payment_source_id=" + payment_source_id
            first = false
        }
        if with_unpublished {
            if first { route = route + "?" } else { route = route + "&" }
            route = route + "include_unpublished=true"
        }
        return json_parse(self.request("GET", route, "")?)
    }

    pub fn fetch_skus_subscription_plans(
        sku_ids: Array[String],
        country_code: String = "",
        payment_source_id: String = "",
        with_unpublished: Bool = false
    ) -> Result[Json, String] {
        if len(sku_ids) == 0 { return json_parse("[]") }
        if len(sku_ids) > 100 { return err("sku_ids must contain at most 100 Discord snowflakes") }
        if country_code != "" && !valid_country_code(country_code) { return err("country_code must be empty or two letters") }
        if payment_source_id != "" && !valid_user_snowflake(payment_source_id) { return err("payment_source_id must be empty or a Discord snowflake") }
        let mut route: String = "/store/published-listings/skus/subscription-plans?"
        let mut first: Bool = true
        for sku_id in sku_ids {
            if !valid_user_snowflake(sku_id) { return err("sku_ids must contain only Discord snowflakes") }
            if !first { route = route + "&" }
            route = route + "sku_ids=" + sku_id
            first = false
        }
        if country_code != "" { route = route + "&country_code=" + country_code }
        if payment_source_id != "" { route = route + "&payment_source_id=" + payment_source_id }
        if with_unpublished { route = route + "&include_unpublished=true" }
        return json_parse(self.request("GET", route, "")?)
    }

    pub fn fetch_live_build_ids(branch_ids: Array[String]) -> Result[Json, String] {
        if len(branch_ids) == 0 { return json_parse("{}") }
        if len(branch_ids) > 100 { return err("branch_ids must contain at most 100 Discord snowflakes") }
        let mut branch_ids_json: String = "["
        let mut first: Bool = true
        for branch_id in branch_ids {
            if !valid_user_snowflake(branch_id) { return err("branch_ids must contain only Discord snowflakes") }
            if !first { branch_ids_json = branch_ids_json + "," }
            branch_ids_json = branch_ids_json + branch_id
            first = false
        }
        branch_ids_json = branch_ids_json + "]"
        let body: String = "{\"branch_ids\":" + branch_ids_json + "}"
        return json_parse(self.request("POST", "/branches", body)?)
    }

    pub fn price_tiers(price_tier_type: Int = 0, guild_id: String = "") -> Result[Json, String] {
        if price_tier_type < 0 { return err("price_tier_type must not be negative") }
        if guild_id != "" && !valid_user_snowflake(guild_id) { return err("guild_id must be empty or a Discord snowflake") }
        let mut route: String = "/store/price-tiers"
        let mut first: Bool = true
        if price_tier_type > 0 {
            route = route + "?price_tier_type=" + str(price_tier_type)
            first = false
        }
        if guild_id != "" {
            if first { route = route + "?" } else { route = route + "&" }
            route = route + "guild_id=" + guild_id
        }
        return json_parse(self.request("GET", route, "")?)
    }

    pub fn giftable_entitlements(country_code: String = "") -> Result[Json, String] {
        if country_code != "" && !valid_country_code(country_code) { return err("country_code must be empty or two letters") }
        let mut route: String = "/users/@me/entitlements/gifts"
        if country_code != "" { route = route + "?country_code=" + country_code }
        return json_parse(self.request("GET", route, "")?)
    }

    pub fn send_message(channel_id: String, content: String) -> Result[Json, String] {
        return self.inner.send_message(channel_id, content)
    }

    pub fn send_files(channel_id: String, content: String, filenames: Array[String], file_data: Array[Bytes]) -> Result[Json, String] {
        return self.inner.send_files(channel_id, content, filenames, file_data)
    }

    pub fn edit_message(channel_id: String, message_id: String, content: String) -> Result[Json, String] {
        return self.inner.edit_message(channel_id, message_id, content)
    }

    pub fn delete_message(channel_id: String, message_id: String) -> Result[Nil, String] {
        return self.inner.delete_message(channel_id, message_id)
    }

    pub fn create_dm(user_id: String) -> Result[Json, String] {
        return self.inner.create_dm(user_id)
    }

    pub fn set_presence_json(status: String, activities_json: String, afk: Bool) -> Result[Nil, String] {
        return self.inner.set_presence_json(status, activities_json, afk)
    }

    pub fn set_voice_state(guild_id: String, channel_id: String, self_mute: Bool, self_deaf: Bool) -> Result[Nil, String] {
        return self.inner.set_voice_state(guild_id, channel_id, self_mute, self_deaf)
    }

    pub fn join_voice(guild_id: String, channel_id: String, self_mute: Bool, self_deaf: Bool) -> Result[Nil, String] {
        if channel_id == "" { return err("channel_id must be a Discord voice channel ID") }
        return self.inner.set_voice_state(guild_id, channel_id, self_mute, self_deaf)
    }

    pub fn leave_voice(guild_id: String) -> Result[Nil, String] {
        return self.inner.set_voice_state(guild_id, "", false, false)
    }
}
