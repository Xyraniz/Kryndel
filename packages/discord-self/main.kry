        if !valid_user_snowflake(application_id) { return err("application_id must be a Discord snowflake") }
        let mut exclude_consumed: String = "false"
        if !include_consumed { exclude_consumed = "true" }
        let route: String = "/users/@me/applications/" + application_id + "/entitlements?exclude_consumed=" + exclude_consumed
        return json_parse(self.request("GET", route, "")?)
    }

    pub fn fetch_sku(sku_id: String, localize: Bool = true) -> Result[Json, String] {
