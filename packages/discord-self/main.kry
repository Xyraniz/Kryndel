    }

    pub fn detectable_applications() -> Result[Json, String] {
        return json_parse(self.request("GET", "/applications/detectable", "")?)
    }

    pub fn fetch_application(application_id: String) -> Result[Json, String] {
        if !valid_user_snowflake(application_id) { return err("application_id must be a Discord snowflake") }
        return json_parse(self.request("GET", "/applications/" + application_id, "")?)
