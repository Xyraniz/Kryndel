    }

    pub fn fetch_public_application(application_id: String, with_guild: Bool = false) -> Result[Json, String] {
        if !valid_user_snowflake(application_id) { return err("application_id must be a Discord snowflake") }
        let route: String = "/applications/" + application_id + "/public?with_guild=" + bool_query_value(with_guild)
        return json_parse(self.request("GET", route, "")?)
    }

    pub fn fetch_public_applications(application_ids: Array[String]) -> Result[Json, String] {
        if len(application_ids) == 0 { return json_parse("[]") }
        if len(application_ids) > 100 { return err("application_ids must contain at most 100 Discord snowflakes") }
        let mut route: String = "/applications/public?"
        let mut first: Bool = true
        for application_id in application_ids {
            if !valid_user_snowflake(application_id) { return err("application_ids must contain only Discord snowflakes") }
            if !first { route = route + "&" }
            route = route + "application_ids=" + application_id
            first = false
        }
        return json_parse(self.request("GET", route, "")?)
    }

    pub fn teams(with_payout_account_status: Bool = false) -> Result[Json, String] {
        let mut route: String = "/teams"
        if with_payout_account_status { route = route + "?include_payout_account_status=true" }
        return json_parse(self.request("GET", route, "")?)
    }

    pub fn fetch_team(team_id: String) -> Result[Json, String] {
        if !valid_user_snowflake(team_id) { return err("team_id must be a Discord snowflake") }
