        let mut route: String = "/store/skus/" + sku_id
        if !localize { route = route + "?localize=false" }
        return json_parse(self.request("GET", route, "")?)
    }

    pub fn fetch_store_listing(listing_id: String, localize: Bool = true) -> Result[Json, String] {
