// Discord Gateway connection, heartbeat, and dispatch handling.

fn discord_internal_ignore_event_v10(event_json: String) -> String {
    return ""
}

fn discord_internal_ignore_message_v10(message_json: String) -> String {
    return ""
}

fn discord_internal_ignore_interaction_v10(interaction_json: String) -> String {
    return ""
}

fn discord_interaction_subcommand_suffix(data: Json) -> Result[String, String] {
    let options_result: Result[Json, String] = json_object_get(data, "options")
    let mut options: Json = json_parse("[]")?
    match options_result {
        ok(value) => { options = value }
        err(_) => { return ok("") }
    }
    let count: Int = json_array_len(options)?
    let mut index: Int = 0
    while index < count {
        let option: Json = json_array_get(options, index)?
        let option_type: Int = json_int(json_object_get(option, "type")?)?
        if option_type == 1 {
            let name: String = json_string(json_object_get(option, "name")?)?
            return ok("." + name)
        }
        if option_type == 2 {
            let group_name: String = json_string(json_object_get(option, "name")?)?
            let children: Json = json_object_get(option, "options")?
            let child_count: Int = json_array_len(children)?
            let mut child_index: Int = 0
            while child_index < child_count {
                let child: Json = json_array_get(children, child_index)?
                if json_int(json_object_get(child, "type")?)? == 1 {
                    let command_name: String = json_string(json_object_get(child, "name")?)?
                    return ok("." + group_name + "." + command_name)
                }
                child_index = child_index + 1
            }
            return err("Discord subcommand group interaction has no selected subcommand")
        }
        index = index + 1
    }
    return ok("")
}

fn discord_interaction_handler_slots(interaction: Json) -> Result[Array[String], String] {
    let raw_type: Json = json_field(interaction, "type")?
    let interaction_type: Int = json_int(raw_type)?
    if interaction_type == 2 || interaction_type == 4 {
        let data: Json = json_field(interaction, "data")?
        let raw_name: Json = json_field(data, "name")?
        let name: String = json_string(raw_name)?
        if name == "" { return err("Discord interaction command name is empty") }
        let mut prefix: String = "discord.on_command."
        if interaction_type == 4 { prefix = "discord.on_autocomplete." }
        let suffix: String = discord_interaction_subcommand_suffix(data)?
        let mut slots: Array[String] = []
        if suffix != "" { slots = array_push(slots, prefix + name + suffix) }
        slots = array_push(slots, prefix + name)
        return ok(slots)
    }
    if interaction_type == 3 || interaction_type == 5 {
        let data: Json = json_field(interaction, "data")?
        let raw_custom_id: Json = json_field(data, "custom_id")?
        let custom_id: String = json_string(raw_custom_id)?
        if custom_id == "" { return err("Discord component interaction custom_id is empty") }
        return ok(["discord.on_component." + custom_id])
    }
    let no_named_route: Array[String] = []
    return ok(no_named_route)
}

fn discord_dispatch_interaction(bot: Bot, interaction: Json, event_reply: String) -> Result[Nil, String] {
    let interaction_json: String = json_stringify(interaction)
    let mut callback_json: String = event_reply
    if callback_json == "" {
        let slots: Array[String] = discord_interaction_handler_slots(interaction)?
        let mut handler_found: Bool = false
        for slot in slots {
            if !handler_found {
                let dispatch: Result[String, String] = poly_dispatch(slot, interaction_json)
                match dispatch {
                    ok(value) => {
                        callback_json = value
                        handler_found = true
                    }
                    err(problem) => {
                        if problem != "dispatch slot has no registered handlers" {
                            return err("Discord interaction handler failed: " + problem)
                        }
                    }
                }
            }
        }
        if !handler_found {
            let fallback: Result[String, String] = poly_dispatch("discord.on_interaction", interaction_json)
            match fallback {
                ok(value) => { callback_json = value }
                err(problem) => {
                    if problem == "dispatch slot has no registered handlers" { return ok(nil) }
                    return err("Discord interaction handler failed: " + problem)
                }
            }
        }
    }
    if callback_json == "" { return ok(nil) }
    let callback: Json = json_parse(callback_json)?
    if json_kind(callback) != "object" { return err("Discord interaction handler must return a JSON callback object") }
    let raw_id: Json = json_field(interaction, "id")?
    let interaction_id: String = json_string(raw_id)?
    let raw_token: Json = json_field(interaction, "token")?
    let interaction_token: String = json_string(raw_token)?
    if !valid_snowflake(interaction_id) || !valid_interaction_token(interaction_token) {
        return err("Discord interaction has an invalid ID or token")
    }
    let sent: Result[Nil, String] = bot.respond_interaction(interaction_id, interaction_token, callback_json)
    match sent {
        ok(_) => { return ok(nil) }
        err(problem) => { return err("Discord interaction response failed: " + problem) }
    }
}

fn discord_prefix_raw_argument_text(remainder: String, command_name: String) -> Result[String, String] {
    let mut command_start: Int = 0
    while command_start < len(remainder) {
        let character: String = substring(remainder, command_start, 1)?
        if trim(character) != "" { break }
        command_start = command_start + 1
    }
    if command_start >= len(remainder) { return ok("") }
    let command_tail: String = substring(remainder, command_start, len(remainder) - command_start)?
    if !starts_with(command_tail, command_name) { return ok("") }
    let mut argument_start: Int = command_start + len(command_name)
    while argument_start < len(remainder) {
        let character: String = substring(remainder, argument_start, 1)?
        if trim(character) != "" { break }
        argument_start = argument_start + 1
    }
    if argument_start >= len(remainder) { return ok("") }
    return substring(remainder, argument_start, len(remainder) - argument_start)
}

fn discord_prefix_quote_end(opening: String) -> String {
    if opening == "\"" { return "\"" }
    if opening == "‘" { return "’" }
    if opening == "‚" { return "‛" }
    if opening == "“" { return "”" }
    if opening == "„" { return "‟" }
    if opening == "⹂" { return "⹂" }
    if opening == "「" { return "」" }
    if opening == "『" { return "』" }
    if opening == "〝" { return "〞" }
    if opening == "﹁" { return "﹂" }
    if opening == "﹃" { return "﹄" }
    if opening == "＂" { return "＂" }
    if opening == "｢" { return "｣" }
    if opening == "«" { return "»" }
    if opening == "‹" { return "›" }
    if opening == "《" { return "》" }
    if opening == "〈" { return "〉" }
    if opening == "'" { return "'" }
    return ""
}

fn discord_prefix_is_quote(character: String) -> Bool {
    return discord_prefix_quote_end(character) != "" || character == "’" || character == "‛" || character == "”" || character == "‟" || character == "」" || character == "』" || character == "〞" || character == "﹂" || character == "﹄" || character == "｣" || character == "»" || character == "›" || character == "》" || character == "〉"
}

fn discord_prefix_parse_words(value: String) -> Result[Array[String], String] {
    let mut words: Array[String] = []
    let mut index: Int = 0
    while index < len(value) {
        while index < len(value) {
            let whitespace: String = substring(value, index, 1)?
            if trim(whitespace) != "" { break }
            index = index + 1
        }
        if index >= len(value) { break }
        let first: String = substring(value, index, 1)?
        let quote_end: String = discord_prefix_quote_end(first)
        let mut quoted: Bool = quote_end != ""
        let mut closed: Bool = !quoted
        if quoted { index = index + 1 }
        let mut word: String = ""
        let mut done: Bool = false
        while index < len(value) && !done {
            let character: String = substring(value, index, 1)?
            if character == "\\" {
                if index + 1 >= len(value) {
                    if quoted { return err("expected closing quote " + quote_end) }
                    word = word + "\\"
                    index = index + 1
                    done = true
                } else {
                    let next_character: String = substring(value, index + 1, 1)?
                    if quoted {
                        if next_character == first || next_character == quote_end {
                            word = word + next_character
                            index = index + 2
                        } else {
                            word = word + "\\"
                            index = index + 1
                        }
                    } else if discord_prefix_is_quote(next_character) {
                        word = word + next_character
                        index = index + 2
                    } else {
                        word = word + "\\"
                        index = index + 1
                    }
                }
            } else if quoted && character == quote_end {
                index = index + 1
                closed = true
                if index < len(value) {
                    let following: String = substring(value, index, 1)?
                    if trim(following) != "" { return err("quoted argument must be followed by whitespace") }
                }
                done = true
            } else if !quoted && discord_prefix_is_quote(character) {
                return err("unexpected quote mark: " + character)
            } else if !quoted && trim(character) == "" {
                done = true
            } else {
                word = word + character
                index = index + 1
            }
        }
        if quoted && !closed { return err("expected closing quote " + quote_end) }
        words = array_push(words, word)
    }
    return ok(words)
}

fn discord_prefix_command_context(message: Json, prefixes: Array[String]) -> Result[String, String] {
    let raw_content: Result[Json, String] = json_object_get(message, "content")
    let mut content: String = ""
    match raw_content {
        ok(value) => {
            match json_string(value) {
                ok(text_value) => { content = text_value }
                err(_) => { return ok("") }
            }
        }
        err(_) => { return ok("") }
    }
    let mut matched_prefix: String = ""
    for prefix in prefixes {
        if starts_with(content, prefix) && len(prefix) > len(matched_prefix) { matched_prefix = prefix }
    }
    if matched_prefix == "" { return ok("") }
    let remainder: String = substring(content, len(matched_prefix), len(content) - len(matched_prefix))?
    let normalized: String = replace(replace(replace(remainder, "\t", " "), "\r", " "), "\n", " ")
    let mut tokens: Array[String] = []
    for token in split(trim(normalized), " ") {
        if token != "" { tokens = array_push(tokens, token) }
    }
    if len(tokens) == 0 { return ok("") }
    let mut command_name: String = ""
    match array_get(tokens, 0) {
        some(value) => { command_name = value }
        none => { return ok("") }
    }
    let raw_argument_text: String = discord_prefix_raw_argument_text(remainder, command_name)?
    let arguments: Array[String] = array_slice(tokens, 1, len(tokens) - 1)
    let mut parsed_arguments: Array[String] = []
    let mut parse_error: String = ""
    let parsed_words_result: Result[Array[String], String] = discord_prefix_parse_words(remainder)
    match parsed_words_result {
        ok(parsed_words) => {
            if len(parsed_words) > 1 { parsed_arguments = array_slice(parsed_words, 1, len(parsed_words) - 1) }
        }
        err(problem) => { parse_error = problem }
    }
    let mut arguments_json: String = "["
    let mut arguments_text: String = ""
    let mut first: Bool = true
    for argument in arguments {
        if !first { arguments_json = arguments_json + ","; arguments_text = arguments_text + " " }
        arguments_json = arguments_json + json_quote(argument)?
        arguments_text = arguments_text + argument
        first = false
    }
    arguments_json = arguments_json + "]"
    let mut parsed_arguments_json: String = "["
    let mut parsed_first: Bool = true
    for argument in parsed_arguments {
        if !parsed_first { parsed_arguments_json = parsed_arguments_json + "," }
        parsed_arguments_json = parsed_arguments_json + json_quote(argument)?
        parsed_first = false
    }
    parsed_arguments_json = parsed_arguments_json + "]"
    let encoded_prefix: String = json_quote(matched_prefix)?
    let encoded_command: String = json_quote(command_name)?
    let encoded_arguments_text: String = json_quote(arguments_text)?
    let encoded_raw_arguments: String = json_quote(raw_argument_text)?
    let encoded_parse_error: String = json_quote(parse_error)?
    return ok("{\"message\":" + json_stringify(message) + ",\"prefix\":" + encoded_prefix + ",\"command\":" + encoded_command + ",\"arguments\":" + arguments_json + ",\"argument_text\":" + encoded_arguments_text + ",\"raw_argument_text\":" + encoded_raw_arguments + ",\"parsed_arguments\":" + parsed_arguments_json + ",\"parse_error\":" + encoded_parse_error + "}")
}

fn discord_dispatch_prefix_command(message: Json, prefixes: Array[String]) -> Result[String, String] {
    if len(prefixes) == 0 { return ok("") }
    let context: String = discord_prefix_command_context(message, prefixes)?
    if context == "" { return ok("") }
    let parsed_context: Json = json_parse(context)?
    let command_name: String = json_string(json_object_get(parsed_context, "command")?)?
    let parse_error: String = json_string(json_object_get(parsed_context, "parse_error")?)?
    if parse_error != "" {
        let error_result: Result[String, String] = poly_dispatch("discord.on_prefix_command_error", context)
        match error_result {
            ok(reply) => { return ok(reply) }
            err(problem) => {
                if problem == "dispatch slot has no registered handlers" { return ok("") }
                return err("Discord prefix command error handler failed: " + problem)
            }
        }
    }
    let named_result: Result[String, String] = poly_dispatch("discord.on_prefix_command." + command_name, context)
    match named_result {
        ok(reply) => { return ok(reply) }
        err(problem) => {
            if problem != "dispatch slot has no registered handlers" { return err("Discord prefix command handler failed: " + problem) }
        }
    }
    let generic_result: Result[String, String] = poly_dispatch("discord.on_prefix_command", context)
    match generic_result {
        ok(reply) => { return ok(reply) }
        err(problem) => {
            if problem == "dispatch slot has no registered handlers" { return ok("") }
            return err("Discord prefix command handler failed: " + problem)
        }
    }
}

fn discord_cache_message_author_if_missing(bot: Bot, author: Json) -> Nil {
    let raw_id: Result[Json, String] = json_object_get(author, "id")
    match raw_id {
        ok(id_value) => {
            match json_string(id_value) {
                ok(user_id) => {
                    if valid_snowflake(user_id) {
                        let cached: Result[Json, String] = bot.cache_get("user", user_id)
                        match cached {
                            ok(_) => {}
                            err(_) => {
                                let stored: Result[Nil, String] = bot.cache_put("user", user_id, json_stringify(author))
                                match stored { ok(_) => {} err(_) => {} }
                            }
                        }
                    }
                }
                err(_) => {}
            }
        }
        err(_) => {}
    }
    return nil
}

fn gateway_frame(raw: String) -> Result[Json, String] {
    return json_parse(raw)
}

fn gateway_opcode(frame: Json) -> Result[Int, String] {
    let raw_opcode: Result[Json, String] = json_field(frame, "op")
    match raw_opcode {
        ok(value) => { return json_int(value) }
        err(problem) => { return err("Gateway frame has no opcode: " + problem) }
    }
}

fn request_guild_members_internal(guild_id: String, query: String, limit: Int, user_ids: Array[String], presences: Bool, nonce: String, all_members: Bool) -> Result[String, String] {
    if !valid_snowflake(guild_id) { return err("guild_id must be a Discord snowflake") }
    return discord_gateway_request_members(guild_id, query, limit, user_ids, presences, nonce, all_members)
}

// Start a prefix query and return its correlation nonce immediately. The
// completed member array is later sent to discord.on_guild_members_complete.
pub fn query_guild_members(guild_id: String, query: String, limit: Int, presences: Bool, nonce: String) -> Result[String, String] {
    let user_ids: Array[String] = []
    return request_guild_members_internal(guild_id, query, limit, user_ids, presences, nonce, false)
}

pub fn request_guild_members_by_ids(guild_id: String, user_ids: Array[String], presences: Bool, nonce: String) -> Result[String, String] {
    return request_guild_members_internal(guild_id, "", 100, user_ids, presences, nonce, false)
}

pub fn chunk_guild_members(guild_id: String, presences: Bool, nonce: String) -> Result[String, String] {
    let user_ids: Array[String] = []
    return request_guild_members_internal(guild_id, "", 0, user_ids, presences, nonce, true)
}

fn discord_internal_ignore_member_query(value: String) -> String {
    return ""
}

fn discord_dispatch_member_query_failures() -> Nil {
    let failures: Array[String] = discord_gateway_take_member_query_failures()
    for failure in failures {
        let handler: Result[String, String] = poly_dispatch("discord.on_guild_members_error", failure)
        match handler {
            ok(_) => {}
            err(problem) => { println("Discord member-query error handler failed: " + problem) }
        }
    }
    return nil
}

fn gateway_heartbeat_interval(frame: Json) -> Result[Int, String] {
    let raw_data: Result[Json, String] = json_field(frame, "d")
    match raw_data {
        err(problem) => { return err("Gateway HELLO has no data object: " + problem) }
        ok(data) => {
            let raw_interval: Result[Json, String] = json_field(data, "heartbeat_interval")
            match raw_interval {
                ok(value) => { return json_int(value) }
                err(problem) => { return err("Gateway HELLO has no heartbeat interval: " + problem) }
            }
        }
    }
}

fn heartbeat_payload(sequence: Int) -> String {
    if sequence < 0 { return "{\"op\":1,\"d\":null}" }
    return "{\"op\":1,\"d\":" + str(sequence) + "}"
}

fn gateway_close_code(problem: String) -> Int {
    if starts_with(problem, "WebSocket peer closed with code 4001:") { return 4001 }
    if starts_with(problem, "WebSocket peer closed with code 4002:") { return 4002 }
    if starts_with(problem, "WebSocket peer closed with code 4003:") { return 4003 }
    if starts_with(problem, "WebSocket peer closed with code 4004:") { return 4004 }
    if starts_with(problem, "WebSocket peer closed with code 4005:") { return 4005 }
    if starts_with(problem, "WebSocket peer closed with code 4007:") { return 4007 }
    if starts_with(problem, "WebSocket peer closed with code 4009:") { return 4009 }
    if starts_with(problem, "WebSocket peer closed with code 4010:") { return 4010 }
    if starts_with(problem, "WebSocket peer closed with code 4011:") { return 4011 }
    if starts_with(problem, "WebSocket peer closed with code 4012:") { return 4012 }
    if starts_with(problem, "WebSocket peer closed with code 4013:") { return 4013 }
    if starts_with(problem, "WebSocket peer closed with code 4014:") { return 4014 }
    return 0
}

fn gateway_close_is_terminal(code: Int) -> Bool {
    return code == 4004 || code == 4010 || code == 4011 || code == 4012 || code == 4013 || code == 4014
}

fn gateway_close_state(code: Int, session_id: String, sequence: Int, resume_url: String) -> GatewaySessionState {
    if code == 4003 || code == 4007 || code == 4009 {
        return GatewaySessionState{reconnect: true, session_id: "", sequence: -1, resume_url: resume_url}
    }
    return GatewaySessionState{reconnect: true, session_id: session_id, sequence: sequence, resume_url: resume_url}
}

fn gateway_close_transition(code: Int, session_id: String, sequence: Int, resume_url: String, problem: String) -> Result[GatewaySessionState, String] {
    if gateway_close_is_terminal(code) {
        return err("Discord Gateway closed this shard permanently: " + problem)
    }
    return ok(gateway_close_state(code, session_id, sequence, resume_url))
}

impl Bot {

    // Establishes a real Gateway v10 session, sends Identify, maintains
    // heartbeat/ack state, and remains connected until Discord or the caller's
    // runtime ends the connection. Gateway dispatches are routed to the
    // generic event slot; MESSAGE_CREATE also supports a reply-specific slot.
    pub fn run() -> Result[Nil, String] {
        let prefixes: Array[String] = self.command_prefixes()
        let event_fallback: Result[Nil, String] = poly_register("discord.on_event", "discord_internal_ignore_event_v10", -1000000)
        match event_fallback {
            ok(_) => {}
            err(problem) => {
                if problem != "handler already registered in slot" {
                    return err("could not install Discord event handler fallback: " + problem)
                }
            }
        }
        let message_fallback: Result[Nil, String] = poly_register("discord.on_message", "discord_internal_ignore_message_v10", -1000000)
        match message_fallback {
            ok(_) => {}
            err(problem) => {
                if problem != "handler already registered in slot" {
                    return err("could not install Discord message handler fallback: " + problem)
                }
            }
        }
        let interaction_fallback: Result[Nil, String] = poly_register("discord.on_interaction", "discord_internal_ignore_interaction_v10", -1000000)
        match interaction_fallback {
            ok(_) => {}
            err(problem) => {
                if problem != "handler already registered in slot" {
                    return err("could not install Discord interaction handler fallback: " + problem)
                }
            }
        }
        let member_query_fallback: Result[Nil, String] = poly_register("discord.on_guild_members_complete", "discord_internal_ignore_member_query", -1000000)
        match member_query_fallback {
            ok(_) => {}
            err(problem) => {
                if problem != "handler already registered in slot" {
                    return err("could not install Discord member-query handler fallback: " + problem)
                }
            }
        }
        let member_query_error_fallback: Result[Nil, String] = poly_register("discord.on_guild_members_error", "discord_internal_ignore_member_query", -1000000)
        match member_query_error_fallback {
            ok(_) => {}
            err(problem) => {
                if problem != "handler already registered in slot" {
                    return err("could not install Discord member-query error handler fallback: " + problem)
                }
            }
        }
        let info_result: Result[Json, String] = response_json(self.request("GET", "/gateway/bot", ""))
        let mut info: Json = result_unwrap(json_parse("null"))
        match info_result {
            ok(value) => { info = value }
            err(problem) => { return err(problem) }
        }
        let raw_gateway: Result[Json, String] = json_field(info, "url")
        let mut gateway: String = ""
        match raw_gateway {
            ok(value) => {
                match json_string(value) {
                    ok(url) => { gateway = url }
                    err(problem) => { return err("Gateway URL is invalid: " + problem) }
                }
            }
            err(problem) => { return err("Gateway discovery response has no URL: " + problem) }
        }
        if !trusted_gateway_url(gateway) { return err("Discord returned an untrusted Gateway URL") }
        let mut session_id: String = ""
        let mut sequence: Int = -1
        let mut resume_url: String = gateway
        let mut reconnect_delay: Int = 1000
        let mut reconnecting: Bool = true
        while reconnecting {
            let use_resume: Bool = session_id != "" && sequence >= 0 && trusted_gateway_url(resume_url)
            let mut connect_url: String = gateway
            if use_resume { connect_url = resume_url }
            let socket_result: Result[WebSocket, String] = websocket_connect(connect_url + "?v=10&encoding=json")
            match socket_result {
                err(problem) => {
                    if starts_with(problem, "WebSocket handshake rejected:") {
                        return err("Discord Gateway rejected the WebSocket handshake: " + problem)
                    }
                    println("Discord Gateway connection failed; retrying: " + problem)
                    let pause: Result[Nil, String] = sleep_ms(reconnect_delay)
                    match pause { ok(_) => {} err(wait_problem) => { return err(wait_problem) } }
                    reconnect_delay = reconnect_delay * 2
                    if reconnect_delay > 30000 { reconnect_delay = 30000 }
                }
                ok(value) => {
                    let connection: Result[GatewaySessionState, String] = run_gateway_session(value, self, session_id, sequence, resume_url, use_resume, prefixes)
                    let member_query_failures: Array[String] = discord_gateway_session_unbind()
                    for failure in member_query_failures {
                        let error_handler: Result[String, String] = poly_dispatch("discord.on_guild_members_error", failure)
                        match error_handler {
                            ok(_) => {}
                            err(problem) => { println("Discord member-query error handler failed: " + problem) }
                        }
                    }
                    websocket_close(value)
                    match connection {
                        ok(state) => {
                            if !state.reconnect { return err("Discord Gateway session ended unexpectedly") }
                            session_id = state.session_id
                            sequence = state.sequence
                            resume_url = state.resume_url
                            if session_id == "" || sequence < 0 || !trusted_gateway_url(resume_url) {
                                session_id = ""
                                sequence = -1
                                resume_url = gateway
                            }
                            reconnect_delay = 1000
                            let pause: Result[Nil, String] = sleep_ms(reconnect_delay)
                            match pause { ok(_) => {} err(wait_problem) => { return err(wait_problem) } }
                        }
                        err(problem) => { return err(problem) }
                    }
                }
            }
        }
        return ok(nil)
    }

}

fn run_gateway_session(socket: WebSocket, bot: Bot, previous_session_id: String, previous_sequence: Int, resume_url: String, should_resume: Bool, prefixes: Array[String]) -> Result[GatewaySessionState, String] {
        let hello_result: Result[String, String] = websocket_receive_timeout(socket, 30000)
        let mut hello_raw: String = ""
        match hello_result {
            ok(value) => { hello_raw = value }
            err(problem) => {
                websocket_close(socket)
                return err("Gateway HELLO receive failed: " + problem)
            }
        }
        let hello_parse: Result[Json, String] = gateway_frame(hello_raw)
        let mut hello: Json = result_unwrap(json_parse("null"))
        match hello_parse {
            ok(value) => { hello = value }
            err(problem) => {
                websocket_close(socket)
                return err("Gateway sent invalid HELLO JSON: " + problem)
            }
        }
        let hello_op: Result[Int, String] = gateway_opcode(hello)
        let mut hello_code: Int = 0
        match hello_op {
            ok(value) => { hello_code = value }
            err(problem) => {
                websocket_close(socket)
                return err(problem)
            }
        }
        if hello_code != 10 {
            websocket_close(socket)
            return err("Discord Gateway did not begin with HELLO")
        }
        let interval_result: Result[Int, String] = gateway_heartbeat_interval(hello)
        let mut heartbeat_interval: Int = 0
        match interval_result {
            ok(value) => { heartbeat_interval = value }
            err(problem) => {
                websocket_close(socket)
                return err(problem)
            }
        }
        if heartbeat_interval < 1000 || heartbeat_interval > 300000 {
            websocket_close(socket)
            return err("Discord Gateway returned an invalid heartbeat interval")
        }

        let intents_result: Result[Int, String] = intent_mask(bot.intents)
        let mut intents_value: Int = 0
        match intents_result {
            ok(value) => { intents_value = value }
            err(problem) => {
                websocket_close(socket)
                return err(problem)
            }
        }
        let gateway_binding: Result[Nil, String] = discord_gateway_session_bind(socket, intents_value)
        match gateway_binding {
            ok(_) => {}
            err(problem) => {
                websocket_close(socket)
                return err("could not bind Discord Gateway session: " + problem)
            }
        }
        let token_json: Result[String, String] = json_quote(bot.token)
        let mut encoded_token: String = ""
        match token_json {
            ok(value) => { encoded_token = value }
            err(problem) => {
                websocket_close(socket)
                return err(problem)
            }
        }
        let mut identify: String = ""
        if should_resume && previous_session_id != "" && previous_sequence >= 0 {
            let session_json: Result[String, String] = json_quote(previous_session_id)
            match session_json {
                ok(encoded_session) => { identify = "{\"op\":6,\"d\":{\"token\":" + encoded_token + ",\"session_id\":" + encoded_session + ",\"seq\":" + str(previous_sequence) + "}}" }
                err(problem) => { websocket_close(socket); return err(problem) }
            }
        } else {
            identify = "{\"op\":2,\"d\":{\"token\":" + encoded_token + ",\"intents\":" + str(intents_value) + ",\"shard\":[" + str(bot.shard_id) + "," + str(bot.shard_count) + "],\"properties\":{\"$os\":\"kryndel\",\"$browser\":\"kryndel\",\"$device\":\"kryndel\"}}}"
        }
        let sent: Result[Nil, String] = websocket_send(socket, identify)
        match sent {
            err(problem) => {
                websocket_close(socket)
                return err("Gateway Identify failed: " + problem)
            }
            ok(_) => {}
        }

        let mut sequence: Int = previous_sequence
        let mut current_session_id: String = previous_session_id
        let mut current_resume_url: String = resume_url
        let mut awaiting_ack: Bool = false
        let mut ready: Bool = false
        let mut heartbeat_wait: Int = datetime_unix_ms() % heartbeat_interval
        if heartbeat_wait < 1 { heartbeat_wait = 1 }
        let mut next_heartbeat_at: Int = datetime_unix_ms() + heartbeat_wait
        let mut connected: Bool = true
        while connected {
            let mut receive_wait: Int = next_heartbeat_at - datetime_unix_ms()
            if receive_wait < 1 { receive_wait = 1 }
            let received: Result[String, String] = websocket_receive_timeout(socket, receive_wait)
            match received {
                err(problem) => {
                    discord_dispatch_member_query_failures()
                    if problem != "WebSocket receive timed out" {
                        let close_code: Int = gateway_close_code(problem)
                        if close_code != 0 {
                            let next_state: Result[GatewaySessionState, String] = gateway_close_transition(close_code, current_session_id, sequence, current_resume_url, problem)
                            match next_state {
                                ok(state) => {
                                    if close_code == 4003 {
                                        println("Discord Gateway session is unauthenticated or invalid; starting a new session")
                                    } else if close_code == 4007 || close_code == 4009 {
                                        println("Discord Gateway session expired; starting a new session: " + problem)
                                    } else {
                                        println("Discord Gateway closed with code " + str(close_code) + "; reconnecting")
                                    }
                                    return ok(state)
                                }
                                err(close_problem) => { return err(close_problem) }
                            }
                        }
                        println("Discord Gateway receive failed; attempting to resume: " + problem)
                        return ok(GatewaySessionState{reconnect: true, session_id: current_session_id, sequence: sequence, resume_url: current_resume_url})
                    }
                    if awaiting_ack {
                        println("Discord Gateway heartbeat acknowledgement timed out; attempting to resume")
                        return ok(GatewaySessionState{reconnect: true, session_id: current_session_id, sequence: sequence, resume_url: current_resume_url})
                    }
                    let heartbeat: Result[Nil, String] = websocket_send(socket, heartbeat_payload(sequence))
                    match heartbeat {
                        ok(_) => {
                            awaiting_ack = true
                            next_heartbeat_at = datetime_unix_ms() + heartbeat_interval
                        }
                        err(send_problem) => {
                            println("Discord Gateway heartbeat failed; attempting to resume: " + send_problem)
                            return ok(GatewaySessionState{reconnect: true, session_id: current_session_id, sequence: sequence, resume_url: current_resume_url})
                        }
                    }
                }
                ok(raw_frame) => {
                    let parsed_frame: Result[Json, String] = gateway_frame(raw_frame)
                    let mut frame: Json = result_unwrap(json_parse("null"))
                    match parsed_frame {
                        ok(value) => { frame = value }
                        err(problem) => { return err("Discord Gateway sent invalid JSON: " + problem) }
                    }
                    let op_result: Result[Int, String] = gateway_opcode(frame)
                    let mut op: Int = -1
                    match op_result {
                        ok(value) => { op = value }
                        err(problem) => { return err(problem) }
                    }
                    if op == 0 {
                        let raw_sequence: Result[Json, String] = json_field(frame, "s")
                        match raw_sequence {
                            ok(value) => {
                                match json_int(value) {
                                    ok(number) => { sequence = number }
                                    err(problem) => { return err("Gateway dispatch has an invalid sequence: " + problem) }
                                }
                            }
                            err(problem) => { return err("Gateway dispatch has no sequence: " + problem) }
                        }
                        let raw_event: Result[Json, String] = json_field(frame, "t")
                        match raw_event {
                            ok(value) => {
                                match json_string(value) {
                                    ok(event_name) => {
                                        let raw_data: Result[Json, String] = json_field(frame, "d")
                                        let mut event_data: Json = result_unwrap(json_parse("null"))
                                        match raw_data {
                                            ok(value) => { event_data = value }
                                            err(problem) => { return err("Gateway dispatch has no data: " + problem) }
                                        }
                                        let event_name_json: Result[String, String] = json_quote(event_name)
                                        let mut encoded_event_name: String = ""
                                        match event_name_json {
                                            ok(value) => { encoded_event_name = value }
                                            err(problem) => { return err(problem) }
                                        }
                                        let event_payload: String = "{\"name\":" + encoded_event_name + ",\"data\":" + json_stringify(event_data) + "}"
                                        let cache_result: Result[Nil, String] = discord_cache_ingest(event_name, json_stringify(event_data))
                                        match cache_result {
                                            ok(_) => {}
                                            err(problem) => { println("Discord cache update skipped: " + problem) }
                                        }
                                        if event_name == "RATE_LIMITED" {
                                            let rate_limit_result: Result[Nil, String] = discord_gateway_rate_limit(json_stringify(event_data))
                                            match rate_limit_result {
                                                ok(_) => {}
                                                err(problem) => { println("Discord member-query rate-limit event skipped: " + problem) }
                                            }
                                        }
                                        let mut complete_member_query: String = ""
                                        if event_name == "GUILD_MEMBERS_CHUNK" {
                                            let chunk_result: Result[String, String] = discord_gateway_member_chunk(json_stringify(event_data))
                                            match chunk_result {
                                                ok(value) => { complete_member_query = value }
                                                err(problem) => { println("Discord member-query aggregation skipped: " + problem) }
                                            }
                                        }
                                        let event_handler_result: Result[String, String] = poly_dispatch("discord.on_event", event_payload)
                                        let mut reply: String = ""
                                        match event_handler_result {
                                            ok(value) => { reply = value }
                                            err(problem) => { return err("Discord event handler failed: " + problem) }
                                        }
                                        if complete_member_query != "" {
                                            let complete_handler: Result[String, String] = poly_dispatch("discord.on_guild_members_complete", complete_member_query)
                                            match complete_handler {
                                                ok(_) => {}
                                                err(problem) => { return err("Discord member-query completion handler failed: " + problem) }
                                            }
                                        }
                                        discord_dispatch_member_query_failures()
                                        if event_name == "READY" && !ready {
                                            let raw_session_id: Result[Json, String] = json_field(event_data, "session_id")
                                            match raw_session_id {
                                                ok(value) => {
                                                    match json_string(value) {
                                                        ok(value) => { current_session_id = value }
                                                        err(problem) => { return err("Discord READY session_id is invalid: " + problem) }
                                                    }
                                                }
                                                err(problem) => { return err("Discord READY has no session_id: " + problem) }
                                            }
                                            let raw_resume_url: Result[Json, String] = json_field(event_data, "resume_gateway_url")
                                            match raw_resume_url {
                                                ok(value) => {
                                                    match json_string(value) {
                                                        ok(value) => {
                                                            if !trusted_gateway_url(value) { return err("Discord READY supplied an untrusted resume URL") }
                                                            current_resume_url = value
                                                        }
                                                        err(problem) => { return err("Discord READY resume URL is invalid: " + problem) }
                                                    }
                                                }
                                                err(problem) => { return err("Discord READY has no resume URL: " + problem) }
                                            }
                                            println("Discord Gateway is ready")
                                            ready = true
                                        }
                                        if event_name == "MESSAGE_CREATE" {
                                            let raw_author: Result[Json, String] = json_field(event_data, "author")
                                            let mut author: Json = result_unwrap(json_parse("null"))
                                            match raw_author {
                                                ok(value) => { author = value }
                                                err(problem) => { return err("MESSAGE_CREATE has no author: " + problem) }
                                            }
                                            discord_cache_message_author_if_missing(bot, author)
                                            let mut from_bot: Bool = false
                                            let raw_bot_flag: Result[Json, String] = json_field(author, "bot")
                                            match raw_bot_flag {
                                                ok(value) => {
                                                    match json_bool(value) {
                                                        ok(flag) => { from_bot = flag }
                                                        err(problem) => { return err("MESSAGE_CREATE author has an invalid bot flag: " + problem) }
                                                    }
                                                }
                                                err(_) => {}
                                            }
                                            if !from_bot {
                                                if reply == "" {
                                                    let encoded_event: String = json_stringify(event_data)
                                                    let handler_result: Result[String, String] = poly_dispatch("discord.on_message", encoded_event)
                                                    match handler_result {
                                                        ok(value) => { reply = value }
                                                        err(problem) => { return err("Discord on_message handler failed: " + problem) }
                                                    }
                                                }
                                                if reply == "" && len(prefixes) > 0 {
                                                    let command_result: Result[String, String] = discord_dispatch_prefix_command(event_data, prefixes)
                                                    match command_result {
                                                        ok(value) => { reply = value }
                                                        err(problem) => { return err(problem) }
                                                    }
                                                }
                                                if reply != "" {
                                                    let raw_channel: Result[Json, String] = json_field(event_data, "channel_id")
                                                    let mut channel_id: String = ""
                                                    match raw_channel {
                                                        ok(value) => {
                                                            match json_string(value) {
                                                                ok(id) => { channel_id = id }
                                                                err(problem) => { return err("MESSAGE_CREATE channel_id is invalid: " + problem) }
                                                            }
                                                        }
                                                        err(problem) => { return err("MESSAGE_CREATE has no channel_id: " + problem) }
                                                    }
                                                    let sent_reply: Result[Json, String] = bot.send_message(channel_id, reply)
                                                    match sent_reply {
                                                        ok(_) => {}
                                                        err(problem) => { return err("Discord message reply failed: " + problem) }
                                                    }
                                                }
                                            }
                                        }
                                        if event_name == "INTERACTION_CREATE" {
                                            let handled: Result[Nil, String] = discord_dispatch_interaction(bot, event_data, reply)
                                            match handled {
                                                ok(_) => {}
                                                err(problem) => { return err(problem) }
                                            }
                                        }
                                    }
                                    err(problem) => { return err("Gateway dispatch has an invalid event name: " + problem) }
                                }
                            }
                            err(problem) => { return err("Gateway dispatch has no event name: " + problem) }
                        }
                    }
                    if op == 1 {
                        if awaiting_ack {
                            println("Discord Gateway requested a heartbeat before acknowledging the previous one; attempting to resume")
                            return ok(GatewaySessionState{reconnect: true, session_id: current_session_id, sequence: sequence, resume_url: current_resume_url})
                        }
                        let heartbeat: Result[Nil, String] = websocket_send(socket, heartbeat_payload(sequence))
                        match heartbeat {
                            ok(_) => {
                                awaiting_ack = true
                                next_heartbeat_at = datetime_unix_ms() + heartbeat_interval
                            }
                            err(problem) => {
                                println("Discord Gateway heartbeat failed; attempting to resume: " + problem)
                                return ok(GatewaySessionState{reconnect: true, session_id: current_session_id, sequence: sequence, resume_url: current_resume_url})
                            }
                        }
                    }
                    if op == 7 {
                        println("Discord Gateway requested a reconnect")
                        return ok(GatewaySessionState{reconnect: true, session_id: current_session_id, sequence: sequence, resume_url: current_resume_url})
                    }
                    if op == 9 {
                        let raw_resumable: Result[Json, String] = json_field(frame, "d")
                        let mut resumable: Bool = false
                        match raw_resumable {
                            ok(value) => {
                                match json_bool(value) {
                                    ok(value) => { resumable = value }
                                    err(problem) => { return err("Discord invalid-session flag is invalid: " + problem) }
                                }
                            }
                            err(problem) => { return err("Discord invalid-session frame has no resumable flag: " + problem) }
                        }
                        if resumable {
                            println("Discord Gateway invalidated the session temporarily; retrying resume")
                            return ok(GatewaySessionState{reconnect: true, session_id: current_session_id, sequence: sequence, resume_url: current_resume_url})
                        }
                        println("Discord Gateway invalidated the session; starting a new session")
                        return ok(GatewaySessionState{reconnect: true, session_id: "", sequence: -1, resume_url: resume_url})
                    }
                    if op == 10 { return err("Discord Gateway sent HELLO more than once") }
                    if op == 11 { awaiting_ack = false }
                }
            }
        }
        return ok(GatewaySessionState{reconnect: false, session_id: current_session_id, sequence: sequence, resume_url: current_resume_url})
}
