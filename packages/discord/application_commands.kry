// Small JSON builders for the common Discord application command types.

fn valid_chat_command_name(value: String) -> Bool {
    if len(value) == 0 || len(value) > 32 { return false }
    for point in codepoints(value) {
        let allowed: Bool = (point >= 97 && point <= 122) ||
            (point >= 48 && point <= 57) || point == 45 || point == 95
        if !allowed { return false }
    }
    return true
}

fn valid_context_command_name(value: String) -> Bool {
    if len(value) == 0 || len(value) > 32 { return false }
    for point in codepoints(value) {
        if point < 32 || (point >= 127 && point <= 159) { return false }
    }
    return true
}

fn validate_application_command_options(value: String) -> Result[String, String] {
    let parsed: Json = json_parse(value)?
    let count: Int = json_array_len(parsed)?
    if count > 25 { return err("Discord slash commands accept at most 25 options") }

    let mut index: Int = 0
    while index < count {
        let option: Json = json_array_get(parsed, index)?
        if json_kind(option) != "object" {
            return err("each Discord slash command option must be a JSON object")
        }
        index = index + 1
    }
    return ok(value)
}

fn application_command_key(command: Json) -> Result[String, String] {
    if json_kind(command) != "object" { return err("Discord application command must be a JSON object") }
    let raw_name: Json = json_object_get(command, "name")?
    let name: String = json_string(raw_name)?
    let mut command_type: Int = 1
    let raw_type: Result[Json, String] = json_object_get(command, "type")
    match raw_type {
        ok(value) => { command_type = json_int(value)? }
        err(_) => {}
    }
    if command_type < 1 || command_type > 3 { return err("Discord application command type must be 1, 2, or 3") }
    if command_type == 1 {
        if !valid_chat_command_name(name) { return err("chat-input command name is invalid") }
    } else if !valid_context_command_name(name) {
        return err("context-menu command name is invalid")
    }
    return ok(name + ":" + str(command_type))
}

fn application_command_array_json(commands: Array[String]) -> String {
    let mut output: String = "["
    let mut index: Int = 0
    for command in commands {
        if index > 0 { output = output + "," }
        output = output + command
        index = index + 1
    }
    return output + "]"
}

pub struct CommandTree {
    private application_id: String,
    private guild_id: String,
    private commands: Array[String],
}

pub fn command_tree(application_id: String) -> Result[CommandTree, String] {
    if !valid_snowflake(application_id) { return err("application_id must be a Discord snowflake") }
    return ok(CommandTree{application_id: application_id, guild_id: "", commands: []})
}

pub fn guild_command_tree(application_id: String, guild_id: String) -> Result[CommandTree, String] {
    if !valid_snowflake(application_id) || !valid_snowflake(guild_id) {
        return err("application_id and guild_id must be Discord snowflakes")
    }
    return ok(CommandTree{application_id: application_id, guild_id: guild_id, commands: []})
}

impl CommandTree {
    // Adds a normalized command definition and rejects duplicate name/type pairs.
    pub fn add(command_json: String) -> Result[CommandTree, String] {
        let command: Json = json_parse(command_json)?
        let key: String = application_command_key(command)?
        for existing_json in self.commands {
            let existing: Json = json_parse(existing_json)?
            if application_command_key(existing)? == key {
                return err("Discord command tree already contains this command name and type")
            }
        }
        let normalized: String = json_stringify(command)
        return ok(CommandTree{
            application_id: self.application_id,
            guild_id: self.guild_id,
            commands: array_push(self.commands, normalized),
        })
    }

    pub fn commands_json() -> String {
        return application_command_array_json(self.commands)
    }

    // Syncs the local set with Discord using the global or guild overwrite route.
    pub fn sync(bot: Bot) -> Result[Json, String] {
        let commands: String = application_command_array_json(self.commands)
        if self.guild_id == "" {
            return bot.sync_global_commands(self.application_id, commands)
        }
        return bot.bulk_overwrite_guild_commands(self.application_id, self.guild_id, commands)
    }
}

fn valid_choice_display_name(value: String) -> Bool {
    return len(value) >= 1 && len(value) <= 100
}

pub fn string_choice_json(name: String, value: String) -> Result[String, String] {
    if !valid_choice_display_name(name) || len(value) < 1 || len(value) > 100 {
        return err("string choice name and value must contain 1 to 100 Unicode code points")
    }
    let encoded_name: String = json_quote(name)?
    let encoded_value: String = json_quote(value)?
    return ok("{\"name\":" + encoded_name + ",\"value\":" + encoded_value + "}")
}

pub fn integer_choice_json(name: String, value: Int) -> Result[String, String] {
    if !valid_choice_display_name(name) { return err("choice name must contain 1 to 100 Unicode code points") }
    let encoded_name: String = json_quote(name)?
    return ok("{\"name\":" + encoded_name + ",\"value\":" + str(value) + "}")
}

pub fn number_choice_json(name: String, value: Float) -> Result[String, String] {
    if !valid_choice_display_name(name) { return err("choice name must contain 1 to 100 Unicode code points") }
    let encoded_name: String = json_quote(name)?
    let encoded_value: String = str(value)
    let checked_number: Json = json_parse(encoded_value)?
    if json_kind(checked_number) != "number" { return err("choice value must be a finite number") }
    return ok("{\"name\":" + encoded_name + ",\"value\":" + encoded_value + "}")
}

pub fn autocomplete_response_json(choices_json: String) -> Result[String, String] {
    let choices: Json = json_parse(choices_json)?
    let count: Int = json_array_len(choices)?
    if count > 25 { return err("Discord autocomplete responses accept at most 25 choices") }
    let mut index: Int = 0
    while index < count {
        let choice: Json = json_array_get(choices, index)?
        if json_kind(choice) != "object" { return err("each autocomplete choice must be a JSON object") }
        let name_json: Json = json_object_get(choice, "name")?
        let name: String = json_string(name_json)?
        if !valid_choice_display_name(name) { return err("autocomplete choice names must contain 1 to 100 Unicode code points") }
        let value_json: Json = json_object_get(choice, "value")?
        let value_kind: String = json_kind(value_json)
        if value_kind != "string" && value_kind != "number" {
            return err("autocomplete choice values must be strings or numbers")
        }
        if value_kind == "string" {
            let value: String = json_string(value_json)?
            if len(value) < 1 || len(value) > 100 { return err("autocomplete string values must contain 1 to 100 Unicode code points") }
        }
        index = index + 1
    }
    let normalized: String = json_stringify(choices)
    return ok("{\"type\":8,\"data\":{\"choices\":" + normalized + "}}")
}

// This builder accepts the ASCII subset of Discord's CHAT_INPUT name rule.
// The Discord API also accepts certain Unicode letter/number categories;
// Kryndel has no Unicode-category predicate yet, so this helper rejects them
// instead of claiming to validate names it cannot classify.
pub fn slash_command_json(name: String, description: String, options_json: String) -> Result[String, String] {
    if !valid_chat_command_name(name) {
        return err("slash command name must be 1 to 32 lowercase ASCII letters, digits, hyphens, or underscores")
    }
    if len(description) == 0 || len(description) > 100 {
        return err("slash command description must contain 1 to 100 Unicode code points")
    }

    let checked_options: String = validate_application_command_options(options_json)?
    let quoted_name: String = json_quote(name)?
    let quoted_description: String = json_quote(description)?
    return ok("{\"name\":" + quoted_name + ",\"type\":1,\"description\":" + quoted_description + ",\"options\":" + checked_options + "}")
}

// Context menu commands have no description or options in Discord's schema.
pub fn user_context_command_json(name: String) -> Result[String, String] {
    if !valid_context_command_name(name) {
        return err("user context command name must contain 1 to 32 non-control Unicode code points")
    }
    let quoted_name: String = json_quote(name)?
    return ok("{\"name\":" + quoted_name + ",\"type\":2}")
}

pub fn message_context_command_json(name: String) -> Result[String, String] {
    if !valid_context_command_name(name) {
        return err("message context command name must contain 1 to 32 non-control Unicode code points")
    }
    let quoted_name: String = json_quote(name)?
    return ok("{\"name\":" + quoted_name + ",\"type\":3}")
}

impl Bot {
    // Validates the overwrite envelope and delegates request/authentication to
    // the existing bulk-overwrite route helper.
    pub fn sync_global_commands(application_id: String, commands_json: String) -> Result[Json, String] {
        let parsed: Json = json_parse(commands_json)?
        let count: Int = json_array_len(parsed)?
        let mut index: Int = 0
        while index < count {
            let command: Json = json_array_get(parsed, index)?
            if json_kind(command) != "object" {
                return err("each Discord global application command must be a JSON object")
            }
            index = index + 1
        }
        return self.bulk_overwrite_global_commands(application_id, commands_json)
    }
}
