// Discord bot account client. Self-bots and normal-user account automation
// are intentionally unsupported.
pub struct Bot {
    token: String,
    intents: Array[String],
    gateway: String,
    shard_id: Int,
    shard_count: Int,
}

pub struct GatewaySessionState {
    reconnect: Bool,
    session_id: String,
    sequence: Int,
    resume_url: String,
}

pub struct Webhook {
    id: String,
    token: String,
}

fn discord_internal_ignore_event_v10(event_json: String) -> String {
    return ""
}

fn discord_internal_ignore_message_v10(message_json: String) -> String {
    return ""
}

fn valid_token(value: String) -> Bool {
    if value == "" { return false }
    for point in codepoints(value) {
        if point < 32 || point == 127 { return false }
    }
    return true
}

fn valid_snowflake(value: String) -> Bool {
    if len(value) < 1 || len(value) > 20 { return false }
    for point in codepoints(value) {
        if point < 48 || point > 57 { return false }
    }
    return true
}

fn valid_cache_id(value: String) -> Bool {
    let mut separators: Int = 0
    let mut digits_before_separator: Int = 0
    let mut digits_after_separator: Int = 0
    for point in codepoints(value) {
        if point >= 48 && point <= 57 {
            if separators == 1 { digits_after_separator = digits_after_separator + 1 }
            else { digits_before_separator = digits_before_separator + 1 }
        } else if point == 58 {
            separators = separators + 1
            if separators > 1 || digits_before_separator == 0 { return false }
        } else { return false }
    }
    if separators == 0 { return valid_snowflake(value) }
    return digits_after_separator > 0 && len(value) <= 41
}

fn valid_interaction_token(value: String) -> Bool {
    if len(value) < 1 || len(value) > 256 { return false }
    for point in codepoints(value) {
        let safe: Bool = (point >= 48 && point <= 57) || (point >= 65 && point <= 90) || (point >= 97 && point <= 122) || point == 45 || point == 46 || point == 95
        if !safe { return false }
    }
    return true
}

fn trusted_gateway_url(value: String) -> Bool {
    if !starts_with(value, "wss://") { return false }
    let raw_host: Result[String, String] = substring(value, 6, len(value) - 6)
    let mut host: String = ""
    match raw_host { ok(raw) => { host = raw } err(_) => { return false } }
    let standard: Bool = host == "gateway.discord.gg"
    let regional: Bool = starts_with(host, "gateway-") && ends_with(host, ".discord.gg")
    return (standard || regional) && !contains(host, "/") && !contains(host, "?") && !contains(host, "#") && !contains(host, "@") && !contains(host, "\\")
}

fn discord_text_length(value: String) -> Int {
    let mut count: Int = 0
    for point in codepoints(value) {
        if point > 65535 { count = count + 2 }
        else { count = count + 1 }
    }
    return count
}

fn intent_bit(intent: String) -> Int {
    if intent == "Guilds" { return 1 }
    if intent == "GuildMembers" { return 2 }
    if intent == "GuildModeration" { return 4 }
    if intent == "GuildExpressions" { return 8 }
    if intent == "GuildIntegrations" { return 16 }
    if intent == "GuildWebhooks" { return 32 }
    if intent == "GuildInvites" { return 64 }
    if intent == "GuildVoiceStates" { return 128 }
    if intent == "GuildPresences" { return 256 }
    if intent == "GuildMessages" { return 512 }
    if intent == "GuildMessageReactions" { return 1024 }
    if intent == "GuildMessageTyping" { return 2048 }
    if intent == "DirectMessages" { return 4096 }
    if intent == "DirectMessageReactions" { return 8192 }
    if intent == "DirectMessageTyping" { return 16384 }
    if intent == "MessageContent" { return 32768 }
    if intent == "GuildScheduledEvents" { return 65536 }
    if intent == "AutoModerationConfiguration" { return 1048576 }
    if intent == "AutoModerationExecution" { return 2097152 }
    if intent == "GuildMessagePolls" { return 4194304 }
    if intent == "DirectMessagePolls" { return 8388608 }
    return 0
}

fn intent_mask(intents: Array[String]) -> Result[Int, String] {
    let mut seen: Array[String] = []
    let mut mask: Int = 0
    for intent in intents {
        let bit: Int = intent_bit(intent)
        if bit == 0 { return err("unknown Discord Gateway intent: " + intent) }
        if array_contains(seen, intent) { return err("duplicate Discord Gateway intent: " + intent) }
        seen = array_push(seen, intent)
        mask = mask + bit
    }
    return ok(mask)
}

pub fn json_quote(value: String) -> Result[String, String] {
    for point in codepoints(value) {
        if point < 32 && point != 9 && point != 10 && point != 13 {
            return err("JSON text contains an unsupported control character")
        }
    }
    let mut escaped: String = replace(value, "\\", "\\\\")
    escaped = replace(escaped, "\"", "\\\"")
    escaped = replace(escaped, "\n", "\\n")
    escaped = replace(escaped, "\r", "\\r")
    escaped = replace(escaped, "\t", "\\t")
    return ok("\"" + escaped + "\"")
}

fn json_field(value: Json, key: String) -> Result[Json, String] {
    return json_object_get(value, key)
}

fn response_json(value: Result[String, String]) -> Result[Json, String] {
    match value {
        ok(text) => { return json_parse(text) }
        err(problem) => { return err(problem) }
    }
}

fn gateway_frame(raw: String) -> Result[Json, String] {
    return json_parse(raw)
}

fn gateway_opcode(frame: Json) -> Result[Int, String] {
    let raw_opcode: Result[Json, String] = json_field(frame, "op")
    match raw_opcode {
        ok(value) => { return json_int(value) }
        err(problem) => { return err("Gateway frame has no opcode: " + problem) }
    }
}

fn gateway_heartbeat_interval(frame: Json) -> Result[Int, String] {
    let raw_data: Result[Json, String] = json_field(frame, "d")
    match raw_data {
        err(problem) => { return err("Gateway HELLO has no data object: " + problem) }
        ok(data) => {
            let raw_interval: Result[Json, String] = json_field(data, "heartbeat_interval")
            match raw_interval {
                ok(value) => { return json_int(value) }
                err(problem) => { return err("Gateway HELLO has no heartbeat interval: " + problem) }
            }
        }
    }
}

fn heartbeat_payload(sequence: Int) -> String {
    if sequence < 0 { return "{\"op\":1,\"d\":null}" }
    return "{\"op\":1,\"d\":" + str(sequence) + "}"
}

pub fn bot(token: String, intents: Array[String]) -> Result[Bot, String] {
    if !valid_token(token) { return err("Discord bot token must be non-empty and contain no control characters") }
    let checked_intents: Result[Int, String] = intent_mask(intents)
    match checked_intents {
        err(problem) => { return err(problem) }
        ok(_) => {}
    }
    return ok(Bot{token: token, intents: intents, gateway: "https://discord.com/api/v10/gateway/bot", shard_id: 0, shard_count: 1})
}

pub fn webhook(id: String, token: String) -> Result[Webhook, String] {
    if !valid_snowflake(id) { return err("webhook ID must be a Discord snowflake") }
    if !valid_interaction_token(token) { return err("invalid webhook token") }
    return ok(Webhook{id: id, token: token})
}

fn webhook_thread_query(thread_id: String) -> Result[String, String] {
    if thread_id == "" { return ok("") }
    if !valid_snowflake(thread_id) { return err("thread_id must be a Discord snowflake") }
    return ok("thread_id=" + thread_id)
}

impl Webhook {
    // Raw JSON exposes Discord's complete execute/edit payload surface, including
    // embeds, components, polls, allowed_mentions, and future API fields.
    pub fn execute_json(payload_json: String, wait: Bool, thread_id: String) -> Result[String, String] {
        let checked_thread: Result[String, String] = webhook_thread_query(thread_id)
        match checked_thread {
            err(problem) => { return err(problem) }
            ok(thread_query) => {
                let mut query: String = "?wait=false"
                if wait { query = "?wait=true" }
                if thread_query != "" { query = query + "&" + thread_query }
                let route: String = "/webhooks/" + self.id + "/" + self.token + query
                return discord_interaction_request("POST", route, payload_json)
            }
        }
    }

    // Plain-text sends suppress mentions unless the caller uses execute_json
    // and explicitly supplies allowed_mentions.
    pub fn send(content: String) -> Result[Json, String] {
        if discord_text_length(content) == 0 || discord_text_length(content) > 2000 {
            return err("webhook content must contain 1 to 2000 UTF-16 code units")
        }
        let quoted: Result[String, String] = json_quote(content)
        match quoted {
            err(problem) => { return err(problem) }
            ok(encoded) => {
                let payload: String = "{\"content\":" + encoded + ",\"allowed_mentions\":{\"parse\":[]}}"
                let response: Result[String, String] = self.execute_json(payload, true, "")
                return response_json(response)
            }
        }
    }

    pub fn fetch() -> Result[Json, String] {
        return response_json(discord_interaction_request("GET", "/webhooks/" + self.id + "/" + self.token, ""))
    }

    pub fn edit_json(payload_json: String) -> Result[Json, String] {
        return response_json(discord_interaction_request("PATCH", "/webhooks/" + self.id + "/" + self.token, payload_json))
    }

    pub fn delete() -> Result[Nil, String] {
        let result: Result[String, String] = discord_interaction_request("DELETE", "/webhooks/" + self.id + "/" + self.token, "")
        match result { ok(_) => { return ok(nil) } err(problem) => { return err(problem) } }
    }

    pub fn fetch_message(message_id: String, thread_id: String) -> Result[Json, String] {
        if !valid_snowflake(message_id) { return err("message_id must be a Discord snowflake") }
        let query: Result[String, String] = webhook_thread_query(thread_id)
        match query {
            err(problem) => { return err(problem) }
            ok(thread_query) => {
                let mut suffix: String = ""
                if thread_query != "" { suffix = "?" + thread_query }
                let route: String = "/webhooks/" + self.id + "/" + self.token + "/messages/" + message_id + suffix
                return response_json(discord_interaction_request("GET", route, ""))
            }
        }
    }

    pub fn edit_message_json(message_id: String, payload_json: String, thread_id: String) -> Result[Json, String] {
        if !valid_snowflake(message_id) { return err("message_id must be a Discord snowflake") }
        let query: Result[String, String] = webhook_thread_query(thread_id)
        match query {
            err(problem) => { return err(problem) }
            ok(thread_query) => {
                let mut suffix: String = ""
                if thread_query != "" { suffix = "?" + thread_query }
                let route: String = "/webhooks/" + self.id + "/" + self.token + "/messages/" + message_id + suffix
                return response_json(discord_interaction_request("PATCH", route, payload_json))
            }
        }
    }

    pub fn delete_message(message_id: String, thread_id: String) -> Result[Nil, String] {
        if !valid_snowflake(message_id) { return err("message_id must be a Discord snowflake") }
        let query: Result[String, String] = webhook_thread_query(thread_id)
        match query {
            err(problem) => { return err(problem) }
            ok(thread_query) => {
                let mut suffix: String = ""
                if thread_query != "" { suffix = "?" + thread_query }
                let route: String = "/webhooks/" + self.id + "/" + self.token + "/messages/" + message_id + suffix
                let result: Result[String, String] = discord_interaction_request("DELETE", route, "")
                match result { ok(_) => { return ok(nil) } err(problem) => { return err(problem) } }
            }
        }
    }
}

impl Bot {
    // Raw REST access keeps the complete API v10 route surface available.
    // The host and authentication scheme are fixed by the runtime builtin.
    pub fn request(method: String, route: String, body: String) -> Result[String, String] {
        return discord_api_request(method, route, body, self.token)
    }

    pub fn with_shard(shard_id: Int, shard_count: Int) -> Result[Bot, String] {
        if shard_count < 1 || shard_count > 1024 || shard_id < 0 || shard_id >= shard_count {
            return err("shard_id must be within a shard_count from 1 to 1024")
        }
        return ok(Bot{token: self.token, intents: self.intents, gateway: self.gateway, shard_id: shard_id, shard_count: shard_count})
    }

    pub fn upload(method: String, route: String, payload_json: String, filename: String, data: Bytes) -> Result[String, String] {
        return discord_api_upload(method, route, payload_json, filename, data, self.token)
    }

    pub fn interaction_request(method: String, route: String, body: String) -> Result[String, String] {
        return discord_interaction_request(method, route, body)
    }

    pub fn verify_interaction(public_key: String, timestamp: String, body: String, signature: String) -> Result[Bool, String] {
        return discord_verify_interaction(public_key, timestamp, body, signature)
    }

    pub fn respond_interaction(interaction_id: String, interaction_token: String, body: String) -> Result[Nil, String] {
        if !valid_snowflake(interaction_id) || !valid_interaction_token(interaction_token) { return err("invalid interaction ID or token") }
        let result: Result[String, String] = discord_interaction_request("POST", "/interactions/" + interaction_id + "/" + interaction_token + "/callback", body)
        match result { ok(_) => { return ok(nil) } err(problem) => { return err(problem) } }
    }

    pub fn create_followup(application_id: String, interaction_token: String, body: String) -> Result[Json, String] {
        if !valid_snowflake(application_id) || !valid_interaction_token(interaction_token) { return err("invalid application ID or interaction token") }
        return response_json(discord_interaction_request("POST", "/webhooks/" + application_id + "/" + interaction_token, body))
    }

    pub fn edit_original_response(application_id: String, interaction_token: String, body: String) -> Result[Json, String] {
        if !valid_snowflake(application_id) || !valid_interaction_token(interaction_token) { return err("invalid application ID or interaction token") }
        return response_json(discord_interaction_request("PATCH", "/webhooks/" + application_id + "/" + interaction_token + "/messages/@original", body))
    }

    pub fn delete_original_response(application_id: String, interaction_token: String) -> Result[Nil, String] {
        if !valid_snowflake(application_id) || !valid_interaction_token(interaction_token) { return err("invalid application ID or interaction token") }
        let result: Result[String, String] = discord_interaction_request("DELETE", "/webhooks/" + application_id + "/" + interaction_token + "/messages/@original", "")
        match result { ok(_) => { return ok(nil) } err(problem) => { return err(problem) } }
    }

    pub fn get_followup(application_id: String, interaction_token: String, message_id: String) -> Result[Json, String] {
        if !valid_snowflake(application_id) || !valid_snowflake(message_id) || !valid_interaction_token(interaction_token) { return err("invalid application ID, interaction token, or message ID") }
        return response_json(discord_interaction_request("GET", "/webhooks/" + application_id + "/" + interaction_token + "/messages/" + message_id, ""))
    }

    pub fn edit_followup(application_id: String, interaction_token: String, message_id: String, body: String) -> Result[Json, String] {
        if !valid_snowflake(application_id) || !valid_snowflake(message_id) || !valid_interaction_token(interaction_token) { return err("invalid application ID, interaction token, or message ID") }
        return response_json(discord_interaction_request("PATCH", "/webhooks/" + application_id + "/" + interaction_token + "/messages/" + message_id, body))
    }

    pub fn delete_followup(application_id: String, interaction_token: String, message_id: String) -> Result[Nil, String] {
        if !valid_snowflake(application_id) || !valid_snowflake(message_id) || !valid_interaction_token(interaction_token) { return err("invalid application ID, interaction token, or message ID") }
        let result: Result[String, String] = discord_interaction_request("DELETE", "/webhooks/" + application_id + "/" + interaction_token + "/messages/" + message_id, "")
        match result { ok(_) => { return ok(nil) } err(problem) => { return err(problem) } }
    }

    pub fn create_global_command(application_id: String, command_json: String) -> Result[Json, String] {
        if !valid_snowflake(application_id) { return err("application_id must be a Discord snowflake") }
        return response_json(self.request("POST", "/applications/" + application_id + "/commands", command_json))
    }

    pub fn bulk_overwrite_global_commands(application_id: String, commands_json: String) -> Result[Json, String] {
        if !valid_snowflake(application_id) { return err("application_id must be a Discord snowflake") }
        return response_json(self.request("PUT", "/applications/" + application_id + "/commands", commands_json))
    }

    pub fn upsert_global_command(application_id: String, command_id: String, command_json: String) -> Result[Json, String] {
        if !valid_snowflake(application_id) || !valid_snowflake(command_id) { return err("application_id and command_id must be Discord snowflakes") }
        return response_json(self.request("PATCH", "/applications/" + application_id + "/commands/" + command_id, command_json))
    }

    pub fn list_global_commands(application_id: String) -> Result[Json, String] {
        if !valid_snowflake(application_id) { return err("application_id must be a Discord snowflake") }
        return response_json(self.request("GET", "/applications/" + application_id + "/commands", ""))
    }

    pub fn delete_global_command(application_id: String, command_id: String) -> Result[Nil, String] {
        if !valid_snowflake(application_id) || !valid_snowflake(command_id) { return err("application_id and command_id must be Discord snowflakes") }
        let result: Result[String, String] = self.request("DELETE", "/applications/" + application_id + "/commands/" + command_id, "")
        match result { ok(_) => { return ok(nil) } err(problem) => { return err(problem) } }
    }

    pub fn create_guild_command(application_id: String, guild_id: String, command_json: String) -> Result[Json, String] {
        if !valid_snowflake(application_id) || !valid_snowflake(guild_id) { return err("application_id and guild_id must be Discord snowflakes") }
        return response_json(self.request("POST", "/applications/" + application_id + "/guilds/" + guild_id + "/commands", command_json))
    }

    pub fn bulk_overwrite_guild_commands(application_id: String, guild_id: String, commands_json: String) -> Result[Json, String] {
        if !valid_snowflake(application_id) || !valid_snowflake(guild_id) { return err("application_id and guild_id must be Discord snowflakes") }
        return response_json(self.request("PUT", "/applications/" + application_id + "/guilds/" + guild_id + "/commands", commands_json))
    }

    pub fn list_guild_commands(application_id: String, guild_id: String) -> Result[Json, String] {
        if !valid_snowflake(application_id) || !valid_snowflake(guild_id) { return err("application_id and guild_id must be Discord snowflakes") }
        return response_json(self.request("GET", "/applications/" + application_id + "/guilds/" + guild_id + "/commands", ""))
    }

    pub fn update_guild_command(application_id: String, guild_id: String, command_id: String, command_json: String) -> Result[Json, String] {
        if !valid_snowflake(application_id) || !valid_snowflake(guild_id) || !valid_snowflake(command_id) { return err("application_id, guild_id, and command_id must be Discord snowflakes") }
        return response_json(self.request("PATCH", "/applications/" + application_id + "/guilds/" + guild_id + "/commands/" + command_id, command_json))
    }

    pub fn delete_guild_command(application_id: String, guild_id: String, command_id: String) -> Result[Nil, String] {
        if !valid_snowflake(application_id) || !valid_snowflake(guild_id) || !valid_snowflake(command_id) { return err("application_id, guild_id, and command_id must be Discord snowflakes") }
        let result: Result[String, String] = self.request("DELETE", "/applications/" + application_id + "/guilds/" + guild_id + "/commands/" + command_id, "")
        match result { ok(_) => { return ok(nil) } err(problem) => { return err(problem) } }
    }

    pub fn cache_get(kind: String, id: String) -> Result[Json, String] {
        if !valid_cache_id(id) { return err("cache ID must be a Discord snowflake or guild:snowflake pair") }
        return response_json(discord_cache_get(kind, id))
    }

    pub fn cache_put(kind: String, id: String, object_json: String) -> Result[Nil, String] {
        if !valid_cache_id(id) { return err("cache ID must be a Discord snowflake or guild:snowflake pair") }
        return discord_cache_put(kind, id, object_json)
    }

    pub fn cache_delete(kind: String, id: String) -> Nil {
        if valid_cache_id(id) { discord_cache_delete(kind, id) }
        return nil
    }

    pub fn cache_clear() -> Nil {
        discord_cache_clear()
        return nil
    }

    pub fn get_current_user() -> Result[Json, String] {
        return response_json(self.request("GET", "/users/@me", ""))
    }

    pub fn get_user(user_id: String) -> Result[Json, String] {
        if !valid_snowflake(user_id) { return err("user_id must be a Discord snowflake") }
        return response_json(self.request("GET", "/users/" + user_id, ""))
    }

    pub fn get_guild(guild_id: String) -> Result[Json, String] {
        if !valid_snowflake(guild_id) { return err("guild_id must be a Discord snowflake") }
        return response_json(self.request("GET", "/guilds/" + guild_id, ""))
    }

    pub fn get_channel(channel_id: String) -> Result[Json, String] {
        if !valid_snowflake(channel_id) { return err("channel_id must be a Discord snowflake") }
        return response_json(self.request("GET", "/channels/" + channel_id, ""))
    }

    pub fn get_message(channel_id: String, message_id: String) -> Result[Json, String] {
        if !valid_snowflake(channel_id) || !valid_snowflake(message_id) {
            return err("channel_id and message_id must be Discord snowflakes")
        }
        return response_json(self.request("GET", "/channels/" + channel_id + "/messages/" + message_id, ""))
    }

    pub fn create_dm(user_id: String) -> Result[Json, String] {
        if !valid_snowflake(user_id) { return err("user_id must be a Discord snowflake") }
        return response_json(self.request("POST", "/users/@me/channels", "{\"recipient_id\":\"" + user_id + "\"}"))
    }

    pub fn send_message(channel_id: String, content: String) -> Result[Json, String] {
        if !valid_snowflake(channel_id) { return err("channel_id must be a Discord snowflake") }
        if discord_text_length(content) == 0 || discord_text_length(content) > 2000 { return err("message content must contain 1 to 2000 UTF-16 code units") }
        let quoted: Result[String, String] = json_quote(content)
        match quoted {
            err(problem) => { return err(problem) }
            ok(encoded) => {
                let body: String = "{\"content\":" + encoded + ",\"allowed_mentions\":{\"parse\":[]}}"
                return response_json(self.request("POST", "/channels/" + channel_id + "/messages", body))
            }
        }
    }

    pub fn edit_message(channel_id: String, message_id: String, content: String) -> Result[Json, String] {
        if !valid_snowflake(channel_id) || !valid_snowflake(message_id) {
            return err("channel_id and message_id must be Discord snowflakes")
        }
        if discord_text_length(content) == 0 || discord_text_length(content) > 2000 { return err("message content must contain 1 to 2000 UTF-16 code units") }
        let quoted: Result[String, String] = json_quote(content)
        match quoted {
            err(problem) => { return err(problem) }
            ok(encoded) => {
                let body: String = "{\"content\":" + encoded + ",\"allowed_mentions\":{\"parse\":[]}}"
                return response_json(self.request("PATCH", "/channels/" + channel_id + "/messages/" + message_id, body))
            }
        }
    }

    pub fn delete_message(channel_id: String, message_id: String) -> Result[Nil, String] {
        if !valid_snowflake(channel_id) || !valid_snowflake(message_id) {
            return err("channel_id and message_id must be Discord snowflakes")
        }
        let result: Result[String, String] = self.request("DELETE", "/channels/" + channel_id + "/messages/" + message_id, "")
        match result {
            ok(_) => { return ok(nil) }
            err(problem) => { return err(problem) }
        }
    }

    pub fn create_guild_channel(guild_id: String, name: String, channel_type: Int) -> Result[Json, String] {
        if !valid_snowflake(guild_id) { return err("guild_id must be a Discord snowflake") }
        if name == "" || len(name) > 100 { return err("channel name must contain 1 to 100 code points") }
        let quoted: Result[String, String] = json_quote(name)
        match quoted {
            err(problem) => { return err(problem) }
            ok(encoded) => {
                let body: String = "{\"name\":" + encoded + ",\"type\":" + str(channel_type) + "}"
                return response_json(self.request("POST", "/guilds/" + guild_id + "/channels", body))
            }
        }
    }

    pub fn create_role(guild_id: String, name: String) -> Result[Json, String] {
        if !valid_snowflake(guild_id) { return err("guild_id must be a Discord snowflake") }
        if name == "" || len(name) > 100 { return err("role name must contain 1 to 100 code points") }
        let quoted: Result[String, String] = json_quote(name)
        match quoted {
            err(problem) => { return err(problem) }
            ok(encoded) => {
                return response_json(self.request("POST", "/guilds/" + guild_id + "/roles", "{\"name\":" + encoded + "}"))
            }
        }
    }

    pub fn delete_role(guild_id: String, role_id: String) -> Result[Nil, String] {
        if !valid_snowflake(guild_id) || !valid_snowflake(role_id) {
            return err("guild_id and role_id must be Discord snowflakes")
        }
        let result: Result[String, String] = self.request("DELETE", "/guilds/" + guild_id + "/roles/" + role_id, "")
        match result {
            ok(_) => { return ok(nil) }
            err(problem) => { return err(problem) }
        }
    }

