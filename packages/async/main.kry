// Async utilities for cancellation-aware and structured concurrency.

pub fn sleep_ms(milliseconds: Int) -> Result[Nil, String] {
    return sleep_ms(milliseconds)
}

pub fn yield_now() -> Nil {
    return yield_now()
}

pub fn group() -> TaskGroup {
    return task_group()
}

pub fn wait_group(group: TaskGroup) -> Result[Nil, String] {
    return task_group_wait(group)
}

pub fn cancel_group(group: TaskGroup) -> Nil {
    return task_group_cancel(group)
}

pub fn await_int(task: Thread[Int]) -> Int {
    return await(task)
}
